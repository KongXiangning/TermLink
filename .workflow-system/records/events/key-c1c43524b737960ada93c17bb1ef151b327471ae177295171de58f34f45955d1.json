          "text": "const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),crypto=require('node:crypto'),readline=require('node:readline');\nconst repo='E:/coding/TermLink-rust-source-resolution-codex',root=__dirname;\nconst executionRef='.workflow-system/records/events/key-b8abacef93150a2c569748f45ee35b71588a12556dc8f8829388307c5f49abf1.json';\nconst execution=JSON.parse(fs.readFileSync(path.join(repo,executionRef),'utf8')).payload.request;\nconst artifact=execution.commands.find(x=>x.label==='collector').artifact;\nconst digest=b=>crypto.createHash('sha256').update(b).digest('hex');\nif(digest(fs.readFileSync(artifact.path))!==artifact.sha256)throw Error('artifact changed');\nconst id='019b2b40-beb6-7b23-bed0-37d570e76816';\nconst baseline=fs.readFileSync(path.join(repo,`native/codex-rollout-collector/tests/fixtures/target-session/2026/08/26/rollout-2026-08-26T00-00-00-${id}.jsonl`),'utf8').trimEnd()+'\\n';\nconst fixture=name=>fs.readFileSync(path.join(repo,`native/codex-rollout-collector/tests/fixtures/current/${name}`),'utf8').split(/\\r?\\n/).filter(Boolean).map(JSON.parse);\nconst token=fixture('token-usage-record.jsonl').find(x=>x.type==='token_usage_record');\nconst developer=fixture('message-roles.jsonl').find(x=>x.payload?.role==='developer');\nconst source=baseline+[token,developer].map((x,i)=>JSON.stringify({...x,ordinal:i+2})+'\\n').join('');\nconst sessions=path.join(root,'synthetic-sessions');\nconst sourceFile=path.join(sessions,`2026/08/26/rollout-2026-08-26T00-00-00-${id}.jsonl`);\nfs.mkdirSync(path.dirname(sourceFile),{recursive:true});fs.writeFileSync(sourceFile,source,{flag:'wx'});\nconst group=xs=>xs.reduce((r,x)=>(r[x]=(r[x]||0)+1,r),{});\nfunction summarizeProjection(p){return {complete:p.complete,coverage:p.coverage,availability:p.availability,diagnostic_codes:group(p.diagnostics.map(x=>x.code)),diagnostic_keys:p.diagnostics.map(x=>x.item_key),turn_count:p.turns.length,item_count:p.turns.reduce((n,t)=>n+t.items.length,0)};}\nasync function run(label,mode,anchor){\n const args=['--startup-config-version','1','--sessions-root',sessions];\n const req={protocol_version:1,message_type:'analyze',request_id:`append-review-${label}`,job_id:`append-review-${label}`,conversation_id:id,mode};\n if(anchor){req.cursor=anchor.cursor;req.persisted_anchor=anchor.checkpoint;}\n return new Promise((resolve,reject)=>{\n  const process=cp.spawn(artifact.path,args,{cwd:repo,stdio:['pipe','pipe','pipe'],windowsHide:true});\n  const lines=readline.createInterface({input:process.stdout});\n  let checkpoint,cursor,stderr='',failure=null;\n  const result={label,command:{executable:artifact.path,args,cwd:repo},mode,source_sha256:digest(fs.readFileSync(sourceFile)),source_bytes:fs.statSync(sourceFile).size,started:new Date().toISOString(),hello:false,batches:[],ack_count:0,errors:[]};\n  const timer=setTimeout(()=>{failure='timeout';process.kill();},15000);\n  process.stderr.on('data',b=>stderr+=b);\n  process.on('error',reject);\n  lines.on('line',line=>{try{\n   const m=JSON.parse(line);\n   if(m.message_type==='hello'){result.hello=true;process.stdin.write(JSON.stringify(req)+'\\n');}\n   else if(m.message_type==='batch'){\n    const b=m.payload;\n    result.batches.push({complete:b.complete,completeness:b.completeness,cursor_kind:b.next_cursor?.cursor_kind,progress:b.progress,event_types:group(b.history_items.map(x=>x.event_type)),projection:summarizeProjection(b.projection),checkpoint_projection:summarizeProjection(b.reducer_state.payload.reducer.projection),canonical_committed:b.reducer_state.payload.reducer.canonical_committed});\n    process.stdin.write(JSON.stringify({protocol_version:1,message_type:'ack',request_id:m.request_id,job_id:m.job_id,segment_id:m.segment_id,batch_id:m.batch_id,accepted:true,persisted:true})+'\\n');result.ack_count++;\n   }else if(m.message_type==='complete'){\n    checkpoint=m.checkpoint;cursor=m.next_cursor??m.cursor??checkpoint.cursor;\n    result.complete={status:m.status,completeness:m.completeness,cursor_kind:checkpoint.cursor_kind,complete_source_end:checkpoint.projection_watermark.complete_source_end,projection:summarizeProjection(checkpoint.reducer_state.payload.reducer.projection),canonical_committed:checkpoint.reducer_state.payload.reducer.canonical_committed};process.stdin.end();\n   }else if(m.message_type==='error'){result.errors.push({code:m.code,message:m.message});process.stdin.end();}\n  }catch(e){failure=e.message;process.kill();}});\n  process.on('close',exit=>{clearTimeout(timer);result.exit_code=exit;result.failure=failure;result.stderr_bytes=Buffer.byteLength(stderr);result.stderr_sha256=digest(stderr);result.finished=new Date().toISOString();resolve({result,checkpoint,cursor});});\n  process.stdin.write(JSON.stringify({protocol_version:1,message_type:'hello',request_id:`append-review-${label}-generation`,role:'node',capabilities:['analyze_v1','cancel','checkpoint','ack']})+'\\n');\n });\n}\n(async()=>{\n const initial=await run('initial','backfill');\n const noGrowth=await run('no-growth','append',initial);\n const extra={...JSON.parse(baseline.trimEnd().split('\\n')[1]),ordinal:4};\n fs.appendFileSync(sourceFile,JSON.stringify(extra)+'\\n');\n const growth=await run('growth-from-original-anchor','append',initial);\n const report={purpose:'Read-only code review counterexample; isolated synthetic sessions only, no external source/product mutation',execution_ref:executionRef,artifact,input_fixture_hashes:{baseline:digest(baseline),token:digest(JSON.stringify(token)),developer:digest(JSON.stringify(developer))},driver_sha256:digest(fs.readFileSync(__filename)),results:[initial.result,noGrowth.result,growth.result],expected:'Both append projections and checkpoint states preserve initial token_usage_record/developer_message_hidden diagnostics without duplication.',assertion_passed:[noGrowth,growth].every(x=>JSON.stringify(x.result.complete?.projection.diagnostic_keys)===JSON.stringify(initial.result.complete?.projection.diagnostic_keys))};\n fs.writeFileSync(path.join(root,'append-probe-report.json'),JSON.stringify(report,null,2)+'\\n');console.log(JSON.stringify(report));if(!report.assertion_passed)process.exitCode=1;\n})().catch(e=>{console.error(e.message);process.exitCode=1;});\n"
