const fs=require('fs'),cp=require('child_process'),assert=require('assert/strict'),out='logs/history-save-repair-20261005/s6';const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S6'}),encoding:'utf8'});assert.equal(q.status,0);fs.writeFileSync(out+'/status-before-repair.json',q.stdout,{flag:'wx'});const s=JSON.parse(q.stdout);const input={action:'adopt',task_id:s.task.task_id,plan_ref:s.task.adopted_plan_ref,activate:false,focus:false,decision_source:'Current direct human asynchronous answer to disclosed S6 Android scope supplement',decision_text:'补最小 Android 兼容并重验 S6（推荐）',scope_supplement:{step_id:'S6',scope_ref:out+'/scope.md',files:['android/app/src/main/java/com/termlink/app/codex/CodexViewModel.kt','android/app/src/test/java/com/termlink/app/codex/CodexViewModelThreadReadyTest.kt'],authorized:'Confirm exact native/canonical tool key mismatch; minimum owned UI ref alias fix, existing JVM regressions/JDK21 APK build/nonclear install/normal3scenario samephone revalidation',preserve:'Original plan identity/S1-S5dispositions;IPC authority/sharedcontracts/olderrorcleanup unchanged. No Git/close/deploy.'},idempotency_key:'task832-S6-Android-ref-compat-human-scope-20261008-v1'};const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(out+'/decision-result.json',r.stdout,{flag:'wx'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);assert.equal(v.recorded,true);assert.equal(v.association,'applied');assert.equal(v.projection.status,'updated');assert.equal(v.next_step_id,'S6');console.log(JSON.stringify({ref:v.ref,recorded:v.recorded,association:v.association,projection:v.projection.status,next_step:v.next_step_id,issues:v.issues.length}));
