'use strict';
const fs = require('fs'), cp = require('child_process'), assert = require('assert/strict');
const out = 'logs/history-save-repair-20261005/s6';
const call = (command, input) => {
    const r = cp.spawnSync('node', ['.workflow-system/runtime/support/assistance.mjs', command, '--root', '.'], {
        input: JSON.stringify(input), encoding: 'utf8', windowsHide: true
    });
    assert.equal(r.status, 0, r.stderr || r.stdout);
    return { raw: r.stdout, value: JSON.parse(r.stdout) };
};
const before = JSON.parse(fs.readFileSync(out + '/status-before-record.json'));
const parent = before.task;
assert.equal(parent.display_id, 'TASK-20260832');
assert.equal(parent.lifecycle, 'active');
assert.ok(parent.steps.filter(s => s.id !== 'S6').every(s => s.state === 'finished'));
assert.equal(parent.steps.find(s => s.id === 'S6').execution_ref, null);
assert.equal(JSON.parse(fs.readFileSync(out + '/prerequisite-before-record.json')).task.lifecycle, 'closed');
const revision = cp.execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
const audit = JSON.parse(fs.readFileSync(out + '/self-check-corrected.json'));
assert.equal(audit.passed, 38);
assert.equal(audit.total, 38);
assert.equal(revision, audit.head);
const files = [
    'android/app/src/main/java/com/termlink/app/codex/CodexViewModel.kt',
    'android/app/src/test/java/com/termlink/app/codex/CodexViewModelThreadReadyTest.kt',
    'docs/product/plans/PLAN-20261005-codex-history-save-repair.md',
    'docs/product/requirements/REQ-20261005-codex-history-save-repair.md',
    'docs/changes/records/CR-20261008-0135-android-history-detail-alias.md',
    ...fs.readdirSync(out).filter(n => /\.(json|cjs|md|kt|txt|xml)$/.test(n) &&
        !/^(execution-|status-after-|management-after-)/.test(n)).map(n => out + '/' + n),
    'logs/history-save-repair-20261005/s5/repair-final-20261008.json',
    'logs/history-save-repair-20261005/s5/s6-final-20261008.json',
    'logs/history-save-repair-20261005/s5/s6-fixed-final-20261008.json'
];
assert.equal(new Set(files).size, files.length);
for (const f of files) {
    assert.ok(fs.statSync(f).isFile(), f);
    assert.ok(!f.includes('/private/'), f);
}
const input = {
    action: 'execution', task_id: parent.task_id, plan_ref: parent.adopted_plan_ref,
    step_id: 'S6', mode: 'default', source_revision: revision,
    decision_ref: '.workflow-system/records/events/key-d99d9cbfdf82571710ab524da759d74872184e4aafe91bd395b6c8b5f35b3d55.json',
    decision_source: 'Direct human asynchronous answer to disclosed S6 Android scope supplement',
    decision_text: '补最小 Android 兼容并重验 S6（推荐）',
    result: 'S6 execution complete within authorized scope: minimum Android tool detail ref compatibility and independent real N/C/D durable history/ACK/body/selected detail/switch/reopen validation. Await change review; not finished or closed.',
    summary: {
        initial_failure: 'N/C saved full product history but healthy UI lacked product detail buttons. A existing selected detail path worked. Initial observations preserved, not rewritten as PASS.',
        change: 'Only Android CodexViewModel matches actual native tool IDs to owned tool: cache keys, requiring same turn/tool type/operation scope/ref; old keys, batch and truncated refs preserved. Existing ThreadReady tests extended by3. No body/IPC authority/selection/Gateway/shared schema/Node/Rust/source/limit changes.',
        tests: 'New tests on old implementation3fail/0error; after minimum fix four existing JVM suites216/216. JDK21 assembleDebug exit0; project install helper adb install -r Success, DB/preferences byte-preserved during installation.',
        device: 'MQS7N19402011743, fixed installed/build APK sha f148028b15fa3a8dffe63ca483bcda5a1ce9764bbde817e68a357598d25dfd6a; normal existing singleton Gateway/product path and original persistent root/Rust executable; no new model turn.',
        scenarios: 'N11items2refs, C22items4refs with inherited N plus own turn, D(oldA)40items9refs. Each normal view/switch-return/force-stop plain Activity reopen/body and selected product tool detail verified. Product detail469/469/552bytes includes exact command/cwd/output/status/exit/duration.',
        durable: 'Stable stopped phone DB full rows exactly match read-only real product provider DTOs; product_db complete committed range/anchors/coverage. Every detail ref verified. Each3 positive real server ACKs joined to actual phone synced/hash events by sync identity; A STAGED delta only followed by completed chunks/persisted full rows/synced ACK, not misreported as immediate COMMITTED.',
        self_checks: 'Original evidence checker35/38 retained; missing provider payloadBytes field caused instrument comparison failure. Corrected predicate uses actual UTF8 byteLength,38/38. These are evidence assertions, not JVM/E2E test count or formal review.',
        protection: 'All2353 unrelated old phone items exact fields preserved; oldA8legacy rows normally reconciled to40 product rows. Original canonical/source/all59oldrun and72pre-repair run hashes preserved; final80runs no queued/running. DB file changes normal, not claimed unchanged. App/session root remains original, expired session normally replaced and valid session kept, original A selection restored.',
        environment: 'Final App stopped/reverse empty/Asleep OFF/service tracked0+3010 no listener. Basic/mtls/serverconfig hashes unchanged; private raw DB/prefs/logs/APKs/UI retained ignored and excluded from attachments.',
        qualifications: 'Existing64KiB tool retention unchanged. Phone selected tool per case, not all9 delegated detail dialogs; S5 full Gateway detail evidence reused by exact version. Old error bar, B/Q budget and registration candidates remain outside scope. Initial live snapshot/tar/receipt/UI predicate/old-coordinate failures preserved.',
        docs: 'PLAN/REQ/current draft CR synchronized; CR strict and diff-check passed; first Windows PowerShell5 REQ decoder-related failure retained, same UTF8 source validates via pwsh/PowerShell7 strict. REQ in_progress, CR draft/TBD; no Git/review/finish/close/deployment.'
    },
    commands: [
        { command: 'JDK21 gradlew -p android :app:testDebugUnitTest --tests *prefixedToolDetailRefs*', result: 'Old implementation3fail/0error exit1', report_ref: out + '/jvm-before-result.json' },
        { command: 'JDK21 gradlew -p android :app:testDebugUnitTest --tests com.termlink.app.codex.CodexViewModelThreadReadyTest --tests com.termlink.app.codex.data.CodexHistoryWireTest --tests com.termlink.app.codex.data.CodexHistoryRangeStorageTest --tests com.termlink.app.codex.data.CodexHistoryPageHashTest', result: '216/216 exit0', report_ref: out + '/jvm-after-summary.json' },
        { command: 'JDK21 gradlew -p android :app:assembleDebug; project install-debug-apk.ps1 -Serial MQS7N19402011743 -ProjectRoot . -SkipLaunch', result: 'build exit0, install -r Success; cache/prefs preserved', report_ref: out + '/install-preservation.json' },
        { command: 'Project local-dev-server-control start/stop -ProjectRoot . and adb -s MQS7N19402011743 normal selection/product details/plain reopen/stopped backup', result: 'N/C/D separately verified, original root normal single collector; final environment restored', report_ref: out + '/environment-restored.json' },
        { command: 'node logs/history-save-repair-20261005/s6/checks.cjs', result: 'First35/38 diagnostic failure retained; corrected38/38, no business replay', report_ref: out + '/self-check-corrected.json' },
        { command: 'validate-change-record.ps1 / validate-req.ps1 -ProjectRoot . -Strict; git diff --check', result: 'CR PASS; original PowerShell5 REQ failure retained and PowerShell7 same validator PASS; diff-check PASS', report_ref: out + '/docs-validation.json' }
    ],
    remaining_work: [
        'review-change must target this actual832/S6 execution; not formal reviewed or finished/closed by this invocation',
        'REQ in_progress/newCR draftTBD; existing retention, selected phone tools and untouched known problems explicitly qualified',
        'Old3 unassociated management records remain; no new business replay for receipts or invented resolution',
        'S1-S5 finished and833 closed preserved, same original plan/task active; no automatic Git/deployment/task closure'
    ],
    files, idempotency_key: 'task832-S6-Android-tool-ref-compat-real-phone-revalidation-20261008-v1'
};
fs.writeFileSync(out + '/execution-input.json', JSON.stringify(input, null, 2) + '\n', { flag: 'wx' });
const recorded = call('task', input);
fs.writeFileSync(out + '/execution-result.json', recorded.raw, { flag: 'wx' });
assert.equal(recorded.value.recorded, true);
assert.equal(recorded.value.association, 'applied');
assert.equal(recorded.value.projection.status, 'updated');
const after = call('task-status', { detail: 'step', task_ref: parent.task_id, step_id: 'S6' });
fs.writeFileSync(out + '/status-after-execution.json', after.raw, { flag: 'wx' });
assert.equal(after.value.step.execution_ref, recorded.value.ref);
assert.equal(after.value.step.state, 'executed');
assert.equal(after.value.step.review_ref, null);
assert.equal(after.value.step.disposition_ref, null);
assert.equal(after.value.task.lifecycle, 'active');
assert.equal(after.value.task.adopted_plan_ref, parent.adopted_plan_ref);
assert.equal(after.value.next_route, 'review-change');
assert.equal(after.value.next_step_id, 'S6');
console.log(JSON.stringify({ ref: recorded.value.ref, recorded: recorded.value.recorded,
    association: recorded.value.association, projection: recorded.value.projection.status,
    state: after.value.step.state, review: after.value.step.review_status,
    disposition: after.value.step.disposition_ref, next_route: after.value.next_route,
    files: files.length, issues: after.value.issues.length }));
