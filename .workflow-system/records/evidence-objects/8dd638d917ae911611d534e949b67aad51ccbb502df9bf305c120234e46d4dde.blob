const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4/repair-r1';
const task_id='task-7ff69ba8242c90c52f0b93fa1144a655';
const plan_ref='.workflow-system/records/events/key-81e218c75e20e038114c3745822b65db24660581f4d7f6b2751a5bbba3ca7d4e.json';
const review_ref='.workflow-system/records/events/key-f70d47a3fa7402f6ccee4bcfd8de46e18768d4d3395e508df94918c8a52e0e0b.json';
const decision_source='Current human execute-step repair invocation after the S4-R1 review';
const decision_text='[$execute-step](E:\\coding\\TermLink-rust-source-resolution-codex\\.agents\\skills\\execute-step\\SKILL.md) repair';
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
const check=JSON.parse(fs.readFileSync(`${d}/self-check.json`,'utf8'));
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
if(head!==check.head||!check.sources.every(p=>hash(p.path)===p.sha256)||!check.protectedChecks.every(p=>hash(p.path)===p.sha256))throw Error('Execution subject changed');
const saveAction=(label,input)=>{
 fs.writeFileSync(`${d}/${label}-input.json`,JSON.stringify(input,null,2)+'\n');
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});
 fs.writeFileSync(`${d}/${label}-result.json`,r.stdout);
 if(r.status!==0){fs.writeFileSync(`${d}/${label}-error.txt`,r.stderr);throw Error(r.stderr||r.stdout);}
 const result=JSON.parse(r.stdout);console.log(JSON.stringify({label,recorded:result.recorded,ref:result.ref,association:result.association,projection:result.projection}));return result;
};
const decision=saveAction('decision',{action:'review-decision',task_id,plan_ref,step_id:'S4',review_ref,choice:'repair',decision_source,decision_text,idempotency_key:'task20260833-S4-R1-user-repair-choice-20261006-v1'});
const labels=['regression-before','regression-corrected-before','focused-after','final-node','req','cr','diff-check'];
const commands=labels.map(label=>{const r=JSON.parse(fs.readFileSync(`${d}/${label}-result.json`,'utf8'));return{command:r.command,environment:r.environment,result:'exit'+r.exit_code,report_ref:`${d}/${label}.txt`};});
if(JSON.parse(fs.readFileSync(`${d}/final-node-result.json`,'utf8')).exit_code!==0)throw Error('Final check failed');
const collect=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(p=>p.isDirectory()?collect(dir+'/'+p.name):[dir+'/'+p.name]);
saveAction('execution',{action:'execution',task_id,plan_ref,step_id:'S4',mode:'repair',source_revision:head,review_ref,decision_ref:decision.ref,decision_source,decision_text,
 result:'S4-R1 repaired;scoped183/183 PASS;pending new change review and finish;S5 product/provider and832 host/mobile acceptance unchanged',
 summary:{implementation:'Protected target-v2 generic completeness promotion requires identical durable/current physical event observations;changed events still require G1/G2 even on rank increase.',finding:'S4-R1 addressed by code and regression,not formally reviewed/resolved;old needs-repair verdict retained.',validation:'Actual current Rust full batch and original old partial prefix;File negative preflight snapshot/reopen invariance;13 focused and183 final scoped PASS;original failing tests retained.',scope:'Importer,existing realRust tests,REQ/PLAN,new draft CR only;original S4 other changes retained;no Git/service/device/governance/Rust changes',qualification:'Implementation self-check,not formal/independent review or SQLite H1/H3 product/provider acceptance.'},
 commands,remaining_work:['New change review of repaired S4 execution and separate finish','S5 H1/H3 actual SQLite product/provider reopen body and real tool details','832 active/S2 unchanged;Branch and three real-host/mobile acceptance cases;explicit return after833','Three existing management association gaps,S2 vendor offline failure and historical failures retained'],
 files:[...check.sources.map(p=>p.path),...collect(d).filter(p=>!p.endsWith('/execution-input.json')&&!p.endsWith('/execution-result.json')),
 'native/codex-rollout-collector/tests/fixtures/current/delegated-context.jsonl',
 'logs/history-save-repair-20261005/s1/repair-r1/run-1/seeded-analysis/9f09fea249cf87ec5a16f0440db7b935482e142957fb4e5ffdfaa68f138c05b5.json'],
 idempotency_key:'task20260833-S4-R1-repair-execution-20261006-v1'});
