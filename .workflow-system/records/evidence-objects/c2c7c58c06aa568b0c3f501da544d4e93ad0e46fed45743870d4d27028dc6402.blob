'use strict';
// S1 bounded offline diagnosis: retained sources only; isolated process/file stores.
// Never invokes the live service, phone, or a production analyzer request.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const cp = require('node:child_process');
const root = process.cwd();
const out = __dirname;
const priv = path.join(out, 'private');
fs.mkdirSync(priv, { recursive: true });
const { AnalyzerProcessManager } = require(path.join(root, 'src/services/codexRolloutCollector/analyzerProcessManager'));
const { AnalysisBatchImporter, FileAnalysisStore, normalizeTargetBatch } = require(path.join(root, 'src/services/codexRolloutCollector/analysisBatchImporter'));
const { createAnalyzeRequest } = require(path.join(root, 'src/services/codexRolloutCollector/analyzerProtocol'));
const A = '01a0fe25-56a2-7910-ba22-61e8016e8ad9';
const C = '01a10643-ae9b-7cb1-b99b-f19f59acba6c';
const exe = path.join(root, 'native/codex-rollout-collector/target/debug/codex-rollout-collector.exe');
const aSource = 'logs/e2e-validation-20261004/s5/private/c-settled-' + A + '.jsonl';
const cSource = 'logs/e2e-validation-20261004/s5/private/c-settled-' + C + '.jsonl';
const oldStore = 'logs/task005-s2-repair-runtime-2/data/codex-rollout-analysis/7ebafbd2d3b406ee0596cf79203a66a04e36581d7a6ff20ef2ff14a6b4a88406.json';
const hashBytes = b => crypto.createHash('sha256').update(b).digest('hex');
const hash = p => hashBytes(fs.readFileSync(p));
const read = p => JSON.parse(fs.readFileSync(p, 'utf8'));
const save = (name, data) => fs.writeFileSync(path.join(out, name), JSON.stringify(data, null, 2) + '\n', { flag: 'wx' });
const watched = [aSource, cSource, oldStore, exe,
  'logs/e2e-validation-20261003/s2/private/source-a1.jsonl',
  'logs/e2e-validation-20261003/s2/private/product-after.sqlite',
  'logs/e2e-validation-20261004/s4/private/product-final.sqlite',
  'logs/task005-s2-repair-runtime-2/data/codex-history.sqlite',
  'logs/e2e-validation-20261004/s5/self-check.json',
  'logs/e2e-validation-20261004/s5-repair-review/report.md',
  'src/services/codexRolloutCollector/analysisBatchImporter.js',
  'src/services/codexRolloutCollector/analyzerProcessManager.js',
  'src/services/codexRolloutCollector/index.js',
  'native/codex-rollout-collector/src/source/discovery.rs',
  'native/codex-rollout-collector/src/source/lineage.rs',
  'native/codex-rollout-collector/src/codex_wire/decode.rs',
  'native/codex-rollout-collector/src/codex_adapter/mod.rs',
  'native/codex-rollout-collector/vendor/codex/protocol/src/models.rs',
  'native/codex-rollout-collector/vendor/codex/protocol/src/items.rs',
  'docs/codex/codex-rollout-collector-architecture.md'];
const runRoot = 'logs/task005-s2-repair-runtime-2/data/codex-rollout-runs';
watched.push(...fs.readdirSync(runRoot).filter(n => n.endsWith('.json')).map(n => runRoot + '/' + n));
const baseline = watched.map(p => ({ path: p, sha256: hash(p), bytes: fs.statSync(p).size }));
save('baseline.json', { head: cp.execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(), files: baseline });

function shape(record) {
  const p = record.payload || {};
  const item = p.item || p;
  return { type: record.type, payload_type: p.type, payload_keys: Object.keys(p), item_type: item.type, item_keys: Object.keys(item),
    id: item.id, call_id_present: Object.hasOwn(item, 'call_id'), name: item.name, namespace: item.namespace,
    output_type: typeof item.output, output_bytes: typeof item.output === 'string' ? Buffer.byteLength(item.output) : null,
    output_sha256: typeof item.output === 'string' ? hashBytes(item.output) : null };
}
function diffPaths(a, b, prefix = '', result = []) {
  if (JSON.stringify(a) === JSON.stringify(b)) return result;
  if (a && b && typeof a === 'object' && typeof b === 'object' && !Array.isArray(a) && !Array.isArray(b)) {
    for (const key of new Set([...Object.keys(a), ...Object.keys(b)])) diffPaths(a[key], b[key], prefix ? prefix + '.' + key : key, result);
  } else result.push({ path: prefix, previous_type: typeof a, incoming_type: typeof b,
    previous_sha256: hashBytes(JSON.stringify(a) ?? 'undefined'), incoming_sha256: hashBytes(JSON.stringify(b) ?? 'undefined') });
  return result;
}
function errorOf(e) { return { code: e.code, message: e.message, rejection_code: e.rejection_code, details: e.details }; }

async function main() {
  const home = path.join(priv, 'offline-home');
  const sources = [
    { id: A, original: aSource, date: '03' },
    { id: C, original: cSource, date: '04' }
  ];
  for (const s of sources) {
    const dir = path.join(home, 'sessions', '2026', '10', s.date); fs.mkdirSync(dir, { recursive: true });
    s.fixture = path.join(dir, `rollout-2026-10-${s.date}T00-00-00-${s.id}.jsonl`);
    fs.copyFileSync(s.original, s.fixture, fs.constants.COPYFILE_EXCL);
  }
  const aRecords = fs.readFileSync(aSource, 'utf8').trim().split('\n').map(JSON.parse);
  const cRecords = fs.readFileSync(cSource, 'utf8').trim().split('\n').map(JSON.parse);
  const aMeta = aRecords.find(r => r.type === 'session_meta').payload;
  const cMeta = cRecords.find(r => r.type === 'session_meta').payload;
  const base = cMeta.history_base;
  const cutBytes = fs.readFileSync(aSource).subarray(0, base.end_byte_offset);
  const old = read(oldStore);
  const seededStore = new FileAnalysisStore({ rootDir: path.join(priv, 'seeded-analysis') });
  const seeded = await new AnalysisBatchImporter({ store: seededStore }).init();
  const seeds = [];
  for (const s of old.staging) {
    const batch = { protocol_version: 1, message_type: 'batch', job_id: s.job_id, request_id: s.request_id, segment_id: s.segment_id, batch_id: s.batch_id, payload: s.payload };
    const result = await seeded.importBatch(batch);
    seeds.push({ job_id: s.job_id, batch_id: s.batch_id, range: s.source_range, persisted: result.persisted });
  }
  const cleanStore = new FileAnalysisStore({ rootDir: path.join(priv, 'fresh-analysis') });
  const clean = await new AnalysisBatchImporter({ store: cleanStore }).init();
  const manager = new AnalyzerProcessManager({ analyzerPath: exe, cwd: root, env: { CODEX_HOME: home }, requestTimeoutMs: 15000 });
  let captured;
  const results = { layer: 'isolated real analyzer protocol + isolated durable FileAnalysisStore; no product DB/App E2E',
    input_policy: 'Only retained frozen private snapshots read. Exact bytes kept for original-failure mechanism; raw input/output stay ignored private. Safe report contains structure/IDs/hashes only.',
    binary_sha256: hash(exe), fixture_bytes_equal: sources.map(s => ({ id: s.id, matches: hash(s.original) === hash(s.fixture) })),
    physical_parent: { parent_id: aMeta.id, child_id: cMeta.id, history_base: base, parent_bytes: fs.statSync(aSource).size,
      cut_within_parent: base.end_byte_offset <= fs.statSync(aSource).size, cut_newline: cutBytes.at(-1) === 10,
      cut_records: cutBytes.toString('utf8').trim().split('\n').length },
    carriers: [7,8].map(ordinal => ({ ordinal, ...shape(aRecords[ordinal]) })), seeds, requests: [] };
  try {
    await manager.start();
    for (const [label, conversationId, importer] of [['H1-seeded', A, seeded], ['H1-fresh', A, clean], ['H2-child', C, clean]]) {
      const observed = { label, conversation_id: conversationId, batch_count: 0, importer_errors: [] };
      try {
        const complete = await manager.request(createAnalyzeRequest({ requestId: 's1-offline-' + label, jobId: 's1-offline-job-' + label, conversationId, mode: 'backfill' }), {
          timeoutMs: 15000,
          onBatch: async batch => {
            observed.batch_count++;
            if (conversationId === A) captured = batch;
            observed.batch = { scope: normalizeTargetBatch(batch).scope, source_range: batch.payload.source_range, completeness: batch.payload.completeness,
              item_count: batch.payload.history_items.length, tool_details_count: batch.payload.tool_details.length,
              diagnostic_summary: batch.payload.diagnostics.map(d => ({ code: d.code, message: d.message, item_key: d.item_key })).filter(d => d.code === 'parse_gap') };
            try { return await importer.importBatch(batch); }
            catch (e) { observed.importer_errors.push(errorOf(e)); throw e; }
          }
        });
        observed.complete = { status: complete.status, completeness: complete.completeness, checkpoint_end: complete.checkpoint?.source?.source_range?.end };
      } catch (e) { observed.terminal_error = errorOf(e); }
      results.requests.push(observed);
    }
  } finally { await manager.stop(); }
  if (captured) {
    const comparisons = [];
    for (const incoming of captured.payload.history_items) {
      const previous = old.items.find(r => r.event_id === incoming.payload?.metadata?.event_id);
      if (previous && JSON.stringify(previous.event) !== JSON.stringify(incoming)) comparisons.push({ event_type: incoming.event_type, event_id: incoming.payload?.metadata?.event_id, item_key: incoming.payload?.metadata?.item_key, changed_paths: diffPaths(previous.event, incoming) });
    }
    results.changed_history_events = comparisons;
    // Preserve batch only as ignored private diagnostic input, never an attachment.
    fs.writeFileSync(path.join(priv,'captured-a-batch.json'),JSON.stringify(captured),{flag:'wx'});
  }
  const after = baseline.map(b => ({ path: b.path, original_sha256: b.sha256, sha256: hash(b.path), unchanged: hash(b.path) === b.sha256 }));
  results.preservation = { checked: after.length, changed: after.filter(x => !x.unchanged), tracked_diff: cp.execFileSync('git', ['diff', '--name-only'], { encoding: 'utf8' }), index_diff: cp.execFileSync('git', ['diff', '--cached', '--name-only'], { encoding: 'utf8' }) };
  save('preservation.json', after); save('diagnosis.json', results);
  console.log(JSON.stringify({ binary: results.binary_sha256, parent: results.physical_parent, requests: results.requests, changed_history_events: results.changed_history_events, preservation: results.preservation }));
}
main().catch(e => { fs.writeFileSync(path.join(out,'diagnostic-failure.json'),JSON.stringify(errorOf(e),null,2)+'\n',{flag:'wx'}); console.error(e.stack); process.exitCode = 1; });
