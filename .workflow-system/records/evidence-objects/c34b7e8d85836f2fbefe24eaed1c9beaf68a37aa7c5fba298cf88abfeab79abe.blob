'use strict';
const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict');const out=__dirname,rel='logs/history-save-repair-20261005/s5',sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const call=(cmd,input,name)=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs',cmd,'--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(out,name+'.json'),r.stdout,{flag:'wx'});assert.equal(r.status,0,r.stderr||r.stdout);return JSON.parse(r.stdout);};
const before=call('task-status',{detail:'step',task_ref:'TASK-20260832',step_id:'S5'},'status-before-record');assert.equal(before.step.state,'not-started');const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();assert.equal(head,'32c6b66179ac314321540fab3b0a82b56050e317');
const files=fs.readdirSync(out,{withFileTypes:true}).filter(e=>e.isFile()&&!e.name.startsWith('status-')&&!e.name.startsWith('execution-')).map(e=>rel+'/'+e.name);files.push('docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/changes/records/CR-20261007-1242-live-history-save-validation.md');
const input={action:'execution',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S5',mode:'default',source_revision:head,result:'partial: real ordinary N canonical/product_db body+details verified; old native C recovered; new N→C own turn awaiting human normal input; old delegated A still fails checkpoint reducer comparison and is unpublished',summary:{binary_sha256:'f0cd1b37ff02d0a023ff77d96b9e4be103507965afde20c4e3207b6dfcd3ec2e',root:'logs/task005-s2-repair-runtime-2',scope:'Original normal server/Node→Rust and product DB path; external rollout readonly; native fork, bounded human N turn; no production source/schema/budget/IPC/Android/Git/deploy modifications',qualification:'Partial execution self-check only, no formal or independent review, finish or close. New C own turn and S6 not run. Gateway diagnostic reader sends no App ACK.',issues:['ANALYSIS_CHECKPOINT_REDUCER_MISMATCH on real old A new v2 canonical batch; staging/receipt are not publication','Old budget failures retained','Initial diagnostic hash/coverage/duration/session assertions corrected from native observed schema; original false outputs retained, no business replay','3 historical unassociated management records retained']},commands:[{command:'local-dev-server-control status/start/stop -ProjectRoot .; original root/analyzer env, port3010',result:'started own singleton; all runs settled; restored stopped status'},{command:'human ordinary N input; native same-directory fork N→C',result:'N completed, C header history_base verified; C own turn pending'},{command:'node '+rel+'/select.cjs N/n/101 then D/d/102',result:'N healthy surface and canonical publication; D no target surface; previous startup D failure retained'},{command:'node '+rel+'/product-read.cjs N/n then D/d',result:'N actual product_db complete page and details; inline hash diagnostic misassertion retained; D cache_only/history_product_not_found'},{command:'node '+rel+'/audit-wire.cjs n',result:'13/13 same saved wire corrected contentHash/detail checks'},{command:'node '+rel+'/checks.cjs final final-self-check.json',result:'17/17 evidence checks; initial15/18 retained'},{command:'validate-change-record.ps1 -RecordPath docs/changes/records/CR-20261007-1242-live-history-save-validation.md -Strict',result:'PASS; rollback Git command warning, no production code or Git changes'}],remaining_work:['Continue S5 after human ordinary C input: inherited N+new C body/details and N protection','Real delegated A remains unpublished: compare exact checkpoint/batch reducer state, locate owner/minimal fix; do not delete old checkpoint/receipt or substitute fresh sample/root','S5 change review and eventual explicit finish remain; S6 specified phone product_db/durable ACK/switch/reopen not run','No Git operations; PLAN/CR and current durable workflow records uncommitted; spike Cargo.lock untouched','3 historical management association gaps retained'],files,idempotency_key:'task20260832-S5-live-partial-execution-20261007-v1'};
fs.writeFileSync(path.join(out,'execution-input.json'),JSON.stringify(input,null,2)+'\n',{flag:'wx'});const result=call('task',input,'execution-result');assert.equal(result.recorded,true);assert.equal(result.association,'applied');assert.equal(result.projection.status,'updated');
const after=call('task-status',{detail:'step',task_ref:'TASK-20260832',step_id:'S5'},'status-after-record');assert.equal(after.step.execution_ref,result.ref);assert.equal(after.step.disposition_ref,null);assert.equal(after.step.review_ref,null);assert.equal(after.current_task_id,before.current_task_id);assert.equal(after.next_step_id,'S5');
const a=JSON.parse(fs.readFileSync(result.ref.replace('/events/','/attachments/'))).attachments.map(x=>({path:x.source_path,sha256:x.sha256,fixed_matches:sha(x.ref)===x.sha256,live_matches:sha(x.source_path)===x.sha256}));assert.ok(a.every(x=>x.live_matches&&x.fixed_matches));fs.writeFileSync(path.join(out,'attachment-readback.json'),JSON.stringify(a,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({ref:result.ref,recorded:result.recorded,association:result.association,projection:result.projection,state:after.step.state,next_step:after.next_step_id,next_route:after.next_route,finish:after.step.disposition_ref,attachments:a.length,all_match:true}));
