const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'),save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n');
const query=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S3'}),encoding:'utf8'});assert.equal(query.status,0,query.stderr);const status=JSON.parse(query.stdout);save('status-before',status);assert.equal(status.step.execution_ref,'.workflow-system/records/events/key-84446cf3e9320397d5eb4b52002da9f98e6a9f12733127705641dff1bcf90f29.json');assert.equal(status.step.review_ref,null);assert.equal(status.current_task_id,status.task.task_id);
const attachments=JSON.parse(fs.readFileSync(status.step.execution_ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));
const check=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s3/repair-r1/self-check.json','utf8'));const subjects=check.subjects.map(p=>({...p,matches:hash(p.path)===p.sha256})),protect=check.protectedSubjects.map(p=>({...p,matches:hash(p.path)===p.sha256}));assert.ok([...subjects,...protect].every(p=>p.matches));assert.equal(hash(check.binary.path),check.binary.sha256);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),check.head);
const oldReview='.workflow-system/records/events/key-aeb521d60861069c8ab289726c2d0160bcd86d0c05de1515c3bb119f1abe562f.json';const old=JSON.parse(fs.readFileSync(oldReview,'utf8'));assert.equal(old.payload.request.verdict,'findings');assert.equal(old.payload.request.findings[0].id,'832-S3-R1');
const results=['branch-5','target-1','req-2','cr-2','diff-1','fmt-2'].map(n=>{const p=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s3/repair-r1/'+n+'-result.json','utf8'));assert.equal(p.exit_code,0);return{name:n,...p};});
const processTraces=['parent-bounded','branch-default','branch-bounded'].map(n=>{const trace=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s3/repair-r1/'+n+'-trace.json','utf8'));assert.equal(trace.binary.sha256,check.binary.sha256);const batch=trace.trace.find(p=>p.direction==='output'&&p.message.message_type==='batch').message;assert.equal(batch.payload.completeness,'canonical');assert.equal(trace.result.message_type,'complete');return{name:n,limits:trace.limits,completeness:batch.payload.completeness,result:trace.result.message_type};});
save('audit',{head:check.head,execution_ref:status.step.execution_ref,oldReview,attachments,subjects,protect,binary:check.binary,results,processTraces});console.log(JSON.stringify({target:status.step.execution_ref,state:status.step.state,review:status.step.review_status,attachments:attachments.length,all_match:true,subjects:subjects.length,protected:protect.length,binary:check.binary,originalR1:'preserved',processTraces}));
