const fs=require('fs'),cp=require('child_process'),path=require('path');
const label=process.argv[2],args=process.argv.slice(3),r=cp.spawnSync('node',args,{encoding:'utf8',maxBuffer:8*1024*1024});fs.writeFileSync(path.join(__dirname,label+'.txt'),r.stdout+r.stderr,{flag:'wx'});const result={command:['node',...args],exit_code:r.status,error:r.error?.message};fs.writeFileSync(path.join(__dirname,label+'-result.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));console.log((r.stdout+r.stderr).split('\n').filter(l=>/^# (tests|pass|fail|duration_ms)|^not ok/.test(l)).join('\n'));process.exitCode=r.status||0;
