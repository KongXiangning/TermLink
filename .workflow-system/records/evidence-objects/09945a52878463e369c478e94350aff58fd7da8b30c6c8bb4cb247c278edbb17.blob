const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4';
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const baseline=JSON.parse(fs.readFileSync(d+'/baseline.json','utf8'));
const protectedChecks=baseline.protected.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const beforeChecks=baseline.before.map(p=>({path:p.path,matches:hash(p.snapshot)===p.sha256}));
const historical=['key-133d6c3b6cac6f1b6a502ab2dc2c76c61e198c19ee1324bda700d90326895382','key-9cbd6bc83843db4a56ee72e21b8e0ae7ce207880b53a8837244a8b30dc5f084e'].map(key=>{
 const manifest=JSON.parse(fs.readFileSync('.workflow-system/records/attachments/'+key+'.json','utf8'));
 const values=manifest.attachments||manifest.files;
 return {key,count:values.length,all_fixed_match:values.every(p=>hash(p.ref)===p.sha256)};
});
const fixture='native/codex-rollout-collector/tests/fixtures/current/delegated-context.jsonl';
const original='logs/history-save-repair-20261005/s1/repair-r1/fixtures-v2/a-full.jsonl';
const seed='logs/history-save-repair-20261005/s1/repair-r1/run-1/seeded-analysis/9f09fea249cf87ec5a16f0440db7b935482e142957fb4e5ffdfaa68f138c05b5.json';
const changed=cp.execFileSync('git',['diff','--name-only'],{encoding:'utf8'}).trim().split(/\r?\n/).filter(Boolean);
const allowed=new Set(baseline.before.map(p=>p.path));
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
const result={qualification:'implementation-self-check-not-formal-review',head,head_unchanged:head===baseline.head,protectedChecks,beforeChecks,historical,fixture:{path:fixture,sha256:hash(fixture),matches_original:hash(fixture)===hash(original)},historical_seed:{path:seed,sha256:hash(seed)},scope:{changed,all_in_scope:changed.every(p=>allowed.has(p)),no_native_governance_IPC_android_changes:changed.every(p=>!p.startsWith('native/')&&!p.startsWith('docs/workflow/')&&!p.startsWith('android/')&&!p.startsWith('.workflow-system/runtime/'))}};
fs.writeFileSync(d+'/self-check.json',JSON.stringify(result,null,2)+'\n');
fs.writeFileSync(d+'/source-after.json',JSON.stringify([...changed,'docs/changes/records/CR-20261006-0200-shared-history-node-consumer.md'].map(path=>({path,sha256:hash(path)})),null,2)+'\n');
console.log(JSON.stringify({head,protected:protectedChecks.every(p=>p.matches),before:beforeChecks.every(p=>p.matches),historical:historical.every(p=>p.all_fixed_match),scope:result.scope}));
