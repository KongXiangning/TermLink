// One-off S1 design probe. No analyzer, source read, store or test runner is started.
const fs = require('node:fs');
const vm = require('node:vm');
const assert = require('node:assert/strict');
const { createAnalyzeRequest } = require('../../../../src/services/codexRolloutCollector/analyzerProtocol');
const testSource = fs.readFileSync('tests/codexRolloutCollector.test.js', 'utf8');
function helper(start, end) {
    const from = testSource.indexOf('function ' + start + '(');
    const to = testSource.indexOf('function ' + end + '(', from);
    assert.ok(from >= 0 && to > from);
    return testSource.slice(from, to);
}
const fixtureContext = {};
vm.runInNewContext(helper('targetCursor', 'targetHistoryEvent')
    + helper('targetCheckpoint', 'resizeTargetCheckpoint')
    + '\nfixture = targetCheckpoint({cursor: targetCursor({cursorKind: "forward_append"})});', fixtureContext);
const oldAnchor = JSON.parse(JSON.stringify(fixtureContext.fixture));
oldAnchor.reducer_state.reducer_version = 'target-v1';
const original = JSON.stringify(oldAnchor);
const observations = [];
function passes(name, options) {
    const request = createAnalyzeRequest(options);
    observations.push({ name, result: 'accepted-by-existing-node-request-validator', request });
    return request;
}
function rejects(name, options, expected) {
    assert.throws(() => createAnalyzeRequest(options), expected);
    observations.push({ name, result: 'expected-rejection', expected: String(expected) });
}
const oldRequest = {
    requestId: 's1-probe-original-request', jobId: oldAnchor.job_id,
    conversationId: oldAnchor.conversation_id, mode: 'backfill',
    cursor: oldAnchor.cursor, persistedAnchor: oldAnchor
};
passes('old non-null checkpoint is structurally valid with matching cursor', oldRequest);
rejects('original design null cursor plus unchanged old anchor',
    { ...oldRequest, requestId: 's1-probe-invalid', jobId: 's1-probe-new-job', cursor: null },
    /cursor must match persisted_anchor.cursor/);
const fresh = passes('repaired independent ordinary backfill has no inherited recovery fields', {
    requestId: 's1-probe-new-request', jobId: 's1-probe-new-job',
    conversationId: oldAnchor.conversation_id, mode: 'backfill',
    cursor: null, persisted_anchor: null, known_complete_range: null, recovery: null
});
assert.notEqual(fresh.job_id, oldAnchor.job_id);
for (const field of ['cursor', 'persisted_anchor', 'known_complete_range', 'recovery']) {
    assert.equal(fresh[field], null);
}
rejects('append still rejects unequal cursor and anchor',
    { ...oldRequest, requestId: 's1-probe-append', mode: 'append', cursor: null },
    /cursor must match persisted_anchor.cursor/);
rejects('backfill still rejects wrong checkpoint conversation',
    { ...oldRequest, requestId: 's1-probe-wrong-conversation', conversationId: 'different-conversation' },
    /conversation_id must match analyze conversation_id/);
assert.equal(JSON.stringify(oldAnchor), original);
observations.push({ name: 'old checkpoint unchanged', result: 'byte-equivalent JSON' });
console.log(JSON.stringify({
    scope: 'Existing Node wire request validation only; synthetic fixture from existing pure helpers. No source read, checkpoint persistence, profile negotiation, Rust process, G1 merge or business PASS.',
    fixture_source: 'tests/codexRolloutCollector.test.js:targetCursor/targetCheckpoint',
    observations
}, null, 2));
