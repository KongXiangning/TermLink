const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const base=JSON.parse(fs.readFileSync(path.join(d,'baseline.json'),'utf8'));const protectedSubjects=base.protect.map(p=>({...p,matches:hash(p.path)===p.sha256}));assert.ok(protectedSubjects.every(p=>p.matches));assert.equal(hash(base.binary.path),base.binary.sha256);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),base.head);
const subjects=[...base.subjects.map(p=>p.path),'docs/changes/records/CR-20261007-0245-branch-product-delivery.md'].map(p=>({path:p,sha256:hash(p)}));const changed=base.subjects.filter(p=>hash(p.path)!==p.sha256).map(p=>p.path);assert.deepEqual(changed,['tests/codexHistoryProductFlow.test.js','docs/product/plans/PLAN-20261005-codex-history-save-repair.md']);
const artifacts=['H1-backfill','H1-append','H3-reopen-conflict','H2-branch-restart'].map(n=>{const p=path.join(d,'evidence/product',n+'.json'),v=JSON.parse(fs.readFileSync(p,'utf8'));assert.equal(v.history.coverage.completeness,'canonical');assert.equal(v.checkpoint.completeness,'canonical');return{name:n,path:p,sha256:hash(p),items:v.history.items.length,details:v.history.toolDetails.length};});
const h2=JSON.parse(fs.readFileSync(path.join(d,'evidence/product/H2-branch-restart.json'),'utf8'));const batches=h2.first.messages.filter(p=>p.message_type==='batch');assert.equal(batches.length,1);assert.ok(batches[0].payload.history_items.every(p=>p.payload.metadata.conversation_id==='00000000-0000-4000-8000-000000000002'));assert.ok(batches[0].payload.history_items.some(p=>p.payload.metadata.source_ref.source_identity==='00000000-0000-4000-8000-000000000001'));assert.equal(batches[0].payload.replacements.length,0);assert.ok(!batches[0].payload.mutations.some(p=>p.mutation==='replace_last_turn'));
assert.ok(JSON.stringify(h2.first_readback.body.items).includes('branch own answer'));assert.ok(!JSON.stringify(h2.history).includes('parent after cut'));assert.deepEqual(h2.history,h2.before_rejection.history);assert.deepEqual(h2.checkpoint,h2.before_rejection.checkpoint);assert.equal(h2.history.items.filter(p=>p.itemType==='delegated_input').length,3);assert.ok(h2.history.items.filter(p=>p.itemType==='delegated_input').every(p=>p.payload.role==='system'&&p.payload.tool===null&&p.payload.eventFacts.length===2));assert.deepEqual(JSON.parse(JSON.parse(h2.detail.content).input),{command:['cargo','test','--locked'],cwd:'file:///synthetic/private/workspace'});
for(const n of ['branch-1','product-1','req-1','cr-1','diff-1'])assert.equal(JSON.parse(fs.readFileSync(path.join(d,n+'-result.json'),'utf8')).exit_code,0);
assert.ok(fs.readFileSync(path.join(d,'product-1.txt'),'utf8').includes('pass 44'));
const out={head:base.head,binary:base.binary,subjects,changed,protectedSubjects,artifacts,qualification:'CurrentNode/product/Rust protocol isolatedsupport;test ACK is actualNode ACK afterdurableSQLite staging,notphoneACK ornaturalhostsource. No productioncode changes.'};fs.writeFileSync(path.join(d,'self-check.json'),JSON.stringify(out,null,2)+'\n');console.log(JSON.stringify({head:base.head,binary:base.binary,changed,protected:protectedSubjects.length,artifacts,all_match:true}));
