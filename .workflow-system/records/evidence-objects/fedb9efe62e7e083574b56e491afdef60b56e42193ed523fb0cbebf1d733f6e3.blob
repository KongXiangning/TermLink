const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict'),out=__dirname,rel='logs/history-save-repair-20261005/s5/resume-20261008',sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
