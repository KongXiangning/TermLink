const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d='logs/history-save-repair-20261005/s2/review-20261007';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const save=(n,v)=>fs.writeFileSync(`${d}/${n}.json`,JSON.stringify(v,null,2)+'\n');
function query(task,detail,step,label){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({task_ref:task,detail,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);save(label,v);return v;}
const parent=query('TASK-20260832','step','S2','status-832-before');
const parentTask=query('TASK-20260832','task',null,'task-832-before');
const child=query('TASK-20260833','task',null,'task-833-before');
const ref=parent.step.execution_ref,execution=JSON.parse(fs.readFileSync(ref,'utf8')).payload.request;
assert.equal(ref,'.workflow-system/records/events/key-56e67631043abd0af05fa6ce1c8852e2df1e9564c7e919d6233879194db06cd0.json');
const attachments=JSON.parse(fs.readFileSync(ref.replace('/events/','/attachments/'),'utf8')).attachments.map(a=>({path:a.source_path,ref:a.ref,sha256:a.sha256,fixed_matches:hash(fs.readFileSync(a.ref))===a.sha256,live_matches:hash(fs.readFileSync(a.source_path))===a.sha256}));save('execution-attachments',attachments);assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));
const priorAudit=JSON.parse(fs.readFileSync(`${d}/source-applicability.json`,'utf8'));save('initial-audit-failure',{reason:'Raw Git blob hash differs from recorded Windows working-tree bytes for some text subjects;inspect line-ending normalization',mismatches:priorAudit.filter(p=>!p.historical_matches)});
const inventory=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s2/source-inventory.json','utf8')).map(p=>{const old=cp.execFileSync('git',['show',`${execution.source_revision}:${p.path}`],{maxBuffer:16*1024*1024}),raw=hash(old),lf=hash(Buffer.from(old.toString('utf8').replace(/\r\n/g,'\n'))),crlf=hash(Buffer.from(old.toString('utf8').replace(/\r?\n/g,'\r\n')));return{path:p.path,recorded_sha256:p.sha256,git_blob_sha256:raw,historical_raw_matches:raw===p.sha256,historical_matches:[raw,lf,crlf].includes(p.sha256),historical_match_kind:raw===p.sha256?'exact':lf===p.sha256?'LF-normalization':crlf===p.sha256?'CRLF-normalization':'unresolved',current_sha256:hash(fs.readFileSync(p.path)),current_matches:hash(fs.readFileSync(p.path))===p.sha256};});save('source-applicability',inventory);assert.ok(inventory.every(p=>p.historical_matches));
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),status=cp.execFileSync('git',['status','--short'],{encoding:'utf8'});
save('git-before',{head,status});
const getReq=r=>JSON.parse(fs.readFileSync(r,'utf8')).payload.request;
const plan=getReq(parent.task.adopted_plan_ref);save('adopted-plan',plan);
const close={...getReq(child.task.lifecycle_ref),ref:child.task.lifecycle_ref};save('child-close',close);
const brief={head,parent:{lifecycle:parent.task.lifecycle,step:parent.step.state,execution:ref,review:parent.step.review_status,disposition:parent.step.disposition_ref,route:parentTask.task.next_route,mode:parentTask.task.next_mode},child:{lifecycle:child.task.lifecycle,origin:child.task.origin,dependency:child.task.dependency,return_result:child.task.return_result,close_ref:close?.ref},focus:parent.focus,current_task_id:parent.current_task_id,attachments:attachments.length,all_fixed_live_match:true,inventory:inventory.length,historical_all_match:true,current_changed:inventory.filter(p=>!p.current_matches).map(p=>p.path),plan_steps:plan.plan?.steps,close:close};save('summary',brief);console.log(JSON.stringify({...brief,plan_steps:brief.plan_steps?.map(s=>({id:s.id,title:s.title,actions:s.actions})),close:close&&{ref:close.ref,remaining_work:close.remaining_work,gaps:close.gaps,decision_source:close.decision_source,decision_text:close.decision_text}},null,2));
