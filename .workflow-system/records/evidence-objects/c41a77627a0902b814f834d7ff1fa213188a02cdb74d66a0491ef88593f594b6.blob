const fs=require('fs'),cp=require('child_process'),d=__dirname,phase=process.argv[2],size=process.argv[3];if(!/^[a-z0-9-]+$/.test(phase||'')||!/^\d+$/.test(size||''))throw Error('phase and expected detail bytes required');const f=d+'/tap-'+phase+'.json',fd=fs.openSync(f,'wx'),args=['-s','MQS7N19402011743'];try{cp.execFileSync('adb',[...args,'shell','input','keyevent','KEYCODE_WAKEUP']);const remote='/data/local/tmp/tl832-s6-tap-'+phase+'.xml';cp.execFileSync('adb',[...args,'shell','uiautomator','dump',remote]);const xml=cp.execFileSync('adb',[...args,'exec-out','cat',remote],{encoding:'utf8'});fs.writeFileSync(d+'/private/tap-'+phase+'.xml',xml,{flag:'wx'});const nodes=[...xml.matchAll(/<node\b[^>]*>/g)].map(m=>({text:m[0].match(/\btext="([^"]*)"/)?.[1],bounds:m[0].match(/bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"/)?.slice(1).map(Number)})).filter(n=>n.text?.startsWith('查看历史详情')&&n.text.includes(size+' 字节')&&n.bounds&&n.bounds[3]<1900&&n.bounds[1]>220);const selected=nodes.sort((a,b)=>b.bounds[1]-a.bounds[1])[0];if(!selected)throw Error('No current visible detail button for '+size+' bytes');const [x1,y1,x2,y2]=selected.bounds,r=cp.spawnSync('adb',[...args,'shell','input','tap',String(Math.round((x1+x2)/2)),String(Math.round((y1+y2)/2))],{encoding:'utf8'});const result={phase,at:new Date().toISOString(),selected,exit:r.status};fs.writeFileSync(fd,JSON.stringify(result,null,2));console.log(JSON.stringify(result));}catch(e){fs.writeFileSync(fd,JSON.stringify({phase,error:e.message}));throw e;}finally{fs.closeSync(fd);}
