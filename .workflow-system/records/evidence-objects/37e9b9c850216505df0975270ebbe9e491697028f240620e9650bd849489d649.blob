const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,base='logs/history-save-repair-20261005/s4',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'),save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n');
const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S4'}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const status=JSON.parse(q.stdout);save('status-before',status);assert.equal(status.step.execution_ref,'.workflow-system/records/events/key-8ddef1358f673636db8e4923d31b087c504694e05340b8cb94dd2e0757671df0.json');assert.equal(status.step.review_ref,null);assert.equal(status.current_task_id,status.task.task_id);
const attachments=JSON.parse(fs.readFileSync(status.step.execution_ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));
const check=JSON.parse(fs.readFileSync(base+'/self-check.json','utf8')),subjects=check.subjects.map(p=>({...p,matches:hash(p.path)===p.sha256})),protect=check.protectedSubjects.map(p=>({...p,matches:hash(p.path)===p.sha256}));assert.ok([...subjects,...protect].every(p=>p.matches));assert.equal(hash(check.binary.path),check.binary.sha256);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),check.head);
const p=JSON.parse(fs.readFileSync(base+'/evidence/product/H2-branch-restart.json','utf8'));
function order(audit){const publications=[];for(const [i,e] of audit.trace.entries()){if(e.phase!=='publishCanonical'||e.returned!=='published')continue;const earlier=audit.trace.slice(0,i);const ack=earlier.findLastIndex(v=>v.phase==='actual-ack-write'&&v.accepted&&v.persisted&&v.batch_id===e.batch_id),reopen=earlier.findLastIndex(v=>v.phase==='durable-reopen-before-ack'&&v.batch_id===e.batch_id),complete=earlier.findLastIndex(v=>v.phase==='actual-rust-complete'&&v.batch_id===e.batch_id),commit=earlier.findLastIndex(v=>v.phase==='publishCanonical'&&v.sql==='COMMIT'),stage=earlier.slice(0,reopen).findLastIndex(v=>v.phase==='stageBatch'&&v.sql==='COMMIT');assert.ok(stage>=0&&stage<reopen&&reopen<ack&&ack<complete&&complete<commit&&commit<i);publications.push({batch_id:e.batch_id,stage,reopen,ack,complete,commit,published:i});}assert.ok(publications.length);return publications;}
const orderProof={parent:order(p.parent),first:order(p.first),restarted:order(p.restarted)};
const batches=p.first.messages.filter(v=>v.message_type==='batch');assert.equal(batches.length,1);const batch=batches[0];assert.equal(batch.payload.conversation_id,'00000000-0000-4000-8000-000000000002');assert.ok(batch.payload.history_items.every(v=>v.payload.metadata.conversation_id===batch.payload.conversation_id));assert.ok(batch.payload.history_items.some(v=>v.payload.metadata.source_ref.source_identity==='00000000-0000-4000-8000-000000000001'));assert.equal(batch.payload.replacements.length,0);assert.ok(batch.payload.mutations.every(v=>v.mutation!=='replace_last_turn'));
assert.ok(JSON.stringify(p.first_readback.body.items).includes('branch own question'));assert.ok(JSON.stringify(p.first_readback.body.items).includes('branch own answer'));assert.ok(!JSON.stringify(p.history).includes('parent after cut'));assert.deepEqual(p.history,p.before_rejection.history);assert.deepEqual(p.checkpoint,p.before_rejection.checkpoint);assert.equal(new Set(p.history.items.map(v=>v.itemKey)).size,p.history.items.length);const delegated=p.history.items.filter(v=>v.itemType==='delegated_input');assert.equal(delegated.length,3);assert.deepEqual(delegated.map(v=>v.payload.content),['[sanitized delegation 1]','[sanitized delegation 2]','[sanitized delegation 3]']);assert.ok(delegated.every(v=>v.payload.role==='system'&&v.payload.tool===null&&v.payload.eventFacts.length===2));
const detail=JSON.parse(p.detail.content);assert.equal(detail.call_id,'command-1');assert.deepEqual(JSON.parse(detail.input),{command:['cargo','test','--locked'],cwd:'file:///synthetic/private/workspace'});assert.equal(detail.output,'status=completed; exit_code=0; duration_ms=1000; output=1 passed\n');assert.deepEqual(p.detail,p.first_readback.detail);
const rejection=p.restarted.messages.find(v=>v.message_type==='error'&&v.request_id==='h2-wrong-binding');assert.equal(rejection.code,'batch_rejected');assert.equal(rejection.details.rejection_code,'batch_validation_failed');assert.ok(p.restarted.trace.some(v=>v.phase==='actual-ack-write'&&!v.accepted&&!v.persisted));assert.ok(!p.restarted.messages.some(v=>v.message_type==='complete'&&v.request_id==='h2-wrong-binding'));
const results=['product-1','branch-1','req-1','cr-1','diff-1'].map(n=>{const v=JSON.parse(fs.readFileSync(base+'/'+n+'-result.json','utf8'));assert.equal(v.exit_code,0);return{name:n,...v};});assert.ok(fs.readFileSync(base+'/product-1.txt','utf8').includes('pass 44'));
const diff=cp.spawnSync('git',['diff','--no-index','--',base+'/before/tests__codexHistoryProductFlow.test.js','tests/codexHistoryProductFlow.test.js'],{encoding:'utf8'});assert.equal(diff.status,1);fs.writeFileSync(path.join(d,'test-diff.txt'),diff.stdout);
save('audit',{head:check.head,binary:check.binary,execution_ref:status.step.execution_ref,attachments,subjects,protect,results,orderProof,rejection,detail,qualification:'Read-only self-review reusing actual44test outputs/artifacts withcurrenthash;no newbusiness test run'});console.log(JSON.stringify({head:check.head,execution_ref:status.step.execution_ref,state:status.step.state,attachments:attachments.length,all_match:true,subjects:subjects.length,protected:protect.length,publications:Object.fromEntries(Object.entries(orderProof).map(([k,v])=>[k,v.length])),rejection:rejection.code,binary:check.binary}));
