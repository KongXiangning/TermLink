const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,rel='logs/history-save-repair-20261005/s3/repair-r1',save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n'),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
function status(task,step,name){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:step?'step':'task',task_ref:task,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);save(name,v);return v;}
function action(input,name){save(name+'-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(d,name+'-result.json'),r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);console.log(JSON.stringify({operation:name,recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));assert.equal(out.recorded,true);assert.equal(out.association,'applied');assert.equal(out.projection.status,'updated');return out;}
const before=status('TASK-20260832','S3','status-record-before'),base=JSON.parse(fs.readFileSync(path.join(d,'baseline.json'),'utf8')),check=JSON.parse(fs.readFileSync(path.join(d,'self-check.json'),'utf8'));
assert.equal(before.step.review_ref,base.review_ref);assert.equal(before.step.review_status,'findings');assert.equal(before.current_task_id,before.task.task_id);assert.equal(before.step.disposition_ref,null);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),base.head);assert.ok([...check.subjects,...base.protect].every(p=>hash(p.path)===p.sha256));assert.equal(hash(check.binary.path),check.binary.sha256);
const decision=action({action:'review-decision',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S3',review_ref:base.review_ref,choice:'repair',decision_source:'Current human explicit execute-step repair on focused832/S3 afterR1 review',decision_text:'[$execute-step](E:\\coding\\TermLink-rust-source-resolution-codex\\.agents\\skills\\execute-step\\SKILL.md) repair',remaining_work:['R1 repair implemented/selfchecked,needsnewexecution review;oldverdictnotchanged','S3finish andS4S6product/realhost/phone acceptance remainpending'],idempotency_key:'task20260832-S3-R1-repair-decision-20261007'},'decision');
const collect=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(p=>p.isDirectory()?collect(dir+'/'+p.name):[dir+'/'+p.name]);
const commands=fs.readdirSync(d).filter(n=>n.endsWith('-result.json')&&!n.startsWith('decision')&&n!=='repro-result.json').map(n=>{const p=JSON.parse(fs.readFileSync(path.join(d,n),'utf8'));return{command:p.command,environment:p.environment,result:'exit'+p.exit_code,report_ref:rel+'/'+n.replace('-result.json','.txt')};});
commands.push({command:'node '+rel+'/checks.cjs',result:'PASS source/binary/protection/artifact assertions',report_ref:rel+'/self-check.json'},{command:'node '+rel+'/repro-after.cjs',result:'PASS 3actualRustprocess traces canonical/complete includingoriginalR1budgetcounterexample',report_ref:rel+'/repro-result.json'});
const execution=action({action:'execution',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S3',mode:'repair',source_revision:base.head,review_ref:base.review_ref,decision_ref:decision.ref,repair_of_execution_ref:before.step.execution_ref,result:'R1 implemented/selfchecked: inheritedprefix usesboundedcomplete-line windows ininitialread andappendrecovery;target76/76,branch3/3 PASS;originalbudgetcounterexample nowcanonical;pendingnewchange review',summary:{scope:'target_source.rs/sharedinternalcomplete-line planner,existingtargettests,REQ/PLAN/newdraftCR/logs;noNode/vendor/Android/DB/IPC/publiccontract/budget/external source/Git/deploy changes',semantics:'Perwindow<=segment,aggregate decoded originalguard,spool oldwindows,allwindowrange/parse/pending/shrinkguards andfinalbyte/ordinalcut;noaftercutparentbodyorreplacement',binary:check.binary,qualification:'Implementation self-check only,not newformal/independentreview,notfinish/closeorproduct/mobilePASS. Test ACK fromisolatedclient. Prior74sourcePASS notrecertified current.',failures:'branch1privatefieldscompile,branch2realred,branch3missingborrowcompile,branch4headeronlycheckpointnoformalappend evidence,cr1IDformatfail;outputsretained,currenttestdata correctedwithoutrelaxinggates'},commands,remaining_work:['Newchange review of832S3repair execution then separatefinish;priorreviewfindingsretained','832S4consumer/product andS5S6all3naturalhost/mobile durableACK/body/tool/switch/reopen notrun','Original failures/vendoroffline limit/3oldmanagementassociationgapsretained'],files:[...check.subjects.map(p=>p.path),...collect(rel).filter(p=>!p.endsWith('/execution-input.json')&&!p.endsWith('/execution-result.json'))],idempotency_key:'task20260832-S3-R1-repair-execution-20261007-v1'},'execution');
const after=status('TASK-20260832','S3','status-after'),child=status('TASK-20260833',null,'status-833-after');assert.equal(after.step.execution_ref,execution.ref);assert.equal(after.step.state,'executed');assert.equal(after.step.review_ref,null);assert.equal(after.step.disposition_ref,null);assert.equal(after.next_route,'review-change');assert.equal(after.current_task_id,before.current_task_id);assert.equal(child.task.lifecycle,'closed');
const attachments=JSON.parse(fs.readFileSync(execution.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('attachment-readback',attachments);assert.ok([...check.subjects,...base.protect].every(p=>hash(p.path)===p.sha256));
console.log(JSON.stringify({state:after.step.state,review:after.step.review_status,finish:after.step.disposition_ref,next_route:after.next_route,next_step:after.next_step_id,child:child.task.lifecycle,attachments:attachments.length,all_match:true,issues:after.issues.length}));
