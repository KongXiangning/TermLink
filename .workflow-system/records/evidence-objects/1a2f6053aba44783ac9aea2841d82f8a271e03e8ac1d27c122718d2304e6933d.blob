'use strict';
// Append-only cleanup qualification; never overwrites the failed live-copy check.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
function read(name) { return JSON.parse(fs.readFileSync(path.join(__dirname, name))); }
function hash(bytes) { return crypto.createHash('sha256').update(bytes).digest('hex'); }
const before = read('before.json');
const final = read('restored-final.json');
const preferences = fs.readFileSync(path.join(__dirname, 'private/restored-final/shared_prefs/codex_native_restore.xml'), 'utf8');
const checks = [
  { name: 'App stopped and phone asleep, original absent reverse retained', passed: !final.phone.pid.stdout && final.phone.power === 'mWakefulness=Asleep' && !final.phone.reverse.stdout },
  { name: 'Original A selection persisted, C selection removed', passed: preferences.includes('01a0fe25-56a2-7910-ba22-61e8016e8ad9') && !preferences.includes('01a10643-ae9b-7cb1-b99b-f19f59acba6c') },
  { name: 'Credential/server config hashes retained', passed: ['termlink_server_config.xml','termlink_basic_credentials.xml','termlink_mtls_credentials.xml'].every(name => before.preference_hashes[name] === final.preference_hashes[name]) },
  { name: 'Final stopped phone/product snapshot quick_check ok', passed: final.phone.database.quick_check[0].quick_check === 'ok' && final.product.quick_check[0].quick_check === 'ok' },
  { name: 'A source and existing product canonical retained', passed: before.sources[0].sha256 === final.sources[0].sha256 && before.product.canonical_digest === final.product.canonical_digest }
];
const output = {
  kind: 'S5-final-cleanup-supplement', at: final.at, source_revision: final.head,
  original_self_check: { file: 'self-check.json', passed: read('self-check.json').passed, total: read('self-check.json').total, failures: read('self-check.json').checks.filter(c => !c.passed) },
  checks, passed: checks.filter(c => c.passed).length, total: checks.length,
  failed_live_copy: { phase: 'c-return', actual: read('c-return.json').phone.database.quick_check, qualification: 'Non-quiesced live backup; not certified as corruption of the on-device database. Original failure remains.' },
  final_phone_counts: final.phone.database.counts,
  final_product: final.product,
  changed_preference_files: Object.keys(final.preference_hashes).filter(name => before.preference_hashes[name] !== final.preference_hashes[name]),
  retained_new_transport_session: 'e7fa3165-7355-4556-b8bc-37c0e4a2804d',
  expired_original_transport_session: 'ddf62f0a-f7d4-4ea7-b850-676a0126d61c',
  note: 'Existing server process 83948 remains running; normal app-created transport session and C branch/cache retained. No manual data deletion, model turn, source/config edit, Git stage/commit/push or service restart during cleanup.',
  manifest: ['restore-active-a.json','restored-final.json','finalize.cjs'].map(file => { const bytes = fs.readFileSync(path.join(__dirname, file)); return { file, sha256: hash(bytes), bytes: bytes.length }; })
};
fs.writeFileSync(path.join(__dirname, 'final-cleanup.json'), JSON.stringify(output, null, 2) + '\n', { flag: 'wx' });
console.log(JSON.stringify({ original_evidence_checks: output.original_self_check, cleanup_passed: output.passed, cleanup_total: output.total }));
if (output.passed !== output.total) process.exitCode = 1;
