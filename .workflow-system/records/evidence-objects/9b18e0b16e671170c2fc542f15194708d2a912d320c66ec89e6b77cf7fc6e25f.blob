'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),WebSocket=require('ws');require('dotenv').config({quiet:true});
const {computeHistoryPageHash}=require('../../../../src/services/codexHistorySyncService');
const out=__dirname,priv=path.join(out,'private'),sha=s=>crypto.createHash('sha256').update(s).digest('hex'),sort=x=>Array.isArray(x)?x.map(sort):x&&typeof x==='object'?Object.fromEntries(Object.keys(x).sort().map(k=>[k,sort(x[k])])):x;
(async()=>{const id=process.argv[2],label=process.argv[3],session=JSON.parse(fs.readFileSync(path.join(priv,'session.json'))),auth='Basic '+Buffer.from(`${process.env.AUTH_USER||'admin'}:${process.env.AUTH_PASS||'admin'}`).toString('base64'),ws=new WebSocket('ws://127.0.0.1:3010/ws?sessionId='+session.id,{headers:{Authorization:auth}}),messages=[],items=new Map(),details=new Map(),checks=[],result={id,label,at:new Date().toISOString(),pages:[],checks,diagnostic_ack_count:0,app_durable_ack:false};let error;
 ws.on('message',b=>messages.push(JSON.parse(b)));ws.on('error',e=>error=e.code||e.message);ws.on('close',c=>error=error||'closed '+c);
 const wait=async f=>{const end=Date.now()+10000;while(Date.now()<end){const m=messages.find(f);if(m)return m;if(error)throw Error(error);await new Promise(r=>setTimeout(r,20));}throw Error('bounded wait timeout');},send=m=>ws.send(JSON.stringify(m)),check=(name,pass)=>{checks.push({name,passed:!!pass});if(!pass)throw Error(name);},generation=401;
 try{await wait(m=>m.type==='codex_ipc_status');let range;
 for(let n=0;n<10;n++){
 const syncId=crypto.randomUUID(),common={conversationId:id,syncId,selectionGeneration:generation,cacheSchemaVersion:3,rangeSegments:{enabled:true,version:1,cacheSchemaVersion:3}};
 send(n===0?{type:'conversation_history_sync_request',...common,productHistory:{version:1,detailRefs:true,onlyIfPresent:true},checkpoint:{rootHash:null,itemCount:0,complete:false}}:{type:'conversation_history_older_request',...common,checkpoint:{nextOlderCursor:range.nextOlderCursor,hasMoreBefore:true,rangeId:range.rangeId,providerMode:range.providerMode,providerIdentityHash:range.providerIdentityHash,oldestAnchorKey:range.oldestAnchor.key,oldestAnchorHash:range.oldestAnchor.hash}});
 let first=await wait(m=>m.syncId===syncId&&['conversation_history_manifest_required','conversation_history_delta','conversation_history_sync_state'].includes(m.type));
 if(first.type==='conversation_history_manifest_required')send({type:'conversation_history_manifest_page',conversationId:id,syncId,clientSelectionGeneration:generation,pageIndex:0,lastPage:true,items:[]});
 if(first.type==='conversation_history_sync_state')throw Error(first.state+'/'+first.detailCode);
 for(let pageIndex=0;pageIndex<20;pageIndex++){
 const page=await wait(m=>m.syncId===syncId&&m.type==='conversation_history_delta'&&m.pageIndex===pageIndex);range=page.range;
 check('product DB bound page '+result.pages.length,page.conversationId===id&&range.providerMode==='product_db'&&page.clientSelectionGeneration===generation);check('page hash '+result.pages.length,computeHistoryPageHash(page)===page.pageHash);
 result.pages.push({syncId,pageIndex,pageCount:page.pageCount,pageHash:page.pageHash,range,items:page.upserts.length});
 for(const item of page.upserts){let text=item.payloadJson;if(item.payloadChunkCount){const chunks=[];for(let i=0;i<item.payloadChunkCount;i++){const chunk=await wait(m=>m.syncId===syncId&&m.pageIndex===pageIndex&&m.type==='conversation_history_payload_chunk'&&m.itemKey===item.itemKey&&m.chunkIndex===i);check('chunk identity '+item.itemKey+'/'+i,chunk.chunkCount===item.payloadChunkCount&&chunk.payloadHash===item.payloadHash);chunks.push(chunk.data);}text=chunks.join('');check('chunk reconstructed '+item.itemKey,sha(text)===item.payloadHash&&Buffer.byteLength(text)===item.payloadBytes);}
 const payloadHash=sha(text),contentHash=(item.detailRefs?.length||item.detailRefsTruncated||item.availability)?sha(JSON.stringify(sort({payloadHash,detailRefs:item.detailRefs||[],detailRefsTruncated:item.detailRefsTruncated===true,availability:item.availability||null}))):payloadHash;check('item version '+item.itemKey,contentHash===item.contentHash);if(items.has(item.itemKey))check('overlap identical '+item.itemKey,items.get(item.itemKey).payloadJson===text);items.set(item.itemKey,{...item,payloadJson:text});
 for(const ref of item.detailRefs||[]){if(details.has(ref.refId))continue;const chunks=[],offsets=[];let cursor=null;
 for(let d=0;d<20;d++){const requestId=crypto.randomUUID();send({type:'conversation_history_detail_request',conversationId:id,requestId,selectionGeneration:generation,refId:ref.refId,cursor});const detail=await wait(m=>m.type==='conversation_history_detail_response'&&m.requestId===requestId);check('detail slice '+ref.refId+'/'+d,detail.state==='ok'&&detail.conversationId===id&&detail.contentHash===ref.contentHash&&detail.byteSize===ref.byteSize&&detail.byteOffset===Buffer.byteLength(chunks.join('')));chunks.push(detail.content);offsets.push(detail.byteOffset);cursor=detail.nextCursor;if(!cursor)break;}
 const text=chunks.join('');check('detail reconstructed '+ref.refId,!cursor&&Buffer.byteLength(text)===ref.byteSize&&sha(text)===ref.contentHash);details.set(ref.refId,{ref,text,pages:chunks.length,offsets});}
 }
 // Diagnostic receiver ACKs verified in-memory pages so pagination can proceed.
 // This is not an Android durable database commit or App ACK.
 send({type:'conversation_history_sync_ack',conversationId:id,syncId,sequence:page.sequence,pageIndex:page.pageIndex,targetRoot:page.targetRoot,clientSelectionGeneration:generation});result.diagnostic_ack_count++;
 if(pageIndex===page.pageCount-1){await wait(m=>m.syncId===syncId&&m.type==='conversation_history_sync_state');break;}
 }
 if(!range.hasMoreBefore)break;if(n===9)throw Error('older range count bound');
 }
 result.items=[...items.values()].map(x=>({itemKey:x.itemKey,turnId:x.turnId,itemType:x.itemType,payloadSha256:sha(x.payloadJson),payloadBytes:Buffer.byteLength(x.payloadJson),detailRefs:x.detailRefs}));result.details=[...details.values()].map(x=>({refId:x.ref.refId,contentHash:x.ref.contentHash,byteSize:x.ref.byteSize,pages:x.pages,offsets:x.offsets,call_id:JSON.parse(x.text).call_id}));result.complete=!range.hasMoreBefore;
 }catch(e){result.failure=e.message;process.exitCode=1;}finally{const raw=Buffer.from(JSON.stringify({messages,items:[...items.values()],details:[...details.values()]}));fs.writeFileSync(path.join(priv,label+'-full-wire.json'),raw,{flag:'wx'});result.private_wire={bytes:raw.length,sha256:sha(raw)};ws.close(1000,'S5 product DB diagnostic read complete');await new Promise(r=>setTimeout(r,200));ws.terminate();fs.writeFileSync(path.join(out,label+'-read-all.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({id,label,items:result.items?.length,details:result.details?.length,body_pages:result.pages.length,detail_pages:result.details?.reduce((n,x)=>n+x.pages,0),checks:checks.length,failed:checks.filter(x=>!x.passed),failure:result.failure,complete:result.complete}));}
})().catch(e=>{console.error(e.message);process.exitCode=1;});
