const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s5';fs.mkdirSync(`${d}/before`,{recursive:true});
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const before=['tests/codexHistoryProductFlow.test.js','docs/product/plans/PLAN-20261005-codex-history-shared-compat.md','docs/product/requirements/REQ-20261005-codex-history-shared-compat.md'].map(path=>{const snapshot=`${d}/before/${path.replaceAll('/','__')}`;fs.copyFileSync(path,snapshot);return{path,snapshot,sha256:hash(path)};});
const protectedPaths=['docs/workflow/CONTRACTS.md','docs/workflow/DECISIONS.md','docs/codex/codex-history-shared-compat-contract.md','docs/codex/codex-rollout-collector-architecture.md','src/services/codexHistoryProductStore.js','src/services/codexHistoryProductProvider.js','src/services/codexHistoryCanonicalizer.js','src/services/codexRolloutCollector/analysisBatchImporter.js','src/services/codexRolloutCollector/analyzerProcessManager.js','src/services/codexRolloutCollector/index.js','native/codex-rollout-collector/target/debug/codex-rollout-collector.exe','native/codex-rollout-collector/tests/fixtures/current/delegated-context.jsonl','native/codex-rollout-compat-spike/vendor/codex/Cargo.lock'];
const protected=protectedPaths.map(path=>({path,sha256:hash(path)}));
fs.writeFileSync(`${d}/baseline.json`,JSON.stringify({head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),before,protected},null,2)+'\n');
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S5'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});fs.writeFileSync(`${d}/status-${label}-before.json`,r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);}
console.log(JSON.stringify({before:before.length,protected:protected.length}));
