    // ── Slash menu ────────────────────────────────────────────────────

    fun showSlashMenu(query: String = "/") {
        _uiState.update { it.copy(slashMenuVisible = true, slashMenuQuery = query) }
    }

    fun hideSlashMenu() {
        _uiState.update { it.copy(slashMenuVisible = false, slashMenuQuery = "") }
    }

    fun updateSlashMenuQuery(query: String) {
        _uiState.update { it.copy(slashMenuQuery = query) }
    }

    private fun closeSlashMenu(state: CodexUiState): CodexUiState =
        state.copy(slashMenuVisible = false, slashMenuQuery = "")

    fun handleComposerTextChanged(rawText: String) {
        val derivedActiveSkill = extractSkillReferencesFromText(rawText).singleOrNull()?.name
        _uiState.update { state ->
            state.copy(
                interactionState = buildInteractionState(
                    state = state.copy(
                        interactionState = state.interactionState?.copy(activeSkill = derivedActiveSkill)
                            ?: CodexInteractionState(
                                planMode = state.planMode == true,
                                activeSkill = derivedActiveSkill
                            )
                    ),
                    planMode = state.planMode == true
                )
            )
        }
        val mentionInput = CodexSlashRegistry.parseFileMentionInput(rawText)
        if (mentionInput == null || _uiState.value.capabilities?.fileMentions != true) {
            hideFileMentionMenu()
            return
        }
        searchFileMentions(mentionInput.query)
    }

    fun hideFileMentionMenu() {
        mentionSearchGeneration += 1
        _uiState.update {
            it.copy(
                fileMentionMenuVisible = false,
                fileMentionQuery = "",
                fileMentionResults = emptyList(),
                fileMentionLoading = false
            )
        }
    }

    fun selectFileMention(file: FileMention) {
        hideFileMentionMenu()
        _uiState.update { state ->
            if (state.pendingFileMentions.any { it.path == file.path }) {
                state
            } else {
                state.copy(pendingFileMentions = state.pendingFileMentions + file)
            }
        }
    }

    fun removeFileMention(path: String) {
        _uiState.update { state ->
            state.copy(pendingFileMentions = state.pendingFileMentions.filterNot { it.path == path })
        }
    }

    // ── Next turn overrides ───────────────────────────────────────────

    fun setNextTurnOverrides(overrides: NextTurnOverrides) {
        _uiState.update { state ->
            recalculateNextTurnEffectiveConfig(state.copy(nextTurnOverrides = overrides))
        }
        rememberCurrentTaskOverrides(reason = "set-overrides")
    }

    fun toggleGoalMode() {
        val current = _uiState.value
        if (current.goalMode) {
            _uiState.update { it.copy(goalMode = false) }
            return
        }
        if (current.planMode == true) {
            closePlanMode(clearWorkflow = true)
        }
        _uiState.update {
            it.copy(
                goalMode = true,
                errorMessage = null
            )
        }
    }

    private fun loadRememberedTaskOverrides(threadId: String?, reason: String): NextTurnOverrides {
        val key = rememberedTaskConfigKey(currentProfile?.id, threadId) ?: return NextTurnOverrides()
        val overrides = decodeRememberedNextTurnOverrides(rememberedTaskConfig.getString(key, null))
        Log.i(
            TAG,
            "[config][remembered-load] reason=$reason threadId=${normalizeThreadId(threadId).orEmpty()} " +
                "fields=${rememberedOverrideFieldSummary(overrides)}"
        )
        return overrides
    }

    private fun rememberCurrentTaskOverrides(reason: String) {
        val state = _uiState.value
        val key = rememberedTaskConfigKey(currentProfile?.id, state.threadId) ?: return
        val encoded = encodeRememberedNextTurnOverrides(state.nextTurnOverrides)
        rememberedTaskConfig.edit().apply {
            if (encoded == null) remove(key) else putString(key, encoded)
        }.apply()
        Log.i(
            TAG,
            "[config][remembered-save] reason=$reason threadId=${normalizeThreadId(state.threadId).orEmpty()} " +
                "fields=${rememberedOverrideFieldSummary(state.nextTurnOverrides)}"
        )
    }

    private fun rememberedOverrideFieldSummary(overrides: NextTurnOverrides): String = buildList {
        if (!overrides.model.isNullOrBlank()) add("model")
        if (!overrides.reasoningEffort.isNullOrBlank()) add("reasoning")
        if (!overrides.sandbox.isNullOrBlank()) add("sandbox")
        if (!overrides.approvalPolicy.isNullOrBlank()) add("approval")
        if (!overrides.approvalsReviewer.isNullOrBlank()) add("reviewer")
        if (!overrides.permissionProfile.isNullOrBlank()) add("profile")
        if (overrides.useConfigPermissions) add("config-permissions")
    }.joinToString(",").ifEmpty { "none" }

    private fun applyIpcConversationSelectionWithRememberedConfig(
        state: CodexUiState,
        selected: CodexIpcConversationSummary
    ): CodexUiState {
        val previousId = normalizeThreadId(state.activeConversationId)
        val selectedState = applyIpcConversationSelectionToUiState(state, selected)
        if (previousId == normalizeThreadId(selected.conversationId)) return selectedState
        return recalculateNextTurnEffectiveConfig(
            selectedState.copy(
                nextTurnOverrides = loadRememberedTaskOverrides(
                    selected.conversationId,
                    reason = "ipc-selection"
                )
            )
        )
    }

    // ── Internal: send turn with overrides ────────────────────────────

    private fun sendTurnWithOverrides(
        text: String,
        forcePlanMode: Boolean = false,
        forceNewThread: Boolean = false,
        clearPlanModeAfterSend: Boolean = true,
        displayTextOverride: String? = null,
        goalObjective: String? = null
    ): Boolean {
        val state = _uiState.value
        if (text.isBlank() && state.pendingFileMentions.isEmpty() && state.pendingImageAttachments.isEmpty()) return false
        val skillReferences = extractSkillReferencesFromText(text)
        val turnInteractionState = CodexInteractionState(
            planMode = forcePlanMode || state.planMode == true,
            activeSkill = skillReferences.singleOrNull()?.name
        )
        val attachments = state.pendingImageAttachments.map { attachment ->
            CodexTurnAttachment(
                type = attachment.type,
                url = attachment.url
            )
        }
        val prompt = buildPromptWithMentions(text, state.pendingFileMentions)
        val clientRequestId = UUID.randomUUID().toString()
        val displayText = displayTextOverride ?: buildDisplayText(
            text = text,
            mentions = state.pendingFileMentions
        )
        val userMsg = ChatMessage(
            id = clientRequestId,
            role = ChatMessage.Role.USER,
            content = displayText,
            fileMentions = state.pendingFileMentions,
            activeSkill = turnInteractionState.activeSkill,
            skills = skillReferences,
            attachments = state.pendingImageAttachments.map(::buildMessageAttachmentSummary)
        )
        val isPlanMode = forcePlanMode || state.planMode == true
        val effectiveModel = state.nextTurnOverrides.model ?: state.model
        val effectiveReasoning = state.nextTurnOverrides.reasoningEffort ?: state.reasoningEffort
        val effectiveTurnConfig = state.nextTurnEffectiveCodexConfig
            ?: resolveNextTurnEffectiveCodexConfig(state)

        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.turn.send.requested",
            mapOf(
                "clientRequestKey" to PersistentDiagnosticLog.shortHash(clientRequestId),
                "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                "threadKey" to PersistentDiagnosticLog.shortHash(state.threadId),
                "transportCandidate" to if (shouldUseIpcFollowerTransport(state)) "follower" else "legacy",
                "ipcOnline" to state.ipcOnline,
                "surfaceStatus" to state.ipcSurfaceSnapshot?.status,
                "surfaceRevision" to state.ipcSurfaceSnapshot?.revision,
                "attachmentCount" to attachments.size,
                "attachmentTypes" to attachments.map { it.type }.distinct(),
                "fileMentionCount" to state.pendingFileMentions.size,
                "textLength" to text.length,
                "intentKind" to if (goalObjective.isNullOrBlank()) "message" else "goal",
                "goalKey" to PersistentDiagnosticLog.shortHash(goalObjective),
                "objectiveLength" to goalObjective?.trim()?.length,
                "planMode" to isPlanMode,
                "modelPresent" to !effectiveModel.isNullOrBlank(),
                "reasoningPresent" to !effectiveReasoning.isNullOrBlank(),
                "effectiveApprovalPolicy" to effectiveTurnConfig?.approvalPolicy,
                "effectiveSandboxMode" to effectiveTurnConfig?.sandboxMode,
                "effectiveApprovalsReviewer" to effectiveTurnConfig?.approvalsReviewer,
                "effectivePermissionProfile" to effectiveTurnConfig?.permissionProfile,
                "usesConfigPermissions" to (effectiveTurnConfig?.useConfigPermissions == true),
                "overrideApprovalPolicy" to state.nextTurnOverrides.approvalPolicy,
                "overrideSandboxMode" to state.nextTurnOverrides.sandbox,
                "overridePermissionProfile" to state.nextTurnOverrides.permissionProfile,
                "overrideUsesConfigPermissions" to state.nextTurnOverrides.useConfigPermissions
            )
        )

        val collaborationMode = if (isPlanMode) {
            CodexClientMessages.buildCollaborationMode(
                model = effectiveModel,
                reasoningEffort = effectiveReasoning
            )
        } else null

        // A plan turn does not change the canonical conversation. The next
        // ordinary turn explicitly sends the default collaboration mode
        // instead of silently replacing the thread.
        val effectiveForceNewThread = forceNewThread

        val followerPayload = buildFollowerTurnPayloadIfSupported(
            state = state,
            prompt = prompt,
            isPlanMode = isPlanMode,
            attachments = attachments,
            interactionState = turnInteractionState,
            collaborationMode = collaborationMode,
            clientRequestId = clientRequestId,
            goalObjective = goalObjective
        )
        val sentViaIpcFollower = followerPayload != null
        if (followerPayload == null && shouldBlockPlainTextFallbackForIpcConversation(state, isPlanMode, attachments)) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.turn.send.rejected",
                mapOf(
                    "clientRequestKey" to PersistentDiagnosticLog.shortHash(clientRequestId),
                    "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                    "reason" to "ipc_fallback_blocked",
                    "attachmentCount" to attachments.size,
                    "surfaceStatus" to state.ipcSurfaceSnapshot?.status,
                    "surfaceDesynced" to (state.ipcSurfaceSnapshot?.desynced == true)
                ),
                level = "warn"
            )
            _uiState.update {
                it.copy(connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable))
            }
            return false
        }
        val sent = sendEnvelopeOrReportFailure(
            payload = followerPayload ?: CodexClientMessages.codexTurn(
                prompt = prompt,
                threadId = normalizeThreadId(state.threadId),
                attachments = attachments,
                interactionState = turnInteractionState,
                model = state.nextTurnOverrides.model,
                reasoningEffort = state.nextTurnOverrides.reasoningEffort,
                sandbox = state.nextTurnOverrides.sandbox,
                collaborationMode = collaborationMode,
                forceNewThread = effectiveForceNewThread
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
        if (!sent) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.turn.send.failed",
                mapOf(
                    "clientRequestKey" to PersistentDiagnosticLog.shortHash(clientRequestId),
                    "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                    "transport" to if (sentViaIpcFollower) "follower" else "legacy",
                    "reason" to "websocket_send_rejected",
                    "attachmentCount" to attachments.size
                ),
                level = "error"
            )
            return false
        }

        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.turn.send.sent",
            mapOf(
                "clientRequestKey" to PersistentDiagnosticLog.shortHash(clientRequestId),
                "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                "threadKey" to PersistentDiagnosticLog.shortHash(state.threadId),
                "transport" to if (sentViaIpcFollower) "follower" else "legacy",
                "attachmentCount" to attachments.size,
                "fileMentionCount" to state.pendingFileMentions.size
            )
        )

        if (!sentViaIpcFollower) {
            // Update plan-turn tracking: set flag if this was a plan turn,
            // reset if we just forced a new thread (clean slate).
            if (isPlanMode) {
                threadHadPlanTurn = true
            } else if (effectiveForceNewThread) {
                threadHadPlanTurn = false
            }
        }
        pendingOptimisticNewThreadSourceThreadId = if (!sentViaIpcFollower && effectiveForceNewThread) {
            normalizeThreadId(state.threadId)
        } else {
            null
        }

        _uiState.update {
            it.copy(
                messages = if (sentViaIpcFollower) it.messages else it.messages + userMsg,
                pendingFileMentions = emptyList(),
                pendingImageAttachments = emptyList(),
                fileMentionMenuVisible = false,
                fileMentionQuery = "",
                fileMentionResults = emptyList(),
                fileMentionLoading = false,
                pendingSkillInsertName = null,
                toolsPanel = it.toolsPanel.copy(
                    compactSubmitting = false,
                    compactStatusText = "",
                    compactStatusTone = ""
                ),
                planWorkflow = if (
                    effectiveForceNewThread ||
                    (forcePlanMode || state.planMode == true) ||
                    it.planWorkflow.phase != PLAN_PHASE_READY_FOR_CONFIRMATION
                ) {
                    it.planWorkflow
                } else {
                    buildEmptyPlanWorkflowState()
                },
                interactionState = CodexInteractionState(
                    planMode = if (isPlanMode && clearPlanModeAfterSend) false else it.planMode == true,
                    activeSkill = null
                )
            )
        }

        if (!sentViaIpcFollower && collaborationMode != null) {
            _uiState.update { current ->
                current.copy(
                    planWorkflow = startPlanWorkflow(prompt)
                )
            }
        }

        // Clear plan mode after sending a plan turn (matches Web behavior)
        if (isPlanMode && clearPlanModeAfterSend) {
            _uiState.update { current ->
                current.copy(planMode = false)
            }
        }
        syncInteractionState(_uiState.value.interactionState ?: CodexInteractionState())
        return true
    }

    private fun shouldUseIpcFollowerTransport(state: CodexUiState): Boolean =
        shouldUseIpcFollowerTransportState(state)

    private fun buildFollowerTurnPayloadIfSupported(
        state: CodexUiState,
        prompt: String,
        isPlanMode: Boolean,
        attachments: List<CodexTurnAttachment>,
        interactionState: CodexInteractionState,
        collaborationMode: JSONObject?,
        clientRequestId: String,
        goalObjective: String? = null
    ): String? {
        val conversationId = state.activeConversationId?.trim().orEmpty()
        if (!shouldUseIpcFollowerSendTransportState(state) || conversationId.isEmpty()) return null
        val overrides = state.nextTurnOverrides
        val permissionOverride = permissionConfigForSandboxOverride(overrides.sandbox)
        val turnConfig = CodexEffectiveConfig(
            model = overrides.model,
            reasoningEffort = overrides.reasoningEffort,
            personality = null,
            approvalPolicy = overrides.approvalPolicy ?: permissionOverride?.approvalPolicy,
            sandboxMode = if (overrides.permissionProfile.isNullOrBlank()) {
                permissionOverride?.sandboxMode ?: overrides.sandbox
            } else {
                null
            },
            approvalsReviewer = overrides.approvalsReviewer,
            permissionProfile = overrides.permissionProfile,
            useConfigPermissions = overrides.useConfigPermissions
        ).takeIf(CodexEffectiveConfig::hasAnyValue)
        return CodexClientMessages.followerSendMessage(
            conversationId = conversationId,
            input = prompt,
            turnConfig = turnConfig,
            clientRequestId = clientRequestId,
            attachments = attachments,
            interactionState = interactionState,
            collaborationMode = if (isPlanMode) collaborationMode else {
                CodexClientMessages.buildCollaborationMode(
                    mode = "default",
                    model = state.nextTurnOverrides.model ?: state.model,
                    reasoningEffort = state.nextTurnOverrides.reasoningEffort ?: state.reasoningEffort
                )
            },
            goalObjective = goalObjective
        )
    }

    private fun shouldBlockPlainTextFallbackForIpcConversation(
        state: CodexUiState,
        isPlanMode: Boolean,
        attachments: List<CodexTurnAttachment>
    ): Boolean {
        return shouldBlockPlainTextFallbackForIpcConversationState(
            state = state,
            isPlanMode = isPlanMode,
            hasAttachments = attachments.isNotEmpty(),
            hasFileMentions = state.pendingFileMentions.isNotEmpty()
        )
    }

    private fun maybeRequestModelList() {
        val state = _uiState.value
        val caps = state.capabilities ?: return
        if (!caps.modelConfig || caps.models.isNotEmpty()) {
            return
        }
        val generation = ++modelCatalogRequestGeneration
        PersistentDiagnosticLog.event("codex", "android.codex.model_catalog.requested", mapOf(
            "generation" to generation,
            "connectionState" to state.connectionState.name,
            "activeConversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
            "capabilityModelCount" to caps.models.size
        ))
        val sent = connectionManager.send(
            CodexClientMessages.codexRequest(
                "model/list",
                JSONObject().put("includeHidden", true)
            )
        )
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.model_catalog.sent",
            mapOf("sent" to sent, "generation" to generation),
            level = if (sent) "info" else "warn"
        )
    }

    private fun maybeRequestPermissionProfiles() {
        val state = _uiState.value
        if (state.capabilities?.permissionProfiles != true ||
            state.permissionProfilesLoading ||
            state.permissionProfilesRequested
        ) {
            return
        }
        _uiState.update {
            it.copy(
                permissionProfilesLoading = true,
                permissionProfilesRequested = true
            )
        }
        PersistentDiagnosticLog.event("codex", "android.codex.permission_catalog.requested")
        val sent = connectionManager.send(CodexClientMessages.codexRequest("permissionProfile/list"))
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.permission_catalog.sent",
            mapOf("sent" to sent),
            level = if (sent) "info" else "warn"
        )
    }

    private fun searchFileMentions(query: String) {
        val state = _uiState.value
        val profile = currentProfile ?: run {
            hideFileMentionMenu()
            return
        }
        val sessionId = state.sessionId.takeIf { it.isNotBlank() } ?: run {
            hideFileMentionMenu()
            return
        }
        val generation = ++mentionSearchGeneration
        _uiState.update {
            it.copy(
                fileMentionMenuVisible = true,
                fileMentionQuery = query,
                fileMentionResults = emptyList(),
                fileMentionLoading = true
            )
        }
        viewModelScope.launch(Dispatchers.IO) {
            val result = sessionApiClient.searchWorkspaceFiles(profile, sessionId, query)
            _uiState.update { current ->
                if (generation != mentionSearchGeneration) {
                    return@update current
                }
                when (result) {
                    is com.termlink.app.data.ApiResult.Success -> current.copy(
                        fileMentionMenuVisible = true,
                        fileMentionQuery = query,
                        fileMentionResults = result.value.map { item ->
                            FileMention(
                                label = item.label,
                                path = item.path,
                                relativePathWithoutFileName = item.relativePathWithoutFileName,
                                fsPath = item.fsPath
                            )
                        },
                        fileMentionLoading = false
                    )
                    is com.termlink.app.data.ApiResult.Failure -> {
                        Log.w(TAG, "Workspace file search failed: ${result.error.message}")
                        current.copy(
                            fileMentionMenuVisible = false,
                            fileMentionQuery = "",
                            fileMentionResults = emptyList(),
                            fileMentionLoading = false
                        )
                    }
                }
            }
        }
    }

    private fun buildPromptWithMentions(text: String, mentions: List<FileMention>): String {
        val mentionPrefix = mentions.joinToString("\n") { "@${it.path}" }
        val promptText = mentions.fold(text) { current, file ->
            stripCommittedMentionToken(current, "@${file.label}")
        }.trim()
        return when {
            mentionPrefix.isBlank() -> promptText
            promptText.isBlank() -> mentionPrefix
            else -> "$mentionPrefix\n$promptText"
        }
    }

    private fun buildDisplayText(
        text: String,
        mentions: List<FileMention>
    ): String {
        val withoutSkills = CodexSlashRegistry.stripSkillTokens(text)
        val withoutMentions = mentions.fold(withoutSkills) { current, file ->
            stripCommittedMentionTokens(current, file)
        }
        return stripAttachmentSummaryLines(withoutMentions).trim()
    }

    private fun stripCommittedMentionTokens(text: String, mention: FileMention): String {
        val candidates = buildSet {
            val trimmedPath = mention.path.trim()
            if (trimmedPath.isNotEmpty()) {
                add("@$trimmedPath")
            }
            mention.label.trim()
                .takeIf { it.isNotEmpty() }
                ?.let { add("@$it") }
        }
        return candidates.fold(text) { current, token ->
            stripCommittedMentionToken(current, token)
        }
    }

    private fun buildVisibleUserMessageText(text: String): String {
        val withoutMentions = stripLeadingMentionLines(text)
        val withoutSkills = CodexSlashRegistry.stripSkillTokens(withoutMentions)
        return stripAttachmentSummaryLines(withoutSkills).trim()
    }

    private fun stripAttachmentSummaryLines(text: String): String {
        if (text.isBlank()) return ""
        return text
            .lineSequence()
            .filterNot { line ->
                val trimmed = line.trim()
                trimmed.startsWith("[image] ", ignoreCase = true) ||
                    trimmed.startsWith("[image-url] ", ignoreCase = true)
            }
            .joinToString("\n")
    }

    private fun extractSkillReferencesFromText(text: String): List<CodexSkillReference> {
        return CodexSlashRegistry.extractSkillTokens(text).map { token ->
            CodexSkillReference(
                name = token.name,
                path = token.path
            )
        }
    }

    private fun buildMessageAttachmentSummary(
        attachment: CodexPendingImageAttachment
    ): CodexMessageAttachment {
        val isLocalImage = attachment.type == "localImage"
        return CodexMessageAttachment(
            kind = "image",
            label = attachment.label,
            path = null,
            // Keep the data URL in the local message projection so the just-sent
            // history chip remains openable before the server canonicalizes it.
            url = attachment.url,
            source = if (isLocalImage) "local" else "remote",
            dedupeKey = if (isLocalImage) {
                buildAttachmentDedupeKey(attachment.url.ifBlank { attachment.label })
            } else {
                null
            }
        )
    }

    private fun buildAttachmentDedupeKey(value: String?): String {
        val normalized = value?.trim().orEmpty()
        if (normalized.isEmpty()) {
            return ""
        }
        var hash = 0x811C9DC5.toInt()
        normalized.forEach { char ->
            hash = hash xor char.code
            hash *= 16777619
        }
        return "k${Integer.toUnsignedString(hash, 16)}"
    }

    private fun buildAttachmentLabel(preferred: String?, fallbackPath: String?): String {
        val preferredTrimmed = preferred?.trim().orEmpty()
        if (preferredTrimmed.isNotEmpty()) {
            return preferredTrimmed
        }
        val fallbackTrimmed = fallbackPath?.trim().orEmpty()
        if (fallbackTrimmed.isEmpty()) {
            return "Image"
        }
        return fallbackTrimmed.substringAfterLast('/').substringAfterLast('\\').ifBlank { fallbackTrimmed }
    }

    private fun extractAttachmentSummaryLines(text: String): List<CodexMessageAttachment> {
        if (text.isBlank()) return emptyList()
        return text.lineSequence()
            .mapNotNull { line ->
                val trimmed = line.trim()
                when {
                    trimmed.startsWith("[image] ", ignoreCase = true) -> {
                        val value = trimmed.substringAfter(']').trim()
                        val isUri = value.startsWith("http://", ignoreCase = true) ||
                            value.startsWith("https://", ignoreCase = true) ||
                            value.startsWith("data:", ignoreCase = true) ||
                            value.startsWith("content:", ignoreCase = true) ||
                            value.startsWith("file:", ignoreCase = true)
                        CodexMessageAttachment(
                            kind = "image",
                            label = value,
                            path = value.takeUnless { isUri },
                            url = value.takeIf { isUri },
                            source = if (isUri) "remote" else "local"
                        )
                    }
                    trimmed.startsWith("[image-url] ", ignoreCase = true) -> {
                        val value = trimmed.substringAfter(']').trim()
                        CodexMessageAttachment(
                            kind = "image",
                            label = value,
                            url = value,
                            source = "remote"
                        )
                    }
                    else -> null
                }
            }
            .distinctBy { attachment ->
                listOf(
                    attachment.kind.trim().lowercase(),
                    attachment.path.orEmpty().trim().lowercase(),
                    attachment.url.orEmpty().trim().lowercase(),
                    attachment.label.trim().lowercase()
                ).joinToString("::")
            }
            .toList()
    }

    private fun stripCommittedMentionToken(text: String, token: String): String {
        if (token.isBlank()) return text
        val result = StringBuilder(text.length)
        var cursor = 0
        while (cursor < text.length) {
            val matchIndex = text.indexOf(token, cursor)
            if (matchIndex == -1) {
                result.append(text, cursor, text.length)
                break
            }
            val tokenEnd = matchIndex + token.length
            result.append(text, cursor, matchIndex)
            if (isCommittedMentionBoundary(text, matchIndex, tokenEnd)) {
                cursor = tokenEnd
            } else {
                result.append(token)
                cursor = tokenEnd
            }
        }
        return result.toString()
    }

    private fun isCommittedMentionBoundary(text: String, start: Int, end: Int): Boolean {
        val validStart = start == 0 || text[start - 1].isWhitespace()
        val validEnd = end == text.length ||
            text[end].isWhitespace() ||
            text[end] in charArrayOf(',', '.', ';', ':', '，', '。', '、', '；', '：', ')', ']', '}')
        return validStart && validEnd
    }

    // ── Internal observers ────────────────────────────────────────────

    private fun observeConnectionState() {
        viewModelScope.launch {
            connectionManager.connectionState.collect { nextState ->
                val previousState = _uiState.value.connectionState
                if (previousState != nextState) {
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.connection.state_changed",
                        mapOf("from" to previousState.name, "to" to nextState.name),
                        critical = true
                    )
                }
                _uiState.update { current ->
                    syncExecutionWatch(
                        applyConnectionStateToUiState(current, nextState),
                        markActivity = nextState != current.connectionState
                    )
                }
                if (nextState == ConnectionState.CONNECTED) {
                    val state = _uiState.value
                    maybeRequestLaunchHydrate(state.threadId)
                    maybeRequestPendingThreadResync(
                        threadId = state.threadId,
                        status = state.status,
                        currentTurnId = state.currentTurnId
                    )
                }
            }
        }
    }

    private fun observeWsEvents() {
        viewModelScope.launch {
            connectionManager.wsClient.events.collect { event ->
                if (!connectionManager.wsClient.isCurrentEvent(event)) return@collect
                try {
                    when (event) {
                        is WsEvent.Opened -> {
                            connectionManager.onConnected()
                            _uiState.update { current ->
                                syncExecutionWatch(
                                    applyConnectionStateToUiState(current, ConnectionState.CONNECTED),
                                    markActivity = true
                                )
                            }
                            if (_uiState.value.ipcOnline) {
                                beginAwaitingFreshIpcSurface()
                            }
                            subscribeActiveConversationIfNeeded()
                        }
                        is WsEvent.Message -> {
                            if (shouldPromoteConnectionStateFromWebSocketMessage(
                                    connectionState = _uiState.value.connectionState
                                )) {
                                connectionManager.onConnected()
                                _uiState.update { current ->
                                    syncExecutionWatch(
                                        applyConnectionStateToUiState(current, ConnectionState.CONNECTED),
                                        markActivity = true
                                    )
                                }
                                subscribeActiveConversationIfNeeded()
                            }
                            handleEnvelope(event.envelope)
                        }
                        is WsEvent.Closed -> {
                            if (_uiState.value.historyDetail?.loading == true) failHistoryDetail("detail_disconnected")
                            resetHistoryRecoveryAfterTransportLoss("websocket-closed:${event.code}")
                            markPendingThreadResyncIfNeeded(_uiState.value)
                            val registrationSessionMismatch = event.code == 4403 && (
                                event.reason.contains("not owned", ignoreCase = true) ||
                                    event.reason.contains("registration", ignoreCase = true)
                                )
                            if (event.code == 4404 ||
                                event.reason.contains("Session not found or expired", ignoreCase = true) ||
                                registrationSessionMismatch
                            ) {
                                val message = if (registrationSessionMismatch) {
                                    "Session is not owned by this client registration"
                                } else {
                                    "Session not found or expired"
                                }
                _uiState.update {
                    it.copy(
                        errorMessage = message,
                        sessionExpired = true,
                        currentTurnId = null,
                        executionWatch = CodexExecutionWatchState()
                    )
                }
                            }
                            connectionManager.onDisconnected()
                        }
                        is WsEvent.Closing -> { /* handled by Closed */ }
                        is WsEvent.Failure -> {
                            if (_uiState.value.historyDetail?.loading == true) failHistoryDetail("detail_disconnected")
                            resetHistoryRecoveryAfterTransportLoss("websocket-failure:${event.code}")
                            markPendingThreadResyncIfNeeded(_uiState.value)
                            val message = event.throwable.message ?: "WebSocket failure"
                            if (!isRecoverableWebSocketFailure(event.throwable, event.code)) {
                                appendMessage(ChatMessage.Role.ERROR, message)
                            }
                            _uiState.update { state ->
                                applyWebSocketFailureToUiState(
                                    state,
                                    event.throwable,
                                    event.code,
                                    appContext.getString(R.string.codex_native_connection_action_unavailable)
                                )
                            }
                            connectionManager.onDisconnected()
                        }
                    }
                } catch (e: Exception) {
                    Log.e(TAG, "Error processing WS event: ${event::class.simpleName}", e)
                }
            }
        }
        viewModelScope.launch {
            connectionManager.wsClient.historyEvents.collect { event ->
                if (!connectionManager.wsClient.isCurrentEvent(event)) return@collect
                try {
                    if (event is WsEvent.Message) {
                        handleEnvelope(event.envelope)
                    }
                } catch (e: Exception) {
                    Log.e(TAG, "Error processing reliable history WS event", e)
                }
            }
        }
    }

    private fun subscribeActiveConversationIfNeeded() {
        val conversationId = _uiState.value.activeConversationId?.trim().orEmpty()
        if (conversationId.isEmpty()) return
        Log.i(TAG, "[ipc][subscribe-active-conversation] subscribing to conversationId=$conversationId")
        val sent = connectionManager.send(
            CodexClientMessages.setActiveConversation(conversationId, historySelectionGeneration)
        )
        if (sent) {
            activeConversationSubscriptionId = conversationId
            activeConversationSubscriptionGeneration = historySelectionGeneration
            activeConversationSubscriptionSentAtElapsed = SystemClock.elapsedRealtime()
            scheduleHistorySyncAfterSubscription(conversationId, historySelectionGeneration)
        }
    }

    private fun cancelHistorySyncAfterSubscription() {
        historySyncAfterSubscriptionJob?.cancel()
        historySyncAfterSubscriptionJob = null
        activeConversationSubscriptionId = null
        activeConversationSubscriptionGeneration = -1L
        activeConversationSubscriptionSentAtElapsed = 0L
    }

    private fun cancelHistoryOlderPump() {
        automaticOlderHistoryPump.cancel()
    }

    /**
     * Continue one enabled range sync after its previous page settled.  The
     * checkpoint is read only after the delay so a page committed by the
     * reducer is the source of truth for `hasMoreBefore`/cursor.  There is no
     * retry on failure and no second request while another sync id is active;
     * task switching cancels this job through the selection generation fence.
     */
    private fun scheduleAutomaticOlderHistoryPage(
        conversationId: String,
        generation: Long,
        syncState: String,
        rangeSync: Boolean
    ) {
        val capability = historyCapability ?: return
        val rangeCapability = capability.rangeSegments?.takeIf {
            it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
        } ?: return
        automaticOlderHistoryPump.schedule(
            conversationId = conversationId,
            generation = generation,
            rangeEnabled = rangeCapability.enabled && rangeCapability.version == 1,
            syncState = syncState,
            rangeSync = rangeSync,
            isCurrentSelection = {
                historySelectionGeneration == generation &&
                    _uiState.value.activeConversationId?.trim() == conversationId &&
                    historySyncInFlightConversationId == null &&
                    historyRecoveryInFlightConversationId == null
            },
            readHasMoreBefore = {
                val profile = currentProfile
                if (profile == null) {
                    false
                } else {
                    val cached = withContext(Dispatchers.IO) {
                        runCatching {
                            historyCacheStore.readConversation(profile.id, conversationId)
                        }.getOrNull()
                    }
                    val durableItemCount = cached?.items?.count { !it.provisional } ?: 0
                    val checkpoint = normalizeHistoryCheckpointForAvailableItems(
                        checkpoint = cached?.checkpoint,
                        availableDurableItemCount = durableItemCount
                    )
                    checkpoint.providerMode != "server_snapshot" && checkpoint.hasMoreBefore == true
                }
            },
            request = { requestOlderHistoryPage(auto = true) }
        )
    }

    /**
     * The Gateway has to install the active follower before it can accept a
     * history envelope.  On reconnect the two sends can otherwise be handled
     * in opposite event-loop turns.  Delay only the first request in that
     * selection generation; this is not a polling loop and does not create a
     * second owner or realtime source.
     */
    private fun scheduleHistorySyncAfterSubscription(
        conversationId: String,
        generation: Long
    ) {
        historySyncAfterSubscriptionJob?.cancel()
        val sentAt = activeConversationSubscriptionSentAtElapsed
        val delayMillis = (HISTORY_SUBSCRIPTION_SETTLE_MILLIS -
            (SystemClock.elapsedRealtime() - sentAt)).coerceAtLeast(0L)
        historySyncAfterSubscriptionJob = viewModelScope.launch {
            delay(delayMillis)
            if (generation != historySelectionGeneration ||
                _uiState.value.activeConversationId?.trim() != conversationId
            ) return@launch
            historySyncAfterSubscriptionJob = null
            maybeRequestHistorySync(conversationId)
        }
    }

    private fun shouldWaitForActiveConversationSubscription(
        conversationId: String,
        generation: Long
    ): Boolean {
        if (activeConversationSubscriptionId != conversationId ||
            activeConversationSubscriptionGeneration != generation ||
            activeConversationSubscriptionSentAtElapsed <= 0L
        ) return false
        val remaining = HISTORY_SUBSCRIPTION_SETTLE_MILLIS -
            (SystemClock.elapsedRealtime() - activeConversationSubscriptionSentAtElapsed)
        if (remaining <= 0L) return false
        if (historySyncAfterSubscriptionJob?.isActive != true) {
            scheduleHistorySyncAfterSubscription(conversationId, generation)
        }
        return true
    }

    /**
     * Ask the Gateway once for a bounded A-B-A replay assessment after the
     * cache-first selection has committed. This is deliberately independent
     * from ordinary history sync and never blocks the already-visible cache.
     */
    private fun maybeRequestLiveReplay(
        conversationId: String,
        generation: Long,
        checkpoint: CodexHistorySyncCheckpoint
    ) {
        val normalizedConversationId = conversationId.trim().takeIf { it.isNotEmpty() } ?: return
        val profile = currentProfile ?: return
        val key = CodexHistorySelectionKey(profile.id, normalizedConversationId, generation)
        if (!isCurrentHistorySelection(key) || liveReplayRequestedKey == key) return
        val capability = historyCapability?.liveReplay?.takeIf {
            it.enabled && it.version == 1
        } ?: return
        liveReplayRequestedKey = key
        val syncId = UUID.randomUUID().toString()
        liveReplayInFlightSyncId = syncId
        val surface = _uiState.value.ipcSurfaceSnapshot?.takeIf {
            normalizeCodexThreadId(it.conversationId) == normalizedConversationId
        }
        val surfaceNewestItemKey = surface?.items?.lastOrNull()?.key?.trim()?.takeIf { it.isNotEmpty() }
        val request = CodexLiveReplayRequest(
            syncId = syncId,
            conversationId = normalizedConversationId,
            checkpoint = checkpoint,
            selectionGeneration = generation,
            liveReplay = capability,
            surfaceRevision = surface?.revision,
            surfaceSourceEpoch = surface?.sourceEpoch,
            surfaceNewestItemKey = surfaceNewestItemKey
        )
        val sent = connectionManager.send(CodexClientMessages.liveReplayRequest(request))
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.live_replay.requested",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                "syncId" to PersistentDiagnosticLog.shortHash(syncId),
                "generation" to generation,
                "checkpointItemCount" to checkpoint.itemCount,
                "checkpointNewestKeyPresent" to !checkpoint.newestAnchorKey.isNullOrBlank(),
                "surfaceRevision" to surface?.revision,
                "surfaceNewestKeyPresent" to !surfaceNewestItemKey.isNullOrBlank(),
                "sent" to sent
            ),
            level = if (sent) "info" else "warn"
        )
        if (!sent && liveReplayInFlightSyncId == syncId) {
            liveReplayInFlightSyncId = null
            liveReplayOutcome = "failed"
            liveReplayDetailCode = "live_replay_send_failed"
        }
    }

    private fun advanceHistorySelectionGeneration(reason: String) {
        dismissHistoryDetail()
        val interruptedConversationId = historySyncInFlightConversationId
        val interruptedEndpointId = currentProfile?.id
        val interruptedSelectionGeneration = historySelectionGeneration
        historySelectionGeneration = (historySelectionGeneration + 1L).coerceAtLeast(1L)
        pendingHistorySelectionKey = null
        historySyncInFlightConversationId = null
        historySyncInFlightSyncId = null
        clearHistorySyncSettlement()
        historyRecoveryInFlightConversationId = null
        historyRecoveryInFlightSyncId = null
        historyRecoveryRequestedGeneration = -1L
        historyActivationRetryGeneration = -1L
        cancelHistorySyncAfterSubscription()
        cancelHistoryOlderPump()
        rangeHistorySyncIds.clear()
        olderHistorySyncIds.clear()
        cancelHistoryWatchdog()
        cancelHistoryResumeProtection()
        pendingHistoryPages.clear()
        pendingHistorySnapshotSegments.clear()
        completeServerSnapshotCacheSelectionKey = null
        productHistoryProbeSelectionKey = null
        clearCanonicalTailValidationState()
        liveReplayRequestedKey = null
        liveReplayInFlightSyncId = null
        liveReplayOutcome = null
        liveReplayDetailCode = null
        if (!interruptedEndpointId.isNullOrBlank() && !interruptedConversationId.isNullOrBlank()) {
            viewModelScope.launch(Dispatchers.IO) {
                runCatching {
                    historyCacheStore.clearInterruptedSync(
                        interruptedEndpointId,
                        interruptedConversationId,
                        interruptedSelectionGeneration
                    )
                }.onFailure { error ->
                    Log.w(TAG, "Failed to clear interrupted history staging", error)
                }
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.selection_generation_advanced",
            mapOf("generation" to historySelectionGeneration, "reason" to reason)
        )
    }

    private fun acceptsHistoryClientSelection(value: Long): Boolean {
        val capability = historyCapability
        return capability?.selectionGeneration != true || value == historySelectionGeneration
    }

    private fun currentHistorySelectionKey(conversationId: String, generation: Long): CodexHistorySelectionKey? =
        currentProfile?.id?.trim()?.takeIf { it.isNotEmpty() }?.let { endpointId ->
            CodexHistorySelectionKey(
                endpointId = endpointId,
                conversationId = conversationId,
                generation = generation
            )
        }

    private fun isCurrentHistorySelection(key: CodexHistorySelectionKey): Boolean =
        currentProfile?.id?.trim() == key.endpointId &&
            _uiState.value.activeConversationId?.trim() == key.conversationId &&
            key.generation == historySelectionGeneration

    private fun isCurrentHistorySelection(conversationId: String, generation: Long): Boolean =
        currentHistorySelectionKey(conversationId, generation)?.let(::isCurrentHistorySelection) == true

    private fun hasCompleteServerSnapshotCache(conversationId: String, generation: Long): Boolean {
        val snapshotSegments = historyCapability?.serverSnapshotSegments ?: return false
        if (!snapshotSegments.enabled || snapshotSegments.version != 1 || snapshotSegments.cacheSchemaVersion < 3) {
            return false
        }
        return completeServerSnapshotCacheSelectionKey ==
            currentHistorySelectionKey(conversationId, generation)
    }

    /**
     * A terminal reconciliation is the newer canonical source for this
     * conversation while it is in flight or after it has settled synced.
     * The ordinary selection snapshot lane must not race it with the older
     * server snapshot and downgrade the durable cache again.
     */
    private fun terminalReconcileFenceForConversation(
        conversationId: String
    ): TerminalReconcileContext? {
        val endpointId = currentProfile?.id?.trim()?.takeIf { it.isNotEmpty() } ?: return null
        return terminalReconcileContexts.values
            .filter { context ->
                    context.key.endpointId == endpointId &&
                    context.key.conversationId == conversationId &&
                    (!context.settled || context.settledState?.equals("synced", ignoreCase = true) == true)
            }
            .maxByOrNull { it.key.terminalEpoch }
    }

    private fun deferOrdinaryHistoryLaneForTerminalReconcile(
        conversationId: String,
        generation: Long,
        reason: String
    ): Boolean {
        val context = terminalReconcileFenceForConversation(conversationId) ?: return false
        if (!isCurrentHistorySelection(conversationId, generation)) return false

        // Quarantine any ordinary sync/recovery that was started before the
        // matching healthy terminal surface arrived. Its late pages then fail
        // the existing sync-id fence and cannot overwrite the terminal cache.
        if (historySyncInFlightConversationId == conversationId) {
            historySyncInFlightConversationId = null
            historySyncInFlightSyncId = null
            pendingHistoryPages.clear()
            pendingHistorySnapshotSegments.clear()
            rangeHistorySyncIds.clear()
            olderHistorySyncIds.clear()
            historySyncAfterSubscriptionJob?.cancel()
            historySyncAfterSubscriptionJob = null
        }
        if (historyRecoveryInFlightConversationId == conversationId) {
            historyRecoveryInFlightConversationId = null
            historyRecoveryInFlightSyncId = null
            cancelHistoryWatchdog()
        }
        historyRecoveryRequestedGeneration = generation
        markHistorySyncSettled(conversationId, generation)
        val key = historySelectionKeyOrNull(conversationId, generation)
        if (key != null) {
            _uiState.update { state ->
                if (isCurrentHistorySelection(key)) {
                    state.copy(
                        historyNetworkSyncState = historyNetworkState(
                            key,
                            CodexHistoryNetworkSyncState.CACHE_ONLY
                        )
                    )
                } else state
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.ordinary_lane_deferred_for_terminal_reconcile",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                "generation" to generation,
                "terminalEpoch" to PersistentDiagnosticLog.shortHash(context.key.terminalEpoch),
                "terminalState" to context.settledState,
                "reason" to reason
            )
        )
        return true
    }

    /**
     * A complete legacy cache is already the best static baseline available
     * to the UI.  Until a fresh surface identifies the task as running, or a
     * terminal context takes the fence, quarantine the ordinary snapshot lane
     * so an older server snapshot cannot downgrade this conversation.
     */
    private fun deferOrdinaryHistoryLaneForCompleteLocalCache(
        conversationId: String,
        generation: Long,
        surfaceStatus: String?,
        surfaceDesynced: Boolean,
        reason: String
    ): Boolean {
        val state = _uiState.value
        if (!shouldDeferOrdinaryHistorySyncForCompleteLocalCache(
                cacheState = state.historyCacheState,
                activeConversationId = state.activeConversationId,
                conversationId = conversationId,
                selectionGeneration = generation,
                surfaceStatus = surfaceStatus,
                surfaceDesynced = surfaceDesynced
            )
        ) return false

        if (historySyncInFlightConversationId == conversationId) {
            historySyncInFlightConversationId = null
            historySyncInFlightSyncId = null
            pendingHistoryPages.clear()
            pendingHistorySnapshotSegments.clear()
            rangeHistorySyncIds.clear()
            olderHistorySyncIds.clear()
            historySyncAfterSubscriptionJob?.cancel()
            historySyncAfterSubscriptionJob = null
        }
        if (historyRecoveryInFlightConversationId == conversationId) {
            historyRecoveryInFlightConversationId = null
            historyRecoveryInFlightSyncId = null
            cancelHistoryWatchdog()
        }
        historyRecoveryRequestedGeneration = generation
        markHistorySyncSettled(conversationId, generation)
        val key = historySelectionKeyOrNull(conversationId, generation)
        if (key != null) {
            _uiState.update { current ->
                if (isCurrentHistorySelection(key)) {
                    current.copy(
                        historyNetworkSyncState = historyNetworkState(
                            key,
                            CodexHistoryNetworkSyncState.CACHE_ONLY
                        )
                    )
                } else current
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.ordinary_lane_deferred_for_complete_local_cache",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                "generation" to generation,
                "cacheItemCount" to state.historyCacheState.itemCount,
                "surfaceStatus" to surfaceStatus,
                "surfaceDesynced" to surfaceDesynced,
                "reason" to reason
            )
        )
        return true
    }

    /**
     * Tail validation is permitted only after the selected task has a matching
     * healthy IPC surface.  A desynced/provisional surface remains useful for
     * display continuity, but it must not unlock canonical source reads.
     */
    private fun hasHealthyIpcAuthorityForCanonicalTailValidation(
        key: CodexHistorySelectionKey
    ): Boolean =
        isCurrentHistorySelection(key) &&
            authorityModeForState(_uiState.value, key.conversationId) == IpcAuthorityMode.IPC_AUTHORITATIVE

    private fun isTerminalReconcileContextCurrent(context: TerminalReconcileContext): Boolean =
        !context.settled &&
            terminalReconcileContexts[context.key] === context &&
            terminalReconcileContextsBySyncId[context.syncId] === context &&
            currentProfile?.id?.trim() == context.key.endpointId

    private fun settleTerminalReconcile(
        context: TerminalReconcileContext,
        state: String,
        detailCode: String?
    ) {
        if (terminalReconcileContexts[context.key] !== context || context.settled) return
        context.settled = true
        context.settledState = state
        context.dispatchJob?.cancel()
        context.dispatchJob = null
        context.watchdogJob?.cancel()
        context.watchdogJob = null
        pendingTerminalReconcilePages.keys.removeIf { it.startsWith("${context.syncId}:") }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.terminal_reconcile.settled",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(context.key.conversationId),
                "syncId" to PersistentDiagnosticLog.shortHash(context.syncId),
                "generation" to context.selectionGeneration,
                "terminalEpoch" to PersistentDiagnosticLog.shortHash(context.key.terminalEpoch),
                "state" to state,
                "detailCode" to detailCode
            ),
            level = if (state.equals("synced", ignoreCase = true)) "info" else "warn"
        )
    }

    /**
     * A terminal cache write is allowed to outlive the active UI selection,
     * but only while its original terminal epoch remains intact. When A is
     * still visible, re-check the local healthy surface before sending; when
     * B is visible, Gateway repeats the same check against its source cache.
     */
    private fun canDispatchTerminalReconcile(context: TerminalReconcileContext): Boolean {
        if (!isTerminalReconcileContextCurrent(context)) return false
        val activeConversationId = _uiState.value.activeConversationId?.trim()
        if (activeConversationId != context.key.conversationId) return true
        val surface = _uiState.value.ipcSurfaceSnapshot ?: return false
        return terminalReconcileEpoch(surface.sourceEpoch, surface.latestTurnId) == context.key.terminalEpoch &&
            isEligibleCompletedTerminalSurface(surface, _uiState.value.currentTurnId)
    }

    private fun invalidateSupersededTerminalReconcile(
        surface: DesktopSurfaceSnapshot
    ) {
        val conversationId = surface.conversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val endpointId = currentProfile?.id?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val currentEpoch = terminalReconcileEpoch(surface.sourceEpoch, surface.latestTurnId)
        terminalReconcileContexts.values
            .filter { context ->
                !context.settled &&
                    context.key.endpointId == endpointId &&
                    context.key.conversationId == conversationId &&
                    (currentEpoch == null || context.key.terminalEpoch != currentEpoch ||
                        !isEligibleCompletedTerminalSurface(surface, _uiState.value.currentTurnId))
            }
            .forEach { context ->
                settleTerminalReconcile(context, "failed", "terminal_reconcile_epoch_superseded")
            }
    }

    /**
     * Start exactly once for a healthy completed terminal epoch. This is not
     * part of selection hydration: the captured context may finish A's
     * SQLite transaction after the user selects B, without touching B's UI.
     */
    private fun maybeScheduleTerminalReconcile(
        surface: DesktopSurfaceSnapshot?,
        reason: String
    ) {
        val snapshot = surface ?: return
        val conversationId = snapshot.conversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val profile = currentProfile ?: return
        val selectionKey = historySelectionKeyOrNull(conversationId, historySelectionGeneration) ?: return
        if (!isCurrentHistorySelection(selectionKey) ||
            !isEligibleCompletedTerminalSurface(snapshot, _uiState.value.currentTurnId)
        ) return
        val capability = historyCapability?.terminalReconcile
        if (capability == null || !capability.enabled || capability.version != 1) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.terminal_reconcile.capability_unavailable",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                    "generation" to selectionKey.generation,
                    "reason" to reason
                )
            )
            return
        }
        // The Gateway only grants the legacy full-read exception from its own
        // metadata observation. Do not race a just-opened conversation before
        // that observation has completed.
        if (tailValidationMetadataSelectionKey != selectionKey) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.terminal_reconcile.waiting_for_metadata",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                    "generation" to selectionKey.generation,
                    "reason" to reason
                )
            )
            return
        }
        val terminalEpoch = terminalReconcileEpoch(snapshot.sourceEpoch, snapshot.latestTurnId) ?: return
        val key = TerminalReconcileKey(profile.id, conversationId, terminalEpoch)
        if (terminalReconcileContexts.containsKey(key)) return
        val context = TerminalReconcileContext(
            key = key,
            selectionGeneration = selectionKey.generation,
            syncId = UUID.randomUUID().toString()
        )
        if (terminalReconcileContexts.putIfAbsent(key, context) != null) return
        terminalReconcileContextsBySyncId[context.syncId] = context
        deferOrdinaryHistoryLaneForTerminalReconcile(
            conversationId = conversationId,
            generation = selectionKey.generation,
            reason = "terminal_reconcile_started"
        )
        context.dispatchJob = viewModelScope.launch {
            delay(TERMINAL_RECONCILE_STABILITY_MILLIS)
            if (!canDispatchTerminalReconcile(context)) {
                settleTerminalReconcile(context, "failed", "terminal_reconcile_epoch_stale")
                return@launch
            }
            val cachedResult = withContext(Dispatchers.IO) {
                runCatching { historyCacheStore.readConversation(context.key.endpointId, conversationId) }
            }
            if (!canDispatchTerminalReconcile(context)) {
                settleTerminalReconcile(context, "failed", "terminal_reconcile_epoch_stale")
                return@launch
            }
            if (cachedResult.isFailure) {
                settleTerminalReconcile(context, "failed", "terminal_reconcile_cache_read_failed")
                return@launch
            }
            val cached = cachedResult.getOrNull()
            val checkpoint = normalizeHistoryCheckpointForAvailableItems(
                checkpoint = cached?.checkpoint,
                availableDurableItemCount = cached?.items?.count { !it.provisional } ?: 0
            )
            val request = CodexHistoryTerminalReconcileRequest(
                syncId = context.syncId,
                conversationId = conversationId,
                checkpoint = checkpoint,
                selectionGeneration = context.selectionGeneration,
                terminalEpoch = context.key.terminalEpoch,
                terminalReconcile = capability,
                cacheSchemaVersion = when {
                    historyCapability?.payloadChunks == true && historyCapability?.perPageAck == true -> 2
                    else -> 1
                }
            )
            if (!connectionManager.send(CodexClientMessages.historyTerminalReconcileRequest(request))) {
                settleTerminalReconcile(context, "failed", "terminal_reconcile_send_failed")
                return@launch
            }
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.terminal_reconcile.requested",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(context.syncId),
                    "generation" to context.selectionGeneration,
                    "terminalEpoch" to PersistentDiagnosticLog.shortHash(context.key.terminalEpoch),
                    "checkpointItemCount" to checkpoint.itemCount,
                    "reason" to reason
                )
            )
            context.watchdogJob = viewModelScope.launch {
                delay(historyWatchdogTimeoutMillis())
                if (isTerminalReconcileContextCurrent(context)) {
                    settleTerminalReconcile(context, "failed", "terminal_reconcile_timeout")
                }
            }
        }
    }

    private fun terminalReconcileContext(
        syncId: String,
        conversationId: String,
        terminalEpoch: String?,
        clientSelectionGeneration: Long? = null
    ): TerminalReconcileContext? {
        val context = terminalReconcileContextsBySyncId[syncId] ?: return null
        if (context.key.conversationId != conversationId ||
            context.key.terminalEpoch != terminalEpoch ||
            (clientSelectionGeneration != null &&
                clientSelectionGeneration != context.selectionGeneration) ||
            !isTerminalReconcileContextCurrent(context)
        ) return null
        return context
    }

    private fun sendTerminalReconcileManifest(required: CodexHistoryManifestRequired) {
        val context = terminalReconcileContext(
            syncId = required.syncId,
            conversationId = required.conversationId,
            terminalEpoch = required.terminalEpoch,
            clientSelectionGeneration = required.clientSelectionGeneration
        ) ?: return
        viewModelScope.launch(Dispatchers.IO) {
            val manifestResult = runCatching {
                historyCacheStore.readConversationManifest(
                    context.key.endpointId,
                    context.key.conversationId
                )
            }
            if (!isTerminalReconcileContextCurrent(context)) return@launch
            if (manifestResult.isFailure) {
                settleTerminalReconcile(context, "failed", "terminal_reconcile_manifest_read_failed")
                return@launch
            }
            val pageSize = required.pageSize.coerceIn(1, 2_000)
            val manifest = manifestResult.getOrDefault(emptyList())
            val pages = manifest.takeIf { it.isNotEmpty() }?.chunked(pageSize) ?: listOf(emptyList())
            for ((index, pageItems) in pages.withIndex()) {
                if (!isTerminalReconcileContextCurrent(context)) return@launch
                val items = JSONArray().apply {
                    pageItems.forEach { entry ->
                        put(JSONObject().apply {
                            put("itemKey", entry.itemKey)
                            put("contentHash", entry.contentHash)
                        })
                    }
                }
                val sent = connectionManager.send(
                    CodexClientMessages.historyManifestPage(
                        syncId = required.syncId,
                        conversationId = required.conversationId,
                        pageIndex = index,
                        lastPage = index == pages.lastIndex,
                        items = items,
                        selectionGeneration = context.selectionGeneration,
                        purpose = TERMINAL_RECONCILE_PURPOSE,
                        terminalEpoch = context.key.terminalEpoch
                    )
                )
                if (!sent) {
                    settleTerminalReconcile(context, "failed", "terminal_reconcile_manifest_send_failed")
                    return@launch
                }
            }
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.terminal_reconcile.manifest_sent",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(context.key.conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(context.syncId),
                    "itemCount" to manifest.size,
                    "pageCount" to pages.size
                )
            )
        }
    }

    private fun sendTerminalReconcileAck(
        context: TerminalReconcileContext,
        targetRoot: String,
        sequence: Int,
        pageIndex: Int
    ) {
        if (!isTerminalReconcileContextCurrent(context)) return
        if (!connectionManager.send(
                CodexClientMessages.historySyncAck(
                    syncId = context.syncId,
                    conversationId = context.key.conversationId,
                    targetRoot = targetRoot,
                    sequence = sequence,
                    pageIndex = pageIndex,
                    selectionGeneration = context.selectionGeneration,
                    purpose = TERMINAL_RECONCILE_PURPOSE,
                    terminalEpoch = context.key.terminalEpoch
                )
            )
        ) {
            settleTerminalReconcile(context, "failed", "terminal_reconcile_ack_send_failed")
        }
    }

    private fun handleTerminalReconcileDelta(wire: CodexHistoryDeltaWire) {
        val delta = wire.page
        val context = terminalReconcileContext(
            syncId = delta.syncId,
            conversationId = delta.conversationId,
            terminalEpoch = wire.terminalEpoch,
            clientSelectionGeneration = delta.selectionGeneration
        ) ?: return
        if (CodexHistoryPageHasher.pageHash(delta) != delta.pageHash
        ) {
            settleTerminalReconcile(context, "failed", "terminal_reconcile_delta_invalid")
            return
        }
        pendingTerminalReconcilePages[historyPageKey(delta.syncId, delta.pageIndex)] = delta
        viewModelScope.launch(Dispatchers.IO) {
            if (!isTerminalReconcileContextCurrent(context)) return@launch
            val result = runCatching {
                historyApplyMutex.withLock {
                    if (isTerminalReconcileContextCurrent(context)) {
                        historyCacheStore.applyDeltaPage(context.key.endpointId, delta)
                    } else {
                        CodexConversationCacheStore.PageApplyResult.REJECTED
                    }
                }
            }.getOrDefault(CodexConversationCacheStore.PageApplyResult.REJECTED)
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.terminal_reconcile.delta_applied",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(delta.conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(delta.syncId),
                    "pageIndex" to delta.pageIndex,
                    "pageCount" to delta.pageCount,
                    "result" to result.name
                ),
                level = if (result == CodexConversationCacheStore.PageApplyResult.REJECTED ||
                    result == CodexConversationCacheStore.PageApplyResult.REJECTED_CONFLICT
                ) "warn" else "info"
            )
            when (result) {
                CodexConversationCacheStore.PageApplyResult.COMMITTED,
                CodexConversationCacheStore.PageApplyResult.READY,
                CodexConversationCacheStore.PageApplyResult.IDEMPOTENT -> {
                    sendTerminalReconcileAck(context, delta.targetRoot, delta.sequence, delta.pageIndex)
                    if (result != CodexConversationCacheStore.PageApplyResult.READY) {
                        pendingTerminalReconcilePages.remove(historyPageKey(delta.syncId, delta.pageIndex))
                    }
                }
                CodexConversationCacheStore.PageApplyResult.STAGED -> Unit
                else -> settleTerminalReconcile(context, "failed", "terminal_reconcile_delta_apply_failed")
            }
        }
    }

    private fun handleTerminalReconcilePayloadChunk(wire: CodexHistoryPayloadChunkWire) {
        val chunk = wire.chunk
        val context = terminalReconcileContext(
            syncId = chunk.syncId,
            conversationId = chunk.conversationId,
            terminalEpoch = wire.terminalEpoch,
            clientSelectionGeneration = chunk.selectionGeneration
        ) ?: return
        viewModelScope.launch(Dispatchers.IO) {
            if (!isTerminalReconcileContextCurrent(context)) return@launch
            val result = runCatching {
                historyApplyMutex.withLock {
                    if (isTerminalReconcileContextCurrent(context)) {
                        historyCacheStore.applyPayloadChunk(context.key.endpointId, chunk)
                    } else {
                        CodexConversationCacheStore.PageApplyResult.REJECTED
                    }
                }
            }.getOrDefault(CodexConversationCacheStore.PageApplyResult.REJECTED)
            when (result) {
                CodexConversationCacheStore.PageApplyResult.COMMITTED,
                CodexConversationCacheStore.PageApplyResult.READY,
                CodexConversationCacheStore.PageApplyResult.IDEMPOTENT -> {
                    val page = pendingTerminalReconcilePages[historyPageKey(chunk.syncId, chunk.pageIndex)]
                    sendTerminalReconcileAck(
                        context = context,
                        targetRoot = page?.targetRoot?.ifBlank { chunk.targetRoot } ?: chunk.targetRoot,
                        sequence = chunk.sequence,
                        pageIndex = chunk.pageIndex
                    )
                    if (result != CodexConversationCacheStore.PageApplyResult.READY) {
                        pendingTerminalReconcilePages.remove(historyPageKey(chunk.syncId, chunk.pageIndex))
                    }
                }
                CodexConversationCacheStore.PageApplyResult.STAGED -> Unit
                else -> settleTerminalReconcile(context, "failed", "terminal_reconcile_payload_apply_failed")
            }
        }
    }

    private fun handleTerminalReconcileState(syncState: CodexHistorySyncStateMessage) {
        val context = terminalReconcileContext(
            syncId = syncState.syncId,
            conversationId = syncState.conversationId,
            terminalEpoch = syncState.terminalEpoch,
            clientSelectionGeneration = syncState.clientSelectionGeneration
        ) ?: return
        settleTerminalReconcile(
            context = context,
            state = syncState.state,
            detailCode = syncState.detailCode
        )
    }

    private fun clearCanonicalTailValidationState() {
        tailValidationDispatchJob?.cancel()
        tailValidationDispatchJob = null
        tailValidationWatchdogJob?.cancel()
        tailValidationWatchdogJob = null
        tailValidationMetadataSelectionKey = null
        tailValidationAwaitingMetadataKey = null
        tailValidationInFlightKey = null
        tailValidationInFlightSyncId = null
        tailValidationSettledKey = null
        tailValidationOutcome = null
        tailValidationDetailCode = null
    }

    private fun cancelCanonicalTailValidationWatchdog() {
        tailValidationWatchdogJob?.cancel()
        tailValidationWatchdogJob = null
    }

    /**
     * This intentionally never calls `maybeRequestHistorySync`, recovery, or
     * a cache-store writer.  The only effect is an additive, one-page
     * read-only Gateway intent for an already-complete static cache.
     */
    private fun maybeRequestCanonicalTailValidation(
        conversationId: String?,
        reason: String
    ) {
        val normalizedConversationId = conversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val key = historySelectionKeyOrNull(normalizedConversationId, historySelectionGeneration) ?: return
        val capability = historyCapability?.tailValidation
        val decision = canonicalTailValidationRequestDecision(
            key = key,
            completeStaticCache = hasCompleteServerSnapshotCache(
                normalizedConversationId,
                historySelectionGeneration
            ),
            healthyIpcAuthority = hasHealthyIpcAuthorityForCanonicalTailValidation(key),
            metadataReadyKey = tailValidationMetadataSelectionKey,
            capabilityKnown = ipcStatusObserved,
            capabilityEnabled = capability?.enabled == true,
            capabilityVersion = capability?.version ?: 0,
            inFlightKey = tailValidationInFlightKey,
            settledKey = tailValidationSettledKey
        )
        when (decision) {
            CanonicalTailValidationRequestDecision.NOOP -> Unit
            CanonicalTailValidationRequestDecision.WAIT_FOR_HEALTHY_IPC -> {
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.tail_validation.waiting_for_healthy_ipc",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                        "generation" to key.generation,
                        "reason" to reason
                    )
                )
            }
            CanonicalTailValidationRequestDecision.WAIT_FOR_CAPABILITY -> {
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.tail_validation.waiting_for_capability",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                        "generation" to key.generation,
                        "reason" to reason
                    )
                )
            }
            CanonicalTailValidationRequestDecision.WAIT_FOR_METADATA -> {
                if (tailValidationAwaitingMetadataKey != key) {
                    tailValidationAwaitingMetadataKey = key
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.tail_validation.waiting_for_metadata",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                            "generation" to key.generation,
                            "reason" to reason
                        )
                    )
                    armCanonicalTailValidationMetadataWatchdog(key)
                }
            }
            CanonicalTailValidationRequestDecision.SETTLE_UNSUPPORTED -> {
                settleCanonicalTailValidation(
                    key = key,
                    syncId = null,
                    outcome = CanonicalTailValidationOutcome.UNSUPPORTED,
                    detailCode = "history_tail_validation_capability_unsupported"
                )
            }
            CanonicalTailValidationRequestDecision.REQUEST -> {
                val tailValidationCapability = capability ?: return
                val profile = currentProfile ?: return
                val requestSyncId = UUID.randomUUID().toString()
                tailValidationAwaitingMetadataKey = null
                tailValidationInFlightKey = key
                tailValidationInFlightSyncId = requestSyncId
                tailValidationDispatchJob?.cancel()
                tailValidationDispatchJob = viewModelScope.launch {
                    val cachedResult = withContext(Dispatchers.IO) {
                        runCatching {
                            historyCacheStore.readConversation(profile.id, normalizedConversationId)
                        }
                    }
                    if (!isCurrentHistorySelection(key) ||
                        tailValidationInFlightKey != key ||
                        tailValidationInFlightSyncId != requestSyncId
                    ) {
                        return@launch
                    }
                    val cached = cachedResult.getOrNull()
                    val durableItemCount = cached?.items?.count { !it.provisional } ?: 0
                    val checkpoint = normalizeHistoryCheckpointForAvailableItems(
                        checkpoint = cached?.checkpoint,
                        availableDurableItemCount = durableItemCount
                    )
                    if (checkpoint.newestAnchorKey.isNullOrBlank() || checkpoint.newestAnchorHash.isNullOrBlank()) {
                        settleCanonicalTailValidation(
                            key = key,
                            syncId = requestSyncId,
                            outcome = CanonicalTailValidationOutcome.FAILED,
                            detailCode = if (cachedResult.isFailure) {
                                "history_tail_validation_checkpoint_unavailable"
                            } else {
                                "history_tail_validation_anchor_missing"
                            }
                        )
                        return@launch
                    }
                    val request = CodexHistoryTailValidationRequest(
                        syncId = requestSyncId,
                        conversationId = normalizedConversationId,
                        checkpoint = checkpoint,
                        selectionGeneration = key.generation,
                        tailValidation = tailValidationCapability
                    )
                    val sent = connectionManager.send(
                        CodexClientMessages.historyTailValidationRequest(request)
                    )
                    if (!sent) {
                        settleCanonicalTailValidation(
                            key = key,
                            syncId = requestSyncId,
                            outcome = CanonicalTailValidationOutcome.FAILED,
                            detailCode = "history_tail_validation_send_failed"
                        )
                        return@launch
                    }
                    armCanonicalTailValidationWatchdog(key, requestSyncId)
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.tail_validation.requested",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                            "syncId" to PersistentDiagnosticLog.shortHash(requestSyncId),
                            "generation" to key.generation,
                            "reason" to reason,
                            "checkpointItemCount" to checkpoint.itemCount
                        )
                    )
                }
            }
        }
    }

    private fun armCanonicalTailValidationWatchdog(
        key: CodexHistorySelectionKey,
        syncId: String
    ) {
        cancelCanonicalTailValidationWatchdog()
        val timeoutMillis = historyWatchdogTimeoutMillis()
        tailValidationWatchdogJob = viewModelScope.launch {
            delay(timeoutMillis)
            if (!isCurrentHistorySelection(key) ||
                tailValidationInFlightKey != key ||
                tailValidationInFlightSyncId != syncId
            ) {
                return@launch
            }
            tailValidationWatchdogJob = null
            settleCanonicalTailValidation(
                key = key,
                syncId = syncId,
                outcome = CanonicalTailValidationOutcome.FAILED,
                detailCode = "history_tail_validation_timeout"
            )
        }
    }

    /**
     * Android deliberately waits for the matching metadata-resume response so
     * it cannot race Gateway's history-mode observation.  A lost response is
     * still fail-closed: settle private FAILED instead of issuing an unsafe
     * request or waiting forever.
     */
    private fun armCanonicalTailValidationMetadataWatchdog(key: CodexHistorySelectionKey) {
        cancelCanonicalTailValidationWatchdog()
        val timeoutMillis = historyWatchdogTimeoutMillis()
        tailValidationWatchdogJob = viewModelScope.launch {
            delay(timeoutMillis)
            if (!isCurrentHistorySelection(key) ||
                tailValidationAwaitingMetadataKey != key ||
                tailValidationInFlightKey != null ||
                tailValidationSettledKey == key
            ) {
                return@launch
            }
            tailValidationWatchdogJob = null
            tailValidationAwaitingMetadataKey = null
            settleCanonicalTailValidation(
                key = key,
                syncId = null,
                outcome = CanonicalTailValidationOutcome.FAILED,
                detailCode = "history_tail_validation_metadata_missing"
            )
        }
    }

    private fun settleCanonicalTailValidation(
        key: CodexHistorySelectionKey,
        syncId: String?,
        outcome: CanonicalTailValidationOutcome,
        detailCode: String?
    ) {
        if (!isCurrentHistorySelection(key)) return
        if (syncId != null &&
            (tailValidationInFlightKey != key || tailValidationInFlightSyncId != syncId)
        ) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.tail_validation.stale_result_ignored",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(key.conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(syncId),
                    "generation" to key.generation,
                    "outcome" to outcome.name
                ),
                level = "warn"
            )
            return
        }
        cancelCanonicalTailValidationWatchdog()
        tailValidationDispatchJob = null
        tailValidationInFlightKey = null
        tailValidationInFlightSyncId = null
        tailValidationSettledKey = key
        tailValidationOutcome = outcome
        tailValidationDetailCode = detailCode
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.tail_validation.result",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(key.conversationId),
                "syncId" to PersistentDiagnosticLog.shortHash(syncId),
                "generation" to key.generation,
                "outcome" to outcome.name,
                "detailCode" to detailCode
            ),
            level = if (outcome == CanonicalTailValidationOutcome.NEEDS_RECONCILE ||
                outcome == CanonicalTailValidationOutcome.FAILED
            ) "warn" else "info"
        )
    }

    private fun noteCanonicalTailValidationMetadataReady(response: CodexResponse) {
        if (response.raw.optLong("selectionGeneration", -1L) != historySelectionGeneration) return
        val conversationId = extractThreadResult(response.result)
            ?.optStringOrNullCompat("id")
            ?.let(::normalizeThreadId)
            ?: return
        val key = historySelectionKeyOrNull(conversationId, historySelectionGeneration) ?: return
        if (!isCurrentHistorySelection(key)) return
        tailValidationMetadataSelectionKey = key
        tailValidationAwaitingMetadataKey = null
        cancelCanonicalTailValidationWatchdog()
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.tail_validation.metadata_ready",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                "generation" to key.generation
            )
        )
        maybeRequestCanonicalTailValidation(conversationId, "metadata_response")
        maybeScheduleTerminalReconcile(
            _uiState.value.ipcSurfaceSnapshot,
            "metadata_response"
        )
    }

    private fun handleCanonicalTailValidationState(syncState: CodexHistorySyncStateMessage) {
        val key = historySelectionKeyOrNull(
            syncState.conversationId,
            syncState.clientSelectionGeneration
        )
        if (key == null ||
            !isCurrentHistorySelection(key) ||
            syncState.clientSelectionGeneration != historySelectionGeneration ||
            tailValidationInFlightKey != key ||
            tailValidationInFlightSyncId != syncState.syncId
        ) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.tail_validation.stale_state_ignored",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(syncState.conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(syncState.syncId),
                    "generation" to syncState.clientSelectionGeneration,
                    "state" to syncState.state,
                    "detailCode" to syncState.detailCode
                ),
                level = "warn"
            )
            return
        }
        settleCanonicalTailValidation(
            key = key,
            syncId = syncState.syncId,
            outcome = canonicalTailValidationOutcomeFromWire(syncState.state),
            detailCode = syncState.detailCode ?: "history_tail_validation_state_invalid"
        )
    }

    private fun handleLiveReplayState(replay: CodexLiveReplayStateMessage) {
        val key = historySelectionKeyOrNull(
            replay.conversationId,
            replay.clientSelectionGeneration
        )
        if (key == null ||
            !isCurrentHistorySelection(key) ||
            replay.clientSelectionGeneration != historySelectionGeneration ||
            liveReplayInFlightSyncId != replay.syncId
        ) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.live_replay.stale_state_ignored",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(replay.conversationId),
                    "syncId" to PersistentDiagnosticLog.shortHash(replay.syncId),
                    "generation" to replay.clientSelectionGeneration,
                    "state" to replay.state,
                    "detailCode" to replay.detailCode
                ),
                level = "warn"
            )
            return
        }
        liveReplayInFlightSyncId = null
        liveReplayOutcome = replay.state
        liveReplayDetailCode = replay.detailCode
        val replayMessages = replay.items
            .sortedBy { it.position }
            .mapNotNull(::decodeCachedHistoryItem)
        var beforeCount = 0
        var afterCount = 0
        if (replayMessages.isNotEmpty()) {
            _uiState.update { state ->
                if (!isCurrentHistorySelection(key)) return@update state
                beforeCount = state.messages.size
                val merged = mergeCanonicalTailMessagesForUi(
                    currentMessages = state.messages,
                    tailMessages = replayMessages
                )
                afterCount = merged.size
                // This is intentionally messages-only. The replay is not a
                // history-sync delta and must not mutate cachedCanonicalMessages,
                // cache state, SQLite, or the realtime authority.
                state.copy(messages = merged)
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.live_replay.result",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(replay.conversationId),
                "syncId" to PersistentDiagnosticLog.shortHash(replay.syncId),
                "generation" to replay.clientSelectionGeneration,
                "state" to replay.state,
                "detailCode" to replay.detailCode,
                "source" to replay.source,
                "continuity" to replay.continuity,
                "replayable" to replay.replayable,
                "needsCanonical" to replay.needsCanonical,
                "tracking" to replay.tracking,
                "replayItemCount" to replayMessages.size,
                "messageCountBefore" to beforeCount,
                "messageCountAfter" to afterCount,
                "surfaceRevision" to replay.surfaceRevision,
                "canonicalNewestKeyPresent" to !replay.canonicalNewestItemKey.isNullOrBlank()
            ),
            level = if (replay.state.equals("failed", ignoreCase = true) ||
                replay.state.equals("source_gap", ignoreCase = true)
            ) "warn" else "info"
        )
    }

    /**
     * The recovery request cannot be cancelled remotely, but once the
     * matching healthy surface is applied it must be locally quarantined.  A
     * late `recovery_state` then fails its active sync-id fence and cannot
     * reopen or overwrite the IPC-authoritative selection.
     */
    private fun stopHistoryRecoveryForHealthySurface(
        conversationId: String,
        generation: Long
    ) {
        val key = historySelectionKeyOrNull(conversationId, generation) ?: return
        if (!isCurrentHistorySelection(key) ||
            historyRecoveryInFlightConversationId?.trim() != conversationId
        ) return
        historyRecoveryInFlightConversationId = null
        historyRecoveryInFlightSyncId = null
        cancelHistoryWatchdog()
        _uiState.update { state ->
            if (isCurrentHistorySelection(key)) {
                state.copy(
                    historyNetworkSyncState = historyNetworkState(
                        key,
                        historyNetworkStateAfterHealthySurfaceStopsRecovery(
                            cacheReady = state.historyCacheState.ready,
                            cacheComplete = state.historyCacheState.complete
                        )
                    )
                )
            } else {
                state
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.recovery_cancelled_by_healthy_surface",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                "generation" to generation
            )
        )
    }

    private fun historyPageKey(syncId: String, pageIndex: Int): String = "$syncId:$pageIndex"

    private fun historySnapshotSegmentKey(syncId: String, sequence: Int): String = "$syncId:segment:$sequence"

    private fun historySnapshotPayloadHash(value: String): String =
        MessageDigest.getInstance("SHA-256")
            .digest(value.toByteArray(Charsets.UTF_8))
            .joinToString("") { "%02x".format(it) }

    private fun maybeRequestHistorySync(conversationId: String?) {
        val normalizedConversationId = conversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val profile = currentProfile ?: return
        val requestGeneration = historySelectionGeneration
        val selectionKey = historySelectionKeyOrNull(normalizedConversationId, requestGeneration)
        val cacheState = _uiState.value.historyCacheState
        val productOnly = selectionKey != null &&
            historyCapability?.productHistory?.isSupported() == true &&
            productHistoryProbeSelectionKey != selectionKey &&
            cacheState.ready && cacheState.complete &&
            normalizeCodexThreadId(cacheState.conversationId) == normalizedConversationId &&
            cacheState.generation == requestGeneration
        if (historySyncInFlightConversationId == normalizedConversationId) return
        if (shouldWaitForActiveConversationSubscription(normalizedConversationId, requestGeneration)) {
            return
        }
        val selectedSurface = _uiState.value.ipcSurfaceSnapshot?.takeIf { surface ->
            normalizeCodexThreadId(surface.conversationId) == normalizedConversationId
        }
        if (!productOnly && deferOrdinaryHistoryLaneForCompleteLocalCache(
                conversationId = normalizedConversationId,
                generation = requestGeneration,
                surfaceStatus = selectedSurface?.status,
                surfaceDesynced = selectedSurface?.desynced == true || matchingIpcSurfaceDesynced,
                reason = "selection_or_surface"
            )
        ) {
            maybeRequestCanonicalTailValidation(
                normalizedConversationId,
                "complete_local_cache"
            )
            return
        }
        if (historyRecoveryInFlightConversationId == normalizedConversationId) return
        if (deferOrdinaryHistoryLaneForTerminalReconcile(
                conversationId = normalizedConversationId,
                generation = requestGeneration,
                reason = "selection_or_surface"
            )
        ) {
            return
        }
        if (!productOnly && hasCompleteServerSnapshotCache(normalizedConversationId, requestGeneration)) {
            // A complete static snapshot remains a normal-history fast path,
            // but it is never proof that its newest canonical tail is fresh.
            // Step 3 observes that question privately and must not reopen the
            // manifest/range/recovery lane.
            maybeRequestCanonicalTailValidation(
                normalizedConversationId,
                "complete_static_cache"
            )
            if (!shouldRequestHistorySyncForSelection(
                    conversationId = normalizedConversationId,
                    selectionGeneration = requestGeneration,
                    inFlightConversationId = historySyncInFlightConversationId,
                    settledConversationId = historySyncSettledConversationId,
                    settledGeneration = historySyncSettledGeneration
                )) {
                return
            }
            // Cache-first selection has already proved the complete static
            // B4R snapshot.  Keep its terminal local state stable instead of
            // briefly advertising SYNCING and re-reading the same rows.
            markHistorySyncSettled(normalizedConversationId, requestGeneration)
            val completeSnapshotKey = historySelectionKeyOrNull(
                normalizedConversationId,
                requestGeneration
            )
            if (completeSnapshotKey != null) {
                _uiState.update { state ->
                    if (isCurrentHistorySelection(completeSnapshotKey)) {
                        state.copy(
                            historyNetworkSyncState = historyNetworkState(
                                completeSnapshotKey,
                                CodexHistoryNetworkSyncState.CACHE_ONLY
                            )
                        )
                    } else state
                }
            }
            return
        }
        if (!productOnly && !shouldRequestHistorySyncForSelection(
                conversationId = normalizedConversationId,
                selectionGeneration = requestGeneration,
                inFlightConversationId = historySyncInFlightConversationId,
                settledConversationId = historySyncSettledConversationId,
                settledGeneration = historySyncSettledGeneration
        )) return
        val capability = historyCapability ?: return
        val snapshotSegments = capability.serverSnapshotSegments?.takeIf {
            it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
        }
        val key = historySelectionKeyOrNull(normalizedConversationId, requestGeneration) ?: return
        if (capability.version != 1) {
            _uiState.update { state ->
                if (isCurrentHistorySelection(key)) {
                    state.copy(
                        historyNetworkSyncState = historyNetworkState(
                            key,
                            CodexHistoryNetworkSyncState.UNSUPPORTED
                        )
                    )
                } else state
            }
            return
        }
        historySyncInFlightConversationId = normalizedConversationId
        val requestSyncId = UUID.randomUUID().toString()
        historySyncInFlightSyncId = requestSyncId
        _uiState.update { state ->
            if (isCurrentHistorySelection(key) &&
                state.historyNetworkSyncState.state != CodexHistoryNetworkSyncState.REPAIRING
            ) {
                state.copy(
                    historyNetworkSyncState = historyNetworkState(
                        key,
                        CodexHistoryNetworkSyncState.SYNCING
                    )
                )
            } else {
                state
            }
        }
        viewModelScope.launch(Dispatchers.IO) {
            // A process restart resets the in-memory selection generation, but
            // SQLite may still contain staging sessions from an older process
            // whose generation is numerically newer.  The cache store treats
            // such a row as a newer selection and rejects the fresh delta as
            // STALE.  Clear only unfinished sync rows for this conversation;
            // committed history is untouched, and the current wire sync has
            // not created its row yet.
            runCatching {
                historyCacheStore.clearInterruptedSync(
                    profile.id,
                    normalizedConversationId
                )
            }.onFailure { error ->
                Log.w(TAG, "Failed to clear stale history staging", error)
            }
            val cached = runCatching {
                historyCacheStore.readConversation(profile.id, normalizedConversationId)
            }.getOrNull()
            val durableItemCount = cached?.items?.count { !it.provisional } ?: 0
            val checkpoint = normalizeHistoryCheckpointForAvailableItems(
                checkpoint = cached?.checkpoint,
                availableDurableItemCount = durableItemCount
            )
            // A completed B4R static snapshot already contains the full local
            // history. Step 3 validates canonical-tail freshness through its
            // separate private lane; do not reopen the old manifest/range lane
            // on every task selection.
            if (!productOnly && shouldPromoteCompleteServerSnapshotCache(
                    serverSnapshotSegmentsEnabled = snapshotSegments != null,
                    providerMode = checkpoint.providerMode,
                    cacheCoverageComplete = checkpoint.coverageComplete &&
                        checkpoint.itemCount == durableItemCount
                )
            ) {
                if (isCurrentHistorySelection(normalizedConversationId, requestGeneration) &&
                    acceptsActiveHistorySyncId(historySyncInFlightSyncId, requestSyncId)
                ) {
                    completeServerSnapshotCacheSelectionKey = key
                    historySyncInFlightConversationId = null
                    historySyncInFlightSyncId = null
                    markHistorySyncSettled(normalizedConversationId, requestGeneration)
                    cancelHistoryWatchdog()
                    _uiState.update { state ->
                        if (isCurrentHistorySelection(key)) {
                            state.copy(
                                historyNetworkSyncState = historyNetworkState(
                                    key,
                                    CodexHistoryNetworkSyncState.CACHE_ONLY
                                )
                            )
                        } else state
                    }
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.snapshot_cache_complete",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                            "generation" to requestGeneration,
                            "itemCount" to durableItemCount
                        )
                    )
                    withContext(Dispatchers.Main.immediate) {
                        maybeRequestCanonicalTailValidation(
                            normalizedConversationId,
                            "static_cache_promoted"
                        )
                    }
                }
                return@launch
            }
            if (cached?.checkpoint?.complete == true &&
                cached.checkpoint.itemCount != durableItemCount
            ) {
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.checkpoint_repair_required",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                        "checkpointItemCount" to cached.checkpoint.itemCount,
                        "availableDurableItemCount" to durableItemCount,
                        "generation" to requestGeneration
                    ),
                    level = "warn"
                )
            }
            val request = CodexHistorySyncRequest(
                syncId = requestSyncId,
                conversationId = normalizedConversationId,
                checkpoint = checkpoint,
                selectionGeneration = requestGeneration,
                cacheSchemaVersion = when {
                    snapshotSegments != null -> 3
                    capability.rangeSegments?.enabled == true && capability.rangeSegments.cacheSchemaVersion >= 3 -> 3
                    capability.payloadChunks && capability.perPageAck -> 2
                    else -> 1
                },
                // Advertise both lanes when available. The Gateway selects
                // product_db range for a canonical row and server_snapshot
                // only on a product DB miss; the response providerMode owns
                // the cache/older routing, not capability order.
                rangeSegments = capability.rangeSegments?.takeIf {
                    it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
                },
                serverSnapshotSegments = snapshotSegments,
                profileId = profile.id,
                productHistory = capability.productHistory,
                productOnly = productOnly
            )
            if (!isCurrentHistorySelection(normalizedConversationId, requestGeneration) ||
                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, request.syncId)
            ) return@launch
            if (historyRecoveryInFlightConversationId == normalizedConversationId) return@launch
            if (request.rangeSegments?.enabled == true) {
                // Register the terminal-routing fence before the send. A
                // loopback/test transport may deliver the first terminal
                // state synchronously with send(), and that state must still
                // be eligible to continue the older pump.
                rangeHistorySyncIds += request.syncId
            }
            if (productOnly) productHistoryProbeSelectionKey = key
            val sent = connectionManager.send(CodexClientMessages.historySyncRequest(request))
            if (!sent) {
                rangeHistorySyncIds -= request.syncId
                if (productOnly && productHistoryProbeSelectionKey == key) productHistoryProbeSelectionKey = null
            }
            if (!sent && isCurrentHistorySelection(normalizedConversationId, requestGeneration) &&
                acceptsActiveHistorySyncId(historySyncInFlightSyncId, request.syncId)
            ) {
                historySyncInFlightConversationId = null
                historySyncInFlightSyncId = null
                markHistorySyncSettled(normalizedConversationId, requestGeneration)
                cancelHistoryWatchdog()
                _uiState.update { state ->
                    if (isCurrentHistorySelection(normalizedConversationId, requestGeneration)) {
                        state.copy(
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                CodexHistoryNetworkSyncState.OFFLINE
                            )
                        )
                    } else {
                        state
                    }
                }
            }
            if (sent && isCurrentHistorySelection(normalizedConversationId, requestGeneration) &&
                acceptsActiveHistorySyncId(historySyncInFlightSyncId, request.syncId)
            ) {
                armHistoryWatchdog(
                    normalizedConversationId,
                    requestGeneration,
                    "sync",
                    request.syncId
                )
            }
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.sync_requested",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                    "generation" to requestGeneration,
                    "cacheSchemaVersion" to request.cacheSchemaVersion,
                    "sent" to sent,
                    "historyPayloadChunks" to capability.payloadChunks,
                    "historyPerPageAck" to capability.perPageAck,
                    "historyRangeSegments" to (request.rangeSegments?.enabled == true),
                    "historyServerSnapshotSegments" to (request.serverSnapshotSegments?.enabled == true)
                ),
                level = if (sent) "info" else "warn"
            )
        }
    }

    /**
     * Request exactly one older range page.  B4 may invoke the same seam from
     * the bounded background pump; it still never issues a second request
     * until the previous page reaches a terminal sync state.
     */
    internal fun requestOlderHistoryPage(auto: Boolean = false): Boolean {
        val profile = currentProfile ?: return false
        val conversationId = _uiState.value.activeConversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return false
        val capability = historyCapability ?: return false
        val rangeCapability = capability.rangeSegments?.takeIf {
            it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
        } ?: return false
        if (historyRecoveryInFlightConversationId == conversationId || historySyncInFlightConversationId == conversationId) return false
        val generation = historySelectionGeneration
        val key = historySelectionKeyOrNull(conversationId, generation) ?: return false
        val syncId = UUID.randomUUID().toString()
        historySyncInFlightConversationId = conversationId
        historySyncInFlightSyncId = syncId
        clearHistorySyncSettlement()
        _uiState.update { state ->
            if (isCurrentHistorySelection(key)) {
                state.copy(
                    historyNetworkSyncState = historyNetworkState(
                        key,
                        CodexHistoryNetworkSyncState.SYNCING
                    )
                )
            } else state
        }
        viewModelScope.launch(Dispatchers.IO) {
            val cached = runCatching {
                historyCacheStore.readConversation(profile.id, conversationId)
            }.getOrNull()
            val durableItemCount = cached?.items?.count { !it.provisional } ?: 0
            val checkpoint = normalizeHistoryCheckpointForAvailableItems(
                checkpoint = cached?.checkpoint,
                availableDurableItemCount = durableItemCount
            )
            if (checkpoint.providerMode == "server_snapshot" || checkpoint.hasMoreBefore != true || checkpoint.nextOlderCursor.isNullOrBlank() ||
                !isCurrentHistorySelection(conversationId, generation) ||
                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)
            ) {
                if (isCurrentHistorySelection(conversationId, generation) && acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)) {
                    historySyncInFlightConversationId = null
                    historySyncInFlightSyncId = null
                    markHistorySyncSettled(conversationId, generation)
                    cancelHistoryWatchdog()
                    _uiState.update { state ->
                        if (isCurrentHistorySelection(key)) {
                            state.copy(
                                historyNetworkSyncState = historyNetworkState(
                                    key,
                                    CodexHistoryNetworkSyncState.PARTIAL,
                                    detailCode = "history_no_older_page"
                                )
                            )
                        } else state
                    }
                }
                return@launch
            }
            // Record the one-page lane before send() for the same reason as
            // the initial range request: a very fast terminal response must
            // still release the coordinator's in-flight fence.
            olderHistorySyncIds += syncId
            val sent = connectionManager.send(
                CodexClientMessages.historyOlderRequest(
                    syncId = syncId,
                    conversationId = conversationId,
                    checkpoint = checkpoint,
                    selectionGeneration = generation,
                    rangeSegments = rangeCapability
                )
            )
            if (!sent) {
                olderHistorySyncIds -= syncId
            }
            if (sent && isCurrentHistorySelection(conversationId, generation) && acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)) {
                armHistoryWatchdog(conversationId, generation, "sync", syncId)
            } else if (!sent && isCurrentHistorySelection(conversationId, generation) && acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)) {
                historySyncInFlightConversationId = null
                historySyncInFlightSyncId = null
                markHistorySyncSettled(conversationId, generation)
                cancelHistoryWatchdog()
                _uiState.update { state ->
                    if (isCurrentHistorySelection(key)) {
                        state.copy(
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                CodexHistoryNetworkSyncState.OFFLINE,
                                detailCode = "history_older_send_failed"
                            )
                        )
                    } else state
                }
            }
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.older_requested",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                    "generation" to generation,
                    "syncId" to PersistentDiagnosticLog.shortHash(syncId),
                    "cursorPresent" to true,
                    "automatic" to auto,
                    "sent" to sent
                ),
                level = if (sent) "info" else "warn"
            )
        }
        return true
    }

    private fun requestHistoryRecovery(conversationId: String): Boolean {
        val normalizedConversationId = conversationId.trim().takeIf { it.isNotEmpty() } ?: return false
        val capability = historyCapability ?: return false
        if (!capability.recovery || historyRecoveryInFlightConversationId == normalizedConversationId) return false
        if (_uiState.value.activeConversationId?.trim() != normalizedConversationId) return false
        val generation = historySelectionGeneration
        val key = historySelectionKeyOrNull(normalizedConversationId, generation) ?: return false
        val completeServerSnapshotCache = hasCompleteServerSnapshotCache(
            normalizedConversationId,
            generation
        )
        if (historySyncInFlightConversationId == normalizedConversationId) {
            // A full recovery supersedes a still-running ordinary sync.  The
            // old wire id is quarantined before the recovery watchdog is
            // armed, so the two lanes cannot race one shared watchdog.
            historySyncInFlightConversationId = null
            historySyncInFlightSyncId = null
            markHistorySyncSettled(normalizedConversationId, generation)
            cancelHistoryWatchdog()
        }
        historyRecoveryInFlightConversationId = normalizedConversationId
        _uiState.update { state ->
            if (isCurrentHistorySelection(key)) {
                state.copy(
                    historyNetworkSyncState = historyNetworkState(
                        key,
                        historyNetworkStateForCompleteServerSnapshotRecovery(
                            completeServerSnapshotCache,
                            CodexHistoryNetworkSyncState.REPAIRING
                        )
                    )
                )
            } else {
                state
            }
        }
        val syncId = UUID.randomUUID().toString()
        historyRecoveryInFlightSyncId = syncId
        val sent = connectionManager.send(
            CodexClientMessages.historyRecoveryRequest(
                syncId = syncId,
                conversationId = normalizedConversationId,
                selectionGeneration = generation,
                rangeSegments = capability.rangeSegments?.takeIf {
                    it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
                }
            )
        )
        if (!sent) {
            historyRecoveryInFlightConversationId = null
            historyRecoveryInFlightSyncId = null
            cancelHistoryWatchdog()
            _uiState.update { state ->
                if (isCurrentHistorySelection(key)) {
                    state.copy(
                        historyNetworkSyncState = historyNetworkState(
                            key,
                            historyNetworkStateForCompleteServerSnapshotRecovery(
                                completeServerSnapshotCache,
                                CodexHistoryNetworkSyncState.OFFLINE
                            )
                        )
                    )
                } else state
            }
        } else {
            armHistoryWatchdog(
                normalizedConversationId,
                generation,
                "recovery",
                syncId
            )
        }
        return sent
    }

    /**
     * Escalate a partial/unavailable baseline once for the current selection.
     * The recovery path performs a bounded server-side thread/read and feeds
     * it back through the same manifest/delta protocol; it never becomes a
     * second realtime authority and cannot loop on a running partial turn.
     */
    private fun requestHistoryRecoveryOnce(conversationId: String, reason: String): Boolean {
        val normalizedConversationId = conversationId.trim().takeIf { it.isNotEmpty() } ?: return false
        if (historyRecoveryRequestedGeneration == historySelectionGeneration) return false
        if (_uiState.value.activeConversationId?.trim() != normalizedConversationId) return false
        // Consume the generation quota before sending.  A rejected/offline
        // request is still a bounded attempt; leaving the marker unset would
        // let the foreground tick retry it every second forever.
        historyRecoveryRequestedGeneration = historySelectionGeneration
        val sent = requestHistoryRecovery(normalizedConversationId)
        if (sent) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.recovery_requested",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                    "generation" to historySelectionGeneration,
                    "reason" to reason
                )
            )
        } else if (isCurrentHistorySelection(normalizedConversationId, historySelectionGeneration)) {
            val key = historySelectionKeyOrNull(normalizedConversationId) ?: return false
            val completeServerSnapshotCache = hasCompleteServerSnapshotCache(
                normalizedConversationId,
                historySelectionGeneration
            )
            _uiState.update { state ->
                state.copy(
                    historyNetworkSyncState = historyNetworkState(
                        key,
                        historyNetworkStateForCompleteServerSnapshotRecovery(
                            completeServerSnapshotCache,
                            CodexHistoryNetworkSyncState.FAILED
                        )
                    )
                )
            }
        }
        return sent
    }

    private fun historyWatchdogTimeoutMillis(): Long = (
        historyCapability?.syncInactivityTimeoutMs ?: 30_000L
    ).coerceIn(10_000L, 120_000L) + HISTORY_WATCHDOG_GRACE_MILLIS

    private fun cancelHistoryWatchdog() {
        historyWatchdogJob?.cancel()
        historyWatchdogJob = null
    }

    private fun clearHistorySyncSettlement() {
        historySyncSettledConversationId = null
        historySyncSettledGeneration = -1L
    }

    private fun markHistorySyncSettled(conversationId: String, generation: Long) {
        historySyncSettledConversationId = conversationId.trim().takeIf { it.isNotEmpty() }
        historySyncSettledGeneration = generation
    }

    private fun cancelHistoryResumeProtection() {
        historyResumeProtectionJob?.cancel()
        historyResumeProtectionJob = null
    }

    /**
     * Keep the explicit history target authoritative while a remote resume is
     * being drained, but never let a missing legacy response turn that
     * protection into a permanent global event filter.  Pinned selection
     * continues to protect against late events that do carry another id.
     */
    private fun armHistoryResumeProtection(
        conversationId: String,
        generation: Long
    ) {
        cancelHistoryResumeProtection()
        historyResumeProtectionJob = viewModelScope.launch {
            delay(historyWatchdogTimeoutMillis())
            if (generation != historySelectionGeneration ||
                _uiState.value.activeConversationId?.trim() != conversationId
            ) {
                return@launch
            }
            if (pendingHistoryResumeHydrationThreadId == conversationId) {
                pendingHistoryResumeHydrationThreadId = null
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.resume_protection_expired",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                        "generation" to generation,
                        "timeoutMs" to historyWatchdogTimeoutMillis()
                    ),
                    level = "warn"
                )
            }
            historyResumeProtectionJob = null
        }
    }

    /**
     * OkHttp can accept a frame while the Gateway process or its IPC owner
     * never produces a response.  The server has an inactivity timer for an
     * already-started sync, but it cannot help when the request itself is
     * lost before the handler starts.  Keep this watchdog inactivity-based so
     * a large valid history transfer is not cut off by an absolute deadline.
     */
    private fun armHistoryWatchdog(
        conversationId: String,
        generation: Long,
        phase: String,
        syncId: String? = null
    ) {
        cancelHistoryWatchdog()
        val timeoutMillis = historyWatchdogTimeoutMillis()
        historyWatchdogJob = viewModelScope.launch {
            delay(timeoutMillis)
            val key = historySelectionKeyOrNull(conversationId, generation) ?: return@launch
            if (!isCurrentHistorySelection(key)) return@launch
            when (phase) {
                "sync" -> {
                    if (historySyncInFlightConversationId != conversationId ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)
                    ) return@launch
                    historySyncInFlightConversationId = null
                    historySyncInFlightSyncId = null
                    markHistorySyncSettled(conversationId, generation)
                    _uiState.update { state ->
                        state.copy(
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                CodexHistoryNetworkSyncState.FAILED,
                                detailCode = "sync_watchdog_timeout"
                            )
                        )
                    }
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.sync_watchdog_timeout",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                            "generation" to generation,
                            "timeoutMs" to timeoutMillis
                        ),
                        level = "warn"
                    )
                    requestHistoryRecoveryOnce(conversationId, "sync-watchdog-timeout")
                }
                "recovery" -> {
                    if (historyRecoveryInFlightConversationId != conversationId ||
                        !acceptsActiveHistorySyncId(historyRecoveryInFlightSyncId, syncId)
                    ) return@launch
                    historyRecoveryInFlightConversationId = null
                    historyRecoveryInFlightSyncId = null
                    val completeServerSnapshotCache = hasCompleteServerSnapshotCache(
                        conversationId,
                        generation
                    )
                    _uiState.update { state ->
                        state.copy(
                            // The cached正文 remains visible, but recovery has
                            // definitively stopped.  Keep a terminal state so
                            // the UI does not look as if it is silently waiting
                            // forever for another server response.
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                historyNetworkStateForCompleteServerSnapshotRecovery(
                                    completeServerSnapshotCache,
                                    CodexHistoryNetworkSyncState.FAILED
                                ),
                                detailCode = "recovery_watchdog_timeout"
                            )
                        )
                    }
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.recovery_watchdog_timeout",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                            "generation" to generation,
                            "timeoutMs" to timeoutMillis
                        ),
                        level = "warn"
                    )
                }
            }
        }
    }

    private fun noteHistoryProtocolActivity(conversationId: String, generation: Long) {
        if (!isCurrentHistorySelection(conversationId, generation)) return
        when {
            historyRecoveryInFlightConversationId == conversationId ->
                armHistoryWatchdog(
                    conversationId,
                    generation,
                    "recovery",
                    historyRecoveryInFlightSyncId
                )
            historySyncInFlightConversationId == conversationId ->
                armHistoryWatchdog(
                    conversationId,
                    generation,
                    "sync",
                    historySyncInFlightSyncId
                )
        }
    }

    private fun sendHistoryManifest(required: CodexHistoryManifestRequired) {
        val profile = currentProfile ?: return
        val key = historySelectionKeyOrNull(
            required.conversationId,
            required.clientSelectionGeneration
        ) ?: return
        if (!isCurrentHistorySelection(key) ||
            !acceptsActiveHistorySyncId(historySyncInFlightSyncId, required.syncId)
        ) return

        // A cold task has no local manifest to read.  Send the empty page on
        // the current handler instead of queueing a database query behind
        // other cache work.  The server treats this as an upsert-only
        // reconciliation (baselineComplete=false), so it is safe and lets a
        // no-cache recovery reach its delta before the bounded watchdog.
        val cacheState = _uiState.value.historyCacheState
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.manifest_dispatch",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId),
                "cacheConversationKey" to PersistentDiagnosticLog.shortHash(cacheState.conversationId.orEmpty()),
                "cacheLoadState" to cacheState.loadState.name,
                "cacheItemCount" to cacheState.itemCount
            )
        )
        if (cacheState.loadState != CodexHistoryCacheLoadState.READY && cacheState.itemCount == 0) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.manifest_empty_fast_path",
                mapOf("conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId))
            )
            val sent = connectionManager.send(
                CodexClientMessages.historyManifestPage(
                    syncId = required.syncId,
                    conversationId = required.conversationId,
                    pageIndex = 0,
                    lastPage = true,
                    items = JSONArray(),
                    selectionGeneration = required.clientSelectionGeneration
                )
            )
            if (!sent) {
                historySyncInFlightConversationId = null
                historySyncInFlightSyncId = null
                markHistorySyncSettled(
                    required.conversationId,
                    required.clientSelectionGeneration
                )
                cancelHistoryWatchdog()
                _uiState.update { state ->
                    if (isCurrentHistorySelection(key)) {
                        state.copy(
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                CodexHistoryNetworkSyncState.OFFLINE,
                                detailCode = "manifest_send_failed"
                            )
                        )
                    } else state
                }
            }
            return
        }

        viewModelScope.launch(Dispatchers.IO) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.manifest_read_started",
                mapOf("conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId))
            )
            val manifest = runCatching {
                historyCacheStore.readConversationManifest(profile.id, required.conversationId)
            }.getOrDefault(emptyList())
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.history.manifest_read_completed",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId),
                    "itemCount" to manifest.size
                )
            )
            val pageSize = required.pageSize.coerceIn(1, 2_000)
            val pages = if (manifest.isEmpty()) {
                listOf(emptyList())
            } else {
                manifest.chunked(pageSize)
            }
            pages.forEachIndexed { index, pageItems ->
                if (!isCurrentHistorySelection(key) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, required.syncId)
                ) return@launch
                val items = JSONArray().apply {
                    pageItems.forEach { entry ->
                        put(JSONObject().apply {
                            put("itemKey", entry.itemKey)
                            put("contentHash", entry.contentHash)
                        })
                    }
                }
                val sent = connectionManager.send(
                    CodexClientMessages.historyManifestPage(
                        syncId = required.syncId,
                        conversationId = required.conversationId,
                        pageIndex = index,
                        lastPage = index == pages.lastIndex,
                        items = items,
                        selectionGeneration = required.clientSelectionGeneration
                    )
                )
                if (!sent) {
                    val applied = withContext(Dispatchers.Main.immediate) {
                        if (!shouldApplyHistoryManifestSendFailure(
                                selectionIsCurrent = isCurrentHistorySelection(key),
                                activeSyncId = historySyncInFlightSyncId,
                                manifestSyncId = required.syncId
                            )
                        ) {
                            false
                        } else {
                            historySyncInFlightConversationId = null
                            historySyncInFlightSyncId = null
                            markHistorySyncSettled(
                                required.conversationId,
                                historySelectionGeneration
                            )
                            cancelHistoryWatchdog()
                            _uiState.update { state ->
                                if (isCurrentHistorySelection(key)) {
                                    state.copy(
                                        historyNetworkSyncState = historyNetworkState(
                                            key,
                                            CodexHistoryNetworkSyncState.OFFLINE,
                                            detailCode = "manifest_send_failed"
                                        )
                                    )
                                } else state
                            }
                            true
                        }
                    }
                    if (applied) {
                        PersistentDiagnosticLog.event(
                            "codex",
                            "android.codex.history.manifest_send_failed",
                            mapOf(
                                "conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId),
                                "generation" to required.clientSelectionGeneration,
                                "pageIndex" to index
                            ),
                            level = "warn"
                        )
                    }
                    return@launch
                }
            }
        }
    }

    private fun handleEnvelope(envelope: CodexWsEnvelope) {
        val json = envelope.raw
        when (envelope.type) {
            "conversation_history_detail_response" -> handleHistoryDetailResponse(json)
            "session_info" -> {
                val info = SessionInfo.from(json)
                var conversationToSubscribe: String? = null
                val previousThreadId = _uiState.value.threadId.orEmpty()
                val previousActiveConvId = _uiState.value.activeConversationId.orEmpty()
                val boundThreadId = normalizeThreadId(info.lastCodexThreadId)
                val condBoundThreadId = boundThreadId != null
                val condThreadIdBlank = _uiState.value.threadId.isNullOrBlank()
                val condActiveConvBlank = _uiState.value.activeConversationId.isNullOrBlank()
                val shouldAdoptBoundThread = condBoundThreadId && condThreadIdBlank && condActiveConvBlank
                val previousCwd = _uiState.value.cwd
                val nextCwd = info.cwd ?: previousCwd
                val cwdChanged = normalizeThreadHistoryCwdForUi(previousCwd) !=
                    normalizeThreadHistoryCwdForUi(nextCwd)
                Log.i(TAG, "[ipc][session-info][decision] boundThreadId=${boundThreadId.orEmpty()} " +
                    "cond:boundThreadId=$condBoundThreadId threadIdBlank=$condThreadIdBlank activeConvBlank=$condActiveConvBlank " +
                    "→ shouldAdopt=$shouldAdoptBoundThread " +
                    "previousThreadId=$previousThreadId previousActiveConv=$previousActiveConvId")
                _uiState.update {
                    if (shouldAdoptBoundThread) {
                        conversationToSubscribe = boundThreadId
                    }
                    syncExecutionWatch(
                        it.copy(
                            sessionId = info.sessionId,
                            sessionName = info.sessionName,
                            cwd = info.cwd ?: it.cwd,
                            threadHistoryEntries = if (cwdChanged) {
                                filterThreadHistoryEntriesForCwd(it.threadHistoryEntries, nextCwd)
                            } else {
                                it.threadHistoryEntries
                            },
                            threadId = if (shouldAdoptBoundThread) boundThreadId else it.threadId,
                            activeConversationId = if (shouldAdoptBoundThread) {
                                boundThreadId
                            } else {
                                it.activeConversationId
                            }
                        ),
                        markActivity = false
                    )
                }
                if (cwdChanged) {
                    refreshThreadHistory()
                }
                conversationToSubscribe?.let { conversationId ->
                    connectionManager.send(
                        CodexClientMessages.setActiveConversation(conversationId, historySelectionGeneration)
                    )
                }
                val didAdopt = shouldAdoptBoundThread
                Log.i(TAG, "[session-info] sessionReady: " +
                    "sessionId=${info.sessionId} " +
                    "sessionName=${info.sessionName} " +
                    "lastCodexThreadId=${info.lastCodexThreadId.orEmpty()} " +
                    "boundThreadId=${boundThreadId.orEmpty()} " +
                    "didAdopt=$didAdopt " +
                    "previousActiveConversationId=$previousActiveConvId " +
                    "activeConversationId=${_uiState.value.activeConversationId.orEmpty()} " +
                    "cwd=${info.cwd.orEmpty()}")
            }

            "codex_capabilities" -> {
                val caps = CodexCapabilities.from(json)
                _uiState.update {
                    syncExecutionWatch(
                        recalculateNextTurnEffectiveConfig(
                            it.copy(
                                capabilities = caps,
                                model = caps.defaultModel.ifBlank { it.model },
                                reasoningEffort = caps.defaultReasoningEffort.ifBlank { it.reasoningEffort }
                            )
                        ),
                        markActivity = false
                    )
                }
                maybeRequestModelList()
                maybeScheduleTerminalReconcile(
                    _uiState.value.ipcSurfaceSnapshot,
                    "capabilities_received"
                )
                // Do not enqueue the optional rate-limit RPC during the
                // initial connection.  Codex app-server serializes some
                // requests; a slow rate-limit read can otherwise hold the
                // gateway's session queue long enough for the bounded
                // history manifest/delta window to expire.  The usage panel
                // requests it on demand, after history has a chance to settle.
                Log.i(TAG, "Capabilities: models=${caps.models}")
            }

            // ── IPC realtime sync messages ──
            "codex_ipc_status" -> {
                val status = CodexIpcStatus.from(json)
                historyCapability = CodexHistoryCapability.from(json.optJSONObject("status"))
                val historyStatus = json.optJSONObject("status")
                    ?.optJSONObject("capabilities")
                    ?.optJSONObject("historySync")
                val hadObservedStatus = ipcStatusObserved
                val wasOnline = _uiState.value.ipcOnline
                ipcStatusObserved = true
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.ipc.status",
                    mapOf(
                        "online" to status.online,
                        "hadObservedStatus" to hadObservedStatus,
                        "wasOnline" to wasOnline,
                        "clientIdPresent" to !status.clientId.isNullOrBlank(),
                        "historyCapabilityVersion" to (historyCapability?.version ?: 0),
                        "historyStatusVersion" to (historyStatus?.optInt("version", 0) ?: 0)
                    ),
                    level = if (status.online) "info" else "warn"
                )
                _uiState.update {
                    syncExecutionWatch(
                        applyIpcStatusToUiState(it, status),
                        markActivity = false
                    )
                }
                if (status.online && (!hadObservedStatus || !wasOnline)) {
                    clearHistorySyncSettlement()
                    // Reconnect starts a fresh bounded sync, but the full
                    // recovery quota remains selection-generation scoped.
                    // This prevents a reconnect from issuing a second full
                    // provider read for the same selection.
                    beginAwaitingFreshIpcSurface()
                    subscribeActiveConversationIfNeeded()
                } else if (!status.online && (!hadObservedStatus || wasOnline)) {
                    awaitingFreshIpcSurface = false
                    matchingIpcSurfaceDesynced = false
                    ipcAuthorityModeEnteredAtElapsed = SystemClock.elapsedRealtime()
                    runForegroundRecoveryTick(SystemClock.elapsedRealtime())
                }
                if (status.online) {
                    // A replayed completed surface can precede the additive
                    // history capability on reconnect. Re-evaluate the same
                    // guarded terminal gate once the capability is known;
                    // it still requires matching healthy surface + metadata.
                    maybeScheduleTerminalReconcile(
                        _uiState.value.ipcSurfaceSnapshot,
                        "ipc_status_capability"
                    )
                    maybeRequestHistorySync(_uiState.value.activeConversationId)
                }
                Log.i(TAG, "[ipc][status] " +
                    "online=${status.online} " +
                    "hadObservedStatus=$hadObservedStatus " +
                    "wasOnline=$wasOnline " +
                    "clientId=${status.clientId.orEmpty()} " +
                    "activeConversationId=${_uiState.value.activeConversationId.orEmpty()}")
            }

            "codex_ipc_conversations" -> {
                val conversations = CodexIpcConversationSummary.listFrom(json)
                var conversationToSubscribe: String? = null
                val previousConversationId = _uiState.value.activeConversationId?.trim().orEmpty()
                val currentThreadId = _uiState.value.threadId?.trim().orEmpty()
                val currentCwd = _uiState.value.cwd
                val requiresExactSelection = shouldRequireExactIpcConversationSelection(
                    pinnedConversationId = pinnedIpcConversationId,
                    activeConversationId = previousConversationId,
                    threadId = currentThreadId
                )
                // Trace selection reasoning
                val matchReason: String
                val selected: CodexIpcConversationSummary? = selectIpcConversationForUi(
                    conversations = conversations,
                    activeConversationId = previousConversationId,
                    threadId = currentThreadId,
                    cwd = currentCwd,
                    awaitingNewThreadIpcSurface = _uiState.value.awaitingNewThreadIpcSurface ||
                        requiresExactSelection
                )
                matchReason = when {
                    selected == null -> "none"
                    selected.conversationId == previousConversationId -> "exact-activeConversationId"
                    selected.conversationId == currentThreadId -> "threadId-match"
                    selected.cwd != null && currentCwd != null &&
                        selected.cwd.trim().replace('\\', '/').trimEnd('/').lowercase() ==
                        currentCwd.trim().replace('\\', '/').trimEnd('/').lowercase() -> "cwd-match"
                    selected.hasActiveGoal -> "hasActiveGoal"
                    else -> "fallback-most-recent"
                }
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.ipc.conversation_selection",
                    mapOf(
                        "conversationCount" to conversations.size,
                        "selected" to (selected != null),
                        "matchReason" to matchReason,
                        "requiresExactSelection" to requiresExactSelection
                    )
                )
                _uiState.update { current ->
                    val preferred = selected
                    if (preferred == null) {
                        if (current.awaitingNewThreadIpcSurface || requiresExactSelection) {
                            conversationToSubscribe = current.activeConversationId?.trim()
                                ?.takeIf { it.isNotEmpty() }
                                ?: current.threadId?.trim()?.takeIf { it.isNotEmpty() }
                            current
                        } else {
                            clearIpcConversationSelectionFromUiState(current)
                        }
                    } else if (
                        preferred.conversationId == current.activeConversationId?.trim().orEmpty() &&
                        !current.awaitingNewThreadIpcSurface
                    ) {
                        applyIpcConversationSelectionWithRememberedConfig(current, preferred)
                    } else {
                        conversationToSubscribe = preferred.conversationId
                        applyIpcConversationSelectionWithRememberedConfig(current, preferred)
                    }
                }
                val newConversationId = _uiState.value.activeConversationId?.trim().orEmpty()
                val targetChanged = newConversationId.isNotEmpty() && previousConversationId != newConversationId
                if (targetChanged) advanceHistorySelectionGeneration("ipc-selection:$newConversationId")
                val switched = previousConversationId.isNotEmpty() && targetChanged
                if (targetChanged) {
                    beginAwaitingFreshIpcSurface()
                    // IPC conversation discovery can select the restored/default task
                    // without going through thread/resume. Hydrate its endpoint-scoped
                    // cache immediately so a bounded live surface never hides the
                    // historical正文/attachments while the network path catches up.
                    hydrateCachedConversation(newConversationId, historySelectionGeneration)
                }
                Log.i(TAG, "[ipc][conversations-received] " +
                    "conversationCount=${conversations.size} " +
                    "availableIds=${conversations.map { it.conversationId }} " +
                    "selectedId=$newConversationId " +
                    "previousId=$previousConversationId " +
                    "matchReason=$matchReason " +
                    "switched=$switched " +
                    "willSubscribe=${conversationToSubscribe != null}")
                if (!switched && previousConversationId.isEmpty() && newConversationId.isEmpty()) {
                    Log.w(TAG, "[ipc][conversations-received][no-selection] no conversation selected: " +
                        "available=${conversations.size} " +
                        "threadId=$currentThreadId " +
                        "cwd=$currentCwd " +
                        "anyHasActiveGoal=${conversations.any { it.hasActiveGoal }}")
                }
                conversationToSubscribe?.let { conversationId ->
                    Log.i(TAG, "[ipc][subscribe] sending set_active_conversation: $conversationId")
                    connectionManager.send(
                        CodexClientMessages.setActiveConversation(conversationId, historySelectionGeneration)
                    )
                }
                if (targetChanged) {
                    // IPC conversation discovery can select a task without a
                    // thread/resume response.  Request its bounded detail
                    // baseline explicitly; otherwise a long-idle owner can
                    // leave the UI with only a "live" surface status and no
                    // historical正文.
                    maybeRequestHistorySync(newConversationId)
                }
            }

            "codex_ipc_sync_event" -> {
                // Android consumes normalized conversation snapshots; raw sync events are diagnostics.
            }

            "conversation_history_manifest_required" -> {
                val required = CodexHistoryManifestRequired.from(json) ?: return
                if (isTerminalReconcileSyncPurpose(required.purpose)) {
                    sendTerminalReconcileManifest(required)
                    return
                }
                if (required.conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(required.clientSelectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, required.syncId)
                ) return
                noteHistoryProtocolActivity(
                    conversationId = required.conversationId,
                    generation = required.clientSelectionGeneration
                )
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.manifest_required",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(required.conversationId),
                        "generation" to required.clientSelectionGeneration,
                        "pageSize" to required.pageSize
                    )
                )
                val key = historySelectionKeyOrNull(
                    required.conversationId,
                    required.clientSelectionGeneration
                )
                if (key != null) {
                    _uiState.update { state ->
                        if (isCurrentHistorySelection(key)) {
                            state.copy(
                                historyNetworkSyncState = historyNetworkState(
                                    key,
                                    CodexHistoryNetworkSyncState.REPAIRING
                                )
                            )
                        } else state
                    }
                }
                sendHistoryManifest(required)
            }

            "conversation_history_recovery_state" -> {
                val conversationId = json.optStringOrNullCompat("conversationId") ?: return
                val syncId = json.optStringOrNullCompat("syncId") ?: return
                val clientGeneration = json.optLong("clientSelectionGeneration", 0L)
                if (conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(clientGeneration) ||
                    !acceptsActiveHistorySyncId(historyRecoveryInFlightSyncId, syncId)
                ) return
                cancelHistoryWatchdog()
                historyRecoveryInFlightConversationId = null
                historyRecoveryInFlightSyncId = null
                val state = json.optString("state", "failed")
                val recoverySelectionMatches = isCurrentHistorySelection(
                    conversationId,
                    historySelectionGeneration
                )
                val completeServerSnapshotCache = hasCompleteServerSnapshotCache(
                    conversationId,
                    historySelectionGeneration
                )
                if (shouldInvalidateCompleteServerSnapshotCacheForRecoveryReady(
                        recoveryState = state,
                        recoveryMatchesCurrentSelection = recoverySelectionMatches,
                        completeServerSnapshotCache = completeServerSnapshotCache
                    )
                ) {
                    completeServerSnapshotCacheSelectionKey = null
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.complete_snapshot_cache_invalidated_for_recovery",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                            "generation" to historySelectionGeneration
                        )
                    )
                }
                if (state.equals("ready", ignoreCase = true)) {
                    // The recovery provider produced a new canonical baseline;
                    // quarantine any older sync and allow exactly one fresh
                    // manifest sync for this selection.
                    if (historySyncInFlightConversationId == conversationId) {
                        historySyncInFlightConversationId = null
                        historySyncInFlightSyncId = null
                        cancelHistoryWatchdog()
                    }
                    clearHistorySyncSettlement()
                    val key = historySelectionKeyOrNull(conversationId, historySelectionGeneration)
                    if (key != null) {
                        _uiState.update { current ->
                            if (isCurrentHistorySelection(key)) {
                                current.copy(
                                    historyNetworkSyncState = historyNetworkState(
                                        key,
                                        CodexHistoryNetworkSyncState.SYNCING
                                    )
                                )
                            } else current
                        }
                    }
                    maybeRequestHistorySync(conversationId)
                } else {
                    val key = historySelectionKeyOrNull(conversationId, historySelectionGeneration)
                    if (key != null) {
                        _uiState.update { current ->
                            if (isCurrentHistorySelection(key)) {
                                current.copy(
                                    historyNetworkSyncState = historyNetworkState(
                                        key,
                                        historyNetworkStateForCompleteServerSnapshotRecovery(
                                            completeServerSnapshotCache,
                                            CodexHistoryNetworkSyncState.FAILED
                                        )
                                    )
                                )
                            } else current
                        }
                    }
                }
            }

            "conversation_live_replay_state" -> {
                handleLiveReplayState(CodexLiveReplayStateMessage.from(json))
            }

            "conversation_history_sync_state" -> {
                val syncState = CodexHistorySyncStateMessage.from(json)
                if (isCanonicalTailValidationSyncPurpose(syncState.purpose)) {
                    // This is deliberately not a normal history-sync terminal:
                    // do not touch history in-flight/settled fields, recovery,
                    // UI state, cache rows, or SQLite.  It is only the private
                    // Step 3 freshness observation for this selection.
                    handleCanonicalTailValidationState(syncState)
                    return
                }
                if (isTerminalReconcileSyncPurpose(syncState.purpose)) {
                    // P0-C settles only its private durable context. It must
                    // not affect active UI selection, recovery, or history
                    // network state (which may now belong to B).
                    handleTerminalReconcileState(syncState)
                    return
                }
                if (syncState.conversationId == _uiState.value.activeConversationId &&
                    acceptsHistoryClientSelection(syncState.clientSelectionGeneration) &&
                    acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncState.syncId)
                ) {
                    noteHistoryProtocolActivity(
                        conversationId = syncState.conversationId,
                        generation = syncState.clientSelectionGeneration
                    )
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.sync_state",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(syncState.conversationId),
                            "syncId" to PersistentDiagnosticLog.shortHash(syncState.syncId),
                            "generation" to syncState.clientSelectionGeneration,
                            "state" to syncState.state,
                            "detailCode" to syncState.detailCode
                        ),
                        level = if (syncState.state == "failed") "warn" else "info"
                    )
                    val terminalSyncState = isTerminalHistorySyncState(syncState.state)
                    val rangeSyncForPump = terminalSyncState &&
                        rangeHistorySyncIds.remove(syncState.syncId)
                    val olderSyncForPump = terminalSyncState &&
                        olderHistorySyncIds.remove(syncState.syncId)
                    if (olderSyncForPump) {
                        automaticOlderHistoryPump.markRequestFinished(
                            conversationId = syncState.conversationId,
                            generation = syncState.clientSelectionGeneration
                        )
                    }
                    val historyRecoveryEscalation = shouldKeepHistoryResumeProtectionForSyncState(
                        state = syncState.state,
                        detailCode = syncState.detailCode
                    )
                    val activationRetryScheduled = terminalSyncState &&
                        syncState.state.equals("failed", ignoreCase = true) &&
                        syncState.detailCode.equals("conversation_not_active", ignoreCase = true) &&
                        historyActivationRetryGeneration != syncState.clientSelectionGeneration &&
                        isCurrentHistorySelection(
                            syncState.conversationId,
                            syncState.clientSelectionGeneration
                        )
                    if (terminalSyncState) {
                        historySyncInFlightConversationId = null
                        historySyncInFlightSyncId = null
                        markHistorySyncSettled(
                            conversationId = syncState.conversationId,
                            generation = historySelectionGeneration
                        )
                        cancelHistoryWatchdog()
                        // Keep the explicit selection quarantine until the
                        // optional metadata-only thread/resume responds or
                        // its bounded protection timer expires.  The history
                        // lane can finish before that RPC (or report the
                        // hand-off `history_unavailable` first); clearing it
                        // here would let a late, irrelevant resume failure be
                        // rendered as a user-facing "reply failed" card.
                        // A→B selection still clears it in
                        // advanceHistorySelectionGeneration(), and a matching
                        // resume response/error clears it at its own boundary.
                        if (pendingHistoryResumeHydrationThreadId == syncState.conversationId) {
                            if (historyRecoveryEscalation) {
                                PersistentDiagnosticLog.event(
                                    "codex",
                                    "android.codex.history.resume_protection_kept",
                                    mapOf(
                                        "conversationKey" to PersistentDiagnosticLog.shortHash(
                                            syncState.conversationId
                                        ),
                                        "generation" to syncState.clientSelectionGeneration,
                                        "reason" to (syncState.detailCode ?: "history_recovery")
                                    )
                                )
                            }
                        }
                    }
                    if (activationRetryScheduled) {
                        // A reconnect can deliver the first history request
                        // before the Gateway has installed set_active.  Do
                        // not spend the generation's full-recovery quota on
                        // that transient ordering failure; re-send the
                        // follower subscription and retry the ordinary sync
                        // exactly once after the settle window.
                        historyActivationRetryGeneration = syncState.clientSelectionGeneration
                        val retryKey = historySelectionKeyOrNull(
                            syncState.conversationId,
                            syncState.clientSelectionGeneration
                        )
                        if (productHistoryProbeSelectionKey == retryKey) {
                            productHistoryProbeSelectionKey = null
                        }
                        clearHistorySyncSettlement()
                        subscribeActiveConversationIfNeeded()
                        PersistentDiagnosticLog.event(
                            "codex",
                            "android.codex.history.sync_activation_retry",
                            mapOf(
                                "conversationKey" to PersistentDiagnosticLog.shortHash(
                                    syncState.conversationId
                                ),
                                "generation" to syncState.clientSelectionGeneration
                            ),
                            level = "warn"
                        )
                    }
                    val historyKey = historySelectionKeyOrNull(
                        syncState.conversationId,
                        historySelectionGeneration
                    )
                    if (historyKey != null) {
                        _uiState.update { current ->
                            if (isCurrentHistorySelection(historyKey)) {
                                current.copy(
                                    historyNetworkSyncState = historyNetworkState(
                                        historyKey,
                                        mapHistoryNetworkSyncStateForUi(syncState.state),
                                        detailCode = syncState.detailCode
                                    )
                                )
                            } else current
                        }
                    }
                    if (terminalSyncState &&
                        (rangeSyncForPump || olderSyncForPump) &&
                        !activationRetryScheduled
                    ) {
                        scheduleAutomaticOlderHistoryPage(
                            conversationId = syncState.conversationId,
                            generation = syncState.clientSelectionGeneration,
                            syncState = syncState.state,
                            rangeSync = rangeSyncForPump || olderSyncForPump
                        )
                    }
                    if (historyRecoveryEscalation && !activationRetryScheduled) {
                        requestHistoryRecoveryOnce(syncState.conversationId, syncState.detailCode ?: "sync-failed")
                    }
                }
            }

            "conversation_history_snapshot_state" -> {
                val conversationId = json.optStringOrNullCompat("conversationId") ?: return
                val syncId = json.optStringOrNullCompat("syncId") ?: return
                val selectionGeneration = json.optLong(
                    "clientSelectionGeneration",
                    json.optLong("selectionGeneration", 0L)
                )
                if (conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, syncId)
                ) return
                noteHistoryProtocolActivity(conversationId, selectionGeneration)
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.snapshot_state",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                        "generation" to selectionGeneration,
                        "state" to json.optString("state", "unknown")
                    )
                )
            }

            "conversation_history_segment_start" -> {
                val page = CodexHistoryDeltaWire.from(json)?.page ?: return
                val endpointId = currentProfile?.id
                val range = page.range
                if (endpointId == null || page.conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(page.selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, page.syncId) ||
                    range?.providerMode != "server_snapshot" || range?.segmentId.isNullOrBlank() ||
                    page.pageCount != 1 || page.pageIndex != 0 || page.baselineComplete ||
                    page.fullOrderIncluded || page.deletes.isNotEmpty() ||
                    CodexHistoryPageHasher.pageHash(page) != page.pageHash
                ) {
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.snapshot_segment_rejected",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(page.conversationId),
                            "sequence" to page.sequence
                        ),
                        level = "warn"
                    )
                    return
                }
                noteHistoryProtocolActivity(page.conversationId, page.selectionGeneration)
                pendingHistorySnapshotSegments[historySnapshotSegmentKey(page.syncId, page.sequence)] =
                    PendingHistorySnapshotSegment(page)
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.snapshot_segment_started",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(page.conversationId),
                        "generation" to page.selectionGeneration,
                        "sequence" to page.sequence,
                        "segmentKey" to range.segmentId.take(16),
                        "upsertCount" to page.upserts.size,
                        "chunkedCount" to page.upserts.count { it.payloadChunkCount > 0 }
                    )
                )
            }

            "conversation_history_segment_fragment" -> {
                val chunk = CodexHistoryPayloadChunkWire.from(json)?.chunk ?: return
                if (chunk.conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(chunk.selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                ) return
                val pendingKey = historySnapshotSegmentKey(chunk.syncId, chunk.sequence)
                val pending = pendingHistorySnapshotSegments[pendingKey] ?: return
                val page = pending.page
                val expected = page.upserts.firstOrNull { it.itemKey == chunk.itemKey }
                val fragmentBytes = chunk.data.toByteArray(Charsets.UTF_8).size
                val valid = expected != null && expected.payloadChunkCount > 0 &&
                    chunk.pageIndex == page.pageIndex && chunk.targetRoot == page.targetRoot &&
                    chunk.chunkIndex in 0 until expected.payloadChunkCount &&
                    chunk.chunkCount == expected.payloadChunkCount &&
                    chunk.payloadHash == expected.payloadHash &&
                    chunk.payloadBytes == expected.payloadBytes &&
                    fragmentBytes <= HISTORY_SNAPSHOT_FRAGMENT_MAX_BYTES
                if (!valid) {
                    pendingHistorySnapshotSegments.remove(pendingKey)
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.snapshot_fragment_rejected",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(chunk.conversationId),
                            "sequence" to chunk.sequence,
                            "fragmentBytes" to fragmentBytes
                        ),
                        level = "warn"
                    )
                    return
                }
                val chunks = pending.fragments.getOrPut(chunk.itemKey) { mutableMapOf() }
                val existing = chunks[chunk.chunkIndex]
                if (existing != null && existing != chunk) {
                    pendingHistorySnapshotSegments.remove(pendingKey)
                    return
                }
                chunks[chunk.chunkIndex] = chunk
                noteHistoryProtocolActivity(chunk.conversationId, chunk.selectionGeneration)
            }

            "conversation_history_segment_commit" -> {
                val commit = CodexHistorySegmentCommit.from(json) ?: return
                if (commit.conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(commit.selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                ) return
                val pendingKey = historySnapshotSegmentKey(commit.syncId, commit.sequence)
                val pending = pendingHistorySnapshotSegments[pendingKey] ?: return
                val page = pending.page
                val range = page.range ?: run {
                    pendingHistorySnapshotSegments.remove(pendingKey)
                    return
                }
                if (commit.pageIndex != page.pageIndex || commit.segmentId != range.segmentId ||
                    commit.pageHash != page.pageHash || commit.targetRoot != page.targetRoot
                ) {
                    pendingHistorySnapshotSegments.remove(pendingKey)
                    return
                }
                pendingHistorySnapshotSegments.remove(pendingKey)
                noteHistoryProtocolActivity(commit.conversationId, commit.selectionGeneration)
                val endpointId = currentProfile?.id ?: return
                viewModelScope.launch(Dispatchers.IO) {
                    if (!isCurrentHistorySelection(commit.conversationId, commit.selectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                    ) return@launch
                    val result = runCatching {
                        val hydratedItems = page.upserts.map { item ->
                            if (item.payloadChunkCount <= 0) {
                                item
                            } else {
                                val fragments = pending.fragments[item.itemKey]
                                    ?: throw IllegalStateException("snapshot payload fragments missing")
                                if (fragments.size != item.payloadChunkCount ||
                                    (0 until item.payloadChunkCount).any { it !in fragments }
                                ) throw IllegalStateException("snapshot payload fragments incomplete")
                                val payload = buildString {
                                    for (index in 0 until item.payloadChunkCount) append(fragments.getValue(index).data)
                                }
                                if (payload.toByteArray(Charsets.UTF_8).size != item.payloadBytes ||
                                    historySnapshotPayloadHash(payload) != item.payloadHash
                                ) throw IllegalStateException("snapshot payload hash mismatch")
                                item.copy(
                                    payloadJson = payload,
                                    payloadHash = null,
                                    payloadBytes = null,
                                    payloadChunkCount = 0
                                )
                            }
                        }
                        val localPageWithoutHash = page.copy(upserts = hydratedItems, pageHash = "")
                        val localPage = localPageWithoutHash.copy(
                            pageHash = CodexHistoryPageHasher.pageHash(localPageWithoutHash)
                        )
                        historyApplyMutex.withLock {
                            if (!isCurrentHistorySelection(commit.conversationId, commit.selectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                            ) {
                                CodexConversationCacheStore.PageApplyResult.REJECTED
                            } else {
                                historyCacheStore.applyDeltaPage(endpointId, localPage)
                            }
                        }
                    }.getOrDefault(CodexConversationCacheStore.PageApplyResult.REJECTED)
                    if (result != CodexConversationCacheStore.PageApplyResult.COMMITTED &&
                        result != CodexConversationCacheStore.PageApplyResult.IDEMPOTENT
                    ) {
                        if (result != CodexConversationCacheStore.PageApplyResult.STALE) {
                            val historyKey = historySelectionKeyOrNull(
                                commit.conversationId,
                                commit.selectionGeneration
                            )
                            _uiState.update { state ->
                                if (historyKey != null && isCurrentHistorySelection(historyKey) &&
                                    acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                                ) state.copy(
                                    historyNetworkSyncState = historyNetworkState(
                                        historyKey,
                                        CodexHistoryNetworkSyncState.FAILED,
                                        detailCode = "snapshot_segment_apply_failed"
                                    )
                                ) else state
                            }
                        }
                        return@launch
                    }
                    val cachedResult = runCatching {
                        historyCacheStore.readConversation(endpointId, commit.conversationId)
                    }
                    if (!isCurrentHistorySelection(commit.conversationId, commit.selectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                    ) return@launch
                    val historyKey = historySelectionKeyOrNull(
                        commit.conversationId,
                        commit.selectionGeneration
                    ) ?: return@launch
                    val snapshot = decodeHistoryCacheSnapshot(
                        key = historyKey,
                        cached = cachedResult.getOrNull(),
                        readError = cachedResult.exceptionOrNull()
                    )
                    val snapshotSegmentsEnabled = historyCapability?.serverSnapshotSegments?.let {
                        it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
                    } == true
                    if (isCurrentHistorySelection(historyKey) &&
                        acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId) &&
                        shouldPromoteCompleteServerSnapshotCache(
                            serverSnapshotSegmentsEnabled = snapshotSegmentsEnabled,
                            providerMode = range.providerMode,
                            cacheCoverageComplete = snapshot.durableCoverageComplete
                        )
                    ) {
                        completeServerSnapshotCacheSelectionKey = historyKey
                        PersistentDiagnosticLog.event(
                            "codex",
                            "android.codex.history.snapshot_cache_completed_on_segment_commit",
                            mapOf(
                                "conversationKey" to PersistentDiagnosticLog.shortHash(commit.conversationId),
                                "generation" to commit.selectionGeneration,
                                "sequence" to commit.sequence,
                                "itemCount" to snapshot.uiState.itemCount
                            )
                        )
                    }
                    _uiState.update { state ->
                        if (!isCurrentHistorySelection(historyKey) ||
                            !acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId) ||
                            !shouldApplyHistoryDeltaToUiState(state, commit.conversationId)
                        ) state else state.copy(
                            cachedCanonicalMessages = snapshot.messages,
                            messages = mergeCachedHistoryIntoLiveMessagesForUi(
                                state = state,
                                conversationId = commit.conversationId,
                                cachedMessages = snapshot.messages
                            ),
                            historyCacheState = snapshot.uiState,
                            historyNetworkSyncState = historyNetworkState(
                                historyKey,
                                historySyncProgressState(state.historyNetworkSyncState.state),
                                detailCode = "snapshot_segment_progress",
                                pageIndex = commit.sequence
                            )
                        )
                    }
                    if (isCurrentHistorySelection(commit.conversationId, commit.selectionGeneration) &&
                        acceptsActiveHistorySyncId(historySyncInFlightSyncId, commit.syncId)
                    ) {
                        withContext(Dispatchers.Main.immediate) {
                            maybeRequestCanonicalTailValidation(
                                commit.conversationId,
                                "static_cache_segment_commit"
                            )
                        }
                        scheduleMediaPrefetch(snapshot.messages, commit.selectionGeneration)
                        connectionManager.send(
                            CodexClientMessages.historySegmentAck(
                                syncId = commit.syncId,
                                conversationId = commit.conversationId,
                                targetRoot = commit.targetRoot,
                                sequence = commit.sequence,
                                pageIndex = commit.pageIndex,
                                segmentId = commit.segmentId,
                                pageHash = commit.pageHash,
                                selectionGeneration = commit.selectionGeneration
                            )
                        )
                    }
                }
            }

            "conversation_history_delta" -> {
                val deltaWire = CodexHistoryDeltaWire.from(json) ?: run {
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.delta_parse_failed",
                        mapOf("conversationKey" to PersistentDiagnosticLog.shortHash(json.optString("conversationId", ""))),
                        level = "warn"
                    )
                    return
                }
                if (isTerminalReconcileSyncPurpose(deltaWire.purpose)) {
                    handleTerminalReconcileDelta(deltaWire)
                    return
                }
                val delta = deltaWire.page
                val activeConversationId = _uiState.value.activeConversationId
                val endpointId = currentProfile?.id
                if (endpointId == null || delta.conversationId != activeConversationId ||
                    !acceptsHistoryClientSelection(delta.selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                ) return
                noteHistoryProtocolActivity(
                    conversationId = delta.conversationId,
                    generation = delta.selectionGeneration
                )
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.history.delta_received",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(delta.conversationId),
                        "generation" to delta.selectionGeneration,
                        "pageIndex" to delta.pageIndex,
                        "pageCount" to delta.pageCount,
                        "upsertCount" to delta.upserts.size,
                        "deleteCount" to delta.deletes.size,
                        "chunkedCount" to delta.upserts.count { it.payloadChunkCount > 0 },
                        "pageHashMatches" to (CodexHistoryPageHasher.pageHash(delta) == delta.pageHash)
                    )
                )
                val deltaSelectionGeneration = delta.selectionGeneration
                pendingHistoryPages[historyPageKey(delta.syncId, delta.pageIndex)] = delta
                viewModelScope.launch(Dispatchers.IO) {
                    if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                    ) return@launch
                    val result = runCatching {
                        historyApplyMutex.withLock {
                            if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                            ) {
                                CodexConversationCacheStore.PageApplyResult.REJECTED
                            } else {
                                historyCacheStore.applyDeltaPage(endpointId, delta)
                            }
                        }
                    }
                        .getOrDefault(CodexConversationCacheStore.PageApplyResult.REJECTED)
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.delta_applied",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(delta.conversationId),
                            "generation" to deltaSelectionGeneration,
                            "pageIndex" to delta.pageIndex,
                            "result" to result.name
                        ),
                        level = if (result == CodexConversationCacheStore.PageApplyResult.REJECTED || result == CodexConversationCacheStore.PageApplyResult.REJECTED_CONFLICT) "warn" else "info"
                    )
                    fun ackPage() {
                        if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                            !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                        ) return
                        connectionManager.send(
                            CodexClientMessages.historySyncAck(
                                delta.syncId,
                                delta.conversationId,
                                delta.targetRoot,
                                delta.sequence,
                                delta.pageIndex,
                                deltaSelectionGeneration
                            )
                        )
                    }
                    when (result) {
                        CodexConversationCacheStore.PageApplyResult.COMMITTED -> {
                            if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                            ) return@launch
                            val cachedResult = runCatching {
                                historyCacheStore.readConversation(endpointId, delta.conversationId)
                            }
                            if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                            ) return@launch
                            val historyKey = historySelectionKeyOrNull(
                                delta.conversationId,
                                deltaSelectionGeneration
                            ) ?: return@launch
                            val snapshot = decodeHistoryCacheSnapshot(
                                key = historyKey,
                                cached = cachedResult.getOrNull(),
                                readError = cachedResult.exceptionOrNull()
                            )
                            if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                            ) return@launch
                            if (snapshot.providerMode == "product_db") {
                                completeServerSnapshotCacheSelectionKey = null
                            }
                            _uiState.update { state ->
                                if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId) ||
                                    !shouldApplyHistoryDeltaToUiState(state, delta.conversationId)
                                ) {
                                    state
                                } else {
                                    state.copy(
                                        cachedCanonicalMessages = snapshot.messages,
                                        messages = mergeCachedHistoryIntoLiveMessagesForUi(
                                            state = state,
                                            conversationId = delta.conversationId,
                                            cachedMessages = snapshot.messages
                                        ),
                                        historyCacheState = snapshot.uiState,
                                        historyNetworkSyncState = historyNetworkState(
                                            historyKey,
                                            historySyncProgressState(
                                                state.historyNetworkSyncState.state
                                            ),
                                            pageIndex = delta.pageIndex,
                                            pageCount = delta.pageCount
                                        )
                                    )
                                }
                            }
                            // A cold-start history page can be the first source
                            // of media descriptors; prefetch the latest visible
                            // tail as soon as that page is committed.
                            if (isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) &&
                                acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                            ) {
                                scheduleMediaPrefetch(snapshot.messages, deltaSelectionGeneration)
                            }
                            ackPage()
                        }
                        CodexConversationCacheStore.PageApplyResult.READY -> ackPage()
                        CodexConversationCacheStore.PageApplyResult.STALE -> Unit
                        CodexConversationCacheStore.PageApplyResult.IDEMPOTENT -> {
                            if (delta.pageIndex == delta.pageCount - 1) {
                                if (!isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) ||
                                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                                ) return@launch
                                val cachedResult = runCatching {
                                    historyCacheStore.readConversation(endpointId, delta.conversationId)
                                }
                                val historyKey = historySelectionKeyOrNull(
                                    delta.conversationId,
                                    deltaSelectionGeneration
                                ) ?: return@launch
                                val snapshot = decodeHistoryCacheSnapshot(
                                    key = historyKey,
                                    cached = cachedResult.getOrNull(),
                                    readError = cachedResult.exceptionOrNull()
                                )
                                _uiState.update { state ->
                                    if (isCurrentHistorySelection(historyKey) &&
                                        acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId) &&
                                        shouldApplyHistoryDeltaToUiState(state, delta.conversationId)
                                    ) {
                                        state.copy(
                                            cachedCanonicalMessages = snapshot.messages,
                                            messages = mergeCachedHistoryIntoLiveMessagesForUi(
                                                state = state,
                                                conversationId = delta.conversationId,
                                                cachedMessages = snapshot.messages
                                            ),
                                            historyCacheState = snapshot.uiState,
                                            historyNetworkSyncState = historyNetworkState(
                                                historyKey,
                                                historySyncProgressState(
                                                    state.historyNetworkSyncState.state
                                                ),
                                                pageIndex = delta.pageIndex,
                                                pageCount = delta.pageCount
                                            )
                                        )
                                    } else state
                                }
                                if (isCurrentHistorySelection(delta.conversationId, deltaSelectionGeneration) &&
                                    acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId)
                                ) {
                                    scheduleMediaPrefetch(snapshot.messages, deltaSelectionGeneration)
                                }
                            }
                            ackPage()
                        }
                        CodexConversationCacheStore.PageApplyResult.STAGED -> Unit
                        else -> _uiState.update { state ->
                            val historyKey = historySelectionKeyOrNull(
                                delta.conversationId,
                                deltaSelectionGeneration
                            )
                            if (historyKey != null &&
                                isCurrentHistorySelection(historyKey) &&
                                acceptsActiveHistorySyncId(historySyncInFlightSyncId, delta.syncId) &&
                                shouldApplyHistoryDeltaToUiState(state, delta.conversationId)
                            ) {
                                state.copy(
                                    historyNetworkSyncState = historyNetworkState(
                                        historyKey,
                                        CodexHistoryNetworkSyncState.FAILED,
                                        detailCode = "delta_apply_failed"
                                    )
                                )
                            } else {
                                state
                            }
                        }
                    }
                }
            }

            "conversation_history_payload_chunk" -> {
                val chunkWire = CodexHistoryPayloadChunkWire.from(json) ?: return
                if (isTerminalReconcileSyncPurpose(chunkWire.purpose)) {
                    handleTerminalReconcilePayloadChunk(chunkWire)
                    return
                }
                val chunk = chunkWire.chunk
                val endpointId = currentProfile?.id
                if (endpointId == null || chunk.conversationId != _uiState.value.activeConversationId ||
                    !acceptsHistoryClientSelection(chunk.selectionGeneration) ||
                    !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                ) return
                val endpoint = endpointId
                noteHistoryProtocolActivity(
                    conversationId = chunk.conversationId,
                    generation = chunk.selectionGeneration
                )
                val chunkSelectionGeneration = chunk.selectionGeneration
                val page = pendingHistoryPages[historyPageKey(chunk.syncId, chunk.pageIndex)]
                    ?: CodexHistoryDeltaPage(
                        syncId = chunk.syncId,
                        conversationId = chunk.conversationId,
                        sequence = chunk.sequence,
                        pageIndex = chunk.pageIndex,
                        pageCount = chunk.pageIndex + 1,
                        pageHash = "",
                        baseRoot = null,
                        targetRoot = chunk.targetRoot,
                        baselineComplete = chunk.baselineComplete,
                        fullOrderIncluded = false
                    )
                viewModelScope.launch(Dispatchers.IO) {
                    if (!isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                    ) return@launch
                    val result = runCatching {
                        historyApplyMutex.withLock {
                            if (!isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) ||
                                !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                            ) {
                                CodexConversationCacheStore.PageApplyResult.REJECTED
                            } else {
                                historyCacheStore.applyPayloadChunk(endpoint, chunk)
                            }
                        }
                    }
                        .getOrDefault(CodexConversationCacheStore.PageApplyResult.REJECTED)
                    if (result == CodexConversationCacheStore.PageApplyResult.READY) {
                        if (isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) &&
                            acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                        ) {
                            connectionManager.send(
                                CodexClientMessages.historySyncAck(
                                    chunk.syncId,
                                    chunk.conversationId,
                                    page.targetRoot.ifBlank { chunk.targetRoot },
                                    chunk.sequence,
                                    chunk.pageIndex,
                                    chunkSelectionGeneration
                                )
                            )
                        }
                        return@launch
                    }
                    if (result == CodexConversationCacheStore.PageApplyResult.STALE) return@launch
                    if (result != CodexConversationCacheStore.PageApplyResult.COMMITTED &&
                        result != CodexConversationCacheStore.PageApplyResult.IDEMPOTENT
                    ) {
                        if (result != CodexConversationCacheStore.PageApplyResult.STAGED) {
                            val historyKey = historySelectionKeyOrNull(
                                chunk.conversationId,
                                chunkSelectionGeneration
                            )
                            _uiState.update { state ->
                                if (historyKey != null &&
                                    isCurrentHistorySelection(historyKey) &&
                                    acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId) &&
                                    shouldApplyHistoryDeltaToUiState(state, chunk.conversationId)
                                ) {
                                    state.copy(
                                        historyNetworkSyncState = historyNetworkState(
                                            historyKey,
                                            CodexHistoryNetworkSyncState.FAILED,
                                            detailCode = "payload_apply_failed"
                                        )
                                    )
                                } else state
                            }
                        }
                        return@launch
                    }
                    val cachedResult = runCatching {
                        historyCacheStore.readConversation(endpoint, chunk.conversationId)
                    }
                    if (!isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                    ) return@launch
                    val historyKey = historySelectionKeyOrNull(
                        chunk.conversationId,
                        chunkSelectionGeneration
                    ) ?: return@launch
                    val snapshot = decodeHistoryCacheSnapshot(
                        key = historyKey,
                        cached = cachedResult.getOrNull(),
                        readError = cachedResult.exceptionOrNull()
                    )
                    if (!isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) ||
                        !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                    ) return@launch
                    _uiState.update { state ->
                        if (!isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) ||
                            !acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId) ||
                            !shouldApplyHistoryDeltaToUiState(state, chunk.conversationId)
                        ) state else state.copy(
                            cachedCanonicalMessages = snapshot.messages,
                            messages = mergeCachedHistoryIntoLiveMessagesForUi(
                                state = state,
                                conversationId = chunk.conversationId,
                                cachedMessages = snapshot.messages
                            ),
                            historyCacheState = snapshot.uiState,
                            historyNetworkSyncState = historyNetworkState(
                                historyKey,
                                historySyncProgressState(
                                    state.historyNetworkSyncState.state
                                ),
                                pageIndex = page.pageIndex,
                                pageCount = page.pageCount
                            )
                        )
                    }
                    if (isCurrentHistorySelection(chunk.conversationId, chunkSelectionGeneration) &&
                        acceptsActiveHistorySyncId(historySyncInFlightSyncId, chunk.syncId)
                    ) {
                        scheduleMediaPrefetch(snapshot.messages, chunkSelectionGeneration)
                        connectionManager.send(
                            CodexClientMessages.historySyncAck(
                                chunk.syncId,
                                chunk.conversationId,
                                page.targetRoot.ifBlank { chunk.targetRoot },
                                chunk.sequence,
                                chunk.pageIndex,
                                chunkSelectionGeneration
                            )
                        )
                        pendingHistoryPages.remove(historyPageKey(chunk.syncId, chunk.pageIndex))
                    }
                }
            }

            "output" -> {
                // Legacy terminal output envelope; the native Codex page consumes normalized Codex/IPC state.
            }

            "follower_mode_changed" -> {
                val mode = CodexFollowerMode.from(json)
                _uiState.update {
                    it.copy(
                        followerModeEnabled = mode.enabled,
                        followerActiveSendAllowed = mode.activeSendAllowed
                    )
                }
                if (shouldRequestActiveFollowerModeEnable(mode)) {
                    connectionManager.send(CodexClientMessages.setActiveFollowerMode(true))
                }
            }

            "conversation_surface_snapshot" -> {
                val snap = DesktopSurfaceSnapshot.from(json)
                val convId = snap.conversationId
                val activeConv = _uiState.value.activeConversationId
                val applied = convId != null && activeConv != null && convId == activeConv
                if (applied) {
                    val current = _uiState.value
                    val previousStatus = current.ipcSurfaceSnapshot?.status
                    val currentSelectionMatches = convId?.let {
                        isCurrentHistorySelection(it, historySelectionGeneration)
                    } == true
                    val terminal = snap.status.trim().lowercase() in setOf(
                        "completed", "failed", "interrupted", "cancelled", "canceled"
                    )
                    if (snap.desynced || terminal || previousStatus?.equals(snap.status, ignoreCase = true) != true) {
                        PersistentDiagnosticLog.event(
                            "codex",
                            "android.codex.ipc.surface.received",
                            mapOf(
                                "conversationKey" to PersistentDiagnosticLog.shortHash(convId),
                                "activeConversationKey" to PersistentDiagnosticLog.shortHash(activeConv),
                                "applied" to true,
                                "status" to snap.status,
                                "previousStatus" to previousStatus,
                                "desynced" to snap.desynced,
                                "revision" to snap.revision,
                                "sourceEpoch" to snap.sourceEpoch,
                                "latestTurnIdPresent" to !snap.latestTurnId.isNullOrBlank(),
                                "ownerKind" to snap.ownerKind
                            ),
                            level = if (snap.desynced) "warn" else "info"
                        )
                    }
                    noteMatchingIpcSurface(snap)
                    convId?.let { surfaceConversationId ->
                        if (shouldCancelHistoryRecoveryForHealthySurface(
                                surfaceDesynced = snap.desynced,
                                currentSelectionMatches = currentSelectionMatches,
                                surfaceConversationId = surfaceConversationId,
                                activeConversationId = activeConv,
                                recoveryConversationId = historyRecoveryInFlightConversationId
                            )
                        ) {
                            stopHistoryRecoveryForHealthySurface(
                                conversationId = surfaceConversationId,
                                generation = historySelectionGeneration
                            )
                        }
                    }
                    snap.activeGoal?.objective?.trim()?.takeIf { it.isNotEmpty() }?.let { objective ->
                        rememberGoalHistory(convId, objective)
                    }
                    _uiState.update { state ->
                        val updated = syncExecutionWatch(
                            applyDesktopSurfaceSnapshotToUiState(state, snap),
                            markActivity = true
                        )
                        updated.copy(
                            threadHistoryEntries = mergeGoalHistoryEntries(updated.threadHistoryEntries)
                        )
                    }
                    invalidateSupersededTerminalReconcile(snap)
                    if (!snap.desynced && currentSelectionMatches) {
                        // A matching healthy surface is the only IPC state
                        // allowed to unlock the Step 3 read-only probe.  The
                        // probe itself remains private and cannot modify this
                        // surface, messages, or history-network state.
                        maybeRequestCanonicalTailValidation(
                            convId,
                            "healthy_surface"
                        )
                        maybeScheduleTerminalReconcile(
                            snap,
                            "healthy_completed_surface"
                        )
                    }
                    val surfaceRequestsHistorySync = shouldRequestHistorySyncAfterSurface(
                        previousStatus,
                        snap.status,
                        snap.desynced
                    )
                    val snapshotSegmentsEnabled = historyCapability?.serverSnapshotSegments?.let {
                        it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
                    } == true
                    val deferSurfaceHistoryRefresh = shouldDeferHistoryRefreshForInFlightServerSnapshot(
                        surfaceRequestsSync = surfaceRequestsHistorySync,
                        serverSnapshotSegmentsEnabled = snapshotSegmentsEnabled,
                        surfaceConversationId = convId,
                        activeConversationId = activeConv,
                        inFlightConversationId = historySyncInFlightConversationId,
                        inFlightSyncId = historySyncInFlightSyncId,
                        currentSelectionMatches = currentSelectionMatches
                    )
                    val suppressCompletedSnapshotHistoryRefresh =
                        shouldSuppressHistoryRefreshForCompleteServerSnapshot(
                            surfaceRequestsSync = surfaceRequestsHistorySync,
                            serverSnapshotSegmentsEnabled = snapshotSegmentsEnabled,
                            currentSelectionMatches = currentSelectionMatches,
                            completeServerSnapshotCache = convId?.let {
                                hasCompleteServerSnapshotCache(it, historySelectionGeneration)
                            } == true
                        )
                    if (surfaceRequestsHistorySync &&
                        (deferSurfaceHistoryRefresh || suppressCompletedSnapshotHistoryRefresh)
                    ) {
                        val refreshReason = if (deferSurfaceHistoryRefresh) {
                            "server_snapshot_in_flight"
                        } else {
                            "complete_server_snapshot_cache"
                        }
                        PersistentDiagnosticLog.event(
                            "codex",
                            "android.codex.history.surface_refresh_deferred",
                            mapOf(
                                "conversationKey" to PersistentDiagnosticLog.shortHash(convId),
                                "generation" to historySelectionGeneration,
                                "previousStatus" to previousStatus,
                                "surfaceStatus" to snap.status,
                                "reason" to refreshReason
                            )
                        )
                    } else if (surfaceRequestsHistorySync) {
                        // A partial baseline is complete enough for this selection; do not
                        // restart manifest sync on every streaming surface revision. A terminal
                        // transition gets one final refresh unless the B4R static baseline is
                        // in flight or already proven complete. Reconnect/selection still
                        // trigger their own requests through the existing paths.
                        if (previousStatus?.trim()?.lowercase() !in setOf(
                                "completed", "failed", "interrupted", "cancelled", "canceled"
                            ) && snap.status.trim().lowercase() in setOf(
                                "completed", "failed", "interrupted", "cancelled", "canceled"
                            )
                        ) {
                            historySyncInFlightConversationId = null
                            historySyncInFlightSyncId = null
                            clearHistorySyncSettlement()
                        }
                        maybeRequestHistorySync(convId)
                    }
                }
                Log.i(TAG, "[ipc][surface-snapshot] " +
                    "conv=$convId " +
                    "activeConv=$activeConv " +
                    "applied=$applied " +
                    "status=${snap.status} " +
                    "items=${snap.items.size} " +
                    "hasPendingApproval=${snap.pendingApproval != null} " +
                    "hasPendingPlan=${snap.pendingPlanAction != null} " +
                    "hasActiveGoal=${snap.activeGoal != null} " +
                    "desynced=${snap.desynced} " +
                    "authority=${authorityModeForState(_uiState.value, convId)}")
                if (!applied && convId != null && activeConv != null) {
                    Log.w(TAG, "[ipc][mismatch] surface snapshot not applied: " +
                        "pushedConv=$convId != activeConv=$activeConv")
                }
            }

            "conversation_status_changed" -> {
                val statusConversationId = normalizeThreadId(
                    json.optStringOrNullCompat("conversationId")
                )
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = statusConversationId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale conversation status " +
                            "incoming=${statusConversationId.orEmpty()} " +
                            "target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                applyConversationStatusChanged(json)
                val statusJson = json.optStringOrNullCompat("status").orEmpty()
                val previousJson = json.optStringOrNullCompat("previousStatus").orEmpty()
                Log.i(TAG, "[ipc][conversation-status-changed] " +
                    "conversationId=${json.optStringOrNullCompat("conversationId").orEmpty()} " +
                    "status=$statusJson " +
                    "previousStatus=$previousJson")
            }

            "follower_route_state" -> {
                val routeConversationId = normalizeThreadId(
                    json.optStringOrNullCompat("conversationId")
                )
                val activeConversationId = normalizeThreadId(_uiState.value.activeConversationId)
                if (routeConversationId != null && routeConversationId == activeConversationId) {
                val routeState = json.optString("state", json.optString("phase", "")).trim()
                    val requestId = json.optStringOrNullCompat("clientRequestId")
                    val turnId = json.optStringOrNullCompat("turnId")
                    _uiState.update { current ->
                        current.copy(
                            followerRouteState = routeState.takeUnless {
                                it == "turn_started" || it == "failed"
                            },
                            followerRouteRequestId = requestId.takeUnless {
                                routeState == "turn_started" || routeState == "failed"
                            },
                            status = if (routeState == "turn_started") "running" else current.status,
                            currentTurnId = if (routeState == "turn_started") {
                                turnId ?: current.currentTurnId
                            } else {
                                current.currentTurnId
                            }
                        )
                    }
                    Log.i(
                        TAG,
                        "[ipc][route-state] conversationId=$routeConversationId " +
                            "requestId=${requestId.orEmpty()} state=$routeState " +
                            "authority=${json.optStringOrNullCompat("authority").orEmpty()}"
                    )
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.turn.route_state",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(routeConversationId),
                            "clientRequestKey" to PersistentDiagnosticLog.shortHash(requestId),
                            "turnKey" to PersistentDiagnosticLog.shortHash(turnId),
                            "state" to routeState,
                            "authority" to json.optStringOrNullCompat("authority"),
                            "detail" to json.optStringOrNullCompat("detail")
                        ),
                        level = if (routeState == "failed" || routeState == "recovery_required") "warn" else "info"
                    )
                }
            }

            "codex_thread_recovery_required" -> {
                val recoveryConversationId = normalizeThreadId(
                    json.optStringOrNullCompat("conversationId")
                )
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = recoveryConversationId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale thread recovery " +
                            "incoming=${recoveryConversationId.orEmpty()} " +
                            "target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                val recoveryId = json.optStringOrNullCompat("recoveryId")
                if (!recoveryId.isNullOrBlank()) {
                    _uiState.update { current ->
                        current.copy(
                            followerRouteState = "recovery_required",
                            threadRecovery = CodexThreadRecoveryState(
                                recoveryId = recoveryId,
                                reason = json.optString("reason", "thread_recovery_required"),
                                forkAvailable = json.optBoolean("forkAvailable", false)
                            )
                        )
                    }
                }
            }

            "codex_thread_recovery_resolved" -> {
                val action = json.optString("action", "").trim()
                val draft = json.optJSONObject("draft")
                val draftOptions = draft?.optJSONObject("options")
                val draftInput = draft?.optStringOrNullCompat("input")
                val draftAttachments = draftOptions?.optJSONArray("attachments")
                    ?: draft?.optJSONArray("attachments")
                val restoredAttachments = buildList {
                    if (draftAttachments != null) {
                        for (index in 0 until draftAttachments.length()) {
                            val attachment = draftAttachments.optJSONObject(index) ?: continue
                            val url = attachment.optStringOrNullCompat("url") ?: continue
                            add(
                                CodexPendingImageAttachment(
                                    id = UUID.randomUUID().toString(),
                                    type = attachment.optString("type", "image"),
                                    label = url.substringAfterLast('/').ifBlank { "image" },
                                    url = url
                                )
                            )
                        }
                    }
                }
                _uiState.update { current ->
                    current.copy(
                        followerRouteState = null,
                        followerRouteRequestId = null,
                        threadRecovery = null,
                        composerRecoveryText = if (action == "cancel") draftInput else null,
                        pendingImageAttachments = if (action == "cancel" && restoredAttachments.isNotEmpty()) {
                            restoredAttachments
                        } else {
                            current.pendingImageAttachments
                        }
                    )
                }
            }

            "conversation_action_required" -> {
                val convId = json.optStringOrNullCompat("conversationId").orEmpty()
                val actionType = json.optString("actionType", "").trim()
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = convId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale conversation action " +
                            "incoming=$convId target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                Log.i(TAG, "[ipc][action-required] " +
                    "conversationId=$convId " +
                    "actionType=$actionType " +
                    "activeConversationId=${_uiState.value.activeConversationId.orEmpty()}")
                handleConversationActionRequired(json)
            }

            "session_codex_thread_bound" -> {
                val hasSelectionGeneration = json.has("selectionGeneration")
                val selectionGeneration = if (hasSelectionGeneration) {
                    json.optLong("selectionGeneration", Long.MIN_VALUE)
                } else {
                    null
                }
                if (!shouldAcceptSessionThreadBoundSelectionGeneration(
                        hasSelectionGeneration = hasSelectionGeneration,
                        selectionGeneration = selectionGeneration,
                        currentSelectionGeneration = historySelectionGeneration
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale session binding generation " +
                            "incoming=${selectionGeneration ?: "invalid"} " +
                            "current=$historySelectionGeneration"
                    )
                    return
                }
                val boundSessionId = json.optStringOrNullCompat("sessionId").orEmpty()
                val conversationId = normalizeThreadId(
                    json.optStringOrNullCompat("lastCodexThreadId")
                        ?: json.optStringOrNullCompat("conversationId")
                )
                if (conversationId != null) {
                    if (shouldSuppressExplicitHistorySessionEvent(
                            pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                            pinnedConversationId = pinnedIpcConversationId,
                            activeConversationId = _uiState.value.activeConversationId,
                            incomingConversationId = conversationId
                        )) {
                        Log.w(
                            TAG,
                            "[history][selection-protected] ignoring stale session binding " +
                                "incoming=$conversationId target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                        )
                        return
                    }
                    val rememberedOverrides = loadRememberedTaskOverrides(
                        conversationId,
                        reason = "session-thread-bound"
                    )
                    val previousConversationId = _uiState.value.activeConversationId.orEmpty()
                    val bindingDecision = resolveSessionThreadBindingDecision(
                        boundSessionId = boundSessionId,
                        currentSessionId = _uiState.value.sessionId
                    )
                    _uiState.update { current ->
                        if (!bindingDecision.appliesToCurrentSession) {
                            current
                        } else {
                            applyIpcConversationBindingToUiState(
                                state = current,
                                conversationId = conversationId,
                                rememberedOverrides = rememberedOverrides
                            )
                        }
                    }
                    if (bindingDecision.appliesToCurrentSession) {
                        pinnedIpcConversationId = conversationId
                        if (
                            bindingDecision.shouldSendActiveConversationSelection &&
                            normalizeThreadId(previousConversationId) != conversationId
                        ) {
                            if (_uiState.value.ipcOnline) {
                                beginAwaitingFreshIpcSurface()
                            }
                            subscribeActiveConversationIfNeeded()
                        }
                    }
                    Log.i(TAG, "[ipc][session-thread-bound] " +
                        "boundSessionId=$boundSessionId " +
                        "conversationId=$conversationId " +
                        "previousActiveConversationId=$previousConversationId " +
                        "switched=${previousConversationId.isNotEmpty() && previousConversationId != conversationId}")
                }
            }

            "codex_state" -> {
                val state = CodexState.from(json)
                val previousThreadId = _uiState.value.threadId
                val serverThreadId = state.threadId
                val normalizedServerThreadId = normalizeThreadId(serverThreadId)
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = normalizedServerThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_state " +
                            "incoming=${normalizedServerThreadId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                val rememberedServerOverrides = loadRememberedTaskOverrides(
                    normalizedServerThreadId,
                    reason = "codex-state"
                )
                val resolvesHistoryResumeHydration = normalizedServerThreadId != null &&
                    normalizedServerThreadId == pendingHistoryResumeHydrationThreadId
                val threadChanged = shouldResubscribeForCodexStateThreadChange(
                    previousThreadId = previousThreadId,
                    serverThreadId = serverThreadId
                )
                val previousCwd = _uiState.value.cwd
                val nextCwd = state.cwd ?: previousCwd
                val cwdChanged = normalizeThreadHistoryCwdForUi(previousCwd) !=
                    normalizeThreadHistoryCwdForUi(nextCwd)
                _uiState.update { current ->
                    val wasIdle = current.status.equals("idle", ignoreCase = true)
                    val isIdle = state.status.equals("idle", ignoreCase = true)
                    val nextThreadId = resolveCodexStateThreadId(
                        serverThreadId = serverThreadId,
                        activeConversationId = current.activeConversationId,
                        currentThreadId = current.threadId
                    )
                    val ipcAuthorityMode = authorityModeForState(current, nextThreadId)
                    val ipcAuthoritative = ipcAuthorityMode == IpcAuthorityMode.IPC_AUTHORITATIVE
                    val ipcSurfaceProtectsRuntime = matchingIpcSurfaceProtectsRuntimeFromCodexState(
                        ipcOnline = current.ipcOnline,
                        targetThreadId = nextThreadId,
                        surface = current.ipcSurfaceSnapshot
                    )
                    val millisSinceCanonicalActivity = if (lastCanonicalActivityAtElapsed > 0L) {
                        (SystemClock.elapsedRealtime() - lastCanonicalActivityAtElapsed).coerceAtLeast(0L)
                    } else {
                        Long.MAX_VALUE
                    }
                    val preserveCanonicalRuntime = ipcSurfaceProtectsRuntime || shouldPreserveCanonicalActivityRuntime(
                        incomingStatus = state.status,
                        currentStatus = current.status,
                        matchingOwnerSurfaceAvailable = false,
                        activityThreadId = canonicalActivityThreadId,
                        targetThreadId = nextThreadId,
                        millisSinceCanonicalActivity = millisSinceCanonicalActivity,
                        activityWindowMillis = CANONICAL_ACTIVITY_WINDOW_MILLIS
                    )
                    val ipcConversationSwitched = nextThreadId != null &&
                        normalizeThreadId(current.activeConversationId) != nextThreadId
                    // planMode is managed locally — never override from server codex_state
                    val nextPlanMode = current.planMode ?: false
                    val mergedInteractionState = mergeInteractionState(
                        current = current.interactionState,
                        incoming = state.interactionState
                    )
                    val nextState = syncExecutionWatch(
                        recalculateNextTurnEffectiveConfig(
                            current.copy(
                                status = if (preserveCanonicalRuntime) current.status else state.status,
                                model = state.model ?: current.model,
                                reasoningEffort = state.reasoningEffort ?: current.reasoningEffort,
                                sandbox = state.sandbox ?: current.sandbox,
                                planMode = nextPlanMode,
                                threadId = nextThreadId,
                                activeConversationId = nextThreadId,
                                awaitingNewThreadIpcSurface = resolveAwaitingIpcSurfaceAfterTargetState(
                                    currentlyAwaiting = current.awaitingNewThreadIpcSurface,
                                    pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                                    incomingThreadId = normalizedServerThreadId
                                ),
                                ipcSurfaceSnapshot = if (ipcConversationSwitched) null else current.ipcSurfaceSnapshot,
                                ownerCurrentCodexConfig = if (ipcConversationSwitched) null else current.ownerCurrentCodexConfig,
                                cachedCanonicalMessages = if (ipcConversationSwitched) emptyList() else current.cachedCanonicalMessages,
                                messages = if (ipcConversationSwitched) emptyList() else current.messages,
                                liveAuthoritativeConversationId = if (ipcConversationSwitched) null else current.liveAuthoritativeConversationId,
                                liveAuthoritativeDesynced = if (ipcConversationSwitched) false else current.liveAuthoritativeDesynced,
                                historyCacheState = if (ipcConversationSwitched) {
                                    CodexHistoryCacheUiState(conversationId = nextThreadId)
                                } else {
                                    current.historyCacheState
                                },
                                historyNetworkSyncState = if (ipcConversationSwitched) {
                                    CodexHistoryNetworkSyncUiState(conversationId = nextThreadId)
                                } else {
                                    current.historyNetworkSyncState
                                },
                                nextTurnOverrides = overridesForConversationSwitch(
                                    currentConversationId = current.activeConversationId,
                                    targetConversationId = nextThreadId,
                                    currentOverrides = current.nextTurnOverrides,
                                    rememberedOverrides = rememberedServerOverrides
                                ),
                                currentTurnId = if (preserveCanonicalRuntime) {
                                    current.currentTurnId
                                } else {
                                    state.currentTurnId
                                },
                                currentThreadTitle = if (nextThreadId == null) {
                                    ""
                                } else {
                                    resolveCurrentThreadTitle(
                                        threadId = nextThreadId,
                                        entries = current.threadHistoryEntries,
                                        fallback = current.currentThreadTitle
                                    )
                                },
                                interactionState = mergedInteractionState,
                                cwd = nextCwd,
                                threadHistoryEntries = if (cwdChanged) {
                                    filterThreadHistoryEntriesForCwd(current.threadHistoryEntries, nextCwd)
                                } else {
                                    current.threadHistoryEntries
                                },
                                serverNextTurnConfigBase = state.nextTurnEffectiveCodexConfig,
                                pendingServerRequests = if (ipcAuthoritative) {
                                    current.pendingServerRequests
                                } else {
                                    state.pendingServerRequests.filter { request ->
                                        request.handledBy.equals("client", ignoreCase = true)
                                    }
                                },
                                submittingServerRequestIds = if (ipcAuthoritative) {
                                    current.submittingServerRequestIds
                                } else {
                                    emptySet()
                                }
                            )
                        ),
                        markActivity = true
                    )
                    // Don't finalize plan workflow during thread transitions (forceNewThread idle blip)
                    if (isIdle && !wasIdle && !threadChanged) {
                        syncExecutionWatch(finalizePlanWorkflowOnTurnSettled(nextState), markActivity = false)
                    } else {
                        nextState
                    }
                }
                if (cwdChanged) {
                    refreshThreadHistory()
                }
                if (normalizedServerThreadId != null) {
                    pinnedIpcConversationId = normalizedServerThreadId
                }
                if (resolvesHistoryResumeHydration) {
                    pendingHistoryResumeHydrationThreadId = null
                    cancelHistoryResumeProtection()
                }
                if (threadChanged) {
                    beginAwaitingFreshIpcSurface()
                    Log.i(TAG, "[ipc][codex-state][thread-changed] re-subscribing: " +
                        "from=$previousThreadId to=${serverThreadId.orEmpty()}")
                    subscribeActiveConversationIfNeeded()
                }
                maybeRequestPendingThreadResync(
                    threadId = _uiState.value.threadId,
                    status = _uiState.value.status,
                    currentTurnId = _uiState.value.currentTurnId
                )
                maybeRequestLaunchHydrate(_uiState.value.threadId)
                clearPendingOptimisticNewThreadTransitionIfResolved(_uiState.value.threadId)
                if (json.has("tokenUsage")) {
                    applyTokenUsagePayload(state.tokenUsage)
                }
                if (json.has("rateLimitState")) {
                    applyRateLimitPayload(state.rateLimitState)
                }
                Log.i(TAG, "[ipc][codex-state] threadId=${_uiState.value.threadId.orEmpty()} " +
                    "activeConversationId=${_uiState.value.activeConversationId.orEmpty()} " +
                    "status=${state.status} appliedStatus=${_uiState.value.status} " +
                    "serverThreadId=${state.threadId.orEmpty()} " +
                    "ipcOnline=${_uiState.value.ipcOnline} " +
                    "note=threadId-may-differ-from-activeConversationId")
            }

            "codex_thread_ready" -> {
                val ready = CodexThreadReady.from(json)
                val readyThreadId = normalizeThreadId(ready.threadId)
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = readyThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_thread_ready " +
                            "incoming=${readyThreadId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                if (!shouldApplyThreadReadyToCurrentSelection(
                        state = _uiState.value,
                        readyThreadId = readyThreadId,
                        resumed = ready.resumed
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring foreign codex_thread_ready " +
                            "incoming=${readyThreadId.orEmpty()} " +
                            "active=${_uiState.value.activeConversationId.orEmpty()} " +
                            "thread=${_uiState.value.threadId.orEmpty()}"
                    )
                    return
                }
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.thread.ready",
                    mapOf(
                        "threadKey" to PersistentDiagnosticLog.shortHash(readyThreadId),
                        "resumed" to ready.resumed,
                        "activeConversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId)
                    )
                )
                val wasAwaitingNewSurface = _uiState.value.awaitingNewThreadIpcSurface
                _uiState.update {
                    val allowThreadIdSwitch = shouldAllowOptimisticTailAcrossThreadSwitch(
                        stateThreadId = it.threadId,
                        incomingThreadId = readyThreadId
                    )
                    val transition = buildThreadReadyUiTransition(
                        readyThreadId = readyThreadId,
                        resumed = ready.resumed,
                        state = it,
                        allowThreadIdSwitch = allowThreadIdSwitch
                    )
                    syncExecutionWatch(
                        it.copy(
                            threadId = readyThreadId,
                            activeConversationId = if (it.awaitingNewThreadIpcSurface) {
                                readyThreadId
                            } else {
                                it.activeConversationId
                            },
                            currentTurnId = transition.currentTurnId,
                            messages = transition.messages,
                            runtimePanel = transition.runtimePanel,
                            currentThreadTitle = resolveCurrentThreadTitle(
                                threadId = readyThreadId,
                                entries = it.threadHistoryEntries,
                                fallback = it.currentThreadTitle
                            )
                        ),
                        markActivity = false
                    )
                }
                if (wasAwaitingNewSurface && readyThreadId != null) {
                    pinnedIpcConversationId = readyThreadId
                }
                if (readyThreadId != null) {
                    rememberCurrentTaskOverrides(reason = "thread-ready")
                }
                clearPendingOptimisticNewThreadTransitionIfResolved(readyThreadId)
                Log.i(TAG, "Thread ready: $readyThreadId resumed=${ready.resumed}")
            }

            "codex_thread_snapshot" -> {
                val snapshot = CodexThreadSnapshot.from(json)
                val snapshotThreadId = normalizeThreadId(snapshot.threadId)
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = snapshotThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_thread_snapshot " +
                            "incoming=${snapshotThreadId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                val canonicalMessages = parseSnapshotMessages(snapshot)
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.thread.snapshot.applied",
                    mapOf(
                        "threadKey" to PersistentDiagnosticLog.shortHash(snapshotThreadId),
                        "messageCount" to canonicalMessages.size,
                        "previousMessageCount" to _uiState.value.messages.size,
                        "activeConversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId)
                    )
                )
                clearPendingThreadResync(snapshotThreadId)
                clearPendingLaunchHydrate(snapshotThreadId)
                _uiState.update { state ->
                    val allowThreadIdSwitch = shouldAllowOptimisticTailAcrossThreadSwitch(
                        stateThreadId = state.threadId,
                        incomingThreadId = snapshotThreadId
                    )
                    val preserveLocalTail = shouldPreserveLocalMessageTail(
                        threadId = snapshotThreadId,
                        state = state,
                        allowThreadIdSwitch = allowThreadIdSwitch
                    )
                    val mergedMessages = mergeCanonicalMessages(
                        canonicalMessages = canonicalMessages,
                        currentMessages = state.messages,
                        preserveLocalTail = preserveLocalTail
                    )
                    syncExecutionWatch(
                        state.copy(
                            threadId = snapshotThreadId,
                            messages = mergedMessages,
                            currentTurnId = if (preserveLocalTail) state.currentTurnId else null,
                            currentThreadTitle = resolveCurrentThreadTitle(
                                threadId = snapshotThreadId,
                                entries = state.threadHistoryEntries,
                                fallback = state.currentThreadTitle
                            )
                        ),
                        markActivity = false
                    )
                }
                clearPendingOptimisticNewThreadTransitionIfResolved(snapshotThreadId)
                Log.i(TAG, "Thread snapshot: $snapshotThreadId msgs=${canonicalMessages.size}")
            }

            "codex_turn_ack" -> {
                val ack = CodexTurnAck.from(json)
                val ackThreadId = normalizeThreadId(ack.threadId)
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = ackThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_turn_ack " +
                            "incoming=${ackThreadId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                _uiState.update {
                    syncExecutionWatch(
                        it.copy(
                            threadId = ackThreadId ?: it.threadId,
                            currentTurnId = ack.turnId.ifBlank { null },
                            currentThreadTitle = if (ackThreadId == null) {
                                it.currentThreadTitle
                            } else {
                                resolveCurrentThreadTitle(
                                    threadId = ackThreadId,
                                    entries = it.threadHistoryEntries,
                                    fallback = it.currentThreadTitle
                                )
                            }
                        ),
                        markActivity = false
                    )
                }
                clearPendingOptimisticNewThreadTransitionIfResolved(ackThreadId)
                executionFeedbackSeen.clear()
                Log.d(TAG, "Turn ack: ${ack.turnId}")
            }

            "codex_interrupt_ack" -> {
                val interruptThreadId = normalizeThreadId(
                    json.optStringOrNullCompat("threadId")
                )
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = interruptThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_interrupt_ack " +
                            "incoming=${interruptThreadId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                Log.d(TAG, "Interrupt ack")
                currentStreamingMessageId = null
                currentPlanStreamingMessageId = null
            }

            "follower_turn_interrupted" -> {
                Log.d(TAG, "Follower interrupt ack")
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.interrupt.acknowledged",
                    mapOf(
                        "conversationKey" to PersistentDiagnosticLog.shortHash(json.optStringOrNullCompat("conversationId")),
                        "acknowledged" to json.optBoolean("acknowledged", false),
                        "status" to _uiState.value.status,
                        "turnIdPresent" to (_uiState.value.currentTurnId != null)
                    )
                )
            }

            "follower_message_sent", "follower_goal_sent" -> {
                Log.d(TAG, "Follower turn accepted: ${envelope.type}")
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.turn.send.acknowledged",
                    mapOf(
                        "type" to envelope.type,
                        "conversationKey" to PersistentDiagnosticLog.shortHash(json.optStringOrNullCompat("conversationId")),
                        "clientRequestKey" to PersistentDiagnosticLog.shortHash(json.optStringOrNullCompat("clientRequestId")),
                        "turnKey" to PersistentDiagnosticLog.shortHash(json.optStringOrNullCompat("turnId")),
                        "replayed" to json.optBoolean("replayed", false)
                    )
                )
            }

            "follower_goal_control_ack" -> {
                val controlConversationId = normalizeThreadId(
                    json.optStringOrNullCompat("conversationId")
                )
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = controlConversationId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale follower_goal_control_ack " +
                            "incoming=${controlConversationId.orEmpty()} target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                Log.d(TAG, "Owner Goal control accepted: ${json.optString("action", "")}")
                json.optStringOrNullCompat("warning")?.let { warning ->
                    _uiState.update { current -> current.copy(errorMessage = warning) }
                }
            }

            "follower_approval_response_sent" -> {
                val requestId = json.optStringOrNullCompat("requestId").orEmpty()
                Log.i(
                    TAG,
                    "[approval][ack] requestId=$requestId " +
                        "conversationId=${json.optStringOrNullCompat("conversationId").orEmpty()}"
                )
                if (requestId.isNotEmpty()) {
                    _uiState.update { current ->
                        current.copy(
                            submittingServerRequestIds = current.submittingServerRequestIds - requestId
                        )
                    }
                }
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.approval.acknowledged",
                    mapOf(
                        "requestKey" to PersistentDiagnosticLog.shortHash(requestId),
                        "conversationKey" to PersistentDiagnosticLog.shortHash(json.optStringOrNullCompat("conversationId")),
                        "acknowledged" to json.optBoolean("acknowledged", false)
                    )
                )
            }

            "follower_plan_response_sent" -> {
                Log.i(
                    TAG,
                    "[plan][ack] requestId=${json.optStringOrNullCompat("requestId").orEmpty()} " +
                        "conversationId=${json.optStringOrNullCompat("conversationId").orEmpty()}"
                )
            }

            "codex_response" -> {
                val response = CodexResponse.from(json)
                handleCodexResponse(response)
            }

            "codex_error" -> {
                val error = CodexError.from(json)
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.websocket.error",
                    mapOf(
                        "code" to error.code,
                        "message" to error.message,
                        "conversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId),
                        "threadKey" to PersistentDiagnosticLog.shortHash(_uiState.value.threadId),
                        "routeState" to _uiState.value.followerRouteState
                    ),
                    level = "error"
                )
                if (error.code == "CODEX_NO_ACTIVE_TURN") {
                    _uiState.update {
                        syncExecutionWatch(
                            it.copy(currentTurnId = null),
                            markActivity = false
                        )
                    }
                    Log.w(TAG, "Ignoring stale interrupt error: ${error.code} ${error.message}")
                    return
                }
                val message = "${error.code}: ${error.message}"
                appendMessage(ChatMessage.Role.ERROR, message)
                _uiState.update {
                    it.copy(
                        errorMessage = message,
                        currentTurnId = null,
                        planWorkflow = buildEmptyPlanWorkflowState(),
                        runtimePanel = it.runtimePanel.copy(
                            warning = message,
                            warningTone = "error"
                        )
                    )
                }
                Log.e(TAG, "Codex error: ${error.code} ${error.message}")
            }

            "error" -> {
                val message = json.optString("message", "Codex request failed")
                val detail = json.opt("detail")?.toString()?.takeIf { it.isNotBlank() }
                val errorCode = json.optStringOrNullCompat("code")
                if (errorCode == "GOAL_EXTERNAL_OWNER_UNSUPPORTED") {
                    val objective = json.optStringOrNullCompat("goalObjective")
                    if (!objective.isNullOrBlank()) {
                        _uiState.update { current ->
                            current.copy(
                                errorMessage = null,
                                goalOwnerRequiredObjective = objective.trim()
                            )
                        }
                        return
                    }
                }
                val rendered = if (detail.isNullOrBlank()) message else "$message: $detail"
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.websocket.error",
                    mapOf(
                        "message" to message,
                        "detail" to detail,
                        "conversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId),
                        "threadKey" to PersistentDiagnosticLog.shortHash(_uiState.value.threadId),
                        "routeState" to _uiState.value.followerRouteState,
                        "requestKey" to PersistentDiagnosticLog.shortHash(_uiState.value.followerRouteRequestId)
                    ),
                    level = "error"
                )
                if (message.contains("interrupt", ignoreCase = true) ||
                    detail?.contains("no-client-found", ignoreCase = true) == true
                ) {
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.interrupt.failed",
                        mapOf(
                            "conversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId),
                            "turnKey" to PersistentDiagnosticLog.shortHash(_uiState.value.currentTurnId),
                            "message" to message,
                            "detail" to detail,
                            "status" to _uiState.value.status,
                            "surfaceStatus" to _uiState.value.ipcSurfaceSnapshot?.status,
                            "surfaceDesynced" to (_uiState.value.ipcSurfaceSnapshot?.desynced == true)
                        ),
                        level = "error"
                    )
                }
                appendMessage(ChatMessage.Role.ERROR, rendered)
                _uiState.update {
                    it.copy(
                        errorMessage = rendered,
                        planWorkflow = if (message == "Failed to send plan response" &&
                            it.planWorkflow.phase == PLAN_PHASE_EXECUTING_CONFIRMED_PLAN
                        ) {
                            it.planWorkflow.copy(phase = PLAN_PHASE_READY_FOR_CONFIRMATION)
                        } else {
                            it.planWorkflow
                        },
                        runtimePanel = it.runtimePanel.copy(
                            warning = rendered,
                            warningTone = "error"
                        )
                    )
                }
            }

            "codex_notification" -> {
                val notif = CodexNotification.from(json)
                val notificationThreadId = extractCodexThreadIdFromPayload(
                    raw = notif.raw,
                    params = notif.params
                )
                if (notif.method != "account/rateLimits/updated" &&
                    shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = notificationThreadId
                    )
                ) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_notification " +
                            "method=${notif.method} incoming=${notificationThreadId.orEmpty()} " +
                            "target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                handleCodexNotification(notif)
            }

            "codex_server_request" -> {
                val requestEnvelope = CodexServerRequestEnvelope.from(json)
                val requestThreadId = requestEnvelope?.let { envelope ->
                    extractCodexThreadIdFromPayload(
                        raw = envelope.raw,
                        params = envelope.request.params
                    )
                }
                if (shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = requestThreadId
                    )) {
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring stale codex_server_request " +
                            "incoming=${requestThreadId.orEmpty()} " +
                            "target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                handleCodexServerRequest(requestEnvelope)
            }

            else -> {
                Log.d(TAG, "Unhandled message type: ${envelope.type}")
            }
        }
    }

    private fun handleCodexResponse(response: CodexResponse) {
        val method = response.method
        if ((method == "thread/resume" || method == "thread/read") &&
            response.raw.has("selectionGeneration") &&
            response.raw.optLong("selectionGeneration", -1L) != historySelectionGeneration
        ) {
            Log.w(
                TAG,
                "[history][metadata-response][stale] method=$method " +
                    "incomingGeneration=${response.raw.optLong("selectionGeneration", -1L)} " +
                    "currentGeneration=$historySelectionGeneration"
            )
            return
        }
        if (method == "thread/list" && response.raw.has("selectionGeneration") &&
            response.raw.optLong("selectionGeneration", -1L) != threadListRequestGeneration
        ) {
            Log.w(
                TAG,
                "[history][list-response][stale] ignored " +
                    "incomingGeneration=${response.raw.optLong("selectionGeneration", -1L)} " +
                    "requestGeneration=$threadListRequestGeneration"
            )
            return
        }
        if (!method.isNullOrBlank()) {
            if (response.error != null) {
                if (method == "thread/resume" &&
                    !response.raw.has("selectionGeneration") &&
                    shouldSuppressExplicitHistorySessionEvent(
                        pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                        pinnedConversationId = pinnedIpcConversationId,
                        activeConversationId = _uiState.value.activeConversationId,
                        incomingConversationId = null
                    )
                ) {
                    // A legacy gateway cannot identify which queued resume
                    // failed.  While an explicit cache-first selection is
                    // pending, do not let an older resume error clear the
                    // target's protection; the bounded history watchdog will
                    // surface a terminal recovery state if the current
                    // request also fails.
                    Log.w(
                        TAG,
                        "[history][selection-protected] ignoring unscoped legacy " +
                            "thread/resume error target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                    )
                    return
                }
                handleCodexRequestError(method, response.error)
                return
            }
            when (method) {
                "model/list" -> {
                    handleModelListResponse(response.result)
                    return
                }
                "permissionProfile/list" -> {
                    handlePermissionProfileListResponse(response.result)
                    return
                }
                "thread/list" -> {
                    handleThreadListResponse(response.result)
                    return
                }
                "thread/resume" -> {
                    if (shouldIgnoreStaleThreadResumeResponse(response.result)) {
                        val incomingThreadId = extractThreadResult(response.result)
                            ?.optStringOrNullCompat("id")
                        Log.w(
                            TAG,
                            "[history][metadata-response][stale] ignored thread/resume " +
                                "incoming=${incomingThreadId.orEmpty()} " +
                                "active=${_uiState.value.activeConversationId.orEmpty()} " +
                                "target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
                        )
                        return
                    }
                    // Gateway records the matching metadata-resume history
                    // mode before it emits this response.  Mark only this
                    // exact generation ready; the later Step 3 request still
                    // waits for a healthy IPC surface and a complete static
                    // cache, and cannot touch ordinary history sync state.
                    noteCanonicalTailValidationMetadataReady(response)
                    handleThreadResumeResponse(response.result)
                    return
                }
                "thread/read" -> {
                    handleThreadReadResponse(response.result)
                    return
                }
                "skills/list" -> {
                    handleSkillsListResponse(response.result)
                    return
                }
                "account/rateLimits/read" -> {
                    applyRateLimitPayload(response.result)
                    return
                }
                "thread/compact/start" -> {
                    handleCompactStartResponse(response.result)
                    return
                }
                "thread/fork",
                "thread/archive",
                "thread/unarchive",
                "thread/name/set" -> {
                    handleThreadMutationResponse(method, response.result)
                    return
                }
            }
        }
        when (response.event) {
            "message_start" -> {
                // Finalize any orphaned streaming message before starting a new one
                if (currentStreamingMessageId != null) {
                    val orphanId = currentStreamingMessageId
                    _uiState.update { state ->
                        val updated = state.messages.map { msg ->
                            if (msg.id == orphanId) msg.copy(streaming = false) else msg
                        }
                        state.copy(messages = updated)
                    }
                    Log.w(TAG, "Finalized orphaned streaming message: $orphanId")
                }
                val msgId = UUID.randomUUID().toString()
                currentStreamingMessageId = msgId
                upsertAssistantMessage(
                    itemId = msgId,
                    content = response.content.orEmpty(),
                    streaming = true
                )
            }

            "message_delta", "content_block_delta" -> {
                val streamId = currentStreamingMessageId ?: return
                val delta = response.content ?: return
                appendAssistantDelta(streamId, delta)
            }

            "message_stop" -> {
                val streamId = currentStreamingMessageId ?: return
                _uiState.update { state ->
                    val updated = state.messages.map { msg ->
                        if (msg.id == streamId) msg.copy(streaming = false) else msg
                    }
                    state.copy(messages = updated)
                }
                currentStreamingMessageId = null
            }

            "tool_use_start" -> {
                val msg = ChatMessage(
                    id = UUID.randomUUID().toString(),
                    role = ChatMessage.Role.TOOL,
                    content = response.content.orEmpty(),
                    toolName = response.toolName
                )
                _uiState.update { it.copy(messages = it.messages + msg) }
            }

            "system" -> {
                val msg = ChatMessage(
                    id = UUID.randomUUID().toString(),
                    role = ChatMessage.Role.SYSTEM,
                    content = response.content.orEmpty()
                )
                _uiState.update { it.copy(messages = it.messages + msg) }
            }

            else -> {
                Log.d(TAG, "Unhandled codex_response event: ${response.event}")
            }
        }
    }

    private fun handleModelListResponse(result: Any?) {
        val catalog = CodexModelOption.listFrom(result)
        if (catalog.isEmpty()) {
            PersistentDiagnosticLog.event("codex", "android.codex.model_catalog.loaded", mapOf(
                "count" to 0,
                "generation" to modelCatalogRequestGeneration,
                "uiModelCount" to _uiState.value.capabilities?.models?.size,
                "displayState" to "empty"
            ), level = "warn")
            return
        }
        _uiState.update { state -> applyModelCatalogToUiState(state, catalog) }
        PersistentDiagnosticLog.event("codex", "android.codex.model_catalog.loaded", mapOf(
            "count" to catalog.size,
            "generation" to modelCatalogRequestGeneration,
            "modelKeys" to catalog.map { PersistentDiagnosticLog.shortHash(it.id) },
            "displayState" to "loaded"
        ))
        PersistentDiagnosticLog.event("codex", "android.codex.model_catalog.ui_applied", mapOf(
            "uiModelCount" to _uiState.value.capabilities?.models?.size,
            "selectedModelPresent" to !_uiState.value.model.isNullOrBlank(),
            "selectedOverridePresent" to !_uiState.value.nextTurnOverrides.model.isNullOrBlank(),
            "displayState" to if (_uiState.value.capabilities?.models?.isNotEmpty() == true) "loaded" else "empty"
        ))
        Log.i(TAG, "Loaded model list: ${catalog.map(CodexModelOption::id)}")
    }

    private fun handlePermissionProfileListResponse(result: Any?) {
        val profiles = CodexPermissionProfileOption.listFrom(result)
        _uiState.update {
            it.copy(
                permissionProfiles = profiles,
                permissionProfilesLoading = false,
                permissionProfilesRequested = true
            )
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.permission_catalog.loaded",
            mapOf(
                "count" to profiles.size,
                "profileKeys" to profiles.map { PersistentDiagnosticLog.shortHash(it.id) },
                "selectedPermissionPresent" to !_uiState.value.nextTurnOverrides.permissionProfile.isNullOrBlank(),
                "displayState" to if (profiles.isNotEmpty()) "loaded" else "empty"
            ),
            level = if (profiles.isEmpty()) "warn" else "info"
        )
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.permission_catalog.ui_applied",
            mapOf(
                "uiProfileCount" to _uiState.value.permissionProfiles.size,
                "selectedPermissionPresent" to !_uiState.value.nextTurnOverrides.permissionProfile.isNullOrBlank(),
                "loading" to _uiState.value.permissionProfilesLoading,
                "displayState" to if (_uiState.value.permissionProfiles.isNotEmpty()) "loaded" else "empty"
            )
        )
        Log.i(TAG, "Loaded permission profiles: ${profiles.map(CodexPermissionProfileOption::id)}")
    }

    private fun maybeLoadSkillCatalog() {
        val state = _uiState.value
        if (state.capabilities?.skillsList != true) return
        if (state.toolsPanel.skills.isNotEmpty() || state.toolsPanel.loading || state.toolsPanel.requested) {
            return
        }
        _uiState.update {
            it.copy(
                toolsPanel = it.toolsPanel.copy(
                    loading = true,
                    requested = true
                )
            )
        }
        val params = JSONObject()
        val cwd = state.cwd?.trim().orEmpty()
        if (cwd.isNotEmpty()) {
            params.put("cwds", JSONArray().put(cwd))
        }
        connectionManager.send(CodexClientMessages.codexRequest("skills/list", params))
    }

    private fun handleSkillsListResponse(result: Any?) {
        val skills = normalizeSkillCatalog(result)
        _uiState.update { state ->
            state.copy(
                toolsPanel = state.toolsPanel.copy(
                    skills = skills,
                    loading = false,
                    requested = true
                )
            )
        }
    }

    private fun requestRateLimits(silent: Boolean = false) {
        if (_uiState.value.capabilities?.rateLimitsRead != true) return
        if (!silent) {
            _uiState.update {
                it.copy(
                    usagePanel = it.usagePanel.copy(rateLimitTone = "")
                )
            }
        }
        connectionManager.send(CodexClientMessages.codexRequest("account/rateLimits/read"))
    }

    private fun handleCompactStartResponse(result: Any?) {
        val detail = when (result) {
            is JSONObject -> {
                pickFirstText(
                    result,
                    listOf("message"),
                    listOf("detail"),
                    listOf("status")
                )
            }
            else -> ""
        }
        val successMessage = detail.ifEmpty {
            appContext.getString(R.string.codex_native_tools_compact_submitted)
        }
        _uiState.update {
            it.copy(
                toolsPanel = it.toolsPanel.copy(
                    compactSubmitting = false,
                    compactStatusText = successMessage,
                    compactStatusTone = if (detail.isEmpty()) "success" else ""
                )
            )
        }
        appendMessage(ChatMessage.Role.SYSTEM, successMessage)
    }

    private fun requestThreadMutation(threadId: String, actionKind: String, method: String) {
        val normalizedThreadId = threadId.trim()
        if (normalizedThreadId.isEmpty()) return
        _uiState.update {
            it.copy(
                threadHistoryActionThreadId = normalizedThreadId,
                threadHistoryActionKind = actionKind
            )
        }
        connectionManager.send(
            CodexClientMessages.codexRequest(
                action = method,
                params = JSONObject().put("threadId", normalizedThreadId)
            )
        )
    }

    private fun handleCodexRequestError(method: String, error: JSONObject) {
        val message = error.optString("message", "Codex request failed.")
            .trim()
            .ifEmpty { "Codex request failed." }
        val suppressHistoryResumeError = shouldSuppressHistoryResumeError(
            method = method,
            pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId
        )
        val historyResumeErrorThreadId = pendingHistoryResumeHydrationThreadId
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.request.failed",
            mapOf(
                "method" to method,
                "message" to message,
                "threadKey" to PersistentDiagnosticLog.shortHash(_uiState.value.threadId),
                "activeConversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId),
                "routeState" to _uiState.value.followerRouteState
            ),
            level = "error"
        )
        when (method) {
            "model/list" -> {
                if (!legacyModelListFallbackRequested) {
                    legacyModelListFallbackRequested = true
                    Log.w(TAG, "Hidden model catalog unavailable; retrying legacy model/list: $message")
                    connectionManager.send(CodexClientMessages.codexRequest("model/list"))
                } else {
                    appendMessage(ChatMessage.Role.ERROR, message)
                }
            }
            "permissionProfile/list" -> {
                _uiState.update {
                    it.copy(
                        permissionProfilesLoading = false,
                        permissionProfilesRequested = true
                    )
                }
                Log.w(TAG, "Permission profile catalog unavailable: $message")
            }
            "thread/list" -> {
                _uiState.update { it.copy(threadHistoryLoading = false, threadHistoryStatus = "offline") }
                appendMessage(ChatMessage.Role.ERROR, message)
            }
            "skills/list" -> {
                _uiState.update {
                    it.copy(
                        toolsPanel = it.toolsPanel.copy(
                            loading = false,
                            requested = false
                        )
                    )
                }
                appendMessage(ChatMessage.Role.ERROR, message)
            }
            "account/rateLimits/read" -> {
                appendMessage(ChatMessage.Role.ERROR, message)
            }
            "thread/compact/start" -> {
                _uiState.update {
                    it.copy(
                        toolsPanel = it.toolsPanel.copy(
                            compactSubmitting = false,
                            compactStatusText = message,
                            compactStatusTone = "error"
                        )
                    )
                }
                appendMessage(ChatMessage.Role.ERROR, message)
            }
            "thread/read" -> {
                _uiState.update {
                    it.copy(
                        threadHistoryLoading = false,
                        threadHistoryActionThreadId = "",
                        threadHistoryActionKind = ""
                    )
                }
                appendMessage(ChatMessage.Role.ERROR, message)
            }
            "thread/resume",
            "thread/fork",
            "thread/archive",
            "thread/unarchive",
            "thread/name/set" -> {
                if (method == "thread/resume") {
                    pendingHistoryResumeHydrationThreadId = null
                    cancelHistoryResumeProtection()
                    pinnedIpcConversationId = _uiState.value.activeConversationId?.trim()
                        ?.takeIf { it.isNotEmpty() }
                }
                _uiState.update {
                    it.copy(
                        awaitingNewThreadIpcSurface = if (method == "thread/resume") {
                            false
                        } else {
                            it.awaitingNewThreadIpcSurface
                        },
                        threadHistoryLoading = false,
                        threadHistoryActionThreadId = "",
                        threadHistoryActionKind = "",
                        threadRenameTargetId = if (method == "thread/name/set") it.threadRenameTargetId else "",
                        threadRenameDraft = if (method == "thread/name/set") it.threadRenameDraft else ""
                    )
                }
                if (suppressHistoryResumeError) {
                    // thread/resume is only a metadata/IPC re-entry hint for
                    // an existing-task selection.  The independent bounded
                    // history channel owns the visible outcome; do not add a
                    // misleading "reply failed" card when the task itself
                    // can still be recovered without a Desktop owner.
                    _uiState.update { current ->
                        current.copy(
                            errorMessage = null,
                            threadHistoryStatus = "cache_only"
                        )
                    }
                    PersistentDiagnosticLog.event(
                        "codex",
                        "android.codex.history.resume_optional_error",
                        mapOf(
                            "threadKey" to PersistentDiagnosticLog.shortHash(
                                historyResumeErrorThreadId
                            ),
                            "message" to message
                        ),
                        level = "warn"
                    )
                } else {
                    appendMessage(ChatMessage.Role.ERROR, message)
                }
            }
            else -> appendMessage(ChatMessage.Role.ERROR, message)
        }
    }

    private fun handleThreadListResponse(result: Any?) {
        val profileId = currentProfile?.id
        if (profileId == null || threadListRequestProfileId != profileId ||
            threadListRequestGeneration != historySelectionGeneration ||
            normalizeThreadHistoryCwdForUi(threadListRequestCwd) !=
                normalizeThreadHistoryCwdForUi(_uiState.value.cwd)
        ) return
        val entries = scopeRemoteThreadHistoryEntriesForCwd(
            parseThreadHistoryEntries(result),
            threadListRequestCwd
        )
        val refreshedAt = System.currentTimeMillis()
        val cachedEntries = filterThreadHistoryEntriesForCwd(
            _uiState.value.threadHistoryEntries,
            threadListRequestCwd
        )
        val mergedEntries = mergeThreadHistoryEntries(cachedEntries, entries)
        val indexEntries = entries.map { entry ->
            val merged = mergeThreadHistoryEntry(cachedEntries.firstOrNull { it.id == entry.id }, entry)
            CodexThreadIndexEntry(
                endpointId = profileId,
                conversationId = merged.id,
                title = merged.title,
                preview = merged.preview,
                archived = merged.archived,
                cwd = merged.cwd,
                goalObjective = merged.goalObjective,
                createdAt = merged.createdAt,
                lastActiveAt = merged.lastActiveAt,
                lastSeenAt = refreshedAt,
                lastRemoteRefreshAt = refreshedAt,
                source = "thread_list"
            )
        }
        viewModelScope.launch(Dispatchers.IO) {
            runCatching {
                historyCacheStore.upsertThreadIndex(profileId, indexEntries, refreshedAt)
            }.onFailure { error ->
                Log.w(TAG, "Failed to persist Codex thread index", error)
            }
        }
        _uiState.update { state ->
            state.copy(
                threadHistoryEntries = mergeGoalHistoryEntries(mergedEntries),
                threadHistoryLoading = false,
                threadHistoryStatus = "live",
                currentThreadTitle = resolveCurrentThreadTitle(
                    threadId = state.threadId,
                    entries = mergedEntries,
                    fallback = state.currentThreadTitle
                )
            )
        }
    }

    private fun handleThreadResumeResponse(result: Any?) {
        val thread = extractThreadResult(result) ?: run {
            clearThreadHistoryAction()
            return
        }
        val resumedThreadId = normalizeThreadId(thread.optStringOrNullCompat("id")).orEmpty()
        val rememberedResumedOverrides = loadRememberedTaskOverrides(
            resumedThreadId,
            reason = "thread-resume"
        )
        val resumedTitle = resolveThreadTitle(thread)
        threadHadPlanTurn = false
        clearPendingOptimisticNewThreadTransition()
        clearPendingThreadResync()
        if (resumedThreadId.isNotEmpty()) {
            pinnedIpcConversationId = resumedThreadId
            if (_uiState.value.ipcOnline) {
                beginAwaitingFreshIpcSurface()
            } else {
                awaitingFreshIpcSurface = false
                matchingIpcSurfaceDesynced = false
                ipcAuthorityModeEnteredAtElapsed = SystemClock.elapsedRealtime()
            }
            lastRecoverySubscribeAtElapsed = 0L
        }
        _uiState.update { state ->
            val targetThreadId = resumedThreadId.ifEmpty { state.threadId.orEmpty() }
            val switchedConversation = targetThreadId.isNotEmpty() &&
                state.activeConversationId?.trim().orEmpty() != targetThreadId
            state.copy(
                threadId = targetThreadId.ifEmpty { state.threadId },
                activeConversationId = targetThreadId.ifEmpty { state.activeConversationId },
                awaitingNewThreadIpcSurface = shouldAwaitIpcSurfaceAfterThreadResumeResponse(
                    targetThreadId = targetThreadId,
                    pendingHydrationThreadId = pendingHistoryResumeHydrationThreadId
                ),
                ipcSurfaceSnapshot = if (switchedConversation) null else state.ipcSurfaceSnapshot,
                ownerCurrentCodexConfig = if (switchedConversation) null else state.ownerCurrentCodexConfig,
                cachedCanonicalMessages = if (switchedConversation) emptyList() else state.cachedCanonicalMessages,
                messages = if (switchedConversation) emptyList() else state.messages,
                liveAuthoritativeConversationId = if (switchedConversation) null else state.liveAuthoritativeConversationId,
                liveAuthoritativeDesynced = if (switchedConversation) false else state.liveAuthoritativeDesynced,
                historyCacheState = if (switchedConversation) {
                    CodexHistoryCacheUiState(conversationId = targetThreadId)
                } else {
                    state.historyCacheState
                },
                historyNetworkSyncState = if (switchedConversation) {
                    CodexHistoryNetworkSyncUiState(conversationId = targetThreadId)
                } else {
                    state.historyNetworkSyncState
                },
                nextTurnOverrides = if (switchedConversation) rememberedResumedOverrides else state.nextTurnOverrides,
                currentThreadTitle = resumedTitle.ifBlank { state.currentThreadTitle },
                threadHistoryActionThreadId = "",
                threadHistoryActionKind = "",
                planWorkflow = buildEmptyPlanWorkflowState(),
                runtimePanel = buildEmptyRuntimePanelState(visible = state.runtimePanel.visible),
                noticesPanel = CodexNoticesPanelState(visible = state.noticesPanel.visible),
                pendingServerRequests = emptyList(),
                submittingServerRequestIds = emptySet()
            )
        }
        if (resumedThreadId.isNotEmpty()) {
            hydrateCachedConversation(resumedThreadId, historySelectionGeneration)
            subscribeActiveConversationIfNeeded()
            // Start detail hydration after thread/resume has established the
            // selected upstream thread.  The list response is metadata-only;
            // it must not be mistaken for the conversation正文.
            maybeRequestHistorySync(resumedThreadId)
            runForegroundRecoveryTick(SystemClock.elapsedRealtime())
        } else {
            clearThreadHistoryAction()
        }
        if (thread.has("tokenUsage")) {
            applyTokenUsagePayload(thread.opt("tokenUsage"))
        }
        refreshThreadHistory()
        if (resumedThreadId.isNotEmpty() &&
            resumedThreadId == pendingHistoryResumeHydrationThreadId
        ) {
            // The explicit target has now been acknowledged.  Keep the
            // pinned conversation id for stale-id protection, but stop
            // quarantining legitimate unscoped events from this conversation.
            pendingHistoryResumeHydrationThreadId = null
            cancelHistoryResumeProtection()
        }
    }

    /**
     * Older gateways did not echo selectionGeneration on metadata responses.
     * Keep an explicit history selection authoritative even in that wire
     * shape: a late resume result for the previously bound task must not move
     * the UI back after the cache-first B selection is already visible.
     */
    private fun shouldIgnoreStaleThreadResumeResponse(result: Any?): Boolean {
        val active = normalizeThreadId(_uiState.value.activeConversationId)
        val incoming = extractThreadResult(result)
            ?.optStringOrNullCompat("id")
            ?.let(::normalizeThreadId)
        return shouldSuppressExplicitHistorySessionEvent(
            pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
            pinnedConversationId = pinnedIpcConversationId,
            activeConversationId = active,
            incomingConversationId = incoming
        )
    }

    private data class DecodedHistoryCacheSnapshot(
        val messages: List<ChatMessage>,
        val uiState: CodexHistoryCacheUiState,
        /** B4R's complete static-history proof; distinct from old v2 `complete`. */
        val durableCoverageComplete: Boolean = false,
        val providerMode: String? = null
    )

    private fun decodeHistoryCacheSnapshot(
        key: CodexHistorySelectionKey,
        cached: CodexHistoryCacheView?,
        readError: Throwable? = null
    ): DecodedHistoryCacheSnapshot {
        if (readError != null) {
            return DecodedHistoryCacheSnapshot(
                messages = emptyList(),
                uiState = CodexHistoryCacheUiState(
                    conversationId = key.conversationId,
                    generation = key.generation,
                    loadState = CodexHistoryCacheLoadState.FAILED,
                    detailCode = "cache_read_failed"
                )
            )
        }
        if (cached == null) {
            return DecodedHistoryCacheSnapshot(
                messages = emptyList(),
                uiState = CodexHistoryCacheUiState(
                    conversationId = key.conversationId,
                    generation = key.generation,
                    loadState = CodexHistoryCacheLoadState.MISSING
                )
            )
        }
        val orderedItems = cached.items.sortedBy { it.position }
        val decodedMessages = orderedItems.mapNotNull(::decodeCachedHistoryItem)
        val durableItems = orderedItems.filterNot { it.provisional }
        val decodedIds = decodedMessages.mapTo(mutableSetOf()) { it.id }
        val decodedDurableCount = durableItems.count { it.itemKey in decodedIds }
        val decodedAllDurableRows = decodedDurableCount == durableItems.size
        val checkpoint = cached.checkpoint
        val legacyCheckpointComplete = checkpoint.complete &&
            checkpoint.itemCount == durableItems.size &&
            decodedAllDurableRows
        val durableCoverageComplete = hasDurableHistoryCoverage(
            coverageComplete = checkpoint.coverageComplete,
            checkpointItemCount = checkpoint.itemCount,
            durableItemCount = durableItems.size,
            decodedAllDurableRows = decodedAllDurableRows
        )
        val complete = isCompleteStaticHistoryCache(
            legacyCheckpointComplete = legacyCheckpointComplete,
            durableCoverageComplete = durableCoverageComplete
        )
        val loadState = if (decodedMessages.isEmpty() && durableItems.isNotEmpty()) {
            CodexHistoryCacheLoadState.FAILED
        } else {
            CodexHistoryCacheLoadState.READY
        }
        return DecodedHistoryCacheSnapshot(
            messages = decodedMessages,
            uiState = CodexHistoryCacheUiState(
                conversationId = key.conversationId,
                generation = key.generation,
                loadState = loadState,
                complete = complete,
                itemCount = decodedDurableCount,
                lastSyncedAt = checkpoint.lastSyncedAt,
                detailCode = if (!decodedAllDurableRows) "cache_decode_partial" else null
            ),
            durableCoverageComplete = durableCoverageComplete,
            providerMode = checkpoint.providerMode
        )
    }

    private fun historyNetworkState(
        key: CodexHistorySelectionKey,
        state: CodexHistoryNetworkSyncState,
        detailCode: String? = null,
        pageIndex: Int? = null,
        pageCount: Int? = null
    ): CodexHistoryNetworkSyncUiState = CodexHistoryNetworkSyncUiState(
        conversationId = key.conversationId,
        generation = key.generation,
        state = state,
        detailCode = detailCode,
        pageIndex = pageIndex,
        pageCount = pageCount
    )

    private fun historySelectionKeyOrNull(
        conversationId: String,
        generation: Long = historySelectionGeneration
    ): CodexHistorySelectionKey? = currentHistorySelectionKey(
        conversationId = conversationId,
        generation = generation
    )

    private fun hydrateCachedConversation(conversationId: String, generation: Long) {
        val profileId = currentProfile?.id ?: return
        val key = historySelectionKeyOrNull(conversationId, generation) ?: return
        if (shouldSkipDuplicateHistoryCacheHydration(lastCommittedHistoryCacheKey, key)) {
            Log.i(
                TAG,
                "[history][cache-hydrate][skipped] already committed for " +
                    "conversationId=${key.conversationId} generation=${key.generation}"
            )
            return
        }
        _uiState.update { state ->
            if (state.activeConversationId?.trim() != key.conversationId ||
                state.historyCacheState.generation > key.generation
            ) {
                state
            } else {
                state.copy(
                    historyCacheState = state.historyCacheState.copy(
                        conversationId = key.conversationId,
                        generation = key.generation,
                        loadState = if (state.historyCacheState.ready) {
                            CodexHistoryCacheLoadState.READY
                        } else {
                            CodexHistoryCacheLoadState.LOADING
                        }
                    )
                )
            }
        }
        viewModelScope.launch(Dispatchers.IO) {
            val cachedResult = runCatching {
                historyCacheStore.readConversation(profileId, conversationId)
            }
            if (!isCurrentHistorySelection(key)) return@launch
            val snapshot = decodeHistoryCacheSnapshot(
                key = key,
                cached = cachedResult.getOrNull(),
                readError = cachedResult.exceptionOrNull()
            )
            _uiState.update { state ->
                if (!isCurrentHistorySelection(key)) {
                    state
                } else {
                    state.copy(
                        cachedCanonicalMessages = snapshot.messages,
                        messages = mergeCachedHistoryIntoLiveMessagesForUi(
                            state = state,
                            conversationId = conversationId,
                            cachedMessages = snapshot.messages
                        ),
                        historyCacheState = snapshot.uiState
                    )
                }
            }
            if (snapshot.uiState.complete && isCurrentHistorySelection(key)) {
                // Discovery/metadata paths can start the ordinary lane before
                // this asynchronous cache read finishes. Re-run the same
                // complete-cache fence so an in-flight stale snapshot is
                // quarantined as soon as the durable baseline is known.
                withContext(Dispatchers.Main.immediate) {
                    maybeRequestHistorySync(conversationId)
                }
            }
            scheduleMediaPrefetch(snapshot.messages, generation)
        }
    }

    private fun handleThreadReadResponse(result: Any?) {
        val thread = extractThreadResult(result) ?: run {
            clearThreadHistoryAction()
            return
        }
        val threadId = normalizeThreadId(thread.optStringOrNullCompat("id")).orEmpty()
        if (shouldSuppressExplicitHistorySessionEvent(
                pendingHistoryResumeThreadId = pendingHistoryResumeHydrationThreadId,
                pinnedConversationId = pinnedIpcConversationId,
                activeConversationId = _uiState.value.activeConversationId,
                incomingConversationId = threadId
            )) {
            Log.w(
                TAG,
                "[history][selection-protected] ignoring stale thread/read " +
                    "incoming=$threadId target=${pendingHistoryResumeHydrationThreadId.orEmpty()}"
            )
            return
        }
        val currentThreadId = _uiState.value.threadId
        if (!shouldApplyCanonicalThreadReadResponse(currentThreadId, threadId)) {
            Log.w(
                TAG,
                "[thread/read][stale-response] ignored incomingThreadId=$threadId " +
                    "currentThreadId=${currentThreadId.orEmpty()}"
            )
            return
        }
        val ipcAuthoritativeAtResponse = authorityModeForState(
            _uiState.value,
            threadId
        ) == IpcAuthorityMode.IPC_AUTHORITATIVE
        val threadTitle = resolveThreadTitle(thread)
        val turns = thread.optJSONArray("turns")
        val latestTurn = latestCanonicalTurn(turns)
        val latestTurnId = latestTurn?.optStringOrNullCompat("id")
        val latestTurnStatus = latestTurn?.optStringOrNullCompat("status")
        val threadStatus = canonicalThreadStatusType(thread)
        val latestAgentPhase = latestCanonicalAgentPhase(latestTurn)
        val hasActiveItem = canonicalTurnHasActiveItem(latestTurn)
        val nowElapsed = SystemClock.elapsedRealtime()
        val canonicalFingerprint = latestTurn?.toString()?.hashCode()
        val normalizedReadThreadId = normalizeThreadId(threadId)
        val canonicalSnapshotChanged = if (ipcAuthoritativeAtResponse) {
            false
        } else if (canonicalActivityThreadId != normalizedReadThreadId) {
            canonicalActivityThreadId = normalizedReadThreadId
            canonicalLatestTurnFingerprint = canonicalFingerprint
            lastCanonicalActivityAtElapsed = if (
                canonicalAgentPhaseIndicatesActivity(latestAgentPhase)
            ) {
                nowElapsed
            } else {
                0L
            }
            false
        } else {
            val changed = canonicalLatestTurnFingerprint != null &&
                canonicalFingerprint != null &&
                canonicalLatestTurnFingerprint != canonicalFingerprint
            canonicalLatestTurnFingerprint = canonicalFingerprint
            if (changed) lastCanonicalActivityAtElapsed = nowElapsed
            changed
        }
        if (!ipcAuthoritativeAtResponse &&
            (latestAgentPhase.equals("final_answer", ignoreCase = true) ||
                latestAgentPhase.equals("final", ignoreCase = true))) {
            lastCanonicalActivityAtElapsed = 0L
        }
        val millisSinceCanonicalChange = if (lastCanonicalActivityAtElapsed > 0L) {
            (nowElapsed - lastCanonicalActivityAtElapsed).coerceAtLeast(0L)
        } else {
            Long.MAX_VALUE
        }
        val hasTurns = turns != null
        val messages = if (hasTurns) {
            parseThreadTurns(turns)
        } else {
            parseThreadMessages(thread.optJSONArray("messages"))
        }
        val hasMessages = hasTurns || thread.optJSONArray("messages") != null
        val resolvesHistoryResumeHydration = threadId.isNotEmpty() &&
            threadId == pendingHistoryResumeHydrationThreadId
        clearPendingThreadResync(threadId)
        clearPendingLaunchHydrate(threadId)
        _uiState.update { state ->
            val ipcAuthoritative = authorityModeForState(
                state,
                threadId
            ) == IpcAuthorityMode.IPC_AUTHORITATIVE
            val completesHistoryResume = hasMessages &&
                state.threadHistoryActionKind == "resume" &&
                (state.threadHistoryActionThreadId.isBlank() || state.threadHistoryActionThreadId == threadId)
            val transition = if (hasMessages && ipcAuthoritative) {
                ThreadReadMergeTransition(
                    threadId = threadId.ifEmpty { state.threadId },
                    currentTurnId = state.currentTurnId,
                    messages = mergeCanonicalStaticMetadataIntoAuthoritativeMessages(
                        authoritativeMessages = state.messages,
                        canonicalMessages = messages
                    )
                )
            } else if (hasMessages) {
                buildThreadReadMergeTransition(
                    incomingThreadId = threadId,
                    canonicalMessages = messages,
                    state = state
                )
            } else {
                ThreadReadMergeTransition(
                    threadId = threadId.ifEmpty { state.threadId },
                    currentTurnId = state.currentTurnId,
                    messages = state.messages
                )
            }
            val matchingOwnerSurfaceAvailable = ipcAuthoritative
            val runtimeProjection = projectCanonicalTurnRuntime(
                threadStatus = threadStatus,
                turnStatus = latestTurnStatus,
                turnId = latestTurnId,
                matchingOwnerSurfaceAvailable = matchingOwnerSurfaceAvailable,
                hasActiveItem = hasActiveItem,
                latestAgentPhase = latestAgentPhase,
                canonicalSnapshotChanged = canonicalSnapshotChanged,
                millisSinceCanonicalChange = millisSinceCanonicalChange,
                activityWindowMillis = CANONICAL_ACTIVITY_WINDOW_MILLIS
            )
            state.copy(
                threadId = transition.threadId,
                awaitingNewThreadIpcSurface = if (resolvesHistoryResumeHydration) {
                    false
                } else {
                    state.awaitingNewThreadIpcSurface
                },
                status = runtimeProjection?.status ?: state.status,
                currentTurnId = if (runtimeProjection != null) {
                    runtimeProjection.currentTurnId
                } else {
                    transition.currentTurnId
                },
                currentThreadTitle = threadTitle.ifBlank {
                    resolveCurrentThreadTitle(
                        threadId = transition.threadId,
                        entries = state.threadHistoryEntries,
                        fallback = state.currentThreadTitle
                    )
                },
                messages = transition.messages,
                runtimePanel = when {
                    ipcAuthoritative -> state.runtimePanel
                    hasTurns -> buildRuntimePanelStateFromTurns(
                        turns = turns,
                        visible = state.runtimePanel.visible
                    )
                    hasMessages -> buildEmptyRuntimePanelState(visible = state.runtimePanel.visible)
                    else -> state.runtimePanel
                },
                noticesPanel = when {
                    ipcAuthoritative -> state.noticesPanel
                    hasTurns -> buildNoticesPanelStateFromTurns(
                        turns = turns,
                        visible = state.noticesPanel.visible
                    )
                    hasMessages -> CodexNoticesPanelState(visible = state.noticesPanel.visible)
                    else -> state.noticesPanel
                },
                threadHistorySheetVisible = if (completesHistoryResume) false else state.threadHistorySheetVisible,
                threadHistoryActionThreadId = if (completesHistoryResume) "" else state.threadHistoryActionThreadId,
                threadHistoryActionKind = if (completesHistoryResume) "" else state.threadHistoryActionKind,
                threadRenameTargetId = if (completesHistoryResume) "" else state.threadRenameTargetId,
                threadRenameDraft = if (completesHistoryResume) "" else state.threadRenameDraft
            )
        }
        val appliedState = _uiState.value
        val matchingOwnerSurfaceAvailable =
            authorityModeForState(appliedState, threadId) == IpcAuthorityMode.IPC_AUTHORITATIVE
        val runtimeProjection = projectCanonicalTurnRuntime(
            threadStatus = threadStatus,
            turnStatus = latestTurnStatus,
            turnId = latestTurnId,
            matchingOwnerSurfaceAvailable = matchingOwnerSurfaceAvailable,
            hasActiveItem = hasActiveItem,
            latestAgentPhase = latestAgentPhase,
            canonicalSnapshotChanged = canonicalSnapshotChanged,
            millisSinceCanonicalChange = millisSinceCanonicalChange,
            activityWindowMillis = CANONICAL_ACTIVITY_WINDOW_MILLIS
        )
        Log.i(
            TAG,
            "[runtime][thread-read] threadId=$threadId latestTurnId=${latestTurnId.orEmpty()} " +
                "threadStatus=${threadStatus.orEmpty()} latestTurnStatus=${latestTurnStatus.orEmpty()} " +
                "latestAgentPhase=${latestAgentPhase.orEmpty()} activeItem=$hasActiveItem " +
                "snapshotChanged=$canonicalSnapshotChanged millisSinceChange=$millisSinceCanonicalChange " +
                "matchingOwnerSurface=$matchingOwnerSurfaceAvailable " +
                "projectedStatus=${runtimeProjection?.status ?: "preserved"} " +
                "source=${runtimeProjection?.source ?: "preserved"}"
        )
        if (resolvesHistoryResumeHydration) {
            pendingHistoryResumeHydrationThreadId = null
            cancelHistoryResumeProtection()
        }
        if (thread.has("tokenUsage")) {
            applyTokenUsagePayload(thread.opt("tokenUsage"))
        }
    }

    private fun normalizeThreadId(threadId: String?): String? {
        return normalizeCodexThreadId(threadId)
    }

    private fun shouldPreserveLocalMessageTail(
        threadId: String?,
        state: CodexUiState,
        allowThreadIdSwitch: Boolean = false
    ): Boolean {
        // Snapshot can arrive before turn ack. Keep the optimistic user tail
        // until the canonical thread state catches up so the sent message
        // does not disappear mid-turn.
        return shouldPreserveLocalMessageTailForUi(
            threadId = threadId,
            state = state,
            allowThreadIdSwitch = allowThreadIdSwitch
        )
    }

    private fun mergeCanonicalMessages(
        canonicalMessages: List<ChatMessage>,
        currentMessages: List<ChatMessage>,
        preserveLocalTail: Boolean
    ): List<ChatMessage> {
        return mergeCanonicalMessagesForUi(
            canonicalMessages = canonicalMessages,
            currentMessages = currentMessages,
            preserveLocalTail = preserveLocalTail
        )
    }

    private fun mergeCanonicalUserMessageMetadata(
        canonical: ChatMessage,
        local: ChatMessage
    ): ChatMessage {
        return mergeCanonicalUserMessageMetadataForUi(canonical, local)
    }

    private fun shouldPreserveTailMessage(message: ChatMessage): Boolean {
        return shouldPreserveCodexTailMessage(message)
    }

    private fun messagesEquivalentForConvergence(
        left: ChatMessage,
        right: ChatMessage
    ): Boolean = messagesEquivalentForConvergenceForUi(left, right)

    private fun messageConvergenceKey(message: ChatMessage): String = messageConvergenceKeyForUi(message)

    private fun markPendingThreadResyncIfNeeded(state: CodexUiState) {
        val threadId = normalizeThreadId(state.threadId) ?: return
        val shouldResync = !state.currentTurnId.isNullOrBlank() ||
            state.status.equals("running", ignoreCase = true) ||
            state.executionWatch.active
        if (!shouldResync) {
            return
        }
        pendingThreadResyncThreadId = threadId
        if (threadResyncInFlightThreadId != threadId) {
            threadResyncInFlightThreadId = null
        }
    }

    private fun clearPendingThreadResync(threadId: String? = null) {
        val normalized = normalizeThreadId(threadId)
        if (normalized == null) {
            pendingThreadResyncThreadId = null
            threadResyncInFlightThreadId = null
            return
        }
        if (pendingThreadResyncThreadId == normalized) {
            pendingThreadResyncThreadId = null
        }
        if (threadResyncInFlightThreadId == normalized) {
            threadResyncInFlightThreadId = null
        }
    }

    private fun shouldAllowOptimisticTailAcrossThreadSwitch(
        stateThreadId: String?,
        incomingThreadId: String?
    ): Boolean {
        val pendingSourceThreadId = normalizeThreadId(pendingOptimisticNewThreadSourceThreadId)
            ?: return false
        val normalizedStateThreadId = normalizeThreadId(stateThreadId)
        val normalizedIncomingThreadId = normalizeThreadId(incomingThreadId)
        return normalizedStateThreadId == pendingSourceThreadId &&
            normalizedIncomingThreadId != null &&
            normalizedIncomingThreadId != pendingSourceThreadId
    }

    private fun clearPendingOptimisticNewThreadTransition() {
        pendingOptimisticNewThreadSourceThreadId = null
    }

    private fun clearPendingOptimisticNewThreadTransitionIfResolved(observedThreadId: String?) {
        val pendingSourceThreadId = normalizeThreadId(pendingOptimisticNewThreadSourceThreadId)
            ?: return
        val normalizedObservedThreadId = normalizeThreadId(observedThreadId) ?: return
        if (normalizedObservedThreadId != pendingSourceThreadId) {
            pendingOptimisticNewThreadSourceThreadId = null
        }
    }

    private fun maybeRequestPendingThreadResync(
        threadId: String?,
        status: String?,
        currentTurnId: String?
    ) {
        val normalizedThreadId = normalizeThreadId(threadId) ?: return
        if (pendingThreadResyncThreadId != normalizedThreadId) {
            return
        }
        if (!currentTurnId.isNullOrBlank()) {
            return
        }
        if (!status.equals("idle", ignoreCase = true)) {
            return
        }
        if (threadResyncInFlightThreadId == normalizedThreadId) {
            return
        }
        runForegroundRecoveryTick(SystemClock.elapsedRealtime())
    }

    private fun maybeRequestLaunchHydrate(observedThreadId: String?) {
        val targetThreadId = resolveLaunchHydrateThreadRequest(
            pendingLaunchHydrate = launchHydratePending,
            requestedThreadId = launchHydrateTargetThreadId,
            observedThreadId = observedThreadId,
            inFlightThreadId = launchHydrateInFlightThreadId
        ) ?: return
        if (normalizeThreadId(_uiState.value.threadId) != targetThreadId) return
        runForegroundRecoveryTick(SystemClock.elapsedRealtime())
    }

    private fun clearPendingLaunchHydrate(threadId: String? = null) {
        val normalizedThreadId = normalizeThreadId(threadId)
        if (normalizedThreadId == null) {
            launchHydratePending = false
            launchHydrateTargetThreadId = null
            launchHydrateInFlightThreadId = null
            return
        }
        val targetThreadId = normalizeThreadId(launchHydrateTargetThreadId)
        val inFlightThreadId = normalizeThreadId(launchHydrateInFlightThreadId)
        if (targetThreadId == null || targetThreadId == normalizedThreadId || inFlightThreadId == normalizedThreadId) {
            launchHydratePending = false
            launchHydrateTargetThreadId = normalizedThreadId
            launchHydrateInFlightThreadId = null
        }
    }

    private fun scheduleCanonicalThreadRead(
        threadId: String?,
        delayMillis: Long = 250L
    ) {
        val normalizedThreadId = normalizeThreadId(threadId) ?: return
        viewModelScope.launch {
            delay(delayMillis)
            val state = _uiState.value
            if (!state.currentTurnId.isNullOrBlank()) {
                return@launch
            }
            if (normalizeThreadId(state.threadId) != normalizedThreadId) {
                return@launch
            }
            runForegroundRecoveryTick(SystemClock.elapsedRealtime())
        }
    }

    private fun handleThreadMutationResponse(method: String, result: Any?) {
        val nextThreadId = extractThreadResult(result)?.optStringOrNullCompat("id").orEmpty()
        val renamedTitle = if (method == "thread/name/set") {
            _uiState.value.threadRenameDraft.trim()
        } else {
            ""
        }
        _uiState.update { state ->
            val updatedEntries = when {
                method == "thread/name/set" && state.threadRenameTargetId.isNotBlank() && renamedTitle.isNotBlank() ->
                    state.threadHistoryEntries.map { entry ->
                        if (entry.id == state.threadRenameTargetId) {
                            entry.copy(title = renamedTitle)
                        } else {
                            entry
                        }
                    }
                else -> state.threadHistoryEntries
            }
            state.copy(
                currentThreadTitle = when {
                    method == "thread/name/set" &&
                        state.threadRenameTargetId.isNotBlank() &&
                        state.threadId == state.threadRenameTargetId &&
                        renamedTitle.isNotBlank() -> renamedTitle
                    method == "thread/fork" && nextThreadId.isNotBlank() -> state.currentThreadTitle
                    else -> state.currentThreadTitle
                },
                threadHistoryEntries = updatedEntries,
                threadHistoryActionThreadId = "",
                threadHistoryActionKind = "",
                threadRenameTargetId = "",
                threadRenameDraft = ""
            )
        }
        refreshThreadHistory()
    }

    private fun clearThreadHistoryAction() {
        _uiState.update {
            it.copy(
                threadHistoryActionThreadId = "",
                threadHistoryActionKind = "",
                threadHistoryLoading = false
            )
        }
    }

    private fun toUiThreadHistoryEntry(entry: CodexThreadIndexEntry): CodexThreadHistoryEntry =
        CodexThreadHistoryEntry(
            id = entry.conversationId,
            title = entry.title.ifBlank { entry.preview ?: entry.conversationId },
            archived = entry.archived,
            lastActiveAt = entry.lastActiveAt,
            createdAt = entry.createdAt,
            goalObjective = entry.goalObjective,
            preview = entry.preview,
            cwd = entry.cwd
        )

    private fun mergeThreadHistoryEntries(
        cached: List<CodexThreadHistoryEntry>,
        remote: List<CodexThreadHistoryEntry>
    ): List<CodexThreadHistoryEntry> {
        val merged = LinkedHashMap<String, CodexThreadHistoryEntry>()
        cached.forEach { entry -> merged[entry.id] = entry }
        remote.forEach { entry ->
            merged[entry.id] = mergeThreadHistoryEntry(merged[entry.id], entry)
        }
        return merged.values.sortedWith(
            compareByDescending<CodexThreadHistoryEntry> { it.lastActiveAt ?: Long.MIN_VALUE }
                .thenByDescending { it.createdAt ?: Long.MIN_VALUE }
                .thenBy { it.id }
        )
    }

    private fun mergeThreadHistoryEntry(
        cached: CodexThreadHistoryEntry?,
        remote: CodexThreadHistoryEntry
    ): CodexThreadHistoryEntry {
        if (cached == null) return remote
        val remoteTitleIsOnlyId = remote.title == remote.id
        return remote.copy(
            title = if (remoteTitleIsOnlyId && cached.title != cached.id) cached.title else remote.title,
            preview = remote.preview ?: cached.preview,
            cwd = remote.cwd ?: cached.cwd,
            goalObjective = remote.goalObjective ?: cached.goalObjective,
            createdAt = remote.createdAt ?: cached.createdAt,
            lastActiveAt = remote.lastActiveAt ?: cached.lastActiveAt
        )
    }

    private fun parseThreadHistoryEntries(result: Any?): List<CodexThreadHistoryEntry> {
        val source = when (result) {
            is JSONArray -> result
            is JSONObject -> result.optJSONArray("data") ?: result.optJSONArray("threads")
            else -> null
        } ?: return emptyList()
        val entries = mutableListOf<CodexThreadHistoryEntry>()
        for (index in 0 until source.length()) {
            val item = source.optJSONObject(index) ?: continue
            val threadId = item.optStringOrNullCompat("id").orEmpty()
            if (threadId.isEmpty()) continue
            entries.add(
                CodexThreadHistoryEntry(
                    id = threadId,
                    title = resolveCodexThreadHistoryTitleForUi(item).ifBlank { threadId },
                    archived = item.optBoolean("archived", item.optBoolean("isArchived", false)),
                    lastActiveAt = normalizeHistoryTimestamp(
                        item.opt("lastActiveAt")
                            ?: item.opt("last_active_at")
                            ?: item.opt("updatedAt")
                            ?: item.opt("updated_at")
                            ?: item.opt("lastUpdatedAt")
                            ?: item.opt("last_updated_at")
                            ?: item.opt("lastMessageAt")
                            ?: item.opt("last_message_at")
                            ?: item.opt("modifiedAt")
                            ?: item.opt("modified_at")
                            ?: item.opt("mtime")
                    ),
                    createdAt = normalizeHistoryTimestamp(
                        item.opt("createdAt")
                            ?: item.opt("created_at")
                            ?: item.opt("created")
                    ),
                    goalObjective = null,
                    preview = resolveCodexThreadHistoryPreviewForCache(item),
                    cwd = item.optStringOrNullCompat("cwd")
                )
            )
        }
        return mergeGoalHistoryEntries(entries).sortedWith(
            compareByDescending<CodexThreadHistoryEntry> { entry -> entry.lastActiveAt ?: Long.MIN_VALUE }
                .thenByDescending { entry -> entry.createdAt ?: Long.MIN_VALUE }
                .thenBy { entry -> entry.id }
        )
    }

    private fun extractThreadResult(result: Any?): JSONObject? {
        return when (result) {
            is JSONObject -> result.optJSONObject("thread") ?: result.takeIf { it.has("id") }
            else -> null
        }
    }

    private fun resolveThreadTitle(thread: JSONObject?): String {
        thread ?: return ""
        return thread.optStringOrNullCompat("title")
            ?: thread.optStringOrNullCompat("name")
            ?: ""
    }

    private fun resolveCurrentThreadTitle(
        threadId: String?,
        entries: List<CodexThreadHistoryEntry>,
        fallback: String
    ): String {
        val normalizedThreadId = threadId?.trim().orEmpty()
        if (normalizedThreadId.isEmpty()) return ""
        return entries.firstOrNull { it.id == normalizedThreadId }?.title
            ?.takeIf { it.isNotBlank() }
            ?: fallback
    }

    private fun parseThreadMessages(messages: JSONArray?): List<ChatMessage> {
        val snapshot = CodexThreadSnapshot(
            threadId = normalizeThreadId(_uiState.value.threadId).orEmpty(),
            messages = messages ?: JSONArray()
        )
        return parseSnapshotMessages(snapshot)
    }

    private fun parseThreadTurns(turns: JSONArray?): List<ChatMessage> {
        if (turns == null) {
            return emptyList()
        }
        val result = mutableListOf<ChatMessage>()
        val collapsibleTurnIds = mutableSetOf<String>()
        for (turnIndex in 0 until turns.length()) {
            val turn = turns.optJSONObject(turnIndex) ?: continue
            val items = turn.optJSONArray("items") ?: continue
            val turnId = turn.optStringOrNullCompat("id")
                ?: turn.optStringOrNullCompat("turnId")
            if (isTerminalTurnStatusForUi(turn.optStringOrNullCompat("status"))) {
                turnId?.takeIf { it.isNotBlank() }?.let(collapsibleTurnIds::add)
            }
            for (itemIndex in 0 until items.length()) {
                val item = items.optJSONObject(itemIndex) ?: continue
                when (item.optString("type", "")) {
                    "userMessage" -> {
                        val text = extractUserMessageText(item)
                        val fileMentions = extractUserMessageFileMentions(
                            content = item.optJSONArray("content"),
                            fallbackText = text
                        )
                        val skills = extractUserMessageSkills(
                            content = item.optJSONArray("content"),
                            fallbackText = text
                        )
                        val attachments = extractUserMessageAttachments(
                            content = item.optJSONArray("content"),
                            fallbackText = text
                        )
                        val activeSkill = skills.firstOrNull()?.name
                        val visibleText = buildVisibleUserMessageText(text)
                        if (visibleText.isNotEmpty() || fileMentions.isNotEmpty() || skills.isNotEmpty() || attachments.isNotEmpty()) {
                            result.add(
                                ChatMessage(
                                    id = item.optString("id", UUID.randomUUID().toString()),
                                    role = ChatMessage.Role.USER,
                                    content = visibleText,
                                    fileMentions = fileMentions,
                                    activeSkill = activeSkill,
                                    skills = skills,
                                    attachments = attachments
                                )
                            )
                        }
                    }
                    "agentMessage" -> {
                        if (isRuntimeOnlyAgentMessage(item)) {
                            continue
                        }
                        result.add(
                            ChatMessage(
                                id = item.optString("id", UUID.randomUUID().toString()),
                                role = ChatMessage.Role.ASSISTANT,
                                content = item.optString("text", "")
                            )
                        )
                    }
                    "commandExecution", "fileChange", "mcpToolCall" -> {
                        canonicalOperationMessageForUi(
                            item = item,
                            turnId = turnId,
                            itemIndex = itemIndex
                        )?.let(result::add)
                    }
                    "imageView" -> {
                        canonicalImageViewMessageForUi(
                            item = item,
                            turnId = turnId,
                            itemIndex = itemIndex
                        )?.let(result::add)
                    }
                }
                maybeRequestModelList()
            }
        }
        return collapseCompletedCommandBatchesForUi(result, collapsibleTurnIds)
    }

    private fun goalHistoryKey(threadId: String?): String? =
        rememberedTaskConfigKey(currentProfile?.id, threadId)

    private fun rememberGoalHistory(threadId: String?, objective: String) {
        val key = goalHistoryKey(threadId) ?: return
        val normalizedObjective = objective.trim().takeIf { it.isNotEmpty() } ?: return
        goalHistoryStore.edit().putString(key, normalizedObjective).apply()
    }

    private fun mergeGoalHistoryEntries(
        entries: List<CodexThreadHistoryEntry>
    ): List<CodexThreadHistoryEntry> = entries.map { entry ->
        if (!entry.goalObjective.isNullOrBlank()) {
            entry
        } else {
            entry.copy(
                goalObjective = goalHistoryKey(entry.id)?.let { key ->
                    goalHistoryStore.getString(key, null)
                }
            )
        }
    }

    private fun isTerminalTurnStatusForUi(status: String?): Boolean =
        status?.trim()?.lowercase() in setOf(
            "completed", "complete", "done", "finished", "failed", "error",
            "cancelled", "canceled", "interrupted"
        )

    private fun extractUserMessageText(item: JSONObject): String {
        // Codex may expose user content as a structured array in both
        // thread/read turns and the legacy messages shape.  Keep this path
        // identical to the history-cache decoder so the same item cannot be
        // rendered as a JSON array in one recovery mode and as text in
        // another.
        return extractHistoryPayloadTextForUi(item)
    }

    private fun extractUserMessageFileMentions(
        content: JSONArray?,
        fallbackText: String = ""
    ): List<FileMention> {
        val structured = mutableListOf<FileMention>()
        content?.let { parts ->
            for (index in 0 until parts.length()) {
                val part = parts.optJSONObject(index) ?: continue
                val type = part.optString("type", "")
                if (type in setOf("mention", "fileMention", "file_mention", "file")) {
                    val path = part.optStringOrNullCompat("path")
                        ?: part.optStringOrNullCompat("filePath")
                        ?: continue
                    structured += buildFileMentionFromPath(
                        path = path,
                        labelOverride = part.optStringOrNullCompat("label")
                            ?: part.optStringOrNullCompat("displayName")
                    )
                }
            }
        }
        return if (structured.isNotEmpty()) {
            structured.distinctBy { it.path }
        } else {
            extractLeadingFileMentions(CodexSlashRegistry.stripSkillTokens(fallbackText))
        }
    }

    private fun extractUserMessageActiveSkill(content: JSONArray?): String? {
        content ?: return null
        for (index in 0 until content.length()) {
            val part = content.optJSONObject(index) ?: continue
            if (part.optString("type", "") == "skill") {
                val skillName = part.optStringOrNullCompat("name")
                    ?: part.optStringOrNullCompat("toolName")
                if (!skillName.isNullOrBlank()) {
                    return skillName
                }
            }
        }
        return null
    }

    private fun extractUserMessageSkills(
        content: JSONArray?,
        fallbackText: String = ""
    ): List<CodexSkillReference> {
        val structured = mutableListOf<CodexSkillReference>()
        content?.let { parts ->
            for (index in 0 until parts.length()) {
                val part = parts.optJSONObject(index) ?: continue
                if (part.optString("type", "") == "skill") {
                    val skillName = part.optStringOrNullCompat("name")
                        ?: part.optStringOrNullCompat("toolName")
                        ?: continue
                    structured += CodexSkillReference(
                        name = skillName,
                        path = part.optStringOrNullCompat("path")
                    )
                }
            }
        }
        val tokenSkills = extractSkillReferencesFromText(fallbackText)
        return (structured + tokenSkills).distinctBy { skill ->
            "${skill.name.trim().lowercase()}::${skill.path.orEmpty().trim().lowercase()}"
        }
    }

    private fun extractUserMessageAttachments(
        content: JSONArray?,
        fallbackText: String = ""
    ): List<CodexMessageAttachment> {
        val structured = mutableListOf<CodexMessageAttachment>()
        content?.let { parts ->
            for (index in 0 until parts.length()) {
                val part = parts.optJSONObject(index) ?: continue
                when (part.optString("type", "")) {
                    "image", "image_url", "input_image" -> {
                        val url = part.optStringOrNullCompat("url")
                            ?: part.optStringOrNullCompat("imageUrl")
                            ?: continue
                        structured += CodexMessageAttachment(
                            kind = "image",
                            label = buildAttachmentLabel(
                                preferred = part.optStringOrNullCompat("label")
                                    ?: part.optStringOrNullCompat("name"),
                                fallbackPath = url
                            ),
                            url = url,
                            source = "remote"
                        )
                    }
                    "localImage" -> {
                        val path = part.optStringOrNullCompat("path")
                            ?: part.optStringOrNullCompat("url")
                            ?: continue
                        structured += CodexMessageAttachment(
                            kind = "image",
                            label = buildAttachmentLabel(
                                preferred = part.optStringOrNullCompat("label")
                                    ?: part.optStringOrNullCompat("name"),
                                fallbackPath = path
                            ),
                            path = path,
                            source = "local",
                            dedupeKey = buildAttachmentDedupeKey(path)
                        )
                    }
                }
            }
        }
        return if (structured.isNotEmpty()) {
            structured.distinctBy { attachment ->
                listOf(
                    attachment.kind.trim().lowercase(),
                    attachment.path.orEmpty().trim().lowercase(),
                    attachment.url.orEmpty().trim().lowercase(),
                    attachment.label.trim().lowercase()
                ).joinToString("::")
            }
        } else {
            extractAttachmentSummaryLines(fallbackText)
        }
    }

    private fun extractLeadingFileMentions(text: String): List<FileMention> {
        val result = mutableListOf<FileMention>()
        val trimmed = text.trimStart()
        if (trimmed.isBlank()) {
            return emptyList()
        }
        for (line in trimmed.lineSequence()) {
            val normalized = line.trim()
            if (!normalized.startsWith("@")) {
                break
            }
            val path = normalized.removePrefix("@").trim()
            if (path.isBlank()) {
                break
            }
            result += buildFileMentionFromPath(path)
        }
        return result.distinctBy { it.path }
    }

    private fun stripLeadingMentionLines(text: String): String {
        if (text.isBlank()) {
            return ""
        }
        val lines = text.lines()
        var index = 0
        while (index < lines.size) {
            val normalized = lines[index].trim()
            if (!normalized.startsWith("@")) {
                break
            }
            val path = normalized.removePrefix("@").trim()
            if (path.isBlank()) {
                break
            }
            index += 1
        }
        return lines.drop(index).joinToString("\n").trim()
    }

    private fun buildFileMentionFromPath(path: String, labelOverride: String? = null): FileMention {
        val normalizedPath = path.trim()
        val sanitized = normalizedPath.trimEnd('/', '\\')
        val label = labelOverride?.trim()?.takeIf { it.isNotBlank() }
            ?: sanitized.substringAfterLast('/').substringAfterLast('\\').ifBlank { normalizedPath }
        val folder = sanitized
            .substringBeforeLast('/', missingDelimiterValue = sanitized)
            .substringBeforeLast('\\', missingDelimiterValue = sanitized)
            .takeIf { it != sanitized }
            .orEmpty()
        return FileMention(
            label = label,
            path = normalizedPath,
            relativePathWithoutFileName = folder
        )
    }

    private fun normalizeHistoryTimestamp(value: Any?): Long? {
        val numeric = when (value) {
            is Number -> value.toLong()
            is String -> value.trim().toLongOrNull()
            else -> null
        } ?: return null
        return if (numeric in 1..999_999_999_999L) numeric * 1000 else numeric
    }

    private fun findPendingServerRequest(requestId: String): CodexServerRequest? =
        _uiState.value.pendingServerRequests.firstOrNull { it.requestId == requestId }

    private fun isIpcFollowerRequest(request: CodexServerRequest): Boolean =
        request.handledBy.equals("ipc_follower", ignoreCase = true)

    private fun markServerRequestSubmitting(requestId: String) {
        _uiState.update { state ->
            state.copy(submittingServerRequestIds = state.submittingServerRequestIds + requestId)
        }
    }

    private fun buildApprovalDecisionResult(
        request: CodexServerRequest,
        approved: Boolean
    ): JSONObject? = buildDirectApprovalDecisionResult(request, approved)

    private fun buildUserInputResult(
        request: CodexServerRequest,
        answersByQuestionId: Map<String, String>
    ): JSONObject? {
        if (request.responseMode != "answers") {
            return null
        }
        val answers = JSONObject()
        request.questions.forEach { question ->
            val answer = answersByQuestionId[question.id]?.trim().orEmpty()
            if (answer.isEmpty()) {
                return null
            }
            answers.put(
                question.id,
                JSONObject().put("answers", org.json.JSONArray().put(answer))
            )
        }
        return JSONObject().put("answers", answers)
    }

    private fun isDebugServerRequest(requestId: String): Boolean =
        requestId.startsWith(DEBUG_REQUEST_PREFIX)

    private fun completeDebugServerRequest(
        requestId: String,
        result: JSONObject? = null,
        error: JSONObject? = null
    ) {
        _uiState.update { state ->
            state.copy(
                pendingServerRequests = state.pendingServerRequests.filterNot { it.requestId == requestId },
                submittingServerRequestIds = state.submittingServerRequestIds - requestId
            )
        }
        val payload = when {
            result != null -> JSONObject().put("result", result)
            error != null -> JSONObject().put("error", error)
            else -> JSONObject().put("useDefault", true)
        }
        appendMessage(ChatMessage.Role.SYSTEM, "[debug] Simulated server request response: ${payload}")
    }

    private fun buildDebugServerRequest(preset: DebugServerRequestPreset): CodexServerRequest {
        val requestId = "$DEBUG_REQUEST_PREFIX${preset.name.lowercase()}-${UUID.randomUUID()}"
        return when (preset) {
            DebugServerRequestPreset.RUNTIME_SAMPLE -> error("Runtime sample is injected directly and is not a server request.")
            DebugServerRequestPreset.COMMAND_APPROVAL -> CodexServerRequest(
                requestId = requestId,
                method = "item/commandExecution/requestApproval",
                requestKind = "command",
                responseMode = "decision",
                handledBy = "client",
                summary = "Debug sample: approve or reject this command before continuing.",
                questionCount = 0,
                command = "git --no-pager status --short",
                questions = emptyList(),
                params = JSONObject().put("command", "git --no-pager status --short"),
                defaultResult = null
            )

            DebugServerRequestPreset.FILE_APPROVAL -> CodexServerRequest(
                requestId = requestId,
                method = "item/fileChange/requestApproval",
                requestKind = "file",
                responseMode = "decision",
                handledBy = "client",
                summary = "Debug sample: review a pending file change request.",
                questionCount = 0,
                command = null,
                questions = emptyList(),
                params = JSONObject()
                    .put("path", "docs/debug-approval-sample.txt")
                    .put("action", "write"),
                defaultResult = null
            )

            DebugServerRequestPreset.PATCH_APPROVAL -> CodexServerRequest(
                requestId = requestId,
                method = "applyPatchApproval",
                requestKind = "patch",
                responseMode = "decision",
                handledBy = "client",
                summary = "Debug sample: approve or reject a patch-style request.",
                questionCount = 0,
                command = null,
                questions = emptyList(),
                params = JSONObject()
                    .put(
                        "patch",
                        "*** Begin Patch\n*** Add File: debug-sample.txt\n+hello from debug injector\n*** End Patch\n"
                    ),
                defaultResult = null
            )

            DebugServerRequestPreset.AUTO_HANDLED -> CodexServerRequest(
                requestId = requestId,
                method = "item/commandExecution/requestApproval",
                requestKind = "command",
                responseMode = "decision",
                handledBy = "server",
                summary = "Debug sample: this request is auto-handled by the server and should surface as a system message.",
                questionCount = 0,
                command = "git --no-pager diff --stat",
                questions = emptyList(),
                params = JSONObject().put("command", "git --no-pager diff --stat"),
                defaultResult = null
            )

            DebugServerRequestPreset.USER_INPUT_OPTIONS -> CodexServerRequest(
                requestId = requestId,
                method = "item/tool/requestUserInput",
                requestKind = "userInput",
                responseMode = "answers",
                handledBy = "client",
                summary = "Debug sample: answer a multiple-choice follow-up question.",
                questionCount = 1,
                command = null,
                questions = listOf(
                    CodexServerRequestQuestion(
                        id = "debug-mode",
                        question = "Which mode should I use for this debug run?",
                        options = listOf(
                            CodexServerRequestOption("Apple (Recommended)"),
                            CodexServerRequestOption("Banana")
                        ),
                        allowFreeform = true
                    )
                ),
                params = JSONObject()
                    .put(
                        "questions",
                        JSONArray().put(
                            JSONObject()
                                .put("id", "debug-mode")
                                .put("question", "Which mode should I use for this debug run?")
                                .put(
                                    "options",
                                    JSONArray()
                                        .put(JSONObject().put("label", "Apple (Recommended)"))
                                        .put(JSONObject().put("label", "Banana"))
                                )
                                .put("allow_freeform", true)
                        )
                    ),
                defaultResult = null
            )

            DebugServerRequestPreset.USER_INPUT_FREEFORM -> CodexServerRequest(
                requestId = requestId,
                method = "item/tool/requestUserInput",
                requestKind = "userInput",
                responseMode = "answers",
                handledBy = "client",
                summary = "Debug sample: answer a pure freeform follow-up question.",
                questionCount = 1,
                command = null,
                questions = listOf(
                    CodexServerRequestQuestion(
                        id = "debug-reason",
                        question = "Describe why this patch should be applied.",
                        options = emptyList(),
                        allowFreeform = true
                    )
                ),
                params = JSONObject()
                    .put(
                        "questions",
                        JSONArray().put(
                            JSONObject()
                                .put("id", "debug-reason")
                                .put("question", "Describe why this patch should be applied.")
                                .put("allow_freeform", true)
                        )
                    ),
                defaultResult = null
            )
        }
    }

    private fun handleCodexNotification(notification: CodexNotification) {
        val params = notification.params
        if (shouldTraceNotificationMethod(notification.method)) {
            logNotificationTrace(
                stage = "in",
                message = "method=${notification.method} turnId=${extractTraceTurnId(params)} itemId=${extractTraceItemId(params)} currentStreaming=$currentStreamingMessageId"
            )
        }
        when {
            notification.method == "thread/started" -> {
                val threadId = params
                    ?.optJSONObject("thread")
                    ?.optString("id", "")
                    ?.trim()
                    .orEmpty()
                val startedThreadId = normalizeThreadId(threadId)
                if (!startedThreadId.isNullOrEmpty()) {
                    currentStreamingMessageId = null
                    currentPlanStreamingMessageId = null
                    _uiState.update {
                        val allowThreadIdSwitch = shouldAllowOptimisticTailAcrossThreadSwitch(
                            stateThreadId = it.threadId,
                            incomingThreadId = startedThreadId
                        )
                        val transition = buildThreadStartedUiTransition(
                            startedThreadId = startedThreadId,
                            state = it,
                            allowThreadIdSwitch = allowThreadIdSwitch
                        )
                        it.copy(
                            threadId = startedThreadId,
                            currentTurnId = transition.currentTurnId,
                            messages = transition.messages,
                            errorMessage = null,
                            runtimePanel = transition.runtimePanel,
                            noticesPanel = if (transition.messages.isEmpty()) {
                                CodexNoticesPanelState()
                            } else {
                                it.noticesPanel
                            },
                            pendingServerRequests = emptyList(),
                            submittingServerRequestIds = emptySet()
                        )
                    }
                }
            }

            notification.method == "thread/status/changed" -> {
                val hadActiveTurn = !_uiState.value.currentTurnId.isNullOrBlank()
                val statusType = params
                    ?.optJSONObject("status")
                    ?.optString("type", "")
                    ?.trim()
                    .orEmpty()
                if (statusType == "idle") {
                    finalizeStreamingMessage()
                    finalizePlanStreamingMessage()
                    _uiState.update {
                        syncExecutionWatch(
                            finalizePlanWorkflowOnTurnSettled(
                                it.copy(currentTurnId = null)
                            ),
                            markActivity = false
                        )
                    }
                    val state = _uiState.value
                    if (hadActiveTurn) {
                        scheduleCanonicalThreadRead(
                            threadId = state.threadId
                        )
                    }
                    maybeRequestPendingThreadResync(
                        threadId = state.threadId,
                        status = state.status,
                        currentTurnId = state.currentTurnId
                    )
                }
            }

            notification.method == "turn/started" -> {
                val turnId = params
                    ?.optJSONObject("turn")
                    ?.optString("id", "")
                    ?.trim()
                    .orEmpty()
                _uiState.update {
                    syncExecutionWatch(
                        it.copy(
                            errorMessage = null,
                            currentTurnId = turnId.ifEmpty { it.currentTurnId }
                        ),
                        markActivity = true
                    )
                }
            }

            notification.method == "turn/completed" -> {
                finalizeStreamingMessage()
                finalizePlanStreamingMessage()
                _uiState.update {
                    syncExecutionWatch(
                        finalizePlanWorkflowOnTurnSettled(
                            it.copy(currentTurnId = null)
                        ),
                        markActivity = true
                    )
                }
                scheduleCanonicalThreadRead(
                    threadId = _uiState.value.threadId
                )
            }

            notification.method == "item/started" -> {
                val item = params?.optJSONObject("item") ?: return
                val itemType = item.optString("type", "")
                if (itemType != "agentMessage") {
                    val itemId = item.optString("id", "").trim()
                    val feedback = buildExecutionFeedback(item, itemType)
                    if (feedback != null && itemId.isNotEmpty()) {
                        appendCollapsibleMessage(itemId, feedback.first, feedback.second)
                    }
                    logNotificationTrace("drop", "item/started non-agent type=$itemType")
                    return
                }
                if (isRuntimeOnlyAgentMessage(item)) {
                    logNotificationTrace("drop", "item/started runtime-only itemId=${item.optString("id", "").trim()}")
                    return
                }
                val itemId = item.optString("id", "").trim().ifEmpty { UUID.randomUUID().toString() }
                currentStreamingMessageId = itemId
                logNotificationTrace("apply", "item/started itemId=$itemId textLen=${item.optString("text", "").length}")
                upsertAssistantMessage(
                    itemId = itemId,
                    content = item.optString("text", ""),
                    streaming = true
                )
            }

            notification.method == "item/agentMessage/delta" -> {
                val itemId = params?.optString("itemId", "")?.trim().orEmpty()
                val delta = params?.optString("delta", "") ?: ""
                if (delta.isEmpty()) {
                    logNotificationTrace("drop", "delta empty itemId=$itemId")
                    return
                }
                val streamId = itemId.ifEmpty { currentStreamingMessageId.orEmpty() }
                if (streamId.isEmpty()) {
                    logNotificationTrace("drop", "delta missing-stream itemId=$itemId currentStreaming=$currentStreamingMessageId")
                    return
                }
                logNotificationTrace("apply", "delta streamId=$streamId deltaLen=${delta.length}")
                appendAssistantDelta(streamId, delta)
            }

            notification.method == "turn/plan/updated" -> {
                val plan = params?.optJSONObject("plan") ?: return
                val planText = plan.optString("text", "")
                val planMessageId = resolvePlanStreamingMessageId(params)
                if (planText.isBlank()) {
                    applyRuntimeNotificationUpdate(notification.method, params)
                    return
                }
                trackPlanWorkflowText(planText)
                if (planMessageId.isNotEmpty()) {
                    currentPlanStreamingMessageId = planMessageId
                    upsertAssistantMessage(
                        itemId = planMessageId,
                        content = planText,
                        streaming = true,
                        trackPlanText = false
                    )
                }
                applyRuntimeNotificationUpdate(notification.method, params)
            }

            notification.method == "item/plan/delta" -> {
                val delta = params?.optString("delta", "") ?: ""
                val planMessageId = resolvePlanStreamingMessageId(params)
                if (delta.isEmpty()) {
                    applyRuntimeNotificationUpdate(notification.method, params)
                    return
                }
                val currentPlanText = getPlanWorkflowDisplayText(_uiState.value)
                trackPlanWorkflowText(
                    text = currentPlanText + delta,
                    preserveWhitespace = true
                )
                if (planMessageId.isNotEmpty()) {
                    currentPlanStreamingMessageId = planMessageId
                    appendAssistantDelta(
                        itemId = planMessageId,
                        delta = delta,
                        trackPlanText = false
                    )
                }
                applyRuntimeNotificationUpdate(notification.method, params)
            }

            notification.method == "item/completed" -> {
                val item = params?.optJSONObject("item") ?: return
                applyRuntimeSnapshotItem(item)
                val itemType = item.optString("type", "")
                if (itemType != "agentMessage") {
                    val itemId = item.optString("id", "").trim()
                    if (itemId.isNotEmpty()) {
                        updateCollapsibleMessageContent(itemId, item, itemType)
                    }
                    logNotificationTrace("drop", "item/completed non-agent type=$itemType")
                    return
                }
                if (isRuntimeOnlyAgentMessage(item)) {
                    logNotificationTrace("drop", "item/completed runtime-only itemId=${item.optString("id", "").trim()}")
                    return
                }
                val itemId = item.optString("id", "").trim().ifEmpty { currentStreamingMessageId.orEmpty() }
                val text = item.optString("text", "")
                if (itemId.isEmpty()) {
                    logNotificationTrace("drop", "item/completed missing-stream currentStreaming=$currentStreamingMessageId")
                    return
                }
                currentStreamingMessageId = null
                logNotificationTrace("apply", "item/completed itemId=$itemId textLen=${text.length}")
                upsertAssistantMessage(
                    itemId = itemId,
                    content = text,
                    streaming = false
                )
            }

            notification.method == "turn/diff/updated" ||
                notification.method == "item/fileChange/outputDelta" ||
                notification.method == "item/mcpToolCall/progress" ||
                notification.method == "configWarning" ||
                notification.method == "deprecationNotice" ||
                notification.method.startsWith("item/reasoning/") -> {
                applyRuntimeNotificationUpdate(notification.method, params)
            }

            notification.method == "thread/tokenUsage/updated" -> {
                applyTokenUsagePayload(params)
            }

            notification.method == "account/rateLimits/updated" -> {
                applyRateLimitPayload(params)
            }

            notification.method == "error" -> {
                val message = resolveCodexNotificationError(params)
                logNotificationTrace("apply", "error message=$message")
                appendMessage(ChatMessage.Role.ERROR, message)
                _uiState.update {
                    it.copy(
                        errorMessage = message,
                        planWorkflow = buildEmptyPlanWorkflowState(),
                        executionWatch = CodexExecutionWatchState(),
                        runtimePanel = it.runtimePanel.copy(
                            warning = message,
                            warningTone = "error"
                        )
                    )
                }
            }

            else -> {
                Log.d(TAG, "Unhandled codex_notification method: ${notification.method}")
            }
        }
    }

    private fun handleCodexServerRequest(envelope: CodexServerRequestEnvelope?) {
        val request = envelope?.request ?: return
        Log.d(
            TAG,
            "[server-request] requestId=${request.requestId} kind=${request.requestKind} mode=${request.responseMode} handledBy=${request.handledBy} questionCount=${request.questionCount} parsedQuestions=${request.questions.size} summary=${compactLogValue(request.summary)} params=${compactLogValue(request.params?.toString())} raw=${compactLogValue(envelope.raw.toString())}"
        )
        finalizePlanStreamingMessage()
        if (!request.handledBy.equals("client", ignoreCase = true)) {
            appendMessage(
                ChatMessage.Role.SYSTEM,
                buildAutoHandledServerRequestMessage(request)
            )
            Log.d(TAG, "Surfaced auto-handled server request as system message: ${request.method}")
            return
        }
        if (
            request.requestKind == "userInput" &&
            _uiState.value.planWorkflow.phase == PLAN_PHASE_PLANNING
        ) {
            _uiState.update { state ->
                syncExecutionWatch(
                    state.copy(
                        planWorkflow = state.planWorkflow.copy(
                            phase = PLAN_PHASE_AWAITING_USER_INPUT,
                            lastUserInputRequestId = request.requestId
                        )
                    ),
                    markActivity = true
                )
            }
        }
        _uiState.update { state ->
            syncExecutionWatch(
                state.copy(
                    pendingServerRequests = upsertPendingServerRequest(state.pendingServerRequests, request),
                    submittingServerRequestIds = state.submittingServerRequestIds - request.requestId
                ),
                markActivity = true
            )
        }
        Log.i(TAG, "Pending server request: ${request.requestKind} ${request.requestId}")
    }

    private fun buildAutoHandledServerRequestMessage(request: CodexServerRequest): String {
        val method = request.method.ifBlank { "unknown" }
        return "Codex server request auto-handled: $method"
    }

    private fun buildEmptyPlanWorkflowState(): CodexPlanWorkflowState = CodexPlanWorkflowState()

    private fun buildEmptyRuntimePanelState(visible: Boolean = false): CodexRuntimePanelState =
        CodexRuntimePanelState(visible = visible)

    private data class RuntimePanelUpdate(
        val section: String,
        val mode: String,
        val text: String,
        val warningTone: String = "",
        val warningKind: String = ""
    )

    private fun applyRuntimeNotificationUpdate(method: String, params: JSONObject?) {
        val update = buildRuntimeNotificationUpdate(method, params) ?: return
        _uiState.update { state ->
            syncExecutionWatch(applyRuntimePanelUpdate(state, update), markActivity = true)
        }
    }

    private fun applyRuntimeSnapshotItem(item: JSONObject) {
        val update = buildRuntimeSnapshotUpdate(item) ?: return
        _uiState.update { state ->
            syncExecutionWatch(applyRuntimePanelUpdate(state, update), markActivity = true)
        }
    }

    private fun buildRuntimePanelStateFromTurns(
        turns: JSONArray?,
        visible: Boolean
    ): CodexRuntimePanelState {
        var panel = buildEmptyRuntimePanelState(visible = visible)
        if (turns == null) {
            return panel
        }
        for (turnIndex in 0 until turns.length()) {
            val turn = turns.optJSONObject(turnIndex) ?: continue
            val items = turn.optJSONArray("items") ?: continue
            for (itemIndex in 0 until items.length()) {
                val item = items.optJSONObject(itemIndex) ?: continue
                val update = buildRuntimeSnapshotUpdate(item) ?: continue
                panel = applyRuntimePanelUpdate(panel, update)
            }
        }
        return panel
    }

    private fun buildNoticesPanelStateFromTurns(
        turns: JSONArray?,
        visible: Boolean
    ): CodexNoticesPanelState {
        var notices = CodexNoticesPanelState(visible = visible)
        if (turns == null) {
            return notices
        }
        for (turnIndex in 0 until turns.length()) {
            val turn = turns.optJSONObject(turnIndex) ?: continue
            val items = turn.optJSONArray("items") ?: continue
            for (itemIndex in 0 until items.length()) {
                val item = items.optJSONObject(itemIndex) ?: continue
                val update = buildRuntimeSnapshotUpdate(item) ?: continue
                notices = when (update.warningKind) {
                    "config" -> notices.copy(configWarningText = update.text)
                    "deprecation" -> notices.copy(deprecationNoticeText = update.text)
                    else -> notices
                }
            }
        }
        return notices
    }

    private fun applyRuntimePanelUpdate(
        state: CodexUiState,
        update: RuntimePanelUpdate
    ): CodexUiState {
        val nextRuntimePanel = applyRuntimePanelUpdate(state.runtimePanel, update)
        val nextNoticesPanel = when (update.warningKind) {
            "config" -> state.noticesPanel.copy(configWarningText = update.text)
            "deprecation" -> state.noticesPanel.copy(deprecationNoticeText = update.text)
            else -> state.noticesPanel
        }
        return state.copy(
            runtimePanel = nextRuntimePanel,
            noticesPanel = nextNoticesPanel
        )
    }

    private fun applyRuntimePanelUpdate(
        panel: CodexRuntimePanelState,
        update: RuntimePanelUpdate
    ): CodexRuntimePanelState {
        if (update.text.isEmpty()) {
            return panel
        }
        if (update.section == "warning") {
            return panel.copy(
                warning = update.text,
                warningTone = update.warningTone.ifBlank { panel.warningTone }
            )
        }
        val nextText = when (update.section) {
            "diff" -> updateRuntimeSectionText(panel.diff, update)
            "plan" -> updateRuntimeSectionText(panel.plan, update)
            "reasoning" -> updateRuntimeSectionText(panel.reasoning, update)
            else -> return panel
        }
        return when (update.section) {
            "diff" -> panel.copy(diff = nextText)
            "plan" -> panel.copy(plan = nextText)
            "reasoning" -> panel.copy(reasoning = nextText)
            else -> panel
        }
    }

    private fun updateRuntimeSectionText(existing: String, update: RuntimePanelUpdate): String {
        val normalizedUpdateText = stripAnsiText(update.text).trim()
        if (normalizedUpdateText.isEmpty()) {
            return existing
        }
        return if (update.mode == "append") {
            val separator = if (existing.isNotEmpty() && !existing.endsWith('\n')) "\n" else ""
            trimRuntimePanelText(existing + separator + normalizedUpdateText)
        } else {
            trimRuntimePanelText(normalizedUpdateText)
        }
    }

    private fun trimRuntimePanelText(value: String, maxLength: Int = 12_000): String {
        if (value.length <= maxLength) {
            return value
        }
        return value.takeLast(maxLength)
    }

    private fun buildRuntimeNotificationUpdate(
        method: String,
        params: JSONObject?
    ): RuntimePanelUpdate? {
        val payload = params ?: JSONObject()
        val update = when {
            method == "turn/diff/updated" -> RuntimePanelUpdate(
                section = "diff",
                mode = "replace",
                text = pickFirstText(
                    payload,
                    listOf("summary"),
                    listOf("diff"),
                    listOf("patch"),
                    listOf("text"),
                    listOf("content")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            method == "turn/plan/updated" -> RuntimePanelUpdate(
                section = "plan",
                mode = "replace",
                text = pickFirstText(
                    payload,
                    listOf("summary"),
                    listOf("text"),
                    listOf("plan", "summary"),
                    listOf("plan", "text"),
                    listOf("content")
                ).ifEmpty {
                    summarizePlanValue(payload.opt("plan"))
                        .ifEmpty { summarizePlanValue(payload) }
                        .ifEmpty { normalizeLines(payload.opt("steps")) }
                        .ifEmpty { summarizeRuntimeValue(payload) }
                }
            )
            method == "item/plan/delta" -> RuntimePanelUpdate(
                section = "plan",
                mode = "append",
                text = pickFirstText(
                    payload,
                    listOf("delta"),
                    listOf("text"),
                    listOf("summary"),
                    listOf("part", "text"),
                    listOf("item", "text")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            method.startsWith("item/reasoning/") -> RuntimePanelUpdate(
                section = "reasoning",
                mode = if (method.endsWith("Delta")) "append" else "replace",
                text = summarizeReasoningPayload(payload)
            )
            method == "item/fileChange/outputDelta" -> RuntimePanelUpdate(
                section = "diff",
                mode = "append",
                text = pickFirstText(
                    payload,
                    listOf("delta"),
                    listOf("output"),
                    listOf("text")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            method == "item/mcpToolCall/progress" -> RuntimePanelUpdate(
                section = "plan",
                mode = "append",
                text = pickFirstText(
                    payload,
                    listOf("message"),
                    listOf("status"),
                    listOf("text"),
                    listOf("progress", "message")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            method == "configWarning" -> RuntimePanelUpdate(
                section = "warning",
                mode = "replace",
                warningTone = "warn",
                warningKind = "config",
                text = pickFirstText(
                    payload,
                    listOf("message"),
                    listOf("text"),
                    listOf("detail")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            method == "deprecationNotice" -> RuntimePanelUpdate(
                section = "warning",
                mode = "replace",
                warningTone = "warn",
                warningKind = "deprecation",
                text = pickFirstText(
                    payload,
                    listOf("message"),
                    listOf("text"),
                    listOf("detail")
                ).ifEmpty { summarizeRuntimeValue(payload) }
            )
            else -> null
        }
        return update?.takeIf { it.text.isNotEmpty() }
    }

    private fun buildRuntimeSnapshotUpdate(item: JSONObject): RuntimePanelUpdate? {
        val itemType = item.optString("type", "")
        val update = when (itemType) {
            "reasoning" -> RuntimePanelUpdate(
                section = "reasoning",
                mode = "replace",
                text = summarizeReasoningPayload(item)
            )
            "plan" -> RuntimePanelUpdate(
                section = "plan",
                mode = "replace",
                text = pickFirstText(
                    item,
                    listOf("text"),
                    listOf("summary")
                ).ifEmpty {
                    normalizeLines(item.opt("steps")).ifEmpty { summarizeRuntimeValue(item) }
                }
            )
            "fileChange" -> RuntimePanelUpdate(
                section = "diff",
                mode = "replace",
                text = pickFirstText(
                    item,
                    listOf("output"),
                    listOf("text"),
                    listOf("summary"),
                    listOf("patch")
                ).ifEmpty { summarizeRuntimeValue(item) }
            )
            "mcpToolCall" -> RuntimePanelUpdate(
                section = "plan",
                mode = "append",
                text = pickFirstText(
                    item,
                    listOf("message"),
                    listOf("status"),
                    listOf("text")
                ).ifEmpty { summarizeRuntimeValue(item) }
            )
            "agentMessage" -> {
                when (item.optString("phase", "").trim().lowercase()) {
                    "plan" -> RuntimePanelUpdate(
                        section = "plan",
                        mode = "replace",
                        text = pickFirstText(item, listOf("text")).ifEmpty { summarizeRuntimeValue(item) }
                    )
                    "reasoning" -> RuntimePanelUpdate(
                        section = "reasoning",
                        mode = "replace",
                        text = summarizeReasoningPayload(item)
                    )
                    else -> null
                }
            }
            else -> null
        }
        return update?.takeIf { it.text.isNotEmpty() }
    }

    /** Build label + initial content for a collapsible execution feedback message. */
    private fun buildExecutionFeedback(item: JSONObject, type: String): Pair<String, String>? {
        return when (type) {
            "fileChange" -> {
                val path = item.optString("filePath", "").ifEmpty { item.optString("path", "") }
                val changeType = item.optString("changeType", "edit").lowercase()
                val label = when (changeType) {
                    "create", "created" -> appContext.getString(R.string.codex_native_exec_created_file)
                    "delete", "deleted" -> appContext.getString(R.string.codex_native_exec_deleted_file)
                    else -> appContext.getString(R.string.codex_native_exec_edited_file)
                }
                "$label" to path
            }
            "mcpToolCall" -> {
                val name = item.optString("name", "").ifEmpty { item.optString("toolName", "") }
                val label = appContext.getString(R.string.codex_native_exec_ran_command)
                "$label" to name
            }
            else -> null
        }
    }

    /** Append a collapsible TOOL message (auto-collapsed). */
    private fun appendCollapsibleMessage(itemId: String, label: String, content: String) {
        val msg = ChatMessage(
            id = "exec-$itemId",
            role = ChatMessage.Role.TOOL,
            content = content,
            collapsible = true,
            collapsedLabel = label
        )
        _uiState.update { it.copy(messages = it.messages + msg) }
    }

    /** Update an existing collapsible message with completed details. */
    private fun updateCollapsibleMessageContent(itemId: String, item: JSONObject, type: String) {
        val targetId = "exec-$itemId"
        val detail = when (type) {
            "fileChange" -> {
                val output = pickFirstText(item, listOf("output"), listOf("text"), listOf("patch"))
                output.take(500)
            }
            "mcpToolCall" -> {
                val output = pickFirstText(item, listOf("output"), listOf("message"), listOf("text"))
                output.take(500)
            }
            else -> ""
        }
        if (detail.isBlank()) return
        _uiState.update { state ->
            val updated = state.messages.map { msg ->
                if (msg.id == targetId) {
                    val combined = if (msg.content.isNotBlank()) "${msg.content}\n$detail" else detail
                    msg.copy(content = combined)
                } else msg
            }
            state.copy(messages = updated)
        }
    }

    private fun resolveCodexNotificationError(params: JSONObject?): String {
        val payload = params?.optJSONObject("error") ?: JSONObject()
        return pickFirstText(
            payload,
            listOf("message"),
            listOf("detail")
        ).ifEmpty {
            pickFirstText(params ?: JSONObject(), listOf("message"), listOf("code"))
        }.ifEmpty {
            "Codex runtime error"
        }
    }

    private fun pickFirstText(source: JSONObject, vararg paths: List<String>): String {
        paths.forEach { path ->
            val normalized = normalizeRuntimeText(readJsonPath(source, path))
            if (normalized.isNotEmpty()) {
                return normalized
            }
        }
        return ""
    }

    private fun readJsonPath(source: Any?, path: List<String>): Any? {
        var current: Any? = source
        path.forEach { segment ->
            val currentObject = current as? JSONObject ?: return null
            current = currentObject.opt(segment)
        }
        return current
    }

    private fun normalizeRuntimeText(value: Any?): String {
        return when (value) {
            is String -> value
            is Number -> value.toString()
            else -> ""
        }
    }

    private fun stripAnsiText(value: String): String {
        if (value.isEmpty()) {
            return value
        }
        return ANSI_ESCAPE_REGEX.replace(value, "")
    }

    private fun normalizeLines(value: Any?): String {
        return when (value) {
            is JSONArray -> {
                buildList {
                    for (index in 0 until value.length()) {
                        summarizeRuntimeValue(value.opt(index))
                            .takeIf { it.isNotEmpty() }
                            ?.let(::add)
                    }
                }.joinToString("\n")
            }
            else -> summarizeRuntimeValue(value)
        }
    }

    private fun summarizeRuntimeValue(value: Any?): String {
        return when (value) {
            is String -> value
            is Number -> value.toString()
            is JSONObject -> {
                pickFirstText(
                    value,
                    listOf("text"),
                    listOf("delta"),
                    listOf("summary"),
                    listOf("message"),
                    listOf("description"),
                    listOf("output"),
                    listOf("content"),
                    listOf("title")
                ).ifEmpty { value.toString() }
            }
            is JSONArray -> normalizeLines(value)
            else -> ""
        }
    }

    private fun summarizePlanValue(value: Any?): String {
        return when (value) {
            is JSONArray -> formatPlanSteps(value)
            is JSONObject -> {
                val directText = pickFirstText(
                    value,
                    listOf("summary"),
                    listOf("text"),
                    listOf("explanation"),
                    listOf("message"),
                    listOf("content")
                )
                val nestedPlanSteps = formatPlanSteps(value.optJSONArray("plan"))
                val nestedSteps = formatPlanSteps(value.optJSONArray("steps"))
                when {
                    nestedPlanSteps.isNotEmpty() && directText.isNotEmpty() -> "$directText\n$nestedPlanSteps"
                    nestedPlanSteps.isNotEmpty() -> nestedPlanSteps
                    nestedSteps.isNotEmpty() && directText.isNotEmpty() -> "$directText\n$nestedSteps"
                    nestedSteps.isNotEmpty() -> nestedSteps
                    else -> directText
                }
            }
            else -> ""
        }
    }

    private fun formatPlanSteps(steps: JSONArray?): String {
        if (steps == null || steps.length() == 0) {
            return ""
        }
        return buildList {
            for (index in 0 until steps.length()) {
                val entry = steps.opt(index)
                val text = if (entry is JSONObject) {
                    val stepText = pickFirstText(
                        entry,
                        listOf("step"),
                        listOf("text"),
                        listOf("summary"),
                        listOf("title")
                    )
                    val statusText = pickFirstText(
                        entry,
                        listOf("status"),
                        listOf("state")
                    )
                    when {
                        stepText.isNotEmpty() && statusText.isNotEmpty() -> "[$statusText] $stepText"
                        stepText.isNotEmpty() -> stepText
                        else -> summarizeRuntimeValue(entry)
                    }
                } else {
                    summarizeRuntimeValue(entry)
                }
                if (text.isNotEmpty()) {
                    add(text)
                }
            }
        }.joinToString("\n")
    }

    private data class RateLimitSummary(val summary: String, val tone: String)

    private data class RateLimitEntryResult(val entry: JSONObject?, val extraCount: Int)

    private fun normalizeSkillCatalog(result: Any?): List<CodexSkillEntry> {
        val source = result as? JSONObject ?: return emptyList()
        val groups = source.optJSONArray("data") ?: return emptyList()
        val seen = linkedSetOf<String>()
        val skills = mutableListOf<CodexSkillEntry>()
        for (groupIndex in 0 until groups.length()) {
            val group = groups.optJSONObject(groupIndex) ?: continue
            val entries = group.optJSONArray("skills") ?: continue
            for (entryIndex in 0 until entries.length()) {
                val entry = entries.optJSONObject(entryIndex) ?: continue
                if (!entry.optBoolean("enabled", false)) continue
                val name = entry.optStringOrNullCompat("name").orEmpty()
                if (name.isEmpty() || !seen.add(name.lowercase())) continue
                val ui = entry.optJSONObject("interface")
                skills += CodexSkillEntry(
                    name = name,
                    label = (
                        ui?.optStringOrNullCompat("displayName")
                            ?: ui?.optStringOrNullCompat("display_name")
                        ).orEmpty().ifBlank { name },
                    description = (
                        ui?.optStringOrNullCompat("shortDescription")
                            ?: ui?.optStringOrNullCompat("short_description")
                        )
                        ?: entry.optStringOrNullCompat("description")
                        ?: "",
                    defaultPrompt = ui?.optStringOrNullCompat("defaultPrompt")
                        ?: ui?.optStringOrNullCompat("default_prompt")
                        ?: "",
                    scope = entry.optStringOrNullCompat("scope") ?: ""
                )
            }
        }
        return skills.sortedBy { it.label.lowercase() }
    }

    private fun applyTokenUsagePayload(payload: Any?) {
        val contextUsage = normalizeContextUsageState(payload)
        val summary = formatTokenUsageSummary(contextUsage)
        _uiState.update { state ->
            state.copy(
                usagePanel = state.usagePanel.copy(
                    visible = if (contextUsage == null) false else state.usagePanel.visible,
                    tokenUsageSummary = summary,
                    contextUsage = contextUsage
                )
            )
        }
    }

    private fun applyRateLimitPayload(payload: Any?) {
        val next = formatRateLimitSummary(payload)
        if (next.summary.isEmpty()) {
            return
        }
        _uiState.update { state ->
            state.copy(
                usagePanel = state.usagePanel.copy(
                    rateLimitSummary = next.summary,
                    rateLimitTone = next.tone
                )
            )
        }
    }

    private fun formatTokenUsageSummary(contextUsage: CodexContextUsageState?): String {
        val usage = contextUsage ?: return ""
        val input = usage.inputTokens
        val output = usage.outputTokens
        val total = usage.usedTokens ?: if (input != null || output != null) {
            (input ?: 0L) + (output ?: 0L)
        } else {
            null
        }
        val cached = usage.cachedInputTokens
        val reasoning = usage.reasoningTokens
        val parts = mutableListOf<String>()
        input?.let { parts += "${formatCompactNumber(it)} in" }
        output?.let { parts += "${formatCompactNumber(it)} out" }
        total?.let { parts += "${formatCompactNumber(it)} total" }
        if (cached != null && cached > 0) parts += "${formatCompactNumber(cached)} cached"
        if (reasoning != null && reasoning > 0) parts += "${formatCompactNumber(reasoning)} reasoning"
        return if (parts.isEmpty()) "" else "tokens ${parts.joinToString(" / ")}"
    }

    private fun normalizeContextUsageState(payload: Any?): CodexContextUsageState? {
        val sources = buildTokenUsageSources(payload).filter(::looksLikeTaskScopedContextSource)
        if (sources.isEmpty()) {
            return null
        }
        val modelContextWindow = pickFirstLongFromSources(
            sources,
            listOf("modelContextWindow"),
            listOf("model_context_window")
        )
        val nestedTotalTokens = pickFirstLongFromSources(
            sources,
            listOf("last", "totalTokens"),
            listOf("last", "total_tokens")
        )
        val explicitUsedTokens = pickFirstLongFromSources(
            sources,
            listOf("usedTokens"),
            listOf("used_tokens")
        )
        val explicitMaxTokens = pickFirstLongFromSources(
            sources,
            listOf("maxTokens"),
            listOf("max_tokens"),
            listOf("contextWindowTokens"),
            listOf("context_window_tokens"),
            listOf("contextWindowMaxTokens"),
            listOf("context_window_max_tokens"),
            listOf("maxContextTokens"),
            listOf("max_context_tokens")
        )
        val explicitPercent = pickFirstLongFromSources(
            sources,
            listOf("usedPercent"),
            listOf("used_percent"),
            listOf("contextUsedPercent"),
            listOf("context_used_percent"),
            listOf("usagePercent"),
            listOf("usage_percent")
        )?.toInt()
        if (
            modelContextWindow != null &&
            modelContextWindow > 0 &&
            nestedTotalTokens != null &&
            nestedTotalTokens >= 0
        ) {
            val safeUsedTokens = nestedTotalTokens.coerceAtMost(modelContextWindow)
            val usedPercent = clampPercent(
                ((safeUsedTokens.toDouble() * 100.0) / modelContextWindow.toDouble()).toInt()
            ) ?: return null
            return CodexContextUsageState(
                usedTokens = safeUsedTokens,
                contextWindow = modelContextWindow,
                usedPercent = usedPercent,
                remainingPercent = (100 - usedPercent).coerceAtLeast(0),
                inputTokens = pickFirstLongFromSources(
                    sources,
                    listOf("inputTokens"),
                    listOf("input_tokens"),
                    listOf("input"),
                    listOf("promptTokens"),
                    listOf("prompt_tokens")
                ),
                outputTokens = pickFirstLongFromSources(
                    sources,
                    listOf("outputTokens"),
                    listOf("output_tokens"),
                    listOf("output"),
                    listOf("completionTokens"),
                    listOf("completion_tokens")
                ),
                cachedInputTokens = pickFirstLongFromSources(
                    sources,
                    listOf("cachedInputTokens"),
                    listOf("cached_input_tokens"),
                    listOf("cacheTokens"),
                    listOf("cache_tokens")
                ),
                reasoningTokens = pickFirstLongFromSources(
                    sources,
                    listOf("reasoningOutputTokens"),
                    listOf("reasoning_output_tokens"),
                    listOf("reasoningTokens"),
                    listOf("reasoning_tokens")
                ),
                updatedAtMillis = System.currentTimeMillis()
            )
        }
        val usedTokens = explicitUsedTokens?.takeIf { it >= 0 }
        val maxTokens = explicitMaxTokens?.takeIf { it > 0 }
        val usedPercent = clampPercent(
            explicitPercent ?: (
                if (usedTokens != null && maxTokens != null && maxTokens > 0) {
                    ((usedTokens.toDouble() * 100.0) / maxTokens.toDouble()).toInt()
                } else {
                    null
                }
            )
        ) ?: return null
        val normalizedUsedTokens = usedTokens?.takeIf { it >= 0 }
        val normalizedContextWindow = maxTokens?.takeIf { it > 0 }
        return CodexContextUsageState(
            usedTokens = normalizedUsedTokens,
            contextWindow = normalizedContextWindow,
            usedPercent = usedPercent,
            remainingPercent = (100 - usedPercent).coerceAtLeast(0),
            inputTokens = pickFirstLongFromSources(
                sources,
                listOf("inputTokens"),
                listOf("input_tokens"),
                listOf("input"),
                listOf("promptTokens"),
                listOf("prompt_tokens")
            ),
            outputTokens = pickFirstLongFromSources(
                sources,
                listOf("outputTokens"),
                listOf("output_tokens"),
                listOf("output"),
                listOf("completionTokens"),
                listOf("completion_tokens")
            ),
            cachedInputTokens = pickFirstLongFromSources(
                sources,
                listOf("cachedInputTokens"),
                listOf("cached_input_tokens"),
                listOf("cacheTokens"),
                listOf("cache_tokens")
            ),
            reasoningTokens = pickFirstLongFromSources(
                sources,
                listOf("reasoningOutputTokens"),
                listOf("reasoning_output_tokens"),
                listOf("reasoningTokens"),
                listOf("reasoning_tokens")
            ),
            updatedAtMillis = System.currentTimeMillis()
        )
    }

    private fun looksLikeTaskScopedContextSource(source: JSONObject): Boolean {
        if (source.has("contextUsage") || source.has("context_usage")) {
            return true
        }
        if (
            source.has("modelContextWindow") ||
            source.has("model_context_window") ||
            source.has("usedPercent") ||
            source.has("used_percent") ||
            source.has("contextUsedPercent") ||
            source.has("context_used_percent") ||
            source.has("usagePercent") ||
            source.has("usage_percent") ||
            source.has("contextWindowTokens") ||
            source.has("context_window_tokens") ||
            source.has("contextWindowMaxTokens") ||
            source.has("context_window_max_tokens") ||
            source.has("maxContextTokens") ||
            source.has("max_context_tokens") ||
            source.has("usedTokens") ||
            source.has("used_tokens")
        ) {
            return true
        }
        val last = source.optJSONObject("last")
        return last?.has("totalTokens") == true || last?.has("total_tokens") == true
    }

    private fun formatRateLimitSummary(payload: Any?): RateLimitSummary {
        val extracted = extractRateLimitEntry(payload)
        val sources = buildRateLimitSources(payload) + listOfNotNull(extracted.entry)
        if (sources.isEmpty()) {
            return RateLimitSummary("", "")
        }
        val message = pickFirstStringFromSources(
            sources,
            listOf("message"),
            listOf("detail"),
            listOf("error", "message")
        )
        val scope = pickFirstStringFromSources(
            sources,
            listOf("scope"),
            listOf("name"),
            listOf("type"),
            listOf("resource")
        )
        val remaining = pickFirstLongFromSources(
            sources,
            listOf("remaining"),
            listOf("remaining_requests"),
            listOf("remainingRequests"),
            listOf("limitRemaining"),
            listOf("rate_limit_remaining"),
            listOf("rateLimitRemaining")
        )
        val limit = pickFirstLongFromSources(
            sources,
            listOf("limit"),
            listOf("max"),
            listOf("rate_limit"),
            listOf("rateLimit")
        )
        val retryAfter = pickFirstLongFromSources(
            sources,
            listOf("retryAfterSeconds"),
            listOf("retry_after_seconds"),
            listOf("retryAfter"),
            listOf("retry_after")
        )
        val resetHint = formatResetHint(
            pickFirstStringFromSources(
                sources,
                listOf("resetAt"),
                listOf("resetsAt"),
                listOf("reset_at"),
                listOf("resets_at")
            ).ifBlank { null } ?: pickFirstLongFromSources(
                sources,
                listOf("resetAtEpochMs"),
                listOf("resetsInSeconds"),
                listOf("reset_at_epoch_ms"),
                listOf("resets_in_seconds")
            )
        )
        val rawStatus = pickFirstStringFromSources(
            sources,
            listOf("status"),
            listOf("state"),
            listOf("result")
        ).lowercase()
        val primaryUsedPercent = pickFirstLongFromSources(
            sources,
            listOf("primary", "usedPercent"),
            listOf("primary", "used_percent")
        )
        val secondaryUsedPercent = pickFirstLongFromSources(
            sources,
            listOf("secondary", "usedPercent"),
            listOf("secondary", "used_percent")
        )
        val primaryWindowMins = pickFirstLongFromSources(
            sources,
            listOf("primary", "windowDurationMins"),
            listOf("primary", "window_duration_mins")
        )
        val secondaryWindowMins = pickFirstLongFromSources(
            sources,
            listOf("secondary", "windowDurationMins"),
            listOf("secondary", "window_duration_mins")
        )
        val primaryResetHint = formatResetHint(
            pickFirstStringFromSources(
                sources,
                listOf("primary", "resetAt"),
                listOf("primary", "resetsAt"),
                listOf("primary", "reset_at"),
                listOf("primary", "resets_at")
            ).ifBlank { null } ?: pickFirstLongFromSources(
                sources,
                listOf("primary", "resetAtEpochMs"),
                listOf("primary", "resetsAtEpochMs"),
                listOf("primary", "resetsAt"),
                listOf("primary", "resets_at"),
                listOf("primary", "resetsInSeconds"),
                listOf("primary", "resets_in_seconds")
            )
        )
        val secondaryResetHint = formatResetHint(
            pickFirstStringFromSources(
                sources,
                listOf("secondary", "resetAt"),
                listOf("secondary", "resetsAt"),
                listOf("secondary", "reset_at"),
                listOf("secondary", "resets_at")
            ).ifBlank { null } ?: pickFirstLongFromSources(
                sources,
                listOf("secondary", "resetAtEpochMs"),
                listOf("secondary", "resetsAtEpochMs"),
                listOf("secondary", "resetsAt"),
                listOf("secondary", "resets_at"),
                listOf("secondary", "resetsInSeconds"),
                listOf("secondary", "resets_in_seconds")
            )
        )
        val parts = mutableListOf<String>()
        if (remaining != null && limit != null) {
            parts += buildString {
                if (scope.isNotEmpty()) {
                    append(scope)
                    append(':')
                }
                append(remaining.coerceAtLeast(0))
                append('/')
                append(limit.coerceAtLeast(0))
            }
        } else if (remaining != null) {
            parts += buildString {
                if (scope.isNotEmpty()) {
                    append(scope)
                    append(':')
                }
                append(remaining.coerceAtLeast(0))
            }
        } else {
            if (primaryUsedPercent != null) {
                val primary = mutableListOf<String>()
                primary += formatRateLimitWindowLabel(primaryWindowMins) ?: "p"
                primary += "${primaryUsedPercent.coerceIn(0, 100)}%"
                if (primaryResetHint.isNotEmpty()) {
                    primary += "⏱$primaryResetHint"
                }
                parts += primary.joinToString(" ")
            }
            if (secondaryUsedPercent != null) {
                val secondary = mutableListOf<String>()
                secondary += formatRateLimitWindowLabel(secondaryWindowMins) ?: "s"
                secondary += "${secondaryUsedPercent.coerceIn(0, 100)}%"
                if (secondaryResetHint.isNotEmpty()) {
                    secondary += "⏱$secondaryResetHint"
                }
                parts += secondary.joinToString(" ")
            }
        }
        if (retryAfter != null && retryAfter > 0) {
            parts += "↺${formatDurationShort(retryAfter)}"
        }
        if (resetHint.isNotEmpty()) {
            parts += "⏱$resetHint"
        }
        if (extracted.extraCount > 0) {
            parts += "+${extracted.extraCount}"
        }
        val summary = when {
            parts.isNotEmpty() -> parts.joinToString(" | ")
            message.isNotEmpty() -> message
            else -> ""
        }
        if (summary.isEmpty()) {
            return RateLimitSummary("", "")
        }
        val tone = when {
            (remaining != null && remaining <= 1L) ||
                (primaryUsedPercent != null && primaryUsedPercent >= 90L) ||
                (secondaryUsedPercent != null && secondaryUsedPercent >= 90L) ||
                (retryAfter != null && retryAfter > 0L) ||
                rawStatus.contains("exhaust") ||
                rawStatus.contains("limit") ||
                rawStatus.contains("denied") -> if (rawStatus.contains("denied")) "error" else "warn"
            else -> ""
        }
        return RateLimitSummary(summary = summary, tone = tone)
    }

    private fun buildTokenUsageSources(payload: Any?): List<JSONObject> {
        val sources = mutableListOf<JSONObject>()
        fun addObject(value: Any?) {
            if (value is JSONObject) {
                sources += value
            }
        }
        val root = payload as? JSONObject ?: return emptyList()
        addObject(root)
        addObject(root.optJSONObject("latestTokenUsageInfo"))
        addObject(root.optJSONObject("tokenUsage"))
        addObject(root.optJSONObject("tokenUsage")?.optJSONObject("latestTokenUsageInfo"))
        addObject(root.optJSONObject("usage"))
        addObject(root.optJSONObject("contextUsage"))
        addObject(root.optJSONObject("context_usage"))
        val thread = root.optJSONObject("thread")
        addObject(thread)
        addObject(thread?.optJSONObject("latestTokenUsageInfo"))
        addObject(thread?.optJSONObject("tokenUsage"))
        addObject(thread?.optJSONObject("tokenUsage")?.optJSONObject("latestTokenUsageInfo"))
        return sources
    }

    private fun buildRateLimitSources(payload: Any?): List<JSONObject> {
        val sources = mutableListOf<JSONObject>()
        fun addObject(value: Any?) {
            if (value is JSONObject) {
                sources += value
            }
        }
        val root = payload as? JSONObject ?: return emptyList()
        addObject(root)
        addObject(root.opt("rateLimit"))
        addObject(root.opt("rateLimits"))
        addObject(root.opt("ratelimits"))
        addObject(root.opt("rate_limits"))
        addObject(root.opt("account"))
        val result = root.opt("result")
        addObject(result)
        if (result is JSONObject) {
            addObject(result.opt("rateLimit"))
            addObject(result.opt("rateLimits"))
            addObject(result.opt("ratelimits"))
            addObject(result.opt("rate_limits"))
        }
        return sources
    }

    private fun extractRateLimitEntry(payload: Any?): RateLimitEntryResult {
        val root = payload as? JSONObject ?: return RateLimitEntryResult(null, 0)
        val candidates = listOf(
            payload,
            root.opt("rateLimit"),
            root.opt("rateLimits"),
            root.opt("ratelimits"),
            root.opt("rate_limits"),
            root.opt("account"),
            root.opt("result"),
            root.optJSONObject("result")?.opt("rateLimit"),
            root.optJSONObject("result")?.opt("rateLimits"),
            root.optJSONObject("result")?.opt("ratelimits"),
            root.optJSONObject("result")?.opt("rate_limits")
        )
        candidates.forEach { current ->
            when (current) {
                is JSONArray -> {
                    val entry = current.optJSONObject(0)
                    if (entry != null) {
                        return RateLimitEntryResult(entry, (current.length() - 1).coerceAtLeast(0))
                    }
                }
                is JSONObject -> {
                    val limits = current.optJSONArray("limits")
                    if (limits != null && limits.length() > 0) {
                        return RateLimitEntryResult(limits.optJSONObject(0), (limits.length() - 1).coerceAtLeast(0))
                    }
                    val items = current.optJSONArray("items")
                    if (items != null && items.length() > 0) {
                        return RateLimitEntryResult(items.optJSONObject(0), (items.length() - 1).coerceAtLeast(0))
                    }
                }
            }
        }
        val byLimitId = root.optJSONObject("rateLimitsByLimitId")
            ?: root.optJSONObject("ratelimitsbylimitid")
            ?: root.optJSONObject("result")?.optJSONObject("rateLimitsByLimitId")
            ?: root.optJSONObject("result")?.optJSONObject("ratelimitsbylimitid")
        if (byLimitId != null) {
            val names = byLimitId.keys().asSequence().toList()
            val entry = names.firstNotNullOfOrNull { key -> byLimitId.optJSONObject(key) }
            if (entry != null) {
                return RateLimitEntryResult(entry, (names.size - 1).coerceAtLeast(0))
            }
        }
        return RateLimitEntryResult(null, 0)
    }

    private fun pickFirstLongFromSources(
        sources: List<JSONObject>,
        vararg paths: List<String>
    ): Long? {
        sources.forEach { source ->
            paths.forEach { path ->
                when (val value = readJsonPath(source, path)) {
                    is Number -> return value.toLong()
                    is String -> value.trim().toLongOrNull()?.let { return it }
                }
            }
        }
        return null
    }

    private fun pickFirstStringFromSources(
        sources: List<JSONObject>,
        vararg paths: List<String>
    ): String {
        sources.forEach { source ->
            paths.forEach { path ->
                val value = readJsonPath(source, path)
                if (value is String && value.isNotBlank()) {
                    return value.trim()
                }
            }
        }
        return ""
    }

    private fun clampPercent(value: Int?): Int? {
        value ?: return null
        return value.coerceIn(0, 100)
    }

    private fun formatCompactNumber(value: Long): String {
        val absValue = kotlin.math.abs(value.toDouble())
        return when {
            absValue >= 1_000_000.0 -> {
                val divisor = value / 1_000_000.0
                if (absValue >= 10_000_000.0) String.format("%.0fm", divisor) else String.format("%.1fm", divisor)
            }
            absValue >= 1_000.0 -> {
                val divisor = value / 1_000.0
                if (absValue >= 10_000.0) String.format("%.0fk", divisor) else String.format("%.1fk", divisor)
            }
            else -> value.toString()
        }
    }

    private fun formatDurationShort(totalSeconds: Long): String {
        if (totalSeconds <= 0L) {
            return ""
        }
        return when {
            totalSeconds < 60L -> "${totalSeconds}s"
            totalSeconds < 3600L -> "${kotlin.math.round(totalSeconds / 60.0).toLong()}m"
            else -> "${kotlin.math.round(totalSeconds / 3600.0).toLong()}h"
        }
    }

    private fun formatRateLimitWindowLabel(windowMins: Long?): String? {
        windowMins ?: return null
        if (windowMins <= 0L) return null
        return formatDurationShort(windowMins * 60L)
    }

    private fun formatResetHint(value: Any?): String {
        fun formatAbsoluteResetTime(timestampMs: Long): String {
            val deltaMs = timestampMs - System.currentTimeMillis()
            val pattern = if (deltaMs >= 86_400_000L) "MM/dd HH:mm" else "HH:mm"
            return SimpleDateFormat(pattern, Locale.getDefault()).format(Date(timestampMs))
        }

        return when (value) {
            is Number -> {
                val numeric = value.toLong()
                when {
                    numeric > 0L && numeric < 10_000_000L ->
                        formatAbsoluteResetTime(System.currentTimeMillis() + numeric * 1000L)
                    numeric >= 1_000_000_000L && numeric < 1_000_000_000_000L ->
                        formatAbsoluteResetTime(numeric * 1000L)
                    numeric >= 1_000_000_000_000L ->
                        formatAbsoluteResetTime(numeric)
                    else -> ""
                }
            }

            is String -> {
                val trimmed = value.trim()
                when {
                    trimmed.isEmpty() -> ""
                    trimmed.all(Char::isDigit) -> formatResetHint(trimmed.toLongOrNull())
                    else -> {
                        val parsed = runCatching { Date.parse(trimmed) }.getOrNull()
                        if (parsed != null && parsed > 0L) {
                            formatAbsoluteResetTime(parsed)
                        } else {
                            trimmed
                        }
                    }
                }
            }

            else -> ""
        }
    }

    private fun buildInteractionState(
        state: CodexUiState,
        planMode: Boolean
    ): CodexInteractionState {
        return CodexInteractionState(
            planMode = planMode,
            activeSkill = state.interactionState?.activeSkill
        )
    }

    private fun mergeInteractionState(
        current: CodexInteractionState?,
        incoming: CodexInteractionState?
    ): CodexInteractionState? {
        if (current == null) {
            return incoming
        }
        if (incoming == null) {
            return current
        }
        return CodexInteractionState(
            planMode = current.planMode,
            activeSkill = incoming.activeSkill ?: current.activeSkill
        )
    }

    private fun syncInteractionState(state: CodexInteractionState) {
        connectionManager.send(CodexClientMessages.codexSetInteractionState(state))
        Log.i(TAG, "Plan mode: ${state.planMode}")
    }

    private fun closePlanMode(clearWorkflow: Boolean) {
        _uiState.update { current ->
            current.copy(
                planMode = false,
                interactionState = buildInteractionState(current, planMode = false),
                planWorkflow = if (clearWorkflow) {
                    buildEmptyPlanWorkflowState()
                } else {
                    current.planWorkflow
                }
            )
        }
        syncInteractionState(_uiState.value.interactionState ?: CodexInteractionState())
    }

    private fun applyInteractionState(planMode: Boolean) {
        _uiState.update { current ->
            current.copy(
                planMode = planMode,
                goalMode = if (planMode) false else current.goalMode,
                interactionState = buildInteractionState(current, planMode)
            )
        }
        syncInteractionState(_uiState.value.interactionState ?: CodexInteractionState(planMode = planMode))
    }

    private fun getPlanWorkflowDisplayText(state: CodexUiState): String {
        return state.planWorkflow.confirmedPlanText.ifBlank {
            state.planWorkflow.latestPlanText
        }
    }

    private fun startPlanWorkflow(promptText: String): CodexPlanWorkflowState {
        return CodexPlanWorkflowState(
            phase = PLAN_PHASE_PLANNING,
            originalPrompt = promptText.trim()
        )
    }

    private fun updatePlanWorkflowText(
        state: CodexUiState,
        text: String,
        preserveWhitespace: Boolean = false
    ): CodexUiState {
        val normalized = if (preserveWhitespace) text else text.trim()
        if (normalized.isBlank()) {
            return state
        }
        return state.copy(
            planWorkflow = state.planWorkflow.copy(
                latestPlanText = normalized
            )
        )
    }

    private fun finalizePlanWorkflowForConfirmation(state: CodexUiState): CodexUiState {
        val planText = getPlanWorkflowDisplayText(state).trim()
        if (planText.isBlank()) {
            return state.copy(planWorkflow = buildEmptyPlanWorkflowState())
        }
        return state.copy(
            planWorkflow = state.planWorkflow.copy(
                phase = PLAN_PHASE_READY_FOR_CONFIRMATION,
                latestPlanText = planText,
                confirmedPlanText = planText,
                lastUserInputRequestId = ""
            )
        )
    }

    private fun finalizePlanWorkflowOnTurnSettled(state: CodexUiState): CodexUiState {
        return when (state.planWorkflow.phase) {
            PLAN_PHASE_PLANNING,
            PLAN_PHASE_AWAITING_USER_INPUT -> finalizePlanWorkflowForConfirmation(state)
            PLAN_PHASE_EXECUTING_CONFIRMED_PLAN -> state.copy(
                planWorkflow = buildEmptyPlanWorkflowState()
            )
            else -> state
        }
    }

    private fun shouldTrackPlanWorkflowText(state: CodexUiState): Boolean {
        return state.planWorkflow.phase == PLAN_PHASE_PLANNING ||
            state.planWorkflow.phase == PLAN_PHASE_AWAITING_USER_INPUT
    }

    private fun buildConfirmedPlanExecutionPrompt(state: CodexUiState): String {
        val originalPrompt = state.planWorkflow.originalPrompt.ifBlank {
            "Follow the confirmed plan below."
        }
        val confirmedPlan = getPlanWorkflowDisplayText(state).trim()
        if (confirmedPlan.isBlank()) {
            return ""
        }
        return listOf(
            "Execute the confirmed plan below now.",
            "",
            "Original user goal:",
            originalPrompt,
            "",
            "Confirmed plan:",
            confirmedPlan
        ).joinToString("\n")
    }

    private fun recalculateNextTurnEffectiveConfig(state: CodexUiState): CodexUiState {
        return recalculateNextTurnEffectiveConfigForUiState(state)
    }

    private fun latestCanonicalTurn(turns: JSONArray?): JSONObject? {
        if (turns == null) return null
        for (index in turns.length() - 1 downTo 0) {
            turns.optJSONObject(index)?.let { return it }
        }
        return null
    }

    private fun canonicalThreadStatusType(thread: JSONObject): String? {
        return when (val raw = thread.opt("status")) {
            is JSONObject -> raw.optStringOrNullCompat("type")
            is String -> raw.trim().takeIf(String::isNotEmpty)
            else -> null
        }
    }

    private fun latestCanonicalAgentPhase(turn: JSONObject?): String? {
        val items = turn?.optJSONArray("items") ?: return null
        for (index in items.length() - 1 downTo 0) {
            val item = items.optJSONObject(index) ?: continue
            if (item.optString("type", "").equals("agentMessage", ignoreCase = true)) {
                item.optStringOrNullCompat("phase")?.let { return it }
            }
        }
        return null
    }

    private fun canonicalTurnHasActiveItem(turn: JSONObject?): Boolean {
        val items = turn?.optJSONArray("items") ?: return false
        for (index in 0 until items.length()) {
            val status = items.optJSONObject(index)?.optStringOrNullCompat("status")
                ?.trim()
                ?.lowercase()
                ?.replace("_", "")
                ?.replace("-", "")
                .orEmpty()
            if (status in setOf("inprogress", "running", "active", "started")) return true
        }
        return false
    }

    private fun parseSnapshotMessages(snapshot: CodexThreadSnapshot): List<ChatMessage> {
        val result = mutableListOf<ChatMessage>()
        val arr = snapshot.messages
        for (i in 0 until arr.length()) {
            val msgJson = arr.optJSONObject(i) ?: continue
            val role = when (msgJson.optString("role", "")) {
                "user" -> ChatMessage.Role.USER
                "assistant" -> ChatMessage.Role.ASSISTANT
                "system" -> ChatMessage.Role.SYSTEM
                "tool" -> ChatMessage.Role.TOOL
                "error" -> ChatMessage.Role.ERROR
                else -> ChatMessage.Role.SYSTEM
            }
            // `content` is a structured array for canonical Codex user
            // messages.  Calling optString() on that array produces the
            // literal JSON-array text that was visible after a
            // cache/history reload; project it using the shared semantic
            // decoder instead.
            val content = extractHistoryPayloadTextForUi(msgJson)
            val fileMentions = if (role == ChatMessage.Role.USER) {
                extractUserMessageFileMentions(
                    content = msgJson.optJSONArray("content"),
                    fallbackText = content
                )
            } else {
                emptyList()
            }
            val skills = if (role == ChatMessage.Role.USER) {
                extractUserMessageSkills(
                    content = msgJson.optJSONArray("content"),
                    fallbackText = content
                )
            } else {
                emptyList()
            }
            val attachments = if (role == ChatMessage.Role.USER) {
                extractUserMessageAttachments(
                    content = msgJson.optJSONArray("content"),
                    fallbackText = content
                )
            } else {
                emptyList()
            }
            val activeSkill = msgJson.optStringOrNullCompat("activeSkill")
                ?: skills.firstOrNull()?.name
            result.add(
                ChatMessage(
                    id = msgJson.optString("id", UUID.randomUUID().toString()),
                    role = role,
                    content = if (role == ChatMessage.Role.USER) buildVisibleUserMessageText(content) else content,
                    fileMentions = fileMentions,
                    activeSkill = if (role == ChatMessage.Role.USER) activeSkill else null,
                    skills = if (role == ChatMessage.Role.USER) skills else emptyList(),
                    attachments = if (role == ChatMessage.Role.USER) attachments else emptyList(),
                    timestamp = msgJson.optLong("timestamp", System.currentTimeMillis())
                )
            )
        }
        return result
    }

    private fun appendMessage(role: ChatMessage.Role, content: String) {
        _uiState.update {
            syncExecutionWatch(
                it.copy(
                    messages = it.messages + ChatMessage(
                        id = UUID.randomUUID().toString(),
                        role = role,
                        content = content
                    )
                ),
                markActivity = role != ChatMessage.Role.USER
            )
        }
    }

    private fun upsertAssistantMessage(
        itemId: String,
        content: String,
        streaming: Boolean,
        trackPlanText: Boolean = true
    ) {
        _uiState.update { state ->
            val nextState = if (trackPlanText && shouldTrackPlanWorkflowText(state)) {
                updatePlanWorkflowText(state, content)
            } else {
                state
            }
            val existingIndex = nextState.messages.indexOfFirst { it.id == itemId }
            if (existingIndex >= 0) {
                logNotificationTrace("ui", "upsert update itemId=$itemId streaming=$streaming contentLen=${content.length}")
                val updated = nextState.messages.toMutableList()
                updated[existingIndex] = updated[existingIndex].copy(
                    content = content,
                    streaming = streaming,
                    timestamp = System.currentTimeMillis()
                )
                syncExecutionWatch(nextState.copy(messages = updated), markActivity = true)
            } else {
                logNotificationTrace("ui", "upsert insert itemId=$itemId streaming=$streaming contentLen=${content.length}")
                syncExecutionWatch(
                    nextState.copy(
                        messages = nextState.messages + ChatMessage(
                            id = itemId,
                            role = ChatMessage.Role.ASSISTANT,
                            content = content,
                            streaming = streaming
                        )
                    ),
                    markActivity = true
                )
            }
        }
    }

    private fun appendAssistantDelta(itemId: String, delta: String, trackPlanText: Boolean = true) {
        _uiState.update { state ->
            val nextState = if (trackPlanText && shouldTrackPlanWorkflowText(state)) {
                updatePlanWorkflowText(
                    state = state,
                    text = getPlanWorkflowDisplayText(state) + delta,
                    preserveWhitespace = true
                )
            } else {
                state
            }
            val existingIndex = nextState.messages.indexOfFirst { it.id == itemId }
            if (existingIndex >= 0) {
                logNotificationTrace("ui", "delta append itemId=$itemId deltaLen=${delta.length}")
                val updated = nextState.messages.toMutableList()
                val existing = updated[existingIndex]
                updated[existingIndex] = existing.copy(
                    content = existing.content + delta,
                    streaming = true,
                    timestamp = System.currentTimeMillis()
                )
                syncExecutionWatch(nextState.copy(messages = updated), markActivity = true)
            } else {
                logNotificationTrace("ui", "delta create itemId=$itemId deltaLen=${delta.length}")
                syncExecutionWatch(
                    nextState.copy(
                        messages = nextState.messages + ChatMessage(
                            id = itemId,
                            role = ChatMessage.Role.ASSISTANT,
                            content = delta,
                            streaming = true
                        )
                    ),
                    markActivity = true
                )
            }
        }
    }

    private fun finalizeStreamingMessage() {
        val streamId = currentStreamingMessageId ?: return
        finalizeStreamingMessageById(streamId)
        currentStreamingMessageId = null
    }

    private fun syncExecutionWatch(
        state: CodexUiState,
        markActivity: Boolean,
        nowMillis: Long = System.currentTimeMillis()
    ): CodexUiState {
        if (!shouldTrackExecutionWatch(state)) {
            return if (
                !state.executionWatch.active &&
                state.executionWatch.runningSinceMillis == 0L &&
                state.executionWatch.lastEventAtMillis == 0L
            ) {
                state
            } else {
                state.copy(executionWatch = CodexExecutionWatchState())
            }
        }
        val startedAt = state.executionWatch.runningSinceMillis.takeIf { it > 0L } ?: nowMillis
        val lastEventAt = when {
            markActivity -> nowMillis
            state.executionWatch.lastEventAtMillis > 0L -> state.executionWatch.lastEventAtMillis
            else -> nowMillis
        }
        return state.copy(
            executionWatch = CodexExecutionWatchState(
                active = true,
                runningSinceMillis = startedAt,
                lastEventAtMillis = lastEventAt
            )
        )
    }

    private fun shouldTrackExecutionWatch(state: CodexUiState): Boolean {
        return shouldTrackExecutionWatchForUiState(
            state = state,
            ipcStatusObserved = ipcStatusObserved
        )
    }

    // ── IPC surface snapshot merge helpers ────────────────────────────

    private fun applyConversationStatusChanged(json: JSONObject) {
        val conversationId = json.optStringOrNullCompat("conversationId").orEmpty()
        val status = json.optStringOrNullCompat("status").orEmpty()
        if (status.isEmpty()) return
        _uiState.update { current ->
            applyConversationStatusChangedToUiState(
                state = current,
                conversationId = conversationId,
                status = status
            )
        }
    }

    private fun handleConversationActionRequired(json: JSONObject) {
        val conversationId = json.optStringOrNullCompat("conversationId").orEmpty()
        val actionType = json.optString("actionType", "").trim()
        val payload = json.optJSONObject("payload") ?: return
        val activeConversationId = _uiState.value.activeConversationId?.trim().orEmpty()
        if (conversationId.isNotEmpty() && activeConversationId.isNotEmpty() && conversationId != activeConversationId) {
            return
        }
        when (actionType) {
            "approval" -> {
                val pending = PendingApprovalInfo.from(payload) ?: return
                _uiState.update { current ->
                    current.copy(
                        activeConversationId = conversationId.ifEmpty { current.activeConversationId },
                        pendingServerRequests = mergePendingApproval(current.pendingServerRequests, pending)
                    )
                }
            }
            "plan" -> {
                val pending = PendingPlanActionInfo.from(payload) ?: return
                _uiState.update { current ->
                    current.copy(
                        activeConversationId = conversationId.ifEmpty { current.activeConversationId },
                        planWorkflow = mergePlanWorkflow(current.planWorkflow, pending)
                    )
                }
            }
            "user_input" -> {
                val request = CodexServerRequest.from(payload)?.copy(handledBy = "ipc_follower") ?: return
                _uiState.update { current ->
                    current.copy(
                        activeConversationId = conversationId.ifEmpty { current.activeConversationId },
                        pendingServerRequests = mergePendingUserInput(current.pendingServerRequests, request)
                    )
                }
            }
            "goal" -> {
                _uiState.update { current ->
                    current.copy(activeConversationId = conversationId.ifEmpty { current.activeConversationId })
                }
            }
        }
    }

    override fun onCleared() {
        super.onCleared()
        connectionManager.shutdown()
    }
}

private fun org.json.JSONObject.optStringOrNullCompat(key: String): String? {
    if (!has(key) || isNull(key)) {
        return null
    }
    return optString(key, "").trim().takeIf { it.isNotEmpty() && !it.equals("null", ignoreCase = true) }
}
