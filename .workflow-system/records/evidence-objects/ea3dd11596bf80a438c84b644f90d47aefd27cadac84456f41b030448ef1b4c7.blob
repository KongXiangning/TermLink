    fun requestCompactCurrentThread() {
        val state = _uiState.value
        if (state.capabilities?.compact != true) {
            val message = appContext.getString(R.string.codex_native_tools_compact_unavailable)
            _uiState.update {
                it.copy(
                    toolsPanel = it.toolsPanel.copy(
                        compactStatusText = message,
                        compactStatusTone = "error"
                    )
                )
            }
            appendMessage(ChatMessage.Role.ERROR, message)
            return
        }
        val threadId = normalizeThreadId(state.threadId).orEmpty()
        if (threadId.isEmpty()) {
            val message = appContext.getString(R.string.codex_native_tools_compact_no_thread)
            _uiState.update {
                it.copy(
                    toolsPanel = it.toolsPanel.copy(
                        compactStatusText = message,
                        compactStatusTone = "error"
                    )
                )
            }
            appendMessage(ChatMessage.Role.ERROR, message)
            return
        }
        val requestingMessage = appContext.getString(R.string.codex_native_tools_compact_requesting)
        _uiState.update {
            it.copy(
                toolsPanel = it.toolsPanel.copy(
                    compactSubmitting = true,
                    compactStatusText = requestingMessage,
                    compactStatusTone = ""
                )
            )
        }
        appendMessage(ChatMessage.Role.SYSTEM, requestingMessage)
        connectionManager.send(
            CodexClientMessages.codexRequest(
                action = "thread/compact/start",
                params = JSONObject().put("threadId", threadId)
            )
        )
    }

    fun showUsagePanel() {
        requestRateLimits(silent = true)
        _uiState.update { state ->
            closeSlashMenu(
                state.copy(usagePanel = state.usagePanel.copy(visible = true))
            )
        }
    }

    fun hideUsagePanel() {
        _uiState.update { state ->
            state.copy(usagePanel = state.usagePanel.copy(visible = false))
        }
    }

    fun addImageUrlAttachment(url: String) {
        val normalized = url.trim()
        if (normalized.isEmpty()) return
        _uiState.update { state ->
            state.copy(
                pendingImageAttachments = state.pendingImageAttachments + CodexPendingImageAttachment(
                    id = UUID.randomUUID().toString(),
                    type = "image",
                    label = normalized,
                    url = normalized
                )
            )
        }
    }

    fun addLocalImageAttachment(
        label: String,
        dataUrl: String,
        mimeType: String?,
        sizeBytes: Long
    ) {
        val normalizedUrl = dataUrl.trim()
        if (normalizedUrl.isEmpty()) return
        val maxImageSize = _uiState.value.capabilities?.maxImageSize ?: 0L
        if (maxImageSize > 0L && sizeBytes > maxImageSize) {
            appendMessage(
                ChatMessage.Role.ERROR,
                "Image too large: $label (${sizeBytes} bytes > $maxImageSize bytes)."
            )
            return
        }
        _uiState.update { state ->
            state.copy(
                pendingImageAttachments = state.pendingImageAttachments + CodexPendingImageAttachment(
                    id = UUID.randomUUID().toString(),
                    type = "localImage",
                    label = label.ifBlank { "Image" },
                    url = normalizedUrl,
                    mimeType = mimeType,
                    sizeBytes = sizeBytes
                )
            )
        }
    }

    fun removePendingImageAttachment(attachmentId: String) {
        _uiState.update { state ->
            state.copy(
                pendingImageAttachments = state.pendingImageAttachments.filterNot { it.id == attachmentId }
            )
        }
    }

    fun hideThreadHistory() {
        _uiState.update {
            it.copy(
                threadHistorySheetVisible = false,
                threadRenameTargetId = "",
                threadRenameDraft = "",
                threadHistoryActionThreadId = "",
                threadHistoryActionKind = ""
            )
        }
    }

    fun refreshThreadHistory() {
        val state = _uiState.value
        // Capabilities can arrive after the first frame (and older gateways do
        // not advertise the bit).  A null value must not disable the user's
        // explicit history refresh; an explicit false still preserves the
        // legacy unsupported-method behavior.
        if (state.capabilities?.historyList == false) return
        val profileId = currentProfile?.id ?: return
        threadListRequestProfileId = profileId
        threadListRequestGeneration = historySelectionGeneration
        threadListRequestCwd = state.cwd?.trim()?.takeIf { it.isNotEmpty() }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.refresh.started",
            mapOf("hasCwd" to !state.cwd.isNullOrBlank(), "ipcOnline" to state.ipcOnline)
        )
        val params = JSONObject().put("limit", 50)
        val cwd = state.cwd?.trim().orEmpty()
        if (cwd.isNotEmpty()) {
            params.put("cwd", cwd)
        }
        _uiState.update { it.copy(threadHistoryLoading = true, threadHistoryStatus = "syncing") }
        val sent = connectionManager.send(
            CodexClientMessages.codexRequest(
                action = "thread/list",
                params = params,
                historyMode = "metadata",
                selectionGeneration = threadListRequestGeneration
            )
        )
        // The endpoint-scoped index is already the usable list.  Do not leave
        // the drawer in an endless "syncing" state when OkHttp accepts a frame
        // but the network never returns a thread/list response.  A later live
        // response still upgrades the status to "live" through the normal
        // response handler, and generation checks continue to reject stale
        // lists after A→B selection.
        _uiState.update { current ->
            if (current.threadHistoryLoading &&
                threadListRequestGeneration == historySelectionGeneration
            ) {
                current.copy(
                    threadHistoryLoading = false,
                    threadHistoryStatus = if (sent) "cache_only" else "offline"
                )
            } else {
                current
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.refresh.sent",
            mapOf(
                "sent" to sent,
                "generation" to threadListRequestGeneration,
                "cwdScoped" to !threadListRequestCwd.isNullOrBlank(),
                "entryCount" to _uiState.value.threadHistoryEntries.size
            ),
            level = if (sent) "info" else "warn"
        )
    }

    fun resumeThread(threadId: String) {
        val normalizedThreadId = threadId.trim()
        if (normalizedThreadId.isEmpty()) return
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.thread.resume.requested",
            mapOf(
                "threadKey" to PersistentDiagnosticLog.shortHash(normalizedThreadId),
                "previousThreadKey" to PersistentDiagnosticLog.shortHash(_uiState.value.threadId),
                "activeConversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId),
                "ipcOnline" to _uiState.value.ipcOnline
            )
        )
        clearPendingOptimisticNewThreadTransition()
        clearPendingLaunchHydrate()
        advanceHistorySelectionGeneration("resume:$normalizedThreadId")
        pinnedIpcConversationId = normalizedThreadId
        pendingHistoryResumeHydrationThreadId = normalizedThreadId
        val selectionGeneration = historySelectionGeneration
        _uiState.update {
            it.copy(
                threadHistoryActionThreadId = normalizedThreadId,
                threadHistoryActionKind = "resume"
            )
        }
        // History selection is cache-first.  The remote thread/resume request
        // may be queued in OkHttp while the socket is offline (or never return
        // after a network drop), so waiting for its response here would leave
        // every history row disabled indefinitely.  Read the endpoint-scoped
        // cache first, then atomically commit the target identity and正文.  The
        // remote response remains an optional freshness/IPC re-entry path and
        // is guarded by the selection generation below.
        applyCachedHistorySelection(
            conversationId = normalizedThreadId,
            generation = selectionGeneration
        ) { key, checkpoint ->
            if (!isCurrentHistorySelection(key)) return@applyCachedHistorySelection
            if (key.generation != selectionGeneration) return@applyCachedHistorySelection
            beginAwaitingFreshIpcSurface()
            subscribeActiveConversationIfNeeded()
            // Do not make detail hydration depend on thread/resume.  A stale
            // or expired Desktop/VS Code owner can leave that RPC queued
            // forever; the bounded history channel is independent and has
            // already been started by this callback.
            maybeRequestHistorySync(normalizedThreadId)
            maybeRequestLiveReplay(
                conversationId = normalizedThreadId,
                generation = selectionGeneration,
                checkpoint = checkpoint
            )
            val sent = connectionManager.send(
                CodexClientMessages.codexRequest(
                    action = "thread/resume",
                    params = JSONObject().put("threadId", normalizedThreadId),
                    historyMode = "metadata",
                    selectionGeneration = selectionGeneration
                )
            )
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.thread.resume.sent",
                mapOf(
                    "threadKey" to PersistentDiagnosticLog.shortHash(normalizedThreadId),
                    "sent" to sent,
                    "generation" to selectionGeneration
                ),
                level = if (sent) "info" else "warn"
            )
            if (sent && isCurrentHistorySelection(key)) {
                armHistoryResumeProtection(
                    conversationId = normalizedThreadId,
                    generation = selectionGeneration
                )
            } else if (!sent && isCurrentHistorySelection(key)) {
                // Do not turn a transport miss into a blocking history action.
                // The cached task remains open and the next explicit refresh
                // can retry after the service becomes reachable.
                pendingHistoryResumeHydrationThreadId = null
                cancelHistoryResumeProtection()
                _uiState.update {
                    it.copy(
                        threadHistoryStatus = "offline",
                        threadHistoryActionThreadId = "",
                        threadHistoryActionKind = "",
                        historyNetworkSyncState = historyNetworkState(
                            key,
                            CodexHistoryNetworkSyncState.OFFLINE
                        )
                    )
                }
            }
        }
    }

    /**
     * Switch to a cached history entry before waiting for thread/resume.
     *
     * This is deliberately limited to static history selection.  A healthy IPC
     * surface remains the live authority: when the remote request succeeds it
     * can still replace the cached base, and stale responses are rejected by
     * [historySelectionGeneration].
     */
    private fun applyCachedHistorySelection(
        conversationId: String,
        generation: Long,
        onCommitted: (CodexHistorySelectionKey, CodexHistorySyncCheckpoint) -> Unit
    ) {
        val normalizedConversationId = normalizeThreadId(conversationId) ?: return
        val profileId = currentProfile?.id?.trim()?.takeIf { it.isNotEmpty() } ?: return
        val key = CodexHistorySelectionKey(profileId, normalizedConversationId, generation)
        val entry = _uiState.value.threadHistoryEntries.firstOrNull {
            normalizeThreadId(it.id) == normalizedConversationId
        }
        val selected = CodexIpcConversationSummary(
            conversationId = normalizedConversationId,
            status = "unknown",
            updatedAt = entry?.lastActiveAt ?: 0L,
            title = entry?.title?.trim()?.takeIf { it.isNotEmpty() } ?: normalizedConversationId,
            cwd = entry?.cwd,
            ownerKind = null,
            latestTurnId = null,
            itemCount = 0,
            hasActiveGoal = false,
            hasPendingApproval = false,
            hasPendingPlanAction = false,
            hasPendingUserInputAction = false
        )
        pendingHistorySelectionKey = key
        // Establish B as the selected task before its cache read starts.  The
        // old implementation deferred this commit until the IO/decode result
        // returned, visibly leaving A's final message on screen in proportion
        // to B's cached payload size.
        _uiState.update { state ->
            val previousConversationId = state.activeConversationId
            val selectedState = dismissThreadHistoryForResumeSelection(
                applyIpcConversationSelectionWithRememberedConfig(state, selected)
            )
            preparePendingHistorySelectionUiState(previousConversationId, selectedState)
        }
        viewModelScope.launch(Dispatchers.IO) {
            val cachedResult = runCatching {
                historyCacheStore.readConversation(profileId, normalizedConversationId)
            }
            val snapshot = decodeHistoryCacheSnapshot(
                key = key,
                cached = cachedResult.getOrNull(),
                readError = cachedResult.exceptionOrNull()
            )
            val cached = cachedResult.getOrNull()
            val checkpoint = normalizeLiveReplayCheckpointForAvailableItems(
                checkpoint = cached?.checkpoint,
                durableItems = cached?.items.orEmpty()
            )
            var completeServerSnapshotCache = false
            val committed = withContext(Dispatchers.Main.immediate) {
                if (!shouldCommitCachedHistorySelectionToUiState(
                        state = _uiState.value,
                        key = key,
                        pendingKey = pendingHistorySelectionKey,
                        currentEndpointId = currentProfile?.id,
                        currentGeneration = historySelectionGeneration
                    )) {
                    false
                } else {
                    val previousConversationId = normalizeThreadId(_uiState.value.activeConversationId)
                    val switched = previousConversationId != normalizedConversationId
                    val snapshotSegmentsEnabled = historyCapability?.serverSnapshotSegments?.let {
                        it.enabled && it.version == 1 && it.cacheSchemaVersion >= 3
                    } == true
                    completeServerSnapshotCache = shouldPromoteCompleteServerSnapshotCache(
                        serverSnapshotSegmentsEnabled = snapshotSegmentsEnabled,
                        providerMode = snapshot.providerMode,
                        cacheCoverageComplete = snapshot.durableCoverageComplete
                    )
                    if (completeServerSnapshotCache) {
                        // This is the durable B4R proof already stored on the
                        // device.  Establish it before the selection callback
                        // can schedule ordinary history sync or foreground
                        // recovery for this generation.
                        completeServerSnapshotCacheSelectionKey = key
                        markHistorySyncSettled(normalizedConversationId, generation)
                    }
                    _uiState.update { state ->
                        val selectedState = dismissThreadHistoryForResumeSelection(
                            applyIpcConversationSelectionWithRememberedConfig(state, selected)
                        )
                        val visibleMessages = mergeCachedHistoryIntoLiveMessagesForUi(
                            state = selectedState,
                            conversationId = normalizedConversationId,
                            cachedMessages = snapshot.messages
                        )
                        selectedState.copy(
                            cachedCanonicalMessages = snapshot.messages,
                            messages = visibleMessages,
                            historyCacheState = snapshot.uiState,
                            historyNetworkSyncState = historyNetworkState(
                                key,
                                if (completeServerSnapshotCache) {
                                    CodexHistoryNetworkSyncState.CACHE_ONLY
                                } else {
                                    CodexHistoryNetworkSyncState.IDLE
                                }
                            ),
                            threadHistoryStatus = "cache_only",
                            threadHistoryLoading = false,
                            threadHistoryActionThreadId = "",
                            threadHistoryActionKind = "",
                            errorMessage = if (switched) null else selectedState.errorMessage,
                            status = if (switched) "idle" else selectedState.status,
                            currentTurnId = if (switched) null else selectedState.currentTurnId,
                            interactionState = if (switched) null else selectedState.interactionState,
                            executionWatch = if (switched) CodexExecutionWatchState() else selectedState.executionWatch,
                            runtimePanel = if (switched) {
                                buildEmptyRuntimePanelState(visible = selectedState.runtimePanel.visible)
                            } else {
                                selectedState.runtimePanel
                            },
                            noticesPanel = if (switched) {
                                CodexNoticesPanelState(visible = selectedState.noticesPanel.visible)
                            } else {
                                selectedState.noticesPanel
                            },
                            pendingServerRequests = if (switched) emptyList() else selectedState.pendingServerRequests,
                            submittingServerRequestIds = if (switched) emptySet() else selectedState.submittingServerRequestIds
                        )
                    }
                    pendingHistorySelectionKey = null
                    true
                }
            }
            if (committed) {
                withContext(Dispatchers.Main.immediate) {
                    lastCommittedHistoryCacheKey = key
                }
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.codex.thread.resume.cache_selected",
                    mapOf(
                        "threadKey" to PersistentDiagnosticLog.shortHash(normalizedConversationId),
                        "hasIndexEntry" to (entry != null),
                        "cacheLoadState" to snapshot.uiState.loadState.name,
                        "cacheComplete" to snapshot.uiState.complete,
                        "cacheCoverageComplete" to snapshot.durableCoverageComplete,
                        "completeServerSnapshotCache" to completeServerSnapshotCache,
                        "generation" to generation
                    )
                )
                withContext(Dispatchers.Main.immediate) {
                    onCommitted(key, checkpoint)
                    if (completeServerSnapshotCache) {
                        maybeRequestCanonicalTailValidation(
                            normalizedConversationId,
                            "static_cache_selected"
                        )
                    }
                }
            }
        }
    }

    fun forkThread(threadId: String) {
        requestThreadMutation(
            threadId = threadId,
            actionKind = "fork",
            method = "thread/fork"
        )
    }

    fun toggleThreadArchive(threadId: String, archived: Boolean) {
        requestThreadMutation(
            threadId = threadId,
            actionKind = if (archived) "unarchive" else "archive",
            method = if (archived) "thread/unarchive" else "thread/archive"
        )
    }

    fun startThreadRename(threadId: String, currentTitle: String) {
        val normalizedThreadId = threadId.trim()
        if (normalizedThreadId.isEmpty()) return
        _uiState.update {
            it.copy(
                threadRenameTargetId = normalizedThreadId,
                threadRenameDraft = currentTitle.ifBlank { normalizedThreadId }
            )
        }
    }

    fun updateThreadRenameDraft(value: String) {
        _uiState.update { it.copy(threadRenameDraft = value) }
    }

    fun cancelThreadRename() {
        _uiState.update {
            it.copy(
                threadRenameTargetId = "",
                threadRenameDraft = ""
            )
        }
    }

    fun submitThreadRename() {
        val state = _uiState.value
        val targetId = state.threadRenameTargetId.trim()
        val nextTitle = state.threadRenameDraft.trim()
        if (targetId.isEmpty() || nextTitle.isEmpty()) return
        _uiState.update {
            it.copy(
                threadHistoryActionThreadId = targetId,
                threadHistoryActionKind = "rename"
            )
        }
        connectionManager.send(
            CodexClientMessages.codexRequest(
                action = "thread/name/set",
                params = JSONObject()
                    .put("threadId", targetId)
                    .put("name", nextTitle)
                    .put("title", nextTitle)
            )
        )
    }

    // ── Slash command dispatch ─────────────────────────────────────────

    private fun dispatchSlashCommand(parsed: CodexSlashRegistry.ParsedInput.Slash) {
        if (parsed.command == "/goal") {
            startFollowerGoal(parsed.argumentText)
            return
        }
        val entry = CodexSlashRegistry.resolveSlashCommand(parsed.command)
        if (entry == null) {
            appendMessage(ChatMessage.Role.SYSTEM, "Unknown command: ${parsed.command}")
            return
        }

        when (resolveMobileSlashAction(entry.command)) {
            MobileSlashAction.SHOW_MODEL_PICKER -> showModelPicker()
            MobileSlashAction.PLAN -> handleSlashPlan(parsed.argumentText)
            MobileSlashAction.FAST -> toggleFastMode()
            MobileSlashAction.SHOW_SKILLS -> showToolsPanel()
            MobileSlashAction.COMPACT -> requestCompactCurrentThread()
            MobileSlashAction.NEW_THREAD -> newThread()
            MobileSlashAction.FORK_THREAD -> {
                val currentThreadId = normalizeThreadId(_uiState.value.threadId)
                if (currentThreadId == null) {
                    appendMessage(
                        ChatMessage.Role.ERROR,
                        appContext.getString(R.string.codex_native_slash_fork_no_thread)
                    )
                } else {
                    forkThread(currentThreadId)
                }
            }
            MobileSlashAction.SKILL -> handleSlashSkill(parsed.argumentText)
            MobileSlashAction.MENTION -> appendMessage(
                ChatMessage.Role.SYSTEM,
                appContext.getString(R.string.codex_native_mention_shortcut_hint)
            )
            MobileSlashAction.UNSUPPORTED -> appendMessage(
                ChatMessage.Role.SYSTEM,
                "${entry.command} is not yet supported on mobile"
            )
        }
    }

    private fun handleSlashPlan(argumentText: String) {
        if (argumentText.isEmpty()) {
            togglePlanMode()
        } else {
            sendTurnWithOverrides(argumentText, forcePlanMode = true)
        }
    }

    private fun startFollowerGoal(argumentText: String): Boolean {
        val objective = argumentText.trim()
            .replaceFirst(Regex("^/goal(?:\\s+|$)", RegexOption.IGNORE_CASE), "")
            .trim()
        if (objective.isEmpty()) {
            appendMessage(ChatMessage.Role.SYSTEM, "Goal objective is required.")
            return false
        }
        val state = _uiState.value
        if (!shouldUseIpcFollowerSendTransportState(state)) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.codex.goal.intent.failed",
                mapOf(
                    "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                    "goalKey" to PersistentDiagnosticLog.shortHash(objective),
                    "objectiveLength" to objective.length,
                    "reason" to "follower_transport_unavailable",
                    "followerModeEnabled" to state.followerModeEnabled,
                    "activeSendAllowed" to state.followerActiveSendAllowed
                ),
                level = "warn"
            )
            _uiState.update {
                it.copy(connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable))
            }
            return false
        }
        val sent = sendTurnWithOverrides("/goal $objective", goalObjective = objective)
        if (sent) {
            _uiState.update { it.copy(goalMode = false) }
        }
        return sent
    }

    private fun handleSlashSkill(argumentText: String) {
        val query = argumentText.trim()
        if (query.isEmpty()) {
            showToolsPanel()
            return
        }
        maybeLoadSkillCatalog()
        val selected = _uiState.value.toolsPanel.skills.firstOrNull { entry ->
            entry.name.equals(query, ignoreCase = true) || entry.label.equals(query, ignoreCase = true)
        }
        if (selected != null) {
            selectSkill(selected.name)
        } else {
            showToolsPanel()
            appendMessage(ChatMessage.Role.SYSTEM, "Skill not found: $query")
        }
    }

    // ── Plan mode ─────────────────────────────────────────────────────

    fun togglePlanMode() {
        val current = _uiState.value
        if (current.planMode == true) {
            closePlanMode(clearWorkflow = true)
        } else {
            applyInteractionState(planMode = true)
        }
    }

    fun continuePlanWorkflow() {
        _uiState.update { state ->
            state.copy(
                planMode = true,
                goalMode = false,
                interactionState = buildInteractionState(state, planMode = true),
                planWorkflow = state.planWorkflow.copy(
                    phase = PLAN_PHASE_PLANNING,
                    latestPlanText = state.planWorkflow.confirmedPlanText.ifBlank {
                        state.planWorkflow.latestPlanText
                    }
                )
            )
        }
        syncInteractionState(_uiState.value.interactionState ?: CodexInteractionState(planMode = true))
    }

    fun cancelPlanWorkflow() {
        closePlanMode(clearWorkflow = true)
    }

    fun executeConfirmedPlan() {
        val state = _uiState.value
        val executionPrompt = buildConfirmedPlanExecutionPrompt(state)
        if (executionPrompt.isBlank()) {
            appendMessage(ChatMessage.Role.ERROR, "No confirmed plan available to execute.")
            return
        }
        val followerPlanRequestId = state.planWorkflow.planRequestId?.trim().orEmpty()
        val followerConversationId = state.activeConversationId?.trim().orEmpty()
        if (shouldUseIpcFollowerTransport(state) && followerPlanRequestId.isNotEmpty() && followerConversationId.isNotEmpty()) {
            Log.i(
                TAG,
                "[plan][submit] requestId=$followerPlanRequestId conversationId=$followerConversationId"
            )
            val sent = sendEnvelopeOrReportFailure(
                payload = CodexClientMessages.followerPlanResponse(
                    conversationId = followerConversationId,
                    input = "是，实施此计划",
                    requestId = followerPlanRequestId,
                    questionId = state.planWorkflow.planQuestionId
                ),
                connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
            )
            if (sent) {
                _uiState.update { current ->
                    current.copy(
                        planMode = false,
                        interactionState = buildInteractionState(current, planMode = false),
                        planWorkflow = current.planWorkflow.copy(
                            phase = PLAN_PHASE_EXECUTING_CONFIRMED_PLAN
                        )
                    )
                }
            }
            return
        }
        _uiState.update { current ->
            current.copy(
                planMode = false,
                interactionState = buildInteractionState(current, planMode = false),
                planWorkflow = current.planWorkflow.copy(
                    phase = PLAN_PHASE_EXECUTING_CONFIRMED_PLAN
                )
            )
        }
        syncInteractionState(_uiState.value.interactionState ?: CodexInteractionState())
        val sent = sendTurnWithOverrides(
            text = executionPrompt,
            forceNewThread = true,
            clearPlanModeAfterSend = false,
            displayTextOverride = appContext.getString(R.string.codex_native_plan_execution_log)
        )
        if (!sent) {
            _uiState.update { current ->
                current.copy(
                    planWorkflow = current.planWorkflow.copy(
                        phase = PLAN_PHASE_READY_FOR_CONFIRMATION
                    )
                )
            }
        }
    }

    // ── Fast mode ─────────────────────────────────────────────────────

    fun toggleFastMode() {
        var enabled = false
        _uiState.update { state ->
            val nextOverrides = nextTurnOverridesForFastModeToggle(state)
            enabled = isFastReasoningEffort(nextOverrides.reasoningEffort)
            Log.i(
                TAG,
                "Fast mode: $enabled (reasoning: ${nextOverrides.reasoningEffort})"
            )
            recalculateNextTurnEffectiveConfig(
                state.copy(
                    nextTurnOverrides = nextOverrides
                )
            )
        }
        rememberCurrentTaskOverrides(reason = "toggle-fast-mode")
        appendMessage(
            ChatMessage.Role.SYSTEM,
            appContext.getString(
                if (enabled) R.string.codex_native_fast_enabled else R.string.codex_native_fast_disabled
            )
        )
    }

    fun showReasoningPicker() {
        _uiState.update {
            closeSlashMenu(
                it.copy(
                    modelPickerVisible = false,
                    sandboxPickerVisible = false,
                    reasoningPickerVisible = true
                )
            )
        }
    }

    fun hideReasoningPicker() {
        _uiState.update { it.copy(reasoningPickerVisible = false) }
    }

    fun selectReasoningEffort(reasoningEffort: String?) {
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.config.selected",
            mapOf("kind" to "reasoning", "valuePresent" to !reasoningEffort.isNullOrBlank()),
            critical = true
        )
        _uiState.update { state ->
            val remembered = loadRememberedTaskOverrides(state.threadId, reason = "select-reasoning-base")
            recalculateNextTurnEffectiveConfig(
                state.copy(
                    nextTurnOverrides = remembered.copy(reasoningEffort = reasoningEffort),
                    reasoningPickerVisible = false
                )
            )
        }
        rememberCurrentTaskOverrides(reason = "select-reasoning")
    }

    fun showSandboxPicker() {
        maybeRequestPermissionProfiles()
        _uiState.update {
            closeSlashMenu(
                it.copy(
                    modelPickerVisible = false,
                    reasoningPickerVisible = false,
                    sandboxPickerVisible = true
                )
            )
        }
    }

    fun hideSandboxPicker() {
        _uiState.update { it.copy(sandboxPickerVisible = false) }
    }

    fun selectSandboxMode(sandboxMode: String?) {
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.config.selected",
            mapOf("kind" to "permission", "value" to sandboxMode.orEmpty()),
            critical = true
        )
        _uiState.update { state ->
            val remembered = loadRememberedTaskOverrides(state.threadId, reason = "select-permission-base")
            val selectionState = state.copy(nextTurnOverrides = remembered)
            recalculateNextTurnEffectiveConfig(
                state.copy(
                    nextTurnOverrides = nextTurnOverridesForPermissionSelection(selectionState, sandboxMode),
                    sandboxPickerVisible = false
                )
            )
        }
        rememberCurrentTaskOverrides(reason = "select-permission")
    }

    // ── Model picker ──────────────────────────────────────────────────

    fun showModelPicker() {
        maybeRequestModelList()
        _uiState.update {
            closeSlashMenu(
                it.copy(
                    modelPickerVisible = true,
                    reasoningPickerVisible = false,
                    sandboxPickerVisible = false
                )
            )
        }
    }

    fun hideModelPicker() {
        _uiState.update { it.copy(modelPickerVisible = false) }
    }

    fun selectModel(model: String?) {
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.config.selected",
            mapOf("kind" to "model", "valuePresent" to !model.isNullOrBlank()),
            critical = true
        )
        _uiState.update { state ->
            val remembered = loadRememberedTaskOverrides(state.threadId, reason = "select-model-base")
            val selectionState = state.copy(nextTurnOverrides = remembered)
            recalculateNextTurnEffectiveConfig(
                state.copy(
                    nextTurnOverrides = nextTurnOverridesForModelSelection(selectionState, model),
                    modelPickerVisible = false
                )
            )
        }
        rememberCurrentTaskOverrides(reason = "select-model")
        Log.i(TAG, "Model override: $model")
