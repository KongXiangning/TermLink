        _uiState.update { state ->
            closeSlashMenu(
                state.copy(
                    threadHistorySheetVisible = false,
                    runtimePanel = state.runtimePanel.copy(visible = false),
                    noticesPanel = state.noticesPanel.copy(visible = true),
                    toolsPanel = state.toolsPanel.copy(visible = false)
                )
            )
        }
