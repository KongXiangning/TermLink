private data class PendingHistorySnapshotSegment(
    val page: CodexHistoryDeltaPage,
    val fragments: MutableMap<String, MutableMap<Int, CodexHistoryPayloadChunk>> = mutableMapOf()
)

/**
 * A completed-only durable context. It intentionally outlives an A→B
 * selection change, but it is never an authority for either conversation's
 * UI state.
 */
private data class TerminalReconcileKey(
    val endpointId: String,
    val conversationId: String,
    val terminalEpoch: String
)

private data class TerminalReconcileContext(
    val key: TerminalReconcileKey,
    val selectionGeneration: Long,
    val syncId: String,
    var dispatchJob: Job? = null,
    var watchdogJob: Job? = null,
    var settled: Boolean = false,
    var settledState: String? = null
)

internal fun isTerminalReconcileSyncPurpose(purpose: String?): Boolean =
    purpose?.trim()?.equals(TERMINAL_RECONCILE_PURPOSE, ignoreCase = true) == true

/**
 * The source epoch + latest turn id identify one completed terminal turn.
 * IPC revision is a delivery/version counter and must not create a new
 * durable reconciliation for every replay of the same completed turn.
 */
internal fun terminalReconcileEpoch(sourceEpoch: String?, latestTurnId: String?): String? {
    val normalizedEpoch = sourceEpoch?.trim()?.takeIf { it.isNotEmpty() } ?: return null
    val normalizedTurnId = latestTurnId?.trim()?.takeIf { it.isNotEmpty() } ?: return null
    return "$normalizedEpoch#$normalizedTurnId"
}

internal fun isEligibleCompletedTerminalSurface(
    surface: DesktopSurfaceSnapshot,
    currentTurnId: String?
): Boolean =
        !surface.desynced &&
        surface.status.trim().lowercase(Locale.ROOT) in setOf("completed", "complete") &&
        currentTurnId.isNullOrBlank() &&
        terminalReconcileEpoch(surface.sourceEpoch, surface.latestTurnId) != null

/**
 * The UI state intentionally keeps one active conversation slot.  This trace
 * records the ownership/count boundary around writes to that slot without
 * changing the state transition itself.  Conversation identifiers are
 * hashed by PersistentDiagnosticLog before they leave the process.
 */
private data class CodexUiStateDiagnosticTrace(
    val activeConversationKey: String?,
    val messageOwnerKey: String?,
    val messageCount: Int,
    val cacheOwnerKey: String?,
    val cacheCount: Int,
    val liveOwnerKey: String?,
    val liveCount: Int,
    val surfaceOwnerKey: String?,
    val surfaceItemCount: Int,
    val surfaceRevision: Int,
    val surfaceDesynced: Boolean,
    val surfaceItemsTruncated: Boolean,
    val surfaceStatus: String?
)

private data class CodexMessageIdentityDelta(
    val values: List<String>,
    val totalCount: Int
)

private data class CodexMessageIdentityObservation(
    val beforeDigest: String,
    val afterDigest: String,
    val beforeSample: String,
    val afterSample: String,
    val removed: CodexMessageIdentityDelta,
    val added: CodexMessageIdentityDelta
)

private fun diagnosticMessageIdentity(message: ChatMessage): String {
    val idHash = PersistentDiagnosticLog.shortHash(message.id).orEmpty()
    val turnHash = PersistentDiagnosticLog.shortHash(
        message.sourceTurnId ?: message.operationTurnId
    ).orEmpty()
    val textHash = PersistentDiagnosticLog.shortHash(message.content).orEmpty()
    val memberHash = PersistentDiagnosticLog.shortHash(
        message.operationBatchMemberIds.joinToString("\u001F")
    ).orEmpty()
    return listOf(
        idHash,
        message.role.name,
        message.operationType.orEmpty(),
        turnHash,
        textHash,
        message.operationBatchSize.toString(),
        message.operationBatchMemberIds.size.toString(),
        memberHash
    ).joinToString(":")
}

private fun diagnosticMessageIdentitySample(identities: List<String>): String {
    if (identities.size <= DIAGNOSTIC_MESSAGE_ID_SAMPLE_LIMIT * 2) {
        return identities.joinToString(",")
    }
    return (identities.take(DIAGNOSTIC_MESSAGE_ID_SAMPLE_LIMIT) +
        listOf("…") +
        identities.takeLast(DIAGNOSTIC_MESSAGE_ID_SAMPLE_LIMIT))
        .joinToString(",")
}

private fun diagnosticMessageIdentityDelta(
    source: List<String>,
    target: List<String>
): CodexMessageIdentityDelta {
    val remaining = target.groupingBy { it }.eachCount().toMutableMap()
    val values = mutableListOf<String>()
    var totalCount = 0
    source.forEach { identity ->
        val count = remaining[identity] ?: 0
        if (count > 0) {
            remaining[identity] = count - 1
        } else {
            totalCount += 1
            if (values.size < DIAGNOSTIC_MESSAGE_ID_DELTA_LIMIT) {
                values += identity
            }
        }
    }
    return CodexMessageIdentityDelta(values = values, totalCount = totalCount)
}

private fun observeMessageIdentities(
    before: List<ChatMessage>,
    after: List<ChatMessage>
): CodexMessageIdentityObservation {
    val beforeIdentities = before.map(::diagnosticMessageIdentity)
    val afterIdentities = after.map(::diagnosticMessageIdentity)
    return CodexMessageIdentityObservation(
        beforeDigest = PersistentDiagnosticLog.shortHash(
            beforeIdentities.joinToString("\u001F")
        ).orEmpty(),
        afterDigest = PersistentDiagnosticLog.shortHash(
            afterIdentities.joinToString("\u001F")
        ).orEmpty(),
        beforeSample = diagnosticMessageIdentitySample(beforeIdentities),
        afterSample = diagnosticMessageIdentitySample(afterIdentities),
        removed = diagnosticMessageIdentityDelta(beforeIdentities, afterIdentities),
        added = diagnosticMessageIdentityDelta(afterIdentities, beforeIdentities)
    )
}

/**
 * Central observation seam for every MutableStateFlow writer.  StateFlow's
 * update{} helper uses compareAndSet(), so intercepting that operation covers
 * the existing ViewModel writers without rewriting their behavior or call
 * sites.  Direct value/emit/tryEmit writes are covered as well.
 */
private class CodexUiStateDiagnosticFlow(
    private val delegate: MutableStateFlow<CodexUiState>,
    private val selectionGeneration: () -> Long
) : MutableStateFlow<CodexUiState> by delegate {
    override var value: CodexUiState
        get() = delegate.value
        set(value) {
            val before = delegate.value
            delegate.value = value
            recordWrite(before, value, "value_set")
        }

    override fun compareAndSet(expect: CodexUiState, update: CodexUiState): Boolean {
        val updated = delegate.compareAndSet(expect, update)
        if (updated) {
            recordWrite(expect, update, "compare_and_set")
        }
        return updated
    }

    override suspend fun emit(value: CodexUiState) {
        val before = delegate.value
        delegate.emit(value)
        recordWrite(before, value, "emit")
    }

    override fun tryEmit(value: CodexUiState): Boolean {
        val before = delegate.value
        val emitted = delegate.tryEmit(value)
        if (emitted) {
            recordWrite(before, value, "try_emit")
        }
        return emitted
    }

    private fun recordWrite(
        before: CodexUiState,
        after: CodexUiState,
        operation: String
    ) {
        if (!PersistentDiagnosticLog.isEnabled()) return
        val beforeTrace = traceOf(before)
        val afterTrace = traceOf(after)
        if (beforeTrace == afterTrace) return

        val identityObservationReason = when {
            beforeTrace.activeConversationKey != afterTrace.activeConversationKey ->
                "active_conversation_changed"
            afterTrace.messageCount < beforeTrace.messageCount ->
                "message_count_decreased"
            beforeTrace.messageCount != afterTrace.messageCount &&
                (isTerminalCodexSurfaceStatus(beforeTrace.surfaceStatus) ||
                    isTerminalCodexSurfaceStatus(afterTrace.surfaceStatus)) ->
                "terminal_message_count_changed"
            else -> null
        }
        val identityObservation = if (identityObservationReason != null) {
            observeMessageIdentities(before.messages, after.messages)
        } else {
            null
        }

        val callsite = Throwable().stackTrace.firstOrNull { frame ->
            frame.className.startsWith("com.termlink.app.codex.CodexViewModel")
        }
        val writer = callsite?.let { frame ->
            "${frame.className.substringAfterLast('.')}.${frame.methodName}"
        } ?: "unknown"
        val reason = callsite?.let { frame ->
            "ui_state_$operation@${frame.fileName ?: "unknown"}:${frame.lineNumber}"
        } ?: "ui_state_$operation@unknown"

        val fields = mutableMapOf<String, Any?>(
            "writer" to writer,
            "reason" to reason,
            "operation" to operation,
            "selectionGeneration" to selectionGeneration(),
            "beforeActiveConversationKey" to beforeTrace.activeConversationKey,
            "afterActiveConversationKey" to afterTrace.activeConversationKey,
            "beforeMessageOwnerKey" to beforeTrace.messageOwnerKey,
            "afterMessageOwnerKey" to afterTrace.messageOwnerKey,
            "beforeMessageCount" to beforeTrace.messageCount,
            "afterMessageCount" to afterTrace.messageCount,
            "beforeCacheOwnerKey" to beforeTrace.cacheOwnerKey,
            "afterCacheOwnerKey" to afterTrace.cacheOwnerKey,
            "beforeCacheCount" to beforeTrace.cacheCount,
            "afterCacheCount" to afterTrace.cacheCount,
            "beforeLiveOwnerKey" to beforeTrace.liveOwnerKey,
            "afterLiveOwnerKey" to afterTrace.liveOwnerKey,
            "beforeLiveCount" to beforeTrace.liveCount,
            "afterLiveCount" to afterTrace.liveCount,
            "beforeSurfaceOwnerKey" to beforeTrace.surfaceOwnerKey,
            "afterSurfaceOwnerKey" to afterTrace.surfaceOwnerKey,
            "beforeSurfaceItemCount" to beforeTrace.surfaceItemCount,
            "afterSurfaceItemCount" to afterTrace.surfaceItemCount,
            "beforeSurfaceRevision" to beforeTrace.surfaceRevision,
            "afterSurfaceRevision" to afterTrace.surfaceRevision,
            "beforeSurfaceDesynced" to beforeTrace.surfaceDesynced,
            "afterSurfaceDesynced" to afterTrace.surfaceDesynced,
            "beforeSurfaceItemsTruncated" to beforeTrace.surfaceItemsTruncated,
            "afterSurfaceItemsTruncated" to afterTrace.surfaceItemsTruncated,
            "beforeSurfaceStatus" to beforeTrace.surfaceStatus,
            "afterSurfaceStatus" to afterTrace.surfaceStatus
        )
        identityObservation?.let { observation ->
            fields += mapOf(
                "messageIdentityObserved" to true,
                "messageIdentityObservationReason" to identityObservationReason,
                "beforeMessageIdentityDigest" to observation.beforeDigest,
                "afterMessageIdentityDigest" to observation.afterDigest,
                "beforeMessageIdentitySample" to observation.beforeSample,
                "afterMessageIdentitySample" to observation.afterSample,
                "messageIdentityRemovedCount" to observation.removed.totalCount,
                "messageIdentityRemoved" to observation.removed.values.joinToString(","),
                "messageIdentityAddedCount" to observation.added.totalCount,
                "messageIdentityAdded" to observation.added.values.joinToString(","),
                "messageIdentityDeltaTruncated" to (
                    observation.removed.totalCount > observation.removed.values.size ||
                        observation.added.totalCount > observation.added.values.size
                    )
            )
        }

        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.ui_state.writer_trace",
            fields
        )
    }

    private fun traceOf(state: CodexUiState): CodexUiStateDiagnosticTrace {
        val activeConversationId = state.activeConversationId
        val liveOwner = state.liveAuthoritativeConversationId
        val surface = state.ipcSurfaceSnapshot
        return CodexUiStateDiagnosticTrace(
            activeConversationKey = PersistentDiagnosticLog.shortHash(activeConversationId),
            messageOwnerKey = PersistentDiagnosticLog.shortHash(activeConversationId ?: state.threadId),
            messageCount = state.messages.size,
            cacheOwnerKey = PersistentDiagnosticLog.shortHash(state.historyCacheState.conversationId),
            cacheCount = state.cachedCanonicalMessages.size,
            liveOwnerKey = PersistentDiagnosticLog.shortHash(liveOwner),
            liveCount = if (liveOwner != null) state.messages.size else 0,
            surfaceOwnerKey = PersistentDiagnosticLog.shortHash(surface?.conversationId),
            surfaceItemCount = surface?.items?.size ?: 0,
            surfaceRevision = surface?.revision ?: -1,
            surfaceDesynced = surface?.desynced == true,
            surfaceItemsTruncated = surface?.itemsTruncated == true,
            surfaceStatus = surface?.status
        )
    }
}

private fun isTerminalCodexSurfaceStatus(status: String?): Boolean {
    return status?.trim()?.lowercase() in setOf(
        "completed",
        "done",
        "finished",
        "failed",
        "error",
        "cancelled",
        "canceled",
        "interrupted",
        "idle"
    )
}

internal const val CODEX_FAST_MODE_REASONING_EFFORT = "low"

/**
 * Transport failures caused by an unavailable network are expected while the
 * app is offline.  They must not be appended as chat error cards: cached
 * history remains usable and the connection status/retry affordance already
 * communicates the transient state.
 */
internal fun isTransientWebSocketFailureMessage(message: String, code: Int?): Boolean {
    if (code != null && code >= 400) {
        return false
    }
    val normalized = message.trim().lowercase()
    if (normalized.isEmpty()) {
        return false
    }
    return normalized.contains("broken pipe") ||
        normalized.contains("software caused connection abort") ||
        normalized.contains("socket closed") ||
        normalized.contains("connection reset") ||
        normalized.contains("connection abort") ||
        normalized.contains("closed channel") ||
        normalized.contains("failed to connect") ||
        normalized.contains("unable to resolve host") ||
        normalized.contains("no route to host") ||
        normalized.contains("network is unreachable") ||
        normalized.contains("enetunreach") ||
        normalized.contains("ehostunreach") ||
        normalized.contains("connection timed out") ||
        normalized.contains("connect timed out")
}

internal fun applyConnectionStateToUiState(
    state: CodexUiState,
    nextState: ConnectionState
): CodexUiState = state.copy(
    connectionState = nextState,
    connectionErrorMessage = if (nextState == ConnectionState.CONNECTED) null else state.connectionErrorMessage
)

internal fun isRecoverableWebSocketFailure(throwable: Throwable, code: Int?): Boolean {
    if (code != null && code >= 400) return false
    if (throwable is SSLException || throwable is ProtocolException) return false
    return throwable is IOException || isTransientWebSocketFailureMessage(throwable.message.orEmpty(), code)
}

internal fun applyWebSocketFailureToUiState(
    state: CodexUiState,
    throwable: Throwable,
    code: Int?,
    connectionHint: String
): CodexUiState {
    val message = throwable.message ?: "WebSocket failure"
    if (isRecoverableWebSocketFailure(throwable, code)) {
        return state.copy(connectionErrorMessage = connectionHint)
    }
    return state.copy(
        errorMessage = message,
        connectionErrorMessage = null,
        currentTurnId = null,
        planWorkflow = CodexPlanWorkflowState(),
        executionWatch = CodexExecutionWatchState(),
        runtimePanel = state.runtimePanel.copy(warning = message, warningTone = "error")
    )
}

internal enum class MobileSlashAction {
    SHOW_MODEL_PICKER,
    PLAN,
    FAST,
    SHOW_SKILLS,
    COMPACT,
    NEW_THREAD,
    FORK_THREAD,
    SKILL,
    MENTION,
    UNSUPPORTED
}

internal fun resolveMobileSlashAction(command: String): MobileSlashAction = when (command.trim().lowercase()) {
    "/model" -> MobileSlashAction.SHOW_MODEL_PICKER
    "/plan" -> MobileSlashAction.PLAN
    "/fast" -> MobileSlashAction.FAST
    "/skills" -> MobileSlashAction.SHOW_SKILLS
    "/compact" -> MobileSlashAction.COMPACT
    "/new" -> MobileSlashAction.NEW_THREAD
    "/fork" -> MobileSlashAction.FORK_THREAD
    "/skill" -> MobileSlashAction.SKILL
    "/mention" -> MobileSlashAction.MENTION
    else -> MobileSlashAction.UNSUPPORTED
}

internal fun resolveCodexThreadHistoryTitleForUi(thread: JSONObject?): String {
    thread ?: return ""
    thread.optStringOrNullCompat("title")?.let { return it }
    thread.optStringOrNullCompat("name")?.let { return it }
    val preview = thread.optStringOrNullCompat("preview")
        ?.replace(Regex("\\s+"), " ")
        ?.trim()
        ?.takeIf { it.isNotEmpty() }
        ?: return ""
    if (preview.length <= THREAD_HISTORY_PREVIEW_MAX_LENGTH) return preview
    return preview
        .take(THREAD_HISTORY_PREVIEW_MAX_LENGTH - 1)
        .trimEnd()
        .plus("…")
}

internal fun resolveCodexThreadHistoryPreviewForCache(thread: JSONObject?): String? {
    thread ?: return null
    val value = listOf(
        "preview", "lastMessage", "last_message", "summary", "message"
    ).asSequence()
        .mapNotNull { key -> thread.optStringOrNullCompat(key) }
        .map { it.replace(Regex("\\s+"), " ").trim() }
        .firstOrNull { it.isNotEmpty() }
        ?: return null
    return value.take(THREAD_HISTORY_PREVIEW_MAX_LENGTH)
}

internal fun isFastReasoningEffort(reasoningEffort: String?): Boolean =
    reasoningEffort?.trim()?.equals(CODEX_FAST_MODE_REASONING_EFFORT, ignoreCase = true) == true

private fun sanitizeProfileOrigin(baseUrl: String): String? = runCatching {
    val uri = java.net.URI(baseUrl.trim())
    val scheme = uri.scheme?.lowercase() ?: return@runCatching null
    val host = uri.host ?: return@runCatching null
    val port = if (uri.port > 0) ":${uri.port}" else ""
    "$scheme://$host$port"
}.getOrNull()

internal fun isFastModeActive(state: CodexUiState): Boolean {
    return isFastReasoningEffort(state.nextTurnOverrides.reasoningEffort)
}

internal fun nextTurnOverridesForFastModeToggle(state: CodexUiState): NextTurnOverrides {
    val fastModeActive = isFastModeActive(state)
    return state.nextTurnOverrides.copy(
        reasoningEffort = if (fastModeActive) {
            null
        } else {
            CODEX_FAST_MODE_REASONING_EFFORT
        }
    )
}

internal data class ThreadReadyUiTransition(
    val currentTurnId: String?,
    val messages: List<ChatMessage>,
    val runtimePanel: CodexRuntimePanelState
)

internal data class ThreadReadMergeTransition(
    val threadId: String?,
    val currentTurnId: String?,
    val messages: List<ChatMessage>
)

/**
 * Identity for every asynchronous history/cache operation.  Conversation ids
 * are only unique inside an endpoint, and the same task can be selected again
 * after A→B→A, so both dimensions are required in addition to the generation.
 */
internal data class CodexHistorySelectionKey(
    val endpointId: String,
    val conversationId: String,
    val generation: Long
)

/**
 * Step 3 keeps canonical-tail freshness entirely separate from the ordinary
 * history-sync/recovery state machine.  These values are deliberately private
 * to the selected conversation and are never rendered as a history-network
 * state: `NEEDS_RECONCILE` is only the hand-off signal for the later durable
 * reconciliation step.
 */
internal enum class CanonicalTailValidationOutcome {
    UP_TO_DATE,
    NEEDS_RECONCILE,
    UNSUPPORTED,
    FAILED
}

internal enum class CanonicalTailValidationRequestDecision {
    NOOP,
    WAIT_FOR_HEALTHY_IPC,
    WAIT_FOR_CAPABILITY,
    WAIT_FOR_METADATA,
    SETTLE_UNSUPPORTED,
    REQUEST
}

internal fun canonicalTailValidationOutcomeFromWire(state: String?): CanonicalTailValidationOutcome =
    when (state?.trim()?.lowercase()) {
        "up_to_date" -> CanonicalTailValidationOutcome.UP_TO_DATE
        "needs_reconcile" -> CanonicalTailValidationOutcome.NEEDS_RECONCILE
        "unsupported" -> CanonicalTailValidationOutcome.UNSUPPORTED
        else -> CanonicalTailValidationOutcome.FAILED
    }

internal fun isCanonicalTailValidationSyncPurpose(purpose: String?): Boolean =
    purpose?.trim()?.equals("tail_validation", ignoreCase = true) == true

/**
 * Pure gate used by the ViewModel and JVM regression tests.  It does not
 * decide whether to reconcile; it only decides whether this selection can
 * issue its one read-only validation intent.
 */
internal fun canonicalTailValidationRequestDecision(
    key: CodexHistorySelectionKey?,
    completeStaticCache: Boolean,
    healthyIpcAuthority: Boolean,
    metadataReadyKey: CodexHistorySelectionKey?,
    capabilityKnown: Boolean,
    capabilityEnabled: Boolean,
    capabilityVersion: Int,
    inFlightKey: CodexHistorySelectionKey?,
    settledKey: CodexHistorySelectionKey?
): CanonicalTailValidationRequestDecision = when {
    key == null || !completeStaticCache || inFlightKey == key || settledKey == key ->
        CanonicalTailValidationRequestDecision.NOOP
    !healthyIpcAuthority -> CanonicalTailValidationRequestDecision.WAIT_FOR_HEALTHY_IPC
    !capabilityKnown -> CanonicalTailValidationRequestDecision.WAIT_FOR_CAPABILITY
    !capabilityEnabled || capabilityVersion != 1 ->
        CanonicalTailValidationRequestDecision.SETTLE_UNSUPPORTED
    metadataReadyKey != key -> CanonicalTailValidationRequestDecision.WAIT_FOR_METADATA
    else -> CanonicalTailValidationRequestDecision.REQUEST
}

internal fun shouldCommitCachedHistorySelectionToUiState(
    state: CodexUiState,
    key: CodexHistorySelectionKey,
    pendingKey: CodexHistorySelectionKey?,
    currentEndpointId: String?,
    currentGeneration: Long
): Boolean {
    val targetId = normalizeCodexThreadId(key.conversationId) ?: return false
    val activeId = normalizeCodexThreadId(state.activeConversationId)
    val threadId = normalizeCodexThreadId(state.threadId)
    val provenanceOwners = listOfNotNull(
        normalizeCodexThreadId(state.historyCacheState.conversationId),
        normalizeCodexThreadId(state.liveAuthoritativeConversationId),
        normalizeCodexThreadId(state.ipcSurfaceSnapshot?.conversationId)
    )
    return pendingKey == key &&
        currentEndpointId?.trim() == key.endpointId &&
        currentGeneration == key.generation &&
        activeId == targetId &&
        (threadId == null || threadId == targetId) &&
        provenanceOwners.none { it != targetId }
}

internal data class CanonicalTurnRuntimeProjection(
    val status: String,
    val currentTurnId: String?,
    val source: String
)

internal enum class IpcAuthorityMode {
    IPC_AUTHORITATIVE,
    AWAITING_IPC_SURFACE,
    IPC_DESYNCED,
    IPC_OFFLINE
}

internal fun shouldSkipDuplicateHistoryCacheHydration(
    committedCacheKey: CodexHistorySelectionKey?,
    requestedCacheKey: CodexHistorySelectionKey
): Boolean = committedCacheKey == requestedCacheKey

internal fun resolveIpcAuthorityMode(
    ipcOnline: Boolean,
    matchingSurfaceAvailable: Boolean,
    surfaceDesynced: Boolean,
    awaitingFreshSurface: Boolean
): IpcAuthorityMode = when {
    !ipcOnline -> IpcAuthorityMode.IPC_OFFLINE
    matchingSurfaceAvailable && surfaceDesynced -> IpcAuthorityMode.IPC_DESYNCED
    matchingSurfaceAvailable && !awaitingFreshSurface -> IpcAuthorityMode.IPC_AUTHORITATIVE
    else -> IpcAuthorityMode.AWAITING_IPC_SURFACE
}

internal fun canonicalAgentPhaseIndicatesActivity(phase: String?): Boolean {
    val normalized = phase
        ?.trim()
        ?.lowercase()
        ?.replace("_", "")
        ?.replace("-", "")
        ?.replace(" ", "")
        .orEmpty()
    return normalized in setOf("analysis", "commentary", "tool", "toolcall")
}

internal fun shouldPreserveCanonicalActivityRuntime(
    incomingStatus: String?,
    currentStatus: String?,
    matchingOwnerSurfaceAvailable: Boolean,
    activityThreadId: String?,
    targetThreadId: String?,
    millisSinceCanonicalActivity: Long,
    activityWindowMillis: Long = 30_000L
): Boolean {
    if (matchingOwnerSurfaceAvailable) return false
    if (!currentStatus.equals("running", ignoreCase = true)) return false
    val normalizedIncoming = incomingStatus
        ?.trim()
        ?.lowercase()
        ?.replace("_", "")
        ?.replace("-", "")
        ?.replace(" ", "")
        .orEmpty()
    val incomingIsTerminal = normalizedIncoming in setOf(
        "idle", "completed", "complete", "failed", "interrupted", "cancelled", "canceled"
    )
    return incomingIsTerminal &&
        normalizeCodexThreadId(activityThreadId) == normalizeCodexThreadId(targetThreadId) &&
        millisSinceCanonicalActivity in 0L..activityWindowMillis
}

internal fun projectCanonicalTurnRuntime(
    threadStatus: String? = null,
    turnStatus: String?,
    turnId: String?,
    matchingOwnerSurfaceAvailable: Boolean,
    hasActiveItem: Boolean = false,
    latestAgentPhase: String? = null,
    canonicalSnapshotChanged: Boolean = false,
    millisSinceCanonicalChange: Long = Long.MAX_VALUE,
    activityWindowMillis: Long = 30_000L
): CanonicalTurnRuntimeProjection? {
    if (matchingOwnerSurfaceAvailable) return null
    fun normalize(value: String?): String = value
        ?.trim()
        ?.lowercase()
        ?.replace("_", "")
        ?.replace("-", "")
        ?.replace(" ", "")
        .orEmpty()
    val normalizedThreadStatus = normalize(threadStatus)
    val normalizedTurnStatus = normalize(turnStatus)
    val normalizedPhase = normalize(latestAgentPhase)
    val explicitActive = normalizedThreadStatus in setOf("active", "running", "inprogress") ||
        normalizedTurnStatus in setOf("inprogress", "running", "active", "started") ||
        hasActiveItem
    if (explicitActive) {
        return CanonicalTurnRuntimeProjection(
            status = "running",
            currentTurnId = turnId?.trim()?.takeIf(String::isNotEmpty),
            source = "canonical-explicit-active"
        )
    }
    if (normalizedPhase == "finalanswer" || normalizedPhase == "final") {
        return CanonicalTurnRuntimeProjection(
            status = "idle",
            currentTurnId = null,
            source = "canonical-final-answer"
        )
    }
    if (canonicalSnapshotChanged || millisSinceCanonicalChange <= activityWindowMillis) {
        return CanonicalTurnRuntimeProjection(
            status = "running",
            currentTurnId = turnId?.trim()?.takeIf(String::isNotEmpty),
            source = "canonical-activity"
        )
    }
    val explicitTerminal = normalizedThreadStatus in setOf("idle", "completed", "complete", "failed", "interrupted") ||
        normalizedTurnStatus in setOf("completed", "complete", "failed", "interrupted", "cancelled", "canceled")
    return if (explicitTerminal) {
        CanonicalTurnRuntimeProjection(
            status = "idle",
            currentTurnId = null,
            source = "canonical-explicit-terminal"
        )
    } else {
        null
    }
}

private const val REMEMBERED_CONFIG_PREFS = "codex_task_config_overrides"
private const val GOAL_HISTORY_PREFS = "codex_goal_history"

internal fun rememberedTaskConfigKey(profileId: String?, threadId: String?): String? {
    val profile = profileId?.trim()?.takeIf(String::isNotEmpty) ?: return null
    val thread = normalizeCodexThreadId(threadId) ?: return null
    return "$profile::$thread"
}

internal fun encodeRememberedNextTurnOverrides(overrides: NextTurnOverrides): String? {
    val json = JSONObject()
    overrides.model?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("model", it) }
    overrides.reasoningEffort?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("reasoningEffort", it) }
    overrides.sandbox?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("sandbox", it) }
    overrides.approvalPolicy?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("approvalPolicy", it) }
    overrides.approvalsReviewer?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("approvalsReviewer", it) }
    overrides.permissionProfile?.trim()?.takeIf(String::isNotEmpty)?.let { json.put("permissionProfile", it) }
    if (overrides.useConfigPermissions) json.put("useConfigPermissions", true)
    return json.takeIf { it.length() > 0 }?.toString()
}

internal fun decodeRememberedNextTurnOverrides(raw: String?): NextTurnOverrides {
    if (raw.isNullOrBlank()) return NextTurnOverrides()
    return runCatching {
        val json = JSONObject(raw)
        NextTurnOverrides(
            model = json.optStringOrNullCompat("model"),
            reasoningEffort = json.optStringOrNullCompat("reasoningEffort"),
            sandbox = json.optStringOrNullCompat("sandbox"),
            approvalPolicy = json.optStringOrNullCompat("approvalPolicy"),
            approvalsReviewer = json.optStringOrNullCompat("approvalsReviewer"),
            permissionProfile = json.optStringOrNullCompat("permissionProfile"),
            useConfigPermissions = json.optBoolean("useConfigPermissions", false)
        )
    }.getOrDefault(NextTurnOverrides())
}

internal fun overridesForConversationSwitch(
    currentConversationId: String?,
    targetConversationId: String?,
    currentOverrides: NextTurnOverrides,
    rememberedOverrides: NextTurnOverrides
): NextTurnOverrides {
    if (normalizeCodexThreadId(currentConversationId) == normalizeCodexThreadId(targetConversationId)) {
        return currentOverrides
    }
    val newConversationIsBeingCreated = normalizeCodexThreadId(currentConversationId) == null &&
        encodeRememberedNextTurnOverrides(rememberedOverrides) == null &&
        encodeRememberedNextTurnOverrides(currentOverrides) != null
    return if (newConversationIsBeingCreated) currentOverrides else rememberedOverrides
}

internal fun shouldBlockPlainTextFallbackForIpcConversationState(
    state: CodexUiState,
    @Suppress("UNUSED_PARAMETER") isPlanMode: Boolean,
    @Suppress("UNUSED_PARAMETER") hasAttachments: Boolean,
    @Suppress("UNUSED_PARAMETER") hasFileMentions: Boolean
): Boolean {
    val hasIpcContext = state.ipcOnline || state.ipcClientId != null || state.ipcSurfaceSnapshot != null
    return hasIpcContext &&
        !state.awaitingNewThreadIpcSurface &&
        !state.activeConversationId.isNullOrBlank()
}

internal fun applyIpcStatusToUiState(
    state: CodexUiState,
    status: CodexIpcStatus
): CodexUiState {
    return state.copy(
        ipcSupported = status.supported,
        ipcOnline = status.online,
        ipcClientId = status.clientId
    )
}

internal fun shouldUseIpcFollowerTransportState(state: CodexUiState): Boolean {
    val transportAvailable = state.ipcOnline ||
        state.ipcSurfaceSnapshot?.ownerKind.equals("termlink", ignoreCase = true)
    return transportAvailable &&
        !state.awaitingNewThreadIpcSurface &&
        state.followerModeEnabled &&
        state.followerActiveSendAllowed &&
        !state.activeConversationId.isNullOrBlank()
}

internal fun goalControlActionForStatus(status: String?): String =
    if (status.equals("paused", ignoreCase = true)) "resume" else "pause"

internal fun shouldUseIpcFollowerSendTransportState(state: CodexUiState): Boolean {
    val activeConversationId = normalizeCodexThreadId(state.activeConversationId) ?: return false
    val threadId = normalizeCodexThreadId(state.threadId) ?: return false
    return activeConversationId == threadId &&
        state.followerModeEnabled &&
        state.followerActiveSendAllowed &&
        activeConversationId.isNotEmpty()
}

internal fun shouldPromoteConnectionStateFromWebSocketMessage(
    connectionState: ConnectionState
): Boolean = connectionState != ConnectionState.CONNECTED

internal fun resolveCodexStateThreadId(
    serverThreadId: String?,
    activeConversationId: String?,
    currentThreadId: String?
): String? = serverThreadId ?: activeConversationId ?: currentThreadId

internal fun shouldResubscribeForCodexStateThreadChange(
    previousThreadId: String?,
    serverThreadId: String?
): Boolean = serverThreadId != null && serverThreadId != previousThreadId

internal fun applyConversationStatusChangedToUiState(
    state: CodexUiState,
    conversationId: String?,
    status: String?
): CodexUiState {
    val normalizedStatus = status?.trim().orEmpty()
    if (normalizedStatus.isEmpty()) return state
    val normalizedConversationId = conversationId?.trim().orEmpty()
    val activeConversationId = state.activeConversationId?.trim().orEmpty()
    if (normalizedConversationId.isNotEmpty() && activeConversationId.isNotEmpty() && normalizedConversationId != activeConversationId) {
        return state
    }
    return state.copy(
        activeConversationId = normalizedConversationId.ifEmpty { state.activeConversationId },
        status = normalizedStatus
    )
}

internal fun shouldRequestActiveFollowerModeEnable(mode: CodexFollowerMode): Boolean =
    mode.activeSendAllowed && !mode.enabled

internal fun chooseInitialIpcConversationForUi(
    conversations: List<CodexIpcConversationSummary>,
    threadId: String?,
    cwd: String?
): CodexIpcConversationSummary? {
    if (conversations.isEmpty()) return null
    val normalizedThreadId = threadId?.trim().orEmpty()
    if (normalizedThreadId.isNotEmpty()) {
        conversations.firstOrNull { it.conversationId == normalizedThreadId }?.let { return it }
    }

    val normalizedCwd = cwd?.trim()?.replace('\\', '/')?.trimEnd('/')?.lowercase(Locale.ROOT).orEmpty()
    if (normalizedCwd.isNotEmpty()) {
        conversations
            .filter { it.cwd?.trim()?.replace('\\', '/')?.trimEnd('/')?.lowercase(Locale.ROOT) == normalizedCwd }
            .maxByOrNull { it.updatedAt }
            ?.let { return it }
    }

    conversations.firstOrNull { it.hasActiveGoal }?.let { return it }
    return conversations.maxByOrNull { it.updatedAt }
}

internal fun selectIpcConversationForUi(
    conversations: List<CodexIpcConversationSummary>,
    activeConversationId: String?,
    threadId: String?,
    cwd: String?,
    awaitingNewThreadIpcSurface: Boolean = false
): CodexIpcConversationSummary? {
    val active = activeConversationId?.trim().orEmpty()
    val currentThread = threadId?.trim().orEmpty()
    if (awaitingNewThreadIpcSurface) {
        val awaitedThreadId = active.ifEmpty { currentThread }
        return conversations.firstOrNull { it.conversationId == awaitedThreadId }
    }
    if (active.isNotEmpty()) {
        conversations.firstOrNull { it.conversationId == active }?.let { return it }
    }
    return chooseInitialIpcConversationForUi(conversations, threadId, cwd)
}

/**
 * Thread history is scoped by the Codex working directory.  Codex can report
 * the same path with Windows separators, POSIX separators, or a trailing
 * separator, so compare a conservative normalized representation instead of
 * the display value.
 */
internal fun normalizeThreadHistoryCwdForUi(cwd: String?): String =
    cwd?.trim()
        ?.replace('\\', '/')
        ?.trimEnd('/')
        ?.lowercase(Locale.ROOT)
        .orEmpty()

/**
 * Keep cached task metadata inside the currently selected Codex workspace.
 * An entry without cwd is intentionally excluded when a scope is known: old
 * cache-migration rows must not leak into another workspace's task list.
 */
internal fun filterThreadHistoryEntriesForCwd(
    entries: List<CodexThreadHistoryEntry>,
    cwd: String?
): List<CodexThreadHistoryEntry> {
    val normalizedCwd = normalizeThreadHistoryCwdForUi(cwd)
    if (normalizedCwd.isEmpty()) return entries
    return entries.filter { entry ->
        normalizeThreadHistoryCwdForUi(entry.cwd) == normalizedCwd
    }
}

/**
 * A thread/list request already carries the current cwd.  Some Codex
 * versions omit cwd on individual metadata rows even though the request was
 * correctly scoped; attach the request scope to those rows before caching.
 */
internal fun scopeRemoteThreadHistoryEntriesForCwd(
    entries: List<CodexThreadHistoryEntry>,
    cwd: String?
): List<CodexThreadHistoryEntry> {
    val normalizedCwd = normalizeThreadHistoryCwdForUi(cwd)
    if (normalizedCwd.isEmpty()) return entries
    return entries.mapNotNull { entry ->
        val entryCwd = normalizeThreadHistoryCwdForUi(entry.cwd)
        when {
            entryCwd.isEmpty() -> entry.copy(cwd = cwd?.trim())
            entryCwd == normalizedCwd -> entry
            else -> null
        }
    }
}

internal fun shouldRequireExactIpcConversationSelection(
    pinnedConversationId: String?,
    activeConversationId: String?,
    threadId: String?
): Boolean {
    val pinned = pinnedConversationId?.trim().orEmpty()
    if (pinned.isEmpty()) return false
    return pinned == activeConversationId?.trim().orEmpty() ||
        pinned == threadId?.trim().orEmpty()
}

/**
 * A history row selection is an explicit user intent.  While it is pending,
 * and while the selected task remains pinned, an older session-level
 * codex_state/binding/ready snapshot must not move the UI back to the task
 * that happened to be bound before the click.
 */
internal fun shouldPreserveExplicitHistorySelection(
    pendingHistoryResumeThreadId: String?,
    pinnedConversationId: String? = null,
    activeConversationId: String?,
    incomingConversationId: String?
): Boolean {
    val pending = normalizeCodexThreadId(pendingHistoryResumeThreadId)
        ?: normalizeCodexThreadId(pinnedConversationId)
        ?: return false
    val active = normalizeCodexThreadId(activeConversationId) ?: return false
    val incoming = normalizeCodexThreadId(incomingConversationId) ?: return false
    return pending == active && incoming != pending
}

/**
 * Selection protection for session events that may not carry a conversation id.
 *
 * During a cache-first history switch the gateway can still be draining
 * notifications for the conversation that was bound before the click.  A
 * missing id is therefore ambiguous while the target selection is pending and
 * must not be allowed to mutate the selected task either.
 */
internal fun shouldSuppressExplicitHistorySessionEvent(
    pendingHistoryResumeThreadId: String?,
    pinnedConversationId: String? = null,
    activeConversationId: String?,
    incomingConversationId: String?
): Boolean {
    val pending = normalizeCodexThreadId(pendingHistoryResumeThreadId)
    val incoming = normalizeCodexThreadId(incomingConversationId)
    if (pending != null) {
        // The pending target is the user's latest explicit intent.  Keep it
        // authoritative even if an older unguarded event has already made the
        // UI's threadId/activeConversationId stale before this guard runs.
        return incoming == null || incoming != pending
    }
    val target = normalizeCodexThreadId(pinnedConversationId) ?: return false
    val active = normalizeCodexThreadId(activeConversationId) ?: return false
    if (target != active) return false
    // A null id is only suppressible during an explicit pending selection.
    // Once the selection has settled, global/unscoped notifications remain
    // valid even though the task stays pinned for stale-id protection.
    return incoming != null && incoming != target
}

/**
 * Match the gateway's thread-id extraction for forwarded notifications and
 * server requests, while also accepting the nested shapes used by turn/item
 * payloads from older Codex app-server versions.
 */
internal fun extractCodexThreadIdFromPayload(
    raw: JSONObject?,
    params: JSONObject?
): String? {
    val candidates = sequenceOf(
        raw?.optStringOrNullCompat("threadId"),
        raw?.optStringOrNullCompat("conversationId"),
        params?.optStringOrNullCompat("threadId"),
        params?.optStringOrNullCompat("conversationId"),
        params?.optJSONObject("thread")?.optStringOrNullCompat("id"),
        params?.optJSONObject("turn")?.optStringOrNullCompat("threadId"),
        params?.optJSONObject("turn")?.optJSONObject("thread")?.optStringOrNullCompat("id"),
        params?.optJSONObject("item")?.optStringOrNullCompat("threadId"),
        params?.optJSONObject("item")?.optJSONObject("thread")?.optStringOrNullCompat("id")
    )
    return candidates.firstNotNullOfOrNull { normalizeCodexThreadId(it) }
}

/**
 * A durable `complete` checkpoint is only a fast-path proof when the rows it
 * describes are still present locally.  A process kill/migration or an older
 * cache schema can leave the conversation row behind while its item rows are
 * missing.  Sending that stale proof makes Gateway answer `live` without a
 * delta, which is indistinguishable from a successful sync but leaves the UI
 * with no正文.  Downgrade only this inconsistent checkpoint to an incomplete
 * one; the normal manifest/delta path then repairs it without touching the
 * remote task or the realtime authority.
 */
internal fun normalizeHistoryCheckpointForAvailableItems(
    checkpoint: CodexConversationCheckpoint?,
    availableDurableItemCount: Int
): CodexHistorySyncCheckpoint {
    val available = availableDurableItemCount.coerceAtLeast(0)
    if (checkpoint == null) {
        return CodexHistorySyncCheckpoint(
            rootHash = null,
            itemCount = 0,
            complete = false
        )
    }
    val inconsistentCompleteCheckpoint = checkpoint.complete &&
        checkpoint.itemCount != available
    return if (inconsistentCompleteCheckpoint) {
        CodexHistorySyncCheckpoint(
            rootHash = null,
            itemCount = available,
            complete = false,
            providerMode = checkpoint.providerMode,
            providerIdentityHash = checkpoint.providerIdentityHash,
            rangeId = checkpoint.rangeId,
            rangeKind = checkpoint.rangeKind,
            newestAnchorKey = checkpoint.newestAnchorKey,
            newestAnchorHash = checkpoint.newestAnchorHash,
            oldestAnchorKey = checkpoint.oldestAnchorKey,
            oldestAnchorHash = checkpoint.oldestAnchorHash,
            nextOlderCursor = checkpoint.nextOlderCursor,
            coverageRoot = checkpoint.coverageRoot,
            hasMoreBefore = checkpoint.hasMoreBefore,
            coverageComplete = false
        )
    } else {
        CodexHistorySyncCheckpoint(
            rootHash = checkpoint.rootHash,
            itemCount = checkpoint.itemCount.coerceAtLeast(0),
            complete = checkpoint.complete,
            providerMode = checkpoint.providerMode,
            providerIdentityHash = checkpoint.providerIdentityHash,
            rangeId = checkpoint.rangeId,
            rangeKind = checkpoint.rangeKind,
            newestAnchorKey = checkpoint.newestAnchorKey,
            newestAnchorHash = checkpoint.newestAnchorHash,
            oldestAnchorKey = checkpoint.oldestAnchorKey,
            oldestAnchorHash = checkpoint.oldestAnchorHash,
            nextOlderCursor = checkpoint.nextOlderCursor,
            coverageRoot = checkpoint.coverageRoot,
            hasMoreBefore = checkpoint.hasMoreBefore,
            coverageComplete = checkpoint.coverageComplete
        )
    }
}

/**
 * Route 3 must still be able to identify the local tail when an older cache
 * row predates the stored anchor columns.  The item rows already contain the
 * same stable key/hash, so derive only the display/replay checkpoint here;
 * this does not modify the durable checkpoint or ordinary history-sync lane.
 */
internal fun normalizeLiveReplayCheckpointForAvailableItems(
    checkpoint: CodexConversationCheckpoint?,
    durableItems: List<CodexHistoryItem>
): CodexHistorySyncCheckpoint {
    val durable = durableItems.filterNot { it.provisional }
    val normalized = normalizeHistoryCheckpointForAvailableItems(
        checkpoint = checkpoint,
        availableDurableItemCount = durable.size
    )
    val newest = durable.maxByOrNull { it.position } ?: return normalized
    val anchorItem = normalized.newestAnchorKey
        ?.let { key -> durable.firstOrNull { it.itemKey == key } }
    return normalized.copy(
        itemCount = maxOf(normalized.itemCount, durable.size),
        newestAnchorKey = normalized.newestAnchorKey ?: newest.itemKey,
        newestAnchorHash = normalized.newestAnchorHash
            ?: anchorItem?.contentHash
            ?: newest.contentHash
    )
}

internal data class SessionThreadBindingDecision(
    val appliesToCurrentSession: Boolean,
    val shouldSendActiveConversationSelection: Boolean
)

internal fun resolveSessionThreadBindingDecision(
    boundSessionId: String?,
    currentSessionId: String?
): SessionThreadBindingDecision {
    val bound = boundSessionId?.trim().orEmpty()
    val current = currentSessionId?.trim().orEmpty()
    val appliesToCurrentSession = bound.isEmpty() || bound == current
    return SessionThreadBindingDecision(
        appliesToCurrentSession = appliesToCurrentSession,
        // session_codex_thread_bound acknowledges a selection the client already sent.
        // Echoing it creates a self-sustaining A/B selection loop when older acks are queued.
        shouldSendActiveConversationSelection = false
    )
}

internal fun shouldAcceptSessionThreadBoundSelectionGeneration(
    hasSelectionGeneration: Boolean,
    selectionGeneration: Long?,
    currentSelectionGeneration: Long
): Boolean {
    if (!hasSelectionGeneration) return true
    return selectionGeneration == currentSelectionGeneration
}

internal fun shouldAwaitIpcSurfaceAfterThreadResumeResponse(
    targetThreadId: String?,
    pendingHydrationThreadId: String?
): Boolean {
    val target = targetThreadId?.trim().orEmpty()
    return target.isNotEmpty() && target == pendingHydrationThreadId?.trim().orEmpty()
}

internal fun resolveAwaitingIpcSurfaceAfterTargetState(
    currentlyAwaiting: Boolean,
    pendingHistoryResumeThreadId: String?,
    incomingThreadId: String?
): Boolean {
    if (!currentlyAwaiting) return false
    val pending = pendingHistoryResumeThreadId?.trim().orEmpty()
    val incoming = incomingThreadId?.trim().orEmpty()
    return !(pending.isNotEmpty() && pending == incoming)
}

internal fun shouldUseCanonicalThreadReadFallback(
    threadId: String?,
    activeConversationId: String?,
    authorityMode: IpcAuthorityMode,
    millisSinceAuthorityModeEntered: Long,
    surfaceWaitGraceMillis: Long,
    ipcStatusObserved: Boolean = true
): Boolean {
    if (!ipcStatusObserved) return false
    val targetThreadId = normalizeCodexThreadId(threadId) ?: return false
    val activeId = normalizeCodexThreadId(activeConversationId)
    if (activeId != null && activeId != targetThreadId) return false
    return when (authorityMode) {
        IpcAuthorityMode.IPC_AUTHORITATIVE -> false
        IpcAuthorityMode.IPC_OFFLINE,
        IpcAuthorityMode.IPC_DESYNCED -> true
        IpcAuthorityMode.AWAITING_IPC_SURFACE ->
            millisSinceAuthorityModeEntered >= surfaceWaitGraceMillis
    }
}

/**
 * Foreground recovery must not overtake the active-conversation handshake.
 * Ordinary history sync already waits for the subscription settle window; the
 * full-recovery escalation has to use the same fence, otherwise a reconnect or
 * a fast A→B selection can send recovery while Gateway still has the previous
 * active conversation.  For the normal awaiting-surface path, let the
 * accepted ordinary sync settle first so `conversation_not_active` cannot be
 * mistaken for a canonical recovery failure.  Explicit offline/desynced
 * states remain eligible immediately after the subscription fence.
 */
internal fun shouldStartForegroundHistoryRecovery(
    historyNeedsFullRecovery: Boolean,
    authorityMode: IpcAuthorityMode,
    activeSubscriptionSettling: Boolean,
    historySyncSettled: Boolean
): Boolean {
    if (!historyNeedsFullRecovery || activeSubscriptionSettling) return false
    return when (authorityMode) {
        IpcAuthorityMode.IPC_OFFLINE,
        IpcAuthorityMode.IPC_DESYNCED -> true
        IpcAuthorityMode.AWAITING_IPC_SURFACE -> historySyncSettled
        IpcAuthorityMode.IPC_AUTHORITATIVE -> false
    }
}

internal fun matchingIpcSurfaceProtectsRuntimeFromCodexState(
    ipcOnline: Boolean,
    targetThreadId: String?,
    surface: DesktopSurfaceSnapshot?
): Boolean = ipcOnline &&
    normalizeCodexThreadId(targetThreadId) != null &&
    normalizeCodexThreadId(targetThreadId) == normalizeCodexThreadId(surface?.conversationId)

internal fun mergeCanonicalStaticMetadataIntoAuthoritativeMessages(
    authoritativeMessages: List<ChatMessage>,
    canonicalMessages: List<ChatMessage>
): List<ChatMessage> = authoritativeMessages.map { authoritative ->
    if (authoritative.role != ChatMessage.Role.USER) return@map authoritative
    val canonical = canonicalMessages.firstOrNull { candidate ->
        candidate.role == ChatMessage.Role.USER &&
            (candidate.id == authoritative.id || candidate.content.trim() == authoritative.content.trim())
    } ?: return@map authoritative
    mergeCanonicalUserMessageMetadataForUi(
        canonical = authoritative,
        local = canonical
    )
}

internal fun shouldApplyCanonicalThreadReadResponse(
    currentThreadId: String?,
    incomingThreadId: String?
): Boolean {
    val current = normalizeCodexThreadId(currentThreadId)
    val incoming = normalizeCodexThreadId(incomingThreadId)
    return current == null || incoming == null || current == incoming
}

internal fun shouldApplyHistoryDeltaToUiState(
    state: CodexUiState,
    conversationId: String?
): Boolean {
    val active = normalizeCodexThreadId(state.activeConversationId)
    val incoming = normalizeCodexThreadId(conversationId)
    return active != null && active == incoming
}

internal fun shouldReplaceMessagesFromHistoryDeltaForUiState(
    state: CodexUiState,
    conversationId: String?
): Boolean {
    if (!shouldApplyHistoryDeltaToUiState(state, conversationId)) return false
    val incoming = normalizeCodexThreadId(conversationId) ?: return false
    val live = normalizeCodexThreadId(state.liveAuthoritativeConversationId)
    return live == null || (live == incoming && state.liveAuthoritativeDesynced)
}

/**
 * History is a static UI base while a healthy IPC surface is only the live
 * tail.  Keep the base visible instead of storing it solely in
 * [CodexUiState.cachedCanonicalMessages]; otherwise an active conversation
 * with a bounded/truncated surface can never scroll back to older正文 or
 * attachment chips.  The merge keeps authoritative live entries/tail and
 * refuses to carry a stale surface from another conversation across A→B.
 */
internal fun mergeCachedHistoryIntoLiveMessagesForUi(
    state: CodexUiState,
    conversationId: String?,
    cachedMessages: List<ChatMessage>
): List<ChatMessage> {
    if (!shouldApplyHistoryDeltaToUiState(state, conversationId)) return state.messages
    val incoming = normalizeCodexThreadId(conversationId) ?: return state.messages
    // `activeConversationId` alone is not enough during the small window in
    // which a late ready/binding event can have rewritten the thread id.  Do
    // not let a cache writer merge a body whose current thread identity is
    // known to be another conversation.  Returning the target cache (also
    // when it is empty) is the fail-closed path for that transition.
    val currentThreadId = normalizeCodexThreadId(state.threadId)
    if (currentThreadId != null && currentThreadId != incoming) {
        return cachedMessages
    }
    if (cachedMessages.isEmpty()) return state.messages
    val live = normalizeCodexThreadId(state.liveAuthoritativeConversationId)
    val matchingTruncatedSurfaceForHydrate = state.ipcSurfaceSnapshot?.takeIf { surface ->
        normalizeCodexThreadId(surface.conversationId) == incoming &&
            surface.itemsTruncated &&
            (surface.desynced || live == incoming)
    }
    fun mergeCachedHistoryWithLocalTail(): List<ChatMessage> {
        val merged = mergeCanonicalMessagesForUi(
            canonicalMessages = cachedMessages,
            currentMessages = state.messages,
            preserveLocalTail = true
        )
        val hydrateSurface = matchingTruncatedSurfaceForHydrate
        if (hydrateSurface != null && state.messages.isNotEmpty()) {
            // Hydrate must not turn an already displayed bounded surface into
            // a different representation (for example, 12 command items into
            // 3 synthetic batches).  Start from the current displayed body,
            // reproject the same surface without collapsing, then prepend only
            // canonical rows that are not represented by that body.
            val displayedSurfaceMessages = mergeSurfaceItems(
                existing = state.messages,
                surfaceItems = hydrateSurface.items,
                surfaceStatus = hydrateSurface.status,
                latestTurnId = hydrateSurface.latestTurnId,
                preserveExisting = true,
                preserveExistingItemIdentity = true
            )
            val missingCanonicalMessages = merged.filter { canonical ->
                displayedSurfaceMessages.none { displayed ->
                    displayed.id == canonical.id ||
                        historyItemAliasesForUiMessage(displayed).contains(canonical.id) ||
                        canonical.operationBatchMemberIds.any { memberId ->
                            historyItemAliasesForUiMessage(displayed).contains(memberId)
                        } ||
                        areSameCanonicalAndSurfaceMessageForUi(canonical, displayed) ||
                        messagesEquivalentForConvergenceForUi(canonical, displayed)
                }
            }
            return deduplicateChatMessagesByIdForUi(
                missingCanonicalMessages + displayedSurfaceMessages
            )
        }
        val provisionalSurface = hydrateSurface?.takeIf { it.desynced } ?: return merged
        // A matching desynced surface is display-only, but its items have
        // already been projected into the active conversation.  A metadata
        // hydrate may lag that snapshot; reproject the same bounded tail over
        // the cache merge so the generic local-tail filter cannot remove blank
        // operation items (for example TOOL:file_change) before healthy IPC
        // converges.  This only returns messages and does not promote the
        // provisional surface to live authority or durable history.
        return mergeSurfaceItems(
            existing = merged,
            surfaceItems = provisionalSurface.items,
            surfaceStatus = provisionalSurface.status,
            latestTurnId = provisionalSurface.latestTurnId,
            preserveExisting = true
        )
    }
    if (live == null) {
        // A legacy/fallback turn can be optimistically visible before the
        // first healthy surface for this selection.  It is still the same
        // selected conversation, so a stale static cache must not erase that
        // local tail while the IPC authority is being acquired.
        return mergeCachedHistoryWithLocalTail()
    }
    if (live != incoming) {
        return cachedMessages
    }
    if (state.liveAuthoritativeDesynced) {
        // A desynced surface cannot replace the canonical cache, but the cache
        // may still lag behind a user turn already projected by that same
        // conversation.  Keep the matching live tail until a healthy surface
        // or a newer canonical snapshot converges it; otherwise a history
        // commit makes a just-sent user message disappear from the page.
        return mergeCachedHistoryWithLocalTail()
    }

    // A healthy surface can arrive before the history page.  Reconcile that
    // surface against the cache using the same itemId-aware path as a later
    // snapshot update.  Surface operation keys are namespaced with turnId,
    // while canonical cache rows keep the raw item id; merging the two lists
    // by ChatMessage.id alone would append the operation after the final
    // answer when the cache read completes after reconnect.
    val surface = state.ipcSurfaceSnapshot
    if (surface != null &&
        normalizeCodexThreadId(surface.conversationId) == incoming &&
        !surface.desynced
    ) {
        if (matchingTruncatedSurfaceForHydrate != null && state.messages.isNotEmpty()) {
            return mergeCachedHistoryWithLocalTail()
        }
        val cachedKeys = cachedMessages.mapTo(mutableSetOf()) { it.id }
        val liveOnly = state.messages.filter { message ->
            historyItemAliasesForUiMessage(message).none(cachedKeys::contains) &&
                cachedMessages.none { cached ->
                    areSameCanonicalAndSurfaceMessageForUi(cached, message)
                }
        }
        return mergeSurfaceItems(
            existing = cachedMessages + liveOnly,
            surfaceItems = surface.items,
            surfaceStatus = surface.status,
            latestTurnId = surface.latestTurnId,
            preserveExisting = true
        )
    }

    val liveById = state.messages.associateBy { it.id }
    val consumedLiveIds = mutableSetOf<String>()
    val merged = cachedMessages.map { cached ->
        val liveMessage = liveById[cached.id]
            ?: state.messages.firstOrNull { candidate ->
                candidate.id !in consumedLiveIds && (
                    historyItemAliasesForUiMessage(candidate).contains(cached.id) ||
                        candidate.role == ChatMessage.Role.USER &&
                            cached.role == ChatMessage.Role.USER &&
                            candidate.content.trim() == cached.content.trim()
                    )
            }
        if (liveMessage == null) {
            cached
        } else {
            consumedLiveIds += liveMessage.id
            mergeLiveMessageWithCachedMetadataForUi(liveMessage, cached)
        }
    }.toMutableList()
    state.messages.forEach { liveMessage ->
        if (liveMessage.id !in consumedLiveIds && merged.none { it.id == liveMessage.id }) {
            merged += liveMessage
        }
    }
    return merged
}

private fun mergeLiveMessageWithCachedMetadataForUi(
    live: ChatMessage,
    cached: ChatMessage
): ChatMessage {
    val attachments = (cached.attachments + live.attachments).distinctBy { attachment ->
        attachment.dedupeKey
            ?.trim()
            ?.takeIf { it.isNotEmpty() }
            ?.lowercase()
            ?: listOf(
                attachment.kind.trim().lowercase(),
                attachment.source.orEmpty().trim().lowercase(),
                attachment.path.orEmpty().trim().lowercase(),
                attachment.url.orEmpty().trim().lowercase(),
                attachment.label.trim().lowercase()
            ).joinToString("::")
    }
    return if (live.role == ChatMessage.Role.USER && cached.role == ChatMessage.Role.USER) {
        mergeCanonicalUserMessageMetadataForUi(
            canonical = live.copy(attachments = attachments),
            local = cached
        )
    } else {
        live.copy(
            attachments = attachments,
            fileMentions = (cached.fileMentions + live.fileMentions).distinctBy { it.path.trim().lowercase() },
            activeSkill = live.activeSkill ?: cached.activeSkill,
            skills = (cached.skills + live.skills).distinctBy {
                "${it.name.trim().lowercase()}::${it.path.orEmpty().trim().lowercase()}"
            }
        )
    }
}

internal fun shouldRequestHistorySyncAfterSurface(
    previousStatus: String?,
    currentStatus: String?,
    desynced: Boolean
): Boolean {
    if (desynced) return false
    if (previousStatus.isNullOrBlank()) return true
    val terminalStatuses = setOf("completed", "failed", "interrupted", "cancelled", "canceled")
    return previousStatus.trim().lowercase() !in terminalStatuses &&
        currentStatus?.trim()?.lowercase() in terminalStatuses
}

/**
 * B4R obtains the static baseline from the already active server-snapshot
 * segment stream.  A matching initial or terminal IPC surface must still be
 * applied as live authority, but it must not discard that in-flight stream
 * and start a second full source read for the same selection.
 */
internal fun shouldDeferHistoryRefreshForInFlightServerSnapshot(
    surfaceRequestsSync: Boolean,
    serverSnapshotSegmentsEnabled: Boolean,
    surfaceConversationId: String?,
    activeConversationId: String?,
    inFlightConversationId: String?,
    inFlightSyncId: String?,
    currentSelectionMatches: Boolean
): Boolean {
    val conversationId = surfaceConversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return false
    return surfaceRequestsSync &&
        serverSnapshotSegmentsEnabled &&
        currentSelectionMatches &&
        conversationId == activeConversationId?.trim() &&
        conversationId == inFlightConversationId?.trim() &&
        !inFlightSyncId.isNullOrBlank()
}

/**
 * A completed B4R cache is already the authoritative static-history baseline
 * for this selection.  A later terminal IPC surface may update the live
 * projection, but must not reopen static history until P1 freshness probing
 * exists.  This is deliberately narrower than the in-flight guard above:
 * generic v2 and incomplete range caches still take their existing path.
 */
internal fun shouldSuppressHistoryRefreshForCompleteServerSnapshot(
    surfaceRequestsSync: Boolean,
    serverSnapshotSegmentsEnabled: Boolean,
    currentSelectionMatches: Boolean,
    completeServerSnapshotCache: Boolean
): Boolean = surfaceRequestsSync &&
    serverSnapshotSegmentsEnabled &&
    currentSelectionMatches &&
    completeServerSnapshotCache

/**
 * A locally complete cache is safe as the static display baseline even when
 * it has no B4R coverage proof.  Do not let the first ordinary selection
 * snapshot replace it before a fresh IPC surface tells us whether the task is
 * still running or is eligible for terminal reconciliation.  This is not a
 * freshness assertion: the terminal/tail lanes remain responsible for
 * proving and updating the canonical tail.
 */
internal fun shouldDeferOrdinaryHistorySyncForCompleteLocalCache(
    cacheState: CodexHistoryCacheUiState,
    activeConversationId: String?,
    conversationId: String?,
    selectionGeneration: Long,
    surfaceStatus: String?,
    surfaceDesynced: Boolean
): Boolean {
    val target = normalizeCodexThreadId(conversationId) ?: return false
    if (!cacheState.ready || !cacheState.complete ||
        normalizeCodexThreadId(cacheState.conversationId) != target ||
        normalizeCodexThreadId(activeConversationId) != target ||
        cacheState.generation != selectionGeneration
    ) return false
    if (surfaceDesynced || surfaceStatus.isNullOrBlank()) return true
    return surfaceStatus.trim().lowercase() in setOf(
        "completed", "complete", "done", "finished",
        "failed", "error", "cancelled", "canceled", "interrupted"
    )
}

/**
 * `coverageComplete` proves that the local B4R static range has no gap; it
 * does not prove the upstream canonical snapshot is still current.  A
 * matching recovery `ready` is the one bounded path that has actually
 * produced a newer canonical baseline, so it must be allowed to replace the
 * old static marker before the normal segment sync begins.
 */
internal fun shouldInvalidateCompleteServerSnapshotCacheForRecoveryReady(
    recoveryState: String,
    recoveryMatchesCurrentSelection: Boolean,
    completeServerSnapshotCache: Boolean
): Boolean = recoveryState.trim().equals("ready", ignoreCase = true) &&
    recoveryMatchesCurrentSelection &&
    completeServerSnapshotCache

/**
 * A healthy matching IPC surface is the realtime authority again.  A
 * recovery started while the same selection was desynced must no longer keep
 * the UI in a visible recovery state or accept a late recovery result as a
 * second authority.
 */
internal fun shouldCancelHistoryRecoveryForHealthySurface(
    surfaceDesynced: Boolean,
    currentSelectionMatches: Boolean,
    surfaceConversationId: String?,
    activeConversationId: String?,
    recoveryConversationId: String?
): Boolean {
    val surfaceId = normalizeCodexThreadId(surfaceConversationId) ?: return false
    return !surfaceDesynced &&
        currentSelectionMatches &&
        surfaceId == normalizeCodexThreadId(activeConversationId) &&
        surfaceId == normalizeCodexThreadId(recoveryConversationId)
}

/**
 * Stopping recovery because IPC is healthy must not leave its spinner behind.
 * Keep a complete static cache quiet; retain an honest partial state when
 * only a readable prefix is available.
 */
internal fun historyNetworkStateAfterHealthySurfaceStopsRecovery(
    cacheReady: Boolean,
    cacheComplete: Boolean
): CodexHistoryNetworkSyncState = when {
    cacheReady && cacheComplete -> CodexHistoryNetworkSyncState.CACHE_ONLY
    cacheReady -> CodexHistoryNetworkSyncState.PARTIAL
    else -> CodexHistoryNetworkSyncState.IDLE
}

/**
 * A complete B4R static cache remains usable when an IPC fallback request is
 * pending, rejected or times out.  The request still occurs when contract
 * conditions require it, but its transport state must not masquerade as a
 * missing static history baseline.
 */
internal fun historyNetworkStateForCompleteServerSnapshotRecovery(
    completeServerSnapshotCache: Boolean,
    otherwise: CodexHistoryNetworkSyncState
): CodexHistoryNetworkSyncState = if (completeServerSnapshotCache) {
    CodexHistoryNetworkSyncState.CACHE_ONLY
} else {
    otherwise
}

/**
 * History sync states that close the current bounded request.  These values
 * are intentionally independent from baselineComplete: a partial/cache-only
 * result is still a terminal network outcome and must not leave the UI
 * watchdog running.
 */
internal fun isTerminalHistorySyncState(rawState: String): Boolean =
    rawState.trim().lowercase(Locale.ROOT) in setOf(
        "synced",
        "live",
        "complete",
        "partial",
        "cache_only",
        "failed",
        "offline",
        "unsupported"
    )

internal fun mapHistoryNetworkSyncStateForUi(rawState: String): CodexHistoryNetworkSyncState =
    when (rawState.trim().lowercase(Locale.ROOT)) {
        "loading_baseline", "syncing", "manifest", "delta" ->
            CodexHistoryNetworkSyncState.SYNCING
        "repairing", "recovering" -> CodexHistoryNetworkSyncState.REPAIRING
        "partial" -> CodexHistoryNetworkSyncState.PARTIAL
        "cache_only" -> CodexHistoryNetworkSyncState.CACHE_ONLY
        "live", "synced", "complete" -> CodexHistoryNetworkSyncState.SYNCED
        "offline" -> CodexHistoryNetworkSyncState.OFFLINE
        "unsupported" -> CodexHistoryNetworkSyncState.UNSUPPORTED
        "failed", "error" -> CodexHistoryNetworkSyncState.FAILED
        "idle", "" -> CodexHistoryNetworkSyncState.IDLE
        else -> CodexHistoryNetworkSyncState.SYNCING
    }

internal fun shouldApplyHistoryManifestSendFailure(
    selectionIsCurrent: Boolean,
    activeSyncId: String?,
    manifestSyncId: String?
): Boolean = selectionIsCurrent && acceptsActiveHistorySyncId(activeSyncId, manifestSyncId)

internal fun shouldEscalateHistoryRecovery(
    cacheReady: Boolean,
    cacheComplete: Boolean,
    networkState: CodexHistoryNetworkSyncState,
    authorityMode: IpcAuthorityMode,
    completeServerSnapshotCache: Boolean
): Boolean {
    // A completed B4R snapshot is a complete static cache for this selection,
    // not an IPC surface.  While still awaiting that surface, avoid reopening
    // canonical history recovery; explicit offline/desynced paths retain their
    // existing bounded recovery behavior.
    if (completeServerSnapshotCache && authorityMode == IpcAuthorityMode.AWAITING_IPC_SURFACE) {
        return false
    }
    return !cacheReady ||
        (cacheReady && !cacheComplete) ||
        networkState in setOf(
            CodexHistoryNetworkSyncState.PARTIAL,
            CodexHistoryNetworkSyncState.CACHE_ONLY,
            CodexHistoryNetworkSyncState.FAILED,
            CodexHistoryNetworkSyncState.OFFLINE,
            CodexHistoryNetworkSyncState.UNSUPPORTED
        ) || authorityMode in setOf(
            IpcAuthorityMode.IPC_OFFLINE,
            IpcAuthorityMode.IPC_DESYNCED
    )
}

/**
 * The first matching surface after A→B selection is intentionally delivered
 * as desynced until the new subscription cycle observes the host again.  A
 * proven B4R static cache gives that cycle one existing surface-grace window
 * before canonical recovery.  This does not relax offline recovery and does
 * not make a persistent desync permanent: the normal recovery path resumes
 * once the bounded window expires.
 */
internal fun shouldDeferCompleteSnapshotRecoveryForFreshSubscription(
    completeServerSnapshotCache: Boolean,
    authorityMode: IpcAuthorityMode,
    subscriptionConversationId: String?,
    subscriptionGeneration: Long,
    targetConversationId: String?,
    selectionGeneration: Long,
    subscriptionSentAtElapsed: Long,
    nowElapsed: Long,
    surfaceWaitGraceMillis: Long
): Boolean {
    if (!completeServerSnapshotCache || authorityMode != IpcAuthorityMode.IPC_DESYNCED) {
        return false
    }
    val targetId = normalizeCodexThreadId(targetConversationId) ?: return false
    if (normalizeCodexThreadId(subscriptionConversationId) != targetId ||
        subscriptionGeneration != selectionGeneration ||
        subscriptionSentAtElapsed <= 0L ||
        surfaceWaitGraceMillis <= 0L
    ) {
        return false
    }
    val elapsed = (nowElapsed - subscriptionSentAtElapsed).coerceAtLeast(0L)
    return elapsed < surfaceWaitGraceMillis
}

/**
 * The final B4R segment has already been atomically committed to SQLite before
 * its ACK is sent.  Promote only that proven server-snapshot completion so the
 * following terminal sync state cannot race foreground recovery.  Generic v2
 * pages and incomplete B4R segments deliberately do not earn this exemption.
 */
internal fun shouldPromoteCompleteServerSnapshotCache(
    serverSnapshotSegmentsEnabled: Boolean,
    providerMode: String?,
    cacheCoverageComplete: Boolean
): Boolean = serverSnapshotSegmentsEnabled &&
    providerMode == "server_snapshot" &&
    cacheCoverageComplete

/**
 * `complete` is the UI's static-history completeness bit, not an assertion
 * that live IPC is fresh.  B4R's range coverage proof therefore joins the
 * legacy v2 complete checkpoint after every durable row has decoded.
 */
internal fun isCompleteStaticHistoryCache(
    legacyCheckpointComplete: Boolean,
    durableCoverageComplete: Boolean
): Boolean = legacyCheckpointComplete || durableCoverageComplete

/**
 * B4R coverage is proven by its own range checkpoint, not by the older v2
 * `complete` bit.  Every durable row must also have decoded successfully.
 */
internal fun hasDurableHistoryCoverage(
    coverageComplete: Boolean,
    checkpointItemCount: Int,
    durableItemCount: Int,
    decodedAllDurableRows: Boolean
): Boolean = coverageComplete &&
    checkpointItemCount == durableItemCount &&
    decodedAllDurableRows

/**
 * Existing history wire syncId is the Android-side cycle fence.  A missing
 * or blank id is rejected rather than treated as an implicit current sync.
 */
internal fun acceptsActiveHistorySyncId(activeSyncId: String?, incomingSyncId: String?): Boolean {
    val active = activeSyncId?.trim().orEmpty()
    val incoming = incomingSyncId?.trim().orEmpty()
    return active.isNotEmpty() && active == incoming
}

/**
 * Selecting an existing task is cache/history-first.  The optional metadata
 * thread/resume request must not turn a successful history recovery into an
 * error message merely because no Desktop owner currently has that task open.
 */
internal fun shouldSuppressHistoryResumeError(
    method: String,
    pendingHistoryResumeThreadId: String?
): Boolean = method == "thread/resume" &&
    !pendingHistoryResumeThreadId.isNullOrBlank()

/**
 * `history_unavailable` (and the equivalent baseline failures) is not the
 * outcome of the selected history request.  It is the hand-off that starts
 * the one bounded canonical recovery attempt.  Keep the explicit selection
 * quarantine alive until that recovery has either produced its follow-up
 * sync or failed, otherwise an optional thread/resume error can be rendered
 * as a misleading "reply failed" card in the small race between the two
 * channels.
 */
internal fun shouldKeepHistoryResumeProtectionForSyncState(
    state: String,
    detailCode: String?
): Boolean = state.trim().equals("failed", ignoreCase = true) &&
    detailCode?.trim()?.lowercase(Locale.ROOT) in setOf(
        "history_unavailable",
        "conversation_not_active",
        "history_baseline_timeout",
        "history_baseline_failed"
    )

internal fun historySyncProgressState(
    currentState: CodexHistoryNetworkSyncState
): CodexHistoryNetworkSyncState = if (
    currentState == CodexHistoryNetworkSyncState.REPAIRING
) {
    CodexHistoryNetworkSyncState.REPAIRING
} else {
    CodexHistoryNetworkSyncState.SYNCING
}

/**
 * A foreground recovery tick can run once per second while an IPC surface is
 * unavailable. A terminal history-sync response must therefore be a real
 * per-selection gate, rather than only clearing the in-flight marker. Without
 * this guard every `live` ACK immediately becomes another full sync request.
 */
internal fun shouldRequestHistorySyncForSelection(
    conversationId: String?,
    selectionGeneration: Long,
    inFlightConversationId: String?,
    settledConversationId: String?,
    settledGeneration: Long
): Boolean {
    val normalizedConversationId = conversationId?.trim()?.takeIf { it.isNotEmpty() } ?: return false
    if (inFlightConversationId?.trim() == normalizedConversationId) return false
    return settledConversationId?.trim() != normalizedConversationId ||
        settledGeneration != selectionGeneration
}

/**
 * Automatic older backfill is a low-priority continuation of a range sync,
 * never a retry loop for arbitrary PARTIAL states.  The caller supplies the
 * durable checkpoint's `hasMoreBefore` bit after the previous page committed;
 * generation and in-flight fences keep a task switch from reusing the old
 * cursor.
 */
internal fun shouldScheduleAutomaticOlderHistoryPage(
    rangeEnabled: Boolean,
    syncState: String,
    rangeSync: Boolean,
    hasMoreBefore: Boolean,
    isCurrentSelection: Boolean,
    requestInFlight: Boolean
): Boolean = rangeEnabled &&
    rangeSync &&
    syncState.trim().equals("partial", ignoreCase = true) &&
    hasMoreBefore &&
    isCurrentSelection &&
    !requestInFlight

/**
 * Selection-scoped coordinator for the low-priority older-page continuation.
 * The ViewModel supplies the real coroutine scheduler; the small abstraction
 * keeps the delay, cancellation and one-request-at-a-time fences executable
 * in JVM tests without constructing a networked ViewModel.
 */
internal fun interface AutomaticOlderHistoryPumpHandle {
    fun cancel()
}

internal class AutomaticOlderHistoryPumpCoordinator(
    private val schedule: (Long, suspend () -> Unit) -> AutomaticOlderHistoryPumpHandle,
    private val delayMillis: Long = 250L
) {
    private data class PumpKey(val conversationId: String, val generation: Long)

    private var scheduledHandle: AutomaticOlderHistoryPumpHandle? = null
    private var requestKey: PumpKey? = null

    fun schedule(
        conversationId: String,
        generation: Long,
        rangeEnabled: Boolean,
        syncState: String,
        rangeSync: Boolean,
        isCurrentSelection: () -> Boolean,
        readHasMoreBefore: suspend () -> Boolean,
        request: () -> Boolean
    ): Boolean {
        // Do not schedule work for a non-range or non-PARTIAL terminal. The
        // durable hasMoreBefore bit is checked after the delay, immediately
        // before the request, so a committed checkpoint is always current.
        if (!rangeEnabled || !rangeSync || !syncState.trim().equals("partial", ignoreCase = true)) return false
        if (scheduledHandle != null || requestKey != null) return false
        val key = PumpKey(conversationId, generation)
        val handle = schedule(delayMillis) task@{
            scheduledHandle = null
            if (!isCurrentSelection()) return@task
            val hasMoreBefore = runCatching { readHasMoreBefore() }.getOrNull() ?: return@task
            if (!isCurrentSelection()) return@task
            if (!shouldScheduleAutomaticOlderHistoryPage(
                    rangeEnabled = rangeEnabled,
                    syncState = syncState,
                    rangeSync = rangeSync,
                    hasMoreBefore = hasMoreBefore,
                    isCurrentSelection = true,
                    requestInFlight = requestKey != null
                )
            ) return@task
            if (request()) requestKey = key
        }
        scheduledHandle = handle
        return true
    }

    fun markRequestFinished(conversationId: String, generation: Long) {
        if (requestKey == PumpKey(conversationId, generation)) requestKey = null
    }

    fun cancel() {
        scheduledHandle?.cancel()
        scheduledHandle = null
        requestKey = null
    }
}

internal fun applyIpcConversationSelectionToUiState(
    state: CodexUiState,
    selected: CodexIpcConversationSummary
): CodexUiState {
    val selectedId = selected.conversationId.trim()
    val activeId = state.activeConversationId?.trim().orEmpty()
    val switched = activeId != selectedId
    val hasIpcPlanWorkflow = state.planWorkflow.planContent != null ||
        state.planWorkflow.canSubmitPlan ||
        state.planWorkflow.planRequestId != null ||
        state.planWorkflow.planRequestMethod != null ||
        state.planWorkflow.planQuestionId != null
    val updated = state.copy(
        threadId = selectedId,
        activeConversationId = selectedId,
        awaitingNewThreadIpcSurface = false,
        currentThreadTitle = selected.title ?: state.currentThreadTitle,
        cwd = selected.cwd ?: state.cwd,
        ipcSurfaceSnapshot = if (switched) null else state.ipcSurfaceSnapshot,
        ownerCurrentCodexConfig = if (switched) null else state.ownerCurrentCodexConfig,
        cachedCanonicalMessages = if (switched) emptyList() else state.cachedCanonicalMessages,
        liveAuthoritativeConversationId = if (switched) null else state.liveAuthoritativeConversationId,
        liveAuthoritativeDesynced = if (switched) false else state.liveAuthoritativeDesynced,
        historyCacheState = if (switched) {
            CodexHistoryCacheUiState(conversationId = selectedId)
        } else {
            state.historyCacheState
        },
        historyNetworkSyncState = if (switched) {
            CodexHistoryNetworkSyncUiState(conversationId = selectedId)
        } else {
            state.historyNetworkSyncState
        },
        nextTurnOverrides = if (switched) NextTurnOverrides() else state.nextTurnOverrides,
        activeGoal = if (switched) null else state.activeGoal,
        goalMode = if (switched && !state.awaitingNewThreadIpcSurface) false else state.goalMode,
        messages = if (switched) emptyList() else state.messages,
        pendingServerRequests = if (switched) {
            state.pendingServerRequests.filterNot { it.handledBy.equals("ipc_follower", ignoreCase = true) }
        } else {
            state.pendingServerRequests
        },
        submittingServerRequestIds = if (switched) emptySet() else state.submittingServerRequestIds,
        planWorkflow = if (switched && hasIpcPlanWorkflow) {
            CodexPlanWorkflowState()
        } else {
            state.planWorkflow
        }
    )
    return recalculateNextTurnEffectiveConfigForUiState(updated)
}

/**
 * Apply the lightweight session binding acknowledgement without treating the
 * acknowledgement itself as a content-ready signal.  A changed binding must
 * still isolate the previous conversation immediately, while a matching
 * binding is allowed to leave an already restored cache/live body untouched.
 */
internal fun applyIpcConversationBindingToUiState(
    state: CodexUiState,
    conversationId: String?,
    rememberedOverrides: NextTurnOverrides
): CodexUiState {
    val targetId = normalizeCodexThreadId(conversationId) ?: return state
    val activeId = normalizeCodexThreadId(state.activeConversationId)
    val currentThreadId = normalizeCodexThreadId(state.threadId)
    val cacheOwner = normalizeCodexThreadId(state.historyCacheState.conversationId)
    val networkOwner = normalizeCodexThreadId(state.historyNetworkSyncState.conversationId)
    val liveOwner = normalizeCodexThreadId(state.liveAuthoritativeConversationId)
    val surfaceOwner = normalizeCodexThreadId(state.ipcSurfaceSnapshot?.conversationId)
    val targetCache = cacheOwner == targetId
    val targetLive = liveOwner == targetId
    val targetSurface = surfaceOwner == targetId
    val targetHealthySurface = targetSurface && state.ipcSurfaceSnapshot?.desynced != true
    val foreignCache = cacheOwner != null && cacheOwner != targetId
    val foreignLive = liveOwner != null && liveOwner != targetId
    val foreignSurface = surfaceOwner != null && surfaceOwner != targetId
    val foreignThreadIdentity = currentThreadId != null &&
        currentThreadId != targetId
    val bodyIsForeignOrUnproven = foreignCache || foreignLive || foreignSurface ||
        foreignThreadIdentity
    val targetCachedMessages = if (targetCache) state.cachedCanonicalMessages else emptyList()
    val rebuiltTargetMessages = when {
        targetSurface -> mergeSurfaceItems(
            existing = targetCachedMessages,
            surfaceItems = state.ipcSurfaceSnapshot?.items.orEmpty(),
            surfaceStatus = state.ipcSurfaceSnapshot
                ?.takeIf { targetHealthySurface }
                ?.status
                ?: "unknown",
            latestTurnId = state.ipcSurfaceSnapshot
                ?.takeIf { targetHealthySurface }
                ?.latestTurnId,
            preserveExisting = true
        )
        targetCachedMessages.isNotEmpty() -> targetCachedMessages
        targetLive && !foreignCache && !foreignSurface -> state.messages
        else -> emptyList()
    }
    val switched = activeId != targetId
    val keepExistingBody = !switched && !bodyIsForeignOrUnproven
    val nextMessages = if (keepExistingBody) state.messages else rebuiltTargetMessages
    val nextCache = if (targetCache) state.cachedCanonicalMessages else emptyList()
    val nextSurface = state.ipcSurfaceSnapshot.takeIf { targetSurface }
    val nextLiveOwner = if (targetHealthySurface) {
        targetId
    } else {
        liveOwner.takeIf { targetLive }
    }
    val nextLiveDesynced = when {
        targetSurface && !targetHealthySurface -> true
        targetHealthySurface -> false
        nextLiveOwner == null -> false
        else -> state.liveAuthoritativeDesynced
    }
    val nextCacheState = if (targetCache) {
        state.historyCacheState
    } else {
        CodexHistoryCacheUiState(conversationId = targetId)
    }
    val nextNetworkState = if (networkOwner == targetId) {
        state.historyNetworkSyncState
    } else {
        CodexHistoryNetworkSyncUiState(conversationId = targetId)
    }
    val nextRuntime = if (keepExistingBody) {
        state.runtimePanel
    } else {
        CodexRuntimePanelState(visible = state.runtimePanel.visible)
    }
    val nextNotices = if (keepExistingBody) {
        state.noticesPanel
    } else {
        CodexNoticesPanelState(visible = state.noticesPanel.visible)
    }
    val nextStatus = when {
        keepExistingBody -> state.status
        targetHealthySurface -> state.ipcSurfaceSnapshot?.status ?: "idle"
        else -> "idle"
    }
    val nextCurrentTurnId = when {
        keepExistingBody -> state.currentTurnId
        targetHealthySurface -> resolveSurfaceCurrentTurnId(
            status = state.ipcSurfaceSnapshot?.status ?: "idle",
            latestTurnId = state.ipcSurfaceSnapshot?.latestTurnId,
            currentTurnId = null
        )
        else -> null
    }
    val updated = state.copy(
        threadId = targetId,
        activeConversationId = targetId,
        ipcSurfaceSnapshot = nextSurface,
        ownerCurrentCodexConfig = if (keepExistingBody || targetHealthySurface) {
            state.ownerCurrentCodexConfig
        } else {
            null
        },
        cachedCanonicalMessages = nextCache,
        liveAuthoritativeConversationId = nextLiveOwner,
        liveAuthoritativeDesynced = nextLiveDesynced,
        historyCacheState = nextCacheState,
        historyNetworkSyncState = nextNetworkState,
        nextTurnOverrides = overridesForConversationSwitch(
            currentConversationId = state.activeConversationId,
            targetConversationId = targetId,
            currentOverrides = state.nextTurnOverrides,
            rememberedOverrides = rememberedOverrides
        ),
        activeGoal = if (keepExistingBody) state.activeGoal else state.ipcSurfaceSnapshot
            ?.takeIf { targetHealthySurface }
            ?.activeGoal,
        status = nextStatus,
        currentTurnId = nextCurrentTurnId,
        messages = nextMessages,
        runtimePanel = nextRuntime,
        noticesPanel = nextNotices,
        pendingServerRequests = if (keepExistingBody) state.pendingServerRequests else emptyList(),
        submittingServerRequestIds = if (keepExistingBody) state.submittingServerRequestIds else emptySet(),
        planWorkflow = if (keepExistingBody) state.planWorkflow else CodexPlanWorkflowState()
    )
    return recalculateNextTurnEffectiveConfigForUiState(updated)
}

internal fun clearIpcConversationSelectionFromUiState(state: CodexUiState): CodexUiState {
    val hadIpcSurface = state.ipcSurfaceSnapshot != null
    val hasIpcPlanWorkflow = state.planWorkflow.planContent != null ||
        state.planWorkflow.canSubmitPlan ||
        state.planWorkflow.planRequestId != null ||
        state.planWorkflow.planRequestMethod != null ||
        state.planWorkflow.planQuestionId != null
    val updated = state.copy(
        activeConversationId = null,
        awaitingNewThreadIpcSurface = false,
        ipcSurfaceSnapshot = null,
        ownerCurrentCodexConfig = null,
        cachedCanonicalMessages = emptyList(),
        liveAuthoritativeConversationId = null,
        liveAuthoritativeDesynced = false,
        historyCacheState = CodexHistoryCacheUiState(),
        historyNetworkSyncState = CodexHistoryNetworkSyncUiState(),
        nextTurnOverrides = NextTurnOverrides(),
        activeGoal = null,
        goalMode = false,
        followerModeEnabled = false,
        followerActiveSendAllowed = false,
        messages = if (hadIpcSurface) emptyList() else state.messages,
        pendingServerRequests = state.pendingServerRequests.filterNot {
            it.handledBy.equals("ipc_follower", ignoreCase = true)
        },
        submittingServerRequestIds = emptySet(),
        planWorkflow = if (hasIpcPlanWorkflow) CodexPlanWorkflowState() else state.planWorkflow
    )
    return recalculateNextTurnEffectiveConfigForUiState(updated)
}

internal fun dismissThreadHistoryForResumeSelection(state: CodexUiState): CodexUiState = state.copy(
    threadHistorySheetVisible = false,
    threadRenameTargetId = "",
    threadRenameDraft = ""
)

/**
 * Cache-first history selection must not leave the previous task rendered
 * while SQLite reads and decodes the target cache.  The target identity is
 * already known at that point, so clear only the previous task-scoped UI now;
 * the target static base still arrives through the existing guarded cache
 * commit later.
 */
internal fun preparePendingHistorySelectionUiState(
    previousConversationId: String?,
    selectedState: CodexUiState
): CodexUiState {
    val switched = normalizeCodexThreadId(previousConversationId) !=
        normalizeCodexThreadId(selectedState.activeConversationId)
    if (!switched) return selectedState
    return selectedState.copy(
        threadHistoryStatus = "cache_only",
        threadHistoryLoading = false,
        threadHistoryActionThreadId = "",
        threadHistoryActionKind = "",
        errorMessage = null,
        status = "idle",
        currentTurnId = null,
        interactionState = null,
        executionWatch = CodexExecutionWatchState(),
        runtimePanel = CodexRuntimePanelState(visible = selectedState.runtimePanel.visible),
        noticesPanel = CodexNoticesPanelState(visible = selectedState.noticesPanel.visible),
        pendingServerRequests = emptyList(),
        submittingServerRequestIds = emptySet()
    )
}

/**
 * A desynced surface is a last-known, bounded body for the matching
 * conversation.  It may be shown provisionally so cache-first selection does
 * not fall back to an older durable tail, but it must not become the live
 * authority or update the durable cache.  Keep the first retained surface
 * stable until a healthy snapshot converges it; this preserves the existing
 * healthy-surface-over-desynced ordering rule.
 */
internal fun applyDesyncedSurfaceBodyToUiState(
    state: CodexUiState,
    snap: DesktopSurfaceSnapshot
): CodexUiState {
    val snapshotConversationId = snap.conversationId?.trim().orEmpty()
    val retainedSurface = state.ipcSurfaceSnapshot?.takeIf {
        it.conversationId?.trim().orEmpty() == snapshotConversationId
    }
    // A delayed replay must never downgrade a healthy surface that has already
    // converged for this conversation.  The next healthy surface remains the
    // only writer allowed to advance live authority and runtime state.
    if (retainedSurface?.desynced == false) return state

    val provisionalMessages = if (retainedSurface != null || snap.items.isEmpty()) {
        state.messages
    } else {
        mergeSurfaceItems(
            existing = state.messages,
            surfaceItems = snap.items,
            // A desynced snapshot cannot authoritatively describe runtime
            // status or the current turn.  Project body items only.
            surfaceStatus = "unknown",
            latestTurnId = null,
            preserveExisting = true
        )
    }
    return state.copy(
        ipcSurfaceSnapshot = retainedSurface ?: snap,
        liveAuthoritativeDesynced = true,
        messages = provisionalMessages
    )
}

internal fun applyDesktopSurfaceSnapshotToUiState(
    state: CodexUiState,
    snap: DesktopSurfaceSnapshot
): CodexUiState {
    val convId = snap.conversationId?.trim().orEmpty()
    val activeConversationId = state.activeConversationId?.trim().orEmpty()
    if (convId.isEmpty() || activeConversationId.isEmpty() || convId != activeConversationId) {
        return state
    }
    if (snap.desynced) {
        return applyDesyncedSurfaceBodyToUiState(state, snap)
    }
    val confirmedOverrides = reconcileOwnerConfirmedOverrides(
        overrides = state.nextTurnOverrides,
        ownerConfig = snap.currentCodexConfig
    )
    // A healthy IPC snapshot is a live tail, not proof that the static
    // conversation history is complete.  Preserve cached正文 when the
    // snapshot is empty, legacy/unmarked, or explicitly truncated; otherwise
    // a long-idle owner can replace a valid cached task with a blank surface.
    val preserveCachedHistory = snap.itemsTruncated ||
        snap.items.isEmpty() ||
        state.cachedCanonicalMessages.isNotEmpty()
    val updated = state.copy(
        threadId = convId,
        activeConversationId = convId,
        awaitingNewThreadIpcSurface = false,
        ipcSurfaceSnapshot = snap,
        liveAuthoritativeConversationId = convId,
        liveAuthoritativeDesynced = false,
        ownerCurrentCodexConfig = snap.currentCodexConfig,
        nextTurnOverrides = confirmedOverrides,
        status = snap.status,
        currentTurnId = resolveSurfaceCurrentTurnId(
            status = snap.status,
            latestTurnId = snap.latestTurnId,
            currentTurnId = state.currentTurnId
        ),
        messages = mergeSurfaceItems(
            existing = state.messages,
            surfaceItems = snap.items,
            surfaceStatus = snap.status,
            latestTurnId = snap.latestTurnId,
            preserveExisting = preserveCachedHistory
        ),
        pendingServerRequests = mergePendingUserInput(
            mergePendingApproval(state.pendingServerRequests, snap.pendingApproval),
            snap.pendingUserInputAction
        ),
        planWorkflow = mergePlanWorkflow(state.planWorkflow, snap.pendingPlanAction),
        activeGoal = snap.activeGoal,
        currentThreadTitle = snap.title ?: state.currentThreadTitle,
        cwd = snap.cwd ?: state.cwd
    )
    return recalculateNextTurnEffectiveConfigForUiState(updated)
}

internal fun reconcileOwnerConfirmedOverrides(
    overrides: NextTurnOverrides,
    ownerConfig: CodexEffectiveConfig?
): NextTurnOverrides {
    ownerConfig ?: return overrides
    val modelConfirmed = valuesMatch(overrides.model, ownerConfig.model)
    // Keep an explicit low override so Fast mode remains visibly selected after the Owner
    // confirms the same turn config; a default/Owner low value without this override is not Fast mode.
    val reasoningConfirmed = valuesMatch(overrides.reasoningEffort, ownerConfig.reasoningEffort) &&
        !isFastReasoningEffort(overrides.reasoningEffort)
    val permissionOverride = permissionConfigForSandboxOverride(overrides.sandbox)
    val hasPermissionOverride = !overrides.sandbox.isNullOrBlank() ||
        !overrides.approvalPolicy.isNullOrBlank() ||
        !overrides.approvalsReviewer.isNullOrBlank() ||
        !overrides.permissionProfile.isNullOrBlank() ||
        overrides.useConfigPermissions
    val permissionConfirmed = if (!hasPermissionOverride) {
        false
    } else if (overrides.useConfigPermissions) {
        // A null active profile does not prove that all sticky permission fields
        // were reset to config.toml, so keep this explicit mode until the user
        // chooses another permission mode or switches conversations.
        false
    } else if (!overrides.permissionProfile.isNullOrBlank()) {
        valuesMatch(overrides.permissionProfile, ownerConfig.permissionProfile) &&
            (overrides.approvalPolicy.isNullOrBlank() ||
                valuesMatch(overrides.approvalPolicy, ownerConfig.approvalPolicy)) &&
            (overrides.approvalsReviewer.isNullOrBlank() ||
                valuesMatch(overrides.approvalsReviewer, ownerConfig.approvalsReviewer))
    } else {
        val expectedSandbox = permissionOverride?.sandboxMode ?: overrides.sandbox
        val expectedApproval = overrides.approvalPolicy ?: permissionOverride?.approvalPolicy
        (expectedSandbox.isNullOrBlank() || valuesMatch(expectedSandbox, ownerConfig.sandboxMode)) &&
            (expectedApproval.isNullOrBlank() || valuesMatch(expectedApproval, ownerConfig.approvalPolicy)) &&
            (overrides.approvalsReviewer.isNullOrBlank() ||
                valuesMatch(overrides.approvalsReviewer, ownerConfig.approvalsReviewer))
    }
    return NextTurnOverrides(
        model = if (modelConfirmed) null else overrides.model,
        reasoningEffort = if (reasoningConfirmed) null else overrides.reasoningEffort,
        sandbox = if (permissionConfirmed) null else overrides.sandbox,
        approvalPolicy = if (permissionConfirmed) null else overrides.approvalPolicy,
        approvalsReviewer = if (permissionConfirmed) null else overrides.approvalsReviewer,
        permissionProfile = if (permissionConfirmed) null else overrides.permissionProfile,
        useConfigPermissions = if (permissionConfirmed) false else overrides.useConfigPermissions
    )
}

internal fun recalculateNextTurnEffectiveConfigForUiState(state: CodexUiState): CodexUiState =
    state.copy(nextTurnEffectiveCodexConfig = resolveNextTurnEffectiveCodexConfig(state))

internal fun applyModelCatalogToUiState(
    state: CodexUiState,
    catalog: List<CodexModelOption>
): CodexUiState {
    if (catalog.isEmpty()) return state
    val modelIds = catalog.filterNot(CodexModelOption::hidden).map(CodexModelOption::id)
    val allModelIds = catalog.map(CodexModelOption::id)
    val selectedModel = state.model
        ?.takeIf(allModelIds::contains)
        ?: catalog.firstOrNull { it.isDefault && !it.hidden }?.id
        ?: modelIds.firstOrNull()
        ?: state.model
        ?: allModelIds.first()
    val selectedMetadata = catalog.firstOrNull { it.id == selectedModel }
    return recalculateNextTurnEffectiveConfigForUiState(
        state.copy(
            capabilities = state.capabilities?.copy(models = modelIds),
            modelCatalog = catalog,
            model = selectedModel,
            reasoningEffort = state.reasoningEffort
                ?: selectedMetadata?.defaultReasoningEffort
        )
    )
}

internal fun nextTurnOverridesForModelSelection(
    state: CodexUiState,
    model: String?
): NextTurnOverrides {
    val normalizedModel = model?.trim()?.takeIf(String::isNotEmpty)
    val metadata = state.modelCatalog.firstOrNull { it.id == normalizedModel }
    val supportedEfforts = metadata?.supportedReasoningEfforts.orEmpty()
    val currentEffectiveEffort = state.nextTurnOverrides.reasoningEffort
        ?: state.nextTurnEffectiveCodexConfig?.reasoningEffort
        ?: state.ownerCurrentCodexConfig?.reasoningEffort
        ?: state.serverNextTurnConfigBase?.reasoningEffort
        ?: state.reasoningEffort
    val nextReasoningOverride = when {
        normalizedModel == null -> state.nextTurnOverrides.reasoningEffort
        supportedEfforts.isEmpty() -> null
        currentEffectiveEffort != null && supportedEfforts.any {
            it.equals(currentEffectiveEffort, ignoreCase = true)
        } -> state.nextTurnOverrides.reasoningEffort
        else -> metadata?.defaultReasoningEffort
            ?.takeIf { default -> supportedEfforts.any { it.equals(default, ignoreCase = true) } }
            ?: supportedEfforts.first()
    }
    return state.nextTurnOverrides.copy(
        model = normalizedModel,
        reasoningEffort = nextReasoningOverride
    )
}

internal fun nextTurnOverridesForPermissionSelection(
    state: CodexUiState,
    selection: String?
): NextTurnOverrides {
    val normalizedSelection = selection?.trim().orEmpty()
    val workspaceProfile = state.permissionProfiles
        .firstOrNull { it.allowed && it.id.equals(":workspace", ignoreCase = true) }
        ?.id
    val fullAccessProfile = state.permissionProfiles
        .firstOrNull { it.allowed && it.id.equals(":danger-full-access", ignoreCase = true) }
        ?.id
    return when {
        normalizedSelection.isEmpty() -> state.nextTurnOverrides.copy(
            sandbox = null,
            approvalPolicy = null,
            approvalsReviewer = null,
            permissionProfile = null,
            useConfigPermissions = false
        )
        normalizedSelection == "workspace-write" ||
            normalizedSelection == "read-only" ||
            normalizedSelection == "danger-full-access" -> state.nextTurnOverrides.copy(
            sandbox = normalizedSelection,
            approvalPolicy = null,
            approvalsReviewer = null,
            permissionProfile = null,
            useConfigPermissions = false
        )
        normalizedSelection == PERMISSION_CHOICE_ASK -> state.nextTurnOverrides.copy(
            sandbox = if (workspaceProfile == null) "workspace-write" else null,
            approvalPolicy = "on-request",
            approvalsReviewer = "user",
            permissionProfile = workspaceProfile,
            useConfigPermissions = false
        )
        normalizedSelection == PERMISSION_CHOICE_AUTO_REVIEW -> state.nextTurnOverrides.copy(
            sandbox = if (workspaceProfile == null) "workspace-write" else null,
            approvalPolicy = "on-request",
            approvalsReviewer = "auto_review",
            permissionProfile = workspaceProfile,
            useConfigPermissions = false
        )
        normalizedSelection == PERMISSION_CHOICE_FULL_ACCESS -> state.nextTurnOverrides.copy(
            sandbox = if (fullAccessProfile == null) "danger-full-access" else null,
            approvalPolicy = "never",
            approvalsReviewer = "user",
            permissionProfile = fullAccessProfile,
            useConfigPermissions = false
        )
        normalizedSelection == PERMISSION_CHOICE_CUSTOM -> state.nextTurnOverrides.copy(
            sandbox = null,
            approvalPolicy = null,
            approvalsReviewer = null,
            permissionProfile = null,
            useConfigPermissions = true
        )
        normalizedSelection.startsWith(PERMISSION_PROFILE_CHOICE_PREFIX) -> {
            val profileId = normalizedSelection.removePrefix(PERMISSION_PROFILE_CHOICE_PREFIX)
                .takeIf(String::isNotBlank)
            state.nextTurnOverrides.copy(
                sandbox = null,
                approvalPolicy = null,
                approvalsReviewer = null,
                permissionProfile = profileId,
                useConfigPermissions = false
            )
        }
        else -> state.nextTurnOverrides
    }
}

internal fun isOwnerConfigHydratingForUiState(state: CodexUiState): Boolean {
    val activeConversationId = state.activeConversationId?.trim().orEmpty()
    if (!state.ipcOnline || !state.followerModeEnabled || activeConversationId.isEmpty()) {
        return false
    }
    // A task switch loads its remembered task-scoped overrides synchronously
    // before the fresh IPC surface arrives.  They are safe to show while the
    // surface is settling; showing a generic loading value here causes the
    // selected model/permission to flicker to loading and back on every A→B.
    if (hasTargetRememberedConfigForUiState(state)) return false
    if (state.awaitingNewThreadIpcSurface) return true
    val snapshotConversationId = state.ipcSurfaceSnapshot?.conversationId?.trim()
        ?: return false
    return snapshotConversationId != activeConversationId
}

internal fun hasTargetRememberedConfigForUiState(state: CodexUiState): Boolean {
    val overrides = state.nextTurnOverrides
    return overrides.useConfigPermissions ||
        !overrides.model.isNullOrBlank() ||
        !overrides.reasoningEffort.isNullOrBlank() ||
        !overrides.sandbox.isNullOrBlank() ||
        !overrides.approvalPolicy.isNullOrBlank() ||
        !overrides.approvalsReviewer.isNullOrBlank() ||
        !overrides.permissionProfile.isNullOrBlank()
}

internal fun resolveNextTurnEffectiveCodexConfig(state: CodexUiState): CodexEffectiveConfig? {
    val owner = state.ownerCurrentCodexConfig
    val session = state.serverNextTurnConfigBase
    val permissionOverride = permissionConfigForSandboxOverride(state.nextTurnOverrides.sandbox)
    val selectedPermissionProfile = if (state.nextTurnOverrides.useConfigPermissions) {
        null
    } else {
        state.nextTurnOverrides.permissionProfile
            ?: owner?.permissionProfile
            ?: session?.permissionProfile
    }
    val config = CodexEffectiveConfig(
        model = state.nextTurnOverrides.model ?: owner?.model ?: session?.model ?: state.model,
        reasoningEffort = state.nextTurnOverrides.reasoningEffort
            ?: owner?.reasoningEffort
            ?: session?.reasoningEffort
            ?: state.reasoningEffort
            ?: state.capabilities?.defaultReasoningEffort,
        personality = owner?.personality ?: session?.personality,
        approvalPolicy = if (state.nextTurnOverrides.useConfigPermissions) {
            null
        } else {
            state.nextTurnOverrides.approvalPolicy
                ?: permissionOverride?.approvalPolicy
                ?: owner?.approvalPolicy
                ?: session?.approvalPolicy
        },
        sandboxMode = if (state.nextTurnOverrides.useConfigPermissions) {
            null
        } else if (!selectedPermissionProfile.isNullOrBlank()) {
            null
        } else {
            permissionOverride?.sandboxMode
                ?: state.nextTurnOverrides.sandbox
                ?: owner?.sandboxMode
                ?: session?.sandboxMode
        },
        approvalsReviewer = if (state.nextTurnOverrides.useConfigPermissions) {
            null
        } else {
            state.nextTurnOverrides.approvalsReviewer
                ?: owner?.approvalsReviewer
                ?: session?.approvalsReviewer
        },
        permissionProfile = selectedPermissionProfile,
        useConfigPermissions = state.nextTurnOverrides.useConfigPermissions
    )
    return config.takeIf(CodexEffectiveConfig::hasAnyValue)
}

internal fun prepareIpcStateForNewThread(state: CodexUiState): CodexUiState {
    val awaitingNewSurface = !state.activeConversationId.isNullOrBlank()
    if (!awaitingNewSurface) return recalculateNextTurnEffectiveConfigForUiState(state)
    return recalculateNextTurnEffectiveConfigForUiState(
        state.copy(
            activeConversationId = null,
            awaitingNewThreadIpcSurface = awaitingNewSurface,
            ipcSurfaceSnapshot = null,
            ownerCurrentCodexConfig = null,
            nextTurnOverrides = NextTurnOverrides(),
            activeGoal = null
        )
    )
}

private fun valuesMatch(expected: String?, actual: String?): Boolean =
    !expected.isNullOrBlank() && expected.trim().equals(actual?.trim(), ignoreCase = true)

private fun CodexEffectiveConfig.hasAnyValue(): Boolean =
    !model.isNullOrBlank() ||
        !reasoningEffort.isNullOrBlank() ||
        !personality.isNullOrBlank() ||
        !approvalPolicy.isNullOrBlank() ||
        !sandboxMode.isNullOrBlank() ||
        !approvalsReviewer.isNullOrBlank() ||
        !permissionProfile.isNullOrBlank() ||
        useConfigPermissions

private fun permissionConfigForSandboxOverride(sandboxOverride: String?): CodexEffectiveConfig? {
    return when (sandboxOverride?.trim()) {
        "danger-full-access" -> CodexEffectiveConfig(
            model = null,
            reasoningEffort = null,
            personality = null,
            approvalPolicy = "never",
            sandboxMode = "danger-full-access"
        )
        "workspace-write" -> CodexEffectiveConfig(
            model = null,
            reasoningEffort = null,
            personality = null,
            approvalPolicy = "on-request",
            sandboxMode = "workspace-write"
        )
        "read-only" -> CodexEffectiveConfig(
            model = null,
            reasoningEffort = null,
            personality = null,
            approvalPolicy = "on-request",
            sandboxMode = "read-only"
        )
        else -> null
    }
}

private const val COMMAND_BATCH_ID_PREFIX_FOR_UI = "command-batch:"

internal fun historyDetailItemsForUiMessage(message: ChatMessage, cached: List<ChatMessage>): List<ChatMessage> {
    val aliases = historyItemAliasesForUiMessage(message)
    val operationTurnId = message.operationTurnId?.trim()?.takeIf(String::isNotEmpty)
    val hasOperationType = !message.operationType.isNullOrBlank()
    return cached.filter { item ->
        // Product rows retain the owned tool: key; IPC operations carry the
        // native id. Only bridge a real tool in this operation's exact turn.
        val sameTool = item.contentType == "tool" && item.id.startsWith("tool:") &&
            operationTurnId != null && hasOperationType && item.sourceTurnId?.trim() == operationTurnId &&
            item.id.removePrefix("tool:") in aliases
        (item.id in aliases || sameTool) &&
            (item.historyDetailRefs.isNotEmpty() || item.historyDetailRefsTruncated)
    }
}

/**
 * Return the stable cache ids represented by a UI/live message.  IPC
 * operation entries use a presentation key such as
 * `turn:operation:command:<itemId>`, whereas canonical history rows use the
 * raw `<itemId>`.  A collapsed command batch may represent several such
 * entries, so include both the batch members and their raw aliases.
 */
private fun historyItemAliasesForUiMessage(message: ChatMessage): Set<String> {
    val aliases = linkedSetOf<String>()
    val turnId = message.operationTurnId?.trim().orEmpty()
    val operationType = message.operationType?.trim().orEmpty()
    val operationPrefix = if (turnId.isNotEmpty() && operationType.isNotEmpty()) {
        "$turnId:operation:$operationType:"
    } else {
        null
    }
    fun add(value: String?) {
        val normalized = value?.trim()?.takeIf(String::isNotEmpty) ?: return
        aliases += normalized
        if (operationPrefix != null && normalized.startsWith(operationPrefix)) {
            normalized.removePrefix(operationPrefix)
                .trim()
                .takeIf(String::isNotEmpty)
                ?.let(aliases::add)
        }
    }
    add(message.id)
    message.operationBatchMemberIds.forEach(::add)
    return aliases
}

/**
 * A normal message can have different ids in the canonical history cache and
 * in the live IPC surface. Only bridge it when the provider turn, role, and
 * normalized正文 all agree; deliberately do not use text-only deduplication.
 */
private fun areSameCanonicalAndSurfaceMessageForUi(
    canonical: ChatMessage,
    surface: ChatMessage
): Boolean {
    val canonicalTurnId = canonical.sourceTurnId?.trim().orEmpty()
    val surfaceTurnId = surface.sourceTurnId?.trim().orEmpty()
    val normalRole = canonical.role == ChatMessage.Role.USER ||
        canonical.role == ChatMessage.Role.ASSISTANT
    return canonicalTurnId.isNotEmpty() &&
        canonicalTurnId == surfaceTurnId &&
        normalRole &&
        surface.role == canonical.role &&
        canonical.operationType == null &&
        surface.operationType == null &&
        canonical.content.trim() == surface.content.trim()
}

private fun surfaceEntryRoleForUi(entry: SurfaceEntry, isOperation: Boolean): ChatMessage.Role =
    when (entry.kind) {
        "message" -> when (entry.role) {
            "user" -> ChatMessage.Role.USER
            else -> ChatMessage.Role.ASSISTANT
        }
        "status" -> if (isOperation) ChatMessage.Role.TOOL else ChatMessage.Role.SYSTEM
        "approval_request" -> ChatMessage.Role.SYSTEM
        "goal_prompt" -> ChatMessage.Role.USER
        else -> ChatMessage.Role.ASSISTANT
    }

/**
 * Returns the raw operation ids represented by a command message.  New
 * collapsed batches carry the complete list; older in-memory messages are
 * handled by recovering the anchor from their stable batch id.
 */
private fun commandOperationMemberIdsForUi(message: ChatMessage): List<String> {
    if (message.operationType != "command") return emptyList()
    val explicit = message.operationBatchMemberIds
        .map(String::trim)
        .filter(String::isNotEmpty)
        .distinct()
    if (explicit.isNotEmpty()) return explicit

    val turnId = message.operationTurnId?.trim().orEmpty()
    val batchPrefix = if (turnId.isNotEmpty()) {
        "$COMMAND_BATCH_ID_PREFIX_FOR_UI$turnId:"
    } else {
        COMMAND_BATCH_ID_PREFIX_FOR_UI
    }
    val anchor = message.id.removePrefix(batchPrefix).trim()
    return anchor.takeIf { it.isNotEmpty() }?.let(::listOf).orEmpty()
}

private fun isCommandBatchMessageForUi(message: ChatMessage): Boolean {
    if (message.operationType != "command") return false
    if (message.operationBatchSize > 1 || message.operationBatchMemberIds.size > 1) {
        return true
    }
    val turnId = message.operationTurnId?.trim().orEmpty()
    return turnId.isNotEmpty() &&
        message.id.startsWith("$COMMAND_BATCH_ID_PREFIX_FOR_UI$turnId:")
}

/**
 * The final Compose key safety net.  Live projection is appended after the
 * retained cache, so a later value is the authoritative replacement while
 * the first occurrence keeps the logical message's historical position.
 */
private fun deduplicateChatMessagesByIdForUi(messages: List<ChatMessage>): List<ChatMessage> {
    if (messages.size < 2) return messages
    val byId = linkedMapOf<String, ChatMessage>()
    messages.forEach { message -> byId[message.id] = message }
    return byId.values.toList()
}

internal fun mergeSurfaceItems(
    existing: List<ChatMessage>,
    surfaceItems: List<SurfaceEntry>,
    surfaceStatus: String = "unknown",
    latestTurnId: String? = null,
    preserveExisting: Boolean = false,
    preserveExistingItemIdentity: Boolean = false
): List<ChatMessage> {
    val existingById = existing.associateBy { it.id }
    val latestAssistantKey = if (surfaceStatus.equals("running", ignoreCase = true)) {
        surfaceItems.lastOrNull { entry ->
            entry.kind == "message" &&
                entry.role != "user" &&
                (latestTurnId.isNullOrBlank() || entry.turnId == latestTurnId)
        }?.key
    } else {
        null
    }
    val projectedMessages = surfaceItems.mapNotNull { entry ->
        val key = entry.key.takeIf { it.isNotBlank() } ?: return@mapNotNull null
        val existingBatchId = entry.turnId
            ?.trim()
            ?.takeIf { it.isNotEmpty() }
            ?.let { turnId -> "command-batch:$turnId:$key" }
        val isOperation = entry.kind == "status" && entry.statusType == "operation"
        val entryItemId = entry.itemId?.trim()?.takeIf(String::isNotEmpty)
        val role = surfaceEntryRoleForUi(entry, isOperation)
        val exactExisting = existingById[key]
        val batchExisting = existingBatchId?.let(existingById::get)
        val itemIdExisting = if (isOperation) entryItemId?.let(existingById::get) else null
        val batchMemberExisting = if (isOperation && entryItemId != null) {
            existing.firstOrNull { candidate ->
                isCommandBatchMessageForUi(candidate) &&
                    historyItemAliasesForUiMessage(candidate).contains(entryItemId)
            }
        } else {
            null
        }
        val bridgedExisting = if (entry.kind == "message" && !isOperation) {
            val entryTurnId = entry.turnId?.trim().orEmpty()
            val entryText = entry.text?.trim()
            if (entryTurnId.isNotEmpty() && entryText != null) {
                existing.firstOrNull { candidate ->
                    candidate.id != key &&
                        candidate.sourceTurnId?.trim() == entryTurnId &&
                        candidate.role == role &&
                        candidate.operationType == null &&
                        candidate.content.trim() == entryText
                }
            } else {
                null
            }
        } else {
            null
        }
        val existingMessage = bridgedExisting
            ?: exactExisting
            ?: batchExisting
            ?: itemIdExisting
            ?: batchMemberExisting
            ?: if (entry.kind == "message" && entry.role == "user") {
            existing.firstOrNull { candidate ->
                candidate.role == ChatMessage.Role.USER &&
                    candidate.content.trim() == entry.text.orEmpty().trim()
            }
        } else {
            null
        }
        // Keep the canonical/raw cache id when itemId matched.  If an
        // existing collapsed batch matched by its presentation key, retain
        // the current key so its member-id accounting remains unchanged.
        val projectedKey = when {
            bridgedExisting != null -> bridgedExisting.id
            exactExisting != null || batchExisting != null -> key
            itemIdExisting != null || batchMemberExisting != null -> entryItemId ?: key
            else -> key
        }
        val projected = ChatMessage(
            id = projectedKey,
            role = role,
            content = if (isOperation) {
                entry.detail ?: entry.text ?: ""
            } else {
                entry.text ?: ""
            },
            contentType = entry.kind.takeIf { it == "goal_prompt" } ?: "text",
            attachments = surfaceEntryAttachmentsForUi(entry),
            timestamp = existingMessage?.timestamp ?: System.currentTimeMillis(),
            streaming = key == latestAssistantKey,
            collapsible = isOperation,
            collapsedLabel = if (isOperation) {
                entry.label ?: entry.text ?: "操作详情"
            } else {
                ""
            },
            operationType = entry.operationType.takeIf { isOperation },
            operationStatus = entry.operationStatus.takeIf { isOperation },
            operationTurnId = entry.turnId.takeIf { isOperation },
            operationBatchSize = if (isOperation) 1 else 0,
            operationBatchMemberIds = if (isOperation) listOf(projectedKey) else emptyList(),
            sourceTurnId = entry.turnId?.trim()?.takeIf(String::isNotEmpty)
                ?: existingMessage?.sourceTurnId
        )
        if (role == ChatMessage.Role.USER && existingMessage != null) {
            mergeCanonicalUserMessageMetadataForUi(
                canonical = projected,
                local = existingMessage
            )
        } else {
            projected
        }
    }
    // The Android IPC surface is intentionally a bounded live tail. Older
    // messages are supplied by the history cache and must stay visible while
    // the tail is reconciled. Replace entries represented by the surface,
    // retain cache/live entries that are not in this snapshot, then append the
    // authoritative projected tail in its server order.
    val projectedKeys = projectedMessages.mapTo(mutableSetOf()) { it.id }
    val projectedOperationIds = projectedMessages
        .filter { it.operationType == "command" }
        .mapTo(mutableSetOf()) { it.id }
    val existingCommandBatches = if (preserveExisting) {
        existing.filter(::isCommandBatchMessageForUi)
    } else {
        emptyList()
    }
    // A complete live tail can replace a cached batch safely.  With only a
    // partial tail, retain the batch and suppress only operations already
    // represented by it, otherwise bounded IPC snapshots would delete older
    // cached command details.
    val fullyCoveredBatchIds = existingCommandBatches
        .filter { batch ->
            batch.operationBatchMemberIds.isNotEmpty() &&
                commandOperationMemberIdsForUi(batch).all(projectedOperationIds::contains)
        }
        .mapTo(mutableSetOf()) { it.id }
    // A legacy batch has no complete provenance, so do not suppress unknown
    // operations from it; the final ID dedupe is the safe compatibility path.
    val partiallyRepresentedOperationIds = existingCommandBatches
        .filter {
            it.id !in fullyCoveredBatchIds &&
                it.operationBatchMemberIds.isNotEmpty()
        }
        .flatMapTo(mutableSetOf()) { batch ->
            commandOperationMemberIdsForUi(batch).filter(projectedOperationIds::contains)
        }
    val retainedExisting = if (preserveExisting) {
        existing.filter { message ->
            message.id !in projectedKeys &&
                (preserveExistingItemIdentity || message.id !in fullyCoveredBatchIds)
        }
    } else {
        emptyList()
    }
    val projectedMessagesForMerge = projectedMessages.filterNot { message ->
        message.operationType == "command" &&
            message.id in partiallyRepresentedOperationIds
    }
    val mergedMessages = retainedExisting + projectedMessagesForMerge
    val collapsibleTurnIds = if (surfaceStatus.equals("running", ignoreCase = true) ||
        surfaceStatus.equals("waiting_for_approval", ignoreCase = true) ||
        surfaceStatus.equals("waiting_for_input", ignoreCase = true)
    ) {
        val activeTurnId = latestTurnId?.trim().orEmpty()
        if (activeTurnId.isBlank()) {
            emptySet()
        } else {
            projectedMessages.mapNotNull { it.operationTurnId }
                .map(String::trim)
                .filter { it.isNotBlank() && it != activeTurnId }
                .toSet()
        }
    } else {
        null
    }
    val collapsedMessages = if (preserveExistingItemIdentity) {
        // Cache hydrate must not change the identity of items that are already
        // visible from the matching bounded surface.  In particular, turning
        // several displayed command items into a synthetic batch would make
        // the body appear to shrink even though no canonical row was deleted.
        mergedMessages
    } else {
        collapseCompletedCommandBatchesForUi(mergedMessages, collapsibleTurnIds)
    }
    val deduplicatedMessages = deduplicateChatMessagesByIdForUi(collapsedMessages)
    if (deduplicatedMessages.size != collapsedMessages.size) {
        Log.w(
            "CodexViewModel",
            "[ui][duplicate-message-id] collapsed=${collapsedMessages.size} " +
                "deduplicated=${deduplicatedMessages.size}"
        )
    }
    return deduplicatedMessages
}

internal fun extractHistoryPayloadTextForUi(payload: JSONObject): String {
    fun extract(value: Any?): String? {
        when (value) {
            null, JSONObject.NULL -> return null
            is String -> return value.trim().takeIf { it.isNotEmpty() }
            is JSONArray -> {
                val parts = buildList {
                    for (index in 0 until value.length()) {
                        extract(value.opt(index))?.let(::add)
                    }
                }
                return parts.joinToString("\n").trim().takeIf { it.isNotEmpty() }
            }
            is JSONObject -> {
                return extract(value.opt("text"))
                    ?: extract(value.opt("content"))
                    ?: extract(value.opt("input"))
            }
        }
        return null
    }

    val body = extract(payload.opt("text"))
        ?: extract(payload.opt("content"))
        ?: extract(payload.opt("summary"))
    fun facts(valuePayload: JSONObject): List<String> =
        listOf("eventFilePath", "sourcePath", "artifactPath", "cwd", "command")
        .mapNotNull { key ->
            val value = valuePayload.opt(key)
            val fact = if (key == "command" && value is JSONArray) {
                (0 until value.length()).mapNotNull { index -> extract(value.opt(index)) }.joinToString(" ")
            } else extract(value)
            fact?.takeIf { it.isNotBlank() }?.let { "$key: $it" }
        }
    // Product items group business events under eventFacts. Read only their
    // known display fields; do not flatten event envelopes or provenance.
    val eventTexts = buildList {
        val events = payload.optJSONArray("eventFacts") ?: return@buildList
        for (index in 0 until events.length()) {
            val eventPayload = events.optJSONObject(index)?.optJSONObject("payload") ?: continue
            if (body == null) {
                (extract(eventPayload.opt("text"))
                    ?: extract(eventPayload.opt("content"))
                    ?: extract(eventPayload.opt("summary")))?.let(::add)
            }
            extract(eventPayload.opt("input"))?.let(::add)
            extract(eventPayload.opt("output"))?.let(::add)
            addAll(facts(eventPayload))
        }
    }
    return (listOfNotNull(body) + facts(payload) + eventTexts).distinct().joinToString("\n")
}

internal fun decodeCachedHistoryItem(item: CodexHistoryItem): ChatMessage? {
    return runCatching {
        val payload = JSONObject(item.payloadJson)
        val role = when (item.role?.lowercase() ?: payload.optString("role", "assistant").lowercase()) {
            "user" -> ChatMessage.Role.USER
            "tool", "command", "file_change" -> ChatMessage.Role.TOOL
            "system" -> ChatMessage.Role.SYSTEM
            else -> ChatMessage.Role.ASSISTANT
        }
        ChatMessage(
            id = item.itemKey,
            role = role,
            content = extractHistoryPayloadTextForUi(payload),
            contentType = item.itemType,
            clientRequestId = item.clientRequestId,
            attachments = extractCachedMediaAttachments(payload),
            sourceTurnId = item.turnId?.trim()?.takeIf(String::isNotEmpty),
            historyDetailRefs = CodexHistoryDetailRef.parseList(item.detailRefsJson),
            historyDetailRefsTruncated = item.detailRefsTruncated
        )
    }.getOrNull()
}

private fun extractCachedMediaAttachments(payload: JSONObject): List<CodexMessageAttachment> {
    val result = mutableListOf<CodexMessageAttachment>()
    fun visit(value: Any?) {
        when (value) {
            is JSONObject -> {
                val descriptor = CodexMediaDescriptor.from(value)
                if (descriptor != null) {
                    result += CodexMessageAttachment(
                        kind = "image",
                        label = "图片",
                        path = descriptor.originalPath,
                        url = descriptor.originalPath,
                        source = "history-media",
                        dedupeKey = descriptor.contentHash,
                        contentHash = descriptor.contentHash,
                        thumbnailHash = descriptor.thumbnailHash,
                        thumbnailUrl = descriptor.thumbnailPath,
                        mimeType = descriptor.mimeType,
                        byteSize = descriptor.byteSize,
                        thumbnailUnavailable = descriptor.thumbnailUnavailable
                    )
                } else {
                    val keys = value.keys()
                    while (keys.hasNext()) visit(value.opt(keys.next()))
                }
            }
            is JSONArray -> for (index in 0 until value.length()) visit(value.opt(index))
        }
    }
    visit(payload)
    return result.distinctBy { it.dedupeKey ?: it.url ?: it.path }
}

private fun surfaceEntryAttachmentsForUi(entry: SurfaceEntry): List<CodexMessageAttachment> =
    entry.attachments.mapNotNull { attachment ->
        val media = attachment.media
        if (media != null) {
            return@mapNotNull CodexMessageAttachment(
                kind = "image",
                label = "图片",
                path = media.originalPath,
                url = media.originalPath,
                source = "surface-media",
                dedupeKey = media.contentHash,
                contentHash = media.contentHash,
                thumbnailHash = media.thumbnailHash,
                thumbnailUrl = media.thumbnailPath,
                mimeType = media.mimeType,
                byteSize = media.byteSize,
                thumbnailUnavailable = media.thumbnailUnavailable
            )
        }
        val target = attachment.url?.trim()?.takeIf { it.isNotBlank() }
            ?: attachment.path?.trim()?.takeIf { it.isNotBlank() }
            ?: return@mapNotNull null
        val label = target.substringBefore('?').substringBefore('#')
            .substringAfterLast('/').substringAfterLast('\\')
            .takeIf { it.isNotBlank() } ?: "图片"
        CodexMessageAttachment(
            kind = attachment.type.ifBlank { "image" },
            label = label,
            path = attachment.path,
            url = attachment.url,
            source = "surface"
        )
    }

internal fun collapseCompletedCommandBatchesForUi(
    messages: List<ChatMessage>,
    collapsibleTurnIds: Set<String>? = null
): List<ChatMessage> {
    if (messages.size < 2) return deduplicateChatMessagesByIdForUi(messages)
    val result = mutableListOf<ChatMessage>()
    var index = 0
    while (index < messages.size) {
        val first = messages[index]
        val turnId = first.operationTurnId?.trim().orEmpty()
        if (first.operationType != "command" || turnId.isBlank()) {
            result += first
            index += 1
            continue
        }

        var endExclusive = index + 1
        while (endExclusive < messages.size) {
            val candidate = messages[endExclusive]
            if (
                candidate.operationType != "command" ||
                candidate.operationTurnId?.trim() != turnId
            ) {
                break
            }
            endExclusive += 1
        }
        val batch = messages.subList(index, endExclusive)
        val shouldCollapse = batch.size >= 2 &&
            (collapsibleTurnIds == null || turnId in collapsibleTurnIds) &&
            batch.all { message ->
            isTerminalCommandOperationStatus(message.operationStatus)
        }
        if (!shouldCollapse) {
            result.addAll(batch)
            index = endExclusive
            continue
        }

        val existingBatchIds = batch
            .filter(::isCommandBatchMessageForUi)
            .mapTo(mutableSetOf()) { it.id }
        val existingBatchMemberIds = batch
            .filter(::isCommandBatchMessageForUi)
            .flatMapTo(mutableSetOf()) { commandOperationMemberIdsForUi(it) }
        val batchContent = batch.filter { message ->
            if (isCommandBatchMessageForUi(message)) {
                existingBatchIds.remove(message.id)
            } else {
                message.id !in existingBatchMemberIds
            }
        }
        val memberIds = batch
            .flatMap(::commandOperationMemberIdsForUi)
            .distinct()
        val existingBatch = batch.firstOrNull(::isCommandBatchMessageForUi)
        val batchId = existingBatch?.id
            ?: "command-batch:$turnId:${memberIds.firstOrNull() ?: first.id}"
        val legacyBatches = batch.filter {
            isCommandBatchMessageForUi(it) && it.operationBatchMemberIds.isEmpty()
        }
        val legacyBatchMemberIds = legacyBatches
            .flatMapTo(mutableSetOf()) { commandOperationMemberIdsForUi(it) }
        val legacyBatchSize = legacyBatches.sumOf {
            it.operationBatchSize.coerceAtLeast(1)
        }
        val newOperationCount = batch
            .filterNot(::isCommandBatchMessageForUi)
            .map { commandOperationMemberIdsForUi(it) }
            .flatten()
            .distinct()
            .count { it !in legacyBatchMemberIds }
        val representedSize = if (legacyBatches.isEmpty()) {
            memberIds.size
        } else {
            maxOf(memberIds.size, legacyBatchSize + newOperationCount)
        }
        val content = batchContent
            .map { it.content.trim() }
            .filter { it.isNotBlank() }
            .joinToString("\n\n")
        result += first.copy(
            id = batchId,
            content = content,
            streaming = false,
            operationStatus = "completed",
            operationBatchSize = representedSize,
            operationBatchMemberIds = memberIds
        )
        index = endExclusive
    }
    return deduplicateChatMessagesByIdForUi(result)
}

private fun isTerminalCommandOperationStatus(status: String?): Boolean {
    return status?.trim()?.lowercase() in setOf(
        "completed",
        "complete",
        "done",
        "finished",
        "succeeded",
        "success",
        "failed",
        "error",
        "cancelled",
        "canceled",
        "interrupted"
    )
}

internal fun resolveSurfaceCurrentTurnId(
    status: String?,
    latestTurnId: String?,
    currentTurnId: String?
): String? {
    val normalized = status?.trim()?.lowercase().orEmpty()
    return when (normalized) {
        "running", "waiting_for_approval", "waiting_for_input" ->
            normalizeCodexThreadId(latestTurnId) ?: currentTurnId
        "completed", "complete", "done", "finished", "failed", "error", "cancelled", "canceled", "interrupted", "idle" -> null
        else -> currentTurnId
    }
}

internal fun canonicalOperationMessageForUi(
    item: JSONObject,
    turnId: String?,
    itemIndex: Int
): ChatMessage? {
    val type = item.optString("type", "")
    val operationType = when (type) {
        "commandExecution" -> "command"
        "fileChange" -> "file_change"
        "mcpToolCall" -> "mcp_tool"
        else -> return null
    }
    val status = item.optStringOrNullCompat("status")
    if (status.equals("pending_approval", ignoreCase = true) ||
        status.equals("awaiting_approval", ignoreCase = true)) {
        return null
    }
    val itemId = item.optStringOrNullCompat("id") ?: itemIndex.toString()
    val (label, detail) = when (operationType) {
        "command" -> buildCanonicalCommandOperation(item, status)
        "file_change" -> buildCanonicalFileOperation(item, status)
        else -> buildCanonicalMcpOperation(item, status)
    }
    return ChatMessage(
        id = "canonical-operation:${turnId.orEmpty()}:$operationType:$itemId",
        role = ChatMessage.Role.TOOL,
        content = truncateCanonicalOperationDetail(detail),
        collapsible = true,
        collapsedLabel = label,
        operationType = operationType,
        operationStatus = status,
        operationTurnId = turnId,
        operationBatchSize = 1,
        operationBatchMemberIds = listOf("canonical-operation:${turnId.orEmpty()}:$operationType:$itemId")
    )
}

internal fun canonicalImageViewMessageForUi(
    item: JSONObject,
    turnId: String?,
    itemIndex: Int
): ChatMessage? {
    val target = item.optStringOrNullCompat("path")?.trim()
        ?.takeIf { it.isNotBlank() }
        ?: item.optStringOrNullCompat("url")?.trim()?.takeIf { it.isNotBlank() }
        ?: return null
    val label = target.substringBefore('?').substringBefore('#')
        .substringAfterLast('/').substringAfterLast('\\')
        .takeIf { it.isNotBlank() } ?: "图片"
    return ChatMessage(
        id = "canonical-image:${turnId.orEmpty()}:$itemIndex",
        role = ChatMessage.Role.SYSTEM,
        content = "已查看图片",
        attachments = listOf(
            CodexMessageAttachment(
                kind = "image",
                label = label,
                path = item.optStringOrNullCompat("path"),
                url = item.optStringOrNullCompat("url"),
                source = "canonical"
            )
        )
    )
}

private fun buildCanonicalCommandOperation(item: JSONObject, status: String?): Pair<String, String> {
    val command = item.optStringOrNullCompat("command").orEmpty()
    val label = operationLabelForStatus("命令", status)
    val lines = mutableListOf<String>()
    if (command.isNotEmpty()) lines.add("$ $command")
    appendCanonicalDetail(lines, "工作目录", item.opt("cwd"))
    appendCanonicalDetail(lines, "提示", item.opt("prompt"))
    appendCanonicalBlock(lines, "输出", item.opt("output"))
    appendCanonicalBlock(lines, "聚合输出", item.opt("aggregatedOutput"))
    val result = item.optJSONObject("result")
    appendCanonicalBlock(lines, "标准输出", result?.opt("stdout"))
    appendCanonicalBlock(lines, "标准错误", result?.opt("stderr") ?: item.opt("stderr"))
    appendCanonicalBlock(lines, "结果", result?.opt("output") ?: result?.opt("result"))
    appendCanonicalDetail(lines, "退出码", item.opt("exitCode") ?: result?.opt("exitCode"))
    appendCanonicalDetail(lines, "状态", status)
    return label to (lines.joinToString("\n\n").ifBlank { label })
}

private fun buildCanonicalFileOperation(item: JSONObject, status: String?): Pair<String, String> {
    val label = operationLabelForStatus("文件变更", status)
    val lines = mutableListOf<String>()
    val changes = item.optJSONArray("changes")
    if (changes != null) {
        for (index in 0 until changes.length()) {
            val change = changes.optJSONObject(index) ?: continue
            val path = change.optStringOrNullCompat("path").orEmpty()
            val kind = change.optStringOrNullCompat("type")
                ?: change.optStringOrNullCompat("changeType")
                ?: change.optStringOrNullCompat("kind")
            if (path.isNotEmpty()) lines.add(if (kind.isNullOrBlank()) path else "$kind: $path")
        }
    }
    appendCanonicalDetail(lines, "摘要", item.opt("summary"))
    appendCanonicalBlock(lines, "补丁", item.opt("patch"))
    appendCanonicalBlock(lines, "输出", item.opt("output"))
    appendCanonicalBlock(lines, "内容", item.opt("text"))
    appendCanonicalDetail(lines, "状态", status)
    return label to (lines.joinToString("\n\n").ifBlank { label })
}

private fun buildCanonicalMcpOperation(item: JSONObject, status: String?): Pair<String, String> {
    val label = operationLabelForStatus("工具调用", status)
    val lines = mutableListOf<String>()
    val server = item.optStringOrNullCompat("server")
        ?: item.optStringOrNullCompat("serverName")
    val tool = item.optStringOrNullCompat("name")
        ?: item.optStringOrNullCompat("toolName")
    appendCanonicalDetail(lines, "服务", server)
    appendCanonicalDetail(lines, "工具", tool)
    appendCanonicalBlock(
        lines,
        "参数",
        item.opt("arguments").takeUnless { it == null || it == JSONObject.NULL }
            ?: item.opt("args").takeUnless { it == null || it == JSONObject.NULL }
            ?: item.opt("input").takeUnless { it == null || it == JSONObject.NULL }
            ?: item.opt("toolParams").takeUnless { it == null || it == JSONObject.NULL }
            ?: item.opt("tool_params")
    )
    appendCanonicalBlock(lines, "输出", item.opt("output"))
    appendCanonicalBlock(lines, "结果", item.opt("result"))
    appendCanonicalBlock(lines, "错误", item.opt("error"))
    appendCanonicalDetail(lines, "状态", status)
    return label to (lines.joinToString("\n\n").ifBlank { label })
}

private fun operationLabelForStatus(subject: String, status: String?): String = when {
    status.equals("failed", ignoreCase = true) || status.equals("error", ignoreCase = true) -> "$subject 失败"
    status.equals("in_progress", ignoreCase = true) ||
        status.equals("inProgress", ignoreCase = true) ||
        status.equals("running", ignoreCase = true) -> "${subject}进行中"
    else -> subject
}

private fun appendCanonicalDetail(lines: MutableList<String>, label: String, value: Any?) {
    renderCanonicalOperationValue(value)?.let { lines.add("$label：$it") }
}

private fun appendCanonicalBlock(lines: MutableList<String>, label: String, value: Any?) {
    renderCanonicalOperationValue(value)?.let { lines.add("$label：\n$it") }
}

private fun renderCanonicalOperationValue(value: Any?): String? = when (value) {
    null, JSONObject.NULL -> null
    is String -> value.takeIf { it.isNotEmpty() }
    is Number, is Boolean -> value.toString()
    is JSONObject -> value.toString(2)
    is JSONArray -> value.toString(2)
    else -> null
}

private fun truncateCanonicalOperationDetail(value: String): String =
    if (value.length <= OPERATION_DETAIL_MAX_LENGTH) {
        value
    } else {
        value.take(OPERATION_DETAIL_MAX_LENGTH - OPERATION_DETAIL_TRUNCATION_MARKER.length) +
            OPERATION_DETAIL_TRUNCATION_MARKER
    }

internal fun shouldTrackExecutionWatchForUiState(
    state: CodexUiState,
    ipcStatusObserved: Boolean = true
): Boolean {
    if (state.errorMessage != null || state.connectionState == ConnectionState.ERROR) {
        return false
    }
    return ipcStatusObserved && !state.ipcOnline && !state.currentTurnId.isNullOrBlank()
}

internal fun mergePendingApproval(
    existing: List<CodexServerRequest>,
    pending: PendingApprovalInfo?
): List<CodexServerRequest> {
    val withoutStaleIpcApprovals = existing.filterNot { it.isIpcFollowerApprovalRequest() }
    if (pending == null) return withoutStaleIpcApprovals
    val reqId = pending.requestId ?: return withoutStaleIpcApprovals
    return withoutStaleIpcApprovals + CodexServerRequest(
        requestId = reqId,
        method = pending.method ?: "item/commandExecution/requestApproval",
        requestKind = pending.requestKind ?: pending.kind,
        responseMode = pending.responseMode ?: "decision",
        handledBy = "ipc_follower",
        summary = pending.description ?: pending.title ?: "等待审批",
        questionCount = 1,
        command = pending.command,
        questions = emptyList(),
        params = JSONObject().apply {
            put("availableDecisions", JSONArray().apply {
                pending.availableDecisions.forEach { put(it) }
            })
        },
        defaultResult = null
    )
}

private fun CodexServerRequest.isIpcFollowerApprovalRequest(): Boolean {
    if (!handledBy.equals("ipc_follower", ignoreCase = true)) return false
    if (!responseMode.equals("decision", ignoreCase = true)) return false
    return requestKind in setOf("approval", "command", "file", "patch", "permissions")
}

internal fun resolveIpcFollowerApprovalDecision(
    request: CodexServerRequest,
    approved: Boolean
): String {
    val decisions = request.params
        ?.optJSONArray("availableDecisions")
        ?.let { array ->
            (0 until array.length())
                .mapNotNull { index -> array.optString(index, "").trim().takeIf { it.isNotEmpty() } }
        }
        .orEmpty()
    if (!approved) {
        return when {
            "decline" in decisions -> "decline"
            "reject" in decisions -> "reject"
            "cancel" in decisions -> "cancel"
            else -> "decline"
        }
    }
    return when {
        decisions.isEmpty() -> "accept"
        "accept" in decisions -> "accept"
        "acceptForSession" in decisions -> "acceptForSession"
        "acceptWithExecpolicyAmendment" in decisions -> "acceptWithExecpolicyAmendment"
        else -> decisions.first()
    }
}

internal fun buildDirectApprovalDecisionResult(
    request: CodexServerRequest,
    approved: Boolean
): JSONObject? {
    if (!request.responseMode.equals("decision", ignoreCase = true)) {
        return null
    }
    if (request.method == "item/permissions/requestApproval") {
        val requestedPermissions = request.params?.optJSONObject("permissions")
        val permissions = if (approved && requestedPermissions != null) {
            JSONObject(requestedPermissions.toString())
        } else {
            JSONObject()
        }
        return JSONObject()
            .put("permissions", permissions)
            .put("scope", "turn")
    }
    val decision = when (request.method) {
        "item/commandExecution/requestApproval" -> if (approved) "accept" else "decline"
        "item/fileChange/requestApproval" -> if (approved) "approve" else "decline"
        "applyPatchApproval", "execCommandApproval" -> if (approved) "approved" else "denied"
        else -> return null
    }
    return JSONObject().put("decision", decision)
}

internal fun mergePendingUserInput(
    existing: List<CodexServerRequest>,
    pending: CodexServerRequest?
): List<CodexServerRequest> {
    // The IPC surface contains the authoritative *single* user-input request.
    // Once the owner has accepted an answer it is omitted from the next
    // snapshot. Do not retain the old follower request (and its submitting
    // dialog) while preserving unrelated canonical/client requests.
    val withoutStaleIpcUserInputs = existing.filterNot { it.isIpcFollowerUserInputRequest() }
    if (pending == null) return withoutStaleIpcUserInputs
    return withoutStaleIpcUserInputs + pending.copy(handledBy = "ipc_follower")
}

private fun CodexServerRequest.isIpcFollowerUserInputRequest(): Boolean =
    handledBy.equals("ipc_follower", ignoreCase = true) &&
        responseMode.equals("answers", ignoreCase = true)

internal fun upsertPendingServerRequest(
    current: List<CodexServerRequest>,
    request: CodexServerRequest
): List<CodexServerRequest> {
    val existingIndex = current.indexOfFirst { it.requestId == request.requestId }
    if (existingIndex == -1) {
        return current + request
    }
    return current.toMutableList().also { it[existingIndex] = request }
}

internal fun mergePlanWorkflow(
    current: CodexPlanWorkflowState,
    action: PendingPlanActionInfo?
): CodexPlanWorkflowState {
    if (action == null) return clearStaleIpcPlanWorkflow(current)
    val nextPlanContent = action.planContent ?: current.planContent
    val isAwaitingOwnerSnapshot = current.phase == PLAN_PHASE_EXECUTING_CONFIRMED_PLAN &&
        current.planRequestId != null &&
        current.planRequestId == action.requestId
    return current.copy(
        phase = if (isAwaitingOwnerSnapshot) {
            PLAN_PHASE_EXECUTING_CONFIRMED_PLAN
        } else if (action.canSubmit && !nextPlanContent.isNullOrBlank()) {
            PLAN_PHASE_READY_FOR_CONFIRMATION
        } else {
            current.phase
        },
        planContent = nextPlanContent,
        latestPlanText = nextPlanContent ?: current.latestPlanText,
        confirmedPlanText = if (action.canSubmit && !nextPlanContent.isNullOrBlank()) {
            nextPlanContent
        } else {
            current.confirmedPlanText
        },
        canSubmitPlan = action.canSubmit,
        planRequestId = action.requestId ?: current.planRequestId,
        planRequestMethod = action.requestMethod ?: current.planRequestMethod,
        planQuestionId = action.questionId ?: current.planQuestionId
    )
}

internal fun clearStaleIpcPlanWorkflow(current: CodexPlanWorkflowState): CodexPlanWorkflowState {
    val hasIpcPlanState = current.planContent != null ||
        current.canSubmitPlan ||
        current.planRequestId != null ||
        current.planRequestMethod != null ||
        current.planQuestionId != null
    return if (hasIpcPlanState) CodexPlanWorkflowState() else current
}

internal fun normalizeCodexThreadId(threadId: String?): String? {
    val normalized = threadId?.trim()?.takeIf { it.isNotEmpty() } ?: return null
    return when {
        normalized.equals("null", ignoreCase = true) -> null
        normalized.equals("undefined", ignoreCase = true) -> null
        else -> normalized
    }
}

internal fun shouldPreserveCodexTailMessage(message: ChatMessage): Boolean {
    if (message.role == ChatMessage.Role.USER) {
        return message.content.isNotBlank() ||
            message.fileMentions.isNotEmpty() ||
            message.skills.isNotEmpty() ||
            message.attachments.isNotEmpty()
    }
    return message.content.isNotBlank() || message.streaming
}

/**
 * A ready event has no selection generation of its own.  Accept it only when
 * every already-known IPC identity agrees with the event, except for the
 * explicit new-thread hand-off where the active identity is intentionally
 * still empty.  This keeps a late foreign ready from rewriting the selected
 * conversation's thread/body pairing.
 */
internal fun shouldApplyThreadReadyToCurrentSelection(
    state: CodexUiState,
    readyThreadId: String?,
    resumed: Boolean
): Boolean {
    val incoming = normalizeCodexThreadId(readyThreadId)
    if (state.awaitingNewThreadIpcSurface && !resumed) return true
    if (incoming == null) return !resumed
    val knownIds = listOfNotNull(
        normalizeCodexThreadId(state.activeConversationId),
        normalizeCodexThreadId(state.threadId)
    ).distinct()
    if (resumed && knownIds.isEmpty()) return false
    return knownIds.isEmpty() || knownIds.all { it == incoming }
}

internal fun shouldPreserveLocalMessageTailForUi(
    threadId: String?,
    state: CodexUiState,
    allowThreadIdSwitch: Boolean = false
): Boolean {
    val normalizedStateThreadId = normalizeCodexThreadId(state.threadId)
    val normalizedIncomingThreadId = normalizeCodexThreadId(threadId)
    val sameThread = normalizedStateThreadId == null ||
        normalizedIncomingThreadId == null ||
        normalizedStateThreadId == normalizedIncomingThreadId
    val knownThreadSwitch = allowThreadIdSwitch &&
        normalizedStateThreadId != null &&
        normalizedIncomingThreadId != null &&
        normalizedStateThreadId != normalizedIncomingThreadId
    if (!sameThread && !knownThreadSwitch) {
        return false
    }
    if (!state.currentTurnId.isNullOrBlank()) {
        return true
    }
    val tail = state.messages.lastOrNull() ?: return false
    return tail.role == ChatMessage.Role.USER && shouldPreserveCodexTailMessage(tail)
}

internal fun buildThreadReadyUiTransition(
    readyThreadId: String?,
    resumed: Boolean,
    state: CodexUiState,
    allowThreadIdSwitch: Boolean = false
): ThreadReadyUiTransition {
    val readyMatchesCurrentSelection = shouldApplyThreadReadyToCurrentSelection(
        state = state,
        readyThreadId = readyThreadId,
        resumed = resumed
    )
    val preserveLocalTail = if (resumed && !readyMatchesCurrentSelection) {
        false
    } else {
        shouldPreserveLocalMessageTailForUi(
            threadId = readyThreadId,
            state = state,
            allowThreadIdSwitch = allowThreadIdSwitch
        )
    }
    // `resumed` only authorizes retaining the body when the ready event still
    // belongs to the selected conversation.  A cross-thread resumed event is
    // an identity boundary, not proof that the current messages are reusable.
    val keepOptimisticMessages = preserveLocalTail ||
        (resumed && readyMatchesCurrentSelection)
    return ThreadReadyUiTransition(
        currentTurnId = if (preserveLocalTail) state.currentTurnId else null,
        messages = if (keepOptimisticMessages) state.messages else emptyList(),
        runtimePanel = if (keepOptimisticMessages) {
            state.runtimePanel
        } else {
            CodexRuntimePanelState(visible = state.runtimePanel.visible)
        }
    )
}

internal fun buildThreadStartedUiTransition(
    startedThreadId: String?,
    state: CodexUiState,
    allowThreadIdSwitch: Boolean = false
): ThreadReadyUiTransition {
    return buildThreadReadyUiTransition(
        readyThreadId = startedThreadId,
        resumed = false,
        state = state,
        allowThreadIdSwitch = allowThreadIdSwitch
    )
}

internal fun mergeCanonicalUserMessageMetadataForUi(
    canonical: ChatMessage,
    local: ChatMessage
): ChatMessage {
    if (canonical.role != ChatMessage.Role.USER || local.role != ChatMessage.Role.USER) {
        return canonical
    }
    val mergedMentions = (canonical.fileMentions + local.fileMentions)
        .distinctBy { mention -> mention.path.trim().lowercase() }
    val mergedSkills = (canonical.skills + local.skills)
        .distinctBy { skill ->
            "${skill.name.trim().lowercase()}::${skill.path.orEmpty().trim().lowercase()}"
        }
    val mergedAttachments = (canonical.attachments + local.attachments)
        .distinctBy { attachment ->
            attachment.dedupeKey
                ?.trim()
                ?.takeIf { it.isNotEmpty() }
                ?.lowercase()
                ?: listOf(
                    attachment.kind.trim().lowercase(),
                    attachment.source.orEmpty().trim().lowercase(),
                    attachment.path.orEmpty().trim().lowercase(),
                    attachment.url.orEmpty().trim().lowercase(),
                    attachment.label.trim().lowercase()
                ).joinToString("::")
        }
    return canonical.copy(
        activeSkill = canonical.activeSkill ?: local.activeSkill ?: mergedSkills.firstOrNull()?.name,
        fileMentions = mergedMentions,
        skills = mergedSkills,
        attachments = mergedAttachments
    )
}

internal fun messageConvergenceKeyForUi(message: ChatMessage): String = buildString {
    append(message.role.name)
    append('|')
    append(message.contentType)
    append('|')
    append(message.toolName.orEmpty())
    append('|')
    append(message.collapsible)
    append('|')
    append(message.collapsedLabel.trim())
    append('|')
    append(message.operationType.orEmpty())
    append('|')
    append(message.operationStatus.orEmpty())
    append('|')
    append(message.operationTurnId.orEmpty())
    append('|')
    append(message.operationBatchSize)
    append('|')
    append(message.activeSkill.orEmpty())
    append('|')
    append(message.skills.joinToString(separator = "\u001F") { skill ->
        "${skill.name.trim()}::${skill.path.orEmpty().trim()}"
    })
    append('|')
    append(message.content.trim())
    append('|')
    append(message.fileMentions.joinToString(separator = "\u001F") { mention ->
        mention.path.trim()
    })
}

internal fun messagesEquivalentForConvergenceForUi(
    left: ChatMessage,
    right: ChatMessage
): Boolean = messageConvergenceKeyForUi(left) == messageConvergenceKeyForUi(right)

internal fun mergeCanonicalMessagesForUi(
    canonicalMessages: List<ChatMessage>,
    currentMessages: List<ChatMessage>,
    preserveLocalTail: Boolean
): List<ChatMessage> {
    if (!preserveLocalTail) {
        return canonicalMessages
    }
    if (currentMessages.isEmpty()) {
        return canonicalMessages
    }
    if (canonicalMessages.isEmpty()) {
        return currentMessages.filter(::shouldPreserveCodexTailMessage)
    }
    var searchStart = 0
    var lastMatchedCurrentIndex = -1
    val mergedCanonical = canonicalMessages.map { canonicalMessage ->
        var mergedMessage = canonicalMessage
        for (index in searchStart until currentMessages.size) {
            if (messagesEquivalentForConvergenceForUi(currentMessages[index], canonicalMessage)) {
                lastMatchedCurrentIndex = index
                searchStart = index + 1
                mergedMessage = mergeCanonicalUserMessageMetadataForUi(
                    canonical = canonicalMessage,
                    local = currentMessages[index]
                )
                break
            }
        }
        mergedMessage
    }
    val localTail = currentMessages
        .subList((lastMatchedCurrentIndex + 1).coerceAtMost(currentMessages.size), currentMessages.size)
        .filter(::shouldPreserveCodexTailMessage)
    if (localTail.isEmpty()) {
        return mergedCanonical
    }
    val merged = mergedCanonical.toMutableList()
    localTail.forEach { message ->
        if (merged.none { existing -> messagesEquivalentForConvergenceForUi(existing, message) }) {
            merged.add(message)
        }
    }
    return merged
}

/**
 * Append a verified canonical tail without rebuilding the older cache. Route
 * 3 is display-only, so it must never delete a local/live item when the
 * server returns only a suffix.
 */
internal fun mergeCanonicalTailMessagesForUi(
    currentMessages: List<ChatMessage>,
    tailMessages: List<ChatMessage>
): List<ChatMessage> {
    if (tailMessages.isEmpty()) return currentMessages
    val merged = currentMessages.toMutableList()
    for (incoming in tailMessages) {
        val exactIndex = merged.indexOfFirst { it.id == incoming.id }
        if (exactIndex >= 0) {
            merged[exactIndex] = mergeCanonicalUserMessageMetadataForUi(
                canonical = incoming,
                local = merged[exactIndex]
            )
            continue
        }
        if (merged.any { existing -> messagesEquivalentForConvergenceForUi(existing, incoming) }) {
            continue
        }
        merged += incoming
    }
    return deduplicateChatMessagesByIdForUi(merged)
}

internal fun buildThreadReadMergeTransition(
    incomingThreadId: String?,
    canonicalMessages: List<ChatMessage>,
    state: CodexUiState,
    allowThreadIdSwitch: Boolean = false
): ThreadReadMergeTransition {
    val resolvedThreadId = normalizeCodexThreadId(incomingThreadId) ?: state.threadId
    val preserveLocalTail = shouldPreserveLocalMessageTailForUi(
        threadId = resolvedThreadId,
        state = state,
        allowThreadIdSwitch = allowThreadIdSwitch
    )
    return ThreadReadMergeTransition(
        threadId = resolvedThreadId,
        currentTurnId = state.currentTurnId,
        messages = mergeCanonicalMessagesForUi(
            canonicalMessages = canonicalMessages,
            currentMessages = state.messages,
            preserveLocalTail = preserveLocalTail
        )
    )
}

internal fun resolveLaunchHydrateThreadRequest(
    pendingLaunchHydrate: Boolean,
    requestedThreadId: String?,
    observedThreadId: String?,
    inFlightThreadId: String?
): String? {
    if (!pendingLaunchHydrate) {
        return null
    }
    val targetThreadId = normalizeCodexThreadId(requestedThreadId)
        ?: normalizeCodexThreadId(observedThreadId)
        ?: return null
    return if (normalizeCodexThreadId(inFlightThreadId) == targetThreadId) {
        null
    } else {
        targetThreadId
    }
}

class CodexViewModel(
    appContext: Context,
    credentialStore: BasicCredentialStore,
    private val sessionApiClient: SessionApiClient
) : ViewModel() {

    companion object {
        private const val TAG = "CodexViewModel"
        private const val DEBUG_REQUEST_PREFIX = "debug-request-"
        private const val PLAN_PHASE_IDLE = "idle"
        private const val PLAN_PHASE_PLANNING = "planning"
        private const val PLAN_PHASE_AWAITING_USER_INPUT = "awaiting_user_input"
        private const val IPC_SURFACE_WAIT_GRACE_MILLIS = 5_000L
        private const val IPC_RECOVERY_TICK_MILLIS = 1_000L
        private const val IPC_RECOVERY_RESUBSCRIBE_MILLIS = 10_000L
        // set_active_conversation and history sync travel on the same
        // WebSocket, but the Gateway processes them in separate handler
        // turns. Keep the first history request behind a small settle window
        // so a reconnect cannot be rejected as conversation_not_active.
        private const val HISTORY_SUBSCRIPTION_SETTLE_MILLIS = 300L
        // Keep each silent older request discrete.  The server-side scheduler
        // still decides whether its next frame may be generated when live or
        // control work is pending.
        private const val HISTORY_OLDER_PUMP_DELAY_MILLIS = 250L
        private const val HISTORY_WATCHDOG_GRACE_MILLIS = 5_000L
        private const val CANONICAL_ACTIVITY_WINDOW_MILLIS = 30_000L
        private val ANSI_ESCAPE_REGEX = Regex("\\u001B\\[[;\\d?]*[ -/]*[@-~]")
    }

    private val appContext = appContext.applicationContext
    private val connectionManager = CodexConnectionManager(viewModelScope, credentialStore, sessionApiClient, this.appContext)
    private val historyCacheStore = CodexConversationCacheStore(this.appContext)
    private val rememberedTaskConfig = this.appContext.getSharedPreferences(
        REMEMBERED_CONFIG_PREFS,
        Context.MODE_PRIVATE
    )
    private val goalHistoryStore = this.appContext.getSharedPreferences(
        GOAL_HISTORY_PREFS,
        Context.MODE_PRIVATE
    )

    private val _uiState = CodexUiStateDiagnosticFlow(
        delegate = MutableStateFlow(CodexUiState()),
        selectionGeneration = { historySelectionGeneration }
    )
    val uiState: StateFlow<CodexUiState> = _uiState.asStateFlow()

    private var currentStreamingMessageId: String? = null
    private var currentPlanStreamingMessageId: String? = null
    private val executionFeedbackSeen = mutableSetOf<String>()
    private var currentProfile: ServerProfile? = null
    private var mentionSearchGeneration: Long = 0L
    private var modelCatalogRequestGeneration: Long = 0L
    private var legacyModelListFallbackRequested: Boolean = false
    /** Tracks whether the current thread had a plan-mode turn.
     *  The Codex API persists plan mode per-thread, so a subsequent
     *  non-plan turn on the same thread still produces plan output.
     *  When this flag is true and the next turn is non-plan,
     *  we force a new thread to avoid thread-level plan contamination. */
    private var threadHadPlanTurn = false
    private var pendingOptimisticNewThreadSourceThreadId: String? = null
    private var pendingThreadResyncThreadId: String? = null
    private var threadResyncInFlightThreadId: String? = null
    private var launchHydratePending: Boolean = false
    private var launchHydrateTargetThreadId: String? = null
    private var launchHydrateInFlightThreadId: String? = null
    private var pinnedIpcConversationId: String? = null
    private var historySyncInFlightConversationId: String? = null
    private var historySyncInFlightSyncId: String? = null
    /** Terminal history-sync responses are settled for one selection generation. */
    private var historySyncSettledConversationId: String? = null
    private var historySyncSettledGeneration: Long = -1L
    /** Target being read before an atomic history selection commit. */
    private var pendingHistorySelectionKey: CodexHistorySelectionKey? = null
    private var historyCapability: CodexHistoryCapability? = null
    /** Set only after B4R proves a durable, complete static snapshot for this selection. */
    @Volatile
    private var completeServerSnapshotCacheSelectionKey: CodexHistorySelectionKey? = null
    /** One DB-only product probe per complete-cache selection. */
    @Volatile
    private var productHistoryProbeSelectionKey: CodexHistorySelectionKey? = null
    /**
     * Step 3 canonical-tail validation is intentionally not represented in
     * CodexUiState.  It neither changes visible body/authority nor joins the
     * ordinary history-sync/recovery lane; this private state only fences the
     * one read-only intent and records its diagnostic result for the current
     * selection.
     */
    private var tailValidationMetadataSelectionKey: CodexHistorySelectionKey? = null
    private var tailValidationAwaitingMetadataKey: CodexHistorySelectionKey? = null
    private var tailValidationInFlightKey: CodexHistorySelectionKey? = null
    private var tailValidationInFlightSyncId: String? = null
    private var tailValidationSettledKey: CodexHistorySelectionKey? = null
    private var tailValidationOutcome: CanonicalTailValidationOutcome? = null
    private var tailValidationDetailCode: String? = null
    private var tailValidationDispatchJob: Job? = null
    private var tailValidationWatchdogJob: Job? = null
    /** Route 3 replay is a private, one-shot selection observation. */
    private var liveReplayRequestedKey: CodexHistorySelectionKey? = null
    private var liveReplayInFlightSyncId: String? = null
    private var liveReplayOutcome: String? = null
    private var liveReplayDetailCode: String? = null
    /**
     * P0-C is a background durable lane. These contexts are keyed by the
     * target cache partition and terminal epoch rather than by active UI
     * selection, so an A→B change cannot redirect an already-started A write.
     */
    private val terminalReconcileContexts = ConcurrentHashMap<TerminalReconcileKey, TerminalReconcileContext>()
    private val terminalReconcileContextsBySyncId = ConcurrentHashMap<String, TerminalReconcileContext>()
    private val pendingTerminalReconcilePages = ConcurrentHashMap<String, CodexHistoryDeltaPage>()
    /** Client token carried by history envelopes to reject stale A→B→A work. */
    private var historySelectionGeneration: Long = 0L
    private data class DetailRead(
        val key: CodexHistorySelectionKey,
        val itemKey: String,
        val assembly: CodexHistoryDetailAssembly,
        val deadlineElapsed: Long = SystemClock.elapsedRealtime() + 120_000L,
        var requestId: String = ""
    )
    private var detailRead: DetailRead? = null
    private var detailSelectionKey: CodexHistorySelectionKey? = null
    private var detailTimeoutJob: Job? = null
    private var historyRecoveryInFlightConversationId: String? = null
    private var historyRecoveryInFlightSyncId: String? = null
    private var historyActivationRetryGeneration: Long = -1L
    private var historySyncAfterSubscriptionJob: Job? = null
    private val automaticOlderHistoryPump = AutomaticOlderHistoryPumpCoordinator(
        delayMillis = HISTORY_OLDER_PUMP_DELAY_MILLIS,
        schedule = { delayMillis, task ->
            val job = viewModelScope.launch {
                delay(delayMillis)
                task()
            }
            AutomaticOlderHistoryPumpHandle { job.cancel() }
        }
    )
    /** Sync ids whose terminal result may continue an enabled range pump. */
    private val rangeHistorySyncIds = ConcurrentHashMap.newKeySet<String>()
    /** Sync ids created by the one-page older request lane. */
    private val olderHistorySyncIds = ConcurrentHashMap.newKeySet<String>()
    /**
     * A recovery request is bounded to one attempt per selected conversation.
     * A partial surface is useful as a live tail, but it is not a complete
     * static history baseline; without this guard each partial ACK would
     * otherwise start another full upstream read.
     */
    private var historyRecoveryRequestedGeneration: Long = -1L
    private var historyWatchdogJob: Job? = null
    /**
     * Cache-first selection protection must be finite.  A legacy gateway may
     * accept thread/resume without ever returning a response; keeping the
     * pending id forever would quarantine legitimate unscoped notifications
     * for the selected conversation after the cache path has already settled.
     */
    private var historyResumeProtectionJob: Job? = null
    private val pendingHistoryPages = mutableMapOf<String, CodexHistoryDeltaPage>()
    /** P0-B.4R fragments remain in memory until their one atomic range commit. */
    private val pendingHistorySnapshotSegments = mutableMapOf<String, PendingHistorySnapshotSegment>()
    private val historyApplyMutex = Mutex()
    private var mediaClient: CodexMediaClient? = null
    // Media jobs are scheduled from the main state flow but complete on
    // Dispatchers.IO. Keep both registries concurrent so a fast A→B switch
    // cannot race an old download's finally/remove with the new selection.
    private val mediaJobs = ConcurrentHashMap<String, Job>()
    private val mediaPrefetchSeen = ConcurrentHashMap.newKeySet<String>()
    private val mediaPrefetchPermits = Semaphore(3)
    private var threadListRequestProfileId: String? = null
    private var threadListRequestGeneration: Long = 0L
    private var threadListRequestCwd: String? = null
    private var pendingHistoryResumeHydrationThreadId: String? = null
    private var activeConversationSubscriptionId: String? = null
    private var activeConversationSubscriptionGeneration: Long = -1L
    private var activeConversationSubscriptionSentAtElapsed: Long = 0L
    /** Cache-first selection commit already performed this exact hydrate. */
    private var lastCommittedHistoryCacheKey: CodexHistorySelectionKey? = null
    private var foregroundFollowJob: Job? = null
    private var foregroundHostVisible: Boolean = false
    private var ipcStatusObserved: Boolean = false
    private var awaitingFreshIpcSurface: Boolean = false
    private var matchingIpcSurfaceDesynced: Boolean = false
    private var ipcAuthorityModeEnteredAtElapsed: Long = 0L
    private var lastRecoverySubscribeAtElapsed: Long = 0L
    private var canonicalActivityThreadId: String? = null
    private var canonicalLatestTurnFingerprint: Int? = null
    private var lastCanonicalActivityAtElapsed: Long = 0L

    init {
        observeConnectionState()
        observeWsEvents()
        viewModelScope.launch {
            uiState.collect { state ->
                val detail = state.historyDetail ?: return@collect
                val read = detailRead
                if (detailSelectionKey?.let(::isCurrentHistorySelection) != true) {
                    dismissHistoryDetail()
                } else if (read != null && !hasCurrentDetailRef(read) && detail.error != "detail_ref_changed") {
                    failHistoryDetail("detail_ref_changed")
                }
            }
        }
    }

    fun dismissHistoryDetail() {
        detailTimeoutJob?.cancel()
        detailTimeoutJob = null
        detailRead = null
        detailSelectionKey = null
        _uiState.update { it.copy(historyDetail = null) }
    }

    fun openHistoryDetail(itemKey: String, ref: CodexHistoryDetailRef) {
        dismissHistoryDetail()
        val conversationId = _uiState.value.activeConversationId ?: return
        val key = currentHistorySelectionKey(conversationId, historySelectionGeneration) ?: return
        if (_uiState.value.cachedCanonicalMessages.none { it.id == itemKey && ref in it.historyDetailRefs }) return
        val assembly = runCatching { CodexHistoryDetailAssembly(ref) }
        val read = assembly.getOrNull()?.let { DetailRead(key, itemKey, it) }
        detailRead = read
        detailSelectionKey = key
        _uiState.update { it.copy(historyDetail = CodexHistoryDetailUiState(itemKey, ref,
            loading = read != null, error = assembly.exceptionOrNull()?.message)) }
        if (read == null) return
        if (historyCapability?.productHistory?.isSupported() != true) {
            failHistoryDetail("detail_unsupported")
            return
        }
        sendHistoryDetailChunk(read)
    }

    private fun hasCurrentDetailRef(read: DetailRead): Boolean =
        _uiState.value.cachedCanonicalMessages.any {
            it.id == read.itemKey && read.assembly.ref in it.historyDetailRefs
        }

    private fun failHistoryDetail(code: String) {
        detailTimeoutJob?.cancel()
        detailTimeoutJob = null
        _uiState.update { state -> state.copy(historyDetail = state.historyDetail?.copy(
            loading = false, content = null, error = code)) }
    }

    private fun sendHistoryDetailChunk(read: DetailRead) {
        if (!isCurrentHistorySelection(read.key) || !hasCurrentDetailRef(read)) {
            failHistoryDetail("detail_ref_changed")
            return
        }
        val remainingMillis = read.deadlineElapsed - SystemClock.elapsedRealtime()
        if (remainingMillis <= 0L) {
            failHistoryDetail("detail_timeout")
            return
        }
        read.requestId = UUID.randomUUID().toString()
        val sent = connectionManager.send(CodexHistoryDetailAssembly.request(
            read.key.conversationId, read.requestId, read.key.generation,
            read.assembly.ref, read.assembly.nextCursor).toString())
        if (!sent) {
            failHistoryDetail("detail_send_failed")
            return
        }
        detailTimeoutJob?.cancel()
        detailTimeoutJob = viewModelScope.launch {
            delay(minOf(35_000L, remainingMillis))
            if (detailRead === read) failHistoryDetail("detail_timeout")
        }
    }

    private fun handleHistoryDetailResponse(json: JSONObject) {
        val read = detailRead ?: return
        if (!isCurrentHistorySelection(read.key) || _uiState.value.historyDetail?.loading != true ||
            !CodexHistoryDetailAssembly.matchesResponse(json, read.key.conversationId,
                read.requestId, read.key.generation)) return
        if (!hasCurrentDetailRef(read)) {
            failHistoryDetail("detail_ref_changed")
            return
        }
        runCatching { read.assembly.accept(json) }.onFailure {
            failHistoryDetail(it.message ?: "detail_invalid")
        }.onSuccess {
            _uiState.update { state -> state.copy(historyDetail = state.historyDetail?.copy(
                loading = read.assembly.content == null,
                receivedBytes = read.assembly.receivedBytes,
                content = read.assembly.content)) }
            if (read.assembly.content == null) sendHistoryDetailChunk(read)
            else {
                detailTimeoutJob?.cancel()
                detailTimeoutJob = null
            }
        }
    }

    // ── Public actions ────────────────────────────────────────────────

    fun connect(profile: ServerProfile, params: CodexLaunchParams) {
        mediaJobs.values.forEach { it.cancel() }
        mediaJobs.clear()
        mediaPrefetchSeen.clear()
        mediaClient = runCatching {
            CodexMediaClient.forProfile(
                context = appContext,
                profile = profile,
                sessionApiClient = sessionApiClient,
                cacheDir = appContext.filesDir
            )
        }.onFailure { error ->
            Log.w(TAG, "Media client unavailable for profile ${profile.id}", error)
        }.getOrNull()
        currentProfile = profile
        viewModelScope.launch(Dispatchers.IO) {
            historyCacheStore.upsertServiceMetadata(
                endpointId = profile.id,
                displayName = profile.name,
                origin = sanitizeProfileOrigin(profile.baseUrl),
                profilePresent = true
            )
        }
        currentStreamingMessageId = null
        currentPlanStreamingMessageId = null
        executionFeedbackSeen.clear()
        threadHadPlanTurn = false
        clearPendingOptimisticNewThreadTransition()
        clearPendingThreadResync()
        launchHydratePending = true
        launchHydrateTargetThreadId = normalizeThreadId(params.threadId)
        launchHydrateInFlightThreadId = null
        val launchConversationId = normalizeThreadId(params.threadId)
        dismissHistoryDetail()
        historySelectionGeneration += 1L
        historySyncInFlightConversationId = null
        historySyncInFlightSyncId = null
        clearHistorySyncSettlement()
        historyRecoveryInFlightConversationId = null
        historyRecoveryInFlightSyncId = null
        historyRecoveryRequestedGeneration = -1L
        historyActivationRetryGeneration = -1L
        cancelHistorySyncAfterSubscription()
        cancelHistoryOlderPump()
        rangeHistorySyncIds.clear()
        olderHistorySyncIds.clear()
        cancelHistoryWatchdog()
        cancelHistoryResumeProtection()
        pendingHistoryPages.clear()
        pendingHistorySnapshotSegments.clear()
        historyCapability = null
        completeServerSnapshotCacheSelectionKey = null
        liveReplayRequestedKey = null
        liveReplayInFlightSyncId = null
        liveReplayOutcome = null
        liveReplayDetailCode = null
        threadListRequestProfileId = null
        threadListRequestGeneration = historySelectionGeneration
        threadListRequestCwd = null
        val rememberedOverrides = loadRememberedTaskOverrides(launchConversationId, reason = "connect")
        pinnedIpcConversationId = launchConversationId
        pendingHistoryResumeHydrationThreadId = null
        ipcStatusObserved = false
        lastCommittedHistoryCacheKey = null
        awaitingFreshIpcSurface = false
        matchingIpcSurfaceDesynced = false
        ipcAuthorityModeEnteredAtElapsed = 0L
        lastRecoverySubscribeAtElapsed = 0L
        canonicalActivityThreadId = null
        canonicalLatestTurnFingerprint = null
        lastCanonicalActivityAtElapsed = 0L
        val previousActiveConvId = _uiState.value.activeConversationId?.trim().orEmpty()
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.connect.started",
            mapOf(
                "sessionId" to params.sessionId,
                "threadIdPresent" to !launchConversationId.isNullOrBlank(),
                "launchSource" to params.launchSource,
                "previousActiveConversationPresent" to previousActiveConvId.isNotBlank(),
                "profileId" to profile.id
            )
        )
        Log.i(TAG, "[ipc][connect] starting connection: " +
            "launchConversationId=${launchConversationId.orEmpty()} " +
            "launchThreadId=${params.threadId.orEmpty()} " +
            "launchSource=${params.launchSource} " +
            "previousActiveConversationId=$previousActiveConvId " +
            "sessionId=${params.sessionId} " +
            "profileId=${profile.id}")
        _uiState.update {
            recalculateNextTurnEffectiveConfig(
                it.copy(
                    sessionId = params.sessionId,
                    cwd = params.cwd,
                    threadId = launchConversationId,
                    currentTurnId = null,
                    messages = emptyList(),
                    errorMessage = null,
                    connectionErrorMessage = null,
                    connectionState = ConnectionState.CONNECTING,
                    serverNextTurnConfigBase = null,
                    ownerCurrentCodexConfig = null,
                    nextTurnEffectiveCodexConfig = null,
                    nextTurnOverrides = rememberedOverrides,
                    goalMode = false,
                    planWorkflow = buildEmptyPlanWorkflowState(),
                    pendingFileMentions = emptyList(),
                    fileMentionMenuVisible = false,
                    fileMentionQuery = "",
                    fileMentionResults = emptyList(),
                    fileMentionLoading = false,
                    pendingServerRequests = emptyList(),
                    submittingServerRequestIds = emptySet(),
                    sessionExpired = false,
                    executionWatch = CodexExecutionWatchState(),
                    runtimePanel = buildEmptyRuntimePanelState(),
                    noticesPanel = CodexNoticesPanelState(),
                    toolsPanel = CodexToolsPanelState(),
                    usagePanel = CodexUsagePanelState(),
                    pendingImageAttachments = emptyList(),
                    currentThreadTitle = "",
                    threadHistoryEntries = emptyList(),
                    threadHistorySheetVisible = false,
                    threadHistoryLoading = true,
                    threadHistoryActionThreadId = "",
                    threadHistoryActionKind = "",
                    threadRenameTargetId = "",
                    threadRenameDraft = "",
                    activeConversationId = launchConversationId,
                    historyCacheState = CodexHistoryCacheUiState(
                        conversationId = launchConversationId,
                        generation = historySelectionGeneration,
                        loadState = if (launchConversationId.isNullOrBlank()) {
                            CodexHistoryCacheLoadState.NOT_LOADED
                        } else {
                            CodexHistoryCacheLoadState.LOADING
                        }
                    ),
                    historyNetworkSyncState = CodexHistoryNetworkSyncUiState(
                        conversationId = launchConversationId,
                        generation = historySelectionGeneration
                    ),
                    awaitingNewThreadIpcSurface = false,
                    ipcSurfaceSnapshot = null,
                    activeGoal = null,
                    followerModeEnabled = true,
                    followerActiveSendAllowed = false
                )
            )
        }
        val cacheProfileId = profile.id
        val cacheSessionId = params.sessionId
        viewModelScope.launch(Dispatchers.IO) {
            val cachedIndex = runCatching {
                historyCacheStore.readThreadIndex(cacheProfileId)
            }.getOrDefault(emptyList())
            _uiState.update { state ->
                if (currentProfile?.id != cacheProfileId || state.sessionId != cacheSessionId) {
                    state
                } else {
                    state.copy(
                        threadHistoryEntries = mergeGoalHistoryEntries(
                            filterThreadHistoryEntriesForCwd(
                                cachedIndex.map(::toUiThreadHistoryEntry),
                                state.cwd
                            )
                        ),
                        threadHistoryLoading = false
                    )
                }
            }
        }
        if (!launchConversationId.isNullOrBlank()) {
            val launchHistoryKey = currentHistorySelectionKey(
                conversationId = launchConversationId,
                generation = historySelectionGeneration
            )
            viewModelScope.launch(Dispatchers.IO) {
                val cachedResult = runCatching {
                    historyCacheStore.readConversation(profile.id, launchConversationId)
                }
                val cached = cachedResult.getOrNull()
                if (launchHistoryKey != null && isCurrentHistorySelection(launchHistoryKey)) {
                    val snapshot = decodeHistoryCacheSnapshot(
                        key = launchHistoryKey,
                        cached = cached,
                        readError = cachedResult.exceptionOrNull()
                    )
                    _uiState.update { state ->
                        if (isCurrentHistorySelection(launchHistoryKey)) {
                            state.copy(
                                cachedCanonicalMessages = snapshot.messages,
                                messages = mergeCachedHistoryIntoLiveMessagesForUi(
                                    state = state,
                                    conversationId = launchConversationId,
                                    cachedMessages = snapshot.messages
                                ),
                                historyCacheState = snapshot.uiState
                            )
                        } else state
                    }
                    scheduleMediaPrefetch(snapshot.messages, launchHistoryKey.generation)
                }
            }
        }
        connectionManager.connect(profile, params.sessionId)
    }

    fun disconnect() {
        clearPendingOptimisticNewThreadTransition()
        clearPendingLaunchHydrate()
        pendingHistoryResumeHydrationThreadId = null
        advanceHistorySelectionGeneration("disconnect")
        threadListRequestProfileId = null
        threadListRequestCwd = null
        ipcStatusObserved = false
        connectionManager.disconnect()
    }

    /** Explicit user action: original media may be fetched on any network. */
    fun downloadOriginalAttachment(
        attachment: CodexMessageAttachment,
        onCompleted: (File?) -> Unit = {}
    ) {
        val hash = attachment.contentHash?.trim()?.takeIf { it.matches(Regex("^[0-9a-fA-F]{64}$")) }
            ?: return onCompleted(null)
        val client = mediaClient ?: return onCompleted(null)
        val selectionGeneration = historySelectionGeneration
        val conversationId = (_uiState.value.activeConversationId ?: _uiState.value.threadId).orEmpty().trim()
        viewModelScope.launch(Dispatchers.IO) {
            val file = runCatching {
                client.download(
                    contentHash = hash,
                    variant = CodexMediaVariant.ORIGINAL,
                    expectedHash = hash,
                    onProgress = { progress ->
                        // A→B switches invalidate the old download's UI too;
                        // never let an attachment from A paint progress over B.
                        if (isCurrentHistorySelection(conversationId, selectionGeneration)) {
                            _uiState.update {
                                it.copy(
                                    mediaDownloadHash = hash,
                                    mediaDownloadBytes = progress.downloadedBytes,
                                    mediaDownloadTotalBytes = progress.totalBytes
                                )
                            }
                        }
                    }
                )
            }.getOrNull()
            if (file != null && isCurrentHistorySelection(conversationId, selectionGeneration)) {
                val profile = currentProfile
                if (profile != null) {
                    historyCacheStore.upsertMediaBlob(
                        CodexMediaBlobRecord(
                            endpointId = profile.id,
                            contentHash = hash.lowercase(),
                            variant = CodexMediaVariant.ORIGINAL,
                            mimeType = attachment.mimeType,
                            byteSize = file.length(),
                            localPath = file.absolutePath,
                            state = "available",
                            lastAccessedAt = System.currentTimeMillis()
                        )
                    )
                    persistConversationMediaReference(
                        endpointId = profile.id,
                        conversationId = conversationId,
                        contentHash = hash,
                        thumbnailHash = attachment.thumbnailHash,
                        generation = selectionGeneration
                    )
                }
            }
            withContext(Dispatchers.Main) {
                _uiState.update {
                    if (isCurrentHistorySelection(conversationId, selectionGeneration) &&
                        it.mediaDownloadHash.equals(hash, ignoreCase = true)
                    ) {
                        it.copy(
                            mediaDownloadHash = null,
                            mediaDownloadBytes = 0L,
                            mediaDownloadTotalBytes = null
                        )
                    } else {
                        it
                    }
                }
                onCompleted(
                    file.takeIf { isCurrentHistorySelection(conversationId, selectionGeneration) }
                )
            }
        }
    }

    private fun scheduleMediaPrefetch(messages: List<ChatMessage>, generation: Long = historySelectionGeneration) {
        val client = mediaClient ?: return
        val targetConversationId = (_uiState.value.activeConversationId ?: _uiState.value.threadId).orEmpty().trim()
        // Messages are chronological; the tail is the initial viewport after
        // selecting a task. Prefer it so nearby thumbnails are ready without
        // scanning/dowloading the entire history.
        val candidates = messages.asReversed().asSequence()
            .flatMap { it.attachments.asSequence() }
            .filter { it.contentHash?.matches(Regex("^[0-9a-fA-F]{64}$")) == true }
            .filter { !it.thumbnailHash.isNullOrBlank() && it.localPath.isNullOrBlank() }
            .distinctBy { it.contentHash }
            .take(6)
            .toList()
        candidates.forEach { attachment ->
            val contentHash = attachment.contentHash!!.lowercase()
            val thumbnailHash = attachment.thumbnailHash!!.lowercase()
            val key = "$generation:$contentHash:$thumbnailHash"
            if (!mediaPrefetchSeen.add(key) || mediaJobs[key]?.isActive == true) return@forEach

            // A committed thumbnail is usable offline.  Hydrate the UI from
            // the content-addressed file before attempting any network call;
            // download() remains the fallback when the file is missing or its
            // bytes no longer match the descriptor hash.
            val cachedThumbnail = runCatching {
                client.cached(
                    contentHash = contentHash,
                    variant = CodexMediaVariant.THUMBNAIL,
                    expectedHash = thumbnailHash
                )
            }.getOrNull()
            if (cachedThumbnail != null) {
                val currentConversationId = _uiState.value.threadId
                if (currentConversationId.isNullOrBlank() ||
                    !isCurrentHistorySelection(currentConversationId, generation)
                ) {
                    mediaPrefetchSeen.remove(key)
                    return@forEach
                }
                _uiState.update { state ->
                    if (isCurrentHistorySelection(currentConversationId, generation)) {
                        state.copy(
                            messages = updateAttachmentPath(state.messages, contentHash, cachedThumbnail.absolutePath),
                            cachedCanonicalMessages = updateAttachmentPath(
                                state.cachedCanonicalMessages,
                                contentHash,
                                cachedThumbnail.absolutePath
                            )
                        )
                    } else {
                        state
                    }
                }
                persistMediaUsage(contentHash, thumbnailHash, cachedThumbnail, generation)
                return@forEach
            }

            mediaJobs[key] = viewModelScope.launch(Dispatchers.IO) {
                try {
                    val file = mediaPrefetchPermits.withPermit {
                        client.download(
                            contentHash = contentHash,
                            variant = CodexMediaVariant.THUMBNAIL,
                            expectedHash = thumbnailHash,
                            isCancelled = {
                                val currentConversationId = _uiState.value.threadId
                                !isActive || currentConversationId.isNullOrBlank() ||
                                    !isCurrentHistorySelection(currentConversationId, generation)
                            }
                        )
                    }
                    val currentConversationId = _uiState.value.threadId
                    if (!currentConversationId.isNullOrBlank() && isCurrentHistorySelection(currentConversationId, generation)) {
                        _uiState.update { state ->
                            state.copy(
                                messages = updateAttachmentPath(state.messages, contentHash, file.absolutePath),
                                cachedCanonicalMessages = updateAttachmentPath(state.cachedCanonicalMessages, contentHash, file.absolutePath)
                            )
                        }
                        persistMediaUsage(contentHash, thumbnailHash, file, generation)
                    }
                } catch (error: Exception) {
                    // A transient network failure should be retried while this
                    // selection generation remains active.
                    mediaPrefetchSeen.remove(key)
                    Log.w(TAG, "Thumbnail prefetch failed for ${PersistentDiagnosticLog.shortHash(contentHash)}", error)
                } finally {
                    mediaJobs.remove(key)
                }
            }
        }
        if (CodexNetworkPolicy.shouldDownload(
                CodexMediaRequestKind.AUTO_ORIGINAL,
                UiPreferences.autoDownloadOriginalsWifiOnly(appContext),
                isWifiConnected()
            )) {
            val originalKey = "originals:$generation"
            if (mediaJobs[originalKey]?.isActive != true) {
                mediaJobs[originalKey] = viewModelScope.launch(Dispatchers.IO) {
                    val profile = currentProfile
                    try {
                        candidates.forEach { attachment ->
                            if (!isActive || targetConversationId.isBlank() ||
                                !isCurrentHistorySelection(targetConversationId, generation)
                            ) return@forEach
                            val hash = attachment.contentHash?.lowercase() ?: return@forEach
                            runCatching {
                                client.download(
                                    contentHash = hash,
                                    variant = CodexMediaVariant.ORIGINAL,
                                    expectedHash = hash,
                                    isCancelled = {
                                        !isActive || targetConversationId.isBlank() ||
                                            !isCurrentHistorySelection(targetConversationId, generation)
                                    }
                                )
                            }.onSuccess { file ->
                                if (profile != null && isCurrentHistorySelection(targetConversationId, generation)) {
                                    historyCacheStore.upsertMediaBlob(
                                        CodexMediaBlobRecord(
                                            endpointId = profile.id,
                                            contentHash = hash,
                                            variant = CodexMediaVariant.ORIGINAL,
                                            mimeType = attachment.mimeType,
                                            byteSize = file.length(),
                                            localPath = file.absolutePath,
                                            state = "available",
                                            lastAccessedAt = System.currentTimeMillis()
                                        )
                                    )
                                    persistConversationMediaReference(
                                        endpointId = profile.id,
                                        conversationId = targetConversationId,
                                        contentHash = hash,
                                        thumbnailHash = attachment.thumbnailHash,
                                        generation = generation
                                    )
                                }
                            }
                        }
                    } finally {
                        mediaJobs.remove(originalKey)
                    }
                }
            }
        }
    }

    private fun isWifiConnected(): Boolean {
        val manager = appContext.getSystemService(Context.CONNECTIVITY_SERVICE) as? ConnectivityManager ?: return false
        val capabilities = manager.getNetworkCapabilities(manager.activeNetwork) ?: return false
        return capabilities.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)
    }

    private fun persistMediaUsage(
        contentHash: String,
        thumbnailHash: String,
        file: File,
        generation: Long
    ) {
        val profile = currentProfile ?: return
        val conversationId = _uiState.value.threadId?.trim().orEmpty()
        if (conversationId.isBlank() || !isCurrentHistorySelection(conversationId, generation)) return
        val now = System.currentTimeMillis()
        historyCacheStore.upsertMediaBlob(
            CodexMediaBlobRecord(
                endpointId = profile.id,
                contentHash = thumbnailHash,
                variant = CodexMediaVariant.THUMBNAIL,
                mimeType = "image/webp",
                byteSize = file.length(),
                localPath = file.absolutePath,
                state = "available",
                lastAccessedAt = now
            )
        )
        persistConversationMediaReference(
            endpointId = profile.id,
            conversationId = conversationId,
            contentHash = contentHash,
            thumbnailHash = thumbnailHash,
            generation = generation
        )
    }

    private fun persistConversationMediaReference(
        endpointId: String,
        conversationId: String,
        contentHash: String,
        thumbnailHash: String?,
        generation: Long
    ) {
        if (conversationId.isBlank() || !isCurrentHistorySelection(conversationId, generation)) return
        // A healthy IPC surface may intentionally expose only a bounded live
        // tail while the complete static history lives in
        // cachedCanonicalMessages. Scan both projections so an attachment in
        // an older turn still contributes to task/service usage and cannot be
        // deleted as an apparently unreferenced blob.
        (_uiState.value.messages + _uiState.value.cachedCanonicalMessages)
            .forEach { message ->
                if (message.attachments.any { it.contentHash.equals(contentHash, ignoreCase = true) }) {
                    historyCacheStore.upsertConversationMediaRef(
                        endpointId = endpointId,
                        conversationId = conversationId,
                        itemKey = message.id,
                        originalHash = contentHash,
                        thumbnailHash = thumbnailHash
                    )
                }
            }
    }

    private fun updateAttachmentPath(
        messages: List<ChatMessage>,
        contentHash: String,
        localPath: String
    ): List<ChatMessage> = messages.map { message ->
        message.copy(
            attachments = message.attachments.map { attachment ->
                if (attachment.contentHash.equals(contentHash, ignoreCase = true)) {
                    attachment.copy(localPath = localPath)
                } else attachment
            }
        )
    }

    fun onHostVisible() {
        foregroundHostVisible = true
        val now = SystemClock.elapsedRealtime()
        if (!ipcStatusObserved) {
            ipcAuthorityModeEnteredAtElapsed = now
        } else if (_uiState.value.ipcOnline) {
            beginAwaitingFreshIpcSurface(now)
        } else {
            ipcAuthorityModeEnteredAtElapsed = now
        }
        subscribeActiveConversationIfNeeded()
        runForegroundRecoveryTick(now)
        if (foregroundFollowJob?.isActive == true) return
        foregroundFollowJob = viewModelScope.launch {
            while (isActive) {
                delay(IPC_RECOVERY_TICK_MILLIS)
                runForegroundRecoveryTick(SystemClock.elapsedRealtime())
            }
        }
    }

    fun onHostHidden() {
        foregroundHostVisible = false
        foregroundFollowJob?.cancel()
        foregroundFollowJob = null
    }

    private fun beginAwaitingFreshIpcSurface(nowElapsed: Long = SystemClock.elapsedRealtime()) {
        awaitingFreshIpcSurface = true
        matchingIpcSurfaceDesynced = false
        ipcAuthorityModeEnteredAtElapsed = nowElapsed
    }

    private fun noteMatchingIpcSurface(
        snap: DesktopSurfaceSnapshot,
        nowElapsed: Long = SystemClock.elapsedRealtime()
    ) {
        awaitingFreshIpcSurface = false
        matchingIpcSurfaceDesynced = snap.desynced
        ipcAuthorityModeEnteredAtElapsed = if (snap.desynced) nowElapsed else 0L
    }

    private fun authorityModeForState(
        state: CodexUiState,
        targetThreadId: String? = state.threadId
    ): IpcAuthorityMode {
        if (!ipcStatusObserved) return IpcAuthorityMode.AWAITING_IPC_SURFACE
        val target = normalizeThreadId(targetThreadId)
        val matchingSurface = target != null &&
            normalizeThreadId(state.ipcSurfaceSnapshot?.conversationId) == target
        return resolveIpcAuthorityMode(
            ipcOnline = state.ipcOnline,
            matchingSurfaceAvailable = matchingSurface,
            surfaceDesynced = matchingSurface &&
                (state.ipcSurfaceSnapshot?.desynced == true || matchingIpcSurfaceDesynced),
            awaitingFreshSurface = awaitingFreshIpcSurface
        )
    }

    private fun runForegroundRecoveryTick(nowElapsed: Long) {
        if (!foregroundHostVisible) return
        val state = _uiState.value
        if (state.connectionState != ConnectionState.CONNECTED) return
        val targetThreadId = normalizeThreadId(state.threadId) ?: return
        val authorityMode = authorityModeForState(state, targetThreadId)
        val millisSinceModeEntered = if (ipcAuthorityModeEnteredAtElapsed > 0L) {
            (nowElapsed - ipcAuthorityModeEnteredAtElapsed).coerceAtLeast(0L)
        } else {
            Long.MAX_VALUE
        }
        if (!shouldUseCanonicalThreadReadFallback(
                threadId = targetThreadId,
                activeConversationId = state.activeConversationId,
                authorityMode = authorityMode,
                millisSinceAuthorityModeEntered = millisSinceModeEntered,
                surfaceWaitGraceMillis = IPC_SURFACE_WAIT_GRACE_MILLIS,
                ipcStatusObserved = ipcStatusObserved
        )) {
            return
        }
        // A stale/expired Desktop or VS Code owner can leave the IPC feed
        // online while no fresh surface exists for this conversation.  Keep
        // the bounded history channel idempotent across ticks; do not issue a
        // second ordinary thread/read polling loop from this path.
        val activeSubscriptionSettling = shouldWaitForActiveConversationSubscription(
            targetThreadId,
            historySelectionGeneration
        )
        val completeServerSnapshotCache = hasCompleteServerSnapshotCache(
            conversationId = targetThreadId,
            generation = historySelectionGeneration
        )
        val deferCompleteSnapshotRecovery =
            shouldDeferCompleteSnapshotRecoveryForFreshSubscription(
                completeServerSnapshotCache = completeServerSnapshotCache,
                authorityMode = authorityMode,
                subscriptionConversationId = activeConversationSubscriptionId,
                subscriptionGeneration = activeConversationSubscriptionGeneration,
                targetConversationId = targetThreadId,
                selectionGeneration = historySelectionGeneration,
                subscriptionSentAtElapsed = activeConversationSubscriptionSentAtElapsed,
                nowElapsed = nowElapsed,
                surfaceWaitGraceMillis = IPC_SURFACE_WAIT_GRACE_MILLIS
            )
        maybeRequestHistorySync(targetThreadId)
        val historyNeedsFullRecovery = shouldEscalateHistoryRecovery(
            cacheReady = state.historyCacheState.ready,
            cacheComplete = state.historyCacheState.complete,
            networkState = state.historyNetworkSyncState.state,
            authorityMode = authorityMode,
            completeServerSnapshotCache = completeServerSnapshotCache
        )
        val historySyncSettled =
            historySyncSettledConversationId?.trim() == targetThreadId &&
                historySyncSettledGeneration == historySelectionGeneration
        if (!deferCompleteSnapshotRecovery && shouldStartForegroundHistoryRecovery(
                historyNeedsFullRecovery = historyNeedsFullRecovery,
                authorityMode = authorityMode,
                activeSubscriptionSettling = activeSubscriptionSettling,
                historySyncSettled = historySyncSettled
            )) {
            requestHistoryRecoveryOnce(
                targetThreadId,
                "foreground-ipc-recovery:${authorityMode.name.lowercase()}"
            )
        }
        if (state.ipcOnline &&
            nowElapsed - lastRecoverySubscribeAtElapsed >= IPC_RECOVERY_RESUBSCRIBE_MILLIS) {
            subscribeActiveConversationIfNeeded()
            lastRecoverySubscribeAtElapsed = nowElapsed
        }
    }

    private fun resetHistoryRecoveryAfterTransportLoss(reason: String) {
        val hadPendingSync = historySyncInFlightConversationId != null ||
            historyRecoveryInFlightConversationId != null
        historySyncInFlightConversationId = null
        historySyncInFlightSyncId = null
        clearHistorySyncSettlement()
        historyRecoveryInFlightConversationId = null
        historyRecoveryInFlightSyncId = null
        historyActivationRetryGeneration = -1L
        cancelHistorySyncAfterSubscription()
        cancelHistoryOlderPump()
        rangeHistorySyncIds.clear()
        olderHistorySyncIds.clear()
        cancelHistoryWatchdog()
        if (!hadPendingSync) return
        val activeConversationId = _uiState.value.activeConversationId?.trim().orEmpty()
        _uiState.update { state ->
            if (activeConversationId.isBlank() || state.activeConversationId?.trim() != activeConversationId) {
                state
            } else {
                state.copy(
                    historyNetworkSyncState = currentHistorySelectionKey(
                        activeConversationId,
                        historySelectionGeneration
                    )?.let { key ->
                        historyNetworkState(key, CodexHistoryNetworkSyncState.OFFLINE)
                    } ?: state.historyNetworkSyncState
                )
            }
        }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.history.transport_lost",
            mapOf(
                "conversationKey" to PersistentDiagnosticLog.shortHash(activeConversationId),
                "generation" to historySelectionGeneration,
                "reason" to reason
            ),
            level = "warn"
        )
    }

    fun setError(message: String) {
        _uiState.update {
            it.copy(
                errorMessage = message,
                connectionState = ConnectionState.ERROR,
                executionWatch = CodexExecutionWatchState()
            )
        }
    }

    fun clearError() {
        _uiState.update { current ->
            val pendingGoalObjective = current.goalOwnerRequiredObjective
                ?.trim()
                ?.takeIf { it.isNotEmpty() }
            current.copy(
                errorMessage = null,
                connectionErrorMessage = null,
                goalOwnerRequiredObjective = null,
                goalMode = if (pendingGoalObjective != null) true else current.goalMode,
                composerRecoveryText = pendingGoalObjective ?: current.composerRecoveryText
            )
        }
    }

    fun resolveThreadRecovery(action: String) {
        val recovery = _uiState.value.threadRecovery ?: return
        val normalizedAction = action.trim().lowercase()
        if (normalizedAction !in setOf("retry", "fork", "new", "cancel")) return
        sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.codexThreadRecoveryAction(
                recoveryId = recovery.recoveryId,
                action = normalizedAction
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
    }

    fun consumeComposerRecoveryText() {
        _uiState.update { it.copy(composerRecoveryText = null) }
    }

    fun setCreatingSession() {
        _uiState.update {
            recalculateNextTurnEffectiveConfig(
                it.copy(
                    sessionId = "",
                    threadId = null,
                    errorMessage = null,
                    connectionErrorMessage = null,
                    connectionState = ConnectionState.CONNECTING,
                    serverNextTurnConfigBase = null,
                    ownerCurrentCodexConfig = null,
                    nextTurnEffectiveCodexConfig = null,
                    nextTurnOverrides = NextTurnOverrides(),
                    planWorkflow = buildEmptyPlanWorkflowState(),
                    pendingServerRequests = emptyList(),
                    submittingServerRequestIds = emptySet(),
                    sessionExpired = false,
                    executionWatch = CodexExecutionWatchState(),
                    runtimePanel = buildEmptyRuntimePanelState(),
                    noticesPanel = CodexNoticesPanelState(),
                    toolsPanel = CodexToolsPanelState(),
                    usagePanel = CodexUsagePanelState(),
                    pendingImageAttachments = emptyList(),
                    currentThreadTitle = "",
                    threadHistoryEntries = emptyList(),
                    threadHistorySheetVisible = false,
                    threadHistoryLoading = false,
                    threadHistoryActionThreadId = "",
                    threadHistoryActionKind = "",
                    threadRenameTargetId = "",
                    threadRenameDraft = ""
                )
            )
        }
    }

    fun acknowledgeSessionExpired() {
        _uiState.update { it.copy(sessionExpired = false) }
    }

    /**
     * Main entry point for user submit. Parses input for slash commands,
     * dispatches accordingly, or sends as a plain text turn.
     */
    fun handleComposerSubmit(rawText: String) {
        hideFileMentionMenu()
        if (_uiState.value.goalMode) {
            startFollowerGoal(rawText)
            hideSlashMenu()
            return
        }
        val parsed = CodexSlashRegistry.parseComposerInput(rawText)
        when (parsed) {
            is CodexSlashRegistry.ParsedInput.Empty -> sendTurnWithOverrides("")
            is CodexSlashRegistry.ParsedInput.Text -> sendTurnWithOverrides(parsed.text)
            is CodexSlashRegistry.ParsedInput.Slash -> dispatchSlashCommand(parsed)
        }
        hideSlashMenu()
    }

    fun sendMessage(prompt: String) {
        sendTurnWithOverrides(prompt)
    }

    fun interrupt() {
        val state = _uiState.value
        val useFollowerTransport = shouldUseIpcFollowerTransport(state)
        val interruptRequestId = UUID.randomUUID().toString()
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.interrupt.requested",
            mapOf(
                "interruptRequestKey" to PersistentDiagnosticLog.shortHash(interruptRequestId),
                "conversationKey" to PersistentDiagnosticLog.shortHash(state.activeConversationId),
                "turnKey" to PersistentDiagnosticLog.shortHash(state.currentTurnId),
                "transport" to if (useFollowerTransport) "follower" else "legacy",
                "authority" to authorityModeForState(state, state.activeConversationId).name,
                "status" to state.status,
                "ipcOnline" to state.ipcOnline,
                "ipcClientIdPresent" to (state.ipcClientId != null),
                "followerModeEnabled" to state.followerModeEnabled,
                "followerActiveSendAllowed" to state.followerActiveSendAllowed,
                "surfaceStatus" to state.ipcSurfaceSnapshot?.status,
                "surfaceDesynced" to (state.ipcSurfaceSnapshot?.desynced == true),
                "surfaceRevision" to state.ipcSurfaceSnapshot?.revision,
                "sourceEpoch" to state.ipcSurfaceSnapshot?.sourceEpoch
            )
        )
        if (useFollowerTransport) {
            sendEnvelopeOrReportFailure(
                payload = CodexClientMessages.followerInterruptTurn(state.activeConversationId!!),
                connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
            )
            return
        }
        if (state.threadId.isNullOrBlank() || state.currentTurnId.isNullOrBlank()) {
            _uiState.update {
                syncExecutionWatch(
                    it.copy(currentTurnId = null),
                    markActivity = false
                )
            }
            return
        }
        sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.codexInterrupt(state.threadId),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
    }

    fun continueActiveGoal() {
        val state = _uiState.value
        val activeGoal = state.activeGoal ?: return
        val conversationId = state.activeConversationId?.trim().orEmpty()
        val isTermLinkOwner = state.ipcSurfaceSnapshot?.ownerKind.equals("termlink", ignoreCase = true)
        if (conversationId.isEmpty() || !isTermLinkOwner || !shouldUseIpcFollowerTransport(state)) return
        sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.followerGoalControl(
                conversationId = conversationId,
                action = goalControlActionForStatus(activeGoal.status)
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
    }

    fun newThread() {
        val pendingGoalObjective = _uiState.value.goalOwnerRequiredObjective
            ?.trim()
            ?.takeIf { it.isNotEmpty() }
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.new.requested",
            mapOf(
                "source" to "view_model",
                "hadActiveConversation" to !_uiState.value.activeConversationId.isNullOrBlank(),
                "ipcOnline" to _uiState.value.ipcOnline
            ),
            critical = true
        )
        currentStreamingMessageId = null
        currentPlanStreamingMessageId = null
        executionFeedbackSeen.clear()
        threadHadPlanTurn = false
        clearPendingOptimisticNewThreadTransition()
        clearPendingThreadResync()
        clearPendingLaunchHydrate()
        pinnedIpcConversationId = null
        pendingHistoryResumeHydrationThreadId = null
        cancelHistoryResumeProtection()
        _uiState.update {
            prepareIpcStateForNewThread(
                it.copy(
                    threadId = null,
                    messages = emptyList(),
                    errorMessage = null,
                    planMode = false,
                    goalMode = pendingGoalObjective != null,
                    goalOwnerRequiredObjective = null,
                    composerRecoveryText = pendingGoalObjective ?: it.composerRecoveryText,
                    planWorkflow = buildEmptyPlanWorkflowState(),
                    pendingFileMentions = emptyList(),
                    fileMentionMenuVisible = false,
                    fileMentionQuery = "",
                    fileMentionResults = emptyList(),
                    fileMentionLoading = false,
                    pendingServerRequests = emptyList(),
                    submittingServerRequestIds = emptySet(),
                    runtimePanel = buildEmptyRuntimePanelState(),
                    noticesPanel = CodexNoticesPanelState(),
                    toolsPanel = it.toolsPanel.copy(
                        compactSubmitting = false,
                        compactStatusText = "",
                        compactStatusTone = ""
                    ),
                    usagePanel = it.usagePanel.copy(
                        visible = false,
                        tokenUsageSummary = "",
                        contextUsage = null
                    ),
                    pendingImageAttachments = emptyList(),
                    currentThreadTitle = "",
                    threadHistorySheetVisible = false,
                    threadHistoryActionThreadId = "",
                    threadHistoryActionKind = "",
                    threadRenameTargetId = "",
                    threadRenameDraft = ""
                )
            )
        }
        val sent = connectionManager.send(CodexClientMessages.codexNewThread())
        PersistentDiagnosticLog.event(
            "codex",
            "android.codex.new.sent",
            mapOf("sent" to sent, "ipcOnline" to _uiState.value.ipcOnline),
            level = if (sent) "info" else "warn",
            critical = true
        )
    }

    fun setCwd(cwd: String) {
        connectionManager.send(CodexClientMessages.codexSetCwd(cwd))
        val previousCwd = _uiState.value.cwd
        val cwdChanged = normalizeThreadHistoryCwdForUi(previousCwd) !=
            normalizeThreadHistoryCwdForUi(cwd)
        _uiState.update { state ->
            state.copy(
                cwd = cwd,
                threadHistoryEntries = if (cwdChanged) {
                    filterThreadHistoryEntriesForCwd(state.threadHistoryEntries, cwd)
                } else {
                    state.threadHistoryEntries
                }
            )
        }
        if (cwdChanged) {
            refreshThreadHistory()
        }
    }

    fun submitApprovalDecision(requestId: String, approved: Boolean) {
        PersistentDiagnosticLog.event(
            "codex",
            "android.approval.clicked",
            mapOf(
                "requestKey" to PersistentDiagnosticLog.shortHash(requestId),
                "approved" to approved,
                "conversationKey" to PersistentDiagnosticLog.shortHash(_uiState.value.activeConversationId)
            ),
            critical = true
        )
        val request = findPendingServerRequest(requestId)
        if (request == null) {
            PersistentDiagnosticLog.event(
                "codex",
                "android.approval.failed",
                mapOf(
                    "requestKey" to PersistentDiagnosticLog.shortHash(requestId),
                    "reason" to "pending_request_missing"
                ),
                level = "error"
            )
            Log.w(TAG, "[approval][submit-skipped] pending request not found requestId=$requestId")
            return
        }
        if (isIpcFollowerRequest(request)) {
            val state = _uiState.value
            val conversationId = state.activeConversationId?.trim().orEmpty()
            Log.i(
                TAG,
                "[approval][submit] transport=ipc_follower requestId=$requestId " +
                    "requestKind=${request.requestKind} approved=$approved " +
                    "conversationId=$conversationId ipcOnline=${state.ipcOnline} " +
                    "followerModeEnabled=${state.followerModeEnabled} " +
                    "activeSendAllowed=${state.followerActiveSendAllowed}"
            )
            if (!shouldUseIpcFollowerTransport(state) || conversationId.isEmpty()) {
                Log.w(TAG, "[approval][submit-skipped] IPC follower transport unavailable requestId=$requestId")
                _uiState.update {
                    it.copy(connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable))
                }
                return
            }
            val decision = resolveIpcFollowerApprovalDecision(request, approved)
            val sent = sendEnvelopeOrReportFailure(
                payload = CodexClientMessages.followerApprovalResponse(
                    conversationId = conversationId,
                    requestId = requestId,
                    decision = decision,
                    requestKind = request.requestKind.takeIf { it.isNotBlank() && it != "approval" }
                ),
                connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
            )
            if (!sent) return
            PersistentDiagnosticLog.event(
                "codex",
                "android.approval.sent",
                mapOf(
                    "requestKey" to PersistentDiagnosticLog.shortHash(requestId),
                    "conversationKey" to PersistentDiagnosticLog.shortHash(conversationId),
                    "transport" to "ipc_follower",
                    "approved" to approved
                )
            )
            markServerRequestSubmitting(requestId)
            return
        }
        val result = buildApprovalDecisionResult(request, approved) ?: return
        if (isDebugServerRequest(requestId)) {
            markServerRequestSubmitting(requestId)
            completeDebugServerRequest(requestId, result = result)
            return
        }
        val sent = sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.codexServerRequestResponse(
                requestId = requestId,
                result = result
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
        if (!sent) return
        markServerRequestSubmitting(requestId)
    }

    fun submitUserInputAnswers(requestId: String, answersByQuestionId: Map<String, String>) {
        val request = findPendingServerRequest(requestId) ?: return
        if (isIpcFollowerRequest(request)) {
            val conversationId = _uiState.value.activeConversationId?.trim().orEmpty()
            val firstQuestion = request.questions.firstOrNull()
            val explicitResponse = buildUserInputResult(request, answersByQuestionId)
            val answer = firstQuestion
                ?.let { answersByQuestionId[it.id]?.trim() }
                ?: answersByQuestionId.values.firstOrNull()?.trim()
                ?: ""
            if (conversationId.isEmpty() || (answer.isEmpty() && explicitResponse == null)) return
            val sent = sendEnvelopeOrReportFailure(
                payload = CodexClientMessages.followerPlanResponse(
                    conversationId = conversationId,
                    input = answer.ifEmpty { "submitted" },
                    requestId = requestId,
                    questionId = firstQuestion?.id,
                    response = explicitResponse
                ),
                connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
            )
            if (!sent) return
            markServerRequestSubmitting(requestId)
            return
        }
        val result = buildUserInputResult(request, answersByQuestionId) ?: return
        if (isDebugServerRequest(requestId)) {
            markServerRequestSubmitting(requestId)
            completeDebugServerRequest(requestId, result = result)
            return
        }
        val sent = sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.codexServerRequestResponse(
                requestId = requestId,
                result = result
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
        if (!sent) return
        markServerRequestSubmitting(requestId)
        _uiState.update { state ->
            if (state.planWorkflow.phase == PLAN_PHASE_AWAITING_USER_INPUT) {
                state.copy(
                    planWorkflow = state.planWorkflow.copy(
                        phase = PLAN_PHASE_PLANNING,
                        lastUserInputRequestId = requestId
                    )
                )
            } else {
                state
            }
        }
    }

    fun rejectUserInputRequest(requestId: String) {
        val request = findPendingServerRequest(requestId) ?: return
        if (isIpcFollowerRequest(request)) {
            val state = _uiState.value
            val conversationId = state.activeConversationId?.trim().orEmpty()
            if (!shouldUseIpcFollowerTransport(state) || conversationId.isEmpty()) {
                PersistentDiagnosticLog.event(
                    "codex",
                    "android.approval.send.unavailable",
                    mapOf("transport" to "ipc_follower", "ipcOnline" to state.ipcOnline),
                    level = "warn",
                    critical = true
                )
                Log.w(TAG, "[user-input][reject-skipped] IPC follower transport unavailable requestId=$requestId")
                _uiState.update {
                    it.copy(connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable))
                }
                return
            }
            val sent = sendEnvelopeOrReportFailure(
                payload = CodexClientMessages.followerPlanResponse(
                    conversationId = conversationId,
                    input = "取消",
                    requestId = requestId,
                    questionId = request.questions.firstOrNull()?.id
                ),
                connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
            )
            if (!sent) return
            PersistentDiagnosticLog.event(
                "codex",
                "android.approval.sent",
                mapOf("transport" to "ipc_follower", "sent" to true),
                critical = true
            )
            markServerRequestSubmitting(requestId)
            return
        }
        val error = JSONObject().put("message", "User input request cancelled by user.")
        if (isDebugServerRequest(requestId)) {
            markServerRequestSubmitting(requestId)
            completeDebugServerRequest(requestId, error = error)
            return
        }
        val sent = sendEnvelopeOrReportFailure(
            payload = CodexClientMessages.codexServerRequestResponse(
                requestId = requestId,
                error = error
            ),
            connectionErrorMessage = appContext.getString(R.string.codex_native_connection_action_unavailable)
        )
        if (!sent) return
        PersistentDiagnosticLog.event(
            "codex",
            "android.approval.sent",
            mapOf("transport" to "codex", "sent" to true),
            critical = true
        )
        markServerRequestSubmitting(requestId)
    }

    private fun sendEnvelopeOrReportFailure(
        payload: String,
        connectionErrorMessage: String
    ): Boolean {
        val sent = connectionManager.send(payload)
        if (!sent) {
            _uiState.update { state ->
                state.copy(connectionErrorMessage = connectionErrorMessage)
            }
        }
        return sent
    }

    private fun agentMessagePhase(item: JSONObject): String =
        item.optString("phase", "").trim().lowercase()

    private fun isRuntimeOnlyAgentMessage(item: JSONObject): Boolean {
        return when (agentMessagePhase(item)) {
            "plan", "reasoning" -> true
            else -> false
        }
    }

    private fun extractTraceTurnId(params: JSONObject?): String {
        return params
            ?.optJSONObject("turn")
            ?.optString("id", "")
            ?.trim()
            .orEmpty()
            .ifEmpty { params?.optString("turnId", "")?.trim().orEmpty() }
    }

    private fun extractTraceItemId(params: JSONObject?): String {
        return params
            ?.optJSONObject("item")
            ?.optString("id", "")
            ?.trim()
            .orEmpty()
            .ifEmpty { params?.optString("itemId", "")?.trim().orEmpty() }
    }

    private fun shouldTraceNotificationMethod(method: String): Boolean {
        return when (method) {
            "turn/started",
            "turn/completed",
            "item/started",
            "item/agentMessage/delta",
            "item/completed",
            "error" -> true
            else -> false
        }
    }

    private fun logNotificationTrace(stage: String, message: String) {
        Log.d(TAG, "[notif-trace][$stage] $message")
    }

    private fun compactLogValue(value: String?, maxLength: Int = 1800): String {
        val normalized = value?.trim().orEmpty()
        if (normalized.length <= maxLength) {
            return normalized
        }
        return normalized.take(maxLength) + "...<truncated>"
    }

    private fun resolvePlanStreamingMessageId(params: JSONObject?): String {
        return params
            ?.optJSONObject("plan")
            ?.optString("id", "")
            ?.trim()
            .orEmpty()
            .ifEmpty { params?.optString("planId", "")?.trim().orEmpty() }
            .ifEmpty { params?.optString("itemId", "")?.trim().orEmpty() }
            .ifEmpty { currentPlanStreamingMessageId.orEmpty() }
    }

    private fun finalizeStreamingMessageById(streamId: String) {
        logNotificationTrace("ui", "finalize streamId=$streamId")
        _uiState.update { state ->
            val updated = state.messages.map { message ->
                if (message.id == streamId) {
                    message.copy(
                        streaming = false,
                        timestamp = System.currentTimeMillis()
                    )
                } else {
                    message
                }
            }
            syncExecutionWatch(state.copy(messages = updated), markActivity = true)
        }
    }

    private fun finalizePlanStreamingMessage() {
        val streamId = currentPlanStreamingMessageId ?: return
        finalizeStreamingMessageById(streamId)
        currentPlanStreamingMessageId = null
    }

    private fun trackPlanWorkflowText(
        text: String,
        preserveWhitespace: Boolean = false
    ) {
        _uiState.update { state ->
            if (shouldTrackPlanWorkflowText(state)) {
                updatePlanWorkflowText(
                    state = state,
                    text = text,
                    preserveWhitespace = preserveWhitespace
                )
            } else {
                state
            }
        }
    }

    private fun summarizeReasoningPayload(value: Any?): String {
        return when (value) {
            is String -> value.trim()
            is Number -> value.toString()
            is JSONObject -> {
                pickFirstText(
                    value,
                    listOf("delta"),
                    listOf("text"),
                    listOf("summary"),
                    listOf("summaryText"),
                    listOf("part", "text"),
                    listOf("part", "summary"),
                    listOf("item", "text"),
                    listOf("item", "summary")
                ).ifEmpty {
                    summarizeReasoningPayload(value.optJSONArray("parts"))
                }
            }
            is JSONArray -> {
                buildList {
                    for (index in 0 until value.length()) {
                        summarizeReasoningPayload(value.opt(index))
                            .takeIf { it.isNotBlank() }
                            ?.let(::add)
                    }
                }.joinToString("\n")
            }
            else -> ""
        }.trim()
    }

    fun injectDebugServerRequest(preset: DebugServerRequestPreset) {
        if (preset == DebugServerRequestPreset.RUNTIME_SAMPLE) {
            injectDebugRuntimePanelSample()
            return
        }
        handleCodexServerRequest(
            CodexServerRequestEnvelope(
                request = buildDebugServerRequest(preset),
                raw = JSONObject()
                    .put("type", "codex_server_request")
                    .put("requestId", UUID.randomUUID().toString())
            )
        )
    }

    private fun injectDebugRuntimePanelSample() {
        val now = System.currentTimeMillis()
        _uiState.update { state ->
            state.copy(
                messages = state.messages + ChatMessage(
                    id = UUID.randomUUID().toString(),
                    role = ChatMessage.Role.SYSTEM,
                    content = "[debug] Injected runtime and usage panel sample."
                ),
                runtimePanel = state.runtimePanel.copy(
                    diff = """
                        diff --git a/public/terminal_client.css b/public/terminal_client.css
                        @@ -889,6 +889,9 @@
                        -.codex-runtime-card { padding: 10px; }
                        +.codex-runtime-card { padding: 8px; }
                        +.codex-runtime-card.is-expanded { border-color: rgba(78, 222, 163, 0.15); }
                    """.trimIndent(),
                    plan = """
                        1. Mirror the Web runtime panel hierarchy.
                        2. Keep only Diff, Plan, and Reasoning cards.
                        3. Collapse empty state instead of showing a blank panel.
                    """.trimIndent(),
                    reasoning = """
                        Web compact/mobile layout stacks runtime cards in a single column.
                        Keeping the panel inline above the composer preserves scan speed without squeezing content.
                    """.trimIndent(),
                    warning = "Debug sample: runtime warning is rendered below the card grid.",
                    warningTone = "warn"
                ),
                usagePanel = state.usagePanel.copy(
                    visible = true,
                    rateLimitSummary = "5h 1% ⏱16:13 | 168h 15% ⏱04/17 02:11",
                    rateLimitTone = "",
                    contextUsage = CodexContextUsageState(
                        usedTokens = 18_400,
                        contextWindow = 128_000,
                        usedPercent = 14,
                        remainingPercent = 86,
                        inputTokens = 8_900,
                        outputTokens = 6_400,
                        cachedInputTokens = 2_700,
                        reasoningTokens = 400,
                        updatedAtMillis = System.currentTimeMillis()
                    )
                ),
                noticesPanel = state.noticesPanel.copy(
                    configWarningText = "Debug sample: configuration requires review before the next Codex turn.",
                    deprecationNoticeText = "Debug sample: this fallback path is deprecated and will be removed in a future update."
                ),
                status = "running",
                connectionState = ConnectionState.CONNECTED,
                executionWatch = CodexExecutionWatchState(
                    active = true,
                    runningSinceMillis = now - 125_000L,
                    lastEventAtMillis = now - 65_000L
                )
            )
        }
    }

    fun showThreadHistory() {
        _uiState.update {
            closeSlashMenu(
                it.copy(
                    threadHistorySheetVisible = true,
                    runtimePanel = it.runtimePanel.copy(visible = false),
                    noticesPanel = it.noticesPanel.copy(visible = false),
                    toolsPanel = it.toolsPanel.copy(visible = false)
                )
            )
        }
        // The cache-backed drawer is usable before codex_capabilities arrives.
        // Let an unknown capability probe the optional metadata endpoint; only
        // an explicit server declaration of unsupported should suppress it.
        refreshThreadHistory()
    }

    fun showRuntimePanel() {
        _uiState.update {
            closeSlashMenu(
                it.copy(
                    threadHistorySheetVisible = false,
                    runtimePanel = it.runtimePanel.copy(visible = true),
                    noticesPanel = it.noticesPanel.copy(visible = false),
                    toolsPanel = it.toolsPanel.copy(visible = false)
                )
            )
        }
    }

    fun hideRuntimePanel() {
        _uiState.update { it.copy(runtimePanel = it.runtimePanel.copy(visible = false)) }
    }

    fun showToolsPanel() {
        maybeLoadSkillCatalog()
        _uiState.update { state ->
            closeSlashMenu(
                state.copy(
                    threadHistorySheetVisible = false,
                    runtimePanel = state.runtimePanel.copy(visible = false),
                    noticesPanel = state.noticesPanel.copy(visible = false),
                    toolsPanel = state.toolsPanel.copy(
                        visible = true,
                        compactStatusText = if (state.toolsPanel.compactSubmitting) {
                            state.toolsPanel.compactStatusText
                        } else {
                            ""
                        },
                        compactStatusTone = if (state.toolsPanel.compactSubmitting) {
                            state.toolsPanel.compactStatusTone
                        } else {
                            ""
                        }
                    )
                )
            )
        }
    }

