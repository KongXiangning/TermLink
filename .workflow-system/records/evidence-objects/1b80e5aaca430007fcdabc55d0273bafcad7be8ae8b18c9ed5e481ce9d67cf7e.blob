const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');const d='logs/history-save-repair-20261005/s3',hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
const files=['native/codex-rollout-collector/src/source/discovery.rs','native/codex-rollout-collector/src/protocol/target_source.rs','native/codex-rollout-collector/src/protocol/target_mapping.rs','native/codex-rollout-collector/tests/stage4_target_protocol.rs'];fs.mkdirSync(d+'/before',{recursive:true});
const subjects=files.map(p=>{const b=cp.execFileSync('git',['show',head+':'+p],{maxBuffer:16*1024*1024});const dest=d+'/before/'+p.replaceAll('/','__');fs.writeFileSync(dest,b);return{path:p,git_baseline:dest,git_blob_sha256:hash(b)};});
const protectedFiles=['src/services/codexRolloutCollector/analyzerProtocol.js','src/services/codexRolloutCollector/analysisBatchImporter.js','src/services/codexRolloutCollector/analyzerProcessManager.js','src/services/codexRolloutCollector/index.js','src/services/codexHistoryProductStore.js','src/services/codexHistoryProductProvider.js','docs/codex/codex-rollout-collector-architecture.md','docs/workflow/CONTRACTS.md','docs/workflow/DECISIONS.md','docs/codex/codex-history-shared-compat-contract.md','native/codex-rollout-compat-spike/vendor/codex/Cargo.lock'];
const protect=protectedFiles.map(p=>({path:p,sha256:hash(fs.readFileSync(p))}));
for(const [task,step,label]of[['TASK-20260832','S3','832'],['TASK-20260833','S5','833']]){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:task,step_id:step}),encoding:'utf8'});fs.writeFileSync(d+'/status-'+label+'-before.json',r.stdout);if(r.status!==0)throw Error(r.stderr);}
fs.writeFileSync(d+'/baseline.json',JSON.stringify({head,qualification:'Original tracked business baseline reconstructed read-only from current HEAD after first edits;not a claimed pre-edit live snapshot',subjects,protect},null,2)+'\n');console.log(JSON.stringify({head,subjects:subjects.length,protect:protect.length}));
