'use strict';
// Offline review only: no network, service/device commands, product writes or test replay.
const fs=require('node:fs'), path=require('node:path'), crypto=require('node:crypto');
const {spawnSync}=require('node:child_process'), {isDeepStrictEqual}=require('node:util');
const root=process.cwd(), dir=path.join(root,'logs/e2e-validation-20261004/s6');
const read=f=>JSON.parse(fs.readFileSync(path.resolve(root,f)));
const digest=b=>crypto.createHash('sha256').update(b).digest('hex');
const result={at:new Date().toISOString(),layer:'offline exact S6 evidence/scope review; same-agent self-review',checks:[],inventories:[]};
const check=(name,passed,detail)=>result.checks.push({name,passed:!!passed,...(detail?{detail}:{})});
function inventory(name,files){
  const mismatches=[];
  for(const f of files){const file=path.resolve(root,f.path);try{const b=fs.readFileSync(file);if(digest(b)!==f.sha256 || b.length!==(f.bytes??f.size))mismatches.push(f.path);}catch(e){mismatches.push({path:f.path,error:e.code});}}
  result.inventories.push({name,count:files.length,mismatches});check(name,mismatches.length===0);
}
async function main(){
  const execRef='.workflow-system/records/events/key-239872f59e75b6579bac30729f9c7afe739a9ead35939b93fd367d560e03a234.json';
  const testRef='.workflow-system/records/events/key-215b08a384e8ec7de29428223262d41a2c70da48ae8e6db059e56e1fe6b27f8c.json';
  result.execution_ref=execRef;result.test_ref=testRef;
  for(const ref of [execRef,testRef]){
    const manifest=read(ref.replace('/events/','/attachments/'));
    check('saved attachment status '+path.basename(ref),manifest.attachments.every(a=>a.status==='saved' && a.issues.length===0));
    inventory('CAS '+path.basename(ref),manifest.attachments.map(a=>({path:a.ref,sha256:a.sha256,size:a.size})));
    inventory('attachment sources '+path.basename(ref),manifest.attachments.map(a=>({path:a.source_path,sha256:a.sha256,size:a.size})));
  }
  for(const name of ['original-files','final-index','evidence-index'])inventory(name,read(path.join(dir,name+'.json')).files);
  const matrix=read(path.join(dir,'matrix.json'));
  check('E01-E12 unique matrix',matrix.scenarios.length===12 && new Set(matrix.scenarios.map(s=>s.id)).size===12);
  check('matrix evidence files exist',matrix.scenarios.every(s=>s.evidence.every(f=>fs.existsSync(path.resolve(root,f)))));
  result.matrix={scenarios:matrix.scenarios.length,subcases:matrix.scenarios.flatMap(s=>s.subcases).length,overall:matrix.overall};
  const probe=read(path.join(dir,'probe-results.json')),assessment=read(path.join(dir,'assessment.json'));
  check('original probe failure retained',probe.passed===11 && probe.total===12 && probe.checks.filter(c=>!c.passed).length===1);
  check('original HTTP negative observations',probe.requests.filter(r=>['absent','invalid'].includes(r.credential_case)).length===4 && probe.requests.filter(r=>['absent','invalid'].includes(r.credential_case)).every(r=>r.status===401 && r.body_bytes===0));
  check('original WS negative observations',probe.ws_negative.length===4 && probe.ws_negative.every((r,i)=>r.code===(i<2?4401:4403) && r.frames===0 && r.bytes===0 && !r.error));
  check('unknown registration observation retained',probe.unknown_registration_http.status===200 && probe.unknown_registration_http.empty_list);
  const wireBytes=fs.readFileSync(path.join(dir,'private/wire.json')),wire=JSON.parse(wireBytes);
  check('private retained wire digest/size',digest(wireBytes)===probe.private_wire.sha256 && wireBytes.length===probe.private_wire.bytes);
  const page=wire.find(m=>m.type==='conversation_history_delta' && m.syncId===probe.product_page.syncId);
  const compute=require('../../../src/services/codexHistorySyncService').computeHistoryPageHash;
  check('actual F page identity/hash/provider',page.conversationId===probe.product_page.conversationId && page.clientSelectionGeneration===61 && page.range.providerMode==='product_db' && compute(page)===page.pageHash);
  check('22 unique actual F upserts',page.upserts.length===22 && new Set(page.upserts.map(i=>i.itemKey)).size===22);
  const missFrames=wire.filter(m=>m.syncId===probe.product_miss.syncId);
  check('actual A miss cache-only and no body',missFrames.some(m=>m.type==='conversation_history_sync_state' && m.state==='cache_only' && m.detailCode==='history_product_not_found') && !missFrames.some(m=>['conversation_history_delta','conversation_history_payload_chunk'].includes(m.type)));
  const SQL=await require('sql.js')();
  const bytes=fs.readFileSync(path.join(dir,'private/product.sqlite')),db=new SQL.Database(bytes);db.run('PRAGMA query_only=ON');
  const rows=(sql,args=[])=>{const s=db.prepare(sql);s.bind(args);const out=[];while(s.step())out.push(s.getAsObject());s.free();return out;};
  const forbidden=['source_id','source_epoch','source_ref','job_id','batch_id','segment_id','checkpoint','next_cursor','staging','deliveryIdentity'];
  const payloadMismatches=[],envelopeLeaks=[],topPayloadKeys=[];
  for(const item of page.upserts){const stored=rows('SELECT payload_json FROM history_items WHERE conversation_id=? AND item_key=?',[page.conversationId,item.itemKey]);
    if(stored.length!==1 || item.payloadChunkCount || !isDeepStrictEqual(JSON.parse(item.payloadJson),JSON.parse(stored[0].payload_json)))payloadMismatches.push(item.itemKey);
    if(forbidden.some(k=>Object.hasOwn(item,k)))envelopeLeaks.push(item.itemKey);
    topPayloadKeys.push(...forbidden.filter(k=>Object.hasOwn(JSON.parse(item.payloadJson),k)));
  }
  result.dto={items:page.upserts.length,payloadMismatches,envelopeLeaks,top_payload_collection_keys:[...new Set(topPayloadKeys)]};
  check('actual retained DB payloads equal wire',payloadMismatches.length===0);
  check('actual collector fields absent at envelope and schema top level',envelopeLeaks.length===0 && topPayloadKeys.length===0);
  check('retained product DB byte/digest unchanged from S5',digest(bytes)===read('logs/e2e-validation-20261004/s5/final-cleanup.json').final_product.sha256 && digest(bytes)===assessment.product.sha256);
  check('retained F canonical digest',digest(JSON.stringify(rows('SELECT * FROM history_items ORDER BY conversation_id,item_key')))===assessment.product.canonical_digest);
  check('A/C canonical tables absent',Object.keys(assessment.product.targets).every(id=>['conversations','history_items','tool_details','analysis_checkpoints','publication_receipts'].every(t=>rows('SELECT count(*) n FROM '+t+' WHERE conversation_id=?',[id])[0].n===0)));
  check('retained product quick check',rows('PRAGMA quick_check')[0].quick_check==='ok');db.close();
  check('phone stopped DB snapshot equals S5',digest(fs.readFileSync(path.join(dir,'private/phone/databases/codex_conversations.db')))===digest(fs.readFileSync('logs/e2e-validation-20261004/s5/private/restored-final/databases/codex_conversations.db')));
  const prefs=fs.readdirSync(path.join(dir,'private/phone/shared_prefs')).filter(f=>f.endsWith('.xml'));
  check('phone retained preferences equal S5',prefs.length===assessment.phone.preference_hashes.length && prefs.every(f=>digest(fs.readFileSync(path.join(dir,'private/phone/shared_prefs',f)))===digest(fs.readFileSync(path.join('logs/e2e-validation-20261004/s5/private/restored-final/shared_prefs',f)))));
  // Extract this method only: requiring the module would instantiate the persistent singleton.
  const source=fs.readFileSync('src/services/clientRegistrationManager.js','utf8');
  const method=source.match(/    isActive\(id\) \{([\s\S]*?)\n    \}/)[1];
  const isActive=new Function('id',method), registrationMap=new Map([['known',{revokedAt:null}],['revoked',{revokedAt:1}]]);
  result.registration_reproduction={unknown:isActive.call({registrations:registrationMap},'missing'),known:isActive.call({registrations:registrationMap},'known'),revoked:isActive.call({registrations:registrationMap},'revoked')};
  check('S6-G1 exact source in-memory reproduction',result.registration_reproduction.unknown===true && result.registration_reproduction.known===true && result.registration_reproduction.revoked===false);
  check('5 targeted original test results retained',/tests 5/.test(fs.readFileSync(path.join(dir,'node-focused.txt'),'utf8')) && /pass 5/.test(fs.readFileSync(path.join(dir,'node-focused.txt'),'utf8')) && /fail 0/.test(fs.readFileSync(path.join(dir,'node-focused.txt'),'utf8')));
  const git=args=>{const r=spawnSync('git',args,{encoding:'utf8',windowsHide:true});if(r.status!==0)throw Error('Git read failed');return r.stdout.trim();};
  result.source={head:git(['rev-parse','HEAD']),diff:git(['diff','--name-only']),index_diff:git(['diff','--cached','--name-only']),architecture_sha256:digest(fs.readFileSync('docs/codex/codex-rollout-collector-architecture.md'))};
  check('exact clean tracked/index subject',result.source.head==='026892bb02a44c6664dc96e62acb41428422a310' && result.source.diff==='' && result.source.index_diff==='');
  result.limitations=['Offline review does not repeat HTTP/WS/device/model/service commands or tests. Negative frame counts are caller-observed saved summaries, not separately captured packets.','No natural canonical publication, full E2E, resend/ordinary append, physical older/large copy or race validation certified.','S6-G1 remains an existing product defect candidate and was not introduced or repaired by this evidence-only execution.'];
  result.passed=result.checks.filter(c=>c.passed).length;result.total=result.checks.length;
  fs.writeFileSync(path.join(__dirname,'checks.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});
  console.log(JSON.stringify({passed:result.passed,total:result.total,inventories:result.inventories.map(i=>({name:i.name,count:i.count,mismatches:i.mismatches})),dto:result.dto,matrix:result.matrix,source:result.source}));
  if(result.passed!==result.total)process.exitCode=1;
}
main().catch(e=>{console.error(e.stack);process.exitCode=1;});
