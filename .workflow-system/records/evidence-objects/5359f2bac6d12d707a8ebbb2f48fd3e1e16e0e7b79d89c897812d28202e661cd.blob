'use strict';
// Retained-evidence review only; no test rerun, service start or phone UI action.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { spawnSync } = require('node:child_process');
const { CodexHistoryProductProvider } = require('../../../src/services/codexHistoryProductProvider');
const out = __dirname;
const sha = v => crypto.createHash('sha256').update(v).digest('hex');
const stable = v => Array.isArray(v) ? v.map(stable) : v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort().map(k => [k, stable(v[k])])) : v;
const read = n => fs.readFileSync(path.join(out, n));
const json = n => JSON.parse(read(n));
const rootRead = n => fs.readFileSync(path.resolve(n));
const checks = [];
const check = (name, pass) => checks.push({ name, pass: Boolean(pass) });
const eventRef = '.workflow-system/records/events/key-2ca151f99db0ae2a1a48fe59ab4e8df4faf81bf2e36b8bba846d07f813d691af.json';
const nodeRef = '.workflow-system/records/events/key-49f69c72fbb4e1d59b00ed99c36698bc1863e8a87c75d847d940540f43e39d84.json';
const androidRef = '.workflow-system/records/events/key-95e03a227bad22a8e3fba2f17843374b6f95fa9876d433e0566492eb92b37fb7.json';
async function main() {
  const observed = json('support-results.json'), android = json('android-focused-result.json');
  const event = JSON.parse(rootRead(eventRef));
  check('execution and both exact linked test payload digests', [eventRef, nodeRef, androidRef].every(ref => { const e = JSON.parse(rootRead(ref)); return e.payload_sha256 === sha(JSON.stringify(stable(e.payload))); }));
  check('both tests link exact task/step/execution and retain layer qualifications', [nodeRef, androidRef].every(ref => { const r = JSON.parse(rootRead(ref)).payload.request; return r.task_id === 'task-25654b249109f357a559899562804c15' && r.step_id === 'S3' && r.execution_ref === eventRef && r.coverage.passed === 3 && r.result === 'passed' && r.coverage.layer.includes('not '); }));
  const attachments = [eventRef, nodeRef, androidRef].flatMap(ref => JSON.parse(rootRead(ref.replace('/events/', '/attachments/'))).attachments);
  check('all ten execution/test attachment entries match CAS hash/size and local originals', attachments.length === 10 && attachments.every(a => { const bytes = rootRead(a.ref); return a.status === 'saved' && bytes.length === a.size && sha(bytes) === a.sha256 && sha(rootRead(a.source_path)) === a.sha256; }));
  const git = args => { const r = spawnSync('git', args, { encoding: 'utf8', windowsHide: true }); if (r.status !== 0) throw new Error('Read-only git query failed'); return r.stdout.trim(); };
  const head = git(['rev-parse', 'HEAD']);
  check('actual HEAD is exact execution subject', head === event.payload.request.source_revision && head === observed.head);
  check('tracked working tree and index unchanged', git(['diff', '--name-only']) === '' && git(['diff', '--cached', '--name-only']) === '');
  check('historical device absence/service-unavailable report backed by saved observation', observed.physical.status === 'blocked-target-not-online' && observed.devices.stdout.trim() === 'List of devices attached' && observed.service.summary.includes('Listening: none') && read('service-status.txt').toString().includes('Health: unavailable'));
  const bytes = read('private/product-current.sqlite');
  check('exact private snapshot size/hash matches historical subject', bytes.length === 31301632 && sha(bytes) === observed.snapshot.sha256 && sha(bytes) === '255dd3247f408badf30a0d99834723c872e774fc43b9da65ce8f7688cfdc00c5');
  const SQL = await require('sql.js')(); const db = new SQL.Database(bytes); db.run('PRAGMA query_only=ON');
  const rows = (sql, args = []) => { const s = db.prepare(sql); s.bind(args); const out = []; while (s.step()) out.push(s.getAsObject()); s.free(); return out; };
  const cid = '01a0ee04-a775-72b3-bd07-04aac804a3b4';
  const rawItems = rows('SELECT * FROM history_items WHERE conversation_id=? ORDER BY ordinal,item_key', [cid]);
  const rawDetails = rows('SELECT * FROM tool_details WHERE conversation_id=? ORDER BY detail_key', [cid]);
  check('snapshot quick_check ok; F98/39 and A canonical absent', rows('PRAGMA quick_check')[0].quick_check === 'ok' && rawItems.length === 98 && rawDetails.length === 39 && rows('SELECT count(*) AS n FROM conversations WHERE conversation_id=?', ['01a0fe25-56a2-7910-ba22-61e8016e8ad9'])[0].n === 0);
  const h = { conversationId: cid, items: rawItems.map(r => ({ itemKey: r.item_key, eventId: r.event_id, turnId: r.turn_id, itemType: r.item_type, ordinal: r.ordinal, payload: JSON.parse(r.payload_json) })), toolDetails: rawDetails.map(r => ({ detailKey: r.detail_key, itemKey: r.item_key, payload: JSON.parse(r.payload_json) })), coverage: JSON.parse(rows('SELECT coverage_json FROM conversations WHERE conversation_id=?', [cid])[0].coverage_json) };
  const provider = new CodexHistoryProductProvider({ store: { readConversation: async id => id === cid ? h : null } });
  let page = await provider.readInitial(cid, { rangeEnabled: true }); const pages = [], seen = new Set(), refs = new Map();
  for (let n = 0; n < 15; n++) {
    const overlap = page.items.filter(i => seen.has(i.itemKey)).length;
    for (const i of page.items) { seen.add(i.itemKey); for (const r of i.detailRefs || []) refs.set(r.refId, r); }
    pages.push({ kind: n === 0 ? 'tail' : 'older', count: page.items.length, overlap, unique: seen.size, provider: page.range.providerMode, hasMoreBefore: page.range.hasMoreBefore, coverageComplete: page.range.coverageComplete });
    if (!page.range.hasMoreBefore) break;
    page = await provider.readOlderPage(cid, { cursor: page.range.nextOlderCursor, rangeId: page.range.rangeId });
  }
  check('seven exact retained page descriptors recompute from unchanged provider/snapshot', JSON.stringify(pages) === JSON.stringify(observed.offline_pages.pages));
  check('exact item key set matches all98 DB items, not just equal count', seen.size === 98 && rawItems.every(i => seen.has(i.item_key)));
  check('all39 ref identities match real conversation/detail key scope', refs.size === 39 && rawDetails.every(d => refs.has(sha(`${cid}\0${d.detail_key}`))));
  check('last page hasMoreBefore false never claims complete coverage', pages.length === 7 && pages.at(-1).hasMoreBefore === false && pages.every(p => p.coverageComplete === false));
  const ref = refs.get(observed.offline_detail.refId), chunks = [], offsets = []; let cursor = null;
  for (let n = 0; n < 10; n++) { const d = await provider.readDetailPage(cid, { refId: ref.refId, cursor }); chunks.push(Buffer.from(d.content, 'utf8')); offsets.push(d.byteOffset); cursor = d.nextCursor; if (!cursor) break; }
  const body = Buffer.concat(chunks);
  check('descriptor69,427 bytes/hash agrees with real two-chunk reconstructed detail', ref.byteSize === 69427 && body.length === 69427 && sha(body) === ref.contentHash && sha(body) === observed.offline_detail.actual_hash && cursor === null);
  check('exact chunk byte boundaries preserved', JSON.stringify(chunks.map(c => c.length)) === '[49152,20275]' && JSON.stringify(offsets) === '[0,49152]' && chunks.every(c => Buffer.from(c.toString('utf8')).equals(c)));
  const repeated = await provider.readDetailPage(cid, { refId: ref.refId });
  check('unchanged reference repeated-read retains descriptor and first chunk', repeated.contentHash === ref.contentHash && repeated.byteSize === ref.byteSize && repeated.content === chunks[0].toString('utf8'));
  db.close();
  const node = read('node-focused.txt').toString('utf8');
  check('raw retained Node log actually has3 passes/no failures despite empty parsed summary', observed.node_test.exit_code === 0 && /(?:#|ℹ) tests 3\b/.test(node) && /(?:#|ℹ) pass 3\b/.test(node) && /(?:#|ℹ) fail 0\b/.test(node) && node.split(/\r?\n/).filter(l => l.startsWith('✔ product-history-read ')).length === 3);
  const xml = read('android-focused-junit.xml').toString('utf8');
  const names = [...xml.matchAll(/<testcase name="([^"]+)"/g)].map(m => m[1]);
  check('JUnit exact3 requested cases, no failures/errors, Gradle successful', android.exit_code === 0 && names.length === 3 && android.selectors.every(s => names.includes(s.split('.').at(-1))) && /tests="3"/.test(xml) && /failures="0"/.test(xml) && /errors="0"/.test(xml) && read('android-focused.txt').toString().includes('BUILD SUCCESSFUL'));
  const stamp = xml.match(/timestamp="([^"]+)"/)[1];
  check('JUnit timestamp and saved report mtime within actual run window; JDK21 scoped', Date.parse(stamp) >= Date.parse(android.started_at) && Date.parse(stamp) <= Date.parse(android.finished_at) && Date.parse(android.suite.report_mtime) >= Date.parse(android.started_at) && Date.parse(android.suite.report_mtime) <= Date.parse(android.finished_at) && android.jdk === 'D:/ProgramCode/openjdk/jdk-21');
  const live = spawnSync('adb', ['-s', 'MQS7N19402011743', 'get-state'], { encoding: 'utf8', timeout: 10000, windowsHide: true });
  const liveDevice = { observed_at: new Date().toISOString(), serial: 'MQS7N19402011743', command: 'adb -s MQS7N19402011743 get-state', exit_code: live.status, stdout: live.stdout.trim(), stderr: live.stderr.trim(), meaning: 'Current USB authorization/readiness only; no physical S3 scenario exercised. Original absent-device observation stays historical.' };
  check('current exact target adb readiness is device', live.status === 0 && live.stdout.trim() === 'device');
  const result = { reviewed_execution_ref: eventRef, execution_sha256: sha(rootRead(eventRef)), source_revision: head, review_date: '2026-10-04 Asia/Shanghai', passed: checks.filter(c => c.pass).length, total: checks.length, checks, live_device: liveDevice, limitations: ['Self-review, not independent.', 'Retained file/snapshot verification; no Node/Gradle tests or physical E2E rerun.', 'Offline provider recomputation is not Gateway/provider DTO/phone durable commit/ACK/copy proof.', 'S3 still incomplete. Device readiness does not fulfill acceptance.', 'No service start, phone UI/clipboard/database mutation, model/Rust request, Git write, step finish or task closure.'] };
  fs.writeFileSync(path.join(out, 'review-20261004-checks.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify(result, null, 2));
  if (result.passed !== result.total) process.exitCode = 2;
}
main().catch(e => { console.error(e.stack); process.exitCode = 1; });
