'use strict';
// Append-only, one-time evidence correction. No live service, device or analyzer access.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { spawnSync } = require('node:child_process');

const root = process.cwd();
const out = __dirname;
const base = 'logs/e2e-validation-20261004/s4/';
const originalRef = '.workflow-system/records/events/key-80adab6cdb9d564d9c2d729f2e0415a0b66e64d0871efb83c8bc599215602030.json';
const reviewRef = '.workflow-system/records/events/key-9550ab96b8d1fbcc0ace3cb4de914a5f5931acc04d7639f47c31330f13e4fec3.json';
const conversationKey = 'd710f9d09d0248bf';
const citedIds = [
  'e4392a2c-a261-4b35-856c-b6984365c9a3',
  '0cff4ebc-61e1-448d-8467-ef1995503cae',
  'd5e17c07-55a0-43bd-a81b-180cac076033'
];
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const read = relative => JSON.parse(fs.readFileSync(path.join(root, relative), 'utf8'));
const digest = relative => sha(fs.readFileSync(path.join(root, relative)));
const save = (name, value) => fs.writeFileSync(path.join(out, name), JSON.stringify(value, null, 2) + '\n', { flag: 'wx' });
const stable = value => Array.isArray(value) ? value.map(stable) : value && typeof value === 'object'
  ? Object.fromEntries(Object.keys(value).sort().map(key => [key, stable(value[key])])) : value;
const normalized = rows => rows.map(row => JSON.stringify(stable(row))).sort();
const equalRows = (a, b) => JSON.stringify(normalized(a)) === JSON.stringify(normalized(b));
const pageIdentity = row => JSON.stringify([row.sync_id, row.sequence, row.page_index, row.page_hash]);

// ACK evidence lacks sequence/hash: these remain database facts, never inferred wire fields.
function matchPages(acks, databasePages, capturedPages, key, ids) {
  const capturedIdentities = new Set(capturedPages.map(pageIdentity));
  return acks.flatMap(ack => {
    const f = ack.fields;
    if (ack.event !== 'server.codex.history.ack_received' || f?.conversationKey !== key ||
        f.ok !== true || !ids.includes(f.syncId)) return [];
    const candidates = databasePages.filter(row => row.sync_id === f.syncId && row.page_index === f.pageIndex &&
      Number.isInteger(row.sequence) && /^[a-f0-9]{64}$/.test(row.page_hash) && capturedIdentities.has(pageIdentity(row)));
    if (candidates.length !== 1) return [];
    return [{ ack, completed_page: candidates[0] }];
  });
}

async function main() {
  const checks = [];
  const check = (name, ok) => checks.push({ name, ok: Boolean(ok) });
  const oldPaths = [];
  function inventory(relative) {
    for (const entry of fs.readdirSync(path.join(root, relative), { withFileTypes: true })) {
      const next = relative + '/' + entry.name;
      if (entry.isDirectory()) inventory(next);
      else if (entry.isFile() && !entry.name.startsWith('repair-r1')) oldPaths.push(next);
      else if (!entry.isFile()) throw Error('Unexpected non-regular evidence entry');
    }
  }
  inventory(base.slice(0, -1));
  const manifests = [originalRef, reviewRef].map(ref => ref.replace('/events/', '/attachments/'));
  const originals = new Set([...oldPaths, originalRef, reviewRef, ...manifests]);
  for (const file of fs.readdirSync(path.join(root, '.workflow-system/records/evidence-objects'))) {
    if (/^[a-f0-9]{64}\.blob$/.test(file)) originals.add('.workflow-system/records/evidence-objects/' + file);
  }
  const before = [...originals].sort().map(file => ({ file, sha256: digest(file) }));
  const observation = read(base + 'observations.json');
  const reopened = read(base + 'reopened.json');
  const dbPath = base + 'private/reopened/databases/codex_conversations.db';
  check('saved database digest equals original capture', digest(dbPath) === reopened.database.sha256);
  for (const manifestPath of manifests) {
    const attachments = read(manifestPath).attachments;
    check('original manifest attachments intact: ' + manifestPath, attachments.length > 0 && attachments.every(a =>
      a.status === 'saved' && fs.statSync(path.join(root, a.ref)).size === a.size && digest(a.ref) === a.sha256 &&
      digest(a.source_path) === a.sha256));
  }
  const SQL = await require('sql.js')();
  const db = new SQL.Database(fs.readFileSync(path.join(root, dbPath)));
  db.run('PRAGMA query_only=ON');
  const rows = query => {
    const result = db.exec(query)[0];
    return result ? result.values.map(values => Object.fromEntries(result.columns.map((column, i) => [column, values[i]]))) : [];
  };
  const columns = rows('PRAGMA table_info(sync_completed_pages)').map(row => row.name);
  const pages = rows('SELECT sync_id,sequence,page_index,page_hash,completed_at FROM sync_completed_pages');
  check('retained DB quick_check is ok', rows('PRAGMA quick_check')[0]?.quick_check === 'ok');
  db.close();
  check('actual page schema, no invented conversation_id', equalRows(columns.map(name => ({ name })),
    ['sync_id', 'sequence', 'page_index', 'page_hash', 'completed_at'].map(name => ({ name }))));
  check('225 DB pages equal saved capture, not empty-summary success', pages.length === 225 && equalRows(pages, reopened.database.pages) && observation.phone_pages.length === 0);
  const acks = observation.server_diagnostics.filter(event => event.event === 'server.codex.history.ack_received' &&
    event.fields.conversationKey === conversationKey && citedIds.includes(event.fields.syncId));
  check('three actual cited ACKs present and partial', acks.length === 3 && citedIds.every(id =>
    acks.filter(a => a.fields.syncId === id && a.fields.ok === true && a.fields.pageIndex === 0 && a.fields.state === 'partial').length === 1));
  const baselines = observation.server_diagnostics.filter(event => event.event === 'server.codex.history.baseline_registered' && event.fields.conversationKey === conversationKey);
  check('nonempty baselines remain IPC fallback', baselines.length > 0 && baselines.every(b => b.fields.sourceKind === 'ipc_surface' && b.fields.complete === false));
  const matches = matchPages(acks, pages, reopened.database.pages, conversationKey, citedIds);
  const expectedHashes = ['e0d4a504f25a3c09df30423d958c4036f9fe70d0376cc78da081f8241d6cea94', 'beee4d455b113bb8d1e7bda909c702d1520e935775338ae5b4f64ac1973e1e8f'];
  check('exactly two nonempty durable-page matches, with expected real hashes', matches.length === 2 && citedIds.slice(0, 2).every((id, i) =>
    matches.filter(m => m.completed_page.sync_id === id && m.completed_page.sequence === 1 && m.completed_page.page_index === 0 && m.completed_page.page_hash === expectedHashes[i]).length === 1));
  check('third sync explicitly lacks post-commit snapshot row, despite ACK', !pages.some(p => p.sync_id === citedIds[2]) && acks.some(a => a.fields.syncId === citedIds[2]));
  const mutateAcks = fields => acks.map(a => ({ ...a, fields: { ...a.fields, ...fields } }));
  check('reject wrong conversationKey', matchPages(mutateAcks({ conversationKey: 'other' }), pages, reopened.database.pages, conversationKey, citedIds).length === 0);
  check('reject failed ACK', matchPages(mutateAcks({ ok: false }), pages, reopened.database.pages, conversationKey, citedIds).length === 0);
  check('reject unrelated sync identity', matchPages(mutateAcks({ syncId: 'unrelated' }), pages, reopened.database.pages, conversationKey, citedIds).length === 0);
  check('reject wrong page index', matchPages(mutateAcks({ pageIndex: 99 }), pages, reopened.database.pages, conversationKey, citedIds).length === 0);
  check('empty ACK evidence cannot produce durable/ACK matches', matchPages([], pages, reopened.database.pages, conversationKey, citedIds).length === 0);
  check('reject snapshot hash mismatch', matchPages(acks, pages.map(p => ({ ...p, page_hash: '0'.repeat(64) })), reopened.database.pages, conversationKey, citedIds).length === 0);
  check('reject snapshot sequence mismatch', matchPages(acks, pages.map(p => ({ ...p, sequence: p.sequence + 1000 })), reopened.database.pages, conversationKey, citedIds).length === 0);
  check('ambiguous duplicate pages fail closed', matchPages(acks, [...pages, ...pages], reopened.database.pages, conversationKey, citedIds).length === 0);

  const correction = {
    schema_version: 1, kind: 'S4-R1-evidence-correction', at: new Date().toISOString(),
    original_execution_ref: originalRef, review_ref: reviewRef,
    corrects: [base + 'summarize.cjs:24', base + 'observations.json#/phone_pages', base + 'report.md:54'],
    original_files_unchanged: true,
    conversation_id: '01a0fe25-56a2-7910-ba22-61e8016e8ad9', conversation_key: conversationKey,
    sources: [dbPath, base + 'reopened.json', base + 'observations.json'].map(file => ({ file, sha256: digest(file) })),
    capture_started_at: reopened.observed_at, total_retained_pages: pages.length,
    original_summary_page_count: observation.phone_pages.length,
    phone_pages: matches.map(m => ({ ...m.completed_page })),
    sync_evidence: citedIds.map(id => ({
      sync_id: id,
      ack: acks.find(a => a.fields.syncId === id),
      completed_pages: matches.filter(m => m.completed_page.sync_id === id).map(m => m.completed_page),
      qualification: matches.some(m => m.completed_page.sync_id === id)
        ? 'Durable row in retained capture matches syncId/pageIndex of actual partial ACK. Sequence/pageHash validated DB-to-capture only; not a wire hash/sequence comparison.'
        : 'ACK observed; no completed-page in retained snapshot. Post-commit persistence unverified, not a failure inferred from absence.'
    })),
    baseline_evidence: baselines,
    limitations: [
      'ACK summary does not retain sequence or pageHash; do not fabricate them or claim end-to-end hash equality.',
      'capture_started_at is phase start, not an atomic snapshot transaction timestamp. Live backup is not quiesced.',
      'DB completed_at uses device clock; ACK/capture metadata use host clock. No cross-clock ordering asserted.',
      'IPC fallback remains partial; canonical publication failures, UI error candidate, budgets and races remain unchanged.',
      'No source/config/permanent-test edits, live captures, model calls, service operations, Git writes, formal review or S4 finish.'
    ]
  };
  check('original evidence files and every existing CAS blob byte-preserved', before.every(b => digest(b.file) === b.sha256));
  const git = args => {
    const result = spawnSync('git', args, { encoding: 'utf8', windowsHide: true });
    if (result.status !== 0) throw Error('Read-only Git command failed: ' + result.stderr);
    return result.stdout.trim();
  };
  const gitState = { head: git(['rev-parse', 'HEAD']), tracked_diff: git(['diff', '--name-only']), index_diff: git(['diff', '--cached', '--name-only']) };
  check('source HEAD, tracked and index unchanged', gitState.head === '19bf3121203ba17ad21147ffe02877d50a22d4a0' && !gitState.tracked_diff && !gitState.index_diff);
  const failed = checks.filter(c => !c.ok);
  const validation = { at: new Date().toISOString(), qualification: 'One-time evidence self-checks, not E2E tests or formal review', checks, failed_checks: failed.map(c => c.name), git: gitState, originals: before };
  // Retain actual failed predicates without publishing a successful correction.
  save('repair-r1-validation.json', validation);
  if (!failed.length) save('repair-r1-observations.json', correction);
  console.log(JSON.stringify({ checks: checks.length, failed_checks: validation.failed_checks, preserved_files: before.length,
    durable_page_count: matches.length, ack_only_syncs: correction.sync_evidence.filter(s => !s.completed_pages.length).map(s => s.sync_id) }, null, 2));
  if (failed.length) process.exitCode = 1;
}
main().catch(error => { console.error(error.stack); process.exitCode = 1; });
