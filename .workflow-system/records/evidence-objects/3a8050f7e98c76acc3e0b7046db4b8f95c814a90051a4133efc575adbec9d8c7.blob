const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S4'}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const status=JSON.parse(q.stdout);fs.writeFileSync(path.join(d,'status-before.json'),q.stdout);assert.equal(status.step.state,'not-started');assert.equal(status.current_task_id,status.task.task_id);
const prior=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s3/review-r2/audit.json','utf8'));assert.ok(prior.protect.every(p=>hash(p.path)===p.sha256));assert.equal(hash(prior.binary.path),prior.binary.sha256);
const subjects=['tests/codexHistoryProductFlow.test.js','docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/product/requirements/REQ-20261005-codex-history-save-repair.md'].map(p=>{const snapshot=path.join(d,'before',p.replaceAll('/','__'));fs.mkdirSync(path.dirname(snapshot),{recursive:true});fs.copyFileSync(p,snapshot);return{path:p,sha256:hash(p),snapshot};});
const protect=[...prior.protect,...prior.subjects.filter(p=>p.path.startsWith('native/')).map(p=>({path:p.path,sha256:p.sha256}))];
const baseline={head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),subjects,protect,binary:prior.binary};fs.writeFileSync(path.join(d,'baseline.json'),JSON.stringify(baseline,null,2)+'\n');console.log(JSON.stringify({head:baseline.head,step:status.step.state,next:status.next_step_id,subjects:subjects.length,protected:protect.length,binary:baseline.binary}));
