const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,rel='logs/history-save-repair-20261005/s4',save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n'),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
function query(task,step,name){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:step?'step':'task',task_ref:task,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);save(name,v);return v;}
const before=query('TASK-20260832','S4','status-record-before'),s3=query('TASK-20260832','S3','status-s3-before'),base=JSON.parse(fs.readFileSync(path.join(d,'baseline.json'),'utf8')),check=JSON.parse(fs.readFileSync(path.join(d,'self-check.json'),'utf8'));assert.equal(before.step.state,'not-started');assert.equal(s3.step.state,'finished');assert.equal(before.current_task_id,before.task.task_id);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),base.head);assert.ok([...check.subjects,...base.protect].every(p=>hash(p.path)===p.sha256));assert.equal(hash(base.binary.path),base.binary.sha256);
const collect=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(p=>p.isDirectory()?collect(dir+'/'+p.name):[dir+'/'+p.name]);const commands=fs.readdirSync(d).filter(n=>n.endsWith('-result.json')).map(n=>{const p=JSON.parse(fs.readFileSync(path.join(d,n),'utf8'));return{command:p.command,environment:p.environment,result:'exit'+p.exit_code,report_ref:rel+'/'+n.replace('-result.json','.txt')};});commands.push({command:'node '+rel+'/checks.cjs',result:'PASS evidence/currentbinary/source/protection checks',report_ref:rel+'/self-check.json'});
const input={action:'execution',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S4',mode:'default',source_revision:base.head,result:'H2 repairedbranch savedthroughactualRust/Node/SQLite/provider;H1H3 reused/currentbinary regression44/44 PASS;pendingchange review/productnaturalhost/mobile acceptance',decision_source:'Current human bare execute-step;fresh journal S3finished/focused832/S4not-started;confirmed832plan and833handoff reused',decision_text:'[$execute-step](E:\\coding\\TermLink-rust-source-resolution-codex\\.agents\\skills\\execute-step\\SKILL.md)',summary:{scope:'Existingproduct-flow test H2,PLAN/newdraftCR/logs;no productionNode/Rust/Gateway/DBschema/IPC/Android/vendor/sharedcontract/defaultbudget/Git/deploy/real source orphonechanges',business:'H1full+append andH3 exactcarrier/conflict/rollback reusedverifiedcurrentbinary;H2 actualA/C prefix/body/tool identities,SQLite durablestaging→actualNodeACK→Rustcomplete→productCOMMIT,duplicate/restart/append/wrongbindingnegativeACK andA/C oldcanonical protection',binary:base.binary,qualification:'Implementation self-check only,notchange/independentreview orfinish/close. ActualNode durableACK inisolatedSQLtest,notphoneACK ornaturalCodex Branch. ExistingGatewaytest harness only.',test_assertion_correction:'Initialmutation.op assertion correctedtorealmutation.mutation andexactdetail/rejection asserts beforefinal44/44;initialPASS output preserved'},commands,remaining_work:['S4change review then separatefinish;832active,833closed unchanged','S5all3naturalhost scenes andS6specifiedphone durablebody/tool/switch/reopen underoriginalbudgets;productDB/service/Gateway/deviceobservationsnotrun','Originalfailures/vendoroffline limitation/3oldmanagementassociationgaps retained'],files:[...check.subjects.map(p=>p.path),...base.protect.map(p=>p.path),...collect(rel).filter(p=>!p.endsWith('/execution-input.json')&&!p.endsWith('/execution-result.json'))],idempotency_key:'task20260832-S4-branch-product-execution-20261007-v1'};
save('execution-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(d,'execution-result.json'),r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);assert.equal(out.recorded,true);assert.equal(out.association,'applied');assert.equal(out.projection.status,'updated');console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const after=query('TASK-20260832','S4','status-after'),child=query('TASK-20260833',null,'status-833-after');assert.equal(after.step.execution_ref,out.ref);assert.equal(after.step.state,'executed');assert.equal(after.step.review_ref,null);assert.equal(after.step.disposition_ref,null);assert.equal(after.next_route,'review-change');assert.equal(after.current_task_id,before.current_task_id);assert.equal(child.task.lifecycle,'closed');
const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('attachment-readback',attachments);console.log(JSON.stringify({state:after.step.state,review:after.step.review_status,finish:after.step.disposition_ref,next_route:after.next_route,next_step:after.next_step_id,attachments:attachments.length,all_match:true,child:'closed',issues:after.issues.length}));
