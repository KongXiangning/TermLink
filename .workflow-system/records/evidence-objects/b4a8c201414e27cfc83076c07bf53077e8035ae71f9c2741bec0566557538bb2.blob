'use strict';
const fs=require('fs'),path=require('path'),WebSocket=require('ws');const out=__dirname;
(async()=>{const end=Date.now()+15000,p=path.join(out,'private','inspector-url.json');while(!fs.existsSync(p)&&Date.now()<end)await new Promise(r=>setTimeout(r,50));if(!fs.existsSync(p))throw Error('inspector URL unavailable');
 const target=JSON.parse(fs.readFileSync(p)),ws=new WebSocket(target.url),pending=new Map();let seq=0,paused;
 ws.on('message',b=>{const m=JSON.parse(b);if(m.id){const r=pending.get(m.id);if(r){pending.delete(m.id);m.error?r.reject(Error(m.error.message)):r.resolve(m.result);}}if(m.method==='Debugger.paused')paused=m.params;});
 await new Promise((r,j)=>{ws.once('open',r);ws.once('error',j);});const rpc=(method,params={})=>new Promise((resolve,reject)=>{const id=++seq;pending.set(id,{resolve,reject});ws.send(JSON.stringify({id,method,params}));});
 let bp;try{
 await rpc('Debugger.enable');bp=await rpc('Debugger.setBreakpointByUrl',{urlRegex:'analysisBatchImporter\\.js$',lineNumber:2146,condition:"batch.scope.conversationId === '01a0fe25-56a2-7910-ba22-61e8016e8ad9' && !sameJson(value.reducer_state, batch.payload.reducer_state)"});
 await rpc('Runtime.runIfWaitingForDebugger');const deadline=Date.now()+45000;while(!paused&&Date.now()<deadline)await new Promise(r=>setTimeout(r,50));if(!paused)throw Error('bounded breakpoint timeout');
 const expression=`(()=>{const left=value.reducer_state,right=batch.payload.reducer_state,diffs=[];const shape=v=>v===undefined?{type:'undefined'}:v===null?{type:'null'}:typeof v==='number'||typeof v==='boolean'?{type:typeof v,value:v}:typeof v==='string'?{type:'string',length:v.length}:{type:Array.isArray(v)?'array':'object',keys:Object.keys(v).length};const walk=(a,b,p)=>{if(sameJson(a,b))return;if(a&&b&&typeof a==='object'&&typeof b==='object'){for(const k of new Set([...Object.keys(a),...Object.keys(b)]))walk(a[k],b[k],p+'.'+k);}else if(diffs.length<60)diffs.push({path:p,checkpoint:shape(a),batch:shape(b)});};walk(left,right,'reducer_state');return {conversation:batch.scope.conversationId,job_id:value.job_id,batch_id:batch.identity.batch_id,checkpoint_profile:value.wire_profile,checkpoint_version:left.reducer_version,batch_version:right.reducer_version,diffs};})()`;
 const evaluated=await rpc('Debugger.evaluateOnCallFrame',{callFrameId:paused.callFrames[0].callFrameId,expression,returnByValue:true});if(evaluated.exceptionDetails)throw Error('diagnostic evaluation failed: '+(evaluated.exceptionDetails.exception?.description||evaluated.exceptionDetails.text).slice(0,350));
 const result={at:new Date().toISOString(),pid:target.pid,paused_at:{function:paused.callFrames[0].functionName,line:paused.callFrames[0].location.lineNumber+1},observation:evaluated.result.value,method:'Node inspector conditional breakpoint on existing normal server; no source logs, no state mutation, no second collector'};fs.writeFileSync(path.join(out,'live-reducer-diff.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));
 }catch(e){fs.writeFileSync(path.join(out,'inspector-failure-'+Date.now()+'.json'),JSON.stringify({at:new Date().toISOString(),paused_at:paused&&{reason:paused.reason,function:paused.callFrames[0].functionName,line:paused.callFrames[0].location.lineNumber+1},error:e.message})+'\n',{flag:'wx'});console.error(e.message);process.exitCode=1;}finally{if(bp)await rpc('Debugger.removeBreakpoint',{breakpointId:bp.breakpointId}).catch(()=>{});if(paused)await rpc('Debugger.resume').catch(()=>{});await rpc('Debugger.disable').catch(()=>{});ws.close();}
})().catch(e=>{console.error(e.message);process.exitCode=1;});
