'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto');const out=__dirname,sha=b=>crypto.createHash('sha256').update(b).digest('hex'),read=n=>JSON.parse(fs.readFileSync(path.join(out,n+'.json'))),checks=[],check=(name,passed)=>checks.push({name,passed:!!passed});
const base=read('baseline-summary'),after=read(process.argv[2]||'n-after');
for(const [file,v]of Object.entries(base.files))if(file!=='data/sessions.json')check('protected file '+file,sha(fs.readFileSync(file))===v.sha256);
for(const label of ['N','D','F'])check('readonly source '+label,base.sources[label].length===1&&after.sources[label].length===1&&base.sources[label][0].sha256===after.sources[label][0].sha256);
const old=base.canonical.find(r=>r.id===base.ids.F),f=after.canonical.find(r=>r.id===base.ids.F);check('F canonical items/details retained',old.digest===f.digest&&old.items===f.items&&old.details===f.details);
check('all old run records byte preserved',base.runs.every(r=>after.runs.some(x=>x.file===r.file&&x.sha256===r.sha256)));
const n=after.canonical.find(r=>r.id===base.ids.N);check('N published separately',n&&n.items===11&&n.details===2);check('N complete coverage',n?.coverage?.completeness==='canonical'&&n?.coverage?.coverageComplete===true);
check('N no C marker',n&&n.marker_counts['TL832-S5-C-20261007']===0&&n.marker_counts['TL832-S5-C-DONE']===0);check('D retained absent',!after.canonical.some(r=>r.id===base.ids.D));check('D durable intent retained',after.intents.some(r=>r.conversation_id===base.ids.D));
const wire=JSON.parse(fs.readFileSync(path.join(out,'private','n-product-wire.json'))),page=wire.find(m=>m.type==='conversation_history_delta');check('N product complete page',page.range.providerMode==='product_db'&&page.range.coverageComplete&&page.upserts.length===n.items);
const source=fs.readFileSync(base.sources.N[0].path,'utf8').trim().split('\n').map(l=>JSON.parse(l)),ordinary=source.filter(r=>r.type==='response_item'&&r.payload.type==='message'&&r.payload.role==='user').filter(r=>JSON.stringify(r.payload.content).includes('TL832-S5-N-20261007'));
check('N exactly one ordinary request',ordinary.length===1);check('N native source no delegation',!source.some(r=>r.type==='response_item'&&r.payload.type==='function_call_output'));
const payloads=page.upserts.map(i=>({key:i.itemKey,p:JSON.parse(i.payloadJson)})),cmd='exec-57e3cac5-da0a-4ef8-b44f-88726133194a',native=source.find(r=>r.type==='event_msg'&&r.payload.type==='item_completed'&&r.payload.item?.id===cmd)?.payload.item;
const detail=wire.filter(m=>m.type==='conversation_history_detail_response').map(m=>JSON.parse(m.content)).find(d=>d.call_id===cmd);
const durationMs=native?.duration?native.duration.secs*1000+Math.floor(native.duration.nanos/1000000):null;
check('N native command detail identity/output',native&&detail&&detail.input===JSON.stringify({command:native.command,cwd:native.cwd})&&detail.output===`status=${native.status}; exit_code=${native.exit_code}; duration_ms=${durationMs}; output=${native.aggregated_output}`);
check('N final body exact',payloads.some(x=>x.p.content==='TL832-S5-N-DONE'||x.p.answer==='TL832-S5-N-DONE'));
const result={at:new Date().toISOString(),checks,passed:checks.filter(c=>c.passed).length,total:checks.length,session_file:{before:base.files['data/sessions.json'].sha256,after:sha(fs.readFileSync('data/sessions.json')),qualification:'Authorized normal new validation session and binding changed durable session metadata; original empty list is not restored/deleted.'},correction:'Initial self-check retained: session metadata naturally changed; coverage uses canonical/coverageComplete; native duration is secs/nanos. Assertions corrected against observed schema, no business tests repeated.',qualification:'Evidence self-check, not product test count or formal review. C own turn and phone checks still pending. D remains failed; no new delegated replacement sample.'};fs.writeFileSync(path.join(out,process.argv[3]||'self-check-corrected.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));if(checks.some(x=>!x.passed))process.exitCode=2;
