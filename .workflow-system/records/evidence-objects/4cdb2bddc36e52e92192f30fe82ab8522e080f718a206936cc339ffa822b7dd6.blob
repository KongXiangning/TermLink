const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),path=require('path'),dir=__dirname,phase=process.argv[2],priv=dir+'/private',args=['-s','MQS7N19402011743'];if(!/^[a-z0-9-]+$/.test(phase||''))throw Error('phase required');const run=a=>cp.spawnSync('adb',[...args,...a],{encoding:'utf8',timeout:20000,windowsHide:true});const file=(a,name)=>{const fd=fs.openSync(priv+'/'+name,'wx');let r;try{r=cp.spawnSync('adb',[...args,...a],{stdio:['ignore',fd,'pipe'],timeout:20000,windowsHide:true});}finally{fs.closeSync(fd);}if(r.status!==0)throw Error('capture failed '+r.status);const b=fs.readFileSync(priv+'/'+name);return {path:'private/'+name,bytes:b.length,sha256:crypto.createHash('sha256').update(b).digest('hex')};};const wake=run(['shell','input','keyevent','KEYCODE_WAKEUP']),dump=run(['shell','uiautomator','dump','/data/local/tmp/tl832-s6-'+phase+'.xml']),xml=file(['exec-out','cat','/data/local/tmp/tl832-s6-'+phase+'.xml'],phase+'.xml'),screenshot=file(['exec-out','screencap','-p'],phase+'.png'),pid=run(['shell','pidof','com.termlink.app']).stdout.trim();const result={phase,at:new Date().toISOString(),pid,xml,screenshot,nodes:[...fs.readFileSync(priv+'/'+phase+'.xml','utf8').matchAll(/<node\b[^>]*>/g)].map(m=>({text:m[0].match(/\btext="([^"]*)"/)?.[1],desc:m[0].match(/content-desc="([^"]*)"/)?.[1],bounds:m[0].match(/bounds="([^"]*)"/)?.[1]})).filter(n=>n.text||n.desc)};if(pid)result.logcat=file(['logcat','--pid='+pid,'-d','-v','threadtime'],phase+'-logcat.txt');fs.writeFileSync(priv+'/'+phase+'-ui.json',JSON.stringify(result,null,2),{flag:'wx'});fs.writeFileSync(dir+'/'+phase+'-ui-summary.json',JSON.stringify({phase,at:result.at,pid,xml,screenshot,edit_text_lengths:[...fs.readFileSync(priv+'/'+phase+'.xml','utf8').matchAll(/<node\b[^>]*>/g)].filter(m=>/class="android.widget.EditText"/.test(m[0])).map(m=>(m[0].match(/\btext="([^"]*)"/)?.[1]||'').length),detail_buttons:result.nodes.filter(n=>n.text?.includes('查看历史详情')).map(n=>({text:n.text,bounds:n