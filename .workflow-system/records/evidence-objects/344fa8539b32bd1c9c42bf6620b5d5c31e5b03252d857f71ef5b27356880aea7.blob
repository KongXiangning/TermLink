'use strict';
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { execFileSync } = require('node:child_process');
const out = __dirname;
const hash = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
function walk(dir) {
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(e => e.isDirectory() ? walk(path.join(dir, e.name)) : e.isFile() ? [path.join(dir, e.name)] : []);
}
function entry(file) { const b = fs.readFileSync(file); return { path: file.replaceAll('\\', '/'), bytes: b.length, sha256: hash(b) }; }
const git = args => execFileSync('git', args, { encoding: 'utf8', windowsHide: true }).trim();
const mode = process.argv[2];
if (mode === 'before') {
  const files = [...new Set([
    ...walk('.workflow-system/records/events'), ...walk('.workflow-system/records/attachments'), ...walk('.workflow-system/records/evidence-objects'),
    ...walk('logs/e2e-validation-20261003'), ...walk('logs/e2e-validation-20261004').filter(f => !path.resolve(f).startsWith(out + path.sep)),
    ...walk('logs/task005-s2-repair-runtime-2/data/codex-rollout-runs'),
    ...git(['ls-files', '-z', '--', 'src', 'native', 'android', 'tests', 'public', 'package.json', 'package-lock.json', '.agents', '.workflow-system/runtime', 'docs/codex', 'docs/workflow/CONTRACTS.md', 'docs/workflow/DECISIONS.md']).split('\0').filter(f => f && fs.existsSync(f)),
    ...['.env', 'data/client-registrations.json'].filter(f => fs.existsSync(f))
  ])];
  fs.writeFileSync(path.join(out, 'original-files.json'), JSON.stringify({ head: git(['rev-parse', 'HEAD']), index: git(['write-tree']), files: files.map(entry) }, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify({ preserved_baseline_files: files.length, source_diff: git(['diff', '--name-only']), index_diff: git(['diff', '--cached', '--name-only']) }));
} else if (mode === 'after') {
  const before = JSON.parse(fs.readFileSync(path.join(out, 'original-files.json')));
  const mismatches = before.files.filter(e => !fs.existsSync(e.path) || entry(e.path).sha256 !== e.sha256);
  const result = { head_unchanged: git(['rev-parse', 'HEAD']) === before.head, index_tree_unchanged: git(['write-tree']) === before.index,
    checked_files: before.files.length, mismatches, source_diff: git(['diff', '--name-only']), index_diff: git(['diff', '--cached', '--name-only']),
    qualification: 'Hash preservation is scoped to enumerated original bytes. Newly appended management records and derived views are separate.' };
  fs.writeFileSync(path.join(out, 'preservation-check.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify(result)); if (mismatches.length || !result.head_unchanged || !result.index_tree_unchanged) process.exitCode = 1;
} else throw Error('before or after required');
