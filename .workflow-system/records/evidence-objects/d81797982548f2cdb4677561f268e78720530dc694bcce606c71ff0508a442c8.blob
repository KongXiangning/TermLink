const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict'),out='logs/history-save-repair-20261005/s5/utf8-repair-20261008';
const result=JSON.parse(fs.readFileSync(out+'/execution-result.json'));const sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const manifest=JSON.parse(fs.readFileSync(result.ref.replace('/events/','/attachments/')));
const a=manifest.attachments.map((x,i)=>x.ref?{path:x.source_path,status:x.status,fixed:sha(x.ref)===x.sha256,live:sha(x.source_path)===x.sha256}:{path:JSON.parse(fs.readFileSync(out+'/execution-input.json')).files[i],status:x.status,issues:x.issues});
assert.equal(a.filter(x=>x.status==='unavailable').length,1);assert.equal(a.find(x=>x.status==='unavailable').path,out+'/service-stop.txt');assert.ok(a.filter(x=>x.status==='saved').every(x=>x.fixed&&x.live));
fs.writeFileSync(out+'/attachment-readback.json',JSON.stringify({attachments:a,verification_script_failure:'Initial record-execution helper assumed every attachment had a ref; service-stop.txt was not created. Execution fact and other28 attachments saved successfully; corrected readback retains missing optional log, does not replay business or write a replacement execution.'},null,2)+'\n',{flag:'wx'});
const q=input=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});assert.equal(r.status,0);return JSON.parse(r.stdout)};
const s=q({detail:'step',task_ref:'TASK-20260832',step_id:'S5'});assert.equal(s.step.execution_ref,result.ref);assert.equal(s.next_route,'review-change');assert.equal(s.step.disposition_ref,null);assert.equal(s.step.review_ref,null);assert.equal(s.issues.length,3);
const prior=['S1','S2','S3','S4'].map(step_id=>{const v=q({detail:'step',task_ref:'TASK-20260832',step_id});assert.equal(v.step.state,'finished');return {step_id,state:v.step.state}});
const child=q({detail:'task',task_ref:'TASK-20260833'});assert.equal(child.task.lifecycle,'closed');
fs.writeFileSync(out+'/final-management-readback.json',JSON.stringify({execution_ref:result.ref,recorded:result.recorded,association:result.association,projection:result.projection,current_task:s.current_task_id,step:s.step.id||'S5',state:s.step.state,review_ref:s.step.review_ref,disposition_ref:s.step.disposition_ref,next_route:s.next_route,prior_steps:prior,task833:child.task.lifecycle,saved_attachments:a.filter(x=>x.status==='saved').length,unavailable_optional_log:a.find(x=>x.status==='unavailable').path,retained_old_issues:s.issues},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({recorded:result.recorded,association:result.association,projection:result.projection.status,S5:s.step.state,review:null,finish:null,next_route:s.next_route,S1_S4:'finished',task833:child.task.lifecycle,verified_saved_attachments:28,optional_stop_log:'not saved; original missing attachment retained'}));
