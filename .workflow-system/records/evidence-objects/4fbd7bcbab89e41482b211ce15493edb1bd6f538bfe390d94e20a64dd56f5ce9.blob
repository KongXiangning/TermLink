const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d=__dirname,base='logs/history-save-repair-20261005/s3',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const save=(n,v)=>fs.writeFileSync(`${d}/${n}.json`,JSON.stringify(v,null,2)+'\n');
const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S3'}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const status=JSON.parse(q.stdout);save('status-before',status);
assert.equal(status.step.execution_ref,'.workflow-system/records/events/key-caa4ad2a4c543fcbac91cd3b4183dce7bc2022a20a522b3016dd59dce2b6ed35.json');
const manifest=JSON.parse(fs.readFileSync(status.step.execution_ref.replace('/events/','/attachments/'),'utf8'));
const attachments=manifest.attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));
const baseline=JSON.parse(fs.readFileSync(`${base}/baseline.json`,'utf8')),source=JSON.parse(fs.readFileSync(`${base}/source-after.json`,'utf8'));
const protectedSubjects=baseline.protect.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const currentSubjects=source.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const binary=JSON.parse(fs.readFileSync(`${base}/self-check.json`,'utf8')).binary;
assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));assert.ok([...protectedSubjects,...currentSubjects].every(p=>p.matches));assert.equal(hash(binary.path),binary.sha256);
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();assert.equal(head,baseline.head);
save('audit',{head,execution_ref:status.step.execution_ref,attachments,protectedSubjects,currentSubjects,binary});
console.log(JSON.stringify({head,execution_ref:status.step.execution_ref,attachments:attachments.length,all_match:true,protectedSubjects:protectedSubjects.length,currentSubjects:currentSubjects.length,binary,state:status.step.state,review:status.step.review_status}));
