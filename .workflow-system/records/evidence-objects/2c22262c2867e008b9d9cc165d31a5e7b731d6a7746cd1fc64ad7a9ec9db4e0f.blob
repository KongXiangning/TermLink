'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{spawnSync}=require('node:child_process');
const out=__dirname,priv=path.join(out,'private');fs.mkdirSync(priv,{recursive:true});
const phase=process.argv[2];if(!/^[a-z0-9-]+$/.test(phase||''))throw Error('unique phase required');
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
function run(exe,args){const r=spawnSync(exe,args,{encoding:'utf8',windowsHide:true,timeout:30000});return{exit:r.status,stdout:r.stdout?.trim(),stderr:r.stderr?.trim()};}
const adb=args=>run('adb',['-s','MQS7N19402011743',...args]);
function file(args,name){const p=path.join(priv,name),fd=fs.openSync(p,'wx');let r;try{r=spawnSync('adb',['-s','MQS7N19402011743',...args],{stdio:['ignore',fd,'pipe'],windowsHide:true,timeout:30000});}finally{fs.closeSync(fd);}if(r.status!==0)throw Error(`capture failed ${r.status}: ${r.stderr}`);const b=fs.readFileSync(p);return{path:p,bytes:b.length,sha256:sha(b)};}
async function main(){
const result={phase,observed_at:new Date().toISOString(),head:run('git',['rev-parse','HEAD']).stdout,device:adb(['get-state']),pid:adb(['shell','pidof','com.termlink.app']),reverse:adb(['reverse','--list'])};
result.backup=file(['exec-out','run-as','com.termlink.app','tar','-cf','-','databases','shared_prefs'],`${phase}.tar`);
const dest=path.join(priv,phase);fs.mkdirSync(dest);const ext=run('tar',['-xf',result.backup.path,'-C',dest]);if(ext.exit!==0)throw Error('tar extract failed');
const SQL=await require('sql.js')();const b=fs.readFileSync(path.join(dest,'databases/codex_conversations.db'));let db;try {db=new SQL.Database(b);db.run('PRAGMA query_only=ON');
const rows=q=>{const r=db.exec(q)[0];return r?r.values.map(v=>Object.fromEntries(r.columns.map((c,i)=>[c,v[i]]))):[];};
result.database={sha256:sha(b),quick_check:rows('PRAGMA quick_check'),counts:rows('SELECT conversation_id,count(*) n FROM items GROUP BY conversation_id'),conversations:rows('SELECT conversation_id,root_hash,item_count,complete,provider_mode,coverage_complete,coverage_state FROM conversations'),pages:rows('SELECT * FROM sync_completed_pages').map(r=>Object.fromEntries(Object.entries(r).filter(([k])=>!k.includes('payload')))),items_digest:sha(JSON.stringify(rows('SELECT * FROM items ORDER BY conversation_id,item_key')))};db.close();}catch(e){result.database={sha256:sha(b),snapshot_error:e.message};if(db)db.close();}
result.preference_hashes=Object.fromEntries(fs.readdirSync(path.join(dest,'shared_prefs')).filter(n=>n.endsWith('.xml')).map(n=>[n,sha(fs.readFileSync(path.join(dest,'shared_prefs',n)))]));
const uiPath=`/data/local/tmp/termlink-e2e-s4-${phase}.xml`;result.dump=adb(['shell','uiautomator','dump',uiPath]);if(result.dump.exit===0){result.ui=file(['exec-out','cat',uiPath],`${phase}.xml`);const xml=fs.readFileSync(result.ui.path,'utf8');result.edit_text_lengths=[...xml.matchAll(/<node\b[^>]*>/g)].filter(m=>/class="android.widget.EditText"/.test(m[0])).map(m=>(m[0].match(/\btext="([^"]*)"/)?.[1]||'').length);result.ui_labels={connected:xml.includes('已连接'),running:xml.includes('运行中')||xml.includes('正在运行'),A:xml.includes('TermLink E2E A 20261003'),B:xml.includes('梳理知识内核任务流程'),retry:xml.includes('重试')};result.screenshot=file(['exec-out','screencap','-p'],`${phase}.png`);}
const pid=result.pid.stdout;if(/^\d+$/.test(pid||''))result.logcat=file(['logcat','--pid='+pid,'-d','-v','threadtime'],`${phase}-logcat.txt`);
result.product_sha256=sha(fs.readFileSync('logs/task005-s2-repair-runtime-2/data/codex-history.sqlite'));
result.limitations=['Live tar/copy is not a quiesced transaction backup.','UI XML and full logs/cache/prefs are private ignored; no clipboard read/write.'];
fs.writeFileSync(path.join(out,`${phase}.json`),JSON.stringify(result,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({phase,device:result.device,pid:result.pid,reverse:result.reverse,edit_text_lengths:result.edit_text_lengths,ui_labels:result.ui_labels,phone_db:result.database.sha256,product_sha256:result.product_sha256,backup_sha256:result.backup.sha256}));
}main().catch(e=>{console.error(e.message);process.exitCode=1;});
