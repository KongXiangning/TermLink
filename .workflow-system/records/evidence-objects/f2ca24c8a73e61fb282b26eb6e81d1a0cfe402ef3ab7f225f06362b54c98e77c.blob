const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d=__dirname,hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S3'}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const status=JSON.parse(r.stdout);fs.writeFileSync(path.join(d,'status-before.json'),r.stdout);
assert.equal(status.step.review_ref,'.workflow-system/records/events/key-aeb521d60861069c8ab289726c2d0160bcd86d0c05de1515c3bb119f1abe562f.json');assert.equal(status.step.review_status,'findings');
const prior=JSON.parse(fs.readFileSync('logs/history-save-repair-20261005/s3/review-r1/audit.json','utf8'));
const subjects=prior.currentSubjects.map(p=>{assert.equal(hash(p.path),p.sha256);const dest=path.join(d,'before',p.path.replaceAll('/','__'));fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(p.path,dest);return{path:p.path,sha256:p.sha256,snapshot:dest};});assert.ok(prior.protectedSubjects.every(p=>hash(p.path)===p.sha256));
fs.writeFileSync(path.join(d,'baseline.json'),JSON.stringify({head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),subjects,protect:prior.protectedSubjects,review_ref:status.step.review_ref},null,2)+'\n');console.log(JSON.stringify({subjects:subjects.length,protected:prior.protectedSubjects.length,step:status.step.state,review:status.step.review_status}));
