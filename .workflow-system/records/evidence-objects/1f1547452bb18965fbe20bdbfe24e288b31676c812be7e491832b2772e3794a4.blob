'use strict';
// Debugger launches the same product server entry, same original persistent root.
// Only one server/analyzer chain; no direct analyzer request or collector instance.
const path=require('path');
// Disabled after DebugMCP failed to establish a session. A delayed launch must exit.
throw new Error('DebugMCP launch cancelled; use bounded normal-server inspector');
