const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const base=JSON.parse(fs.readFileSync(path.join(d,'baseline.json'),'utf8'));
const protectedSubjects=base.protect.map(p=>({...p,matches:hash(p.path)===p.sha256}));assert.ok(protectedSubjects.every(p=>p.matches));
const subjects=[...base.subjects.map(p=>p.path),'docs/changes/records/CR-20261007-0219-branch-history-window-repair.md'].map(p=>({path:p,sha256:hash(p)}));
const changed=base.subjects.filter(p=>hash(p.path)!==p.sha256).map(p=>p.path);assert.deepEqual(changed,['native/codex-rollout-collector/src/protocol/target_source.rs','native/codex-rollout-collector/tests/stage4_target_protocol.rs','docs/product/requirements/REQ-20261005-codex-history-save-repair.md','docs/product/plans/PLAN-20261005-codex-history-save-repair.md']);
const binary={path:'native/codex-rollout-collector/target/debug/codex-rollout-collector.exe'};binary.sha256=hash(binary.path);
for(const n of ['branch-5','target-1','fmt-2','req-2','cr-2','diff-1'])assert.equal(JSON.parse(fs.readFileSync(path.join(d,n+'-result.json'),'utf8')).exit_code,0);
const evidence=['bounded-branch-batch','bounded-branch-append-batch'].map(n=>{const p=JSON.parse(fs.readFileSync(path.join(d,'evidence',n+'.json'),'utf8')).payload;assert.equal(p.completeness,'canonical');assert.equal(p.conversation_id,'00000000-0000-4000-8000-000000000002');assert.equal(p.replacements.length,0);assert.ok(!JSON.stringify(p).includes('parent-after-fork'));return{name:n,completeness:p.completeness,conversation_id:p.conversation_id,replacements:p.replacements.length};});
const out={head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),binary,subjects,changed,protectedSubjects,evidence};assert.equal(out.head,base.head);fs.writeFileSync(path.join(d,'self-check.json'),JSON.stringify(out,null,2)+'\n');fs.writeFileSync(path.join(d,'audit.json'),JSON.stringify({binary},null,2)+'\n');
// Copy the original isolated protocol reproducer, keep its original trace intact.
const old=fs.readFileSync('logs/history-save-repair-20261005/s3/review-r1/repro.cjs','utf8');const adapted=old.replace("assert.equal(results[2].result_type,'error');","assert.equal(results[2].completeness,'canonical');");assert.notEqual(old,adapted);fs.writeFileSync(path.join(d,'repro-after.cjs'),adapted);
console.log(JSON.stringify({head:out.head,binary,changed,protectedSubjects:protectedSubjects.length,subjects:subjects.length,evidence}));
