'use strict';
const path=require('path');
if(process.argv[1]&&path.resolve(process.argv[1])===path.resolve('src/server.js')) {
 const inspector=require('node:inspector');
 inspector.open(0,'127.0.0.1',false);
 require('fs').writeFileSync(path.join(__dirname,'private','inspector-url.json'),JSON.stringify({pid:process.pid,url:inspector.url()}),{flag:'wx'});
 inspector.waitForDebugger();
}
