const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s5';
const result=JSON.parse(fs.readFileSync(`${d}/execution-result.json`,'utf8'));
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const checks=JSON.parse(fs.readFileSync(result.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(a=>({path:a.source_path,fixed_matches:hash(a.ref)===a.sha256,live_matches:hash(a.source_path)===a.sha256}));
fs.writeFileSync(`${d}/attachment-readback.json`,JSON.stringify(checks,null,2)+'\n');
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S5'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});
 fs.writeFileSync(`${d}/status-${label}-after.json`,r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);
 const s=JSON.parse(r.stdout);console.log(JSON.stringify({label,lifecycle:s.task?.lifecycle,state:s.step?.state,execution_ref:s.step?.execution_ref,review_status:s.step?.review_status,disposition_ref:s.step?.disposition_ref,next_route:s.next_route,next_step_id:s.next_step_id,issues:s.issues?.length}));
}
console.log(JSON.stringify({recorded:result.recorded,association:result.association,projection:result.projection.status,attachments:checks.length,all_fixed_live_match:checks.every(p=>p.fixed_matches&&p.live_matches)}));
if(!checks.every(p=>p.fixed_matches&&p.live_matches))throw Error('Execution evidence mismatch');
