check('64_original_objects_unchanged',base.files.length===64&&base.files.every(x=>hash(x.path)===x.sha256));
const priorIndexes=['key-857c88fe513282c2114ba4795cbdbc79b11b873e410d8821b987100ae6fe0bba.json','key-34228aaf160940b8653e5db8841d67721660a1dd7743fa5ecfa328361fb6f5bd.json'];
