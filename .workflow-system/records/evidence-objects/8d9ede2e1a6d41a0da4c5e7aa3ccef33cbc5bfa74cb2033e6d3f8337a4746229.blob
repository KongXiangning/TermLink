'use strict';
// Read-only review corroboration: no analyzer, importer, service or device invocation.
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
const dir=__dirname,read=p=>JSON.parse(fs.readFileSync(p,'utf8')),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),checks=[];
function check(id,ok,details){checks.push({id,passed:!!ok,details});}
const execution='.workflow-system/records/events/key-248acd0c7d34961431c8c987339c07919fbf316b12d5d8bcca70cb2061cf37d2.json';
