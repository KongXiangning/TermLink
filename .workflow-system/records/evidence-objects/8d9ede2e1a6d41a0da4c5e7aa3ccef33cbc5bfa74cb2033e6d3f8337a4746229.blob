check('12_prior_execution_review_attachments_unchanged',previous.length===12&&previous.every(x=>hash(x.source_path)===x.sha256&&hash(x.ref)===x.sha256));
const fixtureRoot=path.join(dir,'fixtures-v2'),manifest=read(path.join(fixtureRoot,'manifest.json')),mapping=read(path.join(dir,'shape-mapping.json'));
const prefix=fs.readFileSync(path.join(fixtureRoot,'a-prefix.jsonl')),full=fs.readFileSync(path.join(fixtureRoot,'a-full.jsonl')),childBytes=fs.readFileSync(path.join(fixtureRoot,'c-header.jsonl'));
const a=full.toString('utf8').trim().split('\n').map(JSON.parse),c=JSON.parse(childBytes.toString('utf8').trim());
check('manifest_input_hashes',manifest.files.every(x=>hash(path.join(fixtureRoot,x.name))===x.sha256&&fs.statSync(path.join(fixtureRoot,x.name)).size===x.bytes));
function shape(x){if(x===null)return 'null';if(Array.isArray(x))return x.map(shape);if(typeof x==='object')return Object.fromEntries(Object.entries(x).map(([k,v])=>[k,shape(v)]));return typeof x;}
const originalA=fs.readFileSync(`logs/e2e-validation-20261004/s5/private/c-settled-${manifest.original.A.conversation_id}.jsonl`,'utf8').trim().split('\n').map(JSON.parse);
const originalC=JSON.parse(fs.readFileSync(`logs/e2e-validation-20261004/s5/private/c-settled-${manifest.original.C.conversation_id}.jsonl`,'utf8').split('\n')[0]);
check('14_record_mappings_match_actual_original_and_fixture',mapping.A.length===13&&mapping.A.every(x=>JSON.stringify(shape(originalA[x.original_ordinal]))===JSON.stringify(x.original_shape)&&JSON.stringify(shape(a[x.fixture_ordinal]))===JSON.stringify(x.fixture_shape)&&sha(JSON.stringify(originalA[x.original_ordinal]))===x.original_record_sha256&&sha(JSON.stringify(a[x.fixture_ordinal]))===x.fixture_record_sha256)&&JSON.stringify(shape(originalC))===JSON.stringify(mapping.C.original_shape)&&JSON.stringify(shape(c))===JSON.stringify(mapping.C.fixture_shape)&&sha(JSON.stringify(originalC))===mapping.C.original_record_sha256&&sha(JSON.stringify(c))===mapping.C.fixture_record_sha256);
check('A_prefix_is_exact_and_6_records',full.subarray(0,prefix.length).equals(prefix)&&prefix.toString('utf8').trim().split('\n').length===6);
check('A_v1_v2_byte_identical',['a-prefix.jsonl','a-full.jsonl'].every(n=>hash(path.join(dir,'fixtures',n))===hash(path.join(fixtureRoot,n))));
check('target_turn_correspondence_kept',a[5].payload.type==='task_started'&&a[8].payload.type==='task_complete'&&a[5].payload.turn_id===a[8].payload.turn_id&&a[5].payload.turn_id===manifest.fixture.turn_under_conflict);
check('3_carrier_pairs_id_output_turn_and_missing_call_id',[[2,3],[6,7],[10,11]].every(([i,j])=>a[i].type==='response_item'&&a[i].payload.type==='function_call_output'&&a[j].payload.item.type==='FunctionCallOutput'&&!Object.hasOwn(a[i].payload,'call_id')&&!Object.hasOwn(a[j].payload.item,'call_id')&&a[i].payload.id===a[j].payload.item.id&&a[i].payload.output===a[j].payload.item.output&&a[i].payload.internal_chat_message_metadata_passthrough.turn_id===a[j].payload.turn_id));
check('C_parent_binding_cut_and_protocol_enum_preserved',c.payload.id!==c.payload.history_base.thread_id&&c.payload.id===manifest.fixture.C&&c.payload.history_base.thread_id===manifest.fixture.A&&c.payload.history_base.end_byte_offset===full.length&&c.payload.history_base.end_ordinal_exclusive===13&&full.at(-1)===10&&c.payload.multi_agent_version===originalC.payload.multi_agent_version);
const allowed=new Set(['session_meta','event_msg','task_started','task_complete','item_completed','response_item','function_call_output','FunctionCallOutput','model','create_thread','send_message_to_thread','codex_app','vscode','agent_created_thread','agent_forked_thread','disabled','paginated','default','v1','v2','C:/sanitized-fixture','0.0.0','0000000000000000000000000000000000000000','https://example.invalid/sanitized']);
let leaves=0;function privacy(v){if(v===null||typeof v==='boolean'||typeof v==='number')return true;if(Array.isArray(v))return v.every(privacy);if(typeof v==='object')return Object.values(v).every(privacy);leaves++;return allowed.has(v)||/^00000000-0000-4000-8000-\d{12}$/.test(v)||/^2026-10-0[34]T00:00:\d{2}\.000Z$/.test(v)||/^\[sanitized (text|delegation [123])\]$/.test(v);}
check('fixture_string_content_is_allowlisted',privacy(a)&&privacy(c),{string_leaves:leaves});
const first=read(path.join(dir,'run-1/failure.json')),second=read(path.join(dir,'run-2/result.json'));
check('initial_failed_command_and_H1_H3_checks_retained',first.checks.length===14&&first.checks.slice(0,13).every(x=>x.passed)&&first.checks[13].passed===false&&first.error.message==='H2 missing catalog parent before batch');
check('H1_saved_actual_rejection_and_partial_control',first.requests[1].importer_errors[0].message==='mutation evidence conflicts with an existing staged mutation'&&first.requests[1].error.code==='batch_rejected'&&first.requests[1].error.details.rejection_code==='batch_scope_conflict'&&first.requests[2].complete.completeness==='partial');
check('H3_saved_all6_type_specific_gaps',first.requests[2].batch.gaps.length===6&&first.requests[2].batch.gaps.filter(x=>x.message==='missing_required_field:response_item/function_call_output').length===3&&first.requests[2].batch.gaps.filter(x=>x.message==='missing_required_field:event_msg/item_completed').length===3);
check('H2_corrected_focused_actual_failure',second.passed===5&&second.total===5&&second.checks.every(x=>x.passed)&&second.requests.length===1&&second.requests[0].batch_count===0&&second.requests[0].error.code==='analysis_failed'&&second.requests[0].error.message==='parent rollout is missing from catalog: '+manifest.fixture.A);
function state(p){const names=fs.readdirSync(p).filter(x=>x.endsWith('.json'));return read(path.join(p,names[0]));}
const seeded=state(path.join(dir,'run-1/seeded-analysis')),fresh=state(path.join(dir,'run-1/fresh-analysis'));
check('actual_durable_seed_control_receipts_and_no_canonical',seeded.staging.length===1&&seeded.receipts.length===1&&seeded.staging[0].persisted===true&&fresh.staging.length===1&&fresh.receipts.length===1&&fresh.staging[0].persisted===true&&fresh.canonical===false);
