const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4';
const result=JSON.parse(fs.readFileSync(d+'/execution-result.json','utf8'));
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const manifest=JSON.parse(fs.readFileSync(result.ref.replace('/events/','/attachments/'),'utf8'));
const checks=(manifest.attachments||manifest.files).map(p=>({path:p.source_path,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));
fs.writeFileSync(d+'/attachment-check.json',JSON.stringify(checks,null,2)+'\n');
const statuses={};
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S4'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});
 fs.writeFileSync(d+'/status-'+label+'-after.json',r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);
 const s=JSON.parse(r.stdout);statuses[label]={task:s.task,step:{id:s.step.id,state:s.step.state,execution_ref:s.step.execution_ref,review_status:s.step.review_status,disposition_ref:s.step.disposition_ref},next_route:s.next_route,next_mode:s.next_mode,next_step_id:s.next_step_id,issues:s.issues.length};
}
const check={recorded:result.recorded,association:result.association,projection:result.projection.status,ref:result.ref,attachments:checks.length,all_fixed_live_match:checks.every(p=>p.fixed_matches&&p.live_matches),statuses};
fs.writeFileSync(d+'/management-check.json',JSON.stringify(check,null,2)+'\n');console.log(JSON.stringify(check));
