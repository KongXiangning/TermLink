const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4';
const baseline=JSON.parse(fs.readFileSync(d+'/baseline.json','utf8'));
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
if(head!==baseline.head)throw Error('Execution HEAD changed');
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const source=JSON.parse(fs.readFileSync(d+'/source-after.json','utf8'));
if(!source.every(p=>hash(p.path)===p.sha256))throw Error('Execution source changed');
const names=['final-node','existing-initial','v2-initial','existing-and-v2','protection-and-recovery','old-partial-v2','partial-growth','projection-guards','paired-negatives','req-final','cr-final','req-pwsh-final','cr-pwsh-final','diff-check-final'];
const commands=names.map(name=>{const r=JSON.parse(fs.readFileSync(`${d}/${name}-result.json`,'utf8'));return{command:r.command,environment:r.environment,result:`exit${r.exit_code}`,report_ref:`${d}/${name}.txt`};});
if(JSON.parse(fs.readFileSync(d+'/final-node-result.json','utf8')).exit_code!==0)throw Error('Final validation not passed');
const collect=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(p=>p.isDirectory()?collect(dir+'/'+p.name):[dir+'/'+p.name]);
const files=[...baseline.before.map(p=>p.path),'docs/changes/records/CR-20261006-0200-shared-history-node-consumer.md',
 'native/codex-rollout-collector/tests/fixtures/current/delegated-context.jsonl',
 'logs/history-save-repair-20261005/s1/repair-r1/run-1/seeded-analysis/9f09fea249cf87ec5a16f0440db7b935482e142957fb4e5ffdfaa68f138c05b5.json',
 ...collect(d).filter(p=>!p.endsWith('/execution-input.json')&&!p.endsWith('/execution-result.json'))];
const input={action:'execution',task_id:'task-7ff69ba8242c90c52f0b93fa1144a655',
 plan_ref:'.workflow-system/records/events/key-81e218c75e20e038114c3745822b65db24660581f4d7f6b2751a5bbba3ca7d4e.json',step_id:'S4',mode:'default',source_revision:head,
 result:'S4 Node implemented;final scoped180/180 PASS;actual Rust/File staging/recovery verified;pending change review/finish;H1/H3 SQLite/provider reopening remains S5',
 decision_source:'Current human execute-step invocation TASK-20260833 S4 and adopted precise shared compatibility plan',
 decision_text:'[$execute-step](E:\\coding\\TermLink-rust-source-resolution-codex\\.agents\\skills\\execute-step\\SKILL.md) 833 s4',
 summary:{implementation:'Four local Node files:strict DelegatedInput/system role/public profile,immutable facts plus G1/G2 durable proof/FNV recomputation/stable representative;original run hello/profile recovery and fresh v2 four-empty backfill',
 qualification:'Implementation self-check,not formal review or finish;new role/product payload assertions use productStore callbacks,not H1/H3 SQLite/provider proof;existing productflow PASS remains its own scenarios',
 scope:'Node four src/two existing tests/REQ/PLAN/new draft CR;Rust/vendor/source/governance/IPC/Android/DB schema and budgets unchanged;no Git writes/service/device effects',
 baseline:'HEAD7ce1d08;S3 already clean/finished;S4 not-started before;existing untracked vendor Cargo.lock preserved'},
 commands,
 remaining_work:['S4 formal change review and step finish not performed','S5 H1/H3 actual product transaction and provider reopen body/real tool details;new scenario not proven by existing productflow','832 active/S2 unchanged;Branch and three real-host/phone switch/reopen acceptance remain;explicit return after833','S2 vendor offline failure and three old management association gaps retained;no full Node/Rust suite or independent review'],
 files:[...new Set(files)],idempotency_key:'task20260833-S4-node-history-consumer-execution-20261006-v1'};
fs.writeFileSync(d+'/execution-input.json',JSON.stringify(input,null,2)+'\n');
const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});
fs.writeFileSync(d+'/execution-result.json',r.stdout);
if(r.status!==0){fs.writeFileSync(d+'/execution-error.txt',r.stderr);throw Error(r.stderr||r.stdout);}
const result=JSON.parse(r.stdout);console.log(JSON.stringify({recorded:result.recorded,ref:result.ref,association:result.association,projection:result.projection,attachments:input.files.length}));
