  "task": {
    "task_id": "task-7ff69ba8242c90c52f0b93fa1144a655",
    "display_id": "TASK-20260833",
    "title": "委派输入与正常历史增长的最小共享兼容修复（Rust契约先行）",
    "lifecycle": "active",
    "lifecycle_ref": ".workflow-system/records/events/key-c9ee87ca72baea443b6cb1d53f14387af5407d633ad8cdf5988b80c0be34ff1d.json",
    "adopted_plan_ref": ".workflow-system/records/events/key-81e218c75e20e038114c3745822b65db24660581f4d7f6b2751a5bbba3ca7d4e.json",
    "plan_status": "adopted",
    "plan": {
      "title": "委派输入与正常历史增长的最小共享兼容修复（Rust契约先行）",
      "goal": "让真实create_thread/send_message委派输入按正确业务身份保存，并允许有来源证据的同turn正常开始→完成更新；严格保留真实冲突/未知/partial/旧canonical保护。交付稳定Rust契约与现有Node局部consumer、隔离产品持久化证据，再回到TASK-20260832进行分支定位和真实宿主/手机三场景验收。",
      "acceptance": [
        "两种真实委派carrier、create_thread/send_message分别有脱敏形状/身份/turn关联证据；不造call_id，不当普通user/assistant或本地tool，不用Diagnostic代替业务正文。",
        "相同nativeitem_id双carrier和overlap/retry/restart只生成一个正确逻辑委派项，保留两份物理来源；内容/归属冲突与未知/畸形输入仍typedpartial/fail-closed。",
        "共享AnalysisEvent字段、能力/version/checkpoint/旧consumer策略先审查固定；新Rust不向不支持的新consumer静默发送无法验证的事件并宣称canonical。无新analyze mode/产品revision/epoch/worker。",
        "H1实际prefix→增长样本在旧durablestaging存在时正确处理合法生命周期演进；同event内容变更、source/scope不一致、旧request和canonical降级仍拒绝，旧failedruns/receipts/intents保持。",
        "完整backfill与deltaappend的更新证据分别定义并回归，不凭ordinal/hash/更高completeness猜测合法替换；如果无法证明，仍拒绝并明确剩余问题。",
        "旧partial/ParseGap在新解析兼容下的普通重读、旧checkpoint拒绝/恢复和canonical投影资格必须分别取证；不能删除旧诊断或清库让新版本通过。",
        "Spike→formal相同最小vendorpatch、manifests与closure/许可证来源可核对；普通带call_id工具输出旧路径通过；无本机外部Codex依赖/default网络下载。",
        "Rust独立步骤不改Node/App/DB/IPC；Node步骤仅现有schema/importer/presentation，保持一条Node→Rust链和正式module/process入口。",
        "委派内容使用现有genericproductrows/eventFacts及正确role/presentation保留正文，无新增产品DBschema；如确需Android/Gateway修改，明确文件/实际行为并另行准备，不静默扩本task。",
        "隔离actualRust→durablestaging/positiveACK→validatedcomplete→临时产品SQLitetransaction→productprovider读回的身份/正文及真实工具详情分别成立；fixture/mock不是手机验收。",
        "新普通对话/Branch/委派全部真实宿主和指定手机切换重开验收仍归TASK-20260832；本task不得用isolatedPASS替代三个业务目标。",
        "每批真实REQ/PLAN/CR同步，未提交draft/真实未提交，不造activecommit_ref；最终保留未解决项、版本/失败与测层，审查clean/finished/closed非业务PASS。"
      ],
      "scope": [
        "共享最小事件和合并语义的独立契约范围；以S1和S2证据为基础，协议候选名称不当既定事实。",
        "Rust候选：model/analysis_event.rs、analysis.rs、codex_adapter、wire facade/profile、target_data/mapping/runtime的实际必要处。",
        "仓库内Spike/formalvendorprotocol models/items必要patch与两份manifest、Spikecodex_decode；先确定确切closure影响，不预定全量upstream升级。",
        "Node候选：existinganalyzerProtocol.js和analysisBatchImporter.js；产品presentation仅现有泛化payload字段，不改产品DBschema。",
        "现有stage3/stage4及Nodecollector/realRust/productflow聚焦回归；扩展能检出原缺陷和保护真实冲突的断言，不新造通用框架。",
        "已确认新目标的REQ/PLAN/CR，最小共享data/wire/architecture/coordinator文档；CONTRACTS/DECISIONS实际修改须遵守治理写入边界及精确已确认范围，不改变IPCfreeze。"
      ],
      "exclusions": [
        "不做整个Node4.5迁移，不新增协议mode/产品epoch/对象revision/commitFence/多writer/第二collector。",
        "不改IPC/follower/subscription/owner/Androidauthority/A-B isolation，不改Android/Gateway/UI或DBschema；必要扩大另行明确。",
        "不修H2source/discovery/Branch继承定位；保留为TASK-20260832依赖后的Rust步骤，与本task不重复实施。",
        "不把委派变普通user/assistant，不伪造call_id/native关系、canonical/DTO/ACK，不忽略未知或放宽所有upsert。",
        "不编辑外部rollout/真实DB，不清旧staging/cache/failedrun/intent/receipt来制造通过；不放宽资源或retention预算。",
        "不生成真实聊天/Branch/委派回合、不启动本地服务或操作真机；真实E2E副作用仅在原task的已确认预算内。",
        "不自动stage/commit/push/deploy/release，不关闭/暂停/切换原task焦点；当前prepare不授权实现或改共享契约。"
      ],
      "steps": [
        {
          "id": "S1",
          "title": "固定最小共享事件、更新证明与兼容契约",
          "environment": [
            "S1三问题诊断与脱敏包、TASK-20260832/S2范围",
            "当前架构/CONTRACTS/AD-004/018/019/020/021/022",
            "只读Rust与现有Nodeconsumer"
          ],
          "actions": [
            "联合对照生产/消费模型，固定DelegatedInput候选字段、逻辑/物理身份、两carrierturn/text冲突与正确presentation。",
            "固定真实生命周期更新允许条件，区分同event篡改和后来完成事件；完整backfill/deltaappend分别证明，不单方选择放宽规则。",
            "固定hello/version/旧consumer/旧checkpoint/旧partialParseGap恢复策略；确切schema和能力名必须有依据，不预先猜测。",
            "列确切文件/测试/doc影响，确认仍未覆盖的共享变更一次；此前同target/action/后果的明确决定不重复询问。",
            "正式修改契约前依据项目治理写入边界更新必要来源，真实新增REQ/PLAN绑定用户目标，不改历史done需求为新修复已完成。"
          ],
          "validation": [
            "字段/方向/兼容/错误/证据完整可审阅，保持单例/三mode/外部源只读和模块次序。",
            "无强制App/DB/IPC扩展；需要时保存缺口并另立范围。"
          ],
          "outputs": [
            "精确共享契约与范围决定",
            "REQ/PLAN关联及必要契约/决策更新记录，未实现状态真实"
          ]
        },
        {
          "id": "S2",
          "title": "Spike验证并同步最小wire兼容闭包",
          "environment": [
            "仓库内Spikevendor",
            "原形状脱敏两carrier及普通call_id样本",
            "隔离编译/fixture，非真实服务"
          ],
          "actions": [
            "仅已确认typedvendorpatch支持实际两carrier；不在facade自定义重复wire模型。",
            "普通带call_id输出保持原语义，未知namespace/name/output形状明确拒绝/partial。",
            "先Spike解码/conformance再同源promotion至formal，两manifest登记实际patch/closure/hash，保留LICENSE/NOTICE和真实upstreamrevision。"
          ],
          "validation": [
            "两carrier分别解码正确，正常旧工具/missingidentity/unknown负向保护成立。",
            "实际cargo依赖图仅仓库内Codexclosure；不能用默认构建下载或外部checkout。"
          ],
          "outputs": [
            "wire兼容fixture与最小patch/来源证据",
            "Spike→formalpromotion记录，Rust未修改Node"
          ]
        },
        {
          "id": "S3",
          "title": "实现Rust委派事件、归约与target兼容",
          "environment": [
            "已固定共享契约及Spike验证closure",
            "formalRustcrate及既有stage3/stage4回归",
            "隔离process"
          ],
          "actions": [
            "Adapter唯一映射typedcarrier到正确TermLink-owned委派事件，保留nativeidentity与来源/turn。",
            "Reducer/projection对双carrier和重复读取幂等，不生成本地tool，不把未知Gap升canonical。",
            "落实targetvalidation/checkpoint/capability及旧consumer策略，必要producer表示调整仅按确认契约。",
            "同步RustCR/PLAN和稳定Nodehandoff说明，不在此步改Node。"
          ],
          "validation": [
            "两carrier/create_thread/send_message及unknown/mismatch/partial/overlap/retry/restart聚焦conformance通过。",
            "资源、身份、canonicalcoverage、normal工具及abort保护未变。"
          ],
          "outputs": [
            "Rust事件/target修复及实际binary/hash/回归",
            "现有Nodeconsumer的确切stablecontract说明"
          ]
        },
        {
          "id": "S4",
          "title": "现有Node按契约保存委派并纠正有证据的增长合并",
          "environment": [
            "S3稳定Rustbinary",
            "existingNodecollector/importer/protocol",
            "独立FileAnalysisStore和临时SQLite"
          ],
          "actions": [
            "支持精确新事件schema和协商；正确产品role/presentation保存正文，优先复用既有eventFacts。",
            "只按共享证据规则修H1preflight/merge，不改event_id/epoch、不无条件放宽upsert或清旧state。",
            "验证旧partial/diagnostic/checkpoint普通重读与恢复，保留历史失败/旧canonical。",
            "同步独立NodeCR/PLAN，仅确切consumer局部文件，不全量4.5迁移。"
          ],
          "validation": [
            "S1真实形状prefix→增长在旧staging上可成功，真实内容/scope/旧attempt/降级仍拒绝。",
            "重试/overlap/重启幂等；正文/工具细节可追溯，未支持功能仍显式partial。"
          ],
          "outputs": [
            "Node局部修复及receipt/checkpoint/合并证据",
            "H1/H3分别修复或未解决判定"
          ]
        },
        {
          "id": "S5",
          "title": "验证隔离产品保存并交回三场景业务验收",
          "environment": [
            "实际Rust/Node版本和临时产品SQLite",
            "existingproductprovider/Gateway集成测试入口",
            "不启动真实服务/聊天或操作手机"
          ],
          "actions": [
            "用已有realRust/productflow回归证明durablebatch/ACK、Rustcomplete、产品transactionCOMMIT/provider读回和内容身份。",
            "分别保留ordinary/委派负向及详情/reopen/旧canonical保护，无法闭合项明确failed/partial。",
            "整理稳定契约、修复文件、binary/schema/兼容结论，交回TASK-20260832，不自行执行其S3/S5/S6或结束它。"
          ],
          "validation": [
            "H1/H3各自成功或明确未解决；不以mock或一个普通样本代替委派。",
            "原task三项真实业务验收、H2定位及指定手机durableACK/重开仍显式未验，不重复预算。"
          ],
          "outputs": [
            "共享兼容修复交付矩阵与handoff",
            "REQ/PLAN/CR实际进度及当前taskstatus，不把处置当PASS"
          ]
        }
      ],
      "validation_strategy": "Minimum-sufficient: reuseexistingstage3/stage4modulefixtures andNodecollectorrealRustproductflow; addonly originalfailure-detector andcriticalnegative/idempotence. Exactselectors inconfirmedstep, no preparationtests/fullsuite/device/modelturn. TemporaryDB/store/files only, originalevidence readonly.",
      "source_scope_ref": "logs/history-save-repair-20261005/s2/scope.md",
      "source_decision": "Direct human choice toprepare separate minimalsharedcontractcompatibility, notadoption",
      "original_task": "TASK-20260832",
