'use strict';
// Read retained evidence only. Never invoke the original capture/restart scripts.
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{spawnSync}=require('node:child_process');
const dir=__dirname,priv=path.join(dir,'private');
const execution='.workflow-system/records/events/key-80adab6cdb9d564d9c2d729f2e0415a0b66e64d0871efb83c8bc599215602030.json';
const A='01a0fe25-56a2-7910-ba22-61e8016e8ad9',B='01a0ee4c-9088-7d83-a15d-43f724f03a1a',F='01a0ee04-a775-72b3-bd07-04aac804a3b4';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=p=>JSON.parse(fs.readFileSync(p,'utf8')),json=n=>read(path.join(dir,n));
const stable=v=>Array.isArray(v)?v.map(stable):v&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,stable(v[k])])):v;
async function main(){
  const output={at:new Date().toISOString(),scope:'Read-only retained-evidence self-review; checks are not new E2E tests',execution_ref:execution,execution_sha256:sha(fs.readFileSync(execution)),checks:[]};
  const check=(name,ok)=>output.checks.push({name,ok:!!ok});
  const event=read(execution),obs=json('observations.json'),pres=json('preservation.json');
  check('execution payload digest intact',sha(JSON.stringify(stable(event.payload)))===event.payload_sha256);
  check('exact S4 and source revision',event.payload.request.step_id==='S4'&&event.payload.request.source_revision==='19bf3121203ba17ad21147ffe02877d50a22d4a0');
  const manifest=read('.workflow-system/records/attachments/key-80adab6cdb9d564d9c2d729f2e0415a0b66e64d0871efb83c8bc599215602030.json');
  output.attachments=manifest.attachments.map(a=>{const blob=fs.readFileSync(a.ref),local=fs.readFileSync(a.source_path);return {source_path:a.source_path,sha256:a.sha256,size:a.size,ok:a.status==='saved'&&blob.length===a.size&&sha(blob)===a.sha256&&blob.equals(local)};});
  check('all ten original attachments byte-identical to CAS',output.attachments.length===10&&output.attachments.every(a=>a.ok));
  check('original 13 plus 4 self-check predicates passed, not E2E certification',obs.assertions.length===13&&obs.assertions.every(c=>c.ok)&&pres.checks.length===4&&pres.checks.every(c=>c.ok));
  const host=json('host-terminal.json').response.turns;
  check('two S4 delegated turns, commands completed exit zero',host.length===2&&host.every(t=>t.status==='completed'&&t.items.filter(i=>i.type==='commandExecution').length===1&&t.items.filter(i=>i.type==='commandExecution').every(i=>i.exitCode===0)));
  const t3=host.find(t=>t.id==='01a10308-856d-7072-85db-f5e5b5c4f81a'),window=json('restart-window.json');
  const stop=window.find(e=>e.args?.includes('stop')),start=window.find(e=>e.args?.includes('start'));
  check('second actual restart wholly inside same A3 turn',Date.parse(stop.at)>t3.startedAt*1000&&Date.parse(start.ended_at)<t3.completedAt*1000&&window.every(e=>e.exit===0));
  const switching=['a2-return','node-offline'].flatMap(n=>fs.readFileSync(path.join(priv,n+'-logcat.txt'),'utf8').split('\n')).filter(l=>l.includes('[ipc][surface-snapshot]'));
  const healthy=(l,id,status)=>l.includes(`conv=${id} activeConv=${id}`)&&l.includes(`status=${status}`)&&l.includes('applied=true')&&l.includes('desynced=false authority=IPC_AUTHORITATIVE');
  check('retained log supports healthy A running, B completed, A running return',switching.some(l=>healthy(l,A,'running'))&&switching.some(l=>healthy(l,B,'completed'))&&switching.some(l=>l.includes('02:28:30.825')&&healthy(l,A,'running')));
  const recovery=fs.readFileSync(path.join(priv,'a3-restored-logcat.txt'),'utf8').split('\n').filter(l=>l.includes('[ipc][surface-snapshot]'));
  check('A3 healthy running both sides and completed after outage',recovery.some(l=>l.includes('02:31:19')&&healthy(l,A,'running'))&&recovery.some(l=>l.includes('02:31:50')&&healthy(l,A,'running'))&&recovery.some(l=>l.includes('02:31:54')&&healthy(l,A,'completed')));
  const xml=n=>fs.readFileSync(path.join(priv,n+'.xml'),'utf8');
  check('stale error candidate preserved, reopen clears banner',xml('terminal').includes('unexpected end of stream')&&xml('terminal').includes('已连接')&&xml('foreground').includes('unexpected end of stream')&&!xml('reopened').includes('unexpected end of stream')&&xml('reopened').includes('E2E-S4-A3-DONE'));
  check('saved product snapshot digest matches original observation',sha(fs.readFileSync(path.join(priv,'product-final.sqlite')))===obs.product.sha256);
  const SQL=await require('sql.js')();
  const open=p=>{const d=new SQL.Database(fs.readFileSync(p));d.run('PRAGMA query_only=ON');return d;};
  const rows=(d,q)=>{const r=d.exec(q)[0];return r?r.values.map(v=>Object.fromEntries(r.columns.map((c,i)=>[c,v[i]]))):[];};
  const product=open(path.join(priv,'product-final.sqlite')),oldProduct=open('logs/e2e-validation-20261003/s3/private/product-current.sqlite');
  const canonical=d=>rows(d,'SELECT * FROM history_items ORDER BY conversation_id,item_key');
  check('canonical history unchanged and A product tables still zero',JSON.stringify(canonical(product))===JSON.stringify(canonical(oldProduct))&&['conversations','history_items','tool_details','analysis_checkpoints','publication_receipts'].every(t=>rows(product,`SELECT count(*) n FROM ${t} WHERE conversation_id='${A}'`)[0].n===0));
  const oldPhone=open(path.join(priv,'before/databases/codex_conversations.db')),phone=open(path.join(priv,'reopened/databases/codex_conversations.db'));
  const prev=rows(oldPhone,'SELECT * FROM items ORDER BY conversation_id,item_key'),now=rows(phone,'SELECT * FROM items ORDER BY conversation_id,item_key'),map=new Map(now.map(r=>[r.conversation_id+'\0'+r.item_key,r]));
  check('1689 to 2351 retained phone rows, no old deletion, F unchanged',prev.length===1689&&now.length===2351&&prev.every(r=>map.has(r.conversation_id+'\0'+r.item_key))&&JSON.stringify(prev.filter(r=>r.conversation_id===F))===JSON.stringify(now.filter(r=>r.conversation_id===F)));
  check('A partial fallback, no A marker in other partitions',rows(phone,`SELECT item_count,complete,provider_mode FROM conversations WHERE conversation_id='${A}'`).some(r=>r.item_count===8&&r.complete===0&&r.provider_mode==null)&&!now.some(r=>r.conversation_id!==A&&JSON.stringify(r).includes('E2E-S4-A')));
  const pages=rows(phone,'SELECT * FROM sync_completed_pages ORDER BY sync_id,sequence,page_index');
  const ids=['e4392a2c-a261-4b35-856c-b6984365c9a3','0cff4ebc-61e1-448d-8467-ef1995503cae','d5e17c07-55a0-43bd-a81b-180cac076033'];
  output.finding_counterevidence={id:'S4-R1',columns:rows(phone,'PRAGMA table_info(sync_completed_pages)').map(r=>r.name),retained_page_count:pages.length,original_summary_page_count:obs.phone_pages.length,reopened_capture_at:json('reopened.json').observed_at,syncs:ids.map(id=>({sync_id:id,retained_rows:pages.filter(r=>r.sync_id===id),server_ack:obs.server_diagnostics.filter(r=>r.event==='server.codex.history.ack_received'&&r.fields?.syncId===id&&r.fields.ok===true)})),qualification:'Missing third page in this snapshot is not proof of commit failure. Server ACK and retained completed-page evidence remain distinct; no post-commit capture rerun.'};
  check('reproduce reporting defect: no conversation_id column but 225 pages and empty summary',!output.finding_counterevidence.columns.includes('conversation_id')&&pages.length===225&&obs.phone_pages.length===0);
  check('two cited syncs have actual durable rows, third only saved ACK in this snapshot',output.finding_counterevidence.syncs.slice(0,2).every(s=>s.retained_rows.length===1&&s.server_ack.length>0)&&output.finding_counterevidence.syncs[2].retained_rows.length===0&&output.finding_counterevidence.syncs[2].server_ack.length>0);
  const runDir='logs/task005-s2-repair-runtime-2/data/codex-rollout-runs';
  check('retained run bytes match observations including recorded failures',obs.runs.every(r=>sha(fs.readFileSync(path.join(runDir,r.file)))===r.sha256)&&obs.new_runs.length===18&&obs.new_runs.filter(r=>r.conversation_id===A&&r.status==='failed').length===8);
  const git=args=>{const r=spawnSync('git',args,{encoding:'utf8',windowsHide:true});if(r.status!==0)throw Error(r.stderr);return r.stdout.trim();};
  output.git={head:git(['rev-parse','HEAD']),tracked_diff:git(['diff','--name-only']),index_diff:git(['diff','--cached','--name-only'])};
  check('review leaves source/tracked/index untouched at target HEAD',output.git.head===event.payload.request.source_revision&&!output.git.tracked_diff&&!output.git.index_diff);
  for(const d of [product,oldProduct,oldPhone,phone])d.close();
  output.failed_checks=output.checks.filter(c=>!c.ok).map(c=>c.name);
  fs.writeFileSync(path.join(dir,process.argv[2]||'review-20261004-checks.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});
  console.log(JSON.stringify({checks:output.checks.length,failed_checks:output.failed_checks,counterevidence:output.finding_counterevidence},null,2));
  if(output.failed_checks.length)process.exitCode=1;
}
main().catch(e=>{console.error(e.stack);process.exitCode=1;});
