'use strict';
const fs=require('node:fs'),path=require('node:path'),{spawnSync}=require('node:child_process');
const out=__dirname,events=[];const save=()=>fs.writeFileSync(path.join(out,'restart-window.json'),JSON.stringify(events,null,2)+'\n',{flag:'wx'});
function cmd(exe,args,env){const at=new Date().toISOString();const r=spawnSync(exe,args,{encoding:'utf8',windowsHide:true,timeout:45000,env:env||process.env});events.push({at,ended_at:new Date().toISOString(),exe,args,exit:r.status,stdout:r.stdout,stderr:r.stderr});if(r.status!==0)throw Error(`${exe} exit ${r.status}`);return r.stdout;}
const adb=args=>cmd('adb',['-s','MQS7N19402011743',...args]);
const capture=p=>cmd(process.execPath,[path.join(out,'capture.cjs'),p]);
async function main(){try{
const pid=adb(['shell','pidof','com.termlink.app']).trim();let found=false;const end=Date.now()+25000;
while(Date.now()<end){const r=spawnSync('adb',['-s','MQS7N19402011743','logcat','--pid='+pid,'-d','-v','brief'],{encoding:'utf8',windowsHide:true,timeout:5000});const text=r.stdout||'';if(text.includes('E2E-S4-A3-BEGIN')&&text.includes('status=running')){found=true;break;}await new Promise(r=>setTimeout(r,500));}
// Text body may be omitted from diagnostics: require current running authority after latest turn start.
if(!found){const r=spawnSync('adb',['-s','MQS7N19402011743','logcat','--pid='+pid,'-d','-v','brief'],{encoding:'utf8',windowsHide:true,timeout:5000});const lines=(r.stdout||'').split('\n').filter(l=>l.includes('[ipc][surface-snapshot]')&&l.includes('conv=01a0fe25-56a2-7910-ba22-61e8016e8ad9'));if(!lines.at(-1)?.includes('status=running'))throw Error('No current running A authority; restart not attempted');}
adb(['shell','input','keyevent','KEYCODE_WAKEUP']);capture('a3-before-restart');
const helper='.agents/skills/local-dev-server-control/scripts/manage-local-dev-server.ps1';const common=['-NoProfile','-ExecutionPolicy','Bypass','-File',helper,'-ProjectRoot',process.cwd()];
cmd('powershell',[...common,'-Action','stop']);capture('a3-offline');
const env={...process.env,TERMLINK_PERSISTENT_ROOT:path.resolve('logs/task005-s2-repair-runtime-2'),TERMLINK_CODEX_ROLLOUT_ANALYZER_PATH:path.resolve('native/codex-rollout-collector/target/debug/codex-rollout-collector.exe'),TERMLINK_HISTORY_RANGE_SEGMENTS:'1'};
cmd('powershell',[...common,'-Action','start'],env);adb(['shell','input','keyevent','KEYCODE_WAKEUP']);capture('a3-restored');
}catch(e){events.push({error:e.message,at:new Date().toISOString()});process.exitCode=1;}finally{save();console.log(JSON.stringify(events.map(e=>({at:e.at,ended_at:e.ended_at,exe:e.exe,exit:e.exit,error:e.error}))));}}
main();
