const fs=require('fs'),path=require('path'),cp=require('child_process'),assert=require('node:assert/strict'),readline=require('readline');
const d=__dirname,root=path.join(d,'sources'),fixture='native/codex-rollout-collector/tests/fixtures/branch-history';
const parent='00000000-0000-4000-8000-000000000001',child='00000000-0000-4000-8000-000000000002';
const dir=path.join(root,'2026/10/04');fs.mkdirSync(dir,{recursive:true});
fs.copyFileSync(`${fixture}/a-full.jsonl`,path.join(dir,`rollout-2026-10-04T00-00-00-${parent}.jsonl`));
fs.copyFileSync(`${fixture}/c-header.jsonl`,path.join(dir,`rollout-2026-10-04T00-01-00-${child}.jsonl`));
const audit=JSON.parse(fs.readFileSync(path.join(d,'audit.json'),'utf8'));
async function run(id,limits,label){
 const p=cp.spawn(audit.binary.path,['--startup-config-version','1','--sessions-root',root],{stdio:['pipe','pipe','pipe']});let stderr='';p.stderr.on('data',c=>stderr+=c);const trace=[];
 const send=v=>{trace.push({direction:'input',message:v});p.stdin.write(JSON.stringify(v)+'\n');};
 const result=await new Promise((resolve,reject)=>{const timer=setTimeout(()=>{p.kill();reject(Error('timeout'));},15000);p.on('error',reject);
 const rl=readline.createInterface({input:p.stdout});rl.on('line',line=>{let v;try{v=JSON.parse(line);}catch(e){reject(e);return;}trace.push({direction:'output',message:v});
 if(v.message_type==='hello')send({protocol_version:1,message_type:'analyze',request_id:label,job_id:'review-job-'+label,conversation_id:id,mode:'backfill',...(limits?{resource_limits:limits}:{})});
 if(v.message_type==='batch')send({protocol_version:1,message_type:'ack',request_id:label,job_id:v.job_id,segment_id:v.segment_id,batch_id:v.batch_id,accepted:true,persisted:true});
 if(v.message_type==='complete'||v.message_type==='error'){clearTimeout(timer);p.stdin.end();resolve(v);}
 });send({protocol_version:1,message_type:'hello',request_id:'review-hello-'+label,role:'node',capabilities:['analyze_v1','cancel','checkpoint','ack','history_semantics_v2']});
 });
 await new Promise(resolve=>p.on('close',resolve));fs.writeFileSync(path.join(d,label+'-trace.json'),JSON.stringify({binary:audit.binary,limits,result,trace,stderr},null,2)+'\n');
 const batch=trace.find(v=>v.direction==='output'&&v.message.message_type==='batch')?.message;
 return{label,result_type:result.message_type,error_code:result.code||result.error_code,error_message:result.message,completeness:batch?.payload.completeness};
}
(async()=>{const limits={max_decoded_bytes:65536,max_segment_bytes:4096,max_line_bytes:2048};
 const results=[];results.push(await run(parent,limits,'parent-bounded'));results.push(await run(child,null,'branch-default'));results.push(await run(child,limits,'branch-bounded'));
 fs.writeFileSync(path.join(d,'repro-result.json'),JSON.stringify({results,sourceBytes:fs.statSync(path.join(dir,`rollout-2026-10-04T00-00-00-${parent}.jsonl`)).size,qualification:'Isolated sanitized source copies and current Rust process; test protocol ACK only, no Node/product/device/real source write'},null,2)+'\n');console.log(JSON.stringify(results));
 assert.equal(results[0].completeness,'canonical');assert.equal(results[1].completeness,'canonical');assert.equal(results[2].completeness,'canonical');
})().catch(e=>{console.error(e);process.exitCode=1;});
