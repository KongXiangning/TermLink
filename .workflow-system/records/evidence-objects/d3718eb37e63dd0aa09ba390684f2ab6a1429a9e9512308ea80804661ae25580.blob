'use strict';
// Review retained files only. No network, adb, source, product or phone writes.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { execFileSync } = require('node:child_process');
const out = __dirname;
const root = process.cwd();
const cid = '01a0fe25-56a2-7910-ba22-61e8016e8ad9';
const turn = '01a0fe25-654b-7c40-b815-1848c9c56744';
const op = 'exec-f763bc43-72ba-4d9a-853d-1ce04ecbdd3a';
const ref = '.workflow-system/records/events/key-5f905bc784d5c8156da8bd91a6a9029ea02f7a52389aa6e88dab9d67b85aebf9.json';
const sha = v => crypto.createHash('sha256').update(v).digest('hex');
const stable = v => Array.isArray(v) ? v.map(stable) : v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort().map(k => [k, stable(v[k])])) : v;
const read = n => fs.readFileSync(path.join(out, n));
const json = n => JSON.parse(read(n));
const jsonl = n => read(n).toString('utf8').trim().split(/\r?\n/).filter(Boolean).map(JSON.parse);
const checks = [];
const check = (name, pass) => checks.push({ name, pass: Boolean(pass) });
async function main() {
  const eventBytes = fs.readFileSync(path.join(root, ref));
  const event = JSON.parse(eventBytes);
  check('immutable execution payload digest', sha(JSON.stringify(stable(event.payload))) === event.payload_sha256);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, ref.replace('/events/', '/attachments/'))));
  check('all four attached blobs match preserved digest/size and local evidence', manifest.attachments.length === 4 && manifest.attachments.every(a => {
    const blob = fs.readFileSync(path.join(root, a.ref));
    return blob.length === a.size && sha(blob) === a.sha256 && sha(fs.readFileSync(path.join(root, a.source_path))) === a.sha256;
  }));
  const head = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
  check('reviewed HEAD matches execution', head === 'ee5d491204f9c684b8c90cb2a5ae60943db9f026');
  check('no tracked working tree or index changes', execFileSync('git', ['diff', '--name-only'], { encoding: 'utf8' }).trim() === '' && execFileSync('git', ['diff', '--cached', '--name-only'], { encoding: 'utf8' }).trim() === '');
  const changed = execFileSync('git', ['diff', '--name-only', '2c9ff5e5e5574dc34ab5c6280f30634b15e6394f', 'HEAD'], { encoding: 'utf8' }).trim().split(/\r?\n/);
  check('35 committed changes are management records only', changed.length === 35 && changed.every(p => p.startsWith('.workflow-system/records/')));
  const sourceBytes = read('private/source-a1.jsonl'), source = jsonl('private/source-a1.jsonl');
  check('captured source exact size/digest, 31 physical lines, exact SessionMeta binding', sourceBytes.length === 399136 && sha(sourceBytes) === '94aa8b3d2eff5aff57f4660d3d05732c940e0eb398ee90fa07fba41bcc002c67' && source.length === 31 && source[0].payload.id === cid);
  check('actual response delegation carrier lacks call_id', source[7].type === 'response_item' && source[7].payload.type === 'function_call_output' && source[7].payload.name === 'create_thread' && source[7].payload.namespace === 'codex_app' && !Object.hasOwn(source[7].payload, 'call_id'));
  check('matching unsupported nested FunctionCallOutput carrier', source[8].payload.type === 'item_completed' && source[8].payload.item.type === 'FunctionCallOutput' && source[8].payload.item.id === source[7].payload.id && source[8].payload.thread_id === cid && source[8].payload.turn_id === turn);
  check('one completed host turn', source.filter(r => r.type === 'event_msg' && r.payload.type === 'task_complete').length === 1);
  const command = source.find(r => r.payload?.item?.id === op).payload.item;
  const output = command.aggregated_output;
  const lines = output.split(/\r?\n/).filter(l => /^E2E-A1-L\d{4}\|/.test(l));
  check('source command succeeded with exact Unicode output and all 600 ordered lines', command.exit_code === 0 && Buffer.byteLength(output) === 74489 && sha(output) === '771272b217144d0eab8d1d72d8f489d3cde2253006b6bfa78b8a13e0375c79e1' && lines.length === 600 && lines.every((l, i) => l === `E2E-A1-L${String(i + 1).padStart(4, '0')}|汉字🙂é|${'0123456789abcdef'.repeat(6)}`));
  const wire = jsonl('private/wire-a1.jsonl');
  const sent = wire.filter(r => r.direction === 'sent');
  check('observer sent only exact A normal selection, not history/turn/ACK', sent.length === 1 && sent[0].message.type === 'set_active_conversation' && sent[0].message.conversationId === cid);
  const surfaces = wire.filter(r => r.direction === 'received' && r.message.type === 'conversation_surface_snapshot' && r.message.conversationId === cid).map(r => r.message.snapshot);
  check('14 healthy IPC surfaces retain exact turn and running/terminal operation identity', surfaces.length === 14 && surfaces.every(s => s.latestTurnId === turn && s.desynced === false) && surfaces.some(s => s.status === 'running') && surfaces.some(s => s.status === 'completed' && s.items.length === 3 && s.items.some(i => i.itemId === op)));
  const runs = fs.readdirSync(path.join(out, 'private')).filter(n => n.startsWith('a1-run-')).map(n => json(`private/${n}`)).sort((a, b) => a.started_at - b.started_at);
  check('exactly two sequential natural backfill requests, completed partial, no canonical checkpoint or budget error', runs.length === 2 && runs[0].completed_at <= runs[1].started_at && runs.every(r => r.conversation_id === cid && r.mode === 'backfill' && r.status === 'completed' && r.result.completeness === 'partial' && !r.canonical_checkpoint && !r.error && r.receipt_count === 1));
  check('both checkpoints preserve exact parse gap positions and partial availability', runs.every(r => {
    const p = r.checkpoint.reducer_state.payload.reducer.projection;
    const gaps = p.diagnostics.filter(d => d.code === 'parse_gap');
    return !p.complete && p.provisional && p.coverage === 'partial' && p.availability === 'not_recoverable_from_rollout' && gaps.length === 2 && gaps[0].source_ref.rollout_ordinal === 7 && gaps[1].source_ref.rollout_ordinal === 8;
  }));
  const before = json('snapshot-before.json'), after = json('snapshot-after.json');
  check('all 21 prior run snapshot digests preserved', before.runs.length === 21 && after.runs.length === 23 && before.runs.every(b => after.runs.some(a => a.file === b.file && a.sha256 === b.sha256)));
  const SQL = await require('sql.js')();
  const open = n => { const db = new SQL.Database(read(n)); db.run('PRAGMA query_only=ON'); return db; };
  const rows = (db, sql, args = []) => { const stmt = db.prepare(sql); stmt.bind(args); const result = []; while (stmt.step()) result.push(stmt.getAsObject()); stmt.free(); return result; };
  const product = open('private/product-after.sqlite'), oldProduct = open('private/product-before.sqlite');
  check('both captured product DBs quick_check ok', [product, oldProduct].every(db => rows(db, 'PRAGMA quick_check')[0].quick_check === 'ok'));
  const staged = rows(product, 'SELECT * FROM staging_batches WHERE conversation_id = ? ORDER BY staged_at', [cid]);
  check('two actual staging rows bind accepted deliveries and remain unpublished', staged.length === 2 && staged.every((s, i) => {
    const d = JSON.parse(s.delivery_json), r = runs[i];
    return sha(s.payload_json) === s.payload_hash && s.published_at === null && d.batch_id === r.recovery_delivery.batch_id && d.segment_id === r.recovery_delivery.segment_id && d.job_id === r.job_id && r.recovery_delivery.request_id === r.request_id && s.staged_at >= r.started_at && s.staged_at <= r.completed_at && JSON.parse(s.payload_json).completeness === 'partial';
  }));
  check('A absent from all five canonical product tables', ['conversations', 'history_items', 'tool_details', 'analysis_checkpoints', 'publication_receipts'].every(t => rows(product, `SELECT count(*) AS n FROM ${t} WHERE conversation_id = ?`, [cid])[0].n === 0));
  check('A reconciliation intent retained', rows(product, 'SELECT revision FROM reconciliation_intents WHERE conversation_id = ?', [cid]).length === 1);
  check('all seven prior canonical product table rows unchanged', ['conversations', 'history_items', 'tool_details', 'usage_records', 'task_outcomes', 'analysis_checkpoints', 'publication_receipts'].every(t => sha(JSON.stringify(rows(product, `SELECT * FROM ${t} ORDER BY rowid`))) === sha(JSON.stringify(rows(oldProduct, `SELECT * FROM ${t} ORDER BY rowid`)))));
  const fields = [];
  const walk = (v, at) => { if (typeof v === 'string' && v.includes('E2E-A1-L0001|')) fields.push({ path: at, bytes: Buffer.byteLength(v), exact: v === output, last: v.includes('E2E-A1-L0600|'), end: v.includes('E2E-A1-END|600') }); if (Array.isArray(v)) v.forEach((x, i) => walk(x, `${at}[${i}]`)); else if (v && typeof v === 'object') Object.entries(v).forEach(([k, x]) => walk(x, `${at}.${k}`)); };
  walk(JSON.parse(staged[1].payload_json).tool_details, 'tool_details');
  check('staged CommandExecution output is bounded rather than original full fidelity', fields.some(f => f.bytes === 65536 && !f.last && !f.end) && !fields.some(f => f.exact));
  product.close(); oldProduct.close();
  const phone = open('private/android-after/databases/codex_conversations.db'), oldPhone = open('private/android-before/databases/codex_conversations.db');
  const conv = rows(phone, 'SELECT * FROM conversations WHERE conversation_id = ?', [cid]);
  const items = rows(phone, 'SELECT * FROM items WHERE conversation_id = ?', [cid]);
  check('phone A cache is one incomplete baseline item, not product provider', conv.length === 1 && conv[0].provider_mode === null && conv[0].complete === 0 && conv[0].coverage_state === 'legacy_unknown' && items.length === 1 && items[0].payload_json.includes('E2E-A1-20261003-BEGIN'));
  const oldItems = rows(oldPhone, 'SELECT * FROM items ORDER BY endpoint_id,conversation_id,item_key');
  check('all 1688 existing phone item rows unchanged', oldItems.length === 1688 && sha(JSON.stringify(oldItems)) === sha(JSON.stringify(rows(phone, 'SELECT * FROM items WHERE conversation_id != ? ORDER BY endpoint_id,conversation_id,item_key', [cid]))));
  const syncs = ['f2f99148-ffcd-4017-9394-dc25942b1a1d', '9856a85a-e2fd-4124-9cd7-5d4d341366a8'];
  const server = jsonl('private/server-diagnostics.jsonl');
  const android = jsonl('private/android-diagnostics.jsonl');
  const key = sha(cid).slice(0, 16);
  const applied = android.filter(e => e.event === 'android.codex.history.delta_applied' && e.fields.conversationKey === key && e.fields.generation === 7 && e.fields.result === 'COMMITTED');
  check('each real phone durable page correlates outbound hash/ACK and same-conversation commit before hashed sync state', syncs.every((id, index) => {
    const pages = rows(phone, 'SELECT * FROM sync_completed_pages WHERE sync_id = ?', [id]);
    const state = android.find(e => e.event === 'android.codex.history.sync_state' && e.fields.conversationKey === key && e.fields.syncId === sha(id).slice(0, 16) && e.fields.generation === 7 && e.fields.state === 'partial');
    // delta_applied has no syncId. Correlate retained exact sync/page records plus
    // hashed sync_state and same-device sequence; never invent a missing field.
    return pages.length === 1 && applied.length === 2 && state && applied[index].seq < state.seq && (!applied[index + 1] || state.seq < applied[index + 1].seq) && server.some(e => e.event === 'server.codex.history.outbound' && e.fields.type === 'conversation_history_delta' && e.fields.syncId === id && pages[0].page_hash.startsWith(e.fields.pageHash)) && server.some(e => e.event === 'server.codex.history.ack_received' && e.fields.syncId === id && e.fields.ok === true);
  }));
  const relevant = server.filter(e => e.fields?.conversationKey === key);
  check('observed A baseline source IPC, no product_read.started', relevant.some(e => e.event === 'server.codex.history.baseline_registered' && e.fields.sourceKind === 'ipc_surface') && !relevant.some(e => e.event === 'server.codex.history.product_read.started'));
  const authority = read('private/logcat-a1.txt').toString().split(/\r?\n/).filter(l => l.includes(`[ipc][surface-snapshot] conv=${cid}`) && l.includes('authority=IPC_AUTHORITATIVE'));
  check('actual Android log applied healthy running and completed IPC authority', ['running', 'completed'].every(status => authority.some(l => l.includes(`status=${status}`) && l.includes('applied=true') && l.includes('desynced=false'))));
  phone.close(); oldPhone.close();
  check('all authentication, registration and server configuration preference bytes unchanged', before.phone.preferences.filter(p => /credentials|client_registrations|server_config/.test(p.name)).length >= 3 && before.phone.preferences.filter(p => /credentials|client_registrations|server_config/.test(p.name)).every(p => after.phone.preferences.some(a => a.name === p.name && a.sha256 === p.sha256)));
  const ui = read('private/ui-a1-terminal.xml').toString('utf8');
  check('valid terminal UI hierarchy contains BEGIN, completed command, DONE', ui.includes('E2E-A1-20261003-BEGIN') && ui.includes('已运行命令') && ui.includes('E2E-A1-DONE'));
  const result = { execution_ref: ref, execution_sha256: sha(eventBytes), source_revision: head, method: 'Retained-file, in-memory query-only review checks; self-review, no live rerun.', passed: checks.filter(c => c.pass).length, total: checks.length, checks, staged_output_fields: fields, limitations: ['Consistency checks are not E2E PASS.', 'Raw Rust ACK wire not captured; static guarded path reviewed separately.', 'No cross-file snapshot or cross-machine timestamp ordering proof.', 'Terminal screenshot viewed separately; running black screenshot remains excluded.', 'No live device/service/analyzer/model calls or source changes during review.'] };
  result.checker_correction = 'Initial review-checks.json retained (27/28): checker incorrectly required raw syncId on delta_applied. Actual event omits it; corrected correlation uses exact durable page/server sync and hashed Android sync_state with same-device event sequence. Not a business rerun or changed evidence.';
  fs.writeFileSync(path.join(out, 'review-checks-reconciled.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify(result, null, 2));
  if (result.passed !== result.total) process.exitCode = 2;
}
main().catch(e => { console.error(e.stack); process.exitCode = 1; });
