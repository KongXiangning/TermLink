'use strict';
const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict');
const out=__dirname,rel='logs/history-save-repair-20261005/s5/utf8-repair-20261008';
const call=(cmd,input,name)=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs',cmd,'--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(out,name+'.json'),r.stdout,{flag:'wx'});assert.equal(r.status,0,r.stderr);return JSON.parse(r.stdout);};
const before=call('task-status',{detail:'step',task_ref:'TASK-20260832',step_id:'S5'},'status-before-execution');
assert.equal(before.task.lifecycle,'active');assert.equal(before.next_step_id,'S5');assert.equal(before.step.disposition_ref,null);
const s4=call('task-status',{detail:'step',task_ref:'TASK-20260832',step_id:'S4'},'status-S4-after-correction');assert.equal(s4.step.state,'finished');
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();assert.equal(head,'32c6b66179ac314321540fab3b0a82b56050e317');
const files=['src/services/codexRolloutCollector/analyzerProcessManager.js','tests/codexRolloutCollector.test.js','docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/product/requirements/REQ-20261005-codex-history-save-repair.md','docs/changes/records/CR-20261008-0045-stdout-utf8-repair.md',...['report.md','test-before.txt','utf8-after.txt','utf8-after-result.json','collector-regression.txt','collector-regression-result.json','run-tests.cjs','read-all.cjs','a-read-all.json','checks.cjs','self-check.json','service-start.txt','service-stop.txt','decision.cjs','link-decision.cjs','correct-decision.cjs','decision-correction-input.json','record-execution.cjs'].map(x=>rel+'/'+x),...['repair-baseline-20261008.json','repair-startup-20261008.json','repair-after-20261008.json','repair-final-20261008.json','inspect.cjs','resume-20261008/scope.md'].map(x=>'logs/history-save-repair-20261005/s5/'+x)];
const input={action:'execution',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S5',mode:'default',source_revision:head,decision_ref:'.workflow-system/records/events/key-b8f7243b9f59b8e74db73e3d4104b0b53010d79888eed4feac3ba6f9bfd035e5.json',decision_interpretation_ref:'.workflow-system/records/events/key-764e1691f6d37f017d61893bdeac5945fb205666dbc287d15ad360f8bdae2e1f.json',decision_source:'Current direct human execute-step request',decision_text:'补最小修复并重验 A',result:'Requested minimal UTF8 receiver repair and original-root A revalidation complete; S5 three natural scenarios now have server product save/read evidence. Pending change review, separate finish, and S6 phone acceptance.',summary:{change:'Generation-local StringDecoder for stdout Buffers; reject stale child before decode; 3 existing-suite regression tests; no shared contract/limits/schema/Rust/IPC/Android changes.',tests:'Old receiver 2fail/1pass; fixed added tests3/3 and collector+recovery138/138; no formal independent review.',A:'Old delegated A canonical40items9details; normal original-root singleton startup consumed retained intent, batch1/positive receipt1 and complete checkpoint consistent with batch; product_db body/all details64/64 checks and source/protection36/36.',three_scenarios:'Reuse exact prior N11items2details and native C22items4details body/tool/inheritance evidence; both canonical digests preserved. A uses real old source, 3 delegated system rows, 9 tools, no new model turn.',limits:'Long tool output retains existing UTF8-safe64KiB prefix and marker; all published text no U+FFFD. B/Q budget failures and intents retained.',protection:'N/C/D/F source window hashes unchanged; old canonical digests and all56oldrun hashes unchanged. Service restored stopped, no residual collector.',management:'Initial same-plan scope decision association unresolved; actual causal correction applied, view updated, S1-S4 retained, old3gaps remain. No business replay.'},commands:[{command:'node --test --test-reporter=tap --test-name-pattern=target stdout UTF8 tests/codexRolloutCollector.test.js',result:'before2fail/1pass; after3/3 exit0',report_ref:rel+'/utf8-after-result.json'},{command:'node --test --test-reporter=tap tests/codexRolloutCollector.test.js tests/codexRolloutCollector.recovery.test.js',result:'138/138 exit0',report_ref:rel+'/collector-regression-result.json'},{command:'local-dev-server-control start/stop -ProjectRoot .; original persistent root/fixed existing Rust executable/range switch',result:'normal existing intent A publication; no direct Rust, data mutation by diagnostic client or debug preload'},{command:'node '+rel+'/read-all.cjs A; node '+rel+'/checks.cjs; S5 inspect.cjs read-only summaries',result:'Gateway64/64 and source/protection36/36; diagnostic in-memory ACK only, no Android durable ACK'},{command:'validate-change-record.ps1 and validate-req.ps1 -ProjectRoot . -Strict; git diff --check',result:'PASS; no commit'}],remaining_work:['review-change current832/S5 execution and explicit finish remain pending','S6 actual phone durable commitACK/switch/reopen/body/tool details not run; do not infer from server diagnosticACK','REQ in_progress/newCR draftTBD; B/Q budget limitations and original failures retained','No Git, close, deployment or device operation authorized/performed; 833 closed and S1-S4 finished unchanged'],files,idempotency_key:'task832-S5-UTF8-minimal-repair-A-real-revalidation-20261008-v1'};
fs.writeFileSync(out+'/execution-input.json',JSON.stringify(input,null,2)+'\n',{flag:'wx'});
const result=call('task',input,'execution-result');assert.equal(result.recorded,true);assert.equal(result.association,'applied');assert.equal(result.projection.status,'updated');
const after=call('task-status',{detail:'step',task_ref:'TASK-20260832',step_id:'S5'},'status-after-execution');assert.equal(after.step.execution_ref,result.ref);assert.equal(after.next_step_id,'S5');assert.equal(after.step.disposition_ref,null);assert.equal(after.step.review_ref,null);assert.equal(after.next_route,'review-change');assert.equal(after.issues.length,3);
const sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const a=JSON.parse(fs.readFileSync(result.ref.replace('/events/','/attachments/'))).attachments.map(x=>({path:x.source_path,fixed:sha(x.ref)===x.sha256,live:sha(x.source_path)===x.sha256}));assert.ok(a.every(x=>x.live&&x.fixed));fs.writeFileSync(out+'/attachment-readback.json',JSON.stringify(a,null,2)+'\n',{flag:'wx'});
const t833=call('task-status',{detail:'task',task_ref:'TASK-20260833'},'status-833-after-execution');assert.equal(t833.task.lifecycle,'closed');
console.log(JSON.stringify({ref:result.ref,recorded:result.recorded,association:result.association,projection:result.projection.status,S4:s4.step.state,S5:after.step.state,next_route:after.next_route,finish:after.step.disposition_ref,review:after.step.review_ref,task833:t833.task.lifecycle,attachments:a.length,all_match:true,old_gaps:after.issues.length}));
