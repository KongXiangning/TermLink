const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4/review-1';
const execution='.workflow-system/records/events/key-704dc7f71fb9b413ceb4f206154c8a7ff9b109823a12239d2b51e883368c263c.json';
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const save=(name,v)=>fs.writeFileSync(d+'/'+name+'.json',JSON.stringify(v,null,2)+'\n');
const manifest=JSON.parse(fs.readFileSync(execution.replace('/events/','/attachments/'),'utf8'));
const checks=(manifest.attachments||manifest.files).map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));
save('attachment-check',checks);
const baseline=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s4/baseline.json','utf8'));
const protectedChecks=baseline.protected.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const source=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s4/source-after.json','utf8')).map(p=>({...p,matches:hash(p.path)===p.sha256}));
save('scope-check',{head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),protectedChecks,source});
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S4'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){
const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});fs.writeFileSync(d+'/status-'+label+'-before.json',r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);}
console.log(JSON.stringify({attachments:checks.length,all_fixed_live_match:checks.every(p=>p.fixed_matches&&p.live_matches),all_protected_match:protectedChecks.every(p=>p.matches),all_source_match:source.every(p=>p.matches)}));
