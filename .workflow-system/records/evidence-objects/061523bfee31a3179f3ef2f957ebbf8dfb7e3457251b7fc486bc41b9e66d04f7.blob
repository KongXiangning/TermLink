'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),out=__dirname,sha=b=>crypto.createHash('sha256').update(b).digest('hex'),base=JSON.parse(fs.readFileSync(path.join(out,'../resume-baseline-20261008.json'))),after=JSON.parse(fs.readFileSync(path.join(out,'../resumed-state-20261008.json'))),wire=JSON.parse(fs.readFileSync(path.join(out,'private/c-product-wire.json'))),page=wire.find(m=>m.type==='conversation_history_delta'),checks=[],check=(name,passed)=>checks.push({name,passed:!!passed});
for(const label of ['N','C','D','F'])check('source readonly '+label,base.sources[label][0].sha256===after.sources[label][0].sha256);
for(const c of base.canonical)check('old canonical '+c.id,after.canonical.some(x=>x.id===c.id&&x.digest===c.digest));
check('49 old run bytes preserved',base.runs.every(x=>after.runs.some(r=>r.file===x.file&&r.sha256===x.sha256)));
const c=after.canonical.find(r=>r.id===base.ids.C);check('C canonical distinct and complete',c&&c.coverage.completeness==='canonical'&&c.coverage.coverageComplete&&c.items===22&&c.details===4);check('C product_db full page',page.conversationId===base.ids.C&&page.range.providerMode==='product_db'&&page.range.coverageComplete&&!page.range.hasMoreBefore&&page.upserts.length===22);
const oldWire=JSON.parse(fs.readFileSync(path.join(out,'../private/n-product-wire.json'))),oldPage=oldWire.find(m=>m.type==='conversation_history_delta');check('all 11 inherited N payloads unchanged',oldPage.upserts.every(x=>page.upserts.some(y=>y.itemKey===x.itemKey&&y.payloadJson===x.payloadJson)));
const details=wire.filter(m=>m.type==='conversation_history_detail_response'),oldDetails=oldWire.filter(m=>m.type==='conversation_history_detail_response');check('both inherited N details unchanged',oldDetails.every(x=>details.some(y=>y.content===x.content&&y.contentHash===x.contentHash)));
const source=fs.readFileSync(base.sources.C[0].path,'utf8').trim().split('\n').map(JSON.parse),native=source.find(r=>r.payload?.item?.type==='CommandExecution').payload.item,detail=details.map(d=>JSON.parse(d.content)).find(d=>d.call_id===native.id),duration=native.duration.secs*1000+Math.floor(native.duration.nanos/1e6);
check('C own ordinary user turn',source.filter(r=>r.type==='response_item'&&r.payload.type==='message'&&r.payload.role==='user'&&JSON.stringify(r.payload.content).includes('TL832-S5-C-20261007')).length===1);
check('C own detail exact',detail.input===JSON.stringify({command:native.command,cwd:native.cwd})&&detail.output===`status=${native.status}; exit_code=${native.exit_code}; duration_ms=${duration}; output=${native.aggregated_output}`);
check('C own final answer',page.upserts.some(x=>JSON.parse(x.payloadJson).content==='TL832-S5-C-DONE'));
check('N not polluted',after.canonical.find(x=>x.id===base.ids.N).marker_counts['TL832-S5-C-20261007']===0);
check('native parent cut unchanged',base.sources.C[0].history_base.end_ordinal_exclusive===27&&base.sources.C[0].history_base.end_byte_offset===163403&&sha(fs.readFileSync(base.sources.N[0].path).subarray(0,163403))==='50070eece9b57e221967887cd5f40839ae39193c9878ba1b24420db74482b854');
const r={at:new Date().toISOString(),checks,passed:checks.filter(x=>x.passed).length,total:checks.length,qualification:'Evidence checks, not phone or formal review; D remains unpublished unless separately repaired/revalidated'};fs.writeFileSync(path.join(out,'c-checks.json'),JSON.stringify(r,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(r));if(checks.some(x=>!x.passed))process.exitCode=2;
