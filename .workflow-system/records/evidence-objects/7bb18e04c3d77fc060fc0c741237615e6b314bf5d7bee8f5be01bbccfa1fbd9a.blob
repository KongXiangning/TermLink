K_MANAGEMENT_API.md         |   4 +-\\n .../runtime/support/task-management.mjs            |  17 +-\\n .workflow-system/vnext/DISTRIBUTION_STATE.json     |  24 +-\\n .workflow-system/vnext/RUNTIME_CONTRACT.yaml       |   2 +-\\n docs/workflow/CURRENT_TASK.md                      |  69 ++--\\n scripts/case-judgment-projection-worker.ts         |  37 +-\\n .../knowledge-kernel/case-projection-adapter.ts    |   2 +\\n scripts/knowledge-kernel/ep5-rebuild-evidence.md   | 128 +++++-\\n scripts/knowledge-kernel/law-projection-adapter.ts |   1 +\\n scripts/knowledge-kernel/projection-rebuild.ts     |  46 ++-\\n scripts/knowledge-kernel/projection-registry.ts    |   2 +\\n tests/knowledge-kernel/embedding.test.ts           |   2 +-\\n tests/knowledge-kernel/projection-rebuild.test.ts  | 443 +++++++++++++++++++--\\n 18 files changed, 691 insertions(+), 121 deletions(-)\\nwarning: in the working copy of '.agents/skills/execute-step/SKILL.md', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.agents/skills/git-commit/SKILL.md', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/runtime/package-lock.json', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/runtime/package.json', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/runtime/src/kernel.ts', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/runtime/support/TASK_MANAGEMENT_API.md', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/vnext/DISTRIBUTION_STATE.json', LF will be replaced by CRLF the next time Git touches it\\nwarning: in the working copy of '.workflow-system/vnext/RUNTIME_CONTRACT.yaml', LF will be replaced by CRLF the next time Git touches it\\ndiff --git a/.agents/skills/execute-step/SKILL.md b/.agents/skills/execute-step/SKILL.md\\nindex 3970c4e..f96e6a6 100644\\n--- a/.agents/skills/execute-step/SKILL.md\\n+++ b/.agents/skills/execute-step/SKILL.md\\n@@ -116,11 +116,33 @@ old completion gate to obtain permission. Finishing alone does not authorize the\\n step or task closure. Changed plans, scope, validation and ordering use the same rule;\\n necessary in-scope implementation details and management drift do not trigger it.\\n \\n+When the user invokes `execute-step` without a new implementation scope after a\\n+clean applicable change review, and task-status still shows the current step as\\n+`executed` with no finish disposition, treat this as the requested step finish.\\n+The task-status `next_action: finish-step` makes this intent explicit; it is advice,\\n+not a permission token or a substitute for checking the reviewed work.\\n+Verify the review still covers the actual work; a Git commit alone does not change\\n+the reviewed files. Record `task` action `step` with state `finished`, the current\\n+task/plan/step and review reference, then read task-status again. Do not stop with\\n+\\\"nothing to implement\\\" or recommend `close-task` while that step remains open.\\n+An explicit status-only or read-only request remains read-only.\\n+\\n Read task-status after recording: execution, review and step disposition are separate.\\n Keep historical/late results marked historical; they must not reopen closed work or\\n replace the current execution. Report an unassociated result and link/correct it,\\n not repeat the actual execution. The view suggests the next unfinished step without\\n automatically executing it.\\n+Base `next_route` on this fresh view after any step disposition; an earlier review's\\n+route cannot override the current step state. After successfully finishing a\\n+nonfinal step, if Git commits are within the user's task scope and there are\\n+actual in-scope changes to save, recommend `next_route: git-commit` in this\\n+execute-step result. State the exact `commit_scope`, excluding unrelated changes.\\n+This is a one-time recommendation at the finish boundary, not a task-status stage,\\n+permission to commit, or a prerequisite for starting the next step. The fresh\\n+task-status can already point to the next unfinished step. If this was the last\\n+step, recommend `next_route: close-task`; a final Git commit may follow closure\\n+when requested. If Git is excluded or no relevant changes remain, follow the\\n+fresh task-status route. Never present a failed or unrecorded finish as finished.\\n \\n ## Result\\n \\ndiff --git a/.agents/skills/git-commit/SKILL.md b/.agents/skills/git-commit/SKILL.md\\nindex 5f757c4..bad7b38 100644\\n--- a/.agents/skills/git-commit/SKILL.md\\n+++ b/.agents/skills/git-commit/SKILL.md\\n@@ -82,6 +82,11 @@ After committing, inspect Git read-only and report the actual SHA, committed sco\\n remaining working-tree changes. Do not automatically call `task git`, `record`, `rebuild`\\n or refresh CURRENT_TASK merely to report this commit. Missing journal Git observations\\n do not mean the commit is missing and do not require supplementation or another commit.\\n+After a successful commit, read task-status and use its current unfinished stage\\n+for the result's `next_route` (normally `execute-step` for the next step, or\\n+`close-task` when the task has no unfinished step). Do not repeat an earlier\\n+execute-step Git recommendation solely because no `task git` association exists.\\n+If no commit was made, report why and do not imply the Git checkpoint completed.\\n \\n Use `task` action `git` only when the user explicitly requests a persisted task/execution\\n association (including an already agreed explicit recording policy). This action writes\\ndiff --git a/.workflow-system/runtime/package-lock.json b/.workflow-system/runtime/package-lock.json\\nindex c276090..44718a8 100644\\n--- a/.workflow-system/runtime/package-lock.json\\n+++ b/.workflow-system/runtime/package-lock.json\\n@@ -1,12 +1,12 @@\\n {\\n   \\\"name\\\": \\\"vibe-coding-vnext-runtime\\\",\\n-  \\\"version\\\": \\\"0.23.5\\\",\\n+  \\\"version\\\": \\\"0.23.6\\\",\\n   \\\"lockfileVersion\\\": 3,\\n   \\\"requires\\\": true,\\n   \\\"packages\\\": {\\n     \\\"\\\": {\\n       \\\"name\\\": \\\"vibe-coding-vnext-runtime\\\",\\n-      \\\"version\\\": \\\"0.23.5\\\",\\n+      \\\"version\\\": \\\"0.23.6\\\",\\n       \\\"dependencies\\\": {\\n         \\\"yaml\\\": \\\"2.8.3\\\"\\n       },\\ndiff --git a/.workflow-system/runtime/package.json b/.workflow-system/runtime/package.json\\nindex 5221c45..a7123a0 100644\\n--- a/.workflow-system/runtime/package.json\\n+++ b/.workflow-system/runtime/package.json\\n@@ -1,6 +1,6 @@\\n {\\n   \\\"name\\\": \\\"vibe-coding-vnext-runtime\\\",\\n-  \\\"version\\\": \\\"0.23.5\\\",\\n+  \\\"version\\\": \\\"0.23.6\\\",\\n   \\\"private\\\": true,\\n   \\\"type\\\": \\\"module\\\",\\n   \\\"engines\\\": {\\ndiff --git a/.workflow-system/runtime/src/kernel.ts b/.workflow-system/runtime/src/kernel.ts\\nindex 845e143..7ea5df7 100644\\n--- a/.workflow-system/runtime/src/kernel.ts\\n+++ b/.workflow-system/runtime/src/kernel.ts\\n@@ -139,7 +139,7 @@ export const VNEXT_RUNTIME_PACKAGE_MANIFEST_RELATIVE_PATH = '.workflow-system/ru\\n export const VNEXT_RUNTIME_LOCKFILE_RELATIVE_PATH = '.workflow-system/runtime/package-lock.json';\\n export const VNEXT_RUNTIME_PACKAGE_NAME = 'vibe-coding-vnext-runtime';\\n export const VNEXT_RUNTIME_NODE_MIN_VERSION = '>=20.0.0';\\n-export const VNEXT_RUNTIME_PACKAGE_VERSION = '0.23.5';\\n+export const VNEXT_RUNTIME_PACKAGE_VERSION = '0.23.6';\\n \\n export const RUNTIME_OPERATION_KINDS = [\\n   'task-state-transaction',\\ndiff --git a/.workflow-system/runtime/support/TASK_MANAGEMENT_API.md b/.workflow-system/runtime/support/TASK_MANAGEMENT_API.md\\nindex 976f7bb..27dd32a 100644\\n--- a/.workflow-system/runtime/support/TASK_MANAGEMENT_API.md\\n+++ b/.workflow-system/runtime/support/TASK_MANAGEMENT_API.md\\n@@ -68,7 +68,9 @@ management files it produces just to record that new commit's SHA.\\n request selected_task. They scan the entire saved task journal, not a bounded search page.\\n The response includes adopted_plan_ref, plan/steps/environment, current_step_id, execution,\\n review status and findings, review decisions, actual commits, remaining work, and advisory\\n-next_route. `state_completeness`, issues and unassociated_records must be reported; unknown\\n+next_route/next_action. `finish-step` means the reviewed current step still needs a\\n+separate work disposition; it is not an automatic finish or closure. `state_completeness`,\\n+issues and unassociated_records must be reported; unknown\\n association is not evidence that a plan/decision never existed.\\n \\n Reads do not write. `projection.cache` and `projection.display` describe persisted freshness;\\ndiff --git a/.workflow-system/runtime/support/task-management.mjs b/.workflow-system/runtime/support/task-management.mjs\\nindex e165b23..cc60ee2 100644\\n--- a/.workflow-system/runtime/support/task-management.mjs\\n+++ b/.workflow-system/runtime/support/task-management.mjs\\n@@ -302,16 +302,20 @@ export function taskView(root, input, io) {\\n         historical_execution_refs: executions.filter(e => e.step_id === id && !eligible(e)).map(e => e.ref) };\\n     });\\n     const currentStep = steps.find(s => !['finished', 'skipped', 'closed'].includes(s.state));\\n-    let route = null, mode = null;\\n+    let route = null, mode = null, nextAction = null;\\n     if (lifecycle !== 'closed' && lifecycle !== 'paused') {\\n       if (adopted?.conflict) route = 'task-lifecycle';\\n       else if (!adopted?.value && !task.baseline) route = reviews.some(r => r.stage === 'draft') ? 'prepare-task' : 'review-draft';\\n       else if (plan && !list(plan.steps).length) route = 'prepare-task';\\n       else if (currentStep) {\\n         if (currentStep.state === 'ambiguous' || currentStep.state === 'legacy-state' || currentStep.review_status === 'ambiguous') route = 'task-lifecycle';\\n-        else if (!currentStep.execution_ref) route = 'execute-step';\\n-        else if (!currentStep.review_ref) route = 'review-change';\\n-        else { route = 'execute-step'; mode = currentStep.review_status === 'clean' || ['accept', 'continue', 'finish', 'defer'].includes(currentStep.review_choice) ? null : 'repair'; }\\n+        else if (!currentStep.execution_ref) { route = 'execute-step'; nextAction = 'implement-step'; }\\n+        else if (!currentStep.review_ref) { route = 'review-change'; nextAction = 'review-step'; }\\n+        else {\\n+          route = 'execute-step';\\n+          mode = currentStep.review_status === 'clean' || ['accept', 'continue', 'finish', 'defer'].includes(currentStep.review_choice) ? null : 'repair';\\n+          nextAction = mode === 'repair' ? 'repair-step' : 'finish-step';\\n+        }\\n       } else route = 'close-task'; // Missing optional Git associations do not imply uncommitted work.\\n     }\\n     result.push({ task_id: task.task_id, display_id: task.display_id, title: plan?.title ?? task.title,\\n@@ -321,7 +325,7 @@ export function taskView(root, input, io) {\\n       current_step_id: lifecycle === 'closed' || adopted?.conflict ? null : (steps.length ? currentStep?.id ?? null : task.baseline?.current_step_id ?? null),\\n       steps, reviews, executions, tests, review_decisions: decisions, commits,\\n       dispositions: events.filter(e => ['close', 'pause', 'resume'].includes(e.action)).map(e => ({ ...e.data, ref: e.ref, action: e.action })),\\n-      next_route: route, next_mode: mode, recommendation_only: true,\\n+      next_route: route, next_mode: mode, next_action: nextAction, recommendation_only: true,\\n       legacy_source: task.baseline?.source_ref ?? null, legacy_plan_ref: task.baseline?.plan_ref ?? null, heads: maxima(events).map(e => e.ref) });\\n     const applied = [\\n       ...events.filter(e => e.action === 'prepare' && e.da