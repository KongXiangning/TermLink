fb7a381ddf3776.json\",\n              \"source_revision\": \"working-tree-sha256:314ad3394eb398394d3f3d1db9e65cc855451341808f0939770c4573cc433a43\",\n              \"command\": \"bun --env-file=.env.knowledge-kernel.local test tests/knowledge-kernel/evidence.test.ts --test-name-pattern 'three adapters preserve actual bodies'\",\n              \"selector\": \"three adapters preserve actual bodies\",\n              \"result\": \"passed\",\n              \"summary\": \"1 pass, 0 fail, 9 expect() calls; exit 0\",\n              \"report_ref\": \"scripts/knowledge-kernel/ep5-rebuild-evidence.md\",\n              \"ref\": \".workflow-system/records/events/key-bf3409d680b7321aece84e4a1d87659824661c9d2f8a03a2eb97d75b72895fb4.json\",\n              \"interpretation_ref\": null\n            },\n            {\n              \"plan_ref\": \"legacy-plan-0a7296874085b1956122307410e82db559721ec7b0d2bcae2fb3ff11d33fed14\",\n              \"step_id\": \"S3\",\n              \"execution_ref\": \".workflow-system/records/events/key-7d77a20c13e828210373966592f635d1bc934146c8652886738331013582aade.json\",\n              \"source_revision\": \"working-tree-sha256:0681496471e95ef5c40e07654a7a046678edfa357d88478a4eb71dabec0a350c\",\n              \"command\": \"bun --env-file=.env.knowledge-kernel.local test tests/knowledge-kernel/projection-rebuild.test.ts\",\n              \"selector\": \"EP5 all selectors including real PostgreSQL/Neo4j/Elasticsearch\",\n              \"result\": \"passed\",\n              \"summary\": \"31 pass, 0 fail, 226 expect() calls, exit 0; existing strict mapping Worker upgrade and PostgreSQL microsecond boundary included.\",\n              \"report_ref\": \"scripts/knowledge-kernel/ep5-rebuild-evidence.md\",\n              \"ref\": \".workflow-system/records/events/key-d34335cbd1129022e6ab99c6bd0e7754948654a3c19075439fe2500c4469de82.json\",\n              \"interpretation_ref\": null\n            }\n          ],\n          \"disposition_ref\": null,\n          \"historical_execution_refs\": []\n        }\n      ],\n      \"reviews\": [\n        {\n          \"verdict\": \"changes-requested\",\n          \"findings\": [\n            {\n              \"id\": \"S3-FENCE-COVERAGE\",\n              \"priority\": 2,\n              \"line\": 365,\n              \"title\": \"Neo4j 栅栏验收缺少已约定的负例\",\n              \"body\": \"真实用例在 tests/knowledge-kernel/projection-rebuild.test.ts:1209 只创建 claimed upsert，再于维护结束后创建 fresh upsert；缺少 EP5-FENCE-check 要求的 queued/retry、旧 delete、撤回对象重放、维护期新任务不误取消和失败恢复的真实 Worker 观测。12xx 的图谱比较只包含节点 ID/边，不包含代次。现有 PASS 不足以认定此 claim 全部通过，应补原选择器断言与实测，修正验收结论。\",\n              \"file\": \"scripts/knowledge-kernel/ep5-rebuild-evidence.md\"\n            },\n            {\n              \"id\": \"S3-SEARCH-COVERAGE\",\n              \"priority\": 2,\n              \"line\": 366,\n              \"title\": \"Search 等价验收遗漏失败及权限边界\",\n              \"body\": \"真实 ES 用例（1305-1408）只验证公共可见正文 ID、成功 alias 切换和 claimed upsert/delete；未构造 EP5-SEARCH-check-r2 明确要求的 bulk 失败后 alias 不变、独立保护索引、非公共未授权对象、证据读取回链或 queued/retry 重放。fresh 任务在重建结束后才插入，不证明维护中新任务不被误取消。应补齐原验收边界后再声称 S3 无遗留。\",\n              \"file\": \"scripts/knowledge-kernel/ep5-rebuild-evidence.md\"\n            },\n            {\n              \"id\": \"S3-EVIDENCE-REDACTION\",\n              \"priority\": 2,\n              \"line\": 305,\n              \"title\": \"证据报告应移除真实后端口令\",\n              \"body\": \"S3 新增资源说明将 Neo4j 和 Elasticsearch 的用户名/口令明文写入受版本控制的证据报告（305、308 行），违反已确认验证计划的脱敏要求。只保留容器身份、端口、认证方式与凭据配置键即可证明环境，实际口令应留在本地配置。\",\n              \"file\": \"scripts/knowledge-kernel/ep5-rebuild-evidence.md\"\n            }\n          ],\n          \"stage\": \"change\",\n          \"next_route\": \"execute-step\",\n          \"source_revision\": {\n            \"head\": \"1e59a91578903e6605a9aaf1263cc10ce803301f\",\n            \"rebuild_sha256\": \"dd43ca1258cfabd37383a0b897a71f4c62e6ade2c0b7e1e078a33baa6e997d91\",\n            \"tests_sha256\": \"2ec358a4a148c7129a83409f90712ab51b45012623055c29cf52414f6d79b4c2\"\n          },\n          \"step_id\": \"S3\",\n          \"provenance\": {\n            \"type\": \"independent-review\",\n            \"reviewer\": \"Codex current review session\",\n            \"implementation_authored_in_this_session\": false\n          },\n          \"coverage\": {\n            \"scope\": \"TASK-017 S3 current changes and cumulative worker/adapter/registry call chain; unrelated workflow-system upgrade excluded\",\n            \"limitations\": \"Full real Neo4j/Elasticsearch suite not rerun in this review; previous 28/28 is retained caller-reported evidence whose tested file hashes match current bytes.\",\n            \"validation\": [\n              \"bun test tests/knowledge-kernel/projection-rebuild.test.ts --test-name-pattern EP5-GUARD: 11 pass, 1 fail due to omitted env file / missing LAWAGENT_SCHEMA_TEST_URL\",\n              \"bun --env-file=.env.knowledge-kernel.local test tests/knowledge-kernel/projection-rebuild.test.ts --test-name-pattern EP5-GUARD: 12 pass, 0 fail, 16 filtered, 54 assertions\"\n            ],\n            \"requirements\": \"Retained definition 9b875743cf28640d58b8e3b49a893e0e93b7b91513715ded167d6fe2eb23589c; EP5-FENCE-check; EP5-SEARCH-check-r2\"\n          },\n          \"execution_ref\": \".workflow-system/records/events/key-8c8477646da7297534d7b5142c039edc5f2d18bc81e8a206ce2f62ba8811667f.json\",\n          \"ref\": \".workflow-system/records/events/1790695620021-e4dfde65-c0ec-490d-aa31-9edc84cc110d.json\",\n          \"interpretation_ref\": null\n        },\n        {\n          \"stage\": \"change\",\n          \"step_id\": \"S3\",\n          \"findings\": [\n            {\n              \"file\": \"scripts/knowledge-kernel/projection-registry.ts\",\n              \"title\": \"为已有 strict mapping 索引提供升级路径\",\n              \"line\": 122,\n              \"id\": \"S3-ES-EXISTING-MAPPING\",\n              \"body\": \"新增 parse_run_ref、parse_selection_revision、evidence_ref 后所有三域 Adapter 都发送这些字段，但 mappingVersion 仍为 search/v1 系列，ensureElasticsearchAlias 在 alias 存在时直接返回，不更新旧 mapping。已有索引上的普通 Worker upsert 会收到 strict_dynamic_mapping_exception 并进入重试/失败；只有先完整重建才恢复。真实 ES 独立临时索引复现：按旧 mapping 创建 alias，再调用当前 ensureElasticsearchAlias 和 elasticBulk，返回 HTTP bulk item status 400，拒绝 evidence_ref。应补兼容 mapping 更新或明确可执行的版本迁移，再启用新 payload；覆盖已有索引的 Worker 升级场景。临时索引已删除。\",\n              \"priority\": 1\n            },\n            {\n              \"file\": \"scripts/knowledge-kernel/projection-rebuild.ts\",\n              \"title\": \"维护取消截止点须保留 PostgreSQL 微秒精度\",\n              \"line\": 127,\n              \"id\": \"S3-FENCE-TIMESTAMP-PRECISION\",\n              \"body\": \"RETURNING created_at 被 pg 解码成 JavaScript Date，再作为 current.openedAt 回传给 commitMaintenanceBatch 的 created_at <= 截止条件，微秒尾数被截断。例：开窗为 .123900、旧任务为 .123800；Date 回传 .123000 后旧任务不再被取消。该旧 queued/retry/claimed delete 在维护结束后仍可通过状态检查删除新产物。真实 PG 只读复现得到 actually_precedes_open=true、old_task_cancelled_by_current_cutoff=false。应在数据库内按持久化开窗记录比较，或使用保留完整精度的时间字符串，不能向上取整而误取消新任务。\",\n              \"priority\": 2\n            }\n          ],\n          \"provenance\": {\n            \"type\": \"independent-review\",\n            \"reviewer\": \"Codex follow-up review session\",\n            \"implementation_authored_in_this_session\": false\n          },\n          \"source_revision\": {\n            \"rebuild_sha256\": \"50e8cbf6fede6f25bb68a5e435258fdd283075f9b8e7b4530b91024da8e820eb\",\n            \"head\": \"1e59a91578903e6605a9aaf1263cc10ce803301f\",\n            \"tests_sha256\": \"0f339141581f15f0babf90243ea9121f1caa66c1f29c9c29aef72e8d0a609258\"\n          },\n          \"links\": [\n            \".workflow-system/records/events/1790695620021-e4dfde65-c0ec-490d-aa31-9edc84cc110d.json\"\n          ],\n          \"verdict\": \"changes-requested\",\n          \"coverage\": {\n            \"limitations\": \"Existing evidence.test.ts selected runs reused as caller-reported evidence; not rerun this review. Historical unassociated disposition retained.\",\n            \"validation\": [\n              \"bun --env-file=.env.knowledge-kernel.local test tests/knowledge-kernel/projection-rebuild.test.ts: exit 0; 29 pass, 0 fail, 214 expect, 18.51s\",\n              \"Temporary real ES old mapping compatibility probe: bulk status 400 strict_dynamic_mapping_exception for evidence_ref; own temporary index deleted\",\n              \"Read-only PostgreSQL timestamp roundtrip probe: cutoff 2026-09-30T00:00:00.123Z; old .123800 precedes real open .123900 but fails <= roundtripped cutoff\"\n            ],\n            \"previous_findings\": {\n              \"S3_SEARCH_COVERAGE\": \"新增真实 bulk failure、保护索引、证据读取、私有 composition alias 和权限检查已复核\",\n              \"S3_FENCE_COVERAGE\": \"新增旧 queued/retry delete、维护期新任务、失败恢复、代次断言已复核；另发现截止精度缺陷\",\n              \"S3_EVIDENCE_REDACTION\": \"当前报告已脱敏\"\n            },\n            \"scope\": \"TASK-017 S3 follow-up; changed adapters, registry, maintenance cutoff and tests; unrelated workflow-system edits excluded\"\n          },\n          \"next_route\": \"execute-step\",\n          \"execution_ref\": \".workflow-system/records/events/key-763c805eb32aeb9ca38f94e2c1d7639d66e16a82a00f2a3014fb7a381ddf3776.json\",\n          \"ref\": \".workflow-system/records/events/1790698182079-cd767cac-e056-47e9-ab56-a1292bac3f84.json\",\n          \"interpretation_ref\": null\n        },\n        {\n          \"next_route\": \"close-task\",\n          \"links\": [\n            \".workflow-system/records/events/1790698182079-cd767cac-e056-47e9-ab56-a1292bac3f84.json\"\n          ],\n          \"execution_ref\": \".workflow-system/records/events/key-7d77a20c13e828210373966592f635d1bc934146c8652886738331013582aade.json\",\n          \"verdict\": \"clean\",\n          \"stage\": \"change\",\n          \"source_revision\": {\n            \"worker_sha256\": \"638da32a73657f6406c838e5ed58a37dc72b4771cc3204a8ea3c1aa391a83f3c\",\n            \"tests_sha256\": \"a3d1