stamp":"2026-09-29T17:35:32.292Z"}},{"availability":"present","code":"thread_settings_applied","item_key":"diagnostic:ordinal-226:0","message":"recognized session settings metadata","source_ref":{"byte_end":1303231,"byte_start":1301186,"item_type":"event_msg/thread_settings_applied","physical_line_ordinal":227,"rollout_ordinal":226,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-30T04:50:37.693Z"}},{"availability":"present","code":"thread_settings_applied","item_key":"diagnostic:ordinal-227:0","message":"recognized session settings metadata","source_ref":{"byte_end":1305277,"byte_start":1303231,"item_type":"event_msg/thread_settings_applied","physical_line_ordinal":228,"rollout_ordinal":227,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-30T14:35:17.132Z"}}],"provisional":false,"schema":"termlink-analysis-projection","schema_version":1,"source":"01a0ee04-a775-72b3-bd07-04aac804a3b4","turns":[{"availability":"present","context_window":258400,"items":[{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":"提交vNext相关\n","correlation_id":"7220df87-9d89-4457-b1a7-c511e797dfa6","item_key":"message:7220df87-9d89-4457-b1a7-c511e797dfa6","kind":"user_message","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"message","query":null,"question":null,"related_item_key":null,"result":null,"sequence":10000000,"source_ref":{"byte_end":108689,"byte_start":108218,"item_type":"event_msg/item_completed","physical_line_ordinal":10,"rollout_ordinal":9,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T16:35:08.092Z"},"summary":null,"timestamp":"2026-09-29T16:35:08.092Z","tool":null,"turn_id":"01a0ee05-18b3-79a0-8f7f-058e3883b66f","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":"我会按项目的 vNext 流程处理这次提交：先读取工作流协议和 `git-commit` 技能说明，确认当前任务状态与改动范围，再提交对应内容。","correlation_id":"msg_08578c257fee2aec016abbe8befda487d08ae67faef9649422","item_key":"message:msg_08578c257fee2aec016abbe8befda487d08ae67faef9649422","kind":"assistant_message","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"message","query":null,"question":null,"related_item_key":null,"result":null,"sequence":14000000,"source_ref":{"byte_end":113064,"byte_start":112450,"item_type":"response_item/message","physical_line_ordinal":14,"rollout_ordinal":13,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T16:35:12.215Z"},"summary":null,"timestamp":"2026-09-29T16:35:12.215Z","tool":null,"turn_id":"01a0ee05-18b3-79a0-8f7f-058e3883b66f","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"call_nPEysfQLD6w9kI2DDWFmD3IY","item_key":"tool:call_nPEysfQLD6w9kI2DDWFmD3IY","kind":"tool","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"tool","query":null,"question":null,"related_item_key":null,"result":null,"sequence":15000000,"source_ref":{"byte_end":113834,"byte_start":113064,"item_type":"response_item/custom_tool_call","physical_line_ordinal":15,"rollout_ordinal":14,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T16:35:13.498Z"},"summary":null,"timestamp":"2026-09-29T16:35:13.498Z","tool":{"availability":"present","call_id":"call_nPEysfQLD6w9kI2DDWFmD3IY","completed":true,"input":"const r = await tools.exec_command({\n  cmd: \"Get-Content .workflow-system/WORKFLOW_PROTOCOL.md; Get-Content .agents/skills/git-commit/SKILL.md; Get-Content .workflow-system/runtime/support/ASSISTANCE_API.md; git status --short --branch\",\n  workdir: \"E:\\\\coding\\\\LawAgent\",\n  shell: \"powershell\",\n  login: false,\n  max_output_tokens: 12000\n});\ntext(r.output);\n","outcome":"completed","output":"[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.5 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"---\\r\\nschema_version: 1\\r\\nkind: vnext-protocol\\r\\n---\\r\\n\\r\\n# vNext: assistance-first workflow\\r\\n\\r\\n## Governing purpose\\r\\n\\r\\nRuntime is a management service, not a development admission authority. User\\r\\ninstructions and the selected Skill determine scope and actions. Management\\r\\nfailures, stale evidence, incomplete reviews, legacy states and unfilled slots\\r\\nmust not prevent reading history, retaining new facts or continuing otherwise\\r\\nauthorized work. This protocol supersedes older mandatory workflow gate and\\r\\ninternal-recovery instructions for daily development.\\r\\n\\r\\nThe default API is `.workflow-system/runtime/support/assistance.mjs`. See\\r\\n`.workflow-system/runtime/support/ASSISTANCE_API.md` for inputs and outputs. Its\\r\\nnative Node modules run without the transaction kernel or npm dependencies.\\r\\n\\r\\n## Keep facts separate from qualifications\\r\\n\\r\\nRetain the observation first. Associate it with a task, plan, test and source\\r\\nrevision using the actual available information. Missing associations are gaps,\\r\\nnot fabricated IDs and not a reason to lose a report. Old evidence remains the\\r\\nrecord of its original subject. Current applicability can be unknown or stale\\r\\nwithout making historical contents unreadable or prohibiting new work.\\r\\n\\r\\nPASS, clean, resolved and verified are claims supported by evidence, not automatic\\r\\nconsequences of a successful record write or a user decision to continue/close.\\r\\nRecord whose observation it is. Self-review is not independent review.\\r\\n\\r\\n## Work and tools\\r\\n\\r\\nNo mandatory run-entry, preflight, Runtime-owned active tuple, evidence-plan\\r\\nmigration, waiver, retry budget or review receipt is needed for ordinary work.\\r\\nAn optional snapshot can capture before/after bytes. Existing specialized tools\\r\\nremain available; their own refusal is a failed service operation, not a workflow\\r\\nveto. Do not loop through repairs of the control plane before returning to work.\\r\\n\\r\\nKeep the user's actual authorization, explicit exclusions and external effects\\r\\nclear. Discovery is not write permission. Ask only when a genuinely unresolved\\r\\nuser-owned choice changes the requested work. Do not invent a new user quote,\\r\\npermission, risk acceptance or test result.\\r\\n\\r\\n## One-time confirmation for workflow deviations\\r\\n\\r\\nThis applies to every entry and mode, not only review, approval or closure. When an\\r\\nold gate would have stopped work, identify its real consequence rather than restoring\\r\\nthe gate. Use the latest applicable user instructions, plan, execution, review and\\r\\ndisposition records; an unsynchronized CURRENT_TASK alone does not prove a missing\\r\\nreview or a new conflict. Superseded workflow rules do not regain authority.\\r\\n\\r\\n**Continue without confirmation** for record/read/search operations, stale receipts,\\r\\nmissing metadata, index repair and equivalent implementation details already covered\\r\\nby the request. Preserve gaps and use available authorized tools; neither those\\r\\nconditions nor an old error code creates a user decision. Never rerun work just to\\r\\nmake a record fit. A real business/I/O failure must still be reported truthfully.\\r\\n\\r\\n**Ask once before the affected action** when it materially departs from an applicable\\r\\nworkflow commitment and the user has not already made that informed choice. Examples\\r\\ninclude finishing without the expected review or checks, proceeding with unresolved\\r\\nfindings, changing planned scope/acceptance/validation, changing execution order or\\r\\nretry policy, replacing or stopping unfinished work, and replacing independent review\\r\\nwith self-review. These are examples, not a closed list. Do not solicit an unrelated\\r\\nexception or expand the task merely because one is possible.\\r\\n\\r\\nState the intended action, expected workflow, actual gap and concrete consequences.\\r\\nBundle all currently known deviations for that action into one understandable question;\\r\\ninclude the proposed action and a meaningful alternative, not internal gate IDs.\\r\\nWait only for that choice: silence is not consent and the proposed action has not\\r\\nhappened. Independent authorized reading/recording remains available. If the user's\\r\\ncurrent request or still-effective earlier instruction already explicitly covers the\\r\\nsame action and disclosed consequences, use it without asking the same question again.\\r\\nA bare \\\"complete the task\\\", test PASS or next_route is not informed deviation consent.\\r\\n\\r\\nAfter confirmation, carry out exactly the chosen action, including any authorized\\r\\nremaining stages, without requiring another Skill invocation, a waiver receipt,\\r\\nclean review, legacy state repair or another approval for the same disclosed gap.\\r\\nRecord the actual outcome, not just the decision. For step/task disposition use the\\r\\nassistance journal; do not send the choice back through an incompatible legacy\\r\\ncomplete/advance/close gate. Completion of work and verification remain separate.\\r\\nConfirmation never turns failed/not-run/unknown into PASS or self-review into independent\\r\\nreview. It authorizes only the chosen work; file changes, deletion, commit or deployment\\r\\noutside its disclosed scope remain unauthorized.\\r\\n\\r\\nReuse a decision for the same target, action and disclosed consequences, including\\r\\nacross sessions. Check actual relevant changes, not a global revision or time-to-live.\\r\\nAudit additions, reindexing, equivalent receipt refresh or switching sessions alone do\\r\\nnot invalidate it. Ask again only about material new consequences, a changed target or\\r\\naction, or a revised/revoked instruction; show what changed. A prior one-step decision\\r\\nis not blanket permission for later work. Do not invent earlier consent if unavailable.\\r\\n\\r\\nKeep the user's actual source/text separate from the agent's summary. Use existing\\r\\n`record` with kind `decision`, plus links from the later outcome; include the target,\\r\\nchoice, disclosed gaps and scope as available. These are recording conventions, not\\r\\nrequired token fields or Runtime authorization. A recording failure does not revoke\\r\\na choice still available in the conversation: report it and use another authorized\\r\\nrecording method. Never claim the journal or legacy projection was updated when not.\\r\\n\\r\\n## Unified task management\\r\\n\\r\\nNon-blocking does not mean unmanaged. Use assistance `task` actions for task\\r\\npreparation, adoption, execution, tests, reviews, review disposition, explicit Git associations\\r\\nand lifecycle. Read `TASK_MANAGEMENT_API.md` for their association fields and recovery.\\r\\nA new prepare allocates stable identity and a display number; a revision keeps identity.\\r\\nAdoption chooses the exact plan, initializes work position and maintains focus.\\r\\nReview is not adoption; execution is not review; user disposition is not PASS.\\r\\nA close updates the task view and removes that task from active focus, keeping gaps.\\r\\n\\r\\nGit's own history is the source for commit facts. An ordinary commit ends with read-only\\r\\nGit verification and reporting its SHA; it does not require a journal entry or view update.\\r\\n`task git` is an optional write for an explicitly requested task/commit association, not\\r\\nan automatic post-commit step. Missing journal commit entries alone justify neither\\r\\nanother commit nor recovery work. Never create a chain of commits recording their own SHA.\\r\\n\\r\\nEvery state question uses `task-status` / `context.management`. They recompute from\\r\\nthe complete retained journal. A generic find page or old CURRENT_TASK is not current\\r\\nstate. Report partial associations instead of concluding an unlinked plan never existed.\\r\\nCURRENT_TASK is the generated human-readable view; its previous bytes and old task\\r\\nstore remain historical sources. The old task kernel is not a writer of this display.\\r\\n\\r\\nNormal view maintenance belongs to each task operation. Check fact persistence,\\r\\nassociation and projection separately; a saved note is not full task-management\\r\\ncompletion. On a deterministic view failure try bounded rebuild, never business replay.\\r\\nFor missing meaning/conflict offer link, correct, resolve or defer; user-facing Skills\\r\\nexplain the actual choices and fill references. Keep the original records/decisions.\\r\\nDefer preserves known uncertainty; it does not mark it resolved. An existing valid\\r\\nchoice does not need another approval merely because the cache or view changed.\\r\\nIf display content was edited, preserve it and ask only about an actual overwrite.\\r\\nRead-only status computes in memory and never writes a cache.\\r\\n\\r\\nThis section supersedes older guidance that left current task maintenance optional.\\r\\nLegacy archive mirrors may remain historical; the current task view must not remain\\r\\nsilently stale. Compiled task-context defaults to this view; --legacy is historical.\\r\\n\\r\\n## Lifecycle and review\\r\\n\\r\\nPreparation, execution, review and disposition are distinct observations. New\\r\\nplans and corrections link previous plans and preserve their history. Lifecycle\\r\\nchanges record user intent without forcing unfinished work to be completed first.\\r\\nUse One-time confirmation for workflow deviations for unresolved choices before\\r\\nirreversible or incomplete termination; an already sufficient decision is reused.\\r\\nClosure neither rolls back code nor grants Git/deployment permission.\\r\\n\\r\\nBy default execute includes implementation self-check, not a fresh formal review.\\r\\nCreating a review requires an instruction that actually covers it; an explicit\\r\\ncombined request may be completed in one interaction. Report self-review honestly.\\r\\nA public result always reports one `next_route`: a public Skill ID or `null`,\\r\\nwith a brief reason based on the actual outcome and remaining work. Use `null`\\r\\nwhen no public Skill is justified. Complete stages already authorized by the\\r\\nuser before choosing the route. The route is advice, never an exclusive permitted\\r\\nnext action or authorization to perform it.\\r\\n\\r\\n## Evidence and tests\\r\\n\\r\\nKeep actual command output, selectors, source version and failed/not-run outcomes.\\r\\nReuse useful existing evidence. Select minimum-sufficient validation from the real\\r\\nchanged behavior and the user's limits. No automatic E2E, new permanent test,\\r\\nfull-suite rerun or expanded validation merely to satisfy management metadata.\\r\\nThe project's test-admission-policy remains methodological guidance, not a gate\\r\\nthat must be repaired before facts can be retained.\\r\\n\\r\\n## Persistence failures\\r\\n\\r\\nNever claim a failed write succeeded, overwrite unknown history, or silently\\r\\nrestore user files. Return precise I/O errors for the specific service operation.\\r\\nPreserve output elsewhere when authorized; report unpersisted/unreconciled work.\\r\\nContinue independent authorized work. A damaged index/projection is not proof\\r\\nthat historical objects or unrelated records are unavailable.\\r\\n\\r\\n## Existing data and compatibility tools\\r\\n\\r\\nExisting Task Store, task-data, task-history, evidence blobs, test reports,\\r\\nknowledge records and document lookup remain available; no task reset or forced\\r\\nrebootstrap is required. The new append-only journal extends retained management\\r\\nfacts. A preserved old baseline and generated current view replace the obsolete active\\r\\ndisplay without rewriting old evidence. The journal, labels and views are project data,\\r\\nnever distribution-owned artifacts.\\r\\n\\r\\nThe capability and runtime_operations lists in existing entry metadata and\\r\\nSOURCE_CONTRACT/RUNTIME_CONTRACT enumerate compatible tools. They are not a list\\r\\nof admission checks each invocation must pass. Their specialized transactional\\r\\nrequirements describe those optional calls only, not the default development path.\\r\\nHistorical transactional instructions are in support/CONTEXT_API.md.\\r\\n---\\r\\nname: git-commit\\r\\ndescription: 'git-commit: carry out the requested work with non-blocking management assistance.'\\r\\nentry_contract:\\r\\n  entry: git-commit\\r\\n  mode: []\\r\\n  intent: Assist the user's git-commit request without workflow admission.\\r\\n  input_contract:\\r\\n    required:\\r\\n      - repository\\r\\n      - intended_changes\\r\\n    optional:\\r\\n      - preferred_message\\r\\n      - workflow_result\\r\\n  authority_owner: user\\r\\n  mutation_boundary:\\r\\n    product_files: []\\r\\n    governance_sources: []\\r\\n    forbidden_targets:\\r\\n      - unrequested external effects\\r\\n      - unrelated user files\\r\\n      - silent overwrites of immutable history\\r\\n  internal_capabilities:\\r\\n    - dangerous-operation-gate\\r\\n  runtime_operations: []\\r\\n  stop_conditions:\\r\\n    - a genuinely unresolved user-owned choice prevents the requested work\\r\\n    - a real business prerequisite is unavailable; management failures do not prohibit independent work\\r\\n  output_kind: git-commit-result\\r\\n---\\r\\n\\r\\n# vNext Skill: git-commit\\r\\n\\r\\n## Default runtime role\\r\\n\\r\\nruntime_role: assistance/v1\\r\\n\\r\\nFollow `.workflow-system/WORKFLOW_PROTOCOL.md` and the management API in\\r\\n`.workflow-system/runtime/support/ASSISTANCE_API.md`. Use the native service:\\r\\n`node .workflow-system/runtime/support/assistance.mjs <command> --root <project>`.\\r\\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\\r\\n\\r\\nUse `task-status` (or the `context.management` view) to identify the task, adopted\\r\\nplan, step, review/disposition and actual commits. It reads the complete journal,\\r\\nnot one search page or the old CURRENT_TASK tuple. `find`/`read` remain evidence tools.\\r\\nFor task lifecycle changes use `task` actions documented in ASSISTANCE_API; raw\\r\\n`record` is for general observations, not a substitute for task registration.\\r\\nGit itself records a commit. A commit request alone requires no task-management write.\\r\\nFor explicitly requested task-management writes, check `recorded`, `association`\\r\\nand `projection` separately.\\r\\nIf an association/view update fails, retain facts, try a bounded deterministic rebuild\\r\\nwhen appropriate, and present concrete link/correct/resolve/defer choices. Honor the\\r\\nchosen recovery without repeating business actions or asking again for existing consent.\\r\\nA read-only request uses live task-status without writing a cache. Never declare\\r\\nfull task-management completion merely because a generic record was saved.\\r\\n\\r\\nIf a management operation fails, preserve its actual error and any output already\\r\\nsaved; use another authorized recording method when available and continue\\r\\nindependent authorized work. Do not retry unchanged calls, rerun business commands,\\r\\ninvent IDs/PASS or claim persistence succeeded. Ask only about a genuinely unresolved\\r\\nuser choice or unavailable business prerequisite, not an internal gate code.\\r\\n\\r\\n## Workflow deviations\\r\\n\\r\\nApply **One-time confirmation for workflow deviations** in WORKFLOW_PROTOCOL for\\r\\nall materially affected actions, not only approvals. Combine known consequences,\\r\\nreuse an applicable explicit decision, then execute the user's chosen action without\\r\\nlegacy admission or repeated confirmation. Pure management errors need no consent;\\r\\nreport real gaps without making them PASS. Pause only an unresolved user choice.\\r\\n\\r\\n## Method\\r\\n\\r\\nInspect git status and diff, preserve unrelated user changes, and identify the exact\\r\\nrequested commit scope. Only an actual instruction to commit authorizes a commit;\\r\\na next_route recommendation is not that instruction. Do not require a Runtime\\r\\ncompleted/clean/archived tuple before honoring an authorized commit.\\r\\n\\r\\nCommit only authorized paths and report the actual Git result. Do not push, amend,\\r\\nreset, clean, force or bypass host security unless specifically authorized. Existing\\r\\nGit hooks may report their own failures; do not call them Runtime qualification.\\r\\nAfter committing, inspect Git read-only and report the actual SHA, committed scope and\\r\\nremaining working-tree changes. Do not automatically call `task git`, `record`, `rebuild`\\r\\nor refresh CURRENT_TASK merely to report this commit. Missing journal Git observations\\r\\ndo not mean the commit is missing and do not require supplementation or another commit.\\r\\n\\r\\nUse `task` action `git` only when the user explicitly requests a persisted task/execution\\r\\nassociation (including an already agreed explicit recording policy). This action writes\\r\\nmanagement files even though its Git-object check is read-only. Report those writes as\\r\\nthe requested association result; never recursively commit them to record their own SHA.\\r\\nIf that optional write fails, report the real SHA and the association failure separately.\\r\\n\\r\\nIf the requested commit departs from an actual agreed review/test prerequisite, use\\r\\none combined consequence confirmation, not a demand to repair Runtime status. Then\\r\\ncommit the authorized files even with disclosed gaps retained in the report. Consent\\r\\nfor this commit neither grants push/deployment nor bypasses host access controls.\\r\\n\\r\\n## Result\\r\\n\\r\\nReturn the actual requested result, affected scope, evidence/record references,\\r\\nremaining work and any unsaved/unreconciled data. Preserve existing user decisions\\r\\nand exclusions; an explicit read-only request remains read-only. A record's successful\\r\\nwrite does not certify the product or expand authorization.\\r\\n\\r\\nAlways include `next_route` in the final result: one public Skill ID or `null`,\\r\\nwith a brief reason. Choose it from the actual outcome and remaining work; use\\r\\n`next_route: null` when no public Skill is justified. Finish any further stages\\r\\nalready covered by the user's instruction before choosing the route. The route is\\r\\nadvice, not permission or the only allowed next action. Do not invoke it solely\\r\\nbecause it was recommended or widen validation or external effects without authorization.\\r\\n\\r\\nterminal_boundary: public-entry-terminal/v1\\r\\n# vNext management API — assistance, not admission\\r\\n\\r\\n```sh\\r\\nnode .workflow-system/runtime/support/assistance.mjs <command> --root <project>\\r\\n```\\r\\n\\r\\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\\r\\nInput is JSON on stdin. Commands: context, task-status, task, record, snapshot, read, find.\\r\\nNative modules assistance.mjs and task-management.mjs use Node built-ins, not the old\\r\\ntransaction/qualification kernel. The service never executes product commands or tests.\\r\\n`task git` reads local commit objects but writes the requested association and management\\r\\nviews. It is optional, for explicitly requested persistent associations; ordinary commits\\r\\nare verified and reported directly from Git without calling it. It does not commit or push.\\r\\n\\r\\n## Two responsibilities, separate results\\r\\n\\r\\nUser instructions and Skills determine work and informed workflow-deviation choices.\\r\\n`record` preserves arbitrary observations; `task` maintains identity, adopted plans,\\r\\nsteps, execution, reviews/dispositions, Git observations and closure in the same journal.\\r\\nDo not substitute a generic note for a task operation. Full action shapes, examples and\\r\\nexisting-record recovery: **TASK_MANAGEMENT_API.md** beside this file.\\r\\n\\r\\nEvery response retains development_gate=false and qualification=not-evaluated. These are\\r\\nnot permission grants or PASS. Task operations report fact persistence, association and\\r\\nview publication independently. A projection/association failure never discards the saved\\r\\nfact or revokes a still-visible user decision; it also is not complete management success.\\r\\n\\r\\nState queries use `task-status` or `context.management`, computed from all task facts.\\r\\nCURRENT_TASK is a generated presentation, not a second current authority. A stale display,\\r\\none literal-search page or a raw legacy tuple must not decide the current task. Read-only\\r\\nqueries rebuild in memory and report projection freshness; they do not write files.\\r\\n\\r\\nOne-time confirmation for material workflow deviations is in WORKFLOW_PROTOCOL. Read,\\r\\nsearch, save and deterministic view maintenance need no new approval. Ask only about an\\r\\nunresolved choice with real consequences. After the choice, perform the actual operation\\r\\nand update its view, without legacy gate/waiver/preflight recovery. Never fabricate consent,\\r\\nPASS or independent review. A user's review disposition does not edit the review verdict.\\r\\n\\r\\n## Raw facts: save first\\r\\n\\r\\n`record` accepts arbitrary JSON. kind, task_ref, source_revision, body, links,\\r\\nidempotency_key and files are conventional fields. Missing IDs or unknown kinds do not\\r\\nprevent retention. Malformed JSON passed to record is retained as a raw observation.\\r\\nThe raw payload is saved before optional attachments; missing/changed attachments are\\r\\nreported separately, not used to reject the report. Do not capture secrets/unrelated files.\\r\\n\\r\\n```json\\r\\n{\\\"kind\\\":\\\"test-run\\\",\\\"task_ref\\\":\\\"TASK-016\\\",\\\"source_revision\\\":\\\"actually-tested-version\\\",\\\"idempotency_key\\\":\\\"actual-run-1\\\",\\\"body\\\":{\\\"command\\\":\\\"authorized selector\\\",\\\"result\\\":\\\"failed\\\",\\\"observation\\\":\\\"actual output\\\"},\\\"files\\\":[\\\"reports/test.txt\\\"]}\\r\\n```\\r\\n\\r\\nThe result includes recorded, ref, payload hash, attachment references/issues and management\\r\\npublication status. Exact replay returns the original record and does not recapture changed\\r\\nfiles. Conflicting input with the same key is retained separately, linked to the original,\\r\\nnever overwrites it. Task-command retries compare the original semantic request, so changed\\r\\nderived defaults/heads do not turn a retry into another adoption or task.\\r\\n\\r\\nRaw records live in `.workflow-system/records/events`, attachment indexes in records/attachments,\\r\\nimmutable bytes in records/evidence-objects. Task events use this same store. task-labels stores\\r\\nstable display allocation; task-view.json/task-views are rebuildable presentations. Original\\r\\nlegacy displays are retained under records/legacy. None are software distribution assets.\\r\\n\\r\\n## Fixed evidence\\r\\n\\r\\n`snapshot {\\\"path\\\":\\\"reports/test.txt\\\"}` captures an explicit regular file using buffered I/O.\\r\\nAn optional sha256 requests exact historical bytes. A saved digest is resolved first in the\\r\\njournal, then in the existing workflow-home evidence-objects directory. Changed live content\\r\\nis never relabelled with the old digest. Missing/corrupt original bytes are reported, not guessed.\\r\\nThis does not prevent new reports or other evidence from being saved.\\r\\n\\r\\n`read` accepts a path/ref or sha256, workflow_home when needed, offset and max_bytes.\\r\\nIn-repository absolute paths and common separators are normalized. External and symbolic\\r\\npaths are not followed. Historical reads do not require a live plan, current task or review.\\r\\n\\r\\n```json\\r\\n{\\\"sha256\\\":\\\"<actual 64-character digest>\\\",\\\"workflow_home\\\":\\\"docs/workflow\\\",\\\"offset\\\":0,\\\"max_bytes\\\":8192}\\r\\n```\\r\\n\\r\\nRead responses contain exact base64 data, text_preview, size and next_offset. Follow\\r\\nnext_offset until null. Decode base64 for exact reconstruction: the UTF-8 preview may split\\r\\na character at a byte boundary. Page limits are not evidence failures. There is no old\\r\\none-MiB qualification limit. Availability, historical truth and current applicability are\\r\\nseparate; an old PASS only reports that old run until current applicability is established.\\r\\n\\r\\n## Navigation and literal search\\r\\n\\r\\n`context {\\\"task_ref\\\":\\\"TASK-016\\\"}` returns unified task management plus legacy and journal\\r\\nsource navigation. workflow_home is optional; a simple profile hint is read best-effort.\\r\\nFor unusual/ambiguous YAML provide the actual home explicitly. No report save requires it.\\r\\n\\r\\n`find` searches literal stored bytes, not decoded semantics of arbitrary historical payloads.\\r\\nUse query and optional roots to narrow evidence searches. It returns paths/byte offsets for read.\\r\\nEncoded legacy reports may need reading and decoding; do not claim decoded full-text coverage.\\r\\n\\r\\n```json\\r\\n{\\\"query\\\":\\\"TASK-016\\\",\\\"max_results\\\":20}\\r\\n```\\r\\n\\r\\nFollow next_cursor with the same query. partial is pagination, not failure or permission denial.\\r\\nA cursor is not an immutable snapshot; concurrent additions may need a fresh search. Unreadable\\r\\nobjects appear in issues without excluding other files. Do not interpret no hit on one page as\\r\\nproof no plan, review or user decision exists; current state is a task-status query.\\r\\n\\r\\n## Failures, recovery and compatibility\\r\\n\\r\\nA real raw I/O failure returns unavailable, recorded=false and exit 1; do not claim it saved.\\r\\nPreserve output through another authorized means and report unsaved state. A task request with\\r\\nincomplete meaning can still be recorded with association=unresolved. Offer the relevant\\r\\nrebuild/link/correct/resolve/defer operation, not hand editing or repeating user approval.\\r\\nRebuild never reruns tests, execution, git commit or deployment.\\r\\n\\r\\nUnsupported legacy/free-text associations are reported with source refs. Supplement the real\\r\\nmeaning by linking records; do not replay preparation or confirmation. Unknown or conflicting\\r\\nfacts are not silently selected by latest timestamp. Corrections append, original bytes remain.\\r\\n\\r\\nExisting file-context, historical task-read/export, knowledge and evidence APIs remain optional\\r\\nspecialized tools in CONTEXT_API.md. The compiled CLI's default task-context delegates to the\\r\\nunified view after the software is rebuilt; --legacy explicitly opts into the old historical\\r\\nreader, which may not parse the new CURRENT_TASK display. Do not use it for current status or\\r\\nsend accepted user choices back through old complete/replan/close gates.\\r\\n## HEAD (no branch)\\n M .agents/skills/bootstrap-project/SKILL.md\\n M .agents/skills/capture-work-item/SKILL.md\\n M .agents/skills/close-task/SKILL.md\\n M .agents/skills/debug-task/SKILL.md\\n M .agents/skills/execute-step/SKILL.md\\n M .agents/skills/git-commit/SKILL.md\\n M .agents/skills/prepare-task/SKILL.md\\n M .agents/skills/review-change/SKILL.md\\n M .agents/skills/review-draft/SKILL.md\\n M .agents/skills/task-lifecycle/SKILL.md\\n M .agents/skills/validate-change/SKILL.md\\n M .workflow-system/WORKFLOW_PROTOCOL.md\\n M .workflow-system/runtime/package-lock.json\\n M .workflow-system/runtime/package.json\\n M .workflow-system/runtime/src/bootstrap-support.ts\\n M .workflow-system/runtime/src/cli.ts\\n M .workflow-system/runtime/src/kernel.ts\\n M .workflow-system/vnext/DISTRIBUTION_STATE.json\\n M .workflow-system/vnext/RUNTIME_CONTRACT.yaml\\n M AGENTS.md\\n M docs/workflow/CURRENT_TASK.md\\n M scripts/case-judgment-projection-worker.ts\\n M scripts/knowledge-kernel/case-projection-adapter.ts\\n M scripts/knowledge-kernel/ep5-rebuild-evidence.md\\n M scripts/knowledge-kernel/law-projection-adapter.ts\\n M scripts/knowledge-kernel/projection-rebuild.ts\\n M scripts/knowledge-kernel/projection-registry.ts\\n M tests/knowledge-kernel/embedding.test.ts\\n M tests/knowledge-kernel/projection-rebuild.test.ts\\n?? .workflow-system/records/\\n?? .workflow-system/runtime/src/host-guidance.ts\\n?? .workflow-system/runtime/support/ASSISTANCE_API.md\\n?? .workflow-system/runtime/support/TASK_MANAGEMENT_API.md\\n?? .workflow-system/runtime/support/assistance.mjs\\n?? .workflow-system/runtime/support/task-management.mjs\\n\"}]","started":true,"tool_kind":"custom_tool_call","tool_name":"exec"},"turn_id":"01a0ee05-18b3-79a0-8f7f-058e3883b66f","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"exec-2de716e3-6ae9-4f38-9239-ea62718b1cb7","item_key":"tool:exec-2de716e3-6ae9-4f38-9239-ea62718b1cb7","kind":"tool","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"tool","query":null,"question":null,"related_item_key":null,"result":null,"sequence":17000000,"source_ref":{"byte_end":198226,"byte_start":114707,"item_type":"event_msg/item_completed","physical_line_ordinal":17,"rollout_ordinal":16,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T16:35:14.039Z"},"summary":null,"timestamp":"2026-09-29T16:35:14.039Z","tool":{"availability":"present","call_id":"exec-2de716e3-6ae9-4f38-9239-ea62718b1cb7","completed":true,"input":"{\"command\":[\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\",\"-NoProfile\",\"-Command\",\"Get-Content .workflow-system/WORKFLOW_PROTOCOL.md; Get-Content .agents/skills/git-commit/SKILL.md; Get-Content .workflow-system/runtime/support/ASSISTANCE_API.md; git status --short --branch\"],\"cwd\":\"file:///E:/coding/LawAgent\"}","outcome":"completed","output":"status=completed; exit_code=0; duration_ms=352; output=---\r\nschema_version: 1\r\nkind: vnext-protocol\r\n---\r\n\r\n# vNext: assistance-first workflow\r\n\r\n## Governing purpose\r\n\r\nRuntime is a management service, not a development admission authority. User\r\ninstructions and the selected Skill determine scope and actions. Management\r\nfailures, stale evidence, incomplete reviews, legacy states and unfilled slots\r\nmust not prevent reading history, retaining new facts or continuing otherwise\r\nauthorized work. This protocol supersedes older mandatory workflow gate and\r\ninternal-recovery instructions for daily development.\r\n\r\nThe default API is `.workflow-system/runtime/support/assistance.mjs`. See\r\n`.workflow-system/runtime/support/ASSISTANCE_API.md` for inputs and outputs. Its\r\nnative Node modules run without the transaction kernel or npm dependencies.\r\n\r\n## Keep facts separate from qualifications\r\n\r\nRetain the observation first. Associate it with a task, plan, test and source\r\nrevision using the actual available information. Missing associations are gaps,\r\nnot fabricated IDs and not a reason to lose a report. Old evidence remains the\r\nrecord of its original subject. Current applicability can be unknown or stale\r\nwithout making historical contents unreadable or prohibiting new work.\r\n\r\nPASS, clean, resolved and verified are claims supported by evidence, not automatic\r\nconsequences of a successful record write or a user decision to continue/close.\r\nRecord whose observation it is. Self-review is not independent review.\r\n\r\n## Work and tools\r\n\r\nNo mandatory run-entry, preflight, Runtime-owned active tuple, evidence-plan\r\nmigration, waiver, retry budget or review receipt is needed for ordinary work.\r\nAn optional snapshot can capture before/after bytes. Existing specialized tools\r\nremain available; their own refusal is a failed service operation, not a workflow\r\nveto. Do not loop through repairs of the control plane before returning to work.\r\n\r\nKeep the user's actual authorization, explicit exclusions and external effects\r\nclear. Discovery is not write permission. Ask only when a genuinely unresolved\r\nuser-owned choice changes the requested work. Do not invent a new user quote,\r\npermission, risk acceptance or test result.\r\n\r\n## One-time confirmation for workflow deviations\r\n\r\nThis applies to every entry and mode, not only review, approval or closure. When an\r\nold gate would have stopped work, identify its real consequence rather than restoring\r\nthe gate. Use the latest applicable user instructions, plan, execution, review and\r\ndisposition records; an unsynchronized CURRENT_TASK alone does not prove a missing\r\nreview or a new conflict. Superseded workflow rules do not regain authority.\r\n\r\n**Continue without confirmation** for record/read/search operations, stale receipts,\r\nmissing metadata, index repair and equivalent implementation details already covered\r\nby the request. Preserve gaps and use available authorized tools; neither those\r\nconditions nor an old error code creates a user decision. Never rerun work just to\r\nmake a record fit. A real business/I/O failure must still be reported truthfully.\r\n\r\n**Ask once before the affected action** when it materially departs from an applicable\r\nworkflow commitment and the user has not already made that informed choice. Examples\r\ninclude finishing without the expected review or checks, proceeding with unresolved\r\nfindings, changing planned scope/acceptance/validation, changing execution order or\r\nretry policy, replacing or stopping unfinished work, and replacing independent review\r\nwith self-review. These are examples, not a closed list. Do not solicit an unrelated\r\nexception or expand the task merely because one is possible.\r\n\r\nState the intended action, expected workflow, actual gap and concrete consequences.\r\nBundle all currently known deviations for that action into one understandable question;\r\ninclude the proposed action and a meaningful alternative, not internal gate IDs.\r\nWait only for that choice: silence is not consent and the proposed action has not\r\nhappened. Independent authorized reading/recording remains available. If the user's\r\ncurrent request or still-effective earlier instruction already explicitly covers the\r\nsame action and disclosed consequences, use it without asking the same question again.\r\nA bare \"complete the task\", test PASS or next_route is not informed deviation consent.\r\n\r\nAfter confirmation, carry out exactly the chosen action, including any authorized\r\nremaining stages, without requiring another Skill invocation, a waiver receipt,\r\nclean review, legacy state repair or another approval for the same disclosed gap.\r\nRecord the actual outcome, not just the decision. For step/task disposition use the\r\nassistance journal; do not send the choice back through an incompatible legacy\r\ncomplete/advance/close gate. Completion of work and verification remain separate.\r\nConfirmation never turns failed/not-run/unknown into PASS or self-review into independent\r\nreview. It authorizes only the chosen work; file changes, deletion, commit or deployment\r\noutside its disclosed scope remain unauthorized.\r\n\r\nReuse a decision for the same target, action and disclosed consequences, including\r\nacross sessions. Check actual relevant changes, not a global revision or time-to-live.\r\nAudit additions, reindexing, equivalent receipt refresh or switching sessions alone do\r\nnot invalidate it. Ask again only about material new consequences, a changed target or\r\naction, or a revised/revoked instruction; show what changed. A prior one-step decision\r\nis not blanket permission for later work. Do not invent earlier consent if unavailable.\r\n\r\nKeep the user's actual source/text separate from the agent's summary. Use existing\r\n`record` with kind `decision`, plus links from the later outcome; include the target,\r\nchoice, disclosed gaps and scope as available. These are recording conventions, not\r\nrequired token fields or Runtime authorization. A recording failure does not revoke\r\na choice still available in the conversation: report it and use another authorized\r\nrecording method. Never claim the journal or legacy projection was updated when not.\r\n\r\n## Unified task management\r\n\r\nNon-blocking does not mean unmanaged. Use assistance `task` actions for task\r\npreparation, adoption, execution, tests, reviews, review disposition, explicit Git associations\r\nand lifecycle. Read `TASK_MANAGEMENT_API.md` for their association fields and recovery.\r\nA new prepare allocates stable identity and a display number; a revision keeps identity.\r\nAdoption chooses the exact plan, initializes work position and maintains focus.\r\nReview is not adoption; execution is not review; user disposition is not PASS.\r\nA close updates the task view and removes that task from active focus, keeping gaps.\r\n\r\nGit's own history is the source for commit facts. An ordinary commit ends with read-only\r\nGit verification and reporting its SHA; it does not require a journal entry or view update.\r\n`task git` is an optional write for an explicitly requested task/commit association, not\r\nan automatic post-commit step. Missing journal commit entries alone justify neither\r\nanother commit nor recovery work. Never create a chain of commits recording their own SHA.\r\n\r\nEvery state question uses `task-status` / `context.management`. They recompute from\r\nthe complete retained journal. A generic find page or old CURRENT_TASK is not current\r\nstate. Report partial associations instead of concluding an unlinked plan never existed.\r\nCURRENT_TASK is the generated human-readable view; its previous bytes and old task\r\nstore remain historical sources. The old task kernel is not a writer of this display.\r\n\r\nNormal view maintenance belongs to each task operation. Check fact persistence,\r\nassociation and projection separately; a saved note is not full task-management\r\ncompletion. On a deterministic view failure try bounded rebuild, never business replay.\r\nFor missing meaning/conflict offer link, correct, resolve or defer; user-facing Skills\r\nexplain the actual choices and fill references. Keep the original records/decisions.\r\nDefer preserves known uncertainty; it does not mark it resolved. An existing valid\r\nchoice does not need another approval merely because the cache or view changed.\r\nIf display content was edited, preserve it and ask only about an actual overwrite.\r\nRead-only status computes in memory and never writes a cache.\r\n\r\nThis section supersedes older guidance that left current task maintenance optional.\r\nLegacy archive mirrors may remain historical; the current task view must not remain\r\nsilently stale. Compiled task-context defaults to this view; --legacy is historical.\r\n\r\n## Lifecycle and review\r\n\r\nPreparation, execution, review and disposition are distinct observations. New\r\nplans and corrections link previous plans and preserve their history. Lifecycle\r\nchanges record user intent without forcing unfinished work to be completed first.\r\nUse One-time confirmation for workflow deviations for unresolved choices before\r\nirreversible or incomplete termination; an already sufficient decision is reused.\r\nClosure neither rolls back code nor grants Git/deployment permission.\r\n\r\nBy default execute includes implementation self-check, not a fresh formal review.\r\nCreating a review requires an instruction that actually covers it; an explicit\r\ncombined request may be completed in one interaction. Report self-review honestly.\r\nA public result always reports one `next_route`: a public Skill ID or `null`,\r\nwith a brief reason based on the actual outcome and remaining work. Use `null`\r\nwhen no public Skill is justified. Complete stages already authorized by the\r\nuser before choosing the route. The route is advice, never an exclusive permitted\r\nnext action or authorization to perform it.\r\n\r\n## Evidence and tests\r\n\r\nKeep actual command output, selectors, source version and failed/not-run outcomes.\r\nReuse useful existing evidence. Select minimum-sufficient validation from the real\r\nchanged behavior and the user's limits. No automatic E2E, new permanent test,\r\nfull-suite rerun or expanded validation merely to satisfy management metadata.\r\nThe project's test-admission-policy remains methodological guidance, not a gate\r\nthat must be repaired before facts can be retained.\r\n\r\n## Persistence failures\r\n\r\nNever claim a failed write succeeded, overwrite unknown history, or silently\r\nrestore user files. Return precise I/O errors for the specific service operation.\r\nPreserve output elsewhere when authorized; report unpersisted/unreconciled work.\r\nContinue independent authorized work. A damaged index/projection is not proof\r\nthat historical objects or unrelated records are unavailable.\r\n\r\n## Existing data and compatibility tools\r\n\r\nExisting Task Store, task-data, task-history, evidence blobs, test reports,\r\nknowledge records and document lookup remain available; no task reset or forced\r\nrebootstrap is required. The new append-only journal extends retained management\r\nfacts. A preserved old baseline and generated current view replace the obsolete active\r\ndisplay without rewriting old evidence. The journal, labels and views are project data,\r\nnever distribution-owned artifacts.\r\n\r\nThe capability and runtime_operations lists in existing entry metadata and\r\nSOURCE_CONTRACT/RUNTIME_CONTRACT enumerate compatible tools. They are not a list\r\nof admission checks each invocation must pass. Their specialized transactional\r\nrequirements describe those optional calls only, not the default development path.\r\nHistorical transactional instructions are in support/CONTEXT_API.md.\r\n---\r\nname: git-commit\r\ndescription: 'git-commit: carry out the requested work with non-blocking management assistance.'\r\nentry_contract:\r\n  entry: git-commit\r\n  mode: []\r\n  intent: Assist the user's git-commit request without workflow admission.\r\n  input_contract:\r\n    required:\r\n      - repository\r\n      - intended_changes\r\n    optional:\r\n      - preferred_message\r\n      - workflow_result\r\n  authority_owner: user\r\n  mutation_boundary:\r\n    product_files: []\r\n    governance_sources: []\r\n    forbidden_targets:\r\n      - unrequested external effects\r\n      - unrelated user files\r\n      - silent overwrites of immutable history\r\n  internal_capabilities:\r\n    - dangerous-operation-gate\r\n  runtime_operations: []\r\n  stop_conditions:\r\n    - a genuinely unresolved user-owned choice prevents the requested work\r\n    - a real business prerequisite is unavailable; management failures do not prohibit independent work\r\n  output_kind: git-commit-result\r\n---\r\n\r\n# vNext Skill: git-commit\r\n\r\n## Default runtime role\r\n\r\nruntime_role: assistance/v1\r\n\r\nFollow `.workflow-system/WORKFLOW_PROTOCOL.md` and the management API in\r\n`.workflow-system/runtime/support/ASSISTANCE_API.md`. Use the native service:\r\n`node .workflow-system/runtime/support/assistance.mjs <command> --root <project>`.\r\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\r\n\r\nUse `task-status` (or the `context.management` view) to identify the task, adopted\r\nplan, step, review/disposition and actual commits. It reads the complete journal,\r\nnot one search page or the old CURRENT_TASK tuple. `find`/`read` remain evidence tools.\r\nFor task lifecycle changes use `task` actions documented in ASSISTANCE_API; raw\r\n`record` is for general observations, not a substitute for task registration.\r\nGit itself records a commit. A commit request alone requires no task-management write.\r\nFor explicitly requested task-management writes, check `recorded`, `association`\r\nand `projection` separately.\r\nIf an association/view update fails, retain facts, try a bounded deterministic rebuild\r\nwhen appropriate, and present concrete link/correct/resolve/defer choices. Honor the\r\nchosen recovery without repeating business actions or asking again for existing consent.\r\nA read-only request uses live task-status without writing a cache. Never declare\r\nfull task-management completion merely because a generic record was saved.\r\n\r\nIf a management operation fails, preserve its actual error and any output already\r\nsaved; use another authorized recording method when available and continue\r\nindependent authorized work. Do not retry unchanged calls, rerun business commands,\r\ninvent IDs/PASS or claim persistence succeeded. Ask only about a genuinely unresolved\r\nuser choice or unavailable business prerequisite, not an internal gate code.\r\n\r\n## Workflow deviations\r\n\r\nApply **One-time confirmation for workflow deviations** in WORKFLOW_PROTOCOL for\r\nall materially affected actions, not only approvals. Combine known consequences,\r\nreuse an applicable explicit decision, then execute the user's chosen action without\r\nlegacy admission or repeated confirmation. Pure management errors need no consent;\r\nreport real gaps without making them PASS. Pause only an unresolved user choice.\r\n\r\n## Method\r\n\r\nInspect git status and diff, preserve unrelated user changes, and identify the exact\r\nrequested commit scope. Only an actual instruction to commit authorizes a commit;\r\na next_route recommendation is not that instruction. Do not require a Runtime\r\ncompleted/clean/archived tuple before honoring an authorized commit.\r\n\r\nCommit only authorized paths and report the actual Git result. Do not push, amend,\r\nreset, clean, force or bypass host security unless specifically authorized. Existing\r\nGit hooks may report their own failures; do not call them Runtime qualification.\r\nAfter committing, inspect Git read-only and report the actual SHA, committed scope and\r\nremaining working-tree changes. Do not automatically call `task git`, `record`, `rebuild`\r\nor refresh CURRENT_TASK merely to report this commit. Missing journal Git observations\r\ndo not mean the commit is missing and do not require supplementation or another commit.\r\n\r\nUse `task` action `git` only when the user explicitly requests a persisted task/execution\r\nassociation (including an already agreed explicit recording policy). This action writes\r\nmanagement files even though its Git-object check is read-only. Report those writes as\r\nthe requested association result; never recursively commit them to record their own SHA.\r\nIf that optional write fails, report the real SHA and the association failure separately.\r\n\r\nIf the requested commit departs from an actual agreed review/test prerequisite, use\r\none combined consequence confirmation, not a demand to repair Runtime status. Then\r\ncommit the authorized files even with disclosed gaps retained in the report. Consent\r\nfor this commit neither grants push/deployment nor bypasses host access controls.\r\n\r\n## Result\r\n\r\nReturn the actual requested result, affected scope, evidence/record references,\r\nremaining work and any unsaved/unreconciled data. Preserve existing user decisions\r\nand exclusions; an explicit read-only request remains read-only. A record's successful\r\nwrite does not certify the product or expand authorization.\r\n\r\nAlways include `next_route` in the final result: one public Skill ID or `null`,\r\nwith a brief reason. Choose it from the actual outcome and remaining work; use\r\n`next_route: null` when no public Skill is justified. Finish any further stages\r\nalready covered by the user's instruction before choosing the route. The route is\r\nadvice, not permission or the only allowed next action. Do not invoke it solely\r\nbecause it was recommended or widen validation or external effects without authorization.\r\n\r\nterminal_boundary: public-entry-terminal/v1\r\n# vNext management API — assistance, not admission\r\n\r\n```sh\r\nnode .workflow-system/runtime/support/assistance.mjs <command> --root <project>\r\n```\r\n\r\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\r\nInput is JSON on stdin. Commands: context, task-status, task, record, snapshot, read, find.\r\nNative modules assistance.mjs and task-management.mjs use Node built-ins, not the old\r\ntransaction/qualification kernel. The service never executes product commands or tests.\r\n`task git` reads local commit objects but writes the requested association and management\r\nviews. It is optional, for explicitly requested persistent associations; ordinary commits\r\nare verified and reported directly from Git without calling it. It does not commit or push.\r\n\r\n## Two responsibilities, separate results\r\n\r\nUser instructions and Skills determine work and informed workflow-deviation choices.\r\n`record` preserves arbitrary observations; `task` maintains identity, adopted plans,\r\nsteps, execution, reviews/dispositions, Git observations and closure in the same journal.\r\nDo not substitute a generic note for a task operation. Full action shapes, examples and\r\nexisting-record recovery: **TASK_MANAGEMENT_API.md** beside this file.\r\n\r\nEvery response retains development_gate=false and qualification=not-evaluated. These are\r\nnot permission grants or PASS. Task operations report fact persistence, association and\r\nview publication independently. A projection/association failure never discards the saved\r\nfact or revokes a still-visible user decision; it also is not complete management success.\r\n\r\nState queries use `task-status` or `context.management`, computed from all task facts.\r\nCURRENT_TASK is a generated presentation, not a second current authority. A stale display,\r\none literal-search page or a raw legacy tuple must not decide the current task. Read-only\r\nqueries rebuild in memory and report projection freshness; they do not write files.\r\n\r\nOne-time confirmation for material workflow deviations is in WORKFLOW_PROTOCOL. Read,\r\nsearch, save and deterministic view maintenance need no new approval. Ask only about an\r\nunresolved choice with real consequences. After the choice, perform the actual operation\r\nand update its view, without legacy gate/waiver/preflight recovery. Never fabricate consent,\r\nPASS or independent review. A user's review disposition does not edit the review verdict.\r\n\r\n## Raw facts: save first\r\n\r\n`record` accepts arbitrary JSON. kind, task_ref, source_revision, body, links,\r\nidempotency_key and files are conventional fields. Missing IDs or unknown kinds do not\r\nprevent retention. Malformed JSON passed to record is retained as a raw observation.\r\nThe raw payload is saved before optional attachments; missing/changed attachments are\r\nreported separately, not used to reject the report. Do not capture secrets/unrelated files.\r\n\r\n```json\r\n{\"kind\":\"test-run\",\"task_ref\":\"TASK-016\",\"source_revision\":\"actually-tested-version\",\"idempotency_key\":\"actual-run-1\",\"body\":{\"command\":\"authorized selector\",\"result\":\"failed\",\"observation\":\"actual output\"},\"files\":[\"reports/test.txt\"]}\r\n```\r\n\r\nThe result includes recorded, ref, payload hash, attachment references/issues and management\r\npublication status. Exact replay returns the original record and does not recapture changed\r\nfiles. Conflicting input with the same key is retained separately, linked to the original,\r\nnever overwrites it. Task-command retries compare the original semantic request, so changed\r\nderived defaults/heads do not turn a retry into another adoption or task.\r\n\r\nRaw records live in `.workflow-system/records/events`, attachment indexes in records/attachments,\r\nimmutable bytes in records/evidence-objects. Task events use this same store. task-labels stores\r\nstable display allocation; task-view.json/task-views are rebuildable presentations. Original\r\nlegacy displays are retained under records/legacy. None are software distribution assets.\r\n\r\n## Fixed evidence\r\n\r\n`snapshot {\"path\":\"reports/test.txt\"}` captures an explicit regular file using buffered I/O.\r\nAn optional sha256 requests exact historical bytes. A saved digest is resolved first in the\r\njournal, then in the existing workflow-home evidence-objects directory. Changed live content\r\nis never relabelled with the old digest. Missing/corrupt original bytes are reported, not guessed.\r\nThis does not prevent new reports or other evidence from being saved.\r\n\r\n`read` accepts a path/ref or sha256, workflow_home when needed, offset and max_bytes.\r\nIn-repository absolute paths and common separators are normalized. External and symbolic\r\npaths are not followed. Historical reads do not require a live plan, current task or review.\r\n\r\n```json\r\n{\"sha256\":\"<actual 64-character digest>\",\"workflow_home\":\"docs/workflow\",\"offset\":0,\"max_bytes\":8192}\r\n```\r\n\r\nRead responses contain exact base64 data, text_preview, size and next_offset. Follow\r\nnext_offset until null. Decode base64 for exact reconstruction: the UTF-8 preview may split\r\na character at a byte boundary. Page limits are not evidence failures. There is no old\r\none-MiB qualification limit. Availability, historical truth and current applicability are\r\nseparate; an old PASS only reports that old run until current applicability is established.\r\n\r\n## Navigation and literal search\r\n\r\n`context {\"task_ref\":\"TASK-016\"}` returns unified task management plus legacy and journal\r\nsource navigation. workflow_home is optional; a simple profile hint is read best-effort.\r\nFor unusual/ambiguous YAML provide the actual home explicitly. No report save requires it.\r\n\r\n`find` searches literal stored bytes, not decoded semantics of arbitrary historical payloads.\r\nUse query and optional roots to narrow evidence searches. It returns paths/byte offsets for read.\r\nEncoded legacy reports may need reading and decoding; do not claim decoded full-text coverage.\r\n\r\n```json\r\n{\"query\":\"TASK-016\",\"max_results\":20}\r\n```\r\n\r\nFollow next_cursor with the same query. partial is pagination, not failure or permission denial.\r\nA cursor is not an immutable snapshot; concurrent additions may need a fresh search. Unreadable\r\nobjects appear in issues without excluding other files. Do not interpret no hit on one page as\r\nproof no plan, review or user decision exists; current state is a task-status query.\r\n\r\n## Failures, recovery and compatibility\r\n\r\nA real raw I/O failure returns unavailable, recorded=false and exit 1; do not claim it saved.\r\nPreserve output through another authorized means and report unsaved state. A task request with\r\nincomplete meaning can still be recorded with association=unresolved. Offer the relevant\r\nrebuild/link/correct/resolve/defer operation, not hand editing or repeating user approval.\r\nRebuild never reruns tests, execution, git commit or deployment.\r\n\r\nUnsupported legacy/free-text associations are reported with source refs. Supplement the real\r\nmeaning by linking records; do not replay preparation or confirmation. Unknown or conflicting\r\nfacts are not silently selected by latest timestamp. Corrections append, original bytes remain.\r\n\r\nExisting file-context, historical task-read/export, knowledge and evidence APIs remain optional\r\nspecialized tools in CONTEXT_API.md. The compiled CLI's default task-context delegates to the\r\nunified view after the software is rebuilt; --legacy explicitly opts into the old historical\r\nreader, which may not parse the new CURRENT_TASK display. Do not use it for current status or\r\nsend accepted user choices back through old complete/replan/close gates.\r\n## HEAD (no branch)\n M .agents/skills/bootstrap-project/SKILL.md\n M .agents/skills/capture-work-item/SKILL.md\n M .agents/skills/close-task/SKILL.md\n M .agents/skills/debug-task/SKILL.md\n M .agents/skills/execute-step/SKILL.md\n M .agents/skills/git-commit/SKILL.md\n M .agents/skills/prepare-task/SKILL.md\n M .agents/skills/review-change/SKILL.md\n M .agents/skills/review-draft/SKILL.md\n M .agents/skills/task-lifecycle/SKILL.md\n M .agents/skills/validate-change/SKILL.md\n M .workflow-system/WORKFLOW_PROTOCOL.md\n M .workflow-system/runtime/package-lock.json\n M .workflow-system/runtime/package.json\n M .workflow-system/runtime/src/bootstrap-support.ts\n M .workflow-system/runtime/src/cli.ts\n M .workflow-system/runtime/src/kernel.ts\n M .workflow-system/vnext/DISTRIBUTION_STATE.json\n M .workflow-system/vnext/RUNTIME_CONTRACT.yaml\n M AGENTS.md\n M docs/workflow/CURRENT_TASK.md\n M scripts/case-judgment-projection-worker.ts\n M scripts/knowledge-kernel/case-projection-adapter.ts\n M scripts/knowledge-kernel/ep5-rebuild-evidence.md\n M scripts/knowledge-kernel/law-projection-adapter.ts\n M scripts/knowledge-kernel/projection-rebuild.ts\n M scripts/knowledge-kernel/projection-registry.ts\n M tests/knowledge-kernel/embedding.test.ts\n M tests/knowledge-kernel/projection-rebuild.test.ts\n?? .workflow-system/records/\n?? .workflow-system/runtime/src/host-guidance.ts\n?? .workflow-system/runtime/support/ASSISTANCE_API.md\n?? .workflow-system/runtime/support/TASK_MANAGEMENT_API.md\n?? .workflow-system/runtime/support/assistance.mjs\n?? .workflow-system/runtime/support/task-management.mjs\n","started":true,"tool_kind":"local_shell","tool_name":"shell_command"},"turn_id":"01a0ee05-18b3-79a0-8f7f-058e3883b66f","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"call_dKUT1evwPNvm1N1AGvtXTptC","item_key":"tool:call_dKUT1evwPNvm1N1AGvtXTptC","kind":"tool","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"tool","query":null,"question":null,"related_item_key":null,"result":null,"sequence":22000000,"source_ref":{"byte_end":233260,"byte_start":231955,"i