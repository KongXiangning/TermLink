n+      \"checksum\": \"d6c67e7afff955d848b821a4c9dbc8e1b839af4fb6fb4aac4caad98196501934\",\n       \"category\": \"runtime\"\n     },\n     {\n@@ -138,7 +138,7 @@\n     },\n     {\n       \"path\": \".workflow-system/runtime/src/host-guidance.ts\",\n-      \"checksum\": \"926076e5057ddcf7c9b1e985944b97c536f765d03867657e339fba083787fdba\",\n+      \"checksum\": \"274fb72a50cbdbfcd339a2527dcfd76547b786e1a484c6f69d7873ac84dd4bb0\",\n       \"category\": \"runtime\"\n     },\n     {\n@@ -153,7 +153,7 @@\n     },\n     {\n       \"path\": \".workflow-system/runtime/src/kernel.ts\",\n-      \"checksum\": \"e33d75da249cf84791f9dd89319305045eeb8ca3b242c25350271fdae3075bad\",\n+      \"checksum\": \"3914fd356ef02c379d9b2c36118e20b92a5756fb2da463c4b77aeb339c0a4914\",\n       \"category\": \"runtime\"\n     },\n     {\n@@ -253,17 +253,17 @@\n     },\n     {\n       \"path\": \".workflow-system/runtime/support/TASK_MANAGEMENT_API.md\",\n-      \"checksum\": \"70fb1c1e2c6446547592eee1784a5a2547b6530515cf4a772f4a31cd1ec05ac1\",\n+      \"checksum\": \"b768ba3b25cae00198bd2e858cfe7bc09596bd281e6c69e9a482c92e70e7b783\",\n       \"category\": \"runtime\"\n     },\n     {\n       \"path\": \".workflow-system/runtime/support/task-management.mjs\",\n-      \"checksum\": \"a459a1b472b93fd4774461d116d99be47bebc4fcab81dab571cd589b957fbec3\",\n+      \"checksum\": \"c4452a6c39312ca01d8067e49002575cc275bfb055a2c5ff5bc6c153f90fd76d\",\n       \"category\": \"runtime\"\n     },\n     {\n       \"path\": \".workflow-system/vnext/RUNTIME_CONTRACT.yaml\",\n-      \"checksum\": \"6c58743bb2925d2beb48da19297d027090d5faea30bb77be3793182d8fcd14a0\",\n+      \"checksum\": \"a34bc42df4e6e211c55d2ff083a90a5717a6c48511ba3f6fa1121099fb8a3275\",\n       \"category\": \"protocol\"\n     },\n     {\n@@ -273,7 +273,7 @@\n     },\n     {\n       \"path\": \".workflow-system/WORKFLOW_PROTOCOL.md\",\n-      \"checksum\": \"79159d20850908060046665ddd3f00d9198fc9915ef49c54655bff1b39280a7c\",\n+      \"checksum\": \"b7314cf8a146f43362aa854a64c3fd87321f15acf76380bf3cbec2549375485c\",\n       \"category\": \"protocol\"\n     },\n     {\ndiff --git a/.workflow-system/vnext/RUNTIME_CONTRACT.yaml b/.workflow-system/vnext/RUNTIME_CONTRACT.yaml\nindex 8ab0ce1..015a8cb 100644\n--- a/.workflow-system/vnext/RUNTIME_CONTRACT.yaml\n+++ b/.workflow-system/vnext/RUNTIME_CONTRACT.yaml\n@@ -32,7 +32,7 @@ runtime_distribution:\n   package_manifest: .workflow-system/runtime/package.json\n   lockfile: .workflow-system/runtime/package-lock.json\n   package_name: vibe-coding-vnext-runtime\n-  package_version: 0.23.6\n+  package_version: 0.23.7\n   node_min_version: \">=20.0.0\"\n \n task_context:\ndiff --git a/AGENTS.md b/AGENTS.md\nindex 2ab6f7c..0805859 100644\n--- a/AGENTS.md\n+++ b/AGENTS.md\n@@ -1,9 +1,9 @@\n <!-- vnext-assistance-guidance:start -->\n ## vNext workflow assistance\n \n-- Read `.workflow-system/WORKFLOW_PROTOCOL.md` and the selected `.agents/skills/<entry>/SKILL.md`. Their assistance and one-time confirmation rules supersede older workflow admission/terminal instructions; project business constraints remain effective.\n+- On every explicit workflow Skill invocation, read the selected `.agents/skills/<entry>/SKILL.md` from disk again, even in an existing conversation. Read `.workflow-system/WORKFLOW_PROTOCOL.md` for the shared rules. Earlier Skill contents and earlier next_route suggestions are historical context; project business constraints remain effective.\n - Runtime assists recording, evidence, snapshots and lookup. Use `.workflow-system/runtime/support/assistance.mjs` and `ASSISTANCE_API.md`; no mandatory preflight, run-entry, waiver, review receipt, retry budget or legacy state repair is needed for authorized work.\n-- Query `assistance.mjs task-status` or `context.management` for current task/plan/step state. The journal-backed view replaces stale CURRENT_TASK tuples; ordinary `find` pages are not state queries. `task-context --legacy` is historical only.\n+- Query `assistance.mjs task-status` or `context.management` on every workflow invocation for current task/plan/step state, including a repeated invocation in the same conversation. The journal-backed view replaces stale CURRENT_TASK tuples; ordinary `find` pages are not state queries. Report a query failure without turning it into a development gate.\n - Use the assistance `task` actions for prepare/adopt/execution/review/review-decision/step/git/close. Check fact persistence, association and view publication separately; normal state maintenance is not optional. Offer rebuild/link/correct/resolve/defer for unresolved management data, without replaying business work.\n - Read/search/record operations, stale metadata and equivalent details already authorized need no new confirmation. Report actual service failures and continue independent authorized work; never rerun business work just to obtain a receipt.\n - For a material deviation from a still-effective workflow commitment, disclose the action, gaps and concrete consequences together and ask once only if that informed choice is unresolved. Silence is not consent.\n","started":true,"tool_kind":"local_shell","tool_name":"shell_command"},"turn_id":"01a0ee3b-a1bd-7393-ace7-9009d7c7f2eb","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"call_zyiEM0bPhMdEQZNPE5uANtzE","item_key":"tool:call_zyiEM0bPhMdEQZNPE5uANtzE","kind":"tool","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"tool","query":null,"question":null,"related_item_key":null,"result":null,"sequence":193000000,"source_ref":{"byte_end":1169121,"byte_start":1168046,"item_type":"response_item/custom_tool_call","physical_line_ordinal":193,"rollout_ordinal":192,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T17:35:08.615Z"},"summary":null,"timestamp":"2026-09-29T17:35:08.615Z","tool":{"availability":"present","call_id":"call_zyiEM0bPhMdEQZNPE5uANtzE","completed":true,"input":"const r = await tools.exec_command({\n  cmd: \"Get-Content .workflow-system/WORKFLOW_PROTOCOL.md; Get-Content .agents/skills/git-commit/SKILL.md; $raw = node .workflow-system/runtime/support/assistance.mjs task-status --root E:\\\\coding\\\\LawAgent; $o = $raw | ConvertFrom-Json; $t = $o.current_task; [pscustomobject]@{task_id=$t.display_id; title=$t.title; current_step_id=$t.current_step_id; next_route=$t.next_route; next_mode=$t.next_mode; next_action=$t.next_action; health=$o.health; issues=$o.issues.Count} | ConvertTo-Json -Depth 4\",\n  workdir: \"E:\\\\coding\\\\LawAgent\",\n  shell: \"powershell\",\n  login: false,\n  max_output_tokens: 10000\n});\ntext(r.output);\n","outcome":"completed","output":"[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.8 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"---\\r\\nschema_version: 1\\r\\nkind: vnext-protocol\\r\\n---\\r\\n\\r\\n# vNext: assistance-first workflow\\r\\n\\r\\n## Governing purpose\\r\\n\\r\\nRuntime is a management service, not a development admission authority. User\\r\\ninstructions and the selected Skill determine scope and actions. Management\\r\\nfailures, stale evidence, incomplete reviews, legacy states and unfilled slots\\r\\nmust not prevent reading history, retaining new facts or continuing otherwise\\r\\nauthorized work. This protocol supersedes older mandatory workflow gate and\\r\\ninternal-recovery instructions for daily development.\\r\\n\\r\\nThe default API is `.workflow-system/runtime/support/assistance.mjs`. See\\r\\n`.workflow-system/runtime/support/ASSISTANCE_API.md` for inputs and outputs. Its\\r\\nnative Node modules run without the transaction kernel or npm dependencies.\\r\\n\\r\\n## Keep facts separate from qualifications\\r\\n\\r\\nRetain the observation first. Associate it with a task, plan, test and source\\r\\nrevision using the actual available information. Missing associations are gaps,\\r\\nnot fabricated IDs and not a reason to lose a report. Old evidence remains the\\r\\nrecord of its original subject. Current applicability can be unknown or stale\\r\\nwithout making historical contents unreadable or prohibiting new work.\\r\\n\\r\\nPASS, clean, resolved and verified are claims supported by evidence, not automatic\\r\\nconsequences of a successful record write or a user decision to continue/close.\\r\\nRecord whose observation it is. Self-review is not independent review.\\r\\n\\r\\n## Work and tools\\r\\n\\r\\nNo mandatory run-entry, preflight, Runtime-owned active tuple, evidence-plan\\r\\nmigration, waiver, retry budget or review receipt is needed for ordinary work.\\r\\nAn optional snapshot can capture before/after bytes. Existing specialized tools\\r\\nremain available; their own refusal is a failed service operation, not a workflow\\r\\nveto. Do not loop through repairs of the control plane before returning to work.\\r\\n\\r\\nKeep the user's actual authorization, explicit exclusions and external effects\\r\\nclear. Discovery is not write permission. Ask only when a genuinely unresolved\\r\\nuser-owned choice changes the requested work. Do not invent a new user quote,\\r\\npermission, risk acceptance or test result.\\r\\n\\r\\n## One-time confirmation for workflow deviations\\r\\n\\r\\nThis applies to every entry and mode, not only review, approval or closure. When an\\r\\nold gate would have stopped work, identify its real consequence rather than restoring\\r\\nthe gate. Use the latest applicable user instructions, plan, execution, review and\\r\\ndisposition records; an unsynchronized CURRENT_TASK alone does not prove a missing\\r\\nreview or a new conflict. Superseded workflow rules do not regain authority.\\r\\n\\r\\n**Continue without confirmation** for record/read/search operations, stale receipts,\\r\\nmissing metadata, index repair and equivalent implementation details already covered\\r\\nby the request. Preserve gaps and use available authorized tools; neither those\\r\\nconditions nor an old error code creates a user decision. Never rerun work just to\\r\\nmake a record fit. A real business/I/O failure must still be reported truthfully.\\r\\n\\r\\n**Ask once before the affected action** when it materially departs from an applicable\\r\\nworkflow commitment and the user has not already made that informed choice. Examples\\r\\ninclude finishing without the expected review or checks, proceeding with unresolved\\r\\nfindings, changing planned scope/acceptance/validation, changing execution order or\\r\\nretry policy, replacing or stopping unfinished work, and replacing independent review\\r\\nwith self-review. These are examples, not a closed list. Do not solicit an unrelated\\r\\nexception or expand the task merely because one is possible.\\r\\n\\r\\nState the intended action, expected workflow, actual gap and concrete consequences.\\r\\nBundle all currently known deviations for that action into one understandable question;\\r\\ninclude the proposed action and a meaningful alternative, not internal gate IDs.\\r\\nWait only for that choice: silence is not consent and the proposed action has not\\r\\nhappened. Independent authorized reading/recording remains available. If the user's\\r\\ncurrent request or still-effective earlier instruction already explicitly covers the\\r\\nsame action and disclosed consequences, use it without asking the same question again.\\r\\nA bare \\\"complete the task\\\", test PASS or next_route is not informed deviation consent.\\r\\n\\r\\nAfter confirmation, carry out exactly the chosen action, including any authorized\\r\\nremaining stages, without requiring another Skill invocation, a waiver receipt,\\r\\nclean review, legacy state repair or another approval for the same disclosed gap.\\r\\nRecord the actual outcome, not just the decision. For step/task disposition use the\\r\\nassistance journal; do not send the choice back through an incompatible legacy\\r\\ncomplete/advance/close gate. Completion of work and verification remain separate.\\r\\nConfirmation never turns failed/not-run/unknown into PASS or self-review into independent\\r\\nreview. It authorizes only the chosen work; file changes, deletion, commit or deployment\\r\\noutside its disclosed scope remain unauthorized.\\r\\n\\r\\nReuse a decision for the same target, action and disclosed consequences, including\\r\\nacross sessions. Check actual relevant changes, not a global revision or time-to-live.\\r\\nAudit additions, reindexing, equivalent receipt refresh or switching sessions alone do\\r\\nnot invalidate it. Ask again only about material new consequences, a changed target or\\r\\naction, or a revised/revoked instruction; show what changed. A prior one-step decision\\r\\nis not blanket permission for later work. Do not invent earlier consent if unavailable.\\r\\n\\r\\nKeep the user's actual source/text separate from the agent's summary. Use existing\\r\\n`record` with kind `decision`, plus links from the later outcome; include the target,\\r\\nchoice, disclosed gaps and scope as available. These are recording conventions, not\\r\\nrequired token fields or Runtime authorization. A recording failure does not revoke\\r\\na choice still available in the conversation: report it and use another authorized\\r\\nrecording method. Never claim the journal or legacy projection was updated when not.\\r\\n\\r\\n## Unified task management\\r\\n\\r\\nNon-blocking does not mean unmanaged. Use assistance `task` actions for task\\r\\npreparation, adoption, execution, tests, reviews, review disposition, explicit Git associations\\r\\nand lifecycle. Read `TASK_MANAGEMENT_API.md` for their association fields and recovery.\\r\\nAt every explicit workflow Skill invocation, reread the selected project-local\\r\\n`SKILL.md` from disk and query the current `task-status` or `context.management`,\\r\\neven when the same conversation invoked it earlier. Earlier Skill text and route\\r\\nsuggestions are historical context. Report a failed state query truthfully and\\r\\ncontinue independent authorized work rather than treating it as a development gate.\\r\\nA new prepare allocates stable identity and a display number; a revision keeps identity.\\r\\nAdoption chooses the exact plan, initializes work position and maintains focus.\\r\\nReview is not adoption; execution is not review; user disposition is not PASS.\\r\\nA close updates the task view and removes that task from active focus, keeping gaps.\\r\\n\\r\\nGit's own history is the source for commit facts. An ordinary commit ends with read-only\\r\\nGit verification and reporting its SHA; it does not require a journal entry or view update.\\r\\n`task git` is an optional write for an explicitly requested task/commit association, not\\r\\nan automatic post-commit step. Missing journal commit entries alone justify neither\\r\\nanother commit nor recovery work. Never create a chain of commits recording their own SHA.\\r\\n\\r\\nEvery state question uses `task-status` / `context.management`. They recompute from\\r\\nthe complete retained journal. A generic find page or old CURRENT_TASK is not current\\r\\nstate. Report partial associations instead of concluding an unlinked plan never existed.\\r\\nCURRENT_TASK is the generated human-readable view; its previous bytes and old task\\r\\nstore remain historical sources. The old task kernel is not a writer of this display.\\r\\n\\r\\nNormal view maintenance belongs to each task operation. Check fact persistence,\\r\\nassociation and projection separately; a saved note is not full task-management\\r\\ncompletion. On a deterministic view failure try bounded rebuild, never business replay.\\r\\nFor missing meaning/conflict offer link, correct, resolve or defer; user-facing Skills\\r\\nexplain the actual choices and fill references. Keep the original records/decisions.\\r\\nDefer preserves known uncertainty; it does not mark it resolved. An existing valid\\r\\nchoice does not need another approval merely because the cache or view changed.\\r\\nIf display content was edited, preserve it and ask only about an actual overwrite.\\r\\nRead-only status computes in memory and never writes a cache.\\r\\n\\r\\nThis section supersedes older guidance that left current task maintenance optional.\\r\\nLegacy archive mirrors may remain historical; the current task view must not remain\\r\\nsilently stale. Compiled task-context defaults to this view; --legacy is historical.\\r\\n\\r\\n## Lifecycle and review\\r\\n\\r\\nPreparation, execution, review and disposition are distinct observations. New\\r\\nplans and corrections link previous plans and preserve their history. Lifecycle\\r\\nchanges record user intent without forcing unfinished work to be completed first.\\r\\nUse One-time confirmation for workflow deviations for unresolved choices before\\r\\nirreversible or incomplete termination; an already sufficient decision is reused.\\r\\nClosure neither rolls back code nor grants Git/deployment permission.\\r\\n\\r\\nBy default execute includes implementation self-check, not a fresh formal review.\\r\\nCreating a review requires an instruction that actually covers it; an explicit\\r\\ncombined request may be completed in one interaction. Report self-review honestly.\\r\\nA public result always reports one `next_route`: a public Skill ID or `null`,\\r\\nwith a brief reason based on the actual outcome and remaining work. Use `null`\\r\\nwhen no public Skill is justified. Complete stages already authorized by the\\r\\nuser before choosing the route. The route is advice, never an exclusive permitted\\r\\nnext action or authorization to perform it.\\r\\n\\r\\n## Evidence and tests\\r\\n\\r\\nKeep actual command output, selectors, source version and failed/not-run outcomes.\\r\\nReuse useful existing evidence. Select minimum-sufficient validation from the real\\r\\nchanged behavior and the user's limits. No automatic E2E, new permanent test,\\r\\nfull-suite rerun or expanded validation merely to satisfy management metadata.\\r\\nThe project's test-admission-policy remains methodological guidance, not a gate\\r\\nthat must be repaired before facts can be retained.\\r\\n\\r\\n## Persistence failures\\r\\n\\r\\nNever claim a failed write succeeded, overwrite unknown history, or silently\\r\\nrestore user files. Return precise I/O errors for the specific service operation.\\r\\nPreserve output elsewhere when authorized; report unpersisted/unreconciled work.\\r\\nContinue independent authorized work. A damaged index/projection is not proof\\r\\nthat historical objects or unrelated records are unavailable.\\r\\n\\r\\n## Existing data and compatibility tools\\r\\n\\r\\nExisting Task Store, task-data, task-history, evidence blobs, test reports,\\r\\nknowledge records and document lookup remain available; no task reset or forced\\r\\nrebootstrap is required. The new append-only journal extends retained management\\r\\nfacts. A preserved old baseline and generated current view replace the obsolete active\\r\\ndisplay without rewriting old evidence. The journal, labels and views are project data,\\r\\nnever distribution-owned artifacts.\\r\\n\\r\\nThe capability and runtime_operations lists in existing entry metadata and\\r\\nSOURCE_CONTRACT/RUNTIME_CONTRACT enumerate compatible tools. They are not a list\\r\\nof admission checks each invocation must pass. Their specialized transactional\\r\\nrequirements describe those optional calls only, not the default development path.\\r\\nHistorical transactional instructions are in support/CONTEXT_API.md.\\r\\n---\\r\\nname: git-commit\\r\\ndescription: 'git-commit: carry out the requested work with non-blocking management assistance.'\\r\\nentry_contract:\\r\\n  entry: git-commit\\r\\n  mode: []\\r\\n  intent: Assist the user's git-commit request without workflow admission.\\r\\n  input_contract:\\r\\n    required:\\r\\n      - repository\\r\\n      - intended_changes\\r\\n    optional:\\r\\n      - preferred_message\\r\\n      - workflow_result\\r\\n  authority_owner: user\\r\\n  mutation_boundary:\\r\\n    product_files: []\\r\\n    governance_sources: []\\r\\n    forbidden_targets:\\r\\n      - unrequested external effects\\r\\n      - unrelated user files\\r\\n      - silent overwrites of immutable history\\r\\n  internal_capabilities:\\r\\n    - dangerous-operation-gate\\r\\n  runtime_operations: []\\r\\n  stop_conditions:\\r\\n    - a genuinely unresolved user-owned choice prevents the requested work\\r\\n    - a real business prerequisite is unavailable; management failures do not prohibit independent work\\r\\n  output_kind: git-commit-result\\r\\n---\\r\\n\\r\\n# vNext Skill: git-commit\\r\\n\\r\\n## Default runtime role\\r\\n\\r\\nruntime_role: assistance/v1\\r\\n\\r\\nFollow `.workflow-system/WORKFLOW_PROTOCOL.md` and the management API in\\r\\n`.workflow-system/runtime/support/ASSISTANCE_API.md`. Use the native service:\\r\\n`node .workflow-system/runtime/support/assistance.mjs <command> --root <project>`.\\r\\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\\r\\n\\r\\nUse `task-status` (or the `context.management` view) to identify the task, adopted\\r\\nplan, step, review/disposition and actual commits. It reads the complete journal,\\r\\nnot one search page or the old CURRENT_TASK tuple. `find`/`read` remain evidence tools.\\r\\nFor task lifecycle changes use `task` actions documented in ASSISTANCE_API; raw\\r\\n`record` is for general observations, not a substitute for task registration.\\r\\nGit itself records a commit. A commit request alone requires no task-management write.\\r\\nFor explicitly requested task-management writes, check `recorded`, `association`\\r\\nand `projection` separately.\\r\\nIf an association/view update fails, retain facts, try a bounded deterministic rebuild\\r\\nwhen appropriate, and present concrete link/correct/resolve/defer choices. Honor the\\r\\nchosen recovery without repeating business actions or asking again for existing consent.\\r\\nA read-only request uses live task-status without writing a cache. Never declare\\r\\nfull task-management completion merely because a generic record was saved.\\r\\n\\r\\nIf a management operation fails, preserve its actual error and any output already\\r\\nsaved; use another authorized recording method when available and continue\\r\\nindependent authorized work. Do not retry unchanged calls, rerun business commands,\\r\\ninvent IDs/PASS or claim persistence succeeded. Ask only about a genuinely unresolved\\r\\nuser choice or unavailable business prerequisite, not an internal gate code.\\r\\n\\r\\n## Workflow deviations\\r\\n\\r\\nApply **One-time confirmation for workflow deviations** in WORKFLOW_PROTOCOL for\\r\\nall materially affected actions, not only approvals. Combine known consequences,\\r\\nreuse an applicable explicit decision, then execute the user's chosen action without\\r\\nlegacy admission or repeated confirmation. Pure management errors need no consent;\\r\\nreport real gaps without making them PASS. Pause only an unresolved user choice.\\r\\n\\r\\n## Method\\r\\n\\r\\nInspect git status and diff, preserve unrelated user changes, and identify the exact\\r\\nrequested commit scope. Only an actual instruction to commit authorizes a commit;\\r\\na next_route recommendation is not that instruction. Do not require a Runtime\\r\\ncompleted/clean/archived tuple before honoring an authorized commit.\\r\\n\\r\\nCommit only authorized paths and report the actual Git result. Do not push, amend,\\r\\nreset, clean, force or bypass host security unless specifically authorized. Existing\\r\\nGit hooks may report their own failures; do not call them Runtime qualification.\\r\\nAfter committing, inspect Git read-only and report the actual SHA, committed scope and\\r\\nremaining working-tree changes. Do not automatically call `task git`, `record`, `rebuild`\\r\\nor refresh CURRENT_TASK merely to report this commit. Missing journal Git observations\\r\\ndo not mean the commit is missing and do not require supplementation or another commit.\\r\\nAfter a successful commit, read task-status and use its current unfinished stage\\r\\nfor the result's `next_route` (normally `execute-step` for the next step, or\\r\\n`close-task` when the task has no unfinished step). Do not repeat an earlier\\r\\nexecute-step Git recommendation solely because no `task git` association exists.\\r\\nIf no commit was made, report why and do not imply the Git checkpoint completed.\\r\\n\\r\\nUse `task` action `git` only when the user explicitly requests a persisted task/execution\\r\\nassociation (including an already agreed explicit recording policy). This action writes\\r\\nmanagement files even though its Git-object check is read-only. Report those writes as\\r\\nthe requested association result; never recursively commit them to record their own SHA.\\r\\nIf that optional write fails, report the real SHA and the association failure separately.\\r\\n\\r\\nIf the requested commit departs from an actual agreed review/test prerequisite, use\\r\\none combined consequence confirmation, not a demand to repair Runtime status. Then\\r\\ncommit the authorized files even with disclosed gaps retained in the report. Consent\\r\\nfor this commit neither grants push/deployment nor bypasses host access controls.\\r\\n\\r\\n## Result\\r\\n\\r\\nReturn the actual requested result, affected scope, evidence/record references,\\r\\nremaining work and any unsaved/unreconciled data. Preserve existing user decisions\\r\\nand exclusions; an explicit read-only request remains read-only. A record's successful\\r\\nwrite does not certify the product or expand authorization.\\r\\n\\r\\nAlways include `next_route` in the final result: one public Skill ID or `null`,\\r\\nwith a brief reason. Choose it from the actual outcome and remaining work; use\\r\\n`next_route: null` when no public Skill is justified. Finish any further stages\\r\\nalready covered by the user's instruction before choosing the route. The route is\\r\\nadvice, not permission or the only allowed next action. Do not invoke it solely\\r\\nbecause it was recommended or widen validation or external effects without authorization.\\r\\n\\r\\nterminal_boundary: public-entry-terminal/v1\\r\\n{\\r\\n  \\\"task_id\\\": \\\"TASK-017\\\",\\r\\n  \\\"title\\\": \\\"knowledge-kernel-ep5-m5-search-ep6\\\",\\r\\n  \\\"current_step_id\\\": \\\"S3\\\",\\r\\n  \\\"next_route\\\": \\\"execute-step\\\",\\r\\n  \\\"next_mode\\\": \\\"finish\\\",\\r\\n  \\\"next_action\\\": \\\"finish-step\\\",\\r\\n  \\\"health\\\": \\\"needs-attention\\\",\\r\\n  \\\"issues\\\": 1\\r\\n}\\r\\n\"}]","started":true,"tool_kind":"custom_tool_call","tool_name":"exec"},"turn_id":"01a0ee3b-a1bd-7393-ace7-9009d7c7f2eb","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"exec-edda3d5d-648a-472f-9ab8-202e869442c1","item_key":"tool:exec-edda3d5d-648a-472f-9ab8-202e869442c1","kind":"tool","media_type":null,"path":null,"plan":null,"plan_action":null,"presentation_kind":"tool","query":null,"question":null,"related_item_key":null,"result":null,"sequence":195000000,"source_ref":{"byte_end":1229121,"byte_start":1170009,"item_type":"event_msg/item_completed","physical_line_ordinal":195,"rollout_ordinal":194,"source_identity":"01a0ee04-a775-72b3-bd07-04aac804a3b4","timestamp":"2026-09-29T17:35:09.406Z"},"summary":null,"timestamp":"2026-09-29T17:35:09.406Z","tool":{"availability":"present","call_id":"exec-edda3d5d-648a-472f-9ab8-202e869442c1","completed":true,"input":"{\"command\":[\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\",\"-NoProfile\",\"-Command\",\"Get-Content .workflow-system/WORKFLOW_PROTOCOL.md; Get-Content .agents/skills/git-commit/SKILL.md; $raw = node .workflow-system/runtime/support/assistance.mjs task-status --root E:\\\\coding\\\\LawAgent; $o = $raw | ConvertFrom-Json; $t = $o.current_task; [pscustomobject]@{task_id=$t.display_id; title=$t.title; current_step_id=$t.current_step_id; next_route=$t.next_route; next_mode=$t.next_mode; next_action=$t.next_action; health=$o.health; issues=$o.issues.Count} | ConvertTo-Json -Depth 4\"],\"cwd\":\"file:///E:/coding/LawAgent\"}","outcome":"completed","output":"status=completed; exit_code=0; duration_ms=609; output=---\r\nschema_version: 1\r\nkind: vnext-protocol\r\n---\r\n\r\n# vNext: assistance-first workflow\r\n\r\n## Governing purpose\r\n\r\nRuntime is a management service, not a development admission authority. User\r\ninstructions and the selected Skill determine scope and actions. Management\r\nfailures, stale evidence, incomplete reviews, legacy states and unfilled slots\r\nmust not prevent reading history, retaining new facts or continuing otherwise\r\nauthorized work. This protocol supersedes older mandatory workflow gate and\r\ninternal-recovery instructions for daily development.\r\n\r\nThe default API is `.workflow-system/runtime/support/assistance.mjs`. See\r\n`.workflow-system/runtime/support/ASSISTANCE_API.md` for inputs and outputs. Its\r\nnative Node modules run without the transaction kernel or npm dependencies.\r\n\r\n## Keep facts separate from qualifications\r\n\r\nRetain the observation first. Associate it with a task, plan, test and source\r\nrevision using the actual available information. Missing associations are gaps,\r\nnot fabricated IDs and not a reason to lose a report. Old evidence remains the\r\nrecord of its original subject. Current applicability can be unknown or stale\r\nwithout making historical contents unreadable or prohibiting new work.\r\n\r\nPASS, clean, resolved and verified are claims supported by evidence, not automatic\r\nconsequences of a successful record write or a user decision to continue/close.\r\nRecord whose observation it is. Self-review is not independent review.\r\n\r\n## Work and tools\r\n\r\nNo mandatory run-entry, preflight, Runtime-owned active tuple, evidence-plan\r\nmigration, waiver, retry budget or review receipt is needed for ordinary work.\r\nAn optional snapshot can capture before/after bytes. Existing specialized tools\r\nremain available; their own refusal is a failed service operation, not a workflow\r\nveto. Do not loop through repairs of the control plane before returning to work.\r\n\r\nKeep the user's actual authorization, explicit exclusions and external effects\r\nclear. Discovery is not write permission. Ask only when a genuinely unresolved\r\nuser-owned choice changes the requested work. Do not invent a new user quote,\r\npermission, risk acceptance or test result.\r\n\r\n## One-time confirmation for workflow deviations\r\n\r\nThis applies to every entry and mode, not only review, approval or closure. When an\r\nold gate would have stopped work, identify its real consequence rather than restoring\r\nthe gate. Use the latest applicable user instructions, plan, execution, review and\r\ndisposition records; an unsynchronized CURRENT_TASK alone does not prove a missing\r\nreview or a new conflict. Superseded workflow rules do not regain authority.\r\n\r\n**Continue without confirmation** for record/read/search operations, stale receipts,\r\nmissing metadata, index repair and equivalent implementation details already covered\r\nby the request. Preserve gaps and use available authorized tools; neither those\r\nconditions nor an old error code creates a user decision. Never rerun work just to\r\nmake a record fit. A real business/I/O failure must still be reported truthfully.\r\n\r\n**Ask once before the affected action** when it materially departs from an applicable\r\nworkflow commitment and the user has not already made that informed choice. Examples\r\ninclude finishing without the expected review or checks, proceeding with unresolved\r\nfindings, changing planned scope/acceptance/validation, changing execution order or\r\nretry policy, replacing or stopping unfinished work, and replacing independent review\r\nwith self-review. These are examples, not a closed list. Do not solicit an unrelated\r\nexception or expand the task merely because one is possible.\r\n\r\nState the intended action, expected workflow, actual gap and concrete consequences.\r\nBundle all currently known deviations for that action into one understandable question;\r\ninclude the proposed action and a meaningful alternative, not internal gate IDs.\r\nWait only for that choice: silence is not consent and the proposed action has not\r\nhappened. Independent authorized reading/recording remains available. If the user's\r\ncurrent request or still-effective earlier instruction already explicitly covers the\r\nsame action and disclosed consequences, use it without asking the same question again.\r\nA bare \"complete the task\", test PASS or next_route is not informed deviation consent.\r\n\r\nAfter confirmation, carry out exactly the chosen action, including any authorized\r\nremaining stages, without requiring another Skill invocation, a waiver receipt,\r\nclean review, legacy state repair or another approval for the same disclosed gap.\r\nRecord the actual outcome, not just the decision. For step/task disposition use the\r\nassistance journal; do not send the choice back through an incompatible legacy\r\ncomplete/advance/close gate. Completion of work and verification remain separate.\r\nConfirmation never turns failed/not-run/unknown into PASS or self-review into independent\r\nreview. It authorizes only the chosen work; file changes, deletion, commit or deployment\r\noutside its disclosed scope remain unauthorized.\r\n\r\nReuse a decision for the same target, action and disclosed consequences, including\r\nacross sessions. Check actual relevant changes, not a global revision or time-to-live.\r\nAudit additions, reindexing, equivalent receipt refresh or switching sessions alone do\r\nnot invalidate it. Ask again only about material new consequences, a changed target or\r\naction, or a revised/revoked instruction; show what changed. A prior one-step decision\r\nis not blanket permission for later work. Do not invent earlier consent if unavailable.\r\n\r\nKeep the user's actual source/text separate from the agent's summary. Use existing\r\n`record` with kind `decision`, plus links from the later outcome; include the target,\r\nchoice, disclosed gaps and scope as available. These are recording conventions, not\r\nrequired token fields or Runtime authorization. A recording failure does not revoke\r\na choice still available in the conversation: report it and use another authorized\r\nrecording method. Never claim the journal or legacy projection was updated when not.\r\n\r\n## Unified task management\r\n\r\nNon-blocking does not mean unmanaged. Use assistance `task` actions for task\r\npreparation, adoption, execution, tests, reviews, review disposition, explicit Git associations\r\nand lifecycle. Read `TASK_MANAGEMENT_API.md` for their association fields and recovery.\r\nAt every explicit workflow Skill invocation, reread the selected project-local\r\n`SKILL.md` from disk and query the current `task-status` or `context.management`,\r\neven when the same conversation invoked it earlier. Earlier Skill text and route\r\nsuggestions are historical context. Report a failed state query truthfully and\r\ncontinue independent authorized work rather than treating it as a development gate.\r\nA new prepare allocates stable identity and a display number; a revision keeps identity.\r\nAdoption chooses the exact plan, initializes work position and maintains focus.\r\nReview is not adoption; execution is not review; user disposition is not PASS.\r\nA close updates the task view and removes that task from active focus, keeping gaps.\r\n\r\nGit's own history is the source for commit facts. An ordinary commit ends with read-only\r\nGit verification and reporting its SHA; it does not require a journal entry or view update.\r\n`task git` is an optional write for an explicitly requested task/commit association, not\r\nan automatic post-commit step. Missing journal commit entries alone justify neither\r\nanother commit nor recovery work. Never create a chain of commits recording their own SHA.\r\n\r\nEvery state question uses `task-status` / `context.management`. They recompute from\r\nthe complete retained journal. A generic find page or old CURRENT_TASK is not current\r\nstate. Report partial associations instead of concluding an unlinked plan never existed.\r\nCURRENT_TASK is the generated human-readable view; its previous bytes and old task\r\nstore remain historical sources. The old task kernel is not a writer of this display.\r\n\r\nNormal view maintenance belongs to each task operation. Check fact persistence,\r\nassociation and projection separately; a saved note is not full task-management\r\ncompletion. On a deterministic view failure try bounded rebuild, never business replay.\r\nFor missing meaning/conflict offer link, correct, resolve or defer; user-facing Skills\r\nexplain the actual choices and fill references. Keep the original records/decisions.\r\nDefer preserves known uncertainty; it does not mark it resolved. An existing valid\r\nchoice does not need another approval merely because the cache or view changed.\r\nIf display content was edited, preserve it and ask only about an actual overwrite.\r\nRead-only status computes in memory and never writes a cache.\r\n\r\nThis section supersedes older guidance that left current task maintenance optional.\r\nLegacy archive mirrors may remain historical; the current task view must not remain\r\nsilently stale. Compiled task-context defaults to this view; --legacy is historical.\r\n\r\n## Lifecycle and review\r\n\r\nPreparation, execution, review and disposition are distinct observations. New\r\nplans and corrections link previous plans and preserve their history. Lifecycle\r\nchanges record user intent without forcing unfinished work to be completed first.\r\nUse One-time confirmation for workflow deviations for unresolved choices before\r\nirreversible or incomplete termination; an already sufficient decision is reused.\r\nClosure neither rolls back code nor grants Git/deployment permission.\r\n\r\nBy default execute includes implementation self-check, not a fresh formal review.\r\nCreating a review requires an instruction that actually covers it; an explicit\r\ncombined request may be completed in one interaction. Report self-review honestly.\r\nA public result always reports one `next_route`: a public Skill ID or `null`,\r\nwith a brief reason based on the actual outcome and remaining work. Use `null`\r\nwhen no public Skill is justified. Complete stages already authorized by the\r\nuser before choosing the route. The route is advice, never an exclusive permitted\r\nnext action or authorization to perform it.\r\n\r\n## Evidence and tests\r\n\r\nKeep actual command output, selectors, source version and failed/not-run outcomes.\r\nReuse useful existing evidence. Select minimum-sufficient validation from the real\r\nchanged behavior and the user's limits. No automatic E2E, new permanent test,\r\nfull-suite rerun or expanded validation merely to satisfy management metadata.\r\nThe project's test-admission-policy remains methodological guidance, not a gate\r\nthat must be repaired before facts can be retained.\r\n\r\n## Persistence failures\r\n\r\nNever claim a failed write succeeded, overwrite unknown history, or silently\r\nrestore user files. Return precise I/O errors for the specific service operation.\r\nPreserve output elsewhere when authorized; report unpersisted/unreconciled work.\r\nContinue independent authorized work. A damaged index/projection is not proof\r\nthat historical objects or unrelated records are unavailable.\r\n\r\n## Existing data and compatibility tools\r\n\r\nExisting Task Store, task-data, task-history, evidence blobs, test reports,\r\nknowledge records and document lookup remain available; no task reset or forced\r\nrebootstrap is required. The new append-only journal extends retained management\r\nfacts. A preserved old baseline and generated current view replace the obsolete active\r\ndisplay without rewriting old evidence. The journal, labels and views are project data,\r\nnever distribution-owned artifacts.\r\n\r\nThe capability and runtime_operations lists in existing entry metadata and\r\nSOURCE_CONTRACT/RUNTIME_CONTRACT enumerate compatible tools. They are not a list\r\nof admission checks each invocation must pass. Their specialized transactional\r\nrequirements describe those optional calls only, not the default development path.\r\nHistorical transactional instructions are in support/CONTEXT_API.md.\r\n---\r\nname: git-commit\r\ndescription: 'git-commit: carry out the requested work with non-blocking management assistance.'\r\nentry_contract:\r\n  entry: git-commit\r\n  mode: []\r\n  intent: Assist the user's git-commit request without workflow admission.\r\n  input_contract:\r\n    required:\r\n      - repository\r\n      - intended_changes\r\n    optional:\r\n      - preferred_message\r\n      - workflow_result\r\n  authority_owner: user\r\n  mutation_boundary:\r\n    product_files: []\r\n    governance_sources: []\r\n    forbidden_targets:\r\n      - unrequested external effects\r\n      - unrelated user files\r\n      - silent overwrites of immutable history\r\n  internal_capabilities:\r\n    - dangerous-operation-gate\r\n  runtime_operations: []\r\n  stop_conditions:\r\n    - a genuinely unresolved user-owned choice prevents the requested work\r\n    - a real business prerequisite is unavailable; management failures do not prohibit independent work\r\n  output_kind: git-commit-result\r\n---\r\n\r\n# vNext Skill: git-commit\r\n\r\n## Default runtime role\r\n\r\nruntime_role: assistance/v1\r\n\r\nFollow `.workflow-system/WORKFLOW_PROTOCOL.md` and the management API in\r\n`.workflow-system/runtime/support/ASSISTANCE_API.md`. Use the native service:\r\n`node .workflow-system/runtime/support/assistance.mjs <command> --root <project>`.\r\nSource-repository equivalent: `node runtime/vnext/support/assistance.mjs`.\r\n\r\nUse `task-status` (or the `context.management` view) to identify the task, adopted\r\nplan, step, review/disposition and actual commits. It reads the complete journal,\r\nnot one search page or the old CURRENT_TASK tuple. `find`/`read` remain evidence tools.\r\nFor task lifecycle changes use `task` actions documented in ASSISTANCE_API; raw\r\n`record` is for general observations, not a substitute for task registration.\r\nGit itself records a commit. A commit request alone requires no task-management write.\r\nFor explicitly requested task-management writes, check `recorded`, `association`\r\nand `projection` separately.\r\nIf an association/view update fails, retain facts, try a bounded deterministic rebuild\r\nwhen appropriate, and present concrete link/correct/resolve/defer choices. Honor the\r\nchosen recovery without repeating business actions or asking again for existing consent.\r\nA read-only request uses live task-status without writing a cache. Never declare\r\nfull task-management completion merely because a generic record was saved.\r\n\r\nIf a management operation fails, preserve its actual error and any output already\r\nsaved; use another authorized recording method when available and continue\r\nindependent authorized work. Do not retry unchanged calls, rerun business commands,\r\ninvent IDs/PASS or claim persistence succeeded. Ask only about a genuinely unresolved\r\nuser choice or unavailable business prerequisite, not an internal gate code.\r\n\r\n## Workflow deviations\r\n\r\nApply **One-time confirmation for workflow deviations** in WORKFLOW_PROTOCOL for\r\nall materially affected actions, not only approvals. Combine known consequences,\r\nreuse an applicable explicit decision, then execute the user's chosen action without\r\nlegacy admission or repeated confirmation. Pure management errors need no consent;\r\nreport real gaps without making them PASS. Pause only an unresolved user choice.\r\n\r\n## Method\r\n\r\nInspect git status and diff, preserve unrelated user changes, and identify the exact\r\nrequested commit scope. Only an actual instruction to commit authorizes a commit;\r\na next_route recommendation is not that instruction. Do not require a Runtime\r\ncompleted/clean/archived tuple before honoring an authorized commit.\r\n\r\nCommit only authorized paths and report the actual Git result. Do not push, amend,\r\nreset, clean, force or bypass host security unless specifically authorized. Existing\r\nGit hooks may report their own failures; do not call them Runtime qualification.\r\nAfter committing, inspect Git read-only and report the actual SHA, committed scope and\r\nremaining working-tree changes. Do not automatically call `task git`, `record`, `rebuild`\r\nor refresh CURRENT_TASK merely to report this commit. Missing journal Git observations\r\ndo not mean the commit is missing and do not require supplementation or another commit.\r\nAfter a successful commit, read task-status and use its current unfinished stage\r\nfor the result's `next_route` (normally `execute-step` for the next step, or\r\n`close-task` when the task has no unfinished step). Do not repeat an earlier\r\nexecute-step Git recommendation solely because no `task git` association exists.\r\nIf no commit was made, report why and do not imply the Git checkpoint completed.\r\n\r\nUse `task` action `git` only when the user explicitly requests a persisted task/execution\r\nassociation (including an already agreed explicit recording policy). This action writes\r\nmanagement files even though its Git-object check is read-only. Report those writes as\r\nthe requested association result; never recursively commit them to record their own SHA.\r\nIf that optional write fails, report the real SHA and the association failure separately.\r\n\r\nIf the requested commit departs from an actual agreed review/test prerequisite, use\r\none combined consequence confirmation, not a demand to repair Runtime status. Then\r\ncommit the authorized files even with disclosed gaps retained in the report. Consent\r\nfor this commit neither grants push/deployment nor bypasses host access controls.\r\n\r\n## Result\r\n\r\nReturn the actual requested result, affected scope, evidence/record references,\r\nremaining work and any unsaved/unreconciled data. Preserve existing user decisions\r\nand exclusions; an explicit read-only request remains read-only. A record's successful\r\nwrite does not certify the product or expand authorization.\r\n\r\nAlways include `next_route` in the final result: one public Skill ID or `null`,\r\nwith a brief reason. Choose it from the actual outcome and remaining work; use\r\n`next_route: null` when no public Skill is justified. Finish any further stages\r\nalready covered by the user's instruction before choosing the route. The route is\r\nadvice, not permission or the only allowed next action. Do not invoke it solely\r\nbecause it was recommended or widen validation or external effects without authorization.\r\n\r\nterminal_boundary: public-entry-terminal/v1\r\n{\r\n  \"task_id\": \"TASK-017\",\r\n  \"title\": \"knowledge-kernel-ep5-m5-search-ep6\",\r\n  \"current_step_id\": \"S3\",\r\n  \"next_route\": \"execute-step\",\r\n  \"next_mode\": \"finish\",\r\n  \"next_action\": \"finish-step\",\r\n  \"health\": \"needs-attention\",\r\n  \"issues\": 1\r\n}\r\n","started":true,"tool_kind":"local_shell","tool_name":"shell_command"},"turn_id":"01a0ee3b-a1bd-7393-ace7-9009d7c7f2eb","visible":true},{"answer":null,"artifact_id":null,"artifact_name":null,"attachment_name":null,"availability":"present","content":null,"correlation_id":"call_rgKnKftzTuAYv6ptMJxVKydF","item_key":"tool:call_rgKnKftzTuAYv6ptMJxVKydF","kind":"tool","media_type":null,"path":null,"plan":null,"plan_