 -68,7 +68,9 @@ management files it produces just to record that new commit's SHA.\\n request selected_task. They scan the entire saved task journal, not a bounded search page.\\n The response includes adopted_plan_ref, plan/steps/environment, current_step_id, execution,\\n review status and findings, review decisions, actual commits, remaining work, and advisory\\n-next_route. `state_completeness`, issues and unassociated_records must be reported; unknown\\n+next_route/next_action. `finish-step` means the reviewed current step still needs a\\n+separate work disposition; it is not an automatic finish or closure. `state_completeness`,\\n+issues and unassociated_records must be reported; unknown\\n association is not evidence that a plan/decision never existed.\\n \\n Reads do not write. `projection.cache` and `projection.display` describe persisted freshness;\\ndiff --git a/.workflow-system/runtime/support/task-management.mjs b/.workflow-system/runtime/support/task-management.mjs\\nindex e165b23..cc60ee2 100644\\n--- a/.workflow-system/runtime/support/task-management.mjs\\n+++ b/.workflow-system/runtime/support/task-management.mjs\\n@@ -302,16 +302,20 @@ export function taskView(root, input, io) {\\n         historical_execution_refs: executions.filter(e => e.step_id === id && !eligible(e)).map(e => e.ref) };\\n     });\\n     const currentStep = steps.find(s => !['finished', 'skipped', 'closed'].includes(s.state));\\n-    let route = null, mode = null;\\n+    let route = null, mode = null, nextAction = null;\\n     if (lifecycle !== 'closed' && lifecycle !== 'paused') {\\n       if (adopted?.conflict) route = 'task-lifecycle';\\n       else if (!adopted?.value && !task.baseline) route = reviews.some(r => r.stage === 'draft') ? 'prepare-task' : 'review-draft';\\n       else if (plan && !list(plan.steps).length) route = 'prepare-task';\\n       else if (currentStep) {\\n         if (currentStep.state === 'ambiguous' || currentStep.state === 'legacy-state' || currentSt