'use strict';
// Offline SessionMeta reader for S5-R1. Never calls a process or product service.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const retained = path.resolve(__dirname, '../s5');
const A = '01a0fe25-56a2-7910-ba22-61e8016e8ad9';
const C = '01a10643-ae9b-7cb1-b99b-f19f59acba6c';
const uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
function sha(bytes) { return crypto.createHash('sha256').update(bytes).digest('hex'); }
function read(file) { return JSON.parse(fs.readFileSync(path.join(retained, file))); }
function parseSource(bytes, target) {
  const records = bytes.toString('utf8').trim().split('\n').map(line => JSON.parse(line));
  const metas = records.filter(record => record.type === 'session_meta');
  if (metas.length !== 1 || metas[0].payload?.id !== target) throw Error('Exact SessionMeta binding required');
  const meta = metas[0].payload;
  const base = meta.history_base;
  let historyBase = null;
  if (base !== undefined && base !== null) {
    if (typeof base !== 'object' || Array.isArray(base) || !uuid.test(base.thread_id) ||
        !Number.isSafeInteger(base.end_ordinal_exclusive) || base.end_ordinal_exclusive < 0 ||
        !Number.isSafeInteger(base.end_byte_offset) || base.end_byte_offset < 0) {
      throw Error('Malformed retained SessionMeta.history_base');
    }
    historyBase = { thread_id: base.thread_id, end_ordinal_exclusive: base.end_ordinal_exclusive, end_byte_offset: base.end_byte_offset };
  }
  return { meta, historyBase, recordCount: records.length, topLevelHistoryBaseEvents: records.filter(record => record.type === 'history_base').length };
}
function checkedSource(phase, source) {
  const file = path.join(retained, 'private', phase + '-' + source.conversation_id + '.jsonl');
  const stat = fs.statSync(file);
  if (stat.size > 8 * 1024 * 1024 || stat.size !== source.bytes) throw Error('Retained source size mismatch/limit');
  const bytes = fs.readFileSync(file);
  if (sha(bytes) !== source.sha256) throw Error('Retained source hash mismatch');
  return { bytes, parsed: parseSource(bytes, source.conversation_id) };
}
function extract() {
  const selfCheck = read('self-check.json');
  const cleanup = read('final-cleanup.json');
  const phases = [...selfCheck.phases.map(phase => phase.phase), 'restore-active-a', 'restored-final'];
  const before = read('before.json');
  const parent = checkedSource('before', before.sources.find(source => source.conversation_id === A));
  const captures = phases.map(phase => {
    const old = read(phase + '.json');
    const sources = old.sources.map(source => {
      const { parsed } = checkedSource(phase, source);
      let cutObservation = null;
      if (parsed.historyBase) {
        const base = parsed.historyBase;
        const ordinalLines = base.end_byte_offset <= parent.bytes.length
          ? parent.bytes.subarray(0, base.end_byte_offset).toString('utf8').split('\n').length - 1 : null;
        cutObservation = {
          parent_header_id_matches: base.thread_id === parent.parsed.meta.id,
          parent_sha256: before.sources[0].sha256,
          parent_bytes: parent.bytes.length,
          parent_physical_records: parent.parsed.recordCount,
          byte_cut_in_parent: base.end_byte_offset <= parent.bytes.length,
          byte_cut_at_newline: base.end_byte_offset === 0 || parent.bytes[base.end_byte_offset - 1] === 10,
          prefix_physical_lines: ordinalLines,
          ordinal_matches_bounded_prefix: ordinalLines === base.end_ordinal_exclusive,
          qualification: 'Read-only observed metadata/bounds for this retained parent, not Rust validation or resend execution.'
        };
      }
      return {
        conversation_id: source.conversation_id, sha256: source.sha256, bytes: source.bytes,
        session_meta_id: parsed.meta.id, forked_from_id: parsed.meta.forked_from_id ?? null,
        history_base: parsed.historyBase, history_base_field: 'session_meta.payload.history_base',
        original_recorded_history_bases: source.history_bases,
        legacy_top_level_history_base_events: parsed.topLevelHistoryBaseEvents,
        last_turn_id: source.last_turn_id, cut_observation: cutObservation
      };
    });
    return { phase, original_capture_at: old.at, original_capture_sha256: sha(fs.readFileSync(path.join(retained, phase + '.json'))), sources };
  });
  return {
    kind: 'S5-R1-append-only-SessionMeta-correction', source_revision: before.head,
    original_execution_ref: '.workflow-system/records/events/key-26ddca1b4078a7ec73313b6c7dc8a8cc45d37592dbadb757bf18a01a0e7b3332.json',
    review_ref: '.workflow-system/records/events/key-55de26d96e1b7e00a1e0fa408c6919d3ad841c8f42485934d40d1bd39d63b0d0.json',
    correction: 'Original history_bases=[] omitted SessionMeta.history_base; the old absence assertion is superseded by this supplemental extraction, not rewritten.',
    captures,
    qualifications: {
      native_branch: 'C has its own canonical conversation ID and native fork provenance; structured history_base points to A.',
      source_binding_and_cut: 'Exact retained header/hash and bounded parent prefix metadata observed.',
      resend: 'not-run; no new ordinary A terminal user fixture or resend child was executed',
      replacement: 'unverified; Branch cut metadata is not a resend replacement sample',
      rust_transition_lineage_coverage: 'unverified; local cut observation is not protocol validation or catalog completeness',
      projection_and_product_publication: 'failed/not published; original three C analysis_failed reports and absent A/C canonical retained',
      e07_and_healthy_ABC: 'unverified; no new detail sample, A remains desynced'
    },
    retained_original_results: {
      evidence_self_check: { passed: selfCheck.passed, total: selfCheck.total, history_base_assertion: 'disputed false-positive; do not count as supported PASS' },
      cleanup_self_check: { passed: cleanup.passed, total: cleanup.total },
      c_return_live_copy_quick_check: cleanup.failed_live_copy.actual,
      C_failed_runs: selfCheck.c_runs,
      preserved_canonical_digest: cleanup.final_product.canonical_digest
    },
    limitations: ['No live source/service/device/model reads or writes.', 'No parent catalog/root cause/product fix inferred.', 'No source/old script/report/blob edit.', 'Only safe metadata/derived facts saved; raw backups remain private ignored.']
  };
}
if (require.main === module) {
  const output = extract();
  fs.writeFileSync(path.join(__dirname, 'corrected-summary.json'), JSON.stringify(output, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify({ captures: output.captures.length, source_bindings: output.captures.reduce((count, capture) => count + capture.sources.length, 0), C_history_bases: output.captures.flatMap(capture => capture.sources).filter(source => source.conversation_id === C && source.history_base).length }));
}
module.exports = { parseSource, extract };
