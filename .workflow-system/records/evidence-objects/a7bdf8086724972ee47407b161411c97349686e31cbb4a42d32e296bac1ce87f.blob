const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,rel='logs/history-save-repair-20261005/s4/review-r1',save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n'),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const before=JSON.parse(fs.readFileSync(path.join(d,'status-before.json'),'utf8')),audit=JSON.parse(fs.readFileSync(path.join(d,'audit.json'),'utf8'));
const input={action:'review',stage:'change',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S4',execution_ref:before.step.execution_ref,source_revision:audit.head,verdict:'clean',findings:[],coverage:['Exact832S4 execution/currenttestdelta/PLAN/newdraftCR;50fixed/live attachments,4subjects/18protectedsubjects,currentHEAD/binary match','Actualsource/process/importer/File/SQLite durablestaging andproductpublication/provider callchain;4H2publishtraceorders independentlyaudited','A/C target/physicalsource/cut/inherited3delegations+childbody/exacttool details;duplicate/reconstructedNodecollectorandstores/Rustrestart/append/wrongconversationnegativeACK/oldAandCcanonical protection','Currentbinary44product+realRust tests/H1fullappend/H3carriers+conflict+rollback andartifacts reused;no newproductionfix;unknown/oldfailures andtestassertioncorrection retained','REQin_progress andS5S6naturalhost/mobile work retained;isolatedGatewayfixtureandactualNodeACK notclassifiedasphone/productionacceptance'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex',independent:false,new_product_tests_run:false,assessment:'Read-only code/callchain/exactevidencehash/trace audit;reusesexecutiontests and currentbinary,not independentreview or realhost/phonevalidation',binary_sha256:audit.binary.sha256},remaining_work:['Separate832S4finish disposition,832stillactive;notautomaticS5','S5threeactualhostcases andS6specifiedphone durablebody/tool/switch/reopen withoriginalbudgets;currentrealservice/productDB/Gateway/deviceacceptancepending','Priorfailures/vendoroffline limitation/3historicalmanagementassociationgaps retained'],files:[rel+'/review-change.md',rel+'/audit.cjs',rel+'/audit.json',rel+'/test-diff.txt',rel+'/status-before.json',rel+'/record-review.cjs',...audit.subjects.map(p=>p.path)],idempotency_key:'task20260832-S4-review-change-20261007-v1'};
save('review-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(d,'review-result.json'),r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);assert.equal(out.recorded,true);assert.equal(out.association,'applied');assert.equal(out.projection.status,'updated');console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
function query(task,step,name){const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:step?'step':'task',task_ref:task,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const v=JSON.parse(q.stdout);save(name,v);return v;}
const status=query('TASK-20260832','S4','status-after'),child=query('TASK-20260833',null,'status-833-after');assert.equal(status.step.review_ref,out.ref);assert.equal(status.step.review_status,'clean');assert.equal(status.step.execution_ref,before.step.execution_ref);assert.equal(status.step.state,'executed');assert.equal(status.step.disposition_ref,null);assert.equal(status.current_task_id,before.current_task_id);assert.equal(status.next_route,'execute-step');assert.equal(status.next_mode,'finish');assert.equal(child.task.lifecycle,'closed');
const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('attachment-readback',attachments);assert.ok([...audit.subjects,...audit.protect].every(p=>hash(p.path)===p.sha256));
console.log(JSON.stringify({state:status.step.state,review:status.step.review_status,findings:status.step.findings.length,finish:status.step.disposition_ref,next_route:status.next_route,next_mode:status.next_mode,next_step:status.next_step_id,child:'closed',attachments:attachments.length,all_match:true,issues:status.issues.length}));
