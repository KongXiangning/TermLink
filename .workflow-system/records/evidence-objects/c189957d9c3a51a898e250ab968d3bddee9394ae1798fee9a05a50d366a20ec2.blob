'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto');const out=__dirname,root=path.resolve('logs/task005-s2-repair-runtime-2/data'),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),sort=x=>Array.isArray(x)?x.map(sort):x&&typeof x==='object'?Object.fromEntries(Object.keys(x).sort().map(k=>[k,sort(x[k])])):x;
function sanitize(v){const r=structuredClone(v);for(const c of r.canonical||[])c.checkpoint=c.checkpoint.map(x=>({sha256:sha(JSON.stringify(x)),keys:Object.keys(x)}));for(const run of r.runs||[])for(const k of ['result','error','last_error']){const x=run[k];if(x&&typeof x==='object')run[k]={sha256:sha(JSON.stringify(x)),keys:Object.keys(x),code:x.code,message:x.message};}return r;}
for(const label of ['baseline','startup']){const v=JSON.parse(fs.readFileSync(path.join(out,'private',label+'-raw.json')));fs.writeFileSync(path.join(out,label+'-summary.json'),JSON.stringify(sanitize(v),null,2)+'\n',{flag:'wx'});}
const records=fs.readdirSync(path.join(root,'codex-rollout-runs')).map(n=>({file:n,value:JSON.parse(fs.readFileSync(path.join(root,'codex-rollout-runs',n)))}));
const d=records.filter(r=>r.value.conversation_id==='01a0fe25-56a2-7910-ba22-61e8016e8ad9'&&r.value.started_at>=1791347750000).map(({file,value:r})=>({file,keys:Object.keys(r),status:r.status,error:r.error,checkpoint_keys:r.checkpoint&&Object.keys(r.checkpoint),recovery_keys:r.recovery_delivery&&Object.keys(r.recovery_delivery),batches:r.batches,receipt_count:r.receipt_count}));
const cp=fs.readdirSync(path.join(root,'codex-rollout-checkpoints')).map(n=>{const b=fs.readFileSync(path.join(root,'codex-rollout-checkpoints',n)),v=JSON.parse(b);return {file:n,sha256:sha(b),keys:Object.keys(v),profile:v.checkpoint?.wire_profile||v.wire_profile,conversation_id:v.conversation_id||v.scope?.conversationId};});
fs.writeFileSync(path.join(out,'d-diagnostic-shapes.json'),JSON.stringify({d,checkpoints:cp},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({d,checkpoints:cp}));
