+test('history branch delivery H2 saves inherited bodies and child tools without changing parent across restart and rejection', async (t) => {
+    const parentId = '00000000-0000-4000-8000-000000000001';
+    const childId = '00000000-0000-4000-8000-000000000002';
+    const root = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'termlink-h2-delivery-'));
+    const databasePath = path.join(root, 'history.sqlite');
+    const analyzerPath = await resolveRustTargetBinary();
+    const originalParent = await fs.promises.readFile(path.join(nativeRoot, 'tests/fixtures/branch-history/a-full.jsonl'), 'utf8');
+    const childHeader = await fs.promises.readFile(path.join(nativeRoot, 'tests/fixtures/branch-history/c-header.jsonl'), 'utf8');
+    const limits = { max_decoded_bytes: 65536, max_segment_bytes: 4096, max_line_bytes: 2048 };
+    const request = (id, label, options = {}) => createAnalyzeRequest({
+        requestId: 'h2-' + label, jobId: 'h2-job-' + label, conversationId: id,
+        mode: 'backfill', resourceLimits: limits, ...options
+    });
+    const ordinaryTurn = (id, start, marker) => productRolloutFixture(id).trimEnd().split('\n').slice(1).map((line, index) => {
+        const row = JSON.parse(line);
+        row.ordinal = start + index;
+        return JSON.stringify(row).replaceAll('product history initial message', marker + ' question')
+            .replaceAll('initial assistant response', marker + ' answer') + '\n';
+    }).join('');
+    const expectedDelegations = ['[sanitized delegation 1]', '[sanitized delegation 2]', '[sanitized delegation 3]'];
+    let collector;
+    t.after(async () => { await collector?.stop(); await fs.promises.rm(root, { recursive: true, force: true }); });
+
+    // Save the original chat through its own request first. Its later turn is
+    // deliberately beyond the byte-preserved branch cut and must stay in A only.
+    const parentFixture = await createRealProductCollector(root, makeStore(databasePath), analyzerPath, 'parent', parentId);
+    collector = parentFixture.collector;
+    const parentContents = originalParent + ordinaryTurn(parentId, 13, 'parent after cut');
+    await fs.promises.writeFile(parentFixture.sourcePath, parentContents);
+    const parentAudit = traceHistoryDelivery(collector, collector.importer.productStore, parentId);
+    await collector.analyze(request(parentId, 'parent'));
+    await collector.stop();
+    const parentBefore = await readHistoryAfterReopen(databasePath, parentId, 'parent after cut question', expectedDelegations);
+
+    const childFixture = await createRealProductCollector(root, makeStore(databasePath), analyzerPath, 'child', childId);
+    collector = childFixture.collector;
+    const childContents = childHeader + ordinaryTurn(childId, 1, 'branch own');
+    await fs.promises.writeFile(childFixture.sourcePath, childContents);
+    const childAudit = traceHistoryDelivery(collector, collector.importer.productStore, childId);
+    const importBatch = collector.importer.importBatch.bind(collector.importer);
+    collector.importer.importBatch = async (...args) => {
+        const imported = await importBatch(...args);
+        const duplicate = await importBatch(...args);
+        assert.equal(duplicate.duplicate, true);
+        return imported;
+    };
+    const first = await collector.analyze(request(childId, 'branch-first'));
+    assert.equal(first.complete.completeness, 'canonical');
+    assert.ok(first.state.items.some((record) => record.event.event_type === 'DelegatedInput'
+        && record.event.payload.metadata.source_ref.source_identity === parentId
+        && record.event.payload.metadata.conversation_id === childId));
+    const firstBatch = childAudit.messages.find((message) => message.message_type === 'batch');
+    assert.equal(firstBatch.payload.conversation_id, childId);
+    assert.equal(firstBatch.payload.replacements.length, 0);
+    assert.equal(firstBatch.payload.mutations.some((mutation) => mutation.mutation === 'replace_last_turn'), false);
+    await collector.stop();
+    const firstReadback = await readHistoryAfterReopen(databasePath, childId, 'branch own question', expectedDelegations);
+    const toolDetail = JSON.parse(firstReadback.detail.content);
+    assert.equal(toolDetail.call_id, 'command-1');
+    assert.deepEqual(JSON.parse(toolDetail.input), { command: ['cargo', 'test', '--locked'], cwd: 'file:///synthetic/private/workspace' });
+    assert.equal(toolDetail.output, 'status=completed; exit_code=0; duration_ms=1000; output=1 passed\n');
+    assert.equal(JSON.stringify(firstReadback.history).includes('parent after cut'), false);
+    assert.deepEqual(await makeStore(databasePath).readConversation(parentId), parentBefore.history);
+    assert.deepEqual(await makeStore(databasePath).readCheckpoint(parentId), parentBefore.checkpoint);
+
+    // Recreate both the Node collector and SQLite store, then replay overlap.
+    const restarted = await createRealProductCollector(root, makeStore(databasePath), analyzerPath, 'child-reopened', childId);
+    collector = restarted.collector;
+    const restartAudit = traceHistoryDelivery(collector, collector.importer.productStore, childId);
+    await collector.analyze(request(childId, 'branch-overlap'));
+    const overlap = await readHistoryAfterReopen(databasePath, childId, 'branch own question', expectedDelegations);
+    assert.deepEqual(overlap.history.items, firstReadback.history.items);
+    assert.deepEqual(overlap.history.toolDetails, firstReadback.history.toolDetails);
+    const nextOrdinal = childContents.trimEnd().split('\n').length;
+    await fs.promises.appendFile(restarted.sourcePath, appendedProductTurn(nextOrdinal));
+    const appended = await collector.analyze(request(childId, 'branch-append', {
+        mode: 'append', cursor: overlap.checkpoint.cursor, persistedAnchor: overlap.checkpoint
+    }));
+    assert.equal(appended.complete.completeness, 'canonical');
+    const beforeRejection = await readHistoryAfterReopen(databasePath, childId, 'restart append message', expectedDelegations);
+    assert.equal(JSON.stringify(beforeRejection.history).includes('parent after cut'), false);
+
+    // The auxiliary physical source never authorizes publishing C's batch as A.
+    const goodImport = collector.importer.importBatch.bind(collector.importer);
+    collector.importer.importBatch = (batch, options) => {
+        const forged = structuredClone(batch);
+        forged.payload.conversation_id = parentId;
+        return goodImport(forged, options);
+    };
+    await assert.rejects(collector.analyze(request(childId, 'wrong-binding')));
+    assert.ok(restartAudit.messages.some((message) => message.message_type === 'error'
+        && message.request_id === 'h2-wrong-binding' && message.code === 'batch_rejected'
+        && message.details.rejection_code === 'batch_validation_failed'));
+    assert.ok(restartAudit.trace.some((entry) => entry.phase === 'actual-ack-write' && !entry.accepted));
+    assert.equal(restartAudit.messages.some((message) => message.message_type === 'complete'
+        && message.request_id === 'h2-wrong-binding'), false);
+    await collector.stop();
+    const final = await readHistoryAfterReopen(databasePath, childId, 'restart append message', expectedDelegations);
+    assert.deepEqual(final.history, beforeRejection.history);
+    assert.deepEqual(final.checkpoint, beforeRejection.checkpoint);
+    assert.deepEqual(final.detail, firstReadback.detail);
+    assert.deepEqual(await makeStore(databasePath).readConversation(parentId), parentBefore.history);
+    assert.deepEqual(await makeStore(databasePath).readCheckpoint(parentId), parentBefore.checkpoint);
+    assert.equal(await fs.promises.readFile(parentFixture.sourcePath, 'utf8'), parentContents);
+    assertHistoryCommitOrder(parentAudit);
+    assertHistoryCommitOrder(childAudit);
+    assertHistoryCommitOrder(restartAudit);
+    await saveHistoryDeliveryEvidence('H2-branch-restart', {
+        parent: parentAudit, first: childAudit, restarted: restartAudit,
+        parent_before: parentBefore, first_readback: firstReadback, before_rejection: beforeRejection,
+        resource_limits: limits, original_parent_cut: JSON.parse(childHeader).payload.history_base
+    }, final);
+});
+
 test('history shared delivery H3 preserves exact delegated bodies and tool details through SQLite restart and rejection', async (t) => {
     const id = '00000000-0000-4000-8000-000000000001';
     const root = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'termlink-h3-delivery-'));
