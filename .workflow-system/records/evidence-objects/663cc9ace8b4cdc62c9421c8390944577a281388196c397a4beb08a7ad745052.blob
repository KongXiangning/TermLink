'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto');const out=__dirname,sha=b=>crypto.createHash('sha256').update(b).digest('hex'),sort=x=>Array.isArray(x)?x.map(sort):x&&typeof x==='object'?Object.fromEntries(Object.keys(x).sort().map(k=>[k,sort(x[k])])):x;
const label=process.argv[2],messages=JSON.parse(fs.readFileSync(path.join(out,'private',label+'-product-wire.json'))),page=messages.find(m=>m.type==='conversation_history_delta'),checks=[],check=(name,passed)=>checks.push({name,passed:!!passed});
for(const item of page?.upserts||[]){const text=item.payloadJson||messages.filter(m=>m.type==='conversation_history_payload_chunk'&&m.itemKey===item.itemKey).sort((a,b)=>a.chunkIndex-b.chunkIndex).map(m=>m.data).join('');const payloadHash=sha(text),version=(item.detailRefs?.length||item.detailRefsTruncated||item.availability)?sha(JSON.stringify(sort({payloadHash,detailRefs:item.detailRefs||[],detailRefsTruncated:item.detailRefsTruncated===true,availability:item.availability||null}))):payloadHash;check('contentHash '+item.itemKey,version===item.contentHash);for(const ref of item.detailRefs||[]){const d=messages.find(m=>m.type==='conversation_history_detail_response'&&m.refId===ref.refId);check('exact detail hash and bytes '+ref.refId,d&&d.state==='ok'&&d.nextCursor===null&&d.byteOffset===0&&Buffer.byteLength(d.content)===ref.byteSize&&sha(d.content)===ref.contentHash);}}
const result={at:new Date().toISOString(),label,note:'Corrected diagnostic assertion: inline wire items use contentHash; payloadHash exists only on chunk descriptors. Original n-product-read false assertions are retained. This audit reuses exactly saved wire; no business execution or transport repeated.',provider:page?.range?.providerMode,coverageComplete:page?.range?.coverageComplete,items:page?.upserts?.length,checks};fs.writeFileSync(path.join(out,label+'-wire-audit.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({label,checks:checks.length,failed:checks.filter(c=>!c.passed)}));if(checks.some(c=>!c.passed))process.exitCode=2;
