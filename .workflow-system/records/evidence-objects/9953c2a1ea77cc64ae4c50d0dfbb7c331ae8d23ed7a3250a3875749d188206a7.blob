'use strict';
// Read-only correspondence/privacy/preservation audit; no analyzer request or import.
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict'),cp=require('node:child_process');
const dir=__dirname,fixtureRoot=path.join(dir,'fixtures-v2'),read=p=>JSON.parse(fs.readFileSync(p,'utf8'));
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const manifest=read(path.join(fixtureRoot,'manifest.json'));
const originals=Object.fromEntries(['A','C'].map(k=>{const p=`logs/e2e-validation-20261004/s5/private/c-settled-${manifest.original[k].conversation_id}.jsonl`;const b=fs.readFileSync(p);assert.equal(sha(b),manifest.original[k].sha256);return [k,b.toString('utf8').trim().split('\n').map(JSON.parse)];}));
const fullBytes=fs.readFileSync(path.join(fixtureRoot,'a-full.jsonl')),full=fullBytes.toString('utf8').trim().split('\n').map(JSON.parse),child=JSON.parse(fs.readFileSync(path.join(fixtureRoot,'c-header.jsonl'),'utf8').trim());
function shape(v){if(v===null)return 'null';if(Array.isArray(v))return v.map(shape);if(typeof v==='object')return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,shape(x)]));return typeof v;}
const mappings=manifest.records.map(x=>({...x,original_shape:shape(originals.A[x.original_ordinal]),fixture_shape:shape(full[x.fixture_ordinal])}));
const childMapping={...manifest.child_record,original_shape:shape(originals.C[0]),fixture_shape:shape(child)};
const checks=[];function check(id,ok){checks.push({id,passed:!!ok});assert.ok(ok,id);}
check('14selected_record_shapes_match',mappings.every(x=>JSON.stringify(x.original_shape)===JSON.stringify(x.fixture_shape))&&JSON.stringify(childMapping.original_shape)===JSON.stringify(childMapping.fixture_shape));
check('record_hash_correspondence',mappings.every(x=>sha(JSON.stringify(originals.A[x.original_ordinal]))===x.original_record_sha256&&sha(JSON.stringify(full[x.fixture_ordinal]))===x.fixture_record_sha256)&&sha(JSON.stringify(originals.C[0]))===childMapping.original_record_sha256&&sha(JSON.stringify(child))===childMapping.fixture_record_sha256);
const enumKeys=new Set(['type','name','namespace','source','thread_source','memory_mode','history_mode','collaboration_mode_kind','multi_agent_version']);
const allowed=new Set(['session_meta','event_msg','task_started','task_complete','item_completed','response_item','function_call_output','FunctionCallOutput','model','create_thread','send_message_to_thread','codex_app','vscode','agent_created_thread','agent_forked_thread','disabled','paginated','default','v1','v2']);
let strings=0;function safe(v,k=''){if(v===null||typeof v==='boolean'||typeof v==='number')return true;if(Array.isArray(v))return v.every(x=>safe(x,k));if(typeof v==='object')return Object.entries(v).every(([k,x])=>safe(x,k));strings++;if(enumKeys.has(k))return allowed.has(v);return /^00000000-0000-4000-8000-\d{12}$/.test(v)||/^2026-10-0[34]T00:00:\d{2}\.000Z$/.test(v)||/^\[sanitized (text|delegation [123])\]$/.test(v)||['C:/sanitized-fixture','0.0.0','0000000000000000000000000000000000000000','https://example.invalid/sanitized'].includes(v);}
check('all_fixture_string_leaves_allowlisted',full.every(x=>safe(x))&&safe(child));
check('no_real_conversation_ids_in_fixture_bytes',![manifest.original.A.conversation_id,manifest.original.C.conversation_id].some(x=>fullBytes.toString().includes(x)||JSON.stringify(child).includes(x)));
check('C_cut_rebased_not_copied_original',child.payload.history_base.thread_id===manifest.fixture.A&&child.payload.history_base.end_byte_offset===fullBytes.length&&child.payload.history_base.end_ordinal_exclusive===full.length&&fullBytes.at(-1)===10);
const carriers=full.flatMap((r,i)=>{const item=r.payload.item||r.payload;return ['function_call_output','FunctionCallOutput'].includes(item.type)?[{ordinal:i,item}]:[];});
check('six_carriers_keep_missing_call_id',carriers.length===6&&carriers.every(x=>!Object.hasOwn(x.item,'call_id')));
check('three_pairs_keep_id_output_and_turn',[[2,3],[6,7],[10,11]].every(([a,b])=>full[a].payload.id===full[b].payload.item.id&&full[a].payload.output===full[b].payload.item.output&&full[a].payload.internal_chat_message_metadata_passthrough.turn_id===full[b].payload.turn_id));
const first=read(path.join(dir,'run-1/failure.json')),second=read(path.join(dir,'run-2/result.json'));
check('H1_H3_first13_assertions_preserved_passed',first.checks.slice(0,13).every(x=>x.passed)&&first.checks.length===14&&first.checks[13].passed===false);
check('H2_corrected5_assertions_passed',second.passed===5&&second.total===5&&second.checks.every(x=>x.passed));
check('A_inputs_exact_between_v1_and_v2',['a-prefix.jsonl','a-full.jsonl'].every(n=>fs.readFileSync(path.join(dir,'fixtures',n)).equals(fs.readFileSync(path.join(fixtureRoot,n)))));
const base=read(path.join(dir,'../baseline.json'));
check('64original_objects_unchanged',base.files.length===64&&base.files.every(x=>sha(fs.readFileSync(x.path))===x.sha256));
const indexes=['key-857c88fe513282c2114ba4795cbdbc79b11b873e410d8821b987100ae6fe0bba.json','key-34228aaf160940b8653e5db8841d67721660a1dd7743fa5ecfa328361fb6f5bd.json'];
const preserved=indexes.flatMap(n=>read('.workflow-system/records/attachments/'+n).attachments).map(x=>({path:x.source_path,sha256:x.sha256,unchanged:sha(fs.readFileSync(x.source_path))===x.sha256&&sha(fs.readFileSync(x.ref))===x.sha256}));
check('12old_execution_review_attachments_unchanged',preserved.length===12&&preserved.every(x=>x.unchanged));
check('no_product_or_index_diff',cp.execFileSync('git',['diff','--name-only'],{encoding:'utf8'}).trim()===''&&cp.execFileSync('git',['diff','--cached','--name-only'],{encoding:'utf8'}).trim()==='');
const mapped={kind:'sanitized-shape-correspondence/v1',note:'Shapes/hashes only; original private bodies are not included. Fixture IDs/cuts/ordinals are test-only rebased values.',A:mappings,C:childMapping};
fs.writeFileSync(path.join(dir,'shape-mapping.json'),JSON.stringify(mapped,null,2)+'\n',{flag:'wx'});
const result={kind:'S1-R1-repair-self-check',checks,passed:checks.length,total:checks.length,allowlisted_string_leaves:strings,original_objects_checked:64,preserved_original_attachments:preserved,reused_evidence:{H1_H3:'run-1 first13 assertions, byte-identical A fixture between versions',initial_H2_fixture_failure:'run-1/failure.json retained; invalid multi_agent_version sanitization',corrected_H2:'run-2 child-only five assertions'},qualification:'Sanitized diagnostic-delivery repair only, not business success or formal review'};
fs.writeFileSync(path.join(dir,'self-check.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed:result.passed,total:result.total,strings,originals:64,old_attachments:12}));
