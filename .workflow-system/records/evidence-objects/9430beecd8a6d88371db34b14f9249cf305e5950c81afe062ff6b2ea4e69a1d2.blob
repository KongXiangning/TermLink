'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{spawnSync}=require('node:child_process');
const out=__dirname,priv=path.join(out,'private'),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const run=(exe,args)=>{const r=spawnSync(exe,args,{encoding:'utf8',windowsHide:true,timeout:30000});if(r.status!==0)throw Error(`${exe} exit${r.status}: ${r.stderr}`);return r.stdout.trim();};
async function main(){const result={at:new Date().toISOString(),checks:[]};const SQL=await require('sql.js')();const open=p=>{const d=new SQL.Database(fs.readFileSync(p));d.run('PRAGMA query_only=ON');return d;};const rows=(d,q)=>{const r=d.exec(q)[0];return r?r.values.map(v=>Object.fromEntries(r.columns.map((c,i)=>[c,v[i]]))):[];};const old=open(path.join(priv,'before/databases/codex_conversations.db')),cur=open(path.join(priv,'reopened/databases/codex_conversations.db'));const before=rows(old,'SELECT * FROM items'),now=rows(cur,'SELECT * FROM items'),map=new Map(now.map(r=>[r.conversation_id+'\0'+r.item_key,r]));result.old_item_changes=before.flatMap(r=>{const n=map.get(r.conversation_id+'\0'+r.item_key);return n&&JSON.stringify(r)!==JSON.stringify(n)?[{conversation_id:r.conversation_id,item_key:r.item_key,changed_fields:Object.keys(r).filter(k=>JSON.stringify(r[k])!==JSON.stringify(n[k]))}]:[];});result.A_markers_outside_A=now.filter(r=>r.conversation_id!=='01a0fe25-56a2-7910-ba22-61e8016e8ad9'&&JSON.stringify(r).includes('E2E-S4-A')).map(r=>({conversation_id:r.conversation_id,item_key:r.item_key}));old.close();cur.close();
const apk=run('adb',['-s','MQS7N19402011743','shell','pm','path','com.termlink.app']).replace(/^package:/,'');if(!/^\/data\/app\/[^\s]+\/base.apk$/.test(apk))throw Error('Unexpected installed APK path');const fd=fs.openSync(path.join(priv,'installed-base.apk'),'wx');let r;try{r=spawnSync('adb',['-s','MQS7N19402011743','exec-out','cat',apk],{stdio:['ignore',fd,'pipe'],windowsHide:true,timeout:30000});}finally{fs.closeSync(fd);}if(r.status!==0)throw Error('installed APK read failed');result.binary_hashes={local_apk:sha(fs.readFileSync('android/app/build/outputs/apk/debug/app-debug.apk')),installed_apk:sha(fs.readFileSync(path.join(priv,'installed-base.apk'))),analyzer:sha(fs.readFileSync('native/codex-rollout-collector/target/debug/codex-rollout-collector.exe'))};
result.git={head:run('git',['rev-parse','HEAD']),tracked_diff:run('git',['diff','--name-only']),index_diff:run('git',['diff','--cached','--name-only']),source_diff_since_S3:run('git',['diff','--name-only','0bf998452a3f86afa3d68bd0e43d3d9c515499ed','HEAD','--','src','native','android','package.json','package-lock.json'])};
const blobs=run('git',['ls-files','.workflow-system/records/evidence-objects']).split('\n').filter(p=>/[a-f0-9]{64}\.blob$/.test(p));result.old_blobs={checked:blobs.length,mismatches:blobs.filter(p=>sha(fs.readFileSync(p))!==path.basename(p,'.blob'))};
result.checks=[{name:'no A test marker in B or other phone partition',ok:result.A_markers_outside_A.length===0},{name:'installed/local APK and analyzer equal prior S3 source artifact hashes',ok:result.binary_hashes.local_apk==='a3d60ef2e4506950ca44f7b5ec1eaf777f32dbccda13532416e1c5eb9da9505f'&&result.binary_hashes.installed_apk===result.binary_hashes.local_apk&&result.binary_hashes.analyzer==='81a4448219a17cbe54ed827af3214205d49820033275a32d1f8ff46a11599564'},{name:'source, tracked and index unchanged',ok:!result.git.tracked_diff&&!result.git.index_diff&&!result.git.source_diff_since_S3},{name:'all existing tracked CAS blob digests match preserved names',ok:result.old_blobs.checked>0&&result.old_blobs.mismatches.length===0}];
fs.writeFileSync(path.join(out,'preservation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({checks:result.checks,blobs:result.old_blobs,binary_hashes:result.binary_hashes,changed_field_counts:result.old_item_changes.reduce((a,r)=>(r.changed_fields.forEach(k=>a[k]=(a[k]||0)+1),a),{})},null,2));if(result.checks.some(c=>!c.ok))process.exitCode=1;
}main().catch(e=>{console.error(e.stack);process.exitCode=1;});
