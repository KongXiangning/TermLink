idationlimit,3oldmanagementassociationgaps andself-review retained;largeinheritedprefix canstillhitexistinglimits'],files:[...source.map(p=>p.path),...base.protect.filter(p=>!p.path.endsWith('Cargo.lock')).map(p=>p.path),...collect(d).filter(p=>!p.endsWith('/execution-input.json')&&!p.endsWith('/execution-result.json'))],idempotency_key:'task20260832-S3-branch-parent-execution-20261007-v1'};
save('execution-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(d+'/execution-result.json',r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const after=query('TASK-20260832','S3','status-after'),child=query('TASK-20260833','S5','status-833-after');assert.equal(after.step.execution_ref,out.ref);assert.equal(after.step.state,'executed');assert.equal(after.step.review_ref,null);assert.equal(after.step.disposition_ref,null);assert.equal(child.task.lifecycle,'closed');assert.equal(after.current_task_id,before.task.task_id);assert.equal(after.next_route,'review-change');
const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('attachment-readback',attachments);console.log(JSON.stringify({state:after.step.state,review:after.step.review_status,finish:after.step.disposition_ref,next_route:after.next_route,next_step:after.next_step_id,attachments:attachments.length,all_match:true,child:'closed',issues:after.issues.length}));
