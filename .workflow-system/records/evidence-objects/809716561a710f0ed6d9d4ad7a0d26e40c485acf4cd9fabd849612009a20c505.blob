const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d='logs/history-save-repair-20261005/s3',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'),save=(n,v)=>fs.writeFileSync(`${d}/${n}.json`,JSON.stringify(v,null,2)+'\n');
function query(task,step,name){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:task,step_id:step}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);save(name,v);return v;}
const before=query('TASK-20260832','S3','status-record-before'),base=JSON.parse(fs.readFileSync(d+'/baseline.json','utf8')),source=JSON.parse(fs.readFileSync(d+'/source-after.json','utf8'));
assert.equal(before.step.state,'not-started');assert.equal(before.current_task_id,before.task.task_id);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),base.head);for(const p of [...source,...base.protect])assert.equal(hash(p.path),p.sha256);
for(const n of ['target-3','source-1','req-1','cr-1','diff-2'])assert.equal(JSON.parse(fs.readFileSync(`${d}/${n}-result.json`,'utf8')).exit_code,0);
const collect=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(p=>p.isDirectory()?collect(dir+'/'+p.name):[dir+'/'+p.name]);
const resultFiles=fs.readdirSync(d).filter(p=>p.endsWith('-result.json'));const commands=resultFiles.map(p=>{const r=JSON.parse(fs.readFileSync(d+'/'+p,'utf8'));return{command:r.command,environment:r.environment,result:'exit'+r.exit_code,report_ref:d+'/'+p.replace('-result.json','.txt')};});
