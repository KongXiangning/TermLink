'use strict';
// Review evidence audit only: reads saved sources/stores; never runs analyzer or imports.
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
const dir=__dirname, read=p=>JSON.parse(fs.readFileSync(p,'utf8'));
const sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const checks=[]; function check(id,ok,details){checks.push({id,ok:!!ok,details});}
