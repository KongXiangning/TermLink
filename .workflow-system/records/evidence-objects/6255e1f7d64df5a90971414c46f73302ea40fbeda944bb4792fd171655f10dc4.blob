check('two_offline_sources_byte_identical',[[A,'03',aPath],[C,'04',cPath]].every(([id,day,p])=>sha(p)===sha(path.join(dir,`private/offline-home/sessions/2026/10/${day}/rollout-2026-10-${day}T00-00-00-${id}.jsonl`))),undefined);
check('H2_saved_failure_precedes_batch',d.requests[2].conversation_id===C&&d.requests[2].batch_count===0&&d.requests[2].terminal_error?.code==='analysis_failed'&&d.requests[2].terminal_error.message.includes(A),{batch_count:d.requests[2].batch_count,code:d.requests[2].terminal_error?.code});
check('three_historical_C_runs_match',s.h2.historical_c_runs.length===3&&s.h2.historical_c_runs.every(x=>sha('logs/task005-s2-repair-runtime-2/data/codex-rollout-runs/'+x.file)===x.sha256),{count:s.h2.historical_c_runs.length});
const old=read('logs/task005-s2-repair-runtime-2/data/codex-rollout-analysis/7ebafbd2d3b406ee0596cf79203a66a04e36581d7a6ff20ef2ff14a6b4a88406.json');
const batch=read(path.join(dir,'private/captured-a-batch.json')),key='turn:01a10305-be51-76f0-9063-70d58652032e';
const previous=old.mutations.find(x=>x.mutation?.mutation==='upsert_item'&&x.mutation.item.item_key===key).mutation;
const incoming=batch.payload.mutations.find(x=>x.mutation==='upsert_item'&&x.item.item_key===key);
check('H1_same_scope',Object.keys(old.scope).every(k=>old.scope[k]===d.requests[0].batch.scope[k]),old.scope);
check('H1_same_partial_logical_item_changes',previous.item.item_key===incoming.item.item_key&&previous.item.completeness==='partial'&&incoming.item.completeness==='partial'&&previous.item.content_hash!==incoming.item.content_hash,{item_key:key,prior_hash:previous.item.content_hash,incoming_hash:incoming.item.content_hash});
check('H1_refs_actual_started_then_complete',[previous,incoming].every(x=>{const r=JSON.parse(aBytes.subarray(x.item.source_ref.byte_start,x.item.source_ref.byte_end));return 'event_msg/'+r.payload.type===x.item.source_ref.item_type;})&&previous.item.source_ref.item_type==='event_msg/task_started'&&incoming.item.source_ref.item_type==='event_msg/task_complete',undefined);
check('H1_specific_importer_rejection',d.requests[0].importer_errors[0]?.message==='mutation evidence conflicts with an existing staged mutation'&&d.requests[0].importer_errors[0].details.identity.includes(key)&&d.requests[0].terminal_error?.code==='batch_rejected',undefined);
check('H1_fresh_control_only_partial',d.requests[1].importer_errors.length===0&&d.requests[1].complete.status==='partial'&&d.requests[1].complete.completeness==='partial',d.requests[1].complete);
function state(p){const names=fs.readdirSync(p).filter(x=>x.endsWith('.json'));return read(path.join(p,names[0]));}
const seeded=state(path.join(dir,'private/seeded-analysis')),fresh=state(path.join(dir,'private/fresh-analysis'));
