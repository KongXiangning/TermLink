check('H1_control_staging_is_durable_noncanonical',fresh.staging.length===1&&fresh.staging[0].persisted===true&&fresh.receipts.length===1&&fresh.canonical===false,{staging:fresh.staging.length,canonical:fresh.canonical});
const common=batch.payload.history_items.flatMap(x=>{const p=old.items.find(y=>y.event_id===x.payload?.metadata?.event_id);return p?[JSON.stringify(p.event)===JSON.stringify(x)]:[];});
check('H1_39_common_events_unchanged',common.length===39&&common.every(Boolean),{common:common.length});
const a1=fs.readFileSync('logs/e2e-validation-20261003/s2/private/source-a1.jsonl');
check('H1_original399136_prefix_unchanged',a1.length===399136&&a1.equals(aBytes.subarray(0,a1.length)),undefined);
const carrier=a.flatMap((r,i)=>{const item=r.payload?.item||r.payload;return ['function_call_output','FunctionCallOutput'].includes(item?.type)?[{ordinal:i,item,envelope:r.type}]:[];});
check('H3_six_raw_carriers_no_call_id',carrier.length===6&&carrier.every(x=>!Object.hasOwn(x.item,'call_id')),{ordinals:carrier.map(x=>x.ordinal)});
check('H3_three_paired_id_and_output',carrier.filter(x=>x.envelope==='response_item').length===3&&carrier.filter(x=>x.envelope==='response_item').every(x=>carrier.some(y=>y.envelope==='event_msg'&&x.item.id===y.item.id&&x.item.output===y.item.output)),undefined);
check('H3_six_saved_gaps_and_partial',d.requests[1].batch.diagnostic_summary.length===6&&d.requests[1].batch.completeness==='partial',undefined);
check('actual_binary_matches_original',sha('native/codex-rollout-collector/target/debug/codex-rollout-collector.exe')===d.binary_sha256&&d.binary_sha256==='81a4448219a17cbe54ed827af3214205d49820033275a32d1f8ff46a11599564',undefined);
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
check('review_source_same_HEAD',head===base.head,{head});
check('no_tracked_or_staged_changes',cp.execFileSync('git',['diff','--name-only'],{encoding:'utf8'}).trim()===''&&cp.execFileSync('git',['diff','--cached','--name-only'],{encoding:'utf8'}).trim()==='',undefined);
check('business_version_still_matches',cp.execFileSync('git',['diff','--name-only','241becbc2e72f3a1c90970e47f7e95ccf0021dba','HEAD','--','src','native','android','package.json','package-lock.json'],{encoding:'utf8'}).trim()==='',undefined);
const report=fs.readFileSync(path.join(dir,'report.md'),'utf8');
check('report_keeps_unrepaired_and_input_gap',report.includes('三项仍未修复')&&report.includes('而不是计划所列的完整脱敏')&&report.includes('未做新普通聊天'),undefined);
const result={kind:'S1-review-evidence-audit',provenance:'Same-agent self-review; static/raw-byte corroboration only, no analyzer/service/device/test rerun',execution_ref:execution,source_revision:head,checks,passed:checks.filter(x=>x.ok).length,total:checks.length,failed:checks.filter(x=>!x.ok),product_status:{H1:'unrepaired',H2:'unrepaired',H3:'unrepaired'},plan_gap:'S1 promised safe sanitized runnable diagnosis inputs; actual harness depends on original private source/staging. Declaration retains facts but does not fulfill that commitment.'};
fs.writeFileSync(path.join(dir,'review-check-v2.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});
