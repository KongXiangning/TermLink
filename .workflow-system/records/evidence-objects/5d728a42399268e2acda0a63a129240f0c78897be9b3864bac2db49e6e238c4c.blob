const fs = require('fs');
const crypto = require('crypto');
const cp = require('child_process');
const dir = 'logs/shared-history-compat-20261005/s2/review-1';
const execRef = '.workflow-system/records/events/key-debf41cd5061f6e5a4a33043db5815bca9513c7396550d5dcfde38bfc5437308.json';
const manifest = JSON.parse(fs.readFileSync(execRef.replace('/events/', '/attachments/'), 'utf8'));
const hash = p => crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const save = (n, x) => fs.writeFileSync(`${dir}/${n}.json`, JSON.stringify(x, null, 2) + '\n');
const attachments = manifest.attachments || manifest.files;
if (!Array.isArray(attachments)) throw Error('Unknown manifest shape: ' + Object.keys(manifest));
const checks = attachments.map(a => ({path:a.source_path, sha256:a.sha256, fixed_matches:hash(a.ref) === a.sha256, live_matches:hash(a.source_path) === a.sha256}));
save('attachment-check', checks);
const metadata = ['spike', 'formal'].map(kind => {
 const m = JSON.parse(fs.readFileSync(`logs/shared-history-compat-20261005/s2/${kind}-cargo-metadata.json`, 'utf8'));
 const owned = new Set(m.workspace_members);
 const codex = m.packages.filter(p => p.name.startsWith('codex-') && !owned.has(p.id));
 const root = fs.realpathSync(`native/${kind === 'spike' ? 'codex-rollout-compat-spike' : 'codex-rollout-collector'}/vendor/codex`).toLowerCase() + '\\';
 return {kind,excluded:m.packages.filter(p => owned.has(p.id)).map(p=>p.name),dependencies:codex.map(p=>({name:p.name,local:p.source === null && fs.realpathSync(p.manifest_path).toLowerCase().startsWith(root)}))};
});
save('dependency-check', metadata);
const oracles = JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s2/oracle-binaries-final.json', 'utf8')).map(o=>({...o,matches:hash(o.path)===o.sha256}));
save('oracle-check',oracles);
const results = ['spike-final-conformance','formal-final-conformance','stage3-final-conformance','vendor-parity-final'].map(n=>({name:n,...JSON.parse(fs.readFileSync(`logs/shared-history-compat-20261005/s2/${n}-result.json`,'utf8'))}));
save('validation-check',results);
for (const [label,id] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655'],['832','task-58bc12d9a46b8d84fb6e42888785b402']]) {
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'], {input:JSON.stringify({detail:'step',task_ref:id,step_id:'S2'}),encoding:'utf8'});
 fs.writeFileSync(`${dir}/status-${label}-before.json`,r.stdout);
 if(r.status!==0) throw Error(r.stderr);
}
console.log(JSON.stringify({attachments:checks.length,fixed_mismatches:checks.filter(c=>!c.fixed_matches).length,live_mismatches:checks.filter(c=>!c.live_matches).length,metadata:metadata.map(m=>({kind:m.kind,count:m.dependencies.length,all_local:m.dependencies.every(p=>p.local)})),oracle_matches:oracles.every(o=>o.matches),validation:results.map(r=>({name:r.name,exit_code:r.exit_code}))}));
