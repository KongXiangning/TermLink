const fs=require('fs'),path=require('path'),cp=require('child_process'),assert=require('node:assert/strict'),crypto=require('crypto');
const d=__dirname,rel='logs/history-save-repair-20261005/s3/review-r1',save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n');
const before=JSON.parse(fs.readFileSync(path.join(d,'status-before.json'),'utf8'));
const audit=JSON.parse(fs.readFileSync(path.join(d,'audit.json'),'utf8'));
const input={action:'review',stage:'change',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S3',execution_ref:before.step.execution_ref,source_revision:audit.head,verdict:'findings',findings:[{id:'832-S3-R1',priority:2,title:'继承前缀被当作一个 segment，合法分段预算下分支仍保存失败',file:'native/codex-rollout-collector/src/protocol/target_source.rs',start:990,end:995,body:'plan_inherited_prefix 返回单个0..cut range，超过max_segment即拒绝，即使总decoded预算充足。相同5542-byte A在decoded65536/segment4096/line2048下canonical，分支默认canonical，相同分支在上述合法预算下resource_limit_exceeded:range length 5542 exceeds segment limit 4096。应沿完整行分窗口并累计预算/spool，保持cut及fail-closed，不提高限额。初次读取和append recovery均受影响。',evidence_refs:[rel+'/repro-result.json',rel+'/parent-bounded-trace.json',rel+'/branch-bounded-trace.json',rel+'/branch-default-trace.json']}],coverage:['Exact832S3 execution and69fixed/live attachments,10changed/11protected subjects/current binary hash','Discovery referenced parents/targethead/source identity/ambiguity/cycle/sibling/control;source cut/full read/backfill windows/append lineage recovery/coverage;mapper inheritance vsreplacement/diagnostics/canonical gates','2newtests/original sanitized fixtures and execution75target/74source results reused withcurrenthash;new isolated Rust process budgetcounterexample','REQ/PLAN/draftCR,H1H3 reuse andS4S6 unverified product/mobile work retained'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex',independent:false,assessment:'Source/call-chain/evidence review plus isolated sanitized real Rust process counterexample;no product edits/permanent tests/Node durable product commit/phone checks;test ACK only',binary_sha256:audit.binary.sha256},remaining_work:['S3 R1 repair with existing segment/decoded budget then new execution/change review;S3 notfinished','S4 actualconsumer/product branch chain verification,thenS5S6all3naturalhost/mobile durableACK/body/tool/switch/reopen;833 reuse doesnotcertifythese','Prior failures/vendor offline limit and3oldmanagementassociationgaps retained'],files:[...fs.readdirSync(d).filter(n=>!n.endsWith('-input.json')&&!n.endsWith('-result.json')&&fs.statSync(path.join(d,n)).isFile()).map(n=>rel+'/'+n),rel+'/repro-result.json',...audit.currentSubjects.map(p=>p.path)],idempotency_key:'task20260832-S3-review-change-20261007-r1'};
save('review-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(d,'review-result.json'),r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S3'}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const status=JSON.parse(q.stdout);save('status-after',status);assert.equal(status.step.review_ref,out.ref);assert.equal(status.step.review_status,'findings');assert.equal(status.step.execution_ref,before.step.execution_ref);assert.equal(status.step.state,'executed');assert.equal(status.step.disposition_ref,null);assert.equal(status.current_task_id,before.current_task_id);assert.equal(status.next_route,'execute-step');assert.equal(status.next_mode,'repair');
const childQuery=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'task',task_ref:'TASK-20260833'}),encoding:'utf8'});assert.equal(childQuery.status,0,childQuery.stderr);const child=JSON.parse(childQuery.stdout);save('status-833-after',child);assert.equal(child.task.lifecycle,'closed');
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));save('review-attachments',attachments);assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));assert.ok([...audit.currentSubjects,...audit.protectedSubjects].every(p=>hash(p.path)===p.sha256));
console.log(JSON.stringify({state:status.step.state,review:status.step.review_status,findings:status.step.findings.length,finish:status.step.disposition_ref,focus:status.current_task_id,next_route:status.next_route,next_mode:status.next_mode,attachments:attachments.length,all_match:true,child:'closed',issues:status.issues.length}));
