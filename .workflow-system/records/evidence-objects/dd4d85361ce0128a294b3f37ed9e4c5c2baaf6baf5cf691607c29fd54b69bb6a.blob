[package]
name = "codex-rollout-collector"
version = "0.1.0"
edition = "2024"
description = "Formal TermLink Codex rollout collector foundation"
license = "Apache-2.0"

[lib]
path = "src/lib.rs"

[dependencies]
anyhow = "1"
codex-history = { path = "vendor/codex/history" }
codex-protocol = { path = "vendor/codex/protocol" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["fs", "io-util", "macros", "rt-multi-thread", "time"] }
zstd = "0.13"

[profile.release]
opt-level = 2
