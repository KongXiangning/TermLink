    let mut batch = target_partial_batch();
    batch.source_range = Some(TargetSourceByteRange::new(0, 100).expect("batch source range"));
    batch.usage = Some(json!({"total_tokens": 1}));
    batch.tool_details = vec![TargetToolDetail {
        item_key: "tool-1".to_string(),
        call_id: "call-1".to_string(),
        tool_kind: "shell".to_string(),
        input: None,
        output: None,
        completeness: TargetCompleteness::Partial,
        source_epoch: "epoch-1".to_string(),
    }];
    batch.task_outcomes = vec![TargetTaskOutcome {
        item_key: "outcome-1".to_string(),
        status: "completed".to_string(),
        message: None,
        completeness: TargetCompleteness::Partial,
        source_epoch: "epoch-1".to_string(),
    }];
    batch.mutations.push(TargetMutation::UpsertItem {
        item: TargetBatchSourceRef {
