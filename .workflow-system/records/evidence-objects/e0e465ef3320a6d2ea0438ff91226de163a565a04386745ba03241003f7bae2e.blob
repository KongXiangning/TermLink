fn analyzer_output(args: &[OsString]) -> Output {
    Command::new(env!("CARGO_BIN_EXE_codex-rollout-collector"))
        .args(args)
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .output()
        .expect("analyzer process starts")
}

const DELEGATED_CONVERSATION: &str = "00000000-0000-4000-8000-000000000001";

fn history_v2_hello(id: &str) -> TargetMessage {
    let mut caps = target_base_capabilities().map(str::to_string).to_vec();
    caps.push(TARGET_HISTORY_SEMANTICS_CAPABILITY.to_string());
    TargetMessage::NodeHello(TargetNodeHello::new(id, caps))
}

#[test]
fn history_v2_process_negotiates_and_saves_real_delegated_batch_only_after_ack() {
    let root = unique_temp_path("history-v2-process");
    write_target_fixture(
        &root,
        DELEGATED_CONVERSATION,
        &current_fixture_contents("delegated-context.jsonl"),
    );
    let request = TargetAnalyzeRequest::new(
        "delegated-request",
        "delegated-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Backfill,
    );
    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(history_v2_hello("delegated-generation"));
    let TargetMessage::AnalyzerHello(hello) = process.read() else {
        panic!("hello");
    };
    assert!(
        hello
            .capabilities
            .iter()
            .any(|c| c == TARGET_HISTORY_SEMANTICS_CAPABILITY)
    );
    process.send(TargetMessage::Analyze(request.clone()));
    let TargetMessage::Batch(batch) = process.read() else {
        panic!("batch");
    };
    assert_eq!(batch.payload.completeness, TargetCompleteness::Canonical);
    assert_eq!(
        batch
            .payload
            .reducer_state
            .as_ref()
            .unwrap()
            .reducer_version,
        "target-v2"
    );
    assert_eq!(
        batch
            .payload
            .history_items
            .iter()
            .filter(|e| matches!(e, AnalysisEvent::DelegatedInput { .. }))
            .count(),
        6
    );
    let items: Vec<_> = batch.payload.projection["turns"]
        .as_array()
        .unwrap()
        .iter()
        .flat_map(|turn| turn["items"].as_array().unwrap())
        .filter(|item| item["kind"] == "delegated_input")
        .collect();
    assert_eq!(items.len(), 3);
    assert!(items.iter().all(|i| {
        i["tool"].is_null()
            && i["content"]
                .as_str()
                .unwrap()
                .starts_with("[sanitized delegation")
    }));
    for mutation in &batch.payload.mutations {
        if let TargetMutation::UpsertItem { item } = mutation
            && item.item_key.starts_with("delegated-input:")
        {
            assert!(batch.payload.history_items.iter().any(|e|
                matches!(e, AnalysisEvent::DelegatedInput {carrier,..} if carrier == "response_item")
                && e.item_key() == item.item_key && e.metadata().source_ref == item.source_ref));
        }
    }
    process.send(TargetMessage::Ack(TargetAckMessage::new(
        request.header.request_id.clone(),
        batch.job_id.clone(),
        batch.segment_id.clone(),
        batch.batch_id.clone(),
        true,
        true,
        None::<String>,
    )));
    let TargetMessage::Complete(complete) = process.read() else {
        panic!("complete after durable ACK");
    };
    assert_eq!(
        complete.checkpoint.reducer_state.reducer_version,
        "target-v2"
    );
    process.finish();

    // A fresh old consumer can decode ordinary history but must not receive
    // this new event or a successful canonical batch for required delegation.
    let mut old = InteractiveTargetProcess::spawn_with_root(&root, None);
    old.send(target_node_hello("old-generation"));
    assert!(matches!(old.read(), TargetMessage::AnalyzerHello(_)));
    old.send(TargetMessage::Analyze(request));
    target_error(old.read(), "unsupported_capability");
    old.finish();

    // Same new profile, same unsettled job/source identity, new attempt only.
    let mut retry = TargetAnalyzeRequest::new(
        "retry-attempt",
        "delegated-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Backfill,
    );
    retry.recovery = Some(TargetRecovery {
        segment_id: batch.segment_id.clone(),
        batch_id: batch.batch_id.clone(),
    });
    let mut restarted = InteractiveTargetProcess::spawn_with_root(&root, None);
    restarted.send(history_v2_hello("retry-generation"));
    assert!(matches!(restarted.read(), TargetMessage::AnalyzerHello(_)));
    restarted.send(TargetMessage::Analyze(retry.clone()));
    let TargetMessage::Batch(replayed) = restarted.read() else {
        panic!("retry batch");
    };
    assert_eq!(replayed.payload, batch.payload);
    assert_eq!(replayed.batch_id, batch.batch_id);
    restarted.send(TargetMessage::Ack(TargetAckMessage::new(
        retry.header.request_id,
        replayed.job_id,
        replayed.segment_id,
        replayed.batch_id,
        true,
        true,
        None::<String>,
    )));
    assert!(matches!(restarted.read(), TargetMessage::Complete(_)));
    restarted.finish();
}

#[test]
fn history_v2_fresh_job_rebuilds_without_old_anchor_and_rejects_cross_profile_append() {
    let root = unique_temp_path("history-v2-old-state");
    let contents = current_fixture_contents("delegated-context.jsonl");
    let rows: Vec<_> = contents.lines().collect();
    // A complete physical snapshot can contain a running, non-terminal turn.
    let prefix = format!("{}\n{}\n", rows[0], rows[1]);
    let path = write_target_fixture(&root, DELEGATED_CONVERSATION, &prefix);
    let request = TargetAnalyzeRequest::new(
        "old-request",
        "old-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    let old = map_target_source_read(&request, &source).unwrap();
    assert_eq!(
        old.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(
        old.batch.payload.projection["turns"][0]["status"],
        "in_progress"
    );
    let old_checkpoint = old.complete.checkpoint.clone();
    assert!(old_checkpoint.cursor.is_some());
    let saved_old = serde_json::to_value(&old_checkpoint).unwrap();
    let fresh = TargetAnalyzeRequest::new(
        "new-request",
        "new-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Backfill,
    );
    assert!(
        fresh.cursor.is_none()
            && fresh.persisted_anchor.is_none()
            && fresh.known_complete_range.is_none()
            && fresh.recovery.is_none()
    );
    fresh.validate().unwrap();
    let reread = read_target_source(
        &fresh,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    let new = map_target_source_read_with_profile(
        &fresh,
        &reread,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        new.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(
        new.complete.checkpoint.reducer_state.reducer_version,
        "target-v2"
    );
    assert_eq!(serde_json::to_value(&old_checkpoint).unwrap(), saved_old);

    let mut cross = TargetAnalyzeRequest::new(
        "cross-request",
        "cross-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Append,
    );
    cross.cursor = old_checkpoint.cursor.clone();
    cross.persisted_anchor = Some(old_checkpoint);
    cross.validate().unwrap(); // equality is retained, not bypassed
    let cross_read = read_target_source(
        &cross,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    assert!(
        map_target_source_read_with_profile(
            &cross,
            &cross_read,
            CompatibilityProfile::HistorySemanticsV2
        )
        .unwrap_err()
        .to_string()
        .contains("checkpoint_incompatible")
    );
    let mut runtime = TargetRuntime::new(target_startup_config(&root));
    runtime.handle(history_v2_hello("cross-generation"));
    let denied = runtime.handle(TargetMessage::Analyze(cross));
    target_error(
        denied.outbound.into_iter().next().unwrap(),
        "checkpoint_incompatible",
    );
    assert!(runtime.active_request().is_none());

    let mut append = TargetAnalyzeRequest::new(
        "append-request",
        "new-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Append,
    );
    append.cursor = new.complete.checkpoint.cursor.clone();
    append.persisted_anchor = Some(new.complete.checkpoint.clone());
    let terminal = rows
        .iter()
        .find(|line| line.contains("\"type\":\"task_complete\""))
        .unwrap();
    fs::write(path, format!("{prefix}{terminal}\n")).unwrap();
    let delta = read_target_source(
        &append,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    let completed = map_target_source_read_with_profile(
        &append,
        &delta,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        completed.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(
        completed.batch.payload.projection["turns"][0]["status"],
        "completed"
    );
    let mut old_reader = TargetRuntime::new(target_startup_config(&root));
    old_reader.handle(target_node_hello("old-reader-generation"));
    target_error(
        old_reader
            .handle(TargetMessage::Analyze(append))
            .outbound
            .into_iter()
            .next()
            .unwrap(),
        "checkpoint_incompatible",
    );

    let negotiated = negotiate_capabilities(
        &[
            TARGET_HISTORY_SEMANTICS_CAPABILITY.to_string(),
            "analyze_v1".to_string(),
            "cancel".to_string(),
            "checkpoint".to_string(),
            "ack".to_string(),
        ],
        &target_base_capabilities().map(str::to_string),
    )
    .unwrap();
    assert!(!negotiated.supports(TARGET_HISTORY_SEMANTICS_CAPABILITY));
}

#[test]
fn history_v2_delegated_append_restores_binding_and_keeps_one_logical_body() {
    let root = unique_temp_path("history-v2-delegated-append");
    let contents = current_fixture_contents("delegated-context.jsonl");
    let rows: Vec<_> = contents.lines().collect();
    let prefix = format!("{}\n{}\n{}\n", rows[0], rows[1], rows[2]);
    let path = write_target_fixture(&root, DELEGATED_CONVERSATION, &prefix);
    let request = TargetAnalyzeRequest::new(
        "delegate-prefix",
        "delegate-append-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    let initial = map_target_source_read_with_profile(
        &request,
        &source,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        initial.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    let old_item = initial.batch.payload.projection["turns"][0]["items"][0].clone();
    assert_eq!(old_item["kind"], "delegated_input");
    fs::write(path, format!("{prefix}{}\n{}\n", rows[3], rows[4])).unwrap();
    let mut append = TargetAnalyzeRequest::new(
        "delegate-append",
        "delegate-append-job",
        DELEGATED_CONVERSATION,
        TargetAnalyzeMode::Append,
    );
    append.cursor = initial.complete.checkpoint.cursor.clone();
    append.persisted_anchor = Some(initial.complete.checkpoint);
    let delta = read_target_source(
        &append,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    let next = map_target_source_read_with_profile(
        &append,
        &delta,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        next.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(
        next.batch.payload.projection["turns"][0]["items"]
            .as_array()
            .unwrap()
            .len(),
        1
    );
    assert_eq!(
        next.batch.payload.projection["turns"][0]["items"][0],
        old_item
    );
    assert!(next.batch.payload.tool_details.is_empty());
    assert!(next.batch.payload.history_items.iter().any(
        |e| matches!(e, AnalysisEvent::DelegatedInput {carrier,..} if carrier == "item_completed")
    ));
}

fn startup_args(version: &str, sessions_root: &Path) -> Vec<OsString> {
    vec![
        OsString::from("--startup-config-version"),
        OsString::from(version),
        OsString::from("--sessions-root"),
        sessions_root.as_os_str().to_os_string(),
    ]
}

struct InteractiveTargetProcess {
    child: Child,
    stdin: Option<ChildStdin>,
    stdout: BufReader<ChildStdout>,
}

impl InteractiveTargetProcess {
    fn spawn() -> Self {
        Self::spawn_with_fixture(None)
    }

    fn spawn_with_delivery(batch: &TargetBatchMessage, complete: &TargetCompleteMessage) -> Self {
        let fixture = serde_json::json!({
            "batch": batch,
            "complete": complete,
        });
        Self::spawn_with_fixture(Some(
            serde_json::to_string(&fixture).expect("target test delivery serializes"),
        ))
    }

    fn spawn_with_fixture(fixture: Option<String>) -> Self {
        Self::spawn_with_root(&target_protocol_fixture_root(), fixture)
    }

    fn spawn_with_root(root: &Path, fixture: Option<String>) -> Self {
        Self::spawn_with_root_and_worker_delay(root, fixture, None)
    }

    fn spawn_with_root_and_worker_delay(
        root: &Path,
        fixture: Option<String>,
        worker_delay_ms: Option<u64>,
    ) -> Self {
        Self::spawn_with_root_and_test_delays(root, fixture, worker_delay_ms, None, None)
    }

    fn spawn_with_root_and_mapping_delays(
        root: &Path,
        fixture: Option<String>,
        mapping_delay_ms: Option<u64>,
        formal_promotion_delay_ms: Option<u64>,
    ) -> Self {
        Self::spawn_with_root_and_test_delays(
            root,
            fixture,
            None,
            mapping_delay_ms,
            formal_promotion_delay_ms,
        )
    }

    fn spawn_with_root_and_test_delays(
        root: &Path,
        fixture: Option<String>,
        worker_delay_ms: Option<u64>,
        mapping_delay_ms: Option<u64>,
        formal_promotion_delay_ms: Option<u64>,
    ) -> Self {
        let mut command = Command::new(env!("CARGO_BIN_EXE_codex-rollout-collector"));
        command.args(startup_args("1", root));
        if let Some(fixture) = fixture {
            command.env("TERMLINK_TARGET_PROTOCOL_TEST_DELIVERY", fixture);
        }
        if let Some(delay_ms) = worker_delay_ms {
            command.env(
                "TERMLINK_TARGET_PROTOCOL_TEST_WORKER_DELAY_MS",
                delay_ms.to_string(),
            );
        }
        if let Some(delay_ms) = mapping_delay_ms {
            command.env(
                "TERMLINK_TARGET_PROTOCOL_TEST_MAPPING_DELAY_MS",
                delay_ms.to_string(),
            );
        }
        if let Some(delay_ms) = formal_promotion_delay_ms {
            command.env(
                "TERMLINK_TARGET_PROTOCOL_TEST_FORMAL_PROMOTION_DELAY_MS",
                delay_ms.to_string(),
            );
        }
        let mut child = command
            .stdin(Stdio::piped())
            .stdout(Stdio::piped())
            .stderr(Stdio::piped())
            .spawn()
            .expect("target analyzer process starts");
        let stdin = child.stdin.take().expect("target stdin is piped");
        let stdout = child.stdout.take().expect("target stdout is piped");
        Self {
            child,
            stdin: Some(stdin),
            stdout: BufReader::new(stdout),
        }
    }

    fn send(&mut self, message: TargetMessage) {
        let line = message.to_json_line().expect("target input serializes");
        self.send_raw(&line);
    }

    fn send_raw(&mut self, line: &str) {
        let stdin = self.stdin.as_mut().expect("target stdin remains open");
        writeln!(stdin, "{line}").expect("target input writes");
        stdin.flush().expect("target input flushes");
    }

    fn read(&mut self) -> TargetMessage {
        let mut line = String::new();
        let bytes = self
            .stdout
            .read_line(&mut line)
            .expect("target stdout reads");
        assert!(bytes > 0, "target process closed stdout before a response");
        TargetMessage::parse_line(line.trim()).expect("target response parses")
    }

    fn finish(mut self) {
        self.stdin.take();
        drop(self.stdout);
        let status = self.child.wait().expect("target process waits");
        let mut stderr = String::new();
        if let Some(mut pipe) = self.child.stderr.take() {
            pipe.read_to_string(&mut stderr)
                .expect("target stderr reads");
        }
        assert!(
            status.success(),
            "target process failed: {status}; stderr={stderr}"
        );
    }
}

fn target_error(message: TargetMessage, expected_code: &str) -> TargetErrorMessage {
    match message {
        TargetMessage::Error(error) => {
            assert_eq!(error.code, expected_code, "target error: {}", error.message);
            error
        }
        other => panic!("expected target error {expected_code}, got {other:?}"),
    }
}

fn exercise_delayed_target_control(
    root: &Path,
    label: &str,
    mapping_delay_ms: Option<u64>,
    formal_promotion_delay_ms: Option<u64>,
    timeout_ms: Option<u64>,
    cancel_after_ms: Option<u64>,
) {
    assert!(
        timeout_ms.is_some() ^ cancel_after_ms.is_some(),
        "a delayed control case must use exactly one terminal control"
    );
    let mut process = InteractiveTargetProcess::spawn_with_root_and_mapping_delays(
        root,
        None,
        mapping_delay_ms,
        formal_promotion_delay_ms,
    );
    process.send(target_node_hello(format!("{label}-generation").as_str()));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));

    let request_id = format!("{label}-request");
    let mut request = TargetAnalyzeRequest::new(
        request_id.clone(),
        format!("{label}-job"),
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    if let Some(timeout_ms) = timeout_ms {
        request.resource_limits = Some(TargetResourceLimits {
            max_decoded_bytes: None,
            max_line_bytes: None,
            max_segment_bytes: None,
            tail_bytes: None,
            timeout_ms: Some(timeout_ms),
        });
    }
    process.send(TargetMessage::Analyze(request));

    if let Some(cancel_after_ms) = cancel_after_ms {
        std::thread::sleep(Duration::from_millis(cancel_after_ms));
        process.send(TargetMessage::Cancel(TargetCancelMessage::new(
            request_id.clone(),
            format!("cancel delayed {label} control"),
        )));
        let cancelled = target_error(process.read(), "cancelled");
        assert!(!cancelled.fatal);
    } else {
        let timeout = target_error(process.read(), "resource_timeout");
        assert!(!timeout.fatal);
        assert!(timeout.retryable);
    }

    let blocked_request = TargetAnalyzeRequest::new(
        format!("{label}-blocked-request"),
        format!("{label}-blocked-job"),
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    process.send(TargetMessage::Analyze(blocked_request));
    let busy = target_error(process.read(), "busy");
    assert!(!busy.retryable);

    // The source worker must finish before the next request is admitted. The
    // next successful request also proves the cancelled/timed-out result did
    // not publish a stale batch or complete message.
    std::thread::sleep(Duration::from_millis(420));
    let admitted_request = TargetAnalyzeRequest::new(
        format!("{label}-admitted-request"),
        format!("{label}-admitted-job"),
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    process.send(TargetMessage::Analyze(admitted_request));
    let batch = match process.read() {
        TargetMessage::Batch(batch) => batch,
        other => panic!("expected admitted mapped batch after {label} control, got {other:?}"),
    };
    process.send(TargetMessage::Ack(TargetAckMessage::new(
        format!("{label}-admitted-request"),
        batch.job_id.clone(),
        batch.segment_id.clone(),
        batch.batch_id.clone(),
        true,
        true,
        None::<String>,
    )));
    assert!(matches!(process.read(), TargetMessage::Complete(_)));
    process.finish();
}

fn target_node_hello(request_id: &str) -> TargetMessage {
    TargetMessage::NodeHello(TargetNodeHello::new(request_id, target_base_capabilities()))
}

fn target_analyze(request_id: &str, job_id: &str) -> TargetMessage {
    TargetMessage::Analyze(TargetAnalyzeRequest::new(
        request_id,
        job_id,
        "conversation-1",
        TargetAnalyzeMode::Preview,
    ))
}

fn unique_temp_path(label: &str) -> PathBuf {
    let nanos = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .expect("system clock after epoch")
        .as_nanos();
    std::env::temp_dir().join(format!(
        "termlink-rust-startup-{label}-{}-{nanos}",
        std::process::id()
    ))
}

fn target_protocol_fixture_root() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("tests")
        .join("fixtures")
        .join("target-session")
}

const TARGET_MAPPING_CONVERSATION_ID: &str = "019b2b40-beb6-7b23-bed0-37d570e76816";

const SANITIZED_SESSION_CONVERSATION_ID: &str = "7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101";

const SANITIZED_SESSION_FIXTURE_FILES: [&str; 5] = [
    "2026/08/22/rollout-2026-08-22T00-01-00-7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101.jsonl",
    "2026/08/22/rollout-2026-08-22T00-02-00-7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101_6a1b2c30-4d5e-4f6a-8b7c-9d0e1f2a3b40.jsonl",
    "2026/08/22/rollout-2026-08-22T00-03-00-7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101_1a2b3c40-5d6e-4f7a-8b9c-0d1e2f3a4b50.jsonl",
    "2026/08/22/rollout-2026-08-22T00-04-00-7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101_2b3c4d50-6e7f-4a8b-9c0d-1e2f3a4b5c60.jsonl",
    "2026/08/23/rollout-2026-08-23T00-05-00-7d9f2f20-3d1a-4f9a-8b1c-2e7a4f60a101_3c4d5e60-7f8a-4b9c-0d1e-2f3a4b5c6d70.jsonl",
];

fn sanitized_fixture_root() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("tests")
        .join("fixtures")
        .join("sanitized-session-5")
}

fn sanitized_fixture_path(index: usize) -> PathBuf {
    sanitized_fixture_root().join(SANITIZED_SESSION_FIXTURE_FILES[index])
}

fn target_startup_config(root: &Path) -> codex_rollout_collector::protocol::TargetStartupConfig {
    match parse_startup_args(startup_args("1", root)).expect("target startup parses") {
        StartupMode::Target(config) => config,
        StartupMode::Legacy => panic!("target startup arguments must select target mode"),
    }
}

fn target_source_request(
    request_id: &str,
    conversation_id: &str,
    mode: TargetAnalyzeMode,
) -> TargetAnalyzeRequest {
    TargetAnalyzeRequest::new(request_id, "target-source-job", conversation_id, mode)
}

fn copy_sanitized_fixture(index: usize, root: &Path) -> PathBuf {
    let relative = SANITIZED_SESSION_FIXTURE_FILES[index];
    let destination = root.join(relative);
    fs::create_dir_all(destination.parent().expect("fixture destination parent"))
        .expect("fixture destination directory creates");
    fs::copy(sanitized_fixture_path(index), &destination).expect("fixture copies");
    destination
}

fn sanitized_fixture_files_path(root: &Path, index: usize) -> PathBuf {
    root.join(SANITIZED_SESSION_FIXTURE_FILES[index])
}

fn target_fixture_path(root: &Path, conversation_id: &str) -> PathBuf {
    root.join("2026").join("08").join("26").join(format!(
        "rollout-2026-08-26T00-00-00-{conversation_id}.jsonl"
    ))
}

fn write_target_fixture(root: &Path, conversation_id: &str, contents: &str) -> PathBuf {
    let destination = target_fixture_path(root, conversation_id);
    fs::create_dir_all(destination.parent().expect("target fixture parent"))
        .expect("target fixture directory creates");
    fs::write(&destination, contents).expect("target fixture writes");
    destination
}

fn current_fixture_contents(name: &str) -> String {
    let fixtures_root = Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("tests")
        .join("fixtures");
    let path = if name.contains('/') || name.contains('\\') {
        fixtures_root.join(name)
    } else {
        fixtures_root.join("current").join(name)
    };
    fs::read_to_string(path).expect("current fixture reads")
}

fn rewrite_history_base(path: &Path, parent_rollout_id: &str, end_byte_offset: u64) {
    let mut lines = fs::read_to_string(path)
        .expect("rollout fixture reads")
        .lines()
        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("rollout line parses"))
        .collect::<Vec<_>>();
    let header = lines.first_mut().expect("rollout has a session header");
    header["payload"]["history_mode"] = serde_json::Value::String("paginated".to_string());
    header["payload"]["history_base"] = json!({
        "thread_id": parent_rollout_id,
        "end_ordinal_exclusive": 1,
        "end_byte_offset": end_byte_offset
    });
    let encoded = lines
        .iter()
        .map(|line| {
            let mut bytes = serde_json::to_vec(line).expect("rollout line serializes");
            bytes.push(b'\n');
            bytes
        })
        .flatten()
        .collect::<Vec<_>>();
    fs::write(path, encoded).expect("rollout fixture rewrites");
}

fn rollout_id(path: &Path) -> String {
    rollout_id_from_filename(path).expect("rollout fixture has a rollout ID")
}

#[test]
fn no_arguments_preserve_the_legacy_entrypoint() {
    let output = analyzer_output(&[]);
    assert!(
        output.status.success(),
        "legacy runtime failed: {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert!(
        output.stdout.is_empty(),
        "legacy EOF must not emit a target message"
    );
}

#[test]
fn target_startup_accepts_a_normalized_existing_root_without_business_output() {
    let root = fs::canonicalize(env!("CARGO_MANIFEST_DIR")).expect("crate root canonicalizes");
    let root_with_dot = root.join(".");
    let output = analyzer_output(&startup_args("1", &root_with_dot));

    assert!(
        output.status.success(),
        "target startup failed: {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert!(
        output.stdout.is_empty(),
        "startup step must not emit business messages"
    );
}

#[test]
fn target_startup_allows_a_missing_root_without_creating_it() {
    let root = unique_temp_path("missing-root");
    assert!(!root.exists());

    let output = analyzer_output(&startup_args("1", &root));

    assert!(
        output.status.success(),
        "missing root must not block startup: {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert!(!root.exists(), "startup must not create sessions root");
}

#[test]
fn unsupported_or_malformed_startup_arguments_fail_before_legacy_dispatch() {
    let unsupported = analyzer_output(&startup_args("2", Path::new(env!("CARGO_MANIFEST_DIR"))));
    assert!(!unsupported.status.success());
    assert!(
        String::from_utf8_lossy(&unsupported.stderr).contains("unsupported startup config version")
    );

    let unknown = analyzer_output(&[OsString::from("--legacy")]);
    assert!(!unknown.status.success());
    assert!(String::from_utf8_lossy(&unknown.stderr).contains("unexpected startup argument"));

    let missing_root = analyzer_output(&[
        OsString::from("--startup-config-version"),
        OsString::from("1"),
    ]);
    assert!(!missing_root.status.success());
    assert!(String::from_utf8_lossy(&missing_root.stderr).contains("--sessions-root"));
}

#[test]
fn relative_and_non_directory_roots_fail_closed() {
    let relative = analyzer_output(&startup_args("1", Path::new("relative/sessions")));
    assert!(!relative.status.success());
    assert!(String::from_utf8_lossy(&relative.stderr).contains("must be absolute"));

    let file = unique_temp_path("not-a-directory");
    fs::write(&file, b"not a directory").expect("temporary file writes");
    let non_directory = analyzer_output(&startup_args("1", &file));
    let _ = fs::remove_file(&file);

    assert!(!non_directory.status.success());
    assert!(String::from_utf8_lossy(&non_directory.stderr).contains("not a directory"));
}

#[test]
fn filesystem_root_escape_is_rejected_during_normalization() {
    let path = if cfg!(windows) {
        PathBuf::from(r"C:\..\sessions")
    } else {
        PathBuf::from("/../sessions")
    };
    let error = normalize_sessions_root(&path).expect_err("root escape must fail closed");
    assert!(matches!(
        error,
        StartupConfigError::SessionsRootEscapesRoot(_)
    ));
}

#[test]
fn parser_keeps_target_and_legacy_modes_explicitly_separate() {
    assert_eq!(
        parse_startup_args(Vec::<OsString>::new()).unwrap(),
        StartupMode::Legacy
    );

    let root = fs::canonicalize(env!("CARGO_MANIFEST_DIR")).expect("crate root canonicalizes");
    let mode = parse_startup_args(startup_args("1", &root)).expect("target startup parses");
    match mode {
        StartupMode::Target(config) => {
            assert_eq!(config.startup_config_version(), 1);
            assert_eq!(config.sessions_root(), root);
        }
        StartupMode::Legacy => panic!("target arguments must not select legacy mode"),
    }
}

#[test]
fn target_process_requires_handshake_and_enforces_single_flight() {
    let mut process = InteractiveTargetProcess::spawn();

    process.send(target_analyze("request-before-hello", "job-before-hello"));
    let handshake_error = target_error(process.read(), "handshake_required");
    assert!(!handshake_error.fatal);

    process.send(target_node_hello("generation-1"));
    match process.read() {
        TargetMessage::AnalyzerHello(hello) => {
            assert_eq!(hello.header.request_id, "generation-1");
            assert_eq!(hello.role, TargetRole::Analyzer);
            assert!(
                hello
                    .capabilities
                    .contains(&TARGET_ANALYZE_CAPABILITY.to_string())
            );
        }
        other => panic!("expected analyzer hello, got {other:?}"),
    }

    process.send(target_analyze("request-1", "job-1"));
    process.send(target_analyze("request-2", "job-2"));
    let busy = target_error(process.read(), "busy");
    assert!(!busy.fatal);
    assert!(!busy.retryable);

    process.send(TargetMessage::Cancel(TargetCancelMessage::new(
        "request-2",
        "wrong request",
    )));
    let not_found = target_error(process.read(), "cancel_request_not_found");
    assert!(!not_found.fatal);

    process.send(TargetMessage::Cancel(TargetCancelMessage::new(
        "request-1",
        "user cancelled",
    )));
    let cancelled = target_error(process.read(), "cancelled");
    assert!(!cancelled.fatal);

    process.finish();
}

#[test]
fn target_process_rejects_legacy_handshake_and_malformed_lines() {
    let mut process = InteractiveTargetProcess::spawn();

    process.send_raw(
        r#"{"protocol_version":1,"message_type":"hello","request_id":"legacy-generation","role":"analyzer","analyzer_version":"legacy","capabilities":["replay"],"parser_backend":"legacy","compatibility_layer_version":"legacy"}"#,
    );
    assert!(!target_error(process.read(), "handshake_required").fatal);

    process.send_raw("not-json");
    assert!(!target_error(process.read(), "malformed_protocol").fatal);

    process.send(target_node_hello("generation-1"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.finish();
}

#[test]
fn target_process_fails_closed_on_capability_mismatch_and_duplicate_hello() {
    let mut unsupported = InteractiveTargetProcess::spawn();
    unsupported.send(TargetMessage::NodeHello(TargetNodeHello::new(
        "generation-1",
        [TARGET_ANALYZE_CAPABILITY, TARGET_CANCEL_CAPABILITY],
    )));
    let unsupported_error = target_error(unsupported.read(), "unsupported_capability");
    assert!(unsupported_error.fatal);
    unsupported.finish();

    let mut duplicate = InteractiveTargetProcess::spawn();
    duplicate.send(target_node_hello("generation-1"));
    assert!(matches!(duplicate.read(), TargetMessage::AnalyzerHello(_)));
    duplicate.send(target_node_hello("generation-2"));
    let duplicate_error = target_error(duplicate.read(), "duplicate_hello");
    assert!(duplicate_error.fatal);
    duplicate.finish();
}

#[test]
fn target_process_generation_isolated_across_restart() {
    let mut first = InteractiveTargetProcess::spawn();
    first.send(target_node_hello("generation-1"));
    match first.read() {
        TargetMessage::AnalyzerHello(hello) => {
            assert_eq!(hello.header.request_id, "generation-1");
        }
        other => panic!("expected first analyzer hello, got {other:?}"),
    }
    first.finish();

    let mut second = InteractiveTargetProcess::spawn();
    second.send(target_node_hello("generation-2"));
    match second.read() {
        TargetMessage::AnalyzerHello(hello) => {
            assert_eq!(hello.header.request_id, "generation-2");
        }
        other => panic!("expected second analyzer hello, got {other:?}"),
    }
    second.finish();
}

#[test]
fn target_process_requires_matching_positive_ack_before_complete() {
    let batch = target_batch_message("request-1", "job-1", TargetCompleteness::Canonical);
    let complete = target_complete_message("request-1", "job-1", TargetCompleteness::Canonical);
    let mut process = InteractiveTargetProcess::spawn_with_delivery(&batch, &complete);

    process.send(target_node_hello("generation-1"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(target_analyze("request-1", "job-1"));
    assert_eq!(process.read(), TargetMessage::Batch(batch.clone()));

    process.send(TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "wrong-segment",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert!(!target_error(process.read(), "ack_rejected").fatal);

    process.send(TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert_eq!(process.read(), TargetMessage::Complete(complete));
    process.finish();
}

#[test]
fn target_process_negative_ack_is_terminal_and_idempotent() {
    let batch = target_batch_message("request-1", "job-1", TargetCompleteness::Partial);
    let complete = target_complete_message("request-1", "job-1", TargetCompleteness::Partial);
    let mut process = InteractiveTargetProcess::spawn_with_delivery(&batch, &complete);

    process.send(target_node_hello("generation-1"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(target_analyze("request-1", "job-1"));
    assert_eq!(process.read(), TargetMessage::Batch(batch));

    let rejection = TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        false,
        false,
        Some("staging_unavailable"),
    ));
    process.send(rejection.clone());
    let first = target_error(process.read(), "batch_rejected");
    assert!(first.retryable);
    assert_eq!(
        first
            .details
            .as_ref()
            .and_then(|details| details.get("rejection_code")),
        Some(&serde_json::Value::String(
            "staging_unavailable".to_string()
        ))
    );

    process.send(rejection);
    assert!(target_error(process.read(), "batch_rejected").retryable);
    process.finish();
}

#[test]
fn target_process_timeout_and_small_source_limits_do_not_reject_batch_payload() {
    let timeout_batch = target_batch_message(
        "request-timeout",
        "job-timeout",
        TargetCompleteness::Partial,
    );
    let timeout_complete = target_complete_message(
        "request-timeout",
        "job-timeout",
        TargetCompleteness::Partial,
    );
    let mut timeout_process =
        InteractiveTargetProcess::spawn_with_delivery(&timeout_batch, &timeout_complete);
    timeout_process.send(target_node_hello("generation-timeout"));
    assert!(matches!(
        timeout_process.read(),
        TargetMessage::AnalyzerHello(_)
    ));
    let mut timeout_request = TargetAnalyzeRequest::new(
        "request-timeout",
        "job-timeout",
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    timeout_request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: None,
        max_line_bytes: None,
        max_segment_bytes: None,
        tail_bytes: None,
        timeout_ms: Some(10),
    });
    timeout_process.send(TargetMessage::Analyze(timeout_request));
    assert!(matches!(timeout_process.read(), TargetMessage::Batch(_)));
    assert!(!target_error(timeout_process.read(), "resource_timeout").fatal);
    timeout_process.finish();

    let limited_batch =
        target_batch_message("request-limit", "job-limit", TargetCompleteness::Partial);
    let limited_complete =
        target_complete_message("request-limit", "job-limit", TargetCompleteness::Partial);
    let mut limited_process =
        InteractiveTargetProcess::spawn_with_delivery(&limited_batch, &limited_complete);
    limited_process.send(target_node_hello("generation-limit"));
    assert!(matches!(
        limited_process.read(),
        TargetMessage::AnalyzerHello(_)
    ));
    let mut limited_request = TargetAnalyzeRequest::new(
        "request-limit",
        "job-limit",
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    limited_request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(1),
        max_line_bytes: Some(1),
        max_segment_bytes: Some(1),
        tail_bytes: None,
        timeout_ms: None,
    });
    limited_process.send(TargetMessage::Analyze(limited_request));
    assert!(matches!(
        limited_process.read(),
        TargetMessage::Batch(batch) if serde_json::to_vec(&batch.payload)
            .expect("target batch payload serializes")
            .len() > 1
    ));
    limited_process.send(TargetMessage::Ack(TargetAckMessage::new(
        "request-limit",
        "job-limit",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert!(matches!(
        limited_process.read(),
        TargetMessage::Complete(complete) if complete.header.request_id == "request-limit"
    ));
    limited_process.finish();
}

#[test]
fn target_runtime_late_ack_and_complete_are_fenced_by_deadline() {
    let mut late_ack_runtime =
        target_runtime_ready_with_timeout("request-late-ack", "job-late-ack", 10);
    let late_ack_batch = target_batch_message(
        "request-late-ack",
        "job-late-ack",
        TargetCompleteness::Partial,
    );
    late_ack_runtime.publish_batch(late_ack_batch);
    std::thread::sleep(Duration::from_millis(25));

    let late_ack = late_ack_runtime.handle(TargetMessage::Ack(TargetAckMessage::new(
        "request-late-ack",
        "job-late-ack",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert_eq!(
        target_action_error(late_ack, "resource_timeout").retryable,
        true
    );
    assert!(late_ack_runtime.active_request().is_none());

    let late_ack_complete = late_ack_runtime.complete_request(target_complete_message(
        "request-late-ack",
        "job-late-ack",
        TargetCompleteness::Partial,
    ));
    assert_eq!(
        target_action_error(late_ack_complete, "complete_request_not_found").fatal,
        false
    );

    let mut late_complete_runtime =
        target_runtime_ready_with_timeout("request-late-complete", "job-late-complete", 10);
    let late_complete_batch = target_batch_message(
        "request-late-complete",
        "job-late-complete",
        TargetCompleteness::Partial,
    );
    late_complete_runtime.publish_batch(late_complete_batch);
    std::thread::sleep(Duration::from_millis(25));

    let late_complete = late_complete_runtime.complete_request(target_complete_message(
        "request-late-complete",
        "job-late-complete",
        TargetCompleteness::Partial,
    ));
    assert_eq!(
        target_action_error(late_complete, "resource_timeout").retryable,
        true
    );
    assert!(late_complete_runtime.active_request().is_none());
}

#[test]
fn target_process_late_matching_ack_never_emits_complete() {
    let batch = target_batch_message(
        "request-process-late-ack",
        "job-process-late-ack",
        TargetCompleteness::Partial,
    );
    let complete = target_complete_message(
        "request-process-late-ack",
        "job-process-late-ack",
        TargetCompleteness::Partial,
    );
    let mut process = InteractiveTargetProcess::spawn_with_delivery(&batch, &complete);
    process.send(target_node_hello("generation-process-late-ack"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));

    let mut request = TargetAnalyzeRequest::new(
        "request-process-late-ack",
        "job-process-late-ack",
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: None,
        max_line_bytes: None,
        max_segment_bytes: None,
        tail_bytes: None,
        timeout_ms: Some(10),
    });
    process.send(TargetMessage::Analyze(request));
    assert!(matches!(process.read(), TargetMessage::Batch(_)));

    std::thread::sleep(Duration::from_millis(25));
    process.send(TargetMessage::Ack(TargetAckMessage::new(
        "request-process-late-ack",
        "job-process-late-ack",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    let timeout = target_error(process.read(), "resource_timeout");
    assert!(timeout.retryable);
    let late_ack_rejection = target_error(process.read(), "ack_rejected");
    assert!(!late_ack_rejection.retryable);
    process.finish();
}

#[test]
fn target_runtime_settles_ack_watermark_and_rejects_complete_before_ack() {
    let mut runtime = target_runtime_ready("request-1", "job-1");
    let batch = target_batch_message("request-1", "job-1", TargetCompleteness::Canonical);
    assert_eq!(
        runtime.publish_batch(batch.clone()).outbound,
        vec![TargetMessage::Batch(batch.clone())]
    );
    assert_eq!(
        runtime.awaiting_ack().map(|id| id.batch_id.as_str()),
        Some("batch-1")
    );

    let before_ack = runtime.complete_request(target_complete_message(
        "request-1",
        "job-1",
        TargetCompleteness::Canonical,
    ));
    assert_eq!(
        target_action_error(before_ack, "complete_before_ack").fatal,
        false
    );

    let wrong_ack = runtime.handle(TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-wrong",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert_eq!(target_action_error(wrong_ack, "ack_rejected").fatal, false);
    assert!(runtime.awaiting_ack().is_some());

    assert_eq!(
        runtime.publish_batch(batch.clone()).outbound,
        vec![TargetMessage::Batch(batch)]
    );
    assert!(
        runtime
            .handle(TargetMessage::Ack(TargetAckMessage::new(
                "request-1",
                "job-1",
                "segment-1",
                "batch-1",
                true,
                true,
                None::<String>,
            )))
            .outbound
            .is_empty()
    );
    assert_eq!(
        runtime
            .last_acknowledged_identity()
            .map(|id| id.batch_id.as_str()),
        Some("batch-1")
    );

    let complete = target_complete_message("request-1", "job-1", TargetCompleteness::Canonical);
    assert_eq!(
        runtime.complete_request(complete.clone()).outbound,
        vec![TargetMessage::Complete(complete)]
    );
    assert!(runtime.active_request().is_none());
}

#[test]
fn target_runtime_allows_multiple_batches_when_outbound_json_exceeds_source_budget() {
    let mut runtime = target_runtime_ready_with_limits(
        "request-source-budget",
        "job-source-budget",
        TargetResourceLimits {
            max_decoded_bytes: Some(1),
            max_line_bytes: Some(1),
            max_segment_bytes: Some(1),
            tail_bytes: Some(1),
            timeout_ms: Some(30_000),
        },
    );

    let mut first_batch = target_batch_message(
        "request-source-budget",
        "job-source-budget",
        TargetCompleteness::Partial,
    );
    first_batch.payload.projection = json!({
        "coverage": "partial",
        "diagnostic_context": "outbound projection is not source bytes"
    });
    let first_encoded_bytes = serde_json::to_vec(&first_batch.payload)
        .expect("first target batch payload serializes")
        .len();
    assert!(first_encoded_bytes > 1);

    assert_eq!(
        runtime.publish_batch(first_batch.clone()).outbound,
        vec![TargetMessage::Batch(first_batch)]
    );
    assert!(
        runtime
            .handle(TargetMessage::Ack(TargetAckMessage::new(
                "request-source-budget",
                "job-source-budget",
                "segment-1",
                "batch-1",
                true,
                true,
                None::<String>,
            )))
            .outbound
            .is_empty()
    );

    let mut second_batch = target_batch_message(
        "request-source-budget",
        "job-source-budget",
        TargetCompleteness::Partial,
    );
    second_batch.segment_id = "segment-2".to_string();
    second_batch.batch_id = "batch-2".to_string();
    second_batch.payload.projection = json!({
        "coverage": "partial",
        "diagnostic_context": "second outbound projection is not source bytes"
    });
    let second_encoded_bytes = serde_json::to_vec(&second_batch.payload)
        .expect("second target batch payload serializes")
        .len();
    assert!(second_encoded_bytes > 1);
    assert!(first_encoded_bytes.saturating_add(second_encoded_bytes) > 1);

    assert_eq!(
        runtime.publish_batch(second_batch.clone()).outbound,
        vec![TargetMessage::Batch(second_batch)]
    );
    assert!(
        runtime
            .handle(TargetMessage::Ack(TargetAckMessage::new(
                "request-source-budget",
                "job-source-budget",
                "segment-2",
                "batch-2",
                true,
                true,
                None::<String>,
            )))
            .outbound
            .is_empty()
    );
    assert_eq!(
        runtime
            .last_acknowledged_identity()
            .map(|identity| (identity.segment_id.as_str(), identity.batch_id.as_str())),
        Some(("segment-2", "batch-2"))
    );
}

#[test]
fn target_runtime_negative_ack_clears_state_and_retry_keeps_delivery_identity() {
    let mut runtime = target_runtime_ready("request-1", "job-1");
    let first_batch = target_batch_message("request-1", "job-1", TargetCompleteness::Partial);
    runtime.publish_batch(first_batch);
    let negative = TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        false,
        false,
        Some("staging_unavailable"),
    ));
    let rejected = runtime.handle(negative.clone());
    assert_eq!(
        target_action_error(rejected, "batch_rejected").retryable,
        true
    );
    assert!(runtime.active_request().is_none());
    assert_eq!(
        target_action_error(runtime.handle(negative), "batch_rejected").retryable,
        true
    );

    let mut retry = TargetAnalyzeRequest::new(
        "request-2",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    retry.recovery = Some(codex_rollout_collector::protocol::TargetRecovery {
        segment_id: "segment-1".to_string(),
        batch_id: "batch-1".to_string(),
    });
    assert!(
        runtime
            .handle(TargetMessage::Analyze(retry))
            .outbound
            .is_empty()
    );

    let retry_batch = target_batch_message("request-2", "job-1", TargetCompleteness::Partial);
    assert!(runtime.publish_batch(retry_batch).outbound.len() == 1);
    let old_ack = runtime.handle(TargetMessage::Ack(TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    )));
    assert_eq!(target_action_error(old_ack, "ack_rejected").fatal, false);
    assert!(runtime.awaiting_ack().is_some());
    assert!(
        runtime
            .handle(TargetMessage::Ack(TargetAckMessage::new(
                "request-2",
                "job-1",
                "segment-1",
                "batch-1",
                true,
                true,
                None::<String>,
            )))
            .outbound
            .is_empty()
    );

    let complete = target_complete_message("request-2", "job-1", TargetCompleteness::Partial);
    assert_eq!(
        runtime.complete_request(complete.clone()).outbound,
        vec![TargetMessage::Complete(complete)]
    );
}

#[cfg(any(unix, windows))]
fn create_directory_symlink(target: &Path, link: &Path) -> io::Result<()> {
    #[cfg(unix)]
    {
        std::os::unix::fs::symlink(target, link)
    }
    #[cfg(windows)]
    {
        std::os::windows::fs::symlink_dir(target, link)
    }
}

fn symlink_creation_requires_unavailable_privilege(error: &io::Error) -> bool {
    error.kind() == io::ErrorKind::PermissionDenied
        || (cfg!(windows) && error.raw_os_error() == Some(1314))
}

#[cfg(any(unix, windows))]
#[test]
fn existing_directory_symlink_is_canonicalized_before_target_startup() {
    let target = unique_temp_path("symlink-target");
    let link = unique_temp_path("symlink-root");
    fs::create_dir_all(&target).expect("symlink target creates");
    if let Err(error) = create_directory_symlink(&target, &link) {
        let _ = fs::remove_dir_all(&target);
        if symlink_creation_requires_unavailable_privilege(&error) {
            return;
        }
        panic!("directory symlink creates: {error}");
    }

    let normalized = normalize_sessions_root(&link).expect("directory symlink resolves");
    let expected = fs::canonicalize(&target).expect("symlink target canonicalizes");
    let _ = fs::remove_file(&link);
    let _ = fs::remove_dir_all(&target);

    assert_eq!(normalized, expected);
}

fn target_base_capabilities() -> [&'static str; 4] {
    [
        TARGET_ANALYZE_CAPABILITY,
        TARGET_CANCEL_CAPABILITY,
        TARGET_CHECKPOINT_CAPABILITY,
        TARGET_ACK_CAPABILITY,
    ]
}

fn target_parser_provenance() -> ParserProvenance {
    ParserProvenance::for_profile(CompatibilityProfile::Current)
}

fn target_partial_batch() -> TargetAnalysisBatch {
    TargetAnalysisBatch {
        conversation_id: "conversation-1".to_string(),
        source_id: "source-1".to_string(),
        source_epoch: "epoch-1".to_string(),
        source_range: None,
        history_items: Vec::new(),
        diagnostics: Vec::new(),
        parser_provenance: target_parser_provenance(),
        complete: false,
        completeness: TargetCompleteness::Partial,
        projection: json!({"coverage": "partial"}),
        tool_details: Vec::new(),
        usage: None,
        task_outcomes: Vec::new(),
        progress: TargetProgress::default(),
        next_cursor: None,
        mutations: vec![TargetMutation::MarkPartial { source_range: None }],
        history_base: None,
        replacements: Vec::new(),
        reducer_state: None,
        lineage_transitions: Vec::new(),
        lineage_coverage: None,
        lineage_checkpoint: None,
    }
}

fn target_canonical_batch() -> TargetAnalysisBatch {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let mut batch = target_partial_batch();
    batch.source_range = Some(cursor.complete_range);
    batch.complete = true;
    batch.completeness = TargetCompleteness::Canonical;
    batch.projection = json!({"coverage": "complete"});
    batch.next_cursor = Some(cursor);
    batch.reducer_state = Some(
        TargetReducerCheckpointState::from_payload(json!({"active_turn_id": null}), "target-v1")
            .expect("canonical reducer state"),
    );
    batch.mutations = vec![TargetMutation::CompleteRange {
        source_range: batch.source_range.expect("canonical source range"),
    }];
    batch
}

fn target_batch_message(
    request_id: &str,
    job_id: &str,
    completeness: TargetCompleteness,
) -> TargetBatchMessage {
    let payload = match completeness {
        TargetCompleteness::Canonical => target_canonical_batch(),
        TargetCompleteness::Unknown
        | TargetCompleteness::Partial
        | TargetCompleteness::Provisional => {
            let mut batch = target_partial_batch();
            batch.completeness = completeness;
            batch
        }
    };
    TargetBatchMessage::new(request_id, job_id, "segment-1", "batch-1", payload)
}

fn target_complete_message(
    request_id: &str,
    job_id: &str,
    completeness: TargetCompleteness,
) -> TargetCompleteMessage {
    let (status, cursor) = match completeness {
        TargetCompleteness::Canonical => (
            TargetCompleteStatus::Completed,
            Some(target_cursor(TargetCursorKind::ForwardAppend)),
        ),
        TargetCompleteness::Partial | TargetCompleteness::Provisional => {
            (TargetCompleteStatus::Partial, None)
        }
        TargetCompleteness::Unknown => panic!("unknown is not a request-level complete state"),
    };
    TargetCompleteMessage::new(
        request_id,
        job_id,
        status,
        completeness,
        cursor,
        target_checkpoint(request_id, job_id, completeness),
    )
}

fn target_runtime_ready(request_id: &str, job_id: &str) -> TargetRuntime {
    target_runtime_ready_with_timeout(request_id, job_id, 30_000)
}

fn target_runtime_ready_with_timeout(
    request_id: &str,
    job_id: &str,
    timeout_ms: u64,
) -> TargetRuntime {
    target_runtime_ready_with_limits(
        request_id,
        job_id,
        TargetResourceLimits {
            max_decoded_bytes: None,
            max_line_bytes: None,
            max_segment_bytes: None,
            tail_bytes: None,
            timeout_ms: Some(timeout_ms),
        },
    )
}

fn target_runtime_ready_with_limits(
    request_id: &str,
    job_id: &str,
    resource_limits: TargetResourceLimits,
) -> TargetRuntime {
    let root = fs::canonicalize(env!("CARGO_MANIFEST_DIR")).expect("crate root canonicalizes");
    let StartupMode::Target(config) =
        parse_startup_args(startup_args("1", &root)).expect("target startup parses")
    else {
        panic!("target startup must select target runtime");
    };
    let mut runtime = TargetRuntime::new(config);
    let hello = runtime.handle(target_node_hello("generation-1"));
    assert!(matches!(
        hello.outbound.as_slice(),
        [TargetMessage::AnalyzerHello(_)]
    ));
    let mut request = TargetAnalyzeRequest::new(
        request_id,
        job_id,
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    request.resource_limits = Some(resource_limits);
    let accepted = runtime.handle(TargetMessage::Analyze(request));
    assert!(accepted.outbound.is_empty());
    assert_eq!(
        runtime
            .active_request()
            .map(|request| request.request_id.as_str()),
        Some(request_id)
    );
    runtime
}

fn target_action_error(
    action: codex_rollout_collector::protocol::TargetRuntimeAction,
    expected_code: &str,
) -> TargetErrorMessage {
    assert_eq!(action.outbound.len(), 1);
    target_error(
        action.outbound.into_iter().next().expect("runtime error"),
        expected_code,
    )
}

fn target_history_item(
    event_id: &str,
    item_key: &str,
    conversation_id: Option<&str>,
    source_identity: &str,
    byte_start: u64,
    byte_end: u64,
