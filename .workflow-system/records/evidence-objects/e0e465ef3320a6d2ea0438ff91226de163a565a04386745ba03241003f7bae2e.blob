}

fn target_checkpoint(
    request_id: &str,
    job_id: &str,
    completeness: TargetCompleteness,
) -> TargetAnalyzerCheckpoint {
    let mut checkpoint = TargetAnalyzerCheckpoint {
        schema_version: 1,
        job_id: job_id.to_string(),
        request_id: request_id.to_string(),
        conversation_id: "conversation-1".to_string(),
        source: TargetCheckpointSource {
            source_id: "source-1".to_string(),
            source_epoch: "epoch-1".to_string(),
            source_range: None,
            snapshot_boundary: TargetSnapshotBoundary::physical_bytes(0),
        },
        reader: TargetCheckpointReader {
            backend: "target-reader".to_string(),
            version: "target-reader-v1".to_string(),
            source_kind: TargetSourceKind::Rollout,
            compression: TargetSourceCompression::PlainJsonl,
        },
        wire_profile: TargetCheckpointWireProfile {
            parser_backend: "target-parser".to_string(),
            wire_source_revision: "wire-v1".to_string(),
            compatibility_profile: json!("current"),
        },
        cursor_kind: None,
        cursor: None,
        segment: TargetCheckpointSegment {
            source_range: None,
            physical_line_start: None,
            physical_line_end: None,
            rollout_ordinal: None,
        },
        reducer_state: TargetReducerCheckpointState::from_payload(
            json!({"active_turn_id": null}),
            "target-v1",
        )
        .expect("target reducer state"),
        projection_watermark: TargetProjectionWatermark {
            schema_version: 1,
            segment_id: "segment-1".to_string(),
            batch_id: "batch-1".to_string(),
            source_id: Some("source-1".to_string()),
            source_epoch: "epoch-1".to_string(),
            complete_source_end: None,
            logical_item_count: 0,
        },
        completeness,
        lineage_checkpoint: None,
    };
    if completeness == TargetCompleteness::Canonical {
        let cursor = target_cursor(TargetCursorKind::ForwardAppend);
        checkpoint.source.source_range = Some(cursor.complete_range);
        checkpoint.source.snapshot_boundary = cursor.snapshot_boundary;
        checkpoint.cursor_kind = Some(cursor.cursor_kind);
        checkpoint.cursor = Some(cursor.clone());
        checkpoint.segment.source_range = Some(cursor.complete_range);
        checkpoint.projection_watermark.complete_source_end = Some(cursor.complete_range.end);
    }
    checkpoint
}

fn target_checkpoint_value(
    request_id: &str,
    job_id: &str,
    completeness: TargetCompleteness,
) -> serde_json::Value {
    serde_json::to_value(target_checkpoint(request_id, job_id, completeness))
        .expect("target checkpoint value")
}

fn target_cursor(kind: TargetCursorKind) -> TargetAnalyzerCursor {
    TargetAnalyzerCursor {
        schema_version: 1,
        reader_backend: "target-reader".to_string(),
        reader_version: "target-reader-v1".to_string(),
        cursor_kind: kind,
        conversation_id: "conversation-1".to_string(),
        source_id: "source-1".to_string(),
        source_epoch: "epoch-1".to_string(),
        source_kind: TargetSourceKind::Rollout,
        compression: TargetSourceCompression::PlainJsonl,
        snapshot_boundary: TargetSnapshotBoundary::physical_bytes(100),
        complete_range: TargetSourceByteRange::new(0, 100).expect("cursor range"),
        last_complete_line: None,
        last_rollout_ordinal: Some(1),
        capabilities: TargetCursorCapabilities {
            forward_stream: true,
            tail_preview: true,
            backward_segments: true,
            append: true,
            random_seek: false,
        },
    }
}

fn target_checkpoint_with_cursor() -> (TargetAnalyzerCheckpoint, TargetAnalyzerCursor) {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let mut checkpoint = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    checkpoint.source.source_range = Some(cursor.complete_range);
    checkpoint.source.snapshot_boundary = cursor.snapshot_boundary;
    checkpoint.cursor_kind = Some(cursor.cursor_kind);
    checkpoint.cursor = Some(cursor.clone());
    checkpoint.segment.source_range = Some(cursor.complete_range);
    checkpoint.projection_watermark.complete_source_end = Some(cursor.complete_range.end);
    (checkpoint, cursor)
}

#[test]
fn target_hello_is_directional_and_capability_intersection_is_fail_closed() {
    let node = TargetNodeHello::new("hello-1", ["analyze", "cancel", "checkpoint", "ack"]);
    let analyzer = TargetAnalyzerHello::respond_to(
        &node,
        "analyzer-4.5",
        target_base_capabilities(),
        "target-parser",
        "target-compat",
    );

    assert_eq!(node.role, TargetRole::Node);
    assert_eq!(analyzer.role, TargetRole::Analyzer);
    assert_eq!(analyzer.header.request_id, "hello-1");
    let intersection = negotiate_capabilities(&node.capabilities, &analyzer.capabilities)
        .expect("the canonical base capabilities intersect");
    assert!(intersection.supports(TARGET_ANALYZE_CAPABILITY));
    assert!(!intersection.supports("preview"));

    let encoded = TargetMessage::NodeHello(node.clone())
        .to_json_line()
        .expect("node hello serializes");
    assert!(!encoded.contains("source_spec"));
    assert!(!encoded.contains("replay"));
    assert_eq!(
        TargetMessage::parse_line(&encoded).expect("node hello parses"),
        TargetMessage::NodeHello(node)
    );

    let analyzer_encoded = TargetMessage::AnalyzerHello(analyzer.clone())
        .to_json_line()
        .expect("analyzer hello serializes");
    assert_eq!(
        TargetMessage::parse_line(&analyzer_encoded).expect("analyzer hello parses"),
        TargetMessage::AnalyzerHello(analyzer)
    );
}

#[test]
fn target_capability_mismatch_and_mode_errors_fail_closed() {
    let missing = negotiate_capabilities(
        &[
            TARGET_ANALYZE_CAPABILITY.to_string(),
            TARGET_CANCEL_CAPABILITY.to_string(),
        ],
        &target_base_capabilities()
            .into_iter()
            .map(str::to_string)
            .collect::<Vec<_>>(),
    )
    .expect_err("missing checkpoint and ack must fail the handshake");
    assert!(matches!(
        missing,
        TargetProtocolError::CapabilityMismatch { .. }
    ));

    let invalid_mode = r#"{
        "protocol_version": 1,
        "message_type": "analyze",
        "request_id": "request-1",
        "job_id": "job-1",
        "conversation_id": "conversation-1",
        "mode": "replay"
    }"#;
    assert!(TargetMessage::parse_line(invalid_mode).is_err());

    let missing_job = r#"{
        "protocol_version": 1,
        "message_type": "analyze",
        "request_id": "request-1",
        "conversation_id": "conversation-1",
        "mode": "preview"
    }"#;
    assert!(TargetMessage::parse_line(missing_job).is_err());
}

#[test]
fn target_analyze_round_trip_ignores_unknown_legacy_fields_without_emitting_them() {
    let mut request = TargetAnalyzeRequest::new(
        "request-1",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Append,
    );
    request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(4096),
        max_line_bytes: Some(1024),
        max_segment_bytes: Some(2048),
        tail_bytes: Some(512),
        timeout_ms: Some(1000),
    });
    request.recovery = Some(codex_rollout_collector::protocol::TargetRecovery {
        segment_id: "segment-1".to_string(),
        batch_id: "batch-1".to_string(),
    });

    let line = TargetMessage::Analyze(request.clone())
        .to_json_line()
        .expect("target analyze serializes");
    let value: serde_json::Value = serde_json::from_str(&line).expect("serialized JSON");
    assert_eq!(value["mode"], "append");
    assert!(value.get("source_spec").is_none());
    assert!(value.get("discovery").is_none());
    assert!(value.get("retention_profile").is_none());
    assert!(value.get("replay").is_none());
    assert!(value.get("revision").is_none());
    assert_eq!(
        TargetMessage::parse_line(&line).expect("target analyze parses"),
        TargetMessage::Analyze(request)
    );

    let mut legacy_annotated = value;
    legacy_annotated["source_spec"] = json!({"path": "must-not-drive-target"});
    legacy_annotated["replay"] = json!(true);
    legacy_annotated["legacy_field"] = json!("additive");
    let parsed = TargetMessage::parse_line(
        &serde_json::to_string(&legacy_annotated).expect("legacy annotated JSON"),
    )
    .expect("unknown additive fields are ignored at the target boundary");
    let reparsed = parsed.to_json_line().expect("parsed target reserializes");
    assert!(!reparsed.contains("must-not-drive-target"));
    assert!(!reparsed.contains("replay"));
}

#[test]
fn target_analyze_cursor_and_persisted_anchor_must_match() {
    let (checkpoint, cursor) = target_checkpoint_with_cursor();
    let mut request = TargetAnalyzeRequest::new(
        "request-1",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Append,
    );
    request.persisted_anchor = Some(checkpoint.clone());
    assert!(
        request.validate().is_err(),
        "analyze cursor is required when persisted anchor carries a cursor"
    );

    request.cursor = Some(cursor.clone());
    assert!(request.validate().is_ok());
    let line = TargetMessage::Analyze(request.clone())
        .to_json_line()
        .expect("matching cursor and persisted anchor serialize");
    let mut missing_request_cursor: serde_json::Value =
        serde_json::from_str(&line).expect("analyze JSON");
    missing_request_cursor
        .as_object_mut()
        .expect("analyze object")
        .remove("cursor");
    assert!(
        serde_json::from_value::<TargetAnalyzeRequest>(missing_request_cursor.clone()).is_err(),
        "direct analyze serde must reject a missing cursor when anchor has one"
    );
    assert!(
        serde_json::from_value::<TargetMessage>(missing_request_cursor.clone()).is_err(),
        "direct target message serde must reject the mismatched recovery pair"
    );
    assert!(
        TargetMessage::parse_line(
            &serde_json::to_string(&missing_request_cursor).expect("missing cursor JSON")
        )
        .is_err(),
        "JSONL parse must reject the mismatched recovery pair"
    );

    let mut request_with_unexpected_cursor = TargetAnalyzeRequest::new(
        "request-1",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Append,
    );
    request_with_unexpected_cursor.cursor = Some(cursor);
    request_with_unexpected_cursor.persisted_anchor = Some(target_checkpoint(
        "request-1",
        "job-1",
        TargetCompleteness::Partial,
    ));
    assert!(
        request_with_unexpected_cursor.validate().is_err(),
        "request cursor must also be rejected when persisted anchor cursor is null"
    );
}

#[test]
fn target_analyze_cursor_required_nullable_keys_cannot_be_omitted() {
    let mut request = TargetAnalyzeRequest::new(
        "request-1",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Append,
    );
    request.cursor = Some(target_cursor(TargetCursorKind::ForwardAppend));
    let request_value = serde_json::to_value(&request).expect("target analyze request");

    for key in ["last_complete_line", "last_rollout_ordinal"] {
        let mut missing = request_value.clone();
        missing["cursor"]
            .as_object_mut()
            .expect("cursor object")
            .remove(key);
        assert!(
            serde_json::from_value::<TargetAnalyzerCursor>(missing["cursor"].clone()).is_err(),
            "direct cursor serde must reject missing {key}"
        );
        assert!(
            serde_json::from_value::<TargetAnalyzeRequest>(missing.clone()).is_err(),
            "direct analyze serde must reject missing {key}"
        );
        assert!(
            TargetMessage::parse_line(
                &serde_json::to_string(&missing).expect("missing cursor JSON")
            )
            .is_err(),
            "JSONL parse must reject missing {key}"
        );
    }

    let mut explicit_null = request_value;
    explicit_null["cursor"]["last_complete_line"] = json!(null);
    explicit_null["cursor"]["last_rollout_ordinal"] = json!(null);
    assert!(
        serde_json::from_value::<TargetAnalyzerCursor>(explicit_null["cursor"].clone()).is_ok()
    );
    assert!(serde_json::from_value::<TargetAnalyzeRequest>(explicit_null.clone()).is_ok());
    assert!(
        TargetMessage::parse_line(
            &serde_json::to_string(&explicit_null).expect("explicit null cursor JSON")
        )
        .is_ok()
    );
}

#[test]
fn target_resource_limits_validate_numeric_shape_and_relationship() {
    let mut request = TargetAnalyzeRequest::new(
        "request-1",
        "job-1",
        "conversation-1",
        TargetAnalyzeMode::Preview,
    );
    request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: None,
        max_line_bytes: Some(2048),
        max_segment_bytes: Some(1024),
        tail_bytes: None,
        timeout_ms: None,
    });
    assert!(request.validate().is_err());

    let invalid_type = r#"{
        "protocol_version": 1,
        "message_type": "analyze",
        "request_id": "request-1",
        "job_id": "job-1",
        "conversation_id": "conversation-1",
        "mode": "preview",
        "resource_limits": {"timeout_ms": -1}
    }"#;
    assert!(TargetMessage::parse_line(invalid_type).is_err());
}

#[test]
fn target_outer_identity_and_payload_boundary_are_validated() {
    let valid = TargetBatchMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        target_partial_batch(),
    );
    let line = TargetMessage::Batch(valid.clone())
        .to_json_line()
        .expect("batch serializes");
    assert_eq!(
        TargetMessage::parse_line(&line).expect("batch parses"),
        TargetMessage::Batch(valid)
    );

    let mut payload_with_outer_id =
        serde_json::to_value(target_partial_batch()).expect("target payload serializes");
    payload_with_outer_id["batch_id"] = json!("must-stay-outer");
    let without_duplicate = TargetBatchMessage::from_payload_value(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        payload_with_outer_id,
    )
    .expect("payload ignores duplicate outer identity");
    let without_duplicate_value: serde_json::Value = serde_json::from_str(
        &TargetMessage::Batch(without_duplicate)
            .to_json_line()
            .unwrap(),
    )
    .expect("target batch JSON");
    assert_eq!(without_duplicate_value["batch_id"], "batch-1");
    assert!(without_duplicate_value["payload"].get("batch_id").is_none());

    let missing_outer = r#"{
        "protocol_version": 1,
        "message_type": "batch",
        "request_id": "request-1",
        "job_id": "job-1",
        "segment_id": "segment-1",
        "payload": {}
    }"#;
    assert!(TargetMessage::parse_line(missing_outer).is_err());

    let mut old_payload =
        serde_json::to_value(target_partial_batch()).expect("target payload serializes");
    old_payload["revision"] = json!(1);
    let old_payload = TargetBatchMessage::from_payload_value(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        old_payload,
    )
    .expect("legacy revision is not target data");
    let old_payload_value: serde_json::Value = serde_json::from_str(
        &serde_json::to_string(&old_payload).expect("target batch serializes"),
    )
    .expect("target batch JSON");
    assert!(old_payload_value["payload"].get("revision").is_none());
}

#[test]
fn target_complete_accepts_legacy_ok_inbound_but_never_serializes_it() {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let checkpoint = serde_json::to_value(target_checkpoint(
        "request-1",
        "job-1",
        TargetCompleteness::Canonical,
    ))
    .expect("target checkpoint serializes");
    let legacy_value = json!({
        "protocol_version": 1,
        "message_type": "complete",
        "request_id": "request-1",
        "job_id": "job-1",
        "status": "ok",
        "completeness": "canonical",
        "next_cursor": cursor,
        "checkpoint": checkpoint
    });
    let legacy_line = serde_json::to_string(&legacy_value).expect("legacy JSON serializes");
    let parsed = TargetMessage::parse_line(&legacy_line).expect("legacy ok parses inbound");
    let legacy_message = match parsed {
        TargetMessage::Complete(message) => {
            assert_eq!(message.status, TargetCompleteStatus::Ok);
            message
        }
        other => panic!("expected complete message, got {other:?}"),
    };

    assert!(legacy_message.validate().is_ok());
    assert!(legacy_message.validate_for_output().is_err());
    assert!(serde_json::to_string(&legacy_message).is_err());
    assert!(
        TargetMessage::Complete(legacy_message)
            .to_json_line()
            .is_err()
    );

    for completeness in ["partial", "provisional", "unknown"] {
        let invalid = json!({
            "protocol_version": 1,
            "message_type": "complete",
            "request_id": "request-1",
            "job_id": "job-1",
            "status": "ok",
            "completeness": completeness,
            "next_cursor": null,
            "checkpoint": target_checkpoint_value("request-1", "job-1", TargetCompleteness::Canonical)
        });
        assert!(
            TargetMessage::parse_line(&serde_json::to_string(&invalid).expect("invalid JSON"))
                .is_err(),
            "ok + {completeness} must remain invalid"
        );
    }

    let completed = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Canonical,
        Some(target_cursor(TargetCursorKind::ForwardAppend)),
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical),
    );
    let encoded = TargetMessage::Complete(completed).to_json_line().unwrap();
    assert!(encoded.contains(r#""status":"completed""#));
    assert!(!encoded.contains(r#""status":"ok""#));
}

#[test]
fn target_payload_and_checkpoint_drop_legacy_fields_without_using_them() {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let mut payload = serde_json::to_value(target_partial_batch()).expect("target payload");
    payload["revision"] = json!(1);
    payload["replay"] = json!(true);
    let batch = TargetBatchMessage::from_payload_value(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        payload,
    )
    .expect("legacy fields are ignored by typed target mapping");
    let direct_batch_line = serde_json::to_string(&batch).expect("direct target batch serializes");
    let direct_batch_value: serde_json::Value =
        serde_json::from_str(&direct_batch_line).expect("target batch JSON");
    assert!(direct_batch_value["payload"].get("revision").is_none());
    assert!(direct_batch_value["payload"].get("replay").is_none());

    let mut checkpoint =
        target_checkpoint_value("request-1", "job-1", TargetCompleteness::Canonical);
    checkpoint["fingerprint"] = json!("legacy");
    checkpoint["prefix_anchor"] = json!("legacy");
    checkpoint["replay"] = json!(true);
    let complete_value = json!({
        "protocol_version": 1,
        "message_type": "complete",
        "request_id": "request-1",
        "job_id": "job-1",
        "status": "completed",
        "completeness": "canonical",
        "next_cursor": cursor,
        "checkpoint": checkpoint
    });
    let complete =
        TargetMessage::parse_line(&serde_json::to_string(&complete_value).expect("complete JSON"))
            .expect("legacy checkpoint fields are ignored by typed mapping");
    let direct_complete_line =
        serde_json::to_string(&complete).expect("direct complete serializes");
    let direct_complete_value: serde_json::Value =
        serde_json::from_str(&direct_complete_line).expect("complete JSON");
    assert!(
        direct_complete_value["checkpoint"]
            .get("fingerprint")
            .is_none()
    );
    assert!(
        direct_complete_value["checkpoint"]
            .get("prefix_anchor")
            .is_none()
    );
    assert!(direct_complete_value["checkpoint"].get("replay").is_none());

    let valid_batch = TargetBatchMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        target_partial_batch(),
    );
    let direct_batch_line =
        serde_json::to_string(&valid_batch).expect("direct target batch serializes");
    let batch_line = TargetMessage::Batch(valid_batch)
        .to_json_line()
        .expect("nested target payload serializes");

    let valid_complete = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Canonical,
        Some(target_cursor(TargetCursorKind::ForwardAppend)),
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical),
    );
    let direct_complete_line =
        serde_json::to_string(&valid_complete).expect("direct target checkpoint serializes");
    let complete_line = TargetMessage::Complete(valid_complete)
        .to_json_line()
        .expect("nested target checkpoint serializes");
    assert!(!direct_batch_line.contains("source_spec"));
    assert!(!direct_complete_line.contains("source_spec"));
    assert!(!batch_line.contains("source_spec"));
    assert!(!complete_line.contains("source_spec"));
}

#[test]
fn target_required_nullable_keys_cannot_be_omitted() {
    let mut missing_usage = serde_json::to_value(target_partial_batch()).expect("target payload");
    missing_usage
        .as_object_mut()
        .expect("payload object")
        .remove("usage");
    assert!(
        TargetBatchMessage::from_payload_value(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            missing_usage,
        )
        .is_err(),
        "missing usage must not be treated as explicit null"
    );

    let mut missing_next_cursor =
        serde_json::to_value(target_partial_batch()).expect("target payload");
    missing_next_cursor
        .as_object_mut()
        .expect("payload object")
        .remove("next_cursor");
    assert!(
        TargetBatchMessage::from_payload_value(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            missing_next_cursor,
        )
        .is_err(),
        "missing next_cursor must not be treated as explicit null"
    );

    let mut missing_checkpoint_nullable =
        target_checkpoint_value("request-1", "job-1", TargetCompleteness::Canonical);
    missing_checkpoint_nullable["source"]
        .as_object_mut()
        .expect("checkpoint source object")
        .remove("source_range");
    let missing_checkpoint = json!({
        "protocol_version": 1,
        "message_type": "complete",
        "request_id": "request-1",
        "job_id": "job-1",
        "status": "completed",
        "completeness": "canonical",
        "next_cursor": null,
        "checkpoint": missing_checkpoint_nullable
    });
    assert!(
        TargetMessage::parse_line(&serde_json::to_string(&missing_checkpoint).expect("JSON"))
            .is_err(),
        "missing checkpoint nullable key must fail closed"
    );

    let mut missing_complete_cursor = json!({
        "protocol_version": 1,
        "message_type": "complete",
        "request_id": "request-1",
        "job_id": "job-1",
        "status": "partial",
        "completeness": "partial",
        "checkpoint": target_checkpoint_value(
            "request-1",
            "job-1",
            TargetCompleteness::Partial
        )
    });
    assert!(
        serde_json::from_value::<TargetMessage>(missing_complete_cursor.clone()).is_err(),
        "direct serde must reject missing complete next_cursor"
    );
    missing_complete_cursor["next_cursor"] = json!(null);
    let complete = TargetMessage::parse_line(
        &serde_json::to_string(&missing_complete_cursor).expect("explicit null JSON"),
    )
    .expect("explicit null next_cursor remains valid");
    assert!(serde_json::to_string(&complete).is_ok());
    assert!(complete.to_json_line().is_ok());
}

#[test]
fn target_canonical_projection_and_transition_evidence_are_fail_closed() {
    let mut partial_projection = target_canonical_batch();
    partial_projection.projection = json!({"coverage": "partial"});
    assert!(partial_projection.validate().is_err());

    let mut unknown_projection = target_canonical_batch();
    unknown_projection.projection = json!({"coverage": "unknown"});
    assert!(unknown_projection.validate().is_err());

    let (history_base, transitions, coverage) = target_lineage_evidence();
    let replacement = target_replacement();
    let mut missing_replacements = target_canonical_batch();
    missing_replacements.history_base = Some(history_base.clone());
    missing_replacements.lineage_transitions = transitions.clone();
    missing_replacements.lineage_coverage = Some(coverage.clone());
    missing_replacements.mutations.insert(
        0,
        TargetMutation::ReplaceLastTurn {
            replacement: replacement.clone(),
        },
    );
    assert!(missing_replacements.validate().is_err());

    let mut mismatched_replacements = missing_replacements.clone();
    let other_replacement = LastTurnReplacement::new(
        "conversation-1",
        "parent-rollout",
        "child-rollout",
        "old-turn-2",
        "new-turn-2",
        TurnStatus::Completed,
        history_base.clone(),
        target_source_ref("parent-rollout", 10, 20, 1),
        target_source_ref("parent-rollout", 30, 40, 2),
        target_source_ref("child-rollout", 50, 60, 1),
    );
    mismatched_replacements.replacements = vec![other_replacement];
    assert!(mismatched_replacements.validate().is_err());

    let mut valid = missing_replacements;
    valid.replacements = vec![replacement];
    assert!(valid.validate().is_ok());

    let mut missing_history_base = target_canonical_batch();
    missing_history_base.lineage_transitions = transitions.clone();
    missing_history_base.lineage_coverage = Some(coverage.clone());
    assert!(missing_history_base.validate().is_err());

    let mut missing_lineage_coverage = target_canonical_batch();
    missing_lineage_coverage.history_base = Some(history_base);
    missing_lineage_coverage.lineage_transitions = transitions;
    assert!(missing_lineage_coverage.validate().is_err());
}

#[test]
fn target_canonical_batch_rejects_mark_partial_at_all_outbound_boundaries() {
    let mut invalid = target_canonical_batch();
    invalid
        .mutations
        .insert(0, TargetMutation::MarkPartial { source_range: None });
    assert!(invalid.validate().is_err());

    let direct_message = TargetBatchMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        invalid.clone(),
    );
    assert!(serde_json::to_string(&direct_message).is_err());
    assert!(
        TargetMessage::Batch(TargetBatchMessage::new(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            invalid.clone(),
        ))
        .to_json_line()
        .is_err()
    );

    let mut payload = serde_json::to_value(target_canonical_batch()).expect("canonical payload");
    payload["mutations"]
        .as_array_mut()
        .expect("canonical mutations")
        .insert(0, json!({"mutation": "mark_partial", "source_range": null}));
    assert!(
        TargetBatchMessage::from_payload_value(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            payload.clone(),
        )
        .is_err()
    );
    let envelope = json!({
        "protocol_version": 1,
        "message_type": "batch",
        "request_id": "request-1",
        "job_id": "job-1",
        "segment_id": "segment-1",
        "batch_id": "batch-1",
        "payload": payload,
    });
    assert!(
        TargetMessage::parse_line(&serde_json::to_string(&envelope).expect("batch JSON")).is_err()
    );
}

#[test]
fn target_history_items_require_identity_binding_and_batch_source_scope() {
    let valid = target_history_batch();
    assert!(valid.validate().is_ok());
    let valid_payload = serde_json::to_value(&valid).expect("valid history payload");
    assert!(
        TargetBatchMessage::from_payload_value(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            valid_payload.clone(),
        )
        .is_ok()
    );
    assert!(
        serde_json::to_string(&TargetBatchMessage::new(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            valid.clone(),
        ))
        .is_ok()
    );
    assert!(
        TargetMessage::Batch(TargetBatchMessage::new(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            valid.clone(),
        ))
        .to_json_line()
        .is_ok()
    );
    let valid_envelope = json!({
        "protocol_version": 1,
        "message_type": "batch",
        "request_id": "request-1",
        "job_id": "job-1",
        "segment_id": "segment-1",
        "batch_id": "batch-1",
        "payload": valid_payload,
    });
    assert!(
        TargetMessage::parse_line(
            &serde_json::to_string(&valid_envelope).expect("valid batch JSON")
        )
        .is_ok()
    );

    let mut missing_event_id = valid.clone();
    missing_event_id.history_items[0]
        .metadata_mut()
        .event_id
        .clear();
    let mut mismatched_conversation = valid.clone();
    mismatched_conversation.history_items[0]
        .metadata_mut()
        .conversation_id = Some("conversation-other".to_string());
    let mut out_of_scope = valid.clone();
    out_of_scope.history_items[0]
        .metadata_mut()
        .source_ref
        .byte_start = 101;
    out_of_scope.history_items[0]
        .metadata_mut()
        .source_ref
        .byte_end = 110;

    for (label, invalid) in [
        ("empty event_id", missing_event_id),
        ("mismatched conversation_id", mismatched_conversation),
        ("same-source out-of-scope source_ref", out_of_scope),
    ] {
        assert!(!invalid.validate().is_ok(), "{label} must fail validation");
        let payload = serde_json::to_value(&invalid).expect("invalid payload remains encodable");
        assert!(
            TargetBatchMessage::from_payload_value(
                "request-1",
                "job-1",
                "segment-1",
                "batch-1",
                payload.clone(),
            )
            .is_err(),
            "{label} must fail payload validation"
        );
        assert!(
            serde_json::to_string(&TargetBatchMessage::new(
                "request-1",
                "job-1",
                "segment-1",
                "batch-1",
                invalid.clone(),
            ))
            .is_err(),
            "{label} must fail direct serialization"
        );
        assert!(
            TargetMessage::Batch(TargetBatchMessage::new(
                "request-1",
                "job-1",
                "segment-1",
                "batch-1",
                invalid,
            ))
            .to_json_line()
            .is_err(),
            "{label} must fail JSONL serialization"
        );
        let envelope = json!({
            "protocol_version": 1,
            "message_type": "batch",
            "request_id": "request-1",
            "job_id": "job-1",
            "segment_id": "segment-1",
            "batch_id": "batch-1",
            "payload": payload,
        });
        assert!(
            TargetMessage::parse_line(
                &serde_json::to_string(&envelope).expect("invalid batch JSON")
            )
            .is_err(),
            "{label} must fail JSONL parsing"
        );
    }

    let mut optional_conversation = valid.clone();
    optional_conversation.history_items[0]
        .metadata_mut()
        .conversation_id = None;
    assert!(optional_conversation.validate().is_ok());

    let mut lineage_source = optional_conversation;
    lineage_source.history_items[0]
        .metadata_mut()
        .source_ref
        .source_identity = "lineage-source".to_string();
    assert!(lineage_source.validate().is_ok());
}

#[test]
fn target_lineage_checkpoint_requires_bound_matching_validated_evidence() {
    let checkpoint = target_lineage_checkpoint();
    let mut standalone = target_canonical_batch();
    standalone.lineage_checkpoint = Some(checkpoint.clone());
    assert!(standalone.validate().is_err());

    let (history_base, transitions, coverage) = target_lineage_evidence();
    let mut valid = target_canonical_batch();
    valid.history_base = Some(history_base);
    valid.lineage_transitions = transitions;
    valid.lineage_coverage = Some(coverage);
    valid.lineage_checkpoint = Some(checkpoint);
    assert!(valid.validate().is_ok());

    let mut analyzer_checkpoint =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    analyzer_checkpoint.lineage_checkpoint = Some(target_lineage_checkpoint());
    assert!(analyzer_checkpoint.validate().is_ok());

    let mut mismatched = valid.clone();
    mismatched
        .lineage_checkpoint
        .as_mut()
        .expect("lineage checkpoint")
        .coverage
        .active_head_rollout_id = "other-head".to_string();
    assert!(mismatched.validate().is_err());

    let mut checkpoint_shape = target_lineage_checkpoint();
    checkpoint_shape.active_head_rollout_id = "other-head".to_string();
    assert!(checkpoint_shape.validate().is_err());

    let mut mismatched_analyzer_checkpoint =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    mismatched_analyzer_checkpoint.lineage_checkpoint = Some(checkpoint_shape);
    assert!(mismatched_analyzer_checkpoint.validate().is_err());
}

#[test]
fn target_batch_lineage_checkpoint_required_nullable_keys_cannot_be_omitted() {
    let valid_batch = target_canonical_lineage_batch();
    assert!(valid_batch.validate().is_ok());
    let payload = serde_json::to_value(&valid_batch).expect("target lineage batch");

    for key in ["start_date", "end_date"] {
        let mut missing = payload.clone();
        missing["lineage_checkpoint"]
            .as_object_mut()
            .expect("lineage checkpoint object")
            .remove(key);
        assert!(
            serde_json::from_value::<TargetLineageCheckpoint>(
                missing["lineage_checkpoint"].clone()
            )
            .is_err(),
            "direct lineage checkpoint serde must reject missing {key}"
        );
        assert!(
            serde_json::from_value::<TargetAnalysisBatch>(missing.clone()).is_err(),
            "direct batch serde must reject missing {key}"
        );
        assert!(
            TargetBatchMessage::from_payload_value(
                "request-1",
                "job-1",
                "segment-1",
                "batch-1",
                missing.clone(),
            )
            .is_err(),
            "payload adapter must reject missing {key}"
        );
        let envelope = json!({
            "protocol_version": 1,
            "message_type": "batch",
            "request_id": "request-1",
            "job_id": "job-1",
            "segment_id": "segment-1",
            "batch_id": "batch-1",
            "payload": missing,
        });
        assert!(
            TargetMessage::parse_line(
                &serde_json::to_string(&envelope).expect("missing lineage checkpoint JSON")
            )
            .is_err(),
            "JSONL parse must reject missing {key}"
        );
    }

    let mut explicit_null = payload;
    explicit_null["lineage_checkpoint"]["start_date"] = json!(null);
    explicit_null["lineage_checkpoint"]["end_date"] = json!(null);
    assert!(
        serde_json::from_value::<TargetLineageCheckpoint>(
            explicit_null["lineage_checkpoint"].clone()
        )
        .is_ok()
    );
    assert!(serde_json::from_value::<TargetAnalysisBatch>(explicit_null.clone()).is_ok());
    assert!(
        TargetBatchMessage::from_payload_value(
            "request-1",
            "job-1",
            "segment-1",
            "batch-1",
            explicit_null.clone(),
        )
        .is_ok()
    );
}

#[test]
fn target_lineage_transition_and_replacement_validation_state_are_fail_closed() {
    let (_history_base, mut transitions, _coverage) = target_lineage_evidence();
    transitions[0].history_base.parent_rollout_id = "wrong-parent".to_string();
    assert!(transitions[0].validate().is_err());

    let (history_base, mut unavailable, coverage) = target_lineage_evidence();
    unavailable[0].validation_state = TargetLineageValidationState::ValidationUnavailable;
    let mut canonical = target_canonical_batch();
    canonical.history_base = Some(history_base.clone());
    canonical.lineage_transitions = unavailable.clone();
    canonical.lineage_coverage = Some(coverage.clone());
    assert!(canonical.validate().is_err());

    let mut partial = target_partial_batch();
    partial.history_base = Some(history_base);
    partial.lineage_transitions = unavailable;
    partial.lineage_coverage = Some(TargetLineageCoverage {
        complete: false,
        ..coverage
    });
    assert!(partial.validate().is_ok());

    let mut replacement = target_canonical_batch();
    let valid_replacement = target_replacement();
    replacement.history_base =
        Some(HistoryBaseRef::new("parent-rollout", 14, 128).expect("replacement history base"));
    replacement.lineage_transitions = vec![TargetLineageTransition {
        parent_rollout_id: "parent-rollout".to_string(),
        child_rollout_id: "child-rollout".to_string(),
        history_base: replacement.history_base.clone().expect("history base"),
        validation_state: TargetLineageValidationState::Validated,
    }];
    replacement.lineage_coverage = Some(TargetLineageCoverage {
        root_rollout_id: "parent-rollout".to_string(),
        active_head_rollout_id: "child-rollout".to_string(),
        chain_rollout_ids: vec!["parent-rollout".to_string(), "child-rollout".to_string()],
        covered_source_count: 2,
        complete: true,
    });
    replacement.mutations.insert(
        0,
        TargetMutation::ReplaceLastTurn {
            replacement: valid_replacement.clone(),
        },
    );
    replacement.replacements = vec![valid_replacement];
    replacement.lineage_transitions[0].validation_state =
        TargetLineageValidationState::ValidationUnavailable;
    assert!(replacement.validate().is_err());
}

#[test]
fn target_replacement_matches_cut_order_and_terminal_status_contract() {
    let (history_base, transitions, coverage) = target_lineage_evidence();
    let replacement = target_replacement();
    let mut valid = target_canonical_batch();
    valid.history_base = Some(history_base);
    valid.lineage_transitions = transitions;
    valid.lineage_coverage = Some(coverage);
    valid.mutations.insert(
        0,
        TargetMutation::ReplaceLastTurn {
            replacement: replacement.clone(),
        },
    );
    valid.replacements = vec![replacement.clone()];
    assert!(valid.validate().is_ok());

    let mut wrong_cut_start = valid.clone();
    if let TargetMutation::ReplaceLastTurn { replacement } = &mut wrong_cut_start.mutations[0] {
        replacement.parent_turn_start_source_ref.byte_start = 127;
    }
    assert!(wrong_cut_start.validate().is_err());

    let mut terminal_before_start = valid.clone();
    if let TargetMutation::ReplaceLastTurn { replacement } = &mut terminal_before_start.mutations[0]
    {
        replacement.parent_turn_terminal_source_ref.rollout_ordinal = Some(13);
    }
    terminal_before_start.replacements[0]
        .parent_turn_terminal_source_ref
        .rollout_ordinal = Some(13);
    assert!(terminal_before_start.validate().is_err());

    let mut partial_terminal = valid;
    if let TargetMutation::ReplaceLastTurn { replacement } = &mut partial_terminal.mutations[0] {
        replacement.replaced_turn_terminal_status = TurnStatus::Partial;
    }
    partial_terminal.replacements[0].replaced_turn_terminal_status = TurnStatus::Partial;
    assert!(partial_terminal.validate().is_err());
}

#[test]
fn target_upsert_mutations_require_matching_source_evidence() {
    let valid = target_upsert_batch();
    assert!(valid.validate().is_ok());

    let mut reversed_range = valid.clone();
    if let TargetMutation::UpsertItem { item } = &mut reversed_range.mutations[1] {
        item.source_ref.byte_start = 20;
        item.source_ref.byte_end = 10;
    }
    assert!(reversed_range.validate().is_err());

    let mut zero_line = valid.clone();
    if let TargetMutation::UpsertItem { item } = &mut zero_line.mutations[1] {
        item.source_ref.physical_line_ordinal = 0;
    }
    assert!(zero_line.validate().is_err());

    let mut mismatched_epoch = valid.clone();
    if let TargetMutation::UpsertItem { item } = &mut mismatched_epoch.mutations[1] {
        item.source_epoch = "epoch-other".to_string();
    }
    assert!(mismatched_epoch.validate().is_err());

    let mut mismatched_completeness = valid.clone();
    if let TargetMutation::UpsertItem { item } = &mut mismatched_completeness.mutations[1] {
        item.completeness = TargetCompleteness::Canonical;
    }
    assert!(mismatched_completeness.validate().is_err());

    let mut out_of_scope = valid;
    if let TargetMutation::UpsertItem { item } = &mut out_of_scope.mutations[1] {
        item.source_ref.byte_start = 101;
        item.source_ref.byte_end = 110;
    }
    assert!(out_of_scope.validate().is_err());
}

#[test]
fn target_checkpoint_scope_segment_and_profile_validation_are_strict() {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let scope = TargetSourceScope::from_cursor(&cursor);
    let mut ordinal_mismatch = cursor.clone();
    ordinal_mismatch.last_rollout_ordinal = Some(2);
    assert!(scope.matches_cursor(&ordinal_mismatch).is_err());

    let mut line_mismatch = cursor.clone();
    line_mismatch.last_complete_line = Some(TargetCompleteLineBoundary {
        physical_line_ordinal: 1,
        byte_start: 0,
        byte_end: 100,
    });
    assert!(scope.matches_cursor(&line_mismatch).is_err());

    let mut zero_line = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    zero_line.segment.physical_line_start = Some(0);
    zero_line.segment.physical_line_end = Some(0);
    assert!(zero_line.validate().is_err());

    let mut empty_profile = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    empty_profile.wire_profile.compatibility_profile = json!("");
    assert!(empty_profile.validate().is_err());

    let mut invalid_profile =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    invalid_profile.wire_profile.compatibility_profile = json!({});
    assert!(invalid_profile.validate().is_err());

    let mut reader_mismatch =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    reader_mismatch.source.source_range = Some(cursor.complete_range);
    reader_mismatch.source.snapshot_boundary = cursor.snapshot_boundary;
    reader_mismatch.segment.source_range = Some(cursor.complete_range);
    reader_mismatch.cursor_kind = Some(cursor.cursor_kind);
    reader_mismatch.cursor = Some(cursor);
    reader_mismatch.reader.backend = "different-reader".to_string();
    assert!(reader_mismatch.validate().is_err());
}

#[test]
fn target_identity_and_checkpoint_round_trip_preserve_retry_scope() {
    let identity = TargetDeliveryIdentity::new("job-1", "segment-1", "batch-1");
    let retry_identity = TargetDeliveryIdentity::new("job-1", "segment-1", "batch-1");
    identity.validate().expect("delivery identity validates");
    identity
        .matches(&retry_identity)
        .expect("retry keeps delivery identity");

    let checkpoint = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    checkpoint.validate().expect("checkpoint validates");
    let encoded = serde_json::to_vec(&checkpoint).expect("checkpoint serializes");
    let restored: TargetAnalyzerCheckpoint =
        serde_json::from_slice(&encoded).expect("checkpoint round trips");
    assert_eq!(restored, checkpoint);
    assert_eq!(restored.job_id, identity.job_id);
    assert_eq!(restored.projection_watermark.batch_id, identity.batch_id);
}

#[test]
fn target_checkpoint_rejects_cursor_kind_and_source_scope_mismatch() {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let mut checkpoint = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    checkpoint.source.source_range = Some(cursor.complete_range);
    checkpoint.source.snapshot_boundary = cursor.snapshot_boundary;
    checkpoint.segment.source_range = Some(cursor.complete_range);
    checkpoint.cursor_kind = Some(cursor.cursor_kind);
    checkpoint.cursor = Some(cursor.clone());
    checkpoint.validate().expect("matching cursor validates");

    checkpoint.cursor_kind = Some(TargetCursorKind::Backfill);
    assert!(
        checkpoint.validate().is_err(),
        "cursor kind mismatch must fail"
    );

    checkpoint.cursor_kind = Some(cursor.cursor_kind);
    checkpoint.cursor = Some(TargetAnalyzerCursor {
        source_epoch: "different-epoch".to_string(),
        ..cursor
    });
    assert!(
        checkpoint.validate().is_err(),
        "source scope mismatch must fail"
    );

    let scope = TargetSourceScope::from_cursor(&target_cursor(TargetCursorKind::ForwardAppend));
    let mut mismatched = target_cursor(TargetCursorKind::ForwardAppend);
    mismatched.source_id = "other-source".to_string();
    assert!(scope.matches_cursor(&mismatched).is_err());
}

#[test]
fn target_mapping_from_analysis_batch_keeps_identity_and_drops_legacy_revision() {
    let mut legacy =
        codex_rollout_collector::protocol::AnalysisBatch::empty(CompatibilityProfile::Current);
    legacy.source_id = Some("source-1".to_string());
    legacy.complete = false;
    legacy.completeness = BatchCompleteness::Partial;

    let mapped = TargetAnalysisBatch::from_analysis_batch(
        legacy,
        codex_rollout_collector::protocol::TargetBatchMappingContext {
            conversation_id: "conversation-1".to_string(),
            source_id: "source-1".to_string(),
            source_epoch: "epoch-1".to_string(),
            source_range: None,
            projection: json!({"coverage": "partial"}),
            tool_details: Vec::new(),
            usage: None,
            task_outcomes: Vec::new(),
            progress: TargetProgress::default(),
            next_cursor: None,
            mutations: vec![TargetMutation::MarkPartial { source_range: None }],
            reducer_state: None,
            lineage_transitions: Vec::new(),
            lineage_coverage: None,
            lineage_checkpoint: None,
        },
    )
    .expect("legacy analysis batch maps to target payload");
    assert_eq!(mapped.conversation_id, "conversation-1");
    assert_eq!(mapped.source_id, "source-1");
    assert_eq!(mapped.source_epoch, "epoch-1");
    let encoded = serde_json::to_value(mapped).expect("mapped payload serializes");
    assert!(encoded.get("revision").is_none());
    assert!(encoded.get("source_fingerprint").is_none());
    assert!(encoded.get("prefix_anchor").is_none());
}

#[test]
fn target_legacy_checkpoint_adapter_drops_legacy_source_evidence() {
    let legacy = AnalyzerCheckpoint {
        schema_version: 1,
        request_id: "request-1".to_string(),
        conversation_id: "conversation-1".to_string(),
        source: CheckpointSource {
            source_id: "source-1".to_string(),
            source_epoch: "epoch-1".to_string(),
            fingerprint: Some(
                SourceFingerprint::new("sha256-v1", "legacy-fingerprint", 0)
                    .expect("legacy fingerprint"),
            ),
            prefix_anchor: Some(
                SourcePrefixAnchor::new("sha256-v1", "legacy-anchor", 0)
                    .expect("legacy prefix anchor"),
            ),
        },
        reader: CheckpointReader {
            backend: "legacy-reader".to_string(),
            version: "stage4-v1".to_string(),
            source_kind: SourceKind::Rollout,
            compression: SourceCompression::PlainJsonl,
        },
        wire_profile: Some(target_parser_provenance()),
        cursor_kind: Some(SourceCursorKind::ForwardAppend),
        cursor: None,
        segment: CheckpointSegment {
            source_range: None,
            physical_line_start: None,
            physical_line_end: None,
            rollout_ordinal: None,
        },
        reducer_state: Some(json!({"legacy": true})),
        projection_watermark: Some("batch-1".to_string()),
        completeness: BatchCompleteness::Canonical,
        lineage_checkpoint: None,
    };
    let (template, cursor) = target_checkpoint_with_cursor();
    let mapped = TargetAnalyzerCheckpoint::from_legacy(
        &legacy,
        TargetLegacyCheckpointContext {
            job_id: "job-1".to_string(),
            conversation_id: "conversation-1".to_string(),
            source: template.source,
            reader: template.reader,
            wire_profile: template.wire_profile,
            cursor: Some(cursor),
            segment: template.segment,
            reducer_state: template.reducer_state,
            projection_watermark: template.projection_watermark,
            lineage_checkpoint: None,
        },
    )
    .expect("legacy checkpoint maps with explicit target context");
    let encoded = serde_json::to_value(mapped).expect("mapped checkpoint serializes");
    assert!(encoded["source"].get("fingerprint").is_none());
    assert!(encoded["source"].get("prefix_anchor").is_none());
    assert!(encoded.get("revision").is_none());
}

#[test]
fn target_ack_accepts_only_positive_or_stable_negative_shapes() {
    let positive = TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        true,
        true,
        None::<String>,
    );
    assert!(positive.validate().is_ok());

    let negative = TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        false,
        false,
        Some("staging_unavailable"),
    );
    assert!(negative.validate().is_ok());

    let mixed = TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        true,
        false,
        Some("staging_unavailable"),
    );
    assert!(mixed.validate().is_err());

    let free_text = TargetAckMessage::new(
        "request-1",
        "job-1",
        "segment-1",
        "batch-1",
        false,
        false,
        Some("temporary problem"),
    );
    assert!(free_text.validate().is_err());
}

#[test]
fn target_complete_and_error_envelopes_enforce_terminal_semantics() {
    let cursor = target_cursor(TargetCursorKind::ForwardAppend);
    let complete = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Canonical,
        Some(cursor),
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical),
    );
    let line = TargetMessage::Complete(complete.clone())
        .to_json_line()
        .expect("complete serializes");
    assert_eq!(
        TargetMessage::parse_line(&line).expect("complete parses"),
        TargetMessage::Complete(complete)
    );

    let invalid_complete = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Partial,
        None,
        target_checkpoint("request-1", "job-1", TargetCompleteness::Partial),
    );
    assert!(invalid_complete.validate().is_err());

    let mut error = TargetErrorMessage::new(
        "request-1",
        "batch_rejected",
        "batch was rejected",
        false,
        false,
    );
    error.details = Some(json!({"rejection_code": "batch_scope_conflict"}));
    assert!(error.validate().is_ok());

    error.details = Some(json!({"rejection_code": "free_text"}));
    assert!(error.validate().is_err());
}

#[test]
fn canonical_checkpoint_requires_complete_source_cursor_evidence_at_complete_boundaries() {
    let mut missing_source_range =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    missing_source_range.source.source_range = None;
    missing_source_range.segment.source_range = None;
    missing_source_range
        .projection_watermark
        .complete_source_end = None;
    assert!(missing_source_range.validate().is_err());

    let mut missing_cursor = target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    missing_cursor.cursor_kind = None;
    missing_cursor.cursor = None;
    assert!(missing_cursor.validate().is_err());

    let mut missing_complete_source_end =
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical);
    missing_complete_source_end
        .projection_watermark
        .complete_source_end = None;
    assert!(missing_complete_source_end.validate().is_err());

    let invalid_complete = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Canonical,
        None,
        missing_source_range.clone(),
    );
    assert!(invalid_complete.validate().is_err());
    assert!(
        TargetMessage::Complete(invalid_complete.clone())
            .to_json_line()
            .is_err()
    );
    assert!(serde_json::to_string(&invalid_complete).is_err());

    let valid_complete = TargetCompleteMessage::new(
        "request-1",
        "job-1",
        TargetCompleteStatus::Completed,
        TargetCompleteness::Canonical,
        Some(target_cursor(TargetCursorKind::ForwardAppend)),
        target_checkpoint("request-1", "job-1", TargetCompleteness::Canonical),
    );
    let mut malformed = serde_json::to_value(TargetMessage::Complete(valid_complete))
        .expect("valid complete serializes before mutation");
    malformed["checkpoint"]["source"]["source_range"] = serde_json::Value::Null;
    malformed["checkpoint"]["segment"]["source_range"] = serde_json::Value::Null;
    malformed["checkpoint"]["cursor_kind"] = serde_json::Value::Null;
    malformed["checkpoint"]["cursor"] = serde_json::Value::Null;
    malformed["checkpoint"]["projection_watermark"]["complete_source_end"] =
        serde_json::Value::Null;
    let malformed_line = serde_json::to_string(&malformed).expect("malformed JSON serializes");
    assert!(TargetMessage::parse_line(&malformed_line).is_err());

    for completeness in [
        TargetCompleteness::Unknown,
        TargetCompleteness::Partial,
        TargetCompleteness::Provisional,
    ] {
        assert!(
            target_checkpoint("request-1", "job-1", completeness)
                .validate()
                .is_ok()
        );
    }
}

#[test]
fn target_source_read_resolves_cross_date_lineage_from_target_intent_only() {
    let root = sanitized_fixture_root();
    let request = target_source_request(
        "target-source-cross-date",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let result = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("target source read resolves the sanitized lineage");

    assert_eq!(result.conversation_id, SANITIZED_SESSION_CONVERSATION_ID);
    assert_eq!(result.discovered_sources.len(), 5);
    assert_eq!(result.segments.len(), 4);
    assert_eq!(result.lineage_transitions.len(), 3);
    assert_eq!(result.lineage_coverage.chain_rollout_ids.len(), 4);
    assert_eq!(
        result.lineage_coverage.covered_source_count,
        result.segments.len() as u64
    );
    assert!(result.lineage_coverage.complete);
    assert!(result.segments.iter().all(|segment| segment.complete));
    assert!(result.records.iter().any(|record| record.is_valid_json()));
    assert_eq!(
        result.active_source.rollout_id,
        rollout_id(&sanitized_fixture_path(4))
    );
    let canonical_root = fs::canonicalize(&root).expect("fixture root canonicalizes");
    assert!(result.discovered_sources.iter().all(|source| {
        fs::canonicalize(&source.path)
            .expect("discovered source canonicalizes")
            .starts_with(&canonical_root)
    }));
    assert!(
        result
            .lineage_checkpoint
            .coverage
            .chain_rollout_ids
            .ends_with(&[result.active_source.rollout_id.clone()])
    );
}

#[test]
fn branch_history_inherits_verified_parent_prefix_without_replacing_original_turn() {
    let root = unique_temp_path("branch-history-prefix");
    let parent_id = "00000000-0000-4000-8000-000000000011";
    let child_id = "00000000-0000-4000-8000-000000000012";
    let parent_contents = current_fixture_contents("delegated-context.jsonl")
        .replace(DELEGATED_CONVERSATION, parent_id);
    let parent_path = write_target_fixture(&root, parent_id, &parent_contents);
    let parent = fs::read(&parent_path).unwrap();
    let cut = parent.len() as u64;
    let cut_ordinal = parent_contents.lines().count() as u64;
    // The original chat subsequently grows. Those bytes are not inherited.
    let mut grown = parent.clone();
    grown.extend_from_slice(format!("{{\"timestamp\":\"2026-10-03T00:01:00Z\",\"ordinal\":{cut_ordinal},\"type\":\"event_msg\",\"payload\":{{\"type\":\"agent_message\",\"message\":\"parent-after-fork\",\"phase\":\"final\"}}}}\n").as_bytes());
    fs::write(&parent_path, &grown).unwrap();
    let mut child_lines = current_fixture_contents("delegated-context.jsonl")
        .lines()
        .take(1)
        .map(|line| serde_json::from_str::<serde_json::Value>(line).unwrap())
        .collect::<Vec<_>>();
    child_lines[0]["payload"]["id"] = json!(child_id);
    child_lines[0]["payload"]["session_id"] = json!(child_id);
    child_lines[0]["payload"]["thread_source"] = json!("agent_forked_thread");
    child_lines[0]["payload"]["forked_from_id"] = json!(parent_id);
    child_lines[0]["payload"]["forked_from_ordinal_exclusive"] = json!(cut_ordinal);
    child_lines[0]["payload"]["multi_agent_version"] = json!("v1");
    child_lines[0]["payload"]["history_mode"] = json!("paginated");
    child_lines[0]["payload"]["history_base"] = json!({
        "thread_id":parent_id,"end_ordinal_exclusive":cut_ordinal,"end_byte_offset":cut
    });
    for (ordinal, payload) in [
        json!({"type":"task_started","turn_id":"branch-turn","model_context_window":258400,"collaboration_mode_kind":"default"}),
        json!({"type":"user_message","message":"child-question","images":[]}),
        json!({"type":"agent_message","message":"child-answer","phase":"final_answer"}),
        json!({"type":"task_complete","turn_id":"branch-turn","last_agent_message":"child-answer"}),
    ].into_iter().enumerate() {
        child_lines.push(json!({"timestamp":"2026-10-04T00:00:01Z","ordinal":ordinal+1,"type":"event_msg","payload":payload}));
    }
    let encode = |lines: &[serde_json::Value]| {
        lines
            .iter()
            .map(|line| format!("{line}\n"))
            .collect::<String>()
    };
    let child_path = root
        .join("2026/08/27")
        .join(format!("rollout-2026-08-27T00-00-00-{child_id}.jsonl"));
    fs::create_dir_all(child_path.parent().unwrap()).unwrap();
    fs::write(&child_path, encode(&child_lines)).unwrap();
    // An unrelated parent-chat source must not become a head or be read.
    let unrelated = parent_contents.replace(parent_id, "00000000-0000-4000-8000-000000000013");
    write_target_fixture(&root, "00000000-0000-4000-8000-000000000013", &unrelated);
    let request = target_source_request(
        "branch-history-prefix",
        child_id,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    assert_eq!(source.active_source.rollout_id, child_id);
    assert_eq!(source.discovered_sources.len(), 2);
    assert_eq!(source.segments[0].complete_range.unwrap().end, cut);
    assert_eq!(
        source.segments[0].snapshot_boundary.byte_length,
        grown.len() as u64
    );
    let mapped = map_target_source_read_with_profile(
        &request,
        &source,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical,
        "{:?}",
        mapped.batch.payload.diagnostics
    );
    assert_eq!(mapped.batch.payload.conversation_id, child_id);
    assert!(mapped.batch.payload.replacements.is_empty());
    assert!(
        !mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|m| matches!(m, TargetMutation::ReplaceLastTurn { .. }))
    );
    let encoded = serde_json::to_string(&mapped.batch.payload).unwrap();
    assert!(encoded.contains("child-question") && encoded.contains("child-answer"));
    assert!(encoded.contains("[sanitized delegation 1]"));
    assert!(!encoded.contains("parent-after-fork"));
    assert!(
        mapped.batch.payload.history_items.iter().all(|event| event
            .metadata()
            .conversation_id
            .as_deref()
            == Some(child_id))
    );
    assert!(
        mapped.batch.payload.history_items.iter().any(|event| event
            .metadata()
            .source_ref
            .source_identity
            == parent_id)
    );
    // A real process emits the same canonical branch, then completes after ACK.
    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(history_v2_hello("branch-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(TargetMessage::Analyze(request.clone()));
    let TargetMessage::Batch(batch) = process.read() else {
        panic!("branch batch");
    };
    assert_eq!(batch.payload.completeness, TargetCompleteness::Canonical);
    assert!(batch.payload.replacements.is_empty());
    process.send(TargetMessage::Ack(TargetAckMessage::new(
        request.header.request_id.clone(),
        batch.job_id,
        batch.segment_id,
        batch.batch_id,
        true,
        true,
        None::<String>,
    )));
    assert!(matches!(process.read(), TargetMessage::Complete(_)));
    process.finish();
    assert_eq!(fs::read(&parent_path).unwrap(), grown);
    if let Some(output) = std::env::var_os("TERMLINK_HISTORY_S3_EVIDENCE_DIR") {
        fs::create_dir_all(&output).unwrap();
        fs::write(
            PathBuf::from(output).join("branch-batch.json"),
            serde_json::to_vec_pretty(&mapped.batch).unwrap(),
        )
        .unwrap();
    }
    let mut next_lines = child_lines.clone();
    next_lines.push(
        json!({"timestamp":"2026-10-04T00:00:02Z","ordinal":5,"type":"event_msg",
        "payload":{"type":"agent_message","message":"child-later-answer","phase":"final_answer"}}),
    );
    fs::write(&child_path, encode(&next_lines)).unwrap();
    let mut append =
        target_source_request("branch-history-append", child_id, TargetAnalyzeMode::Append);
    append.cursor = mapped.complete.checkpoint.cursor.clone();
    append.persisted_anchor = Some(mapped.complete.checkpoint);
    let delta = read_target_source(
        &append,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    assert!(delta.lineage_records.is_some());
    let appended = map_target_source_read_with_profile(
        &append,
        &delta,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        appended.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert!(appended.batch.payload.replacements.is_empty());
    let appended_json = serde_json::to_string(&appended.batch.payload).unwrap();
    assert!(appended_json.contains("child-later-answer"));
    assert!(!appended_json.contains("parent-after-fork"));
    // Wrong ordinal, mid-line cut, missing parent and header mismatch stay closed.
    for variant in ["ordinal", "mid-line", "missing", "header"] {
        let mut broken = child_lines.clone();
        match variant {
            "ordinal" => {
                broken[0]["payload"]["history_base"]["end_ordinal_exclusive"] =
                    json!(cut_ordinal + 1)
            }
            "mid-line" => broken[0]["payload"]["history_base"]["end_byte_offset"] = json!(cut - 1),
            "missing" => {
                broken[0]["payload"]["history_base"]["thread_id"] =
                    json!("00000000-0000-4000-8000-000000000099")
            }
            "header" => {
                let mut changed = String::from_utf8(grown.clone())
                    .unwrap()
                    .lines()
                    .map(|line| serde_json::from_str::<serde_json::Value>(line).unwrap())
                    .collect::<Vec<_>>();
                changed[0]["payload"]["id"] = json!(child_id);
                fs::write(&parent_path, encode(&changed)).unwrap();
            }
            _ => unreachable!(),
        }
        fs::write(&child_path, encode(&broken)).unwrap();
        assert!(
            read_target_source(
                &request,
                &target_startup_config(&root),
                &std::sync::atomic::AtomicBool::new(false)
            )
            .is_err(),
            "{variant}"
        );
        fs::write(&parent_path, &grown).unwrap();
    }
    fs::write(&child_path, encode(&child_lines)).unwrap();
    let duplicate = root
        .join("2026/08/28")
        .join(parent_path.file_name().unwrap());
    fs::create_dir_all(duplicate.parent().unwrap()).unwrap();
    fs::write(&duplicate, &grown).unwrap();
    assert!(matches!(
        read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false)
        ),
        Err(TargetSourceReadError::Discovery(
            LineageError::AmbiguousRollout { .. }
        ))
    ));
    fs::remove_file(&duplicate).unwrap();
    let compressed = parent_path.with_extension("jsonl.zst");
    fs::write(
        &compressed,
        zstd::stream::encode_all(grown.as_slice(), 0).unwrap(),
    )
    .unwrap();
    fs::remove_file(&parent_path).unwrap();
    assert!(matches!(
        read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false)
        ),
        Err(TargetSourceReadError::Discovery(
            LineageError::UnsupportedParentSourceCompression { .. }
        ))
    ));
    fs::write(&parent_path, &grown).unwrap();
    let mut limited = request.clone();
    limited.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(4096),
        max_segment_bytes: Some(4096),
        max_line_bytes: Some(2048),
        tail_bytes: None,
        timeout_ms: None,
    });
    assert_eq!(
        read_target_source(
            &limited,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false)
        )
        .unwrap_err()
        .wire_error_code(),
        "resource_limit_exceeded"
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn branch_history_original_sanitized_header_reads_actual_cut() {
    let root = unique_temp_path("branch-history-original");
    let child_id = "00000000-0000-4000-8000-000000000002";
    let parent = current_fixture_contents("branch-history/a-full.jsonl");
    let child = current_fixture_contents("branch-history/c-header.jsonl");
    write_target_fixture(&root, DELEGATED_CONVERSATION, &parent);
    write_target_fixture(&root, child_id, &child);
    let request = target_source_request(
        "branch-history-original",
        child_id,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .unwrap();
    assert_eq!(source.segments[0].complete_range.unwrap().end, 5542);
    let mapped = map_target_source_read_with_profile(
        &request,
        &source,
        CompatibilityProfile::HistorySemanticsV2,
    )
    .unwrap();
    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert!(mapped.batch.payload.replacements.is_empty());
    assert_eq!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .filter(|event| matches!(event, AnalysisEvent::DelegatedInput { .. }))
            .count(),
        6
    );
    if let Some(output) = std::env::var_os("TERMLINK_HISTORY_S3_EVIDENCE_DIR") {
        fs::create_dir_all(&output).unwrap();
        fs::write(
            PathBuf::from(output).join("original-sanitized-branch-batch.json"),
            serde_json::to_vec_pretty(&mapped.batch).unwrap(),
        )
        .unwrap();
    }
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_source_read_prefers_plain_jsonl_sibling() {
    let root = unique_temp_path("target-source-plain-sibling");
    let plain = copy_sanitized_fixture(0, &root);
    let compressed = plain.with_file_name(format!(
        "{}.zst",
        plain
            .file_name()
            .expect("plain fixture filename")
            .to_string_lossy()
    ));
    let compressed_bytes =
        zstd::stream::encode_all(fs::read(&plain).expect("plain fixture reads").as_slice(), 0)
            .expect("plain fixture compresses");
    fs::write(&compressed, compressed_bytes).expect("compressed sibling writes");

    let request = target_source_request(
        "target-source-plain-sibling",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Preview,
    );
    let result = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("plain sibling remains the selected source");

    assert_eq!(result.discovered_sources.len(), 1);
    assert_eq!(
        result.active_source.compression,
        TargetSourceCompression::PlainJsonl
    );
    assert_eq!(result.segments[0].mode, SourceReadMode::TailPreview);
    assert!(!result.records.is_empty());
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_source_read_allows_zst_only_root_through_forward_stream() {
    let root = unique_temp_path("target-source-zst-root");
    let plain = copy_sanitized_fixture(0, &root);
    let compressed = plain.with_file_name(format!(
        "{}.zst",
        plain
            .file_name()
            .expect("plain fixture filename")
            .to_string_lossy()
    ));
    let compressed_bytes =
        zstd::stream::encode_all(fs::read(&plain).expect("plain fixture reads").as_slice(), 0)
            .expect("root fixture compresses");
    fs::remove_file(&plain).expect("plain root removes");
    fs::write(&compressed, compressed_bytes).expect("zst-only root writes");

    let request = target_source_request(
        "target-source-zst-root",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Preview,
    );
    let result = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("zst-only active root uses forward read");

    assert_eq!(result.discovered_sources.len(), 1);
    assert_eq!(
        result.active_source.compression,
        TargetSourceCompression::Zstd
    );
    assert_eq!(result.segments[0].mode, SourceReadMode::ForwardStream);
    assert!(result.segments[0].complete);
    assert!(!result.records.is_empty());
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_source_read_rejects_zst_parent_before_publishing_evidence() {
    let root = unique_temp_path("target-source-zst-parent");
    let parent = copy_sanitized_fixture(1, &root);
    let child = copy_sanitized_fixture(2, &root);
    let parent_id = rollout_id(&parent);
    let compressed = parent.with_file_name(format!(
        "{}.zst",
        parent
            .file_name()
            .expect("parent fixture filename")
            .to_string_lossy()
    ));
    let compressed_bytes = zstd::stream::encode_all(
        fs::read(&parent).expect("parent fixture reads").as_slice(),
        0,
    )
    .expect("parent fixture compresses");
    fs::remove_file(&parent).expect("plain parent removes");
    fs::write(&compressed, compressed_bytes).expect("zst parent writes");

    let request = target_source_request(
        "target-source-zst-parent",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let error = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("ordinary zst parent must fail closed");
    match error {
        TargetSourceReadError::Discovery(LineageError::UnsupportedParentSourceCompression {
            rollout_id,
            compression,
            ..
        }) => {
            assert_eq!(rollout_id, parent_id);
            assert_eq!(compression, "zstd");
        }
        other => panic!("expected typed zst parent error, got {other:?}"),
    }
    assert!(child.exists());
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_source_read_rejects_missing_parent_cycle_and_multi_head() {
    let missing_root = unique_temp_path("target-source-missing-parent");
    let missing_child = copy_sanitized_fixture(2, &missing_root);
    let missing_request = target_source_request(
        "target-source-missing-parent",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let missing_error = read_target_source(
        &missing_request,
        &target_startup_config(&missing_root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("missing parent must fail closed");
    assert!(matches!(
        missing_error,
        TargetSourceReadError::Discovery(LineageError::ParentRolloutMissing { .. })
    ));
    assert!(missing_child.exists());
    let _ = fs::remove_dir_all(missing_root);

    let cycle_root = unique_temp_path("target-source-cycle");
    let cycle_a = copy_sanitized_fixture(0, &cycle_root);
    let cycle_b = copy_sanitized_fixture(2, &cycle_root);
    let cycle_a_id = rollout_id(&cycle_a);
    let cycle_b_id = rollout_id(&cycle_b);
    let cycle_cut = fs::read(&cycle_a).expect("cycle parent reads").len() as u64;
    rewrite_history_base(&cycle_a, &cycle_b_id, cycle_cut);
    rewrite_history_base(&cycle_b, &cycle_a_id, cycle_cut);
    let cycle_request = target_source_request(
        "target-source-cycle",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let cycle_error = read_target_source(
        &cycle_request,
        &target_startup_config(&cycle_root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("lineage cycle must fail closed");
    assert!(matches!(
        cycle_error,
        TargetSourceReadError::Discovery(LineageError::ParentChainCycle { .. })
            | TargetSourceReadError::Discovery(LineageError::AmbiguousActiveHead { .. })
    ));
    let _ = fs::remove_dir_all(cycle_root);

    let multi_head_root = unique_temp_path("target-source-multi-head");
    let multi_root = copy_sanitized_fixture(0, &multi_head_root);
    let multi_a = copy_sanitized_fixture(2, &multi_head_root);
    let multi_b = copy_sanitized_fixture(3, &multi_head_root);
    let multi_root_id = rollout_id(&multi_root);
    let multi_cut = fs::read(&multi_root)
        .expect("multi-head parent reads")
        .len() as u64;
    rewrite_history_base(&multi_a, &multi_root_id, multi_cut);
    rewrite_history_base(&multi_b, &multi_root_id, multi_cut);
    let multi_request = target_source_request(
        "target-source-multi-head",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let multi_error = read_target_source(
        &multi_request,
        &target_startup_config(&multi_head_root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("multiple active heads must fail closed");
    assert!(matches!(
        multi_error,
        TargetSourceReadError::Discovery(LineageError::AmbiguousActiveHead { .. })
    ));
    let _ = fs::remove_dir_all(multi_head_root);
}

#[test]
fn target_source_read_honors_cancellation_and_deadline_before_discovery() {
    let root = sanitized_fixture_root();
    let request = target_source_request(
        "target-source-cancelled",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let cancelled = std::sync::atomic::AtomicBool::new(true);
    assert_eq!(
        read_target_source(&request, &target_startup_config(&root), &cancelled,)
            .expect_err("cancelled source read must stop before discovery"),
        TargetSourceReadError::Cancelled
    );

    let deadline_error = read_target_source_with_deadline(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
        Instant::now() - Duration::from_millis(1),
    )
    .expect_err("expired source read deadline must stop before discovery");
    assert_eq!(deadline_error, TargetSourceReadError::Timeout);
}

#[test]
fn target_process_maps_source_segment_limit_and_clears_active_request() {
    let root = sanitized_fixture_root();
    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(target_node_hello("target-source-segment-limit-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));

    let mut request = target_source_request(
        "target-source-segment-limit-request",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Preview,
    );
    request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(4096),
        max_line_bytes: Some(1),
        max_segment_bytes: Some(1),
        tail_bytes: Some(2),
        timeout_ms: None,
    });
    process.send(TargetMessage::Analyze(request));
    let error = target_error(process.read(), "resource_limit_exceeded");
    assert!(!error.retryable);

    // A source error must settle the runtime's active slot. If the first
    // failure left it occupied, this second request would return `busy`.
    let mut second_request = target_source_request(
        "target-source-segment-limit-request-2",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Preview,
    );
    second_request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(4096),
        max_line_bytes: Some(1),
        max_segment_bytes: Some(1),
        tail_bytes: Some(2),
        timeout_ms: None,
    });
    process.send(TargetMessage::Analyze(second_request));
    let second_error = target_error(process.read(), "resource_limit_exceeded");
    assert!(!second_error.retryable);
    process.finish();
}

#[test]
fn target_source_enforces_decoded_budget_across_lineage_segments() {
    let root = sanitized_fixture_root();
    let mut request = target_source_request(
        "target-source-aggregate-budget",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    request.resource_limits = Some(TargetResourceLimits {
        max_decoded_bytes: Some(2500),
        max_line_bytes: None,
        max_segment_bytes: None,
        tail_bytes: None,
        timeout_ms: None,
    });

    let error = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("aggregate decoded budget must stop a later lineage segment");
    assert!(matches!(
        &error,
        TargetSourceReadError::ResourceLimit(message)
            if message.contains("decoded source budget exceeded for")
                && !message.contains("aggregate decoded bytes")
    ));
    assert_eq!(error.wire_error_code(), "resource_limit_exceeded");
    assert!(!error.is_retryable());

    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(target_node_hello("target-source-aggregate-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(TargetMessage::Analyze(request));
    let wire_error = target_error(process.read(), "resource_limit_exceeded");
    assert!(!wire_error.retryable);
    process.finish();
}

#[test]
fn target_process_runs_source_locating_and_fails_closed_on_missing_parent() {
    let root = unique_temp_path("target-process-missing-parent");
    let child = copy_sanitized_fixture(2, &root);
    assert!(child.exists());

    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(target_node_hello("target-source-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(TargetMessage::Analyze(TargetAnalyzeRequest::new(
        "target-source-missing-parent-request",
        "target-source-missing-parent-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    )));
    let error = target_error(process.read(), "analysis_failed");
    assert!(!error.retryable);
    assert!(error.message.contains("parent rollout"));
    process.finish();

    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_process_resolves_cross_date_source_before_cancel() {
    let root = sanitized_fixture_root();
    let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
    process.send(target_node_hello("target-source-cross-date-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));
    process.send(TargetMessage::Analyze(TargetAnalyzeRequest::new(
        "target-source-cross-date-request",
        "target-source-cross-date-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    )));
    // With the target mapper connected, this small fixture can finish before
    // cancellation arrives. A delivered batch must still wait for ACK and
    // must not implicitly complete.
    let first = process.read();
    assert!(matches!(first, TargetMessage::Batch(_)));
    process.send(TargetMessage::Cancel(TargetCancelMessage::new(
        "target-source-cross-date-request",
        "stop after source read",
    )));
    assert_eq!(target_error(process.read(), "cancelled").fatal, false);
    process.finish();
}

#[test]
fn target_mapping_projects_real_source_and_resumes_from_checkpoint() {
    let root = target_protocol_fixture_root();
    let request = TargetAnalyzeRequest::new(
        "target-mapping-request",
        "target-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("target source read succeeds");
    let mapped = map_target_source_read(&request, &source).expect("target mapping succeeds");

    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert!(mapped.batch.payload.complete);
    assert!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::TurnStarted { .. }))
    );
    assert!(
        mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
    );
    assert_eq!(
        mapped.complete.checkpoint.projection_watermark.batch_id,
        mapped.batch.batch_id
    );
    assert_eq!(
        mapped.complete.checkpoint.cursor,
        mapped.batch.payload.next_cursor
    );

    let retry = TargetAnalyzeRequest::new(
        "target-mapping-retry",
        "target-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let retry_source = read_target_source(
        &retry,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("checkpoint retry source read succeeds");
    let retry_mapped =
        map_target_source_read(&retry, &retry_source).expect("checkpoint retry maps");

    assert_eq!(
        retry_mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(retry_mapped.batch.segment_id, mapped.batch.segment_id);
    assert_eq!(retry_mapped.batch.batch_id, mapped.batch.batch_id);
    assert_eq!(
        retry_mapped.batch.payload.history_items,
        mapped.batch.payload.history_items
    );

    let mut incompatible_backfill = TargetAnalyzeRequest::new(
        "target-mapping-incompatible",
        "target-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    incompatible_backfill.cursor = mapped.batch.payload.next_cursor.clone();
    incompatible_backfill.persisted_anchor = Some(mapped.complete.checkpoint.clone());
    let incompatible_error = read_target_source(
        &incompatible_backfill,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect_err("backfill must reject incompatible forward_append cursor");
    assert!(matches!(
        incompatible_error,
        TargetSourceReadError::InvalidRequest(_)
    ));

    let mut append = TargetAnalyzeRequest::new(
        "target-mapping-append",
        "target-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    append.cursor = mapped.batch.payload.next_cursor.clone();
    append.persisted_anchor = Some(mapped.complete.checkpoint.clone());
    let append_source = read_target_source(
        &append,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("append consuming promoted cursor succeeds");
    let append_mapped =
        map_target_source_read(&append, &append_source).expect("append mapping succeeds");
    assert_eq!(
        append_mapped
            .batch
            .payload
            .next_cursor
            .as_ref()
            .map(|c| c.cursor_kind),
        Some(TargetCursorKind::ForwardAppend)
    );
}

#[test]
fn target_mapping_validates_active_head_replacement_and_preserves_source_order() {
    let root = unique_temp_path("target-lineage-mapping");
    let parent_path = copy_sanitized_fixture(0, &root);
    let child_path = copy_sanitized_fixture(1, &root);
    let parent_id = rollout_id(&parent_path);
    let parent_header_end = fs::read(&parent_path)
        .expect("parent fixture reads")
        .split_inclusive(|byte| *byte == b'\n')
        .next()
        .expect("parent fixture has a header")
        .len() as u64;
    rewrite_history_base(&child_path, &parent_id, parent_header_end);
    let request = TargetAnalyzeRequest::new(
        "target-lineage-mapping-request",
        "target-lineage-mapping-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("sanitized lineage source read succeeds");
    let mapped = map_target_source_read(&request, &source).expect("lineage mapping succeeds");

    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(mapped.batch.payload.lineage_transitions.len(), 1);
    assert!(
        mapped
            .batch
            .payload
            .lineage_transitions
            .iter()
            .all(|transition| {
                transition.validation_state == TargetLineageValidationState::Validated
            })
    );
    assert_eq!(mapped.batch.payload.replacements.len(), 1);
    assert!(
        mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(
                mutation,
                TargetMutation::ReplaceLastTurn { replacement }
                    if replacement.child_rollout_id == source.source_id
            ))
    );

    let rank = |source_id: &str| {
        source
            .segments
            .iter()
            .position(|segment| segment.source_id == source_id)
            .expect("mapped event source belongs to a planned segment")
    };
    let mut previous_rank = 0;
    for event in &mapped.batch.payload.history_items {
        let current_rank = rank(&event.metadata().source_ref.source_identity);
        assert!(
            current_rank >= previous_rank,
            "lineage events must be source ordered"
        );
        previous_rank = current_rank;
    }
    assert!(
        mapped
            .complete
            .checkpoint
            .projection_watermark
            .logical_item_count
            > 0
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_preserves_every_validated_lineage_replacement_in_root_order() {
    let root = unique_temp_path("target-lineage-all-replacements");
    for index in 0..5 {
        copy_sanitized_fixture(index, &root);
    }
    let active_path = sanitized_fixture_files_path(&root, 4);
    let active_contents = fs::read_to_string(&active_path).expect("active fixture reads");
    let active_without_developer_event = active_contents
        .lines()
        .take(4)
        .collect::<Vec<_>>()
        .join("\n")
        + "\n";
    fs::write(&active_path, active_without_developer_event).expect("active fixture rewrites");

    let request = TargetAnalyzeRequest::new(
        "target-lineage-all-replacements-request",
        "target-lineage-all-replacements-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("three-edge lineage source read succeeds");
    assert_eq!(source.lineage_transitions.len(), 3);
    let mapped =
        map_target_source_read(&request, &source).expect("three-edge lineage mapping succeeds");

    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(
        mapped.batch.payload.lineage_transitions.len(),
        source.lineage_transitions.len()
    );
    assert!(
        mapped
            .batch
            .payload
            .lineage_transitions
            .iter()
            .all(|transition| {
                transition.validation_state == TargetLineageValidationState::Validated
            })
    );
    let expected_children = source
        .lineage_transitions
        .iter()
        .map(|transition| transition.child_rollout_id.clone())
        .collect::<Vec<_>>();
    let replacement_children = mapped
        .batch
        .payload
        .replacements
        .iter()
        .map(|replacement| replacement.child_rollout_id.clone())
        .collect::<Vec<_>>();
    assert_eq!(replacement_children, expected_children);
    let mutation_children = mapped
        .batch
        .payload
        .mutations
        .iter()
        .filter_map(|mutation| match mutation {
            TargetMutation::ReplaceLastTurn { replacement } => {
                Some(replacement.child_rollout_id.clone())
            }
            _ => None,
        })
        .collect::<Vec<_>>();
    assert_eq!(mutation_children, expected_children);

    let mut invalid_middle_source = source.clone();
    invalid_middle_source.lineage_transitions[1]
        .history_base
        .end_ordinal_exclusive = 99;
    let invalid_middle = map_target_source_read(&request, &invalid_middle_source)
        .expect("invalid middle lineage edge stays partial");
    assert_eq!(
        invalid_middle.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(invalid_middle.batch.payload.replacements.is_empty());
    assert!(
        !invalid_middle
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::ReplaceLastTurn { .. }))
    );

    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_rejects_invalid_replacement_without_publishing_mutation() {
    let root = sanitized_fixture_root();
    let request = TargetAnalyzeRequest::new(
        "target-invalid-replacement-request",
        "target-invalid-replacement-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let mut source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("sanitized lineage source read succeeds");
    source.lineage_transitions[0]
        .history_base
        .end_ordinal_exclusive = 99;
    let mapped = map_target_source_read(&request, &source).expect("invalid lineage stays partial");

    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(!mapped.batch.payload.complete);
    assert!(
        mapped
            .batch
            .payload
            .diagnostics
            .iter()
            .any(|diagnostic| diagnostic.code == "replacement_validation")
    );
    assert!(
        !mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::ReplaceLastTurn { .. }))
    );
    assert!(
        mapped
            .batch
            .payload
            .lineage_transitions
            .iter()
            .any(|transition| transition.validation_state
                == TargetLineageValidationState::ValidationUnavailable)
    );
}

#[test]
fn target_mapping_deduplicates_overlap_and_rejects_incompatible_checkpoint_state() {
    let root = target_protocol_fixture_root();
    let request = TargetAnalyzeRequest::new(
        "target-overlap-mapping-request",
        "target-overlap-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("target source read succeeds");
    let mapped = map_target_source_read(&request, &source).expect("target mapping succeeds");

    let mut overlapped_source = source.clone();
    overlapped_source
        .records
        .push(overlapped_source.records[0].clone());
    let overlapped =
        map_target_source_read(&request, &overlapped_source).expect("overlap is idempotent");
    assert_eq!(
        overlapped.batch.payload.history_items,
        mapped.batch.payload.history_items
    );
    assert_eq!(overlapped.batch.batch_id, mapped.batch.batch_id);

    let mut incompatible = TargetAnalyzeRequest::new(
        "target-incompatible-checkpoint-request",
        "target-overlap-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    incompatible.cursor = mapped.batch.payload.next_cursor.clone();
    let mut checkpoint = mapped.complete.checkpoint.clone();
    checkpoint.reducer_state.reducer_version = "old-target-version".to_string();
    incompatible.persisted_anchor = Some(checkpoint);
    let error = map_target_source_read(&incompatible, &source)
        .expect_err("incompatible reducer checkpoint must fail closed");
    assert!(
        error.to_string().contains("reducer version"),
        "unexpected incompatible checkpoint error: {error}"
    );
}

#[test]
fn target_mapping_projects_rich_adapter_fields_and_unknown_diagnostics() {
    let root = unique_temp_path("target-rich-mapping");
    let contents = current_fixture_contents("minimal-rollout.jsonl");
    write_target_fixture(&root, TARGET_MAPPING_CONVERSATION_ID, &contents);
    let request = TargetAnalyzeRequest::new(
        "target-rich-mapping-request",
        "target-rich-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("rich target source read succeeds");
    let mapped = map_target_source_read(&request, &source).expect("rich target mapping succeeds");

    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(!mapped.batch.payload.complete);
    assert!(!mapped.batch.payload.tool_details.is_empty());
    assert!(mapped.batch.payload.usage.is_some());
    assert!(!mapped.batch.payload.task_outcomes.is_empty());
    assert!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(
                event,
                AnalysisEvent::ToolStarted { .. } | AnalysisEvent::ToolCompleted { .. }
            ))
    );
    assert!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(
                event,
                AnalysisEvent::PlanQuestion { .. } | AnalysisEvent::PlanUpdated { .. }
            ))
    );
    assert!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(
                event,
                AnalysisEvent::TurnStarted { .. }
                    | AnalysisEvent::TurnCompleted { .. }
                    | AnalysisEvent::UsageUpdated { .. }
            ))
    );
    assert!(
        mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::UnknownEvent { .. }))
    );
    assert!(
        mapped
            .batch
            .payload
            .diagnostics
            .iter()
            .any(|diagnostic| diagnostic.code == "unknown_event")
    );
    assert!(
        mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::MarkPartial { .. }))
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_keeps_aliases_and_abort_compaction_parse_gaps_noncanonical() {
    let alias_root = unique_temp_path("target-alias-mapping");
    let header = current_fixture_contents("minimal-rollout.jsonl")
        .lines()
        .next()
        .expect("minimal fixture has a session header")
        .to_string();
    let alias_lines = current_fixture_contents("alias-fields.jsonl");
    let alias_contents = format!("{header}\n{alias_lines}");
    write_target_fixture(&alias_root, TARGET_MAPPING_CONVERSATION_ID, &alias_contents);
    let alias_request = TargetAnalyzeRequest::new(
        "target-alias-mapping-request",
        "target-alias-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let alias_source = read_target_source(
        &alias_request,
        &target_startup_config(&alias_root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("alias source read succeeds");
    let alias_mapped =
        map_target_source_read(&alias_request, &alias_source).expect("alias mapping succeeds");
    assert!(
        alias_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::TurnStarted { .. }))
    );
    assert!(
        alias_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::TurnCompleted { .. }))
    );
    assert!(
        !alias_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::UnknownEvent { .. }))
    );
    let _ = fs::remove_dir_all(alias_root);

    let partial_root = unique_temp_path("target-partial-mapping");
    let partial_lines = current_fixture_contents("partial/abort-compaction.jsonl");
    let partial_contents = format!("{header}\n{{\"timestamp\":\n{partial_lines}");
    write_target_fixture(
        &partial_root,
        TARGET_MAPPING_CONVERSATION_ID,
        &partial_contents,
    );
    let partial_request = TargetAnalyzeRequest::new(
        "target-partial-mapping-request",
        "target-partial-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let partial_source = read_target_source(
        &partial_request,
        &target_startup_config(&partial_root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("partial source read preserves diagnostics");
    let partial_mapped = map_target_source_read(&partial_request, &partial_source)
        .expect("partial mapping preserves diagnostics");
    assert_eq!(
        partial_mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(
        partial_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::ParseGap { .. }))
    );
    assert!(
        partial_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(event, AnalysisEvent::Compaction { .. }))
    );
    assert!(
        partial_mapped
            .batch
            .payload
            .history_items
            .iter()
            .any(|event| matches!(
                event,
                AnalysisEvent::TurnCompleted {
                    status: TurnStatus::Interrupted,
                    ..
                }
            ))
    );
    assert!(
        partial_mapped
            .batch
            .payload
            .diagnostics
            .iter()
            .any(|diagnostic| diagnostic.code == "parse_gap")
    );
    let _ = fs::remove_dir_all(partial_root);
}

#[test]
fn target_mapping_promotes_append_and_keeps_partial_snapshot_boundaries_noncanonical() {
    let root = unique_temp_path("target-append-mapping");
    let fixture_path = target_protocol_fixture_root()
        .join("2026")
        .join("08")
        .join("26")
        .join(format!(
            "rollout-2026-08-26T00-00-00-{TARGET_MAPPING_CONVERSATION_ID}.jsonl"
        ));
    let contents = fs::read_to_string(fixture_path).expect("append fixture reads");
    assert!(contents.contains("\"ordinal\":0"));
    write_target_fixture(&root, TARGET_MAPPING_CONVERSATION_ID, &contents);
    let append_request = TargetAnalyzeRequest::new(
        "target-append-mapping-request",
        "target-append-mapping-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    let append_source = read_target_source(
        &append_request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("append source read succeeds");
    let append_mapped =
        map_target_source_read(&append_request, &append_source).expect("append maps");
    assert_eq!(
        append_mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert!(matches!(
        append_mapped
            .batch
            .payload
            .next_cursor
            .as_ref()
            .map(|cursor| cursor.cursor_kind),
        Some(TargetCursorKind::ForwardAppend)
    ));
    let first_cursor = append_mapped
        .batch
        .payload
        .next_cursor
        .clone()
        .expect("initial append promotion produces a target cursor");
    assert_eq!(first_cursor.last_rollout_ordinal, Some(1));
    assert!(append_mapped.complete.checkpoint.reducer_state.payload["source_cursor"].is_object());

    let path = target_fixture_path(&root, TARGET_MAPPING_CONVERSATION_ID);
    let mut file = fs::OpenOptions::new()
        .append(true)
        .open(&path)
        .expect("append fixture reopens");
    file.write_all(
        br#"{"timestamp":"2026-08-26T00:00:02","ordinal":2,"type":"event_msg","payload":{"type":"task_complete","turn_id":"target-turn-1","last_agent_message":"done","duration_ms":1}}
"#,
    )
    .expect("append fixture grows");
    file.sync_all().expect("append fixture syncs");

    let mut continuation_request = TargetAnalyzeRequest::new(
        "target-append-continuation-request",
        "target-append-continuation-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    continuation_request.cursor = Some(first_cursor.clone());
    continuation_request.persisted_anchor = Some(append_mapped.complete.checkpoint.clone());
    let continuation_source = read_target_source(
        &continuation_request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("append continuation source read succeeds");
    assert_eq!(continuation_source.segments.len(), 1);
    assert_eq!(
        continuation_source.segments[0].mode,
        SourceReadMode::ForwardRange
    );
    assert!(continuation_source.append_cursor.is_some());
    let continuation_mapped = map_target_source_read(&continuation_request, &continuation_source)
        .expect("append continuation maps");
    assert_eq!(
        continuation_mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    let continuation_cursor = continuation_mapped
        .batch
        .payload
        .next_cursor
        .as_ref()
        .expect("append continuation keeps a forward cursor");
    assert_eq!(
        continuation_cursor.cursor_kind,
        TargetCursorKind::ForwardAppend
    );
    assert!(continuation_cursor.complete_range.end > first_cursor.complete_range.end);
    assert_eq!(continuation_cursor.last_rollout_ordinal, Some(2));
    assert_eq!(
        continuation_mapped.complete.checkpoint.cursor,
        continuation_mapped.batch.payload.next_cursor
    );
    assert!(
        continuation_mapped
            .complete
            .checkpoint
            .reducer_state
            .payload["source_cursor"]
            .is_object()
    );

    let mut no_growth_request = TargetAnalyzeRequest::new(
        "target-append-no-growth-request",
        "target-append-no-growth-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    no_growth_request.cursor = Some(continuation_cursor.clone());
    no_growth_request.persisted_anchor = Some(continuation_mapped.complete.checkpoint.clone());
    let no_growth_source = read_target_source(
        &no_growth_request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("no-growth append source read succeeds");
    assert!(no_growth_source.records.is_empty());
    assert!(no_growth_source.append_cursor.is_some());
    let no_growth_mapped = map_target_source_read(&no_growth_request, &no_growth_source)
        .expect("no-growth append mapping succeeds");
    assert_eq!(
        no_growth_mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    let no_growth_cursor = no_growth_mapped
        .batch
        .payload
        .next_cursor
        .as_ref()
        .expect("no-growth append preserves the formal cursor");
    assert_eq!(no_growth_cursor, continuation_cursor);
    assert_eq!(
        no_growth_mapped.complete.checkpoint.cursor,
        no_growth_mapped.batch.payload.next_cursor
    );

    let mutated_contents = contents.replacen("\"ordinal\":0", "\"ordinal\":9", 1);
    fs::write(&path, format!("{mutated_contents}\n")).expect("mutated append fixture writes");
    let mutated_source = read_target_source(
        &continuation_request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("source mutation is reported as a bounded append result");
    assert!(mutated_source.append_cursor.is_none());
    assert!(mutated_source.segments[0].parse_gap_count > 0);
    let mutated_mapped = map_target_source_read(&continuation_request, &mutated_source)
        .expect("source mutation maps as partial diagnostics");
    assert_eq!(
        mutated_mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(mutated_mapped.batch.payload.next_cursor.is_none());
    assert!(
        mutated_mapped
            .batch
            .payload
            .diagnostics
            .iter()
            .any(|diagnostic| diagnostic.code == "parse_gap")
    );

    let mut partial_source = append_source.clone();
    partial_source.segments[0].complete = false;
    partial_source.segments[0].pending_tail_bytes = 3;
    let partial_request = TargetAnalyzeRequest::new(
        "target-partial-boundary-request",
        "target-partial-boundary-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let partial_mapped = map_target_source_read(&partial_request, &partial_source)
        .expect("partial snapshot maps without canonical promotion");
    assert_eq!(
        partial_mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(
        partial_mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::MarkPartial { .. }))
    );
    assert!(
        !partial_mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
    );
    assert!(
        partial_mapped.batch.payload.next_cursor.is_some(),
        "an unfinished tail may expose the safe prefix cursor"
    );

    let mut gapped_source = append_source.clone();
    gapped_source.segments[0].parse_gap_count = 1;
    let gapped_mapped = map_target_source_read(&partial_request, &gapped_source)
        .expect("parse gap stays a partial mapping");
    assert_eq!(
        gapped_mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(gapped_mapped.batch.payload.next_cursor.is_none());
    assert!(gapped_mapped.batch.payload.source_range.is_none());
    assert!(
        !gapped_mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
    );

    let mut shrunk_source = append_source.clone();
    shrunk_source.segments[0].complete = false;
    shrunk_source.segments[0].source_shrank_during_read = true;
    let shrunk_mapped = map_target_source_read(&partial_request, &shrunk_source)
        .expect("source shrink stays a partial mapping");
    assert_eq!(
        shrunk_mapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(shrunk_mapped.batch.payload.next_cursor.is_none());
    assert!(shrunk_mapped.batch.payload.source_range.is_none());
    assert!(
        !shrunk_mapped
            .batch
            .payload
            .mutations
            .iter()
            .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_covers_mode_specific_gap_shrink_and_unfinished_tail_boundaries() {
    let root = unique_temp_path("target-mapping-boundary-matrix");
    let fixture_path = target_protocol_fixture_root()
        .join("2026")
        .join("08")
        .join("26")
        .join(format!(
            "rollout-2026-08-26T00-00-00-{TARGET_MAPPING_CONVERSATION_ID}.jsonl"
        ));
    let complete_contents = fs::read_to_string(fixture_path).expect("boundary fixture reads");
    let path = write_target_fixture(&root, TARGET_MAPPING_CONVERSATION_ID, &complete_contents);
    let complete_modes = [
        (
            "preview",
            TargetAnalyzeMode::Preview,
            TargetCursorKind::TailPreview,
        ),
        (
            "backfill",
            TargetAnalyzeMode::Backfill,
            TargetCursorKind::ForwardAppend,
        ),
    ];

    for (label, mode, expected_cursor_kind) in complete_modes {
        let request = TargetAnalyzeRequest::new(
            format!("target-boundary-complete-{label}"),
            format!("target-boundary-complete-job-{label}"),
            TARGET_MAPPING_CONVERSATION_ID,
            mode,
        );
        let source = read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false),
        )
        .expect("complete boundary source read succeeds");
        let mapped =
            map_target_source_read(&request, &source).expect("complete boundary mapping succeeds");
        assert_eq!(
            mapped
                .batch
                .payload
                .next_cursor
                .as_ref()
                .map(|cursor| cursor.cursor_kind),
            Some(expected_cursor_kind)
        );
        assert_eq!(
            mapped.complete.checkpoint.cursor,
            mapped.batch.payload.next_cursor
        );
        assert!(
            matches!(mode, TargetAnalyzeMode::Preview)
                && mapped.batch.payload.completeness == TargetCompleteness::Provisional
                || matches!(mode, TargetAnalyzeMode::Backfill)
                    && mapped.batch.payload.completeness == TargetCompleteness::Canonical
        );
    }

    let separator = if complete_contents.ends_with('\n') {
        ""
    } else {
        "\n"
    };
    let unfinished_contents = format!(
        "{complete_contents}{separator}{{\"timestamp\":\"2026-08-26T00:00:02\",\"ordinal\":2,\"type\":\"event_msg\",\"payload\":{{\"type\":\"task_complete\""
    );
    fs::write(&path, unfinished_contents).expect("unfinished tail fixture writes");
    let unfinished_modes = [
        (
            "preview",
            TargetAnalyzeMode::Preview,
            TargetCursorKind::TailPreview,
        ),
        (
            "backfill",
            TargetAnalyzeMode::Backfill,
            TargetCursorKind::Backfill,
        ),
    ];
    for (label, mode, expected_cursor_kind) in unfinished_modes {
        let request = TargetAnalyzeRequest::new(
            format!("target-boundary-tail-{label}"),
            format!("target-boundary-tail-job-{label}"),
            TARGET_MAPPING_CONVERSATION_ID,
            mode,
        );
        let source = read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false),
        )
        .expect("unfinished tail source read succeeds");
        let active_segment = source
            .segments
            .iter()
            .rev()
            .find(|segment| segment.source_id == source.source_id)
            .expect("unfinished tail active segment exists");
        assert!(active_segment.pending_tail_bytes > 0);
        assert!(!active_segment.complete);
        let mapped =
            map_target_source_read(&request, &source).expect("unfinished tail mapping succeeds");
        assert_eq!(
            mapped.batch.payload.completeness,
            TargetCompleteness::Partial
        );
        let cursor = mapped
            .batch
            .payload
            .next_cursor
            .as_ref()
            .expect("unfinished tail keeps the safe prefix cursor");
        assert_eq!(cursor.cursor_kind, expected_cursor_kind);
        assert!(cursor.complete_range.end < active_segment.snapshot_boundary.byte_length);
        assert!(
            mapped
                .batch
                .payload
                .mutations
                .iter()
                .any(|mutation| matches!(mutation, TargetMutation::MarkPartial { .. }))
        );
        assert!(
            !mapped
                .batch
                .payload
                .mutations
                .iter()
                .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
        );
        assert_eq!(
            mapped.complete.status,
            TargetCompleteStatus::Partial,
            "unfinished {label} must not settle as completed"
        );
    }

    let malformed_contents = format!(
        "{complete_contents}{separator}{{not-json}}\n{{\"timestamp\":\"2026-08-26T00:00:03\",\"ordinal\":2,\"type\":\"event_msg\",\"payload\":{{\"type\":\"task_complete\"}}}}\n"
    );
    fs::write(&path, malformed_contents).expect("malformed boundary fixture writes");
    for (label, mode, _) in complete_modes {
        let request = TargetAnalyzeRequest::new(
            format!("target-boundary-gap-{label}"),
            format!("target-boundary-gap-job-{label}"),
            TARGET_MAPPING_CONVERSATION_ID,
            mode,
        );
        let source = read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false),
        )
        .expect("malformed boundary source read succeeds");
        let active_segment = source
            .segments
            .iter()
            .rev()
            .find(|segment| segment.source_id == source.source_id)
            .expect("malformed boundary active segment exists");
        assert!(active_segment.parse_gap_count > 0);
        let mapped =
            map_target_source_read(&request, &source).expect("malformed boundary mapping succeeds");
        assert_eq!(
            mapped.batch.payload.completeness,
            TargetCompleteness::Partial
        );
        assert!(mapped.batch.payload.next_cursor.is_none());
        assert!(mapped.batch.payload.source_range.is_none());
        assert!(
            !mapped
                .batch
                .payload
                .mutations
                .iter()
                .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
        );
        assert_eq!(mapped.complete.status, TargetCompleteStatus::Partial);
    }

    fs::write(&path, complete_contents).expect("complete boundary fixture restores");
    for (label, mode, _) in complete_modes {
        let request = TargetAnalyzeRequest::new(
            format!("target-boundary-shrink-{label}"),
            format!("target-boundary-shrink-job-{label}"),
            TARGET_MAPPING_CONVERSATION_ID,
            mode,
        );
        let source = read_target_source(
            &request,
            &target_startup_config(&root),
            &std::sync::atomic::AtomicBool::new(false),
        )
        .expect("shrink boundary source read succeeds");
        let mut shrunk_source = source.clone();
        let active_index = shrunk_source
            .segments
            .iter()
            .rposition(|segment| segment.source_id == shrunk_source.source_id)
            .expect("shrink boundary active segment index exists");
        shrunk_source.segments[active_index].complete = false;
        shrunk_source.segments[active_index].source_shrank_during_read = true;
        let mapped = map_target_source_read(&request, &shrunk_source)
            .expect("shrink boundary mapping succeeds");
        assert_eq!(
            mapped.batch.payload.completeness,
            TargetCompleteness::Partial
        );
        assert!(mapped.batch.payload.next_cursor.is_none());
        assert!(mapped.batch.payload.source_range.is_none());
        assert!(
            !mapped
                .batch
                .payload
                .mutations
                .iter()
                .any(|mutation| matches!(mutation, TargetMutation::CompleteRange { .. }))
        );
        assert_eq!(
            mapped.complete.status,
            TargetCompleteStatus::Partial,
            "shrunken {label} must remain non-canonical"
        );
    }

    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_same_source_append_revalidates_complete_lineage_and_keeps_delta_cursor() {
    let root = unique_temp_path("target-lineage-append-continuation");
    for index in 0..4 {
        copy_sanitized_fixture(index, &root);
    }
    let request = TargetAnalyzeRequest::new(
        "target-lineage-append-initial-request",
        "target-lineage-append-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("initial lineage append source read succeeds");
    let mapped =
        map_target_source_read(&request, &source).expect("initial lineage append mapping succeeds");
    assert_eq!(
        mapped.batch.payload.completeness,
        TargetCompleteness::Canonical
    );
    assert_eq!(mapped.batch.payload.lineage_transitions.len(), 2);
    assert_eq!(mapped.batch.payload.replacements.len(), 2);
    let first_cursor = mapped
        .batch
        .payload
        .next_cursor
        .clone()
        .expect("initial lineage append produces a cursor");

    let active_path = sanitized_fixture_files_path(&root, 3);
    let mut file = fs::OpenOptions::new()
        .append(true)
        .open(&active_path)
        .expect("lineage append fixture reopens");
    file.write_all(
        br#"{"timestamp":"2026-08-22T00:04:01","ordinal":4,"type":"event_msg","payload":{"type":"task_complete","turn_id":"1b4c5d60-7e8f-4091-a2b3-4d5e6f7a8b92","last_agent_message":"synthetic continuation","duration_ms":1}}
"#,
    )
    .expect("lineage append fixture grows");
    file.sync_all().expect("lineage append fixture syncs");

    let mut continuation_request = TargetAnalyzeRequest::new(
        "target-lineage-append-continuation-request",
        "target-lineage-append-job",
        SANITIZED_SESSION_CONVERSATION_ID,
        TargetAnalyzeMode::Append,
    );
    continuation_request.cursor = Some(first_cursor.clone());
    continuation_request.persisted_anchor = Some(mapped.complete.checkpoint.clone());
    let continuation_source = read_target_source(
        &continuation_request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("same-source lineage append source read succeeds");
    assert_eq!(continuation_source.segments.len(), 1);
    assert!(continuation_source.lineage_segments.is_some());
    assert!(continuation_source.lineage_records.is_some());
    assert!(continuation_source.lineage_coverage.complete);
    assert!(continuation_source.append_cursor.is_some());

    let continuation = map_target_source_read(&continuation_request, &continuation_source)
        .expect("same-source lineage append mapping succeeds");
    assert_eq!(
        continuation.batch.payload.completeness,
        TargetCompleteness::Canonical,
        "continuation diagnostics: {:?}",
        continuation.batch.payload.diagnostics
    );
    assert_eq!(continuation.batch.payload.lineage_transitions.len(), 2);
    assert!(
        continuation
            .batch
            .payload
            .lineage_transitions
            .iter()
            .all(|transition| {
                transition.validation_state == TargetLineageValidationState::Validated
            })
    );
    assert_eq!(continuation.batch.payload.replacements.len(), 2);
    let continuation_cursor = continuation
        .batch
        .payload
        .next_cursor
        .as_ref()
        .expect("same-source lineage append advances its cursor");
    assert_eq!(
        continuation_cursor.cursor_kind,
        TargetCursorKind::ForwardAppend
    );
    assert!(continuation_cursor.complete_range.end > first_cursor.complete_range.end);
    assert_eq!(
        continuation.complete.checkpoint.lineage_checkpoint,
        continuation.batch.payload.lineage_checkpoint
    );

    let mut gapped_lineage = continuation_source.clone();
    gapped_lineage
        .lineage_segments
        .as_mut()
        .expect("lineage recovery evidence exists")[0]
        .parse_gap_count = 1;
    let gapped = map_target_source_read(&continuation_request, &gapped_lineage)
        .expect("lineage recovery gap stays partial");
    assert_eq!(
        gapped.batch.payload.completeness,
        TargetCompleteness::Partial
    );
    assert!(gapped.batch.payload.next_cursor.is_none());
    assert!(gapped.batch.payload.source_range.is_none());

    let _ = fs::remove_dir_all(root);
}

#[test]
fn target_mapping_honors_cancellation_and_deadline_controls() {
    let root = target_protocol_fixture_root();
    let request = TargetAnalyzeRequest::new(
        "target-mapping-control-request",
        "target-mapping-control-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    let source = read_target_source(
        &request,
        &target_startup_config(&root),
        &std::sync::atomic::AtomicBool::new(false),
    )
    .expect("target source read succeeds");

    let cancelled = std::sync::atomic::AtomicBool::new(true);
    assert_eq!(
        map_target_source_read_with_control(
            &request,
            &source,
            &cancelled,
            Instant::now() + Duration::from_secs(1),
        )
        .expect_err("cancelled mapping must stop before publication"),
        TargetSourceReadError::Cancelled
    );

    let deadline = Instant::now() - Duration::from_millis(1);
    assert_eq!(
        map_target_source_read_with_control(
            &request,
            &source,
            &std::sync::atomic::AtomicBool::new(false),
            deadline,
        )
        .expect_err("expired mapping deadline must stop before publication"),
        TargetSourceReadError::Timeout
    );
}

#[test]
fn target_process_mapping_and_formal_promotion_controls_never_publish_stale_results() {
    let root = target_protocol_fixture_root();
    exercise_delayed_target_control(
        &root,
        "target-mapping-timeout",
        Some(300),
        None,
        Some(120),
        None,
    );
    exercise_delayed_target_control(
        &root,
        "target-mapping-cancel",
        Some(300),
        None,
        None,
        Some(150),
    );
    exercise_delayed_target_control(
        &root,
        "target-promotion-timeout",
        None,
        Some(300),
        Some(120),
        None,
    );
    exercise_delayed_target_control(
        &root,
        "target-promotion-cancel",
        None,
        Some(300),
        None,
        Some(150),
    );
}

#[test]
fn target_process_keeps_cancelled_source_worker_occupied_until_exit() {
    let root = target_protocol_fixture_root();
    let mut process =
        InteractiveTargetProcess::spawn_with_root_and_worker_delay(&root, None, Some(300));
    process.send(target_node_hello("target-worker-occupancy-generation"));
    assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));

    let cancelled_request = TargetAnalyzeRequest::new(
        "target-worker-occupancy-cancelled-request",
        "target-worker-occupancy-cancelled-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    process.send(TargetMessage::Analyze(cancelled_request.clone()));
    process.send(TargetMessage::Cancel(TargetCancelMessage::new(
        "target-worker-occupancy-cancelled-request",
        "cancel while source worker is delayed",
    )));
    let cancelled = target_error(process.read(), "cancelled");
    assert!(!cancelled.fatal);

    let blocked_request = TargetAnalyzeRequest::new(
        "target-worker-occupancy-blocked-request",
        "target-worker-occupancy-blocked-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    process.send(TargetMessage::Analyze(blocked_request));
    let busy = target_error(process.read(), "busy");
    assert!(!busy.retryable);

    std::thread::sleep(Duration::from_millis(450));
    let admitted_request = TargetAnalyzeRequest::new(
        "target-worker-occupancy-admitted-request",
        "target-worker-occupancy-admitted-job",
        TARGET_MAPPING_CONVERSATION_ID,
        TargetAnalyzeMode::Backfill,
    );
    process.send(TargetMessage::Analyze(admitted_request));
    let batch = match process.read() {
        TargetMessage::Batch(batch) => batch,
        other => panic!("expected a new batch after cancelled worker exit, got {other:?}"),
    };
    process.send(TargetMessage::Ack(TargetAckMessage::new(
        "target-worker-occupancy-admitted-request",
        batch.job_id.clone(),
        batch.segment_id.clone(),
        batch.batch_id.clone(),
        true,
        true,
        None::<String>,
    )));
    assert!(matches!(process.read(), TargetMessage::Complete(_)));
    process.finish();
}

#[test]
fn target_process_delivers_mapped_batch_and_waits_for_positive_ack() {
    let base = fs::read_to_string(target_fixture_path(
        &target_protocol_fixture_root(),
        TARGET_MAPPING_CONVERSATION_ID,
    ))
    .expect("target baseline reads");
    let token = current_fixture_contents("token-usage-record.jsonl")
        .lines()
        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("token fixture JSON"))
        .find(|line| line["type"] == "token_usage_record")
        .expect("known token carrier");
    let developer = current_fixture_contents("message-roles.jsonl")
        .lines()
        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("role fixture JSON"))
        .find(|line| line["payload"]["role"] == "developer")
        .expect("known developer carrier");
    let mut unknown = developer.clone();
    unknown["payload"]["role"] = json!("future_developer");
    let mut malformed = token.clone();
    malformed["payload"]["usage"] = json!("not-an-object");
    let growth_token = token.clone();

    for (label, carriers, canonical) in [
        ("baseline", vec![], true),
        ("token", vec![token.clone()], true),
        ("developer", vec![developer.clone()], true),
        ("both", vec![token.clone(), developer.clone()], true),
        (
            "unknown",
            vec![token.clone(), developer.clone(), unknown],
            false,
        ),
        ("malformed", vec![token, developer, malformed], false),
    ] {
        let root = unique_temp_path(&format!("present-diagnostics-{label}"));
        let mut contents = base.clone();
        for (index, mut carrier) in carriers.into_iter().enumerate() {
            carrier["ordinal"] = json!(index + 2);
            contents.push_str(&serde_json::to_string(&carrier).expect("carrier serializes"));
            contents.push('\n');
        }
        let source_path = write_target_fixture(&root, TARGET_MAPPING_CONVERSATION_ID, &contents);
        let mut process = InteractiveTargetProcess::spawn_with_root(&root, None);
        process.send(target_node_hello(&format!("{label}-generation")));
        assert!(matches!(process.read(), TargetMessage::AnalyzerHello(_)));

        let request_id = format!("{label}-request");
        process.send(TargetMessage::Analyze(TargetAnalyzeRequest::new(
            request_id.clone(),
            format!("{label}-job"),
            TARGET_MAPPING_CONVERSATION_ID,
            TargetAnalyzeMode::Backfill,
        )));
        let batch = match process.read() {
            TargetMessage::Batch(batch) => batch,
            other => panic!("expected mapped target batch for {label}, got {other:?}"),
        };
        let expected = if canonical {
            TargetCompleteness::Canonical
        } else {
            TargetCompleteness::Partial
        };
        assert_eq!(batch.payload.completeness, expected, "{label}");
        assert_eq!(batch.payload.complete, canonical, "{label}");
        let encoded = serde_json::to_string(&batch).expect("batch serializes");
        for sentinel in [
            "history developer carrier",
            "hidden-turn-sentinel",
            "internal_chat_message_metadata_passthrough",
            "thread_token_usage",
            "turn_token_usage",
            "response-sanitized-1",
        ] {
            assert!(!encoded.contains(sentinel), "{label} leaked {sentinel}");
        }
        if canonical {
            assert!(batch.payload.diagnostics.is_empty(), "{label}");
            assert_eq!(batch.payload.projection["coverage"], "complete", "{label}");
            assert_eq!(
                batch
                    .payload
                    .next_cursor
                    .as_ref()
                    .map(|cursor| cursor.cursor_kind),
                Some(TargetCursorKind::ForwardAppend),
                "{label}"
            );
            let diagnostics = batch.payload.projection["diagnostics"]
                .as_array()
                .expect("projection diagnostics");
            assert_eq!(
                diagnostics.len(),
                if label == "both" {
                    2
                } else if label == "baseline" {
                    0
                } else {
                    1
                }
            );
            assert!(
                diagnostics
                    .iter()
                    .all(|diagnostic| diagnostic["availability"] == "present")
            );
        } else {
            assert!(!batch.payload.diagnostics.is_empty(), "{label}");
            assert!(
                !batch
                    .payload
                    .mutations
                    .iter()
                    .any(|mutation| { matches!(mutation, TargetMutation::CompleteRange { .. }) }),
                "{label} published canonical range evidence"
            );
        }

        process.send(TargetMessage::Ack(TargetAckMessage::new(
            request_id,
            batch.job_id.clone(),
            batch.segment_id.clone(),
            batch.batch_id.clone(),
            true,
            true,
            None::<String>,
        )));
        let complete = match process.read() {
            TargetMessage::Complete(complete) => complete,
            other => panic!("expected mapped target complete for {label}, got {other:?}"),
        };
        assert_eq!(complete.completeness, expected, "{label}");
        assert_eq!(
            complete.checkpoint.projection_watermark.batch_id,
            batch.batch_id
        );
        if canonical {
            assert_eq!(complete.status, TargetCompleteStatus::Completed, "{label}");
            assert_eq!(
                complete.checkpoint.projection_watermark.complete_source_end,
                Some(contents.len() as u64),
                "{label}"
            );
        } else {
            assert_eq!(complete.status, TargetCompleteStatus::Partial, "{label}");
            assert_ne!(
                complete.checkpoint.cursor_kind,
                Some(TargetCursorKind::ForwardAppend),
                "{label}"
            );
        }
        process.finish();

        if canonical {
            let original_diagnostics = batch.payload.projection["diagnostics"]
                .as_array()
                .expect("initial diagnostics")
                .clone();
            let mut checkpoint = complete.checkpoint.clone();
            let mut cursor = batch.payload.next_cursor.clone().expect("canonical cursor");
            let mut expected_projection = batch.payload.projection.clone();
            let mut growth_anchor = None;

            for phase in ["no-growth", "growth", "growth-replay", "no-growth-latest"] {
                if phase == "growth" {
                    growth_anchor = Some((checkpoint.clone(), cursor.clone()));
                    let mut carrier = growth_token.clone();
                    carrier["ordinal"] = json!(contents.lines().count());
                    let line = serde_json::to_string(&carrier).expect("growth carrier serializes");
                    let mut file = fs::OpenOptions::new()
                        .append(true)
                        .open(&source_path)
                        .expect("synthetic source opens for append");
                    writeln!(file, "{line}").expect("synthetic source grows");
                    file.sync_all().expect("synthetic growth syncs");
                    contents.push_str(&line);
                    contents.push('\n');
                }

                let (anchor, append_cursor) = if phase == "growth-replay" {
                    growth_anchor
                        .clone()
                        .expect("pre-growth checkpoint retained")
                } else {
                    (checkpoint.clone(), cursor.clone())
                };
                let mut resumed = InteractiveTargetProcess::spawn_with_root(&root, None);
                resumed.send(target_node_hello(&format!("{label}-{phase}-generation")));
                assert!(matches!(resumed.read(), TargetMessage::AnalyzerHello(_)));
                let request_id = format!("{label}-{phase}-request");
                let mut request = TargetAnalyzeRequest::new(
                    request_id.clone(),
                    format!("{label}-{phase}-job"),
                    TARGET_MAPPING_CONVERSATION_ID,
                    TargetAnalyzeMode::Append,
                );
                request.cursor = Some(append_cursor);
                request.persisted_anchor = Some(anchor);
                resumed.send(TargetMessage::Analyze(request));
                let next = match resumed.read() {
                    TargetMessage::Batch(batch) => batch,
                    other => panic!("expected append batch for {label}/{phase}, got {other:?}"),
                };
                assert_eq!(next.payload.completeness, TargetCompleteness::Canonical);
                assert!(next.payload.complete);
                assert_eq!(
                    next.payload.history_items.len(),
                    usize::from(phase == "growth" || phase == "growth-replay"),
                    "{label}/{phase} must deliver only the expected delta"
                );
                let diagnostics = next.payload.projection["diagnostics"]
                    .as_array()
                    .expect("resumed diagnostics");
                for original in &original_diagnostics {
                    assert!(
                        diagnostics.contains(original),
                        "{label}/{phase} lost diagnostic"
                    );
                }
                assert_eq!(
                    diagnostics.len(),
                    original_diagnostics.len() + usize::from(phase != "no-growth"),
                    "{label}/{phase} must retain and deduplicate old and new diagnostics"
                );
                if phase == "growth" {
                    expected_projection = next.payload.projection.clone();
                } else {
                    assert_eq!(
                        next.payload.projection, expected_projection,
                        "{label}/{phase}"
                    );
                }

                resumed.send(TargetMessage::Ack(TargetAckMessage::new(
                    request_id,
                    next.job_id.clone(),
                    next.segment_id.clone(),
                    next.batch_id.clone(),
                    true,
                    true,
                    None::<String>,
                )));
                let done = match resumed.read() {
                    TargetMessage::Complete(done) => done,
                    other => panic!("expected append complete for {label}/{phase}, got {other:?}"),
                };
                assert_eq!(done.status, TargetCompleteStatus::Completed);
                assert_eq!(done.completeness, TargetCompleteness::Canonical);
                assert_eq!(
                    done.checkpoint.cursor_kind,
                    Some(TargetCursorKind::ForwardAppend)
                );
                assert_eq!(
                    done.checkpoint.projection_watermark.complete_source_end,
                    Some(contents.len() as u64)
                );
                assert_eq!(
                    done.checkpoint.reducer_state.payload["reducer"]["projection"]["diagnostics"],
                    next.payload.projection["diagnostics"],
                    "{label}/{phase} checkpoint must preserve diagnostic evidence"
                );
                cursor = next.payload.next_cursor.expect("append keeps cursor");
                checkpoint = done.checkpoint;
                resumed.finish();
            }
        }
        fs::remove_dir_all(root).expect("temporary target fixture removes");
    }
}
