) -> AnalysisEvent {
    AnalysisEvent::UserMessage {
        metadata: EventMetadata {
            event_id: event_id.to_string(),
            item_key: item_key.to_string(),
            correlation_id: None,
            related_item_key: None,
            conversation_id: conversation_id.map(|id| id.to_string()),
            turn_id: Some("turn-1".to_string()),
            timestamp: Some("2026-08-26T00:00:00Z".to_string()),
            sequence: line,
            availability: Availability::Present,
            terminal_evidence: None,
            identity_origin: Default::default(),
            source_ref: target_source_ref(source_identity, byte_start, byte_end, line),
        },
        text: "history item".to_string(),
    }
}

fn target_history_batch() -> TargetAnalysisBatch {
    let mut batch = target_partial_batch();
    batch.source_range = Some(TargetSourceByteRange::new(0, 100).expect("batch source range"));
    batch.history_items = vec![target_history_item(
        "event-1",
        "item-1",
        Some("conversation-1"),
        "source-1",
        10,
        20,
        1,
    )];
    batch
}

fn target_source_ref(identity: &str, byte_start: u64, byte_end: u64, line: u64) -> SourceRef {
    SourceRef {
        source_identity: identity.to_string(),
        byte_start,
        byte_end,
        physical_line_ordinal: line,
        rollout_ordinal: Some(line),
        timestamp: Some("2026-08-26T00:00:00Z".to_string()),
