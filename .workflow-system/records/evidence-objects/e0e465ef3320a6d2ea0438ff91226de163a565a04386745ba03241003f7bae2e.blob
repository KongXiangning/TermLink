fn target_replacement() -> LastTurnReplacement {
    LastTurnReplacement::new(
        "conversation-1",
        "parent-rollout",
        "child-rollout",
        "old-turn",
        "new-turn",
        TurnStatus::Completed,
        HistoryBaseRef::new("parent-rollout", 14, 128).expect("replacement cut"),
        target_source_ref("parent-rollout", 128, 140, 14),
        target_source_ref("parent-rollout", 512, 520, 20),
        target_source_ref("child-rollout", 700, 710, 18),
    )
}

fn target_lineage_evidence() -> (
    HistoryBaseRef,
    Vec<TargetLineageTransition>,
    TargetLineageCoverage,
) {
    let history_base = HistoryBaseRef::new("parent-rollout", 14, 128).expect("lineage cut");
    let transition = TargetLineageTransition {
        parent_rollout_id: "parent-rollout".to_string(),
        child_rollout_id: "child-rollout".to_string(),
        history_base: history_base.clone(),
        validation_state: TargetLineageValidationState::Validated,
    };
    let coverage = TargetLineageCoverage {
        root_rollout_id: "parent-rollout".to_string(),
        active_head_rollout_id: "child-rollout".to_string(),
        chain_rollout_ids: vec!["parent-rollout".to_string(), "child-rollout".to_string()],
        covered_source_count: 2,
        complete: true,
    };
    (history_base, vec![transition], coverage)
}

fn target_lineage_checkpoint() -> TargetLineageCheckpoint {
    let coverage = target_lineage_evidence().2;
    TargetLineageCheckpoint {
        schema_version: 1,
        conversation_id: "conversation-1".to_string(),
        root_rollout_id: coverage.root_rollout_id.clone(),
        active_head_rollout_id: coverage.active_head_rollout_id.clone(),
        chain_rollout_ids: coverage.chain_rollout_ids.clone(),
        start_date: Some("2026-08-26".to_string()),
        end_date: Some("2026-08-26".to_string()),
        coverage,
    }
}

fn target_canonical_lineage_batch() -> TargetAnalysisBatch {
    let (history_base, transitions, coverage) = target_lineage_evidence();
    let mut batch = target_canonical_batch();
    batch.history_base = Some(history_base);
    batch.lineage_transitions = transitions;
    batch.lineage_coverage = Some(coverage);
    batch.lineage_checkpoint = Some(target_lineage_checkpoint());
    batch
}

