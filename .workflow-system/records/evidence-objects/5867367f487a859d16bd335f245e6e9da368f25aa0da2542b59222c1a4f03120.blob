const fs=require('fs'),cp=require('child_process'),assert=require('node:assert/strict'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s5/review-1';
const execution='.workflow-system/records/events/key-9066ef26e085cf17840f5df83f588e75059cfb580f6f650d8dc9ef8c6c41fd18.json';
const query=(id,step,label)=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});fs.writeFileSync(`${d}/status-${label}.json`,r.stdout);assert.equal(r.status,0,r.stderr);return JSON.parse(r.stdout);};
const before=query('task-7ff69ba8242c90c52f0b93fa1144a655','S5','833-record-before');assert.equal(before.step.execution_ref,execution);assert.equal(before.step.state,'executed');
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
for(const a of JSON.parse(fs.readFileSync(execution.replace('/events/','/attachments/'),'utf8')).attachments){assert.equal(hash(a.source_path),a.sha256);assert.equal(hash(a.ref),a.sha256);}
const scope=JSON.parse(fs.readFileSync(`${d}/scope-check.json`,'utf8'));assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),scope.head);for(const p of [...scope.protectedChecks,...scope.source])assert.equal(hash(p.path),p.sha256);
const files=[`${d}/review-change.md`,`${d}/audit.cjs`,`${d}/attachment-check.json`,`${d}/scope-check.json`,`${d}/evidence-check.json`,`${d}/reviewed.diff`,`${d}/status-833-before.json`,`${d}/status-832-before.json`,`${d}/record-review.cjs`,...scope.source.map(p=>p.path),...scope.protectedChecks.filter(p=>!p.path.endsWith('.exe')).map(p=>p.path),'logs/shared-history-compat-20261005/s5/report.md','logs/shared-history-compat-20261005/s5/handoff.md','logs/shared-history-compat-20261005/s5/final-product-and-rust-result.json','logs/shared-history-compat-20261005/s5/final-product-and-rust.txt',...['H1-backfill.json','H1-append.json','H3-reopen-conflict.json'].map(p=>'logs/shared-history-compat-20261005/s5/evidence/final-product-and-rust/'+p)];
const input={action:'review',stage:'change',task_id:'task-7ff69ba8242c90c52f0b93fa1144a655',plan_ref:before.task.adopted_plan_ref,step_id:'S5',execution_ref:execution,source_revision:scope.head,verdict:'clean',findings:[],coverage:['Exact S5 test/REQ/PLAN/draft CR changes and shared contract S5 scope;real Store/importer/provider call chain','62 fixed/live execution attachments,13 protected subjects and4 current S5 source subjects match executed version','Saved final43/43 PASS evidence;fresh semantic audit of H1 full/append and H3 actual stagingCOMMIT/disk reopen/positiveACK/Rustcomplete/productCOMMIT/provider body/detail','Original delegated bodies/native carrier identity,dedup/restart/old partial seed;real negativeACK and SQLROLLBACK protection','Handoff retains H2/natural host/mobile and832/S2 work;no new H3 Gateway/device claim'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex',independent:false,new_product_tests_run:false,assessment:'Read-only exact diff/call-chain and saved actual evidence review;fresh attachment/scope/evidence verification,without business rerun'},remaining_work:['S5 finish disposition;833 close/dependency assessment and manual parent return not performed','832 H2 discovery/catalog localization and three-scenario natural-host/mobile body/tool-detail acceptance','832 S2 review/finish and reconcile duplicated shared implementation scope after explicit return','Retain old failures,S2 vendor offline limitation and3 old management association gaps;self-review is not independent review'],files,idempotency_key:'task20260833-S5-review-change-20261006-v1'};
fs.writeFileSync(`${d}/review-input.json`,JSON.stringify(input,null,2)+'\n');
const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(`${d}/review-result.json`,r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const after=query('task-7ff69ba8242c90c52f0b93fa1144a655','S5','833-after');const parent=query('task-58bc12d9a46b8d84fb6e42888785b402','S2','832-after');
assert.equal(after.step.execution_ref,execution);assert.equal(after.step.review_ref,out.ref);assert.equal(after.step.review_status,'clean');assert.equal(after.step.state,'executed');assert.equal(after.step.disposition_ref,null);assert.equal(after.task.lifecycle,'active');
const oldParent=JSON.parse(fs.readFileSync(`${d}/status-832-before.json`,'utf8'));for(const key of ['execution_ref','review_ref','state','disposition_ref'])assert.deepEqual(parent.step[key],oldParent.step[key]);assert.equal(parent.task.lifecycle,oldParent.task.lifecycle);
const reviewAttachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(a=>({path:a.source_path,sha256:a.sha256,fixed_matches:hash(a.ref)===a.sha256,live_matches:hash(a.source_path)===a.sha256}));assert.ok(reviewAttachments.every(p=>p.fixed_matches&&p.live_matches));fs.writeFileSync(`${d}/review-attachment-readback.json`,JSON.stringify(reviewAttachments,null,2)+'\n');
console.log(JSON.stringify({review_attachments:reviewAttachments.length,all_match:true,state:after.step.state,review:after.step.review_status,disposition:after.step.disposition_ref,next_route:after.next_route,next_mode:after.next_mode,next_step:after.next_step_id,parent_unchanged:true,retained_issues:after.issues.length}));
