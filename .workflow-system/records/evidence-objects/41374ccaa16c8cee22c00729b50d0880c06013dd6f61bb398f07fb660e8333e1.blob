const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S4'}),encoding:'utf8'}),state=JSON.parse(q.stdout);fs.writeFileSync(__dirname+'/status-S4-after-decision-link.json',q.stdout,{flag:'wx'});assert.equal(state.step.state,'finished');assert.equal(state.next_step_id,'S5');assert.equal(state.issues.length,3);console.log(JSON.stringify({S4:state.step.state,next_step:state.next_step_id,issues:state.issues.length}));
