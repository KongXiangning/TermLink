const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d='logs/history-save-repair-20261005/s2/review-20261007',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'),save=(n,v)=>fs.writeFileSync(`${d}/${n}.json`,JSON.stringify(v,null,2)+'\n');
function query(task,detail,step,name){const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({task_ref:task,detail,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);save(name,v);return v;}
const summary=JSON.parse(fs.readFileSync(`${d}/summary.json`,'utf8')),before=query('TASK-20260832','step','S2','status-832-record-before');
assert.equal(before.step.execution_ref,summary.parent.execution);assert.equal(before.step.disposition_ref,null);assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),summary.head);
for(const p of JSON.parse(fs.readFileSync(`${d}/execution-attachments.json`,'utf8'))){assert.equal(hash(p.path),p.sha256);assert.equal(hash(p.ref),p.sha256);}
for(const p of JSON.parse(fs.readFileSync(`${d}/source-applicability.json`,'utf8')))assert.equal(hash(p.path),p.current_sha256);
const files=[`${d}/review-change.md`,`${d}/audit.cjs`,`${d}/audit-notes.md`,`${d}/record-review.cjs`,`${d}/summary.json`,`${d}/execution-attachments.json`,`${d}/source-applicability.json`,`${d}/adopted-plan.json`,`${d}/child-close.json`,`${d}/git-before.json`,`${d}/status-832-before.json`,`${d}/status-832-record-before.json`,...JSON.parse(fs.readFileSync(`${d}/execution-attachments.json`,'utf8')).map(p=>p.path),'logs/history-save-repair-20261005/s1/repair-r1/report.md','logs/history-save-repair-20261005/s1/repair-r1/review-change.md','logs/history-save-repair-20261005/s1/repair-r1/run-1/failure.json','logs/history-save-repair-20261005/s1/repair-r1/run-2/result.json','logs/shared-history-compat-20261005/s5/handoff.md','logs/shared-history-compat-20261005/s5/review-1/review-change.md','docs/codex/codex-history-shared-compat-contract.md'];
const input={action:'review',stage:'change',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S2',execution_ref:before.step.execution_ref,source_revision:'fe3969f28b1b8934d2368f0b5b4a8b1a12b35f71',verdict:'clean',findings:[],coverage:['Exact original S2 scope-only execution and7 fixed/live attachments;32 historical candidate source hashes (31 raw,1 CRLF-normalized) and current applicability','H1 physical vs logical evidence and narrow full/append update proposal;H2 target vs verified auxiliary parent/cut/Branch isolation and real existing regression names;H3 actual carriers/call_id absence/owned event/dual physical identity/capability/old checkpoint/vendor promotion','Adopted plan,actual user choice and separate833 candidate versus later shared contract/delivery/close;REQ/PLAN/CR proposal and exclusions','Fresh parent executed/not-reviewed/not-finished,child closed without native origin/return/focus restoration;future S3/S4 scope reconciliation and three-scenario natural host/mobile work retained'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex',independent:false,new_product_tests_run:false,assessment:'Read-only historical scope/diff/source/evidence review;current HEAD589a62a checked for applicability,not recertified as old execution. Audit script corrections retained.'},remaining_work:['832/S2 separate finish disposition;explicit focus return still not performed,current_task_id is null','Reconcile current832 S3/S4 scope using833 H1/H3 shared delivery before implementation;do not repeat or automatically skip/mark PASS','H2 minimal Rust discovery/catalog/auxiliary parent repair and regression still needed','All3 natural-host/Gateway/mobile durable ACK,body/tool detail,switch/reopen acceptance remain unverified','Old failures,vendor offline validation limits and3 historical management association gaps retained'],files,idempotency_key:'task20260832-S2-review-change-20261007-v1'};
save('review-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(`${d}/review-result.json`,r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const after=query('TASK-20260832','step','S2','status-832-after'),parent=query('TASK-20260832','task',null,'task-832-after'),child=query('TASK-20260833','task',null,'task-833-after');assert.equal(after.step.execution_ref,before.step.execution_ref);assert.equal(after.step.review_ref,out.ref);assert.equal(after.step.review_status,'clean');assert.equal(after.step.state,'executed');assert.equal(after.step.disposition_ref,null);assert.deepEqual(after.focus,before.focus);assert.equal(after.current_task_id,before.current_task_id);assert.equal(child.task.lifecycle,'closed');assert.equal(child.task.lifecycle_ref,summary.child.close_ref);assert.equal(child.task.origin,null);
for(const p of JSON.parse(fs.readFileSync(`${d}/source-applicability.json`,'utf8')))assert.equal(hash(p.path),p.current_sha256);
const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('review-attachment-readback',attachments);
const result={task:after.task.display_id,state:after.step.state,review:after.step.review_status,disposition:after.step.disposition_ref,execution_unchanged:true,parent_lifecycle:after.task.lifecycle,child_closed_unchanged:true,focus_unchanged:true,current_task_id:after.current_task_id,global_next_route:after.next_route,selected_task_next_route:parent.task.next_route,selected_task_next_mode:parent.task.next_mode,review_attachments:attachments.length,attachment_matches:true,business_subjects_unchanged:true,retained_issues:after.issues.length};save('readback-summary',result);console.log(JSON.stringify(result));
