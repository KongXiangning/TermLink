'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),WebSocket=require('ws');require('dotenv').config({quiet:true});
const out=__dirname,priv=path.join(out,'private'),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
(async()=>{const id=process.argv[2],label=process.argv[3],session=JSON.parse(fs.readFileSync(path.join(priv,'session.json'))),auth='Basic '+Buffer.from(`${process.env.AUTH_USER||'admin'}:${process.env.AUTH_PASS||'admin'}`).toString('base64');
 const ws=new WebSocket('ws://127.0.0.1:3010/ws?sessionId='+session.id,{headers:{Authorization:auth}}),messages=[];let error=null;ws.on('message',b=>messages.push(JSON.parse(b)));ws.on('error',e=>error=e.message);
 const wait=async f=>{const end=Date.now()+10000;while(Date.now()<end){const m=messages.find(f);if(m)return m;if(error)throw Error(error);await new Promise(r=>setTimeout(r,30));}throw Error('bounded-wait-timeout');},send=m=>ws.send(JSON.stringify(m));
 const result={id,label,at:new Date().toISOString(),checks:[],app_ack_sent:false},check=(name,passed)=>result.checks.push({name,passed:!!passed});
 try{await wait(m=>m.type==='codex_ipc_status');const syncId=crypto.randomUUID(),generation=201;
 send({type:'conversation_history_sync_request',conversationId:id,syncId,selectionGeneration:generation,cacheSchemaVersion:3,productHistory:{version:1,detailRefs:true,onlyIfPresent:true},rangeSegments:{enabled:true,version:1,cacheSchemaVersion:3},checkpoint:{rootHash:null,itemCount:0,complete:false}});
 const first=await wait(m=>m.syncId===syncId&&['conversation_history_manifest_required','conversation_history_delta','conversation_history_sync_state'].includes(m.type));
 if(first.type==='conversation_history_manifest_required')send({type:'conversation_history_manifest_page',conversationId:id,syncId,clientSelectionGeneration:generation,pageIndex:0,lastPage:true,items:[]});
 if(first.type==='conversation_history_sync_state'){result.miss={state:first.state,detailCode:first.detailCode};}else{
 const page=await wait(m=>m.syncId===syncId&&m.type==='conversation_history_delta');result.page={id:page.conversationId,range:page.range,upserts:page.upserts.length,pageHash:page.pageHash,targetRoot:page.targetRoot,items:[]};
 check('product DB target identity',page.conversationId===id&&page.range?.providerMode==='product_db');
 for(const item of page.upserts){let text=item.payloadJson;if(item.payloadChunkCount){const parts=[];for(let i=0;i<item.payloadChunkCount;i++){const c=await wait(m=>m.syncId===syncId&&m.type==='conversation_history_payload_chunk'&&m.itemKey===item.itemKey&&m.chunkIndex===i);parts.push(c.data);}text=parts.join('');check('chunk hash '+item.itemKey,sha(text)===item.payloadHash&&Buffer.byteLength(text)===item.payloadBytes);}
 const sort=x=>Array.isArray(x)?x.map(sort):x&&typeof x==='object'?Object.fromEntries(Object.keys(x).sort().map(k=>[k,sort(x[k])])):x;
 const payloadHash=sha(text),version=(item.detailRefs?.length||item.detailRefsTruncated||item.availability)?sha(JSON.stringify(sort({payloadHash,detailRefs:item.detailRefs||[],detailRefsTruncated:item.detailRefsTruncated===true,availability:item.availability||null}))):payloadHash;
 check('item content hash '+item.itemKey,version===item.contentHash);const payload=JSON.parse(text);
 const entry={itemKey:item.itemKey,payloadHash:item.payloadHash,payloadBytes:Buffer.byteLength(text),keys:Object.keys(payload),markers:['TL832-S5-N-20261007','TL832-S5-N-DONE','TL832-S5-C-20261007','TL832-S5-C-DONE'].filter(m=>text.includes(m)),details:[]};
 for(const ref of item.detailRefs||[]){const requestId=crypto.randomUUID();send({type:'conversation_history_detail_request',conversationId:id,requestId,refId:ref.refId,selectionGeneration:generation});const d=await wait(m=>m.type==='conversation_history_detail_response'&&m.requestId===requestId);entry.details.push({refId:ref.refId,state:d.state,detailCode:d.detailCode,contentHash:d.contentHash,byteSize:d.byteSize,byteOffset:d.byteOffset,nextCursor:d.nextCursor,bytes:typeof d.content==='string'?Buffer.byteLength(d.content):null,sha256:typeof d.content==='string'?sha(d.content):null,markers:typeof d.content==='string'?['TL832-S5-N-20261007','TL832-S5-C-20261007'].filter(m=>d.content.includes(m)):[]});check('detail hash '+ref.refId,d.state==='ok'&&d.conversationId===id&&d.contentHash===ref.contentHash&&d.byteSize===ref.byteSize&&d.nextCursor===null&&sha(d.content)===d.contentHash);}
 result.page.items.push(entry);}
 }
 }catch(e){result.failure=e.message;}finally{const b=Buffer.from(JSON.stringify(messages));fs.writeFileSync(path.join(priv,label+'-product-wire.json'),b,{flag:'wx'});result.private_wire={bytes:b.length,sha256:sha(b)};ws.close(1000,'S5 DB-only read; no ACK');await new Promise(r=>setTimeout(r,200));ws.terminate();}
 fs.writeFileSync(path.join(out,label+'-product-read.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({id,label,items:result.page?.upserts,range:result.page?.range,miss:result.miss,failure:result.failure,checks:result.checks.length,failed:result.checks.filter(x=>!x.passed)}));if(result.failure||result.checks.some(x=>!x.passed))process.exitCode=2;
})().catch(e=>{console.error(e.message);process.exitCode=1;});
