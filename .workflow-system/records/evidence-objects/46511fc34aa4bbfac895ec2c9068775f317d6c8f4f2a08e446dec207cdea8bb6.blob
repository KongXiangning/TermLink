'use strict';
// Offline evidence self-check, not a product E2E pass or formal review.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const A = '01a0fe25-56a2-7910-ba22-61e8016e8ad9';
const C = '01a10643-ae9b-7cb1-b99b-f19f59acba6c';
const TURN = '01a10644-5f26-7ad0-96bb-46d05b0eb6f6';
const MARKER = 'E2E-S5-C-DONE|20261004|汉字🙂é';
const root = __dirname;
function read(name) { return JSON.parse(fs.readFileSync(path.join(root, name))); }
function sha(value) { return crypto.createHash('sha256').update(value).digest('hex'); }
function rows(db, query) {
  const result = db.exec(query)[0];
  return result ? result.values.map(values => Object.fromEntries(result.columns.map((column, i) => [column, values[i]]))) : [];
}
function open(SQL, name) {
  const db = new SQL.Database(fs.readFileSync(path.join(root, 'private', name, 'databases/codex_conversations.db')));
  db.run('PRAGMA query_only=ON');
  return db;
}
function itemDigest(db, conversation) {
  return sha(JSON.stringify(rows(db, `SELECT item_key,turn_id,position,item_type,role,payload_json,content_hash,payload_bytes,provisional,detail_refs_json FROM items WHERE conversation_id='${conversation}' ORDER BY endpoint_id,item_key`)));
}
async function main() {
  const phases = ['before', 'c-first', 'c-terminal', 'c-settled', 'c-cold', 'c-visible', 'c-valid-session', 'c-final-visible', 'a-return', 'c-return', 'restored'];
  const captures = phases.map(phase => read(phase + '.json'));
  const first = captures[0], last = captures.at(-1), visible = read('c-final-visible.json');
  const checks = [];
  function check(name, passed) { checks.push({ name, passed: Boolean(passed) }); }
  check('A source unchanged across every S5 capture', captures.every(d => d.sources[0].sha256 === first.sources[0].sha256));
  check('C source header binds distinct native branch', visible.sources[1].session_meta.id === C && C !== A && visible.sources[1].session_meta.forked_from_id === A);
  check('No history_base or resend child manufactured', captures.every(d => d.sources.every(s => s.history_bases.length === 0)));
  check('C terminal source unchanged after terminal capture', captures.slice(2).every(d => d.sources[1].sha256 === visible.sources[1].sha256 && d.sources[1].last_turn_id === TURN));
  const host = read('host-c-terminal.json');
  const turn = host.turns.find(t => t.id === TURN);
  check('Host exact C terminal turn completed', host.thread.id === C && turn?.status === 'completed');
  check('Exactly one new C turn (inherited A turns excluded)', host.turns.filter(t => !['01a0fe25-654b-7c40-b815-1848c9c56744', '01a10305-be51-76f0-9063-70d58652032e', '01a10308-856d-7072-85db-f5e5b5c4f81a'].includes(t.id)).length === 1);
  check('C exact Unicode final marker present in host evidence', JSON.stringify(turn).includes(MARKER));
  check('Every phone/product snapshot quick_check ok', captures.every(d => d.phone.database.quick_check[0].quick_check === 'ok' && d.product.quick_check[0].quick_check === 'ok'));
  check('Existing product canonical digest retained (not all DB bytes)', captures.every(d => d.product.canonical_digest === first.product.canonical_digest));
  check('A/C product history and receipts absent: failed publication retained', captures.every(d => Object.values(d.product.target_tables).every(t => Object.values(t).every(n => n === 0))));
  check('Awake C positive visible marker, blank composer', visible.phone.power === 'mWakefulness=Awake' && visible.ui_labels.C_marker && visible.edit_text_lengths.length === 1 && visible.edit_text_lengths[0] === 0);
  check('Awake C-return positive visible marker', read('c-return.json').phone.power === 'mWakefulness=Awake' && read('c-return.json').ui_labels.C_marker);
  const SQL = await require('sql.js')();
  const beforeDb = open(SQL, 'before'), afterDb = open(SQL, 'restored');
  const partitions = first.phone.database.counts.map(({ conversation_id }) => ({ conversation_id, before_digest: itemDigest(beforeDb, conversation_id), after_digest: itemDigest(afterDb, conversation_id) }));
  check('All existing phone item partitions retain semantic row bytes', partitions.every(p => p.before_digest === p.after_digest));
  const markerRows = rows(afterDb, "SELECT conversation_id,item_key,turn_id FROM items WHERE payload_json LIKE '%E2E-S5-C-DONE%'");
  check('C marker exists once only in C partition', markerRows.length === 1 && markerRows[0].conversation_id === C && markerRows[0].turn_id === TURN);
  check('C has 10 cached rows, A unchanged at 8', rows(afterDb, `SELECT count(*) n FROM items WHERE conversation_id='${C}'`)[0].n === 10 && rows(afterDb, `SELECT count(*) n FROM items WHERE conversation_id='${A}'`)[0].n === 8);
  check('No cached conversation falsely marked complete', rows(afterDb, `SELECT complete FROM conversations WHERE conversation_id IN ('${A}','${C}')`).every(r => r.complete === 0));
  beforeDb.close(); afterDb.close();
  const authority = phases.filter(p => ['c-final-visible', 'a-return', 'c-return'].includes(p)).map(phase => {
    const lines = fs.readFileSync(path.join(root, 'private', phase + '-logcat.txt'), 'utf8').split(/\r?\n/);
    return { phase, relevant_lines: lines.filter(line => line.includes('[ipc][surface-snapshot]') && (line.includes('conv=' + A) || line.includes('conv=' + C))).slice(-8) };
  });
  check('C-return final exact C healthy IPC snapshot', authority.find(a => a.phase === 'c-return').relevant_lines.at(-1)?.includes('conv=' + C) && authority.find(a => a.phase === 'c-return').relevant_lines.at(-1)?.includes('authority=IPC_AUTHORITATIVE'));
  check('A-return desynced outcome retained (not healthy PASS)', authority.find(a => a.phase === 'a-return').relevant_lines.at(-1)?.includes('conv=' + A) && authority.find(a => a.phase === 'a-return').relevant_lines.at(-1)?.includes('authority=IPC_DESYNCED'));
  check('Protected credential/server configuration hashes unchanged', ['termlink_server_config.xml','termlink_basic_credentials.xml','termlink_mtls_credentials.xml'].every(name => first.preference_hashes[name] === last.preference_hashes[name]));
  check('Phone app stopped, asleep, temporary reverse removed', !last.phone.pid.stdout && last.phone.power === 'mWakefulness=Asleep' && !last.phone.reverse.stdout);
  const cRuns = last.runs.filter(r => r.conversation_id === C);
  check('Real C failed analyzer runs retained', cRuns.length > 0 && cRuns.every(r => r.status === 'failed' && r.error?.code === 'analysis_failed' && r.error.message.includes('parent rollout is missing from catalog')));
  const files = phases.map(p => p + '.json').concat(['fork.json','host-c-terminal.json','observe.cjs','check.cjs']);
  const manifest = files.map(file => { const bytes = fs.readFileSync(path.join(root, file)); return { file, sha256: sha(bytes), bytes: bytes.length }; });
  const output = { kind: 'S5-evidence-self-check', product_e2e_result: 'partial; resend not-run; C product publication failed', checks, passed: checks.filter(c => c.passed).length, total: checks.length, partitions, marker_rows: markerRows, authority, c_runs: cRuns, phases: captures.map(d => ({ phase: d.phase, at: d.at, power: d.phone.power, ui: d.ui_labels, phone_counts: d.phone.database.counts, phone_pages: d.phone.database.pages.length, source_hashes: d.sources.map(s => ({ conversation_id:s.conversation_id, sha256:s.sha256 })), product_sha256:d.product.sha256, canonical_digest:d.product.canonical_digest })), manifest, limitations: ['Live backups not quiesced atomic snapshots.', 'No resend, cut, replacement, fresh tool-detail drilldown or healthy A/B IPC verification.', 'C inherited A items are legitimate host fork history, not evidence of source lineage.', 'Private source/DB/prefs/UI/logcat not attached.', 'Full product DB file hashes changed through normal failed analysis writes; existing canonical retained.'] };
  fs.writeFileSync(path.join(root, 'self-check.json'), JSON.stringify(output, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify({ passed: output.passed, total: output.total, failures: checks.filter(c => !c.passed), C_failed_runs: cRuns.length, marker_rows: markerRows }));
  if (output.passed !== output.total) process.exitCode = 1;
}
main().catch(error => { console.error(error.stack); process.exitCode = 1; });
