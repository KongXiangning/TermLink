'use strict';
const fs=require('fs'),cp=require('child_process'),assert=require('assert/strict'),path=require('path');
const base='logs/history-save-repair-20261005/independent-review-20261008',out=base+'/management';
const call=(command,input)=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs',command,'--root','.'],{input:JSON.stringify(input),encoding:'utf8',windowsHide:true});assert.equal(r.status,0,r.stderr||r.stdout);return {raw:r.stdout,value:JSON.parse(r.stdout)};};
const report=JSON.parse(fs.readFileSync(base+'/result.json'));
assert.ok(Array.isArray(report.steps)&&report.steps.length===6,'Independent result must cover six real step targets');
assert.ok(Array.isArray(report.findings)&&Array.isArray(report.report_files));
assert.equal(new Set(report.steps.map(x=>x.step_id)).size,6);
const start=JSON.parse(fs.readFileSync(out+'/task832-before.json'));
const live=call('task-status',{detail:'task',task_ref:start.task.task_id});
fs.writeFileSync(out+'/task832-before-record.json',live.raw,{flag:'wx'});
assert.equal(live.value.task.lifecycle,'active');
assert.equal(live.value.task.adopted_plan_ref,start.task.adopted_plan_ref);
assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),JSON.parse(fs.readFileSync(out+'/git-before.json')).head);
for(const s of report.steps){
    const original=start.task.steps.find(x=>x.id===s.step_id),current=live.value.task.steps.find(x=>x.id===s.step_id);
    assert.ok(original&&current);
    assert.equal(s.execution_ref,current.execution_ref);
    assert.equal(current.execution_ref,original.execution_ref);
    assert.equal(current.disposition_ref,original.disposition_ref);
    assert.equal(current.state,'finished');
    assert.ok(typeof s.verdict==='string'&&Array.isArray(s.findings)&&s.coverage);
}
const files=[...report.report_files,base+'/result.json',out+'/task832-before.json',out+'/task833-before.json',out+'/git-before.json',out+'/task832-before-record.json',out+'/record-independent-review.cjs'];
const uniqueFiles=[...new Set(files)];
for(const f of uniqueFiles){
    assert.ok(!path.isAbsolute(f)&&!f.includes('/private/')&&!f.includes('..'));
    assert.ok(fs.statSync(f).isFile(),f);
}
const provenance={kind:'independent-multi-agent-task-review',independent:true,reviewer:'/root/independent_832_review',
    reviewers:report.reviewers,recorder:'Codex /root (implementer, recording independent assessors results)',
    inherited_implementation_history:false,assessment:report.provenance,
    new_test_runs:report.new_test_runs||[],qualification:'Review of retained evidence and current cumulative code, not an independent physical rerun unless explicitly included in actual test facts.'};
const testRefs=[];
for(const [index,run] of (report.new_test_runs||[]).entries()){
    assert.ok(run.step_id&&run.command&&run.report_ref,'Actual independent test needs step/command/report');
    const step=live.value.task.steps.find(s=>s.id===run.step_id);assert.ok(step);
    const testFiles=[...new Set([...(run.files||[]),run.report_ref])];
    for(const f of testFiles){assert.ok(!path.isAbsolute(f)&&!f.includes('/private/')&&!f.includes('..'));assert.ok(fs.statSync(f).isFile());}
    const input={action:'test',task_id:live.value.task.task_id,plan_ref:live.value.task.adopted_plan_ref,
        step_id:run.step_id,execution_ref:step.execution_ref,source_revision:run.source_revision||JSON.parse(fs.readFileSync(out+'/git-before.json')).head,
        command:run.command,selector:run.selector||run.command,result:run.result,exit_code:run.exit_code,report_ref:run.report_ref,
        validation_kind:run.kind,evidence_section:run.evidence_section,applicable_step_ids:run.applicable_step_ids,
        provenance:{kind:'independent-task-review-validation',independent:true,reviewer:run.reviewer||run.provenance?.reviewer||provenance.reviewer,phase:'independent-review',qualification:run.qualification},
        files:testFiles,idempotency_key:'task832-independent-review-20261008-test-'+index+'-v1'};
    fs.writeFileSync(out+'/test-input-'+index+'.json',JSON.stringify(input,null,2)+'\n',{flag:'wx'});
    const saved=call('task',input);fs.writeFileSync(out+'/test-result-'+index+'.json',saved.raw,{flag:'wx'});
    assert.equal(saved.value.recorded,true);assert.equal(saved.value.association,'applied');assert.equal(saved.value.projection.status,'updated');
    testRefs.push({step:run.step_id,ref:saved.value.ref});
}
const recorded=[];
for(const s of report.steps){
    const current=live.value.task.steps.find(x=>x.id===s.step_id);
    const input={action:'review',stage:'change',task_id:live.value.task.task_id,plan_ref:live.value.task.adopted_plan_ref,
        step_id:s.step_id,execution_ref:s.execution_ref,source_revision:JSON.parse(fs.readFileSync(out+'/git-before.json')).head,
        previous_review_ref:current.review_ref,scope:'TASK-20260832 cumulative S1-S6 independent review; exact per-step execution association',
        task_review_ref:base+'/result.json',verdict:s.verdict,findings:s.findings,coverage:s.coverage,provenance,
        overall_verdict:report.overall_verdict,test_refs:testRefs.filter(t=>t.step===s.step_id).map(t=>t.ref),retained_issues:report.retained_issues||[],remaining_work:report.remaining_work||[],
        decision_source:'Direct human request for independent review of TASK-20260832 after S1-S6 finished',
        decision_text:'832现在S1-S6全部完成，现在对832进行一次独立审查',
        files:uniqueFiles,idempotency_key:'task832-allsteps-independent-review-20261008-'+s.step_id+'-v1'};
    fs.writeFileSync(out+'/review-input-'+s.step_id+'.json',JSON.stringify(input,null,2)+'\n',{flag:'wx'});
    const result=call('task',input);fs.writeFileSync(out+'/review-result-'+s.step_id+'.json',result.raw,{flag:'wx'});
    assert.equal(result.value.recorded,true);assert.equal(result.value.association,'applied');assert.equal(result.value.projection.status,'updated');
    recorded.push({step:s.step_id,execution_ref:s.execution_ref,review_ref:result.value.ref,verdict:s.verdict});
}
const after=call('task-status',{detail:'task',task_ref:start.task.task_id});
fs.writeFileSync(out+'/task832-after.json',after.raw,{flag:'wx'});
for(const s of recorded){
    const current=after.value.task.steps.find(x=>x.id===s.step),old=start.task.steps.find(x=>x.id===s.step);
    assert.equal(current.review_ref,s.review_ref);assert.equal(current.review_status,s.verdict);
    assert.equal(current.execution_ref,old.execution_ref);assert.equal(current.disposition_ref,old.disposition_ref);
    assert.equal(current.state,'finished');
}
assert.equal(after.value.task.lifecycle,'active');
const child=call('task-status',{detail:'task',task_ref:'TASK-20260833'});fs.writeFileSync(out+'/task833-after.json',child.raw,{flag:'wx'});assert.equal(child.value.task.lifecycle,'closed');
const result={recorded,test_refs:testRefs,scope:'all6 actual executions independently reviewed',overall_verdict:report.overall_verdict,
    all_original_dispositions_preserved:true,task_lifecycle:after.value.task.lifecycle,prerequisite_lifecycle:child.value.task.lifecycle,
    next_route_from_view:after.value.next_route,issues:after.value.issues.map(x=>({code:x.code,ref:x.ref}))};
fs.writeFileSync(out+'/review-associations.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify(result));
