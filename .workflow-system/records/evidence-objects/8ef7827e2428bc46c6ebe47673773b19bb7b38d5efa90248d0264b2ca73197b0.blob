'use strict';
const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict');
const base='logs/history-save-repair-20261005/independent-review-20261008',dir=base+'/management/user-disposition';
fs.mkdirSync(dir,{recursive:true});
const call=(cmd,input)=>{const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs',cmd,'--root','.'],{input:JSON.stringify(input),encoding:'utf8',windowsHide:true});assert.equal(r.status,0,r.stderr||r.stdout);return {raw:r.stdout,value:JSON.parse(r.stdout)};};
const before=call('task-status',{detail:'task',task_ref:'TASK-20260832'});
fs.writeFileSync(dir+'/before.json',before.raw,{flag:'wx'});
assert.equal(before.value.task.lifecycle,'active');assert.ok(before.value.task.steps.every(s=>s.state==='finished'));
const originalReviewFiles=[base+'/report.md',base+'/result.json',base+'/node-review.md',base+'/node-audit.json'];
const hashes=Object.fromEntries(originalReviewFiles.map(p=>[p,crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')]));
const files=[base+'/user-disposition-20261008.md',base+'/management/record-user-disposition.cjs',
    'docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/product/requirements/REQ-20261005-codex-history-save-repair.md'];
const records=[];
for(const id of ['S4','S5']){
    const step=before.value.task.steps.find(s=>s.id===id);
    assert.equal(step.review_status,'findings');assert.ok(step.findings.some(f=>f.id==='IR832-01'));
    const input={action:'review-decision',task_id:before.value.task.task_id,plan_ref:before.value.task.adopted_plan_ref,
        step_id:id,review_ref:step.review_ref,choice:'accept',
        decision_source:'Direct human reply to independently reproduced IR832-01, current conversation',
        decision_text:'这个P2不用处理，可以不存在这个版本之前的旧格式（没有之前的产品发布至普通用户）。',
        decision_interpretation:'No prior ordinary-user product release; pre-current-version product format migration is not a requirement for this task/release. Exclude IR832-01 from required repair; retain independent finding and reproduction as technical facts.',
        finding_disposition:{finding_id:'IR832-01',state:'excluded-from-current-release-requirements',technical_resolution:'not-fixed',
            release_premise:'Human confirms no previous product release to ordinary users; prior published target-v1 product checkpoint upgrade need not be supported for this version',
            excluded:'pre-current-version settled canonical product-format migration',
            preserved:'Current-version saves/append/restart, unsettled original profile/job/delivery protection, old canonical/receipts, fail-closed cross-profile checks and resource/source/IPC boundaries'},
        files,remaining_work:['Normal close-task disposition still separate; six finished states and taskactive retained','Known out-of-scope error banner/budget/registration and old3 management associations retained'],
        idempotency_key:'task832-IR832-01-no-prior-public-product-release-user-disposition-20261008-'+id+'-v1'};
    fs.writeFileSync(dir+'/input-'+id+'.json',JSON.stringify(input,null,2)+'\n',{flag:'wx'});
    const saved=call('task',input);fs.writeFileSync(dir+'/result-'+id+'.json',saved.raw,{flag:'wx'});
    assert.equal(saved.value.recorded,true);assert.equal(saved.value.association,'applied');assert.equal(saved.value.projection.status,'updated');
    records.push({step_id:id,review_ref:step.review_ref,decision_ref:saved.value.ref});
}
const after=call('task-status',{detail:'task',task_ref:before.value.task.task_id});
fs.writeFileSync(dir+'/after.json',after.raw,{flag:'wx'});
assert.equal(after.value.task.lifecycle,'active');assert.equal(after.value.task.adopted_plan_ref,before.value.task.adopted_plan_ref);
for(const old of before.value.task.steps){const current=after.value.task.steps.find(s=>s.id===old.id);assert.equal(current.state,old.state);assert.equal(current.execution_ref,old.execution_ref);assert.equal(current.review_ref,old.review_ref);assert.equal(current.review_status,old.review_status);assert.equal(current.disposition_ref,old.disposition_ref);}
for(const r of records){const step=after.value.task.steps.find(s=>s.id===r.step_id);assert.equal(step.review_choice,'accept');assert.equal(step.review_decision_ref,r.decision_ref);}
assert.equal(after.value.next_route,'close-task');
const manifests=[];
for(const r of records){const p=r.decision_ref.replace('/events/','/attachments/'),m=JSON.parse(fs.readFileSync(p));assert.ok(m.attachments.every(a=>a.status==='saved'&&a.issues.length===0&&crypto.createHash('sha256').update(fs.readFileSync(a.ref)).digest('hex')===a.sha256));manifests.push({ref:p,files:m.attachments.length,all_saved_exact:true});}
assert.ok(Object.entries(hashes).every(([p,h])=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')===h));
const proof={records,manifests,old_independent_review_bytes_unchanged:true,review_verdicts_not_relabelled:true,six_original_finished_dispositions_retained:true,task_lifecycle:after.value.task.lifecycle,next_route:after.value.next_route,old_management_issues:after.value.issues.length};
fs.writeFileSync(dir+'/verification.json',JSON.stringify(proof,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(proof));
