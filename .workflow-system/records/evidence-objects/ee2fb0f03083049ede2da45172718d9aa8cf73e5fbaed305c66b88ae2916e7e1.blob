'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),out=__dirname,read=n=>JSON.parse(fs.readFileSync(path.join(out,'../'+n+'.json'))),sha=x=>crypto.createHash('sha256').update(x).digest('hex'),sort=x=>Array.isArray(x)?x.map(sort):x&&typeof x==='object'?Object.fromEntries(Object.keys(x).sort().map(k=>[k,sort(x[k])])):x,checks=[],check=(name,p)=>checks.push({name,passed:!!p});
const base=read('repair-baseline-20261008'),after=read('repair-after-20261008'),raw=JSON.parse(fs.readFileSync(path.join(out,'private/a-full-wire.json'))),source=fs.readFileSync(base.sources.D[0].path,'utf8').trim().split('\n').map(JSON.parse),items=raw.items.map(x=>({...x,payload:JSON.parse(x.payloadJson)})),details=raw.details.map(x=>JSON.parse(x.text));
function bounded(text){const bytes=Buffer.from(text),marker='…<truncated>';if(bytes.length<=65536)return text;let end=65536-Buffer.byteLength(marker);while((bytes[end]&0xc0)===0x80)end--;return bytes.subarray(0,end).toString('utf8')+marker;}
const delegates=source.filter(r=>r.type==='response_item'&&r.payload.type==='function_call_output').map(r=>r.payload),savedDelegates=items.filter(x=>x.payload.kind==='delegated_input');check('three distinct delegated input rows',savedDelegates.length===3);
for(const d of delegates){const row=savedDelegates.find(x=>x.itemKey==='delegated-input:'+d.id);check('delegated identity/body/'+d.id,row&&row.payload.role==='system'&&row.payload.content===bounded(d.output)&&row.payload.turn_id===row.turnId);check('both real delegated carriers/'+d.id,row&&row.payload.eventFacts.length===2&&row.payload.eventFacts.every(e=>e.event_type==='DelegatedInput'&&e.payload.item_id===d.id&&e.payload.text===bounded(d.output)&&e.payload.origin_tool===d.name&&e.payload.namespace===d.namespace));}
for(const r of source.filter(r=>r.payload?.item?.type==='CommandExecution')){const n=r.payload.item,d=details.find(x=>x.call_id===n.id),ms=n.duration.secs*1000+Math.floor(n.duration.nanos/1e6),expected=bounded(`status=${n.status}; exit_code=${n.exit_code}; duration_ms=${ms}; output=${n.aggregated_output}`);check('native command detail/'+n.id,d&&d.input===bounded(JSON.stringify({command:n.command,cwd:n.cwd}))&&d.output===expected);}
for(const r of source.filter(r=>r.type==='response_item'&&r.payload.type==='custom_tool_call')){const n=r.payload,d=details.find(x=>x.call_id===n.call_id),end=source.find(x=>x.type==='response_item'&&x.payload.type==='custom_tool_call_output'&&x.payload.call_id===n.call_id)?.payload;let input;try{input=JSON.stringify(sort(JSON.parse(n.input)));}catch{input=n.input;}check('custom tool detail/'+n.call_id,d&&d.input===bounded(input)&&d.output===bounded(typeof end?.output==='string'?end.output:JSON.stringify(end?.output)));}
const answers=source.filter(r=>r.type==='response_item'&&r.payload.type==='message'&&r.payload.role==='assistant').map(r=>r.payload);for(const n of answers){const text=n.content.filter(x=>x.type==='output_text').map(x=>x.text).join('\n');check('assistant body/'+n.id,items.some(x=>x.itemKey==='message:'+n.id&&x.payload.content===bounded(text)));}
check('all published body/details UTF8 intact',![...items.map(x=>x.payloadJson),...raw.details.map(x=>x.text)].some(x=>x.includes('\ufffd')));
for(const label of ['N','C','D','F'])check('source readonly/'+label,base.sources[label][0].sha256===after.sources[label][0].sha256);
for(const c of base.canonical)check('old canonical/'+c.id,after.canonical.some(x=>x.id===c.id&&x.digest===c.digest));
check('56 old run bytes preserved',base.runs.every(x=>after.runs.some(r=>r.file===x.file&&r.sha256===x.sha256)));
const a=after.canonical.find(x=>x.id===base.ids.D);check('A canonical40items9details',a&&a.items===40&&a.details===9&&a.coverage.completeness==='canonical'&&a.coverage.coverageComplete);check('A intent completed',!after.intents.some(x=>x.conversation_id===base.ids.D));
const newRuns=after.runs.filter(x=>!base.runs.some(b=>b.file===x.file)),success=newRuns.find(x=>x.conversation_id===base.ids.D);check('A run completed with positive receipt',success&&success.status==='completed'&&success.receipt_count===1&&success.batches===1);
const root='logs/task005-s2-repair-runtime-2/data/',cpFile=fs.readdirSync(root+'codex-rollout-checkpoints').map(n=>JSON.parse(fs.readFileSync(root+'codex-rollout-checkpoints/'+n))).find(x=>x.conversation_id===base.ids.D),analysis=JSON.parse(fs.readFileSync(root+'codex-rollout-analysis/7ebafbd2d3b406ee0596cf79203a66a04e36581d7a6ff20ef2ff14a6b4a88406.json')),batch=analysis.staging.find(x=>x.batch_id===cpFile.projection_watermark.batch_id);check('persisted checkpoint exact accepted batch reducer',sha(JSON.stringify(sort(cpFile.reducer_state)))===sha(JSON.stringify(sort(batch.payload.reducer_state)))&&cpFile.wire_profile.compatibility_profile==='history-semantics-v2');
const report={at:new Date().toISOString(),checks,passed:checks.filter(x=>x.passed).length,total:checks.length,details:raw.details.map(x=>({call_id:JSON.parse(x.text).call_id,pages:x.pages,bytes:x.ref.byteSize,hash:x.ref.contentHash,truncated:JSON.parse(x.text).output?.endsWith('…<truncated>')||false})),new_runs:newRuns.map(r=>({conversation_id:r.conversation_id,status:r.status,error:r.error})),qualification:'Evidence self-check, not test count/phone/independent review;64KiB native text retention observed and preserved'};fs.writeFileSync(path.join(out,process.argv[2]||'self-check.json'),JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed:report.passed,total:report.total,failed:checks.filter(x=>!x.passed),new_runs:report.new_runs}));if(report.passed!==report.total)process.exitCode=2;
