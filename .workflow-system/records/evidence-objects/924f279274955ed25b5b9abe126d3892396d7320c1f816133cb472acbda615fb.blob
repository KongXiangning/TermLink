const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict'),dir=__dirname,rel='logs/history-save-repair-20261005/s5/review-utf8-20261008';
const before=JSON.parse(fs.readFileSync(dir+'/status-before.json')),audit=JSON.parse(fs.readFileSync(dir+'/audit.json'));
const input={action:'review',stage:'change',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S5',execution_ref:before.step.execution_ref,source_revision:audit.head,verdict:'clean',findings:[],coverage:['Exact latest832/S5 execution source/test/docs snapshots;28fixed/live hashes match; one missing optional stop log retained with actual later stopped observation','Node stdout pipe/UTF8/JSONL/validation/message/process lifecycle and stale child callchain; no changes to ACK/complete/checkpoint equality or shared contracts','Old negative2fail/1pass, fixed3/3 and collector+recovery138/138 real output reused; three tests cover split bytes/large messages/restart isolation; natural A verifies batch/complete product path','Real A original-root intent/batch/positive receipt/consistent checkpoint/canonical40items9details; Gateway64checks private wire hash verified; repeated read-only source/protection36/36','Prior real ordinaryN and nativeC own-turn/inheritance evidence reused; unchanged canonical digests; three scenarios separately qualified at server product layer','64KiB retention/oldfailures/BQbudgets/3legacy management gaps preserved; no phone, independent review, commit, finish or close'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex /root',independent:false,new_product_tests_run:false,assessment:'Read-only actual code/callchain/snapshot/wire/source evidence review; saved test output reused. Source/protection evidence checks rerun read-only; no service/device/model effects.'},remaining_work:['SeparateS5finish disposition;832active/currentS5;S1-S4remainfinished/833closed','S6 actualphone durablecommitACK/switch/reopen/body/tools notrun;diagnosticACK notsubstitute','REQin_progress/newCRdraftTBD;oldfailures/BQbudgets/3historyassociationgaps andoptionalstoplogENOENT retained'],files:[rel+'/review-change.md',rel+'/audit.cjs',rel+'/audit.json',rel+'/review-diff.txt',rel+'/status-before.json',rel+'/record-review.cjs','logs/history-save-repair-20261005/s5/utf8-repair-20261008/review-source-checks-20261008.json',...audit.subjects.map(x=>x.path)],idempotency_key:'task832-S5-UTF8-repair-review-change-20261008-v1'};
fs.writeFileSync(dir+'/review-input.json',JSON.stringify(input,null,2)+'\n',{flag:'wx'});const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(dir+'/review-result.json',r.stdout,{flag:'wx'});assert.equal(r.status,0,r.stderr);const v=JSON.parse(r.stdout);assert.equal(v.recorded,true);assert.equal(v.association,'applied');assert.equal(v.projection.status,'updated');
const query=(task,step,name)=>{const p=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:step?'step':'task',task_ref:task,...(step?{step_id:step}:{})}),encoding:'utf8'});assert.equal(p.status,0);fs.writeFileSync(dir+'/'+name+'.json',p.stdout,{flag:'wx'});return JSON.parse(p.stdout);};
const s=query('TASK-20260832','S5','status-after'),child=query('TASK-20260833',null,'status-833-after');assert.equal(s.step.review_ref,v.ref);assert.equal(s.step.review_status,'clean');assert.equal(s.step.execution_ref,before.step.execution_ref);assert.equal(s.step.disposition_ref,null);assert.equal(s.next_route,'execute-step');assert.equal(s.next_mode,'finish');assert.equal(s.step.state,'executed');assert.equal(s.current_task_id,before.current_task_id);assert.equal(child.task.lifecycle,'closed');assert.equal(s.issues.length,3);
const sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const a=JSON.parse(fs.readFileSync(v.ref.replace('/events/','/attachments/'))).attachments.map(x=>({path:x.source_path,fixed:sha(x.ref)===x.sha256,live:sha(x.source_path)===x.sha256}));assert.ok(a.every(x=>x.live&&x.fixed));assert.ok(audit.subjects.every(x=>sha(x.path)===x.sha256));fs.writeFileSync(dir+'/attachment-readback.json',JSON.stringify(a,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({ref:v.ref,recorded:v.recorded,association:v.association,projection:v.projection.status,review:s.step.review_status,findings:s.step.findings.length,state:s.step.state,finish:s.step.disposition_ref,next_route:s.next_route,next_mode:s.next_mode,next_step:s.next_step_id,task833:child.task.lifecycle,attachments:a.length,all_match:true,old_management_gaps:s.issues.length}));
