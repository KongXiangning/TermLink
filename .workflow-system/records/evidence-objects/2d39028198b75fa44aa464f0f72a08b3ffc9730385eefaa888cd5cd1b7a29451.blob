const fs=require('fs'),path=require('path'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');const d=__dirname,rel='logs/history-save-repair-20261005/s3/review-r2',save=(n,v)=>fs.writeFileSync(path.join(d,n+'.json'),JSON.stringify(v,null,2)+'\n'),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const before=JSON.parse(fs.readFileSync(path.join(d,'status-before.json'),'utf8')),audit=JSON.parse(fs.readFileSync(path.join(d,'audit.json'),'utf8'));
const input={action:'review',stage:'change',task_id:before.task.task_id,plan_ref:before.task.adopted_plan_ref,step_id:'S3',execution_ref:before.step.execution_ref,previous_review_ref:audit.oldReview,source_revision:audit.head,verdict:'clean',findings:[],resolved_findings:[{id:'832-S3-R1',review_ref:audit.oldReview,status:'verified-on-current-execution',evidence_refs:['logs/history-save-repair-20261005/s3/repair-r1/branch-5.txt','logs/history-save-repair-20261005/s3/repair-r1/target-1.txt','logs/history-save-repair-20261005/s3/repair-r1/branch-bounded-trace.json'],qualification:'Current repair source/evidence assessed;oldfindingsverdict retained,not task/product/mobile completion'}],coverage:['Exact832S3repair execution;70fixed/live attachments,11subjects/11protectedsubjects,currentbinary andbaselineHEAD match','Inheritedprefix/activebackfill shared complete-line windows,contiguous0..cut,persegmentandaggregate budgets,spool order,allwindow completeness andfinalordinal/bytecut','Bothinitialread andappendlineage recovery usewindows;mapper sourcecount/physicalprovenance/target binding/diagnostics andinheritance versusresend guards retained','Existingbranch3/3,target76/76 and3actualRustprotocoltraces reused withmatchingbytes;negativeaggregate/line/cut/earlyparsegap checks;priorfailuresnotdeleted','REQ/PLAN/newdraftCR scope consistent;fullRust/source/Node/product/Gateway/naturalhost/mobile not recertified'],provenance:{kind:'same-agent-change-self-review',reviewer:'Codex',independent:false,new_product_tests_run:false,assessment:'Read-only code/call-chain/fixed-and-live evidence audit;no new formal independent review or durable Node/device validation',binary_sha256:audit.binary.sha256},remaining_work:['Separate832S3finish disposition,task832active;not automaticS4','S4consumer/product chain;S5S6all3naturalhost/mobile durableACK/body/tool/switch/reopen pending','Previous failures/vendoroffline limit and3oldmanagementassociationgaps retained'],files:[rel+'/review-change.md',rel+'/audit.cjs',rel+'/audit.json',rel+'/status-before.json',rel+'/record-review.cjs',...audit.subjects.map(p=>p.path)],idempotency_key:'task20260832-S3-review-change-20261007-r2'};
save('review-input',input);const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task','--root','.'],{input:JSON.stringify(input),encoding:'utf8'});fs.writeFileSync(path.join(d,'review-result.json'),r.stdout);assert.equal(r.status,0,r.stderr||r.stdout);const out=JSON.parse(r.stdout);assert.equal(out.recorded,true);assert.equal(out.association,'applied');assert.equal(out.projection.status,'updated');console.log(JSON.stringify({recorded:out.recorded,ref:out.ref,association:out.association,projection:out.projection}));
const q=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S3'}),encoding:'utf8'});assert.equal(q.status,0,q.stderr);const status=JSON.parse(q.stdout);save('status-after',status);assert.equal(status.step.review_ref,out.ref);assert.equal(status.step.review_status,'clean');assert.equal(status.step.execution_ref,before.step.execution_ref);assert.equal(status.step.state,'executed');assert.equal(status.step.disposition_ref,null);assert.equal(status.current_task_id,before.current_task_id);assert.equal(status.next_route,'execute-step');assert.equal(status.next_mode,'finish');
const childQuery=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'task',task_ref:'TASK-20260833'}),encoding:'utf8'});assert.equal(childQuery.status,0,childQuery.stderr);const child=JSON.parse(childQuery.stdout);save('status-833-after',child);assert.equal(child.task.lifecycle,'closed');
const attachments=JSON.parse(fs.readFileSync(out.ref.replace('/events/','/attachments/'),'utf8')).attachments.map(p=>({path:p.source_path,sha256:p.sha256,fixed_matches:hash(p.ref)===p.sha256,live_matches:hash(p.source_path)===p.sha256}));assert.ok(attachments.every(p=>p.fixed_matches&&p.live_matches));save('attachment-readback',attachments);assert.ok([...audit.subjects,...audit.protect].every(p=>hash(p.path)===p.sha256));assert.equal(JSON.parse(fs.readFileSync(audit.oldReview,'utf8')).payload.request.verdict,'findings');
console.log(JSON.stringify({state:status.step.state,review:status.step.review_status,findings:status.step.findings.length,finish:status.step.disposition_ref,next_route:status.next_route,next_mode:status.next_mode,next_step:status.next_step_id,child:'closed',attachments:attachments.length,all_match:true,oldReview:'findings retained',issues:status.issues.length}));
