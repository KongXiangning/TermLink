const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d='logs/history-save-repair-20261005/s3',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const base=JSON.parse(fs.readFileSync(d+'/baseline.json','utf8'));assert.equal(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),base.head);
const protect=base.protect.map(p=>({...p,matches:hash(p.path)===p.sha256}));assert.ok(protect.every(p=>p.matches));
const fixtures=['a-full.jsonl','c-header.jsonl'].map(p=>({name:p,original_sha256:hash('logs/history-save-repair-20261005/s1/repair-r1/fixtures-v2/'+p),formal_sha256:hash('native/codex-rollout-collector/tests/fixtures/branch-history/'+p)}));assert.ok(fixtures.every(p=>p.original_sha256===p.formal_sha256));
const evidence=[];for(const [name,id]of[['branch-batch.json','00000000-0000-4000-8000-000000000012'],['original-sanitized-branch-batch.json','00000000-0000-4000-8000-000000000002']]){const b=JSON.parse(fs.readFileSync(d+'/evidence/'+name,'utf8')).payload;assert.equal(b.conversation_id,id);assert.equal(b.completeness,'canonical');assert.equal(b.replacements.length,0);assert.ok(b.history_items.every(p=>p.payload.metadata.conversation_id===id));const items=b.projection.turns.flatMap(t=>t.items),delegated=items.filter(i=>i.kind==='delegated_input');assert.equal(delegated.length,3);assert.deepEqual(delegated.map(i=>i.content),['[sanitized delegation 1]','[sanitized delegation 2]','[sanitized delegation 3]']);assert.equal(new Set(items.map(p=>p.key||p.item_key)).size,items.length);assert.ok(!JSON.stringify(b).includes('parent-after-fork'));evidence.push({name,target:id,canonical:true,delegations:delegated.length,replacements:0,items:items.length});}
const paths=[...base.subjects.map(p=>p.path),'native/codex-rollout-collector/tests/fixtures/branch-history/a-full.jsonl','native/codex-rollout-collector/tests/fixtures/branch-history/c-header.jsonl','native/codex-rollout-collector/tests/fixtures/branch-history/README.md','docs/product/requirements/REQ-20261005-codex-history-save-repair.md','docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/changes/records/CR-20261007-0900-branch-history-parent.md'];
const sourceAfter=paths.map(p=>({path:p,sha256:hash(p)}));fs.writeFileSync(d+'/source-after.json',JSON.stringify(sourceAfter,null,2)+'\n');
const binary='native/codex-rollout-collector/target/debug/codex-rollout-collector.exe',result={head:base.head,protect,fixtures,evidence,binary:{path:binary,sha256:hash(binary)},qualification:'Implementation self-check only,not change review,product durable ACK or phone acceptance'};fs.writeFileSync(d+'/self-check.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({protected:protect.length,fixtures:fixtures.length,evidence,binary:result.binary}));
