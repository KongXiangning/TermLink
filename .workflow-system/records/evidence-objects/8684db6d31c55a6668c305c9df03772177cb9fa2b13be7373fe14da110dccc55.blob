const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('node:assert/strict');
const d='logs/shared-history-compat-20261005/s5/review-1';
const execution='.workflow-system/records/events/key-9066ef26e085cf17840f5df83f588e75059cfb580f6f650d8dc9ef8c6c41fd18.json';
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const save=(name,v)=>fs.writeFileSync(`${d}/${name}.json`,JSON.stringify(v,null,2)+'\n');
const checks=JSON.parse(fs.readFileSync(execution.replace('/events/','/attachments/'),'utf8')).attachments.map(a=>({path:a.source_path,sha256:a.sha256,fixed_matches:hash(a.ref)===a.sha256,live_matches:hash(a.source_path)===a.sha256}));
save('attachment-check',checks);
const base=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s5/baseline.json','utf8'));
const protectedChecks=base.protected.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const source=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s5/source-after.json','utf8')).map(p=>({...p,matches:hash(p.path)===p.sha256}));
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
save('scope-check',{head,protectedChecks,source});
assert.equal(head,base.head);assert.ok(checks.every(p=>p.fixed_matches&&p.live_matches));assert.ok([...protectedChecks,...source].every(p=>p.matches));
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S5'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});
 fs.writeFileSync(`${d}/status-${label}-before.json`,r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);
}
const diff=cp.spawnSync('git',['diff','--','tests/codexHistoryProductFlow.test.js'],{encoding:'utf8'});if(diff.status!==0)throw Error(diff.stderr);fs.writeFileSync(`${d}/reviewed.diff`,diff.stdout);
const evidence='logs/shared-history-compat-20261005/s5/evidence/final-product-and-rust';
const verify=(audit)=>{
 let publications=0;
 for(const [i,v]of audit.trace.entries()){
  if(v.phase!=='publishCanonical'||v.returned!=='published')continue;
  const t=audit.trace.slice(0,i),index=phase=>t.findLastIndex(p=>p.phase===phase&&p.batch_id===v.batch_id);
  const reopen=index('durable-reopen-before-ack'),ack=t.findLastIndex(p=>p.phase==='actual-ack-write'&&p.accepted&&p.persisted&&p.batch_id===v.batch_id),complete=index('actual-rust-complete');
  const commit=t.findLastIndex(p=>p.phase==='publishCanonical'&&p.sql==='COMMIT');
  const stage=t.slice(0,reopen).findLastIndex(p=>p.phase==='stageBatch'&&p.sql==='COMMIT');
  assert.ok(stage>=0&&stage<reopen&&reopen<ack&&ack<complete&&complete<commit&&commit<i);
  assert.ok(audit.messages.some(m=>m.message_type==='batch'&&m.batch_id===v.batch_id));
  assert.ok(audit.messages.some(m=>m.message_type==='complete'&&m.checkpoint.projection_watermark.batch_id===v.batch_id));
  publications++;
 }
 return{publications,negative_acks:audit.trace.filter(p=>p.phase==='actual-ack-write'&&!p.accepted).length,rollbacks:audit.trace.filter(p=>p.phase==='publishCanonical'&&p.sql==='ROLLBACK').length};
};
const validation=[];
for(const file of ['H1-backfill.json','H1-append.json','H3-reopen-conflict.json']){
 const e=JSON.parse(fs.readFileSync(`${evidence}/${file}`,'utf8'));const a=e.trace?[verify(e)]:[verify(e.first),verify(e.second)];
 assert.equal(e.body.complete,true);assert.equal(e.checkpoint.completeness,'canonical');assert.equal(new Set(e.history.items.map(p=>p.itemKey)).size,e.history.items.length);
 const detail=JSON.parse(e.detail.content);assert.equal(detail.call_id,'command-1');assert.deepEqual(JSON.parse(detail.input).command,['cargo','test','--locked']);assert.ok(detail.output.includes('1 passed'));
 const delegated=e.history.items.filter(p=>p.itemType==='delegated_input');
 if(file.startsWith('H3')){
  assert.equal(a[0].publications,1);assert.equal(a[1].publications,1);assert.equal(a[1].negative_acks,1);assert.equal(a[1].rollbacks,1);
  assert.deepEqual(delegated.map(p=>p.payload.content),['[sanitized delegation 1]','[sanitized delegation 2]','[sanitized delegation 3]']);
  const batch=e.first.messages.find(m=>m.message_type==='batch');
  for(const p of delegated){assert.equal(p.payload.role,'system');assert.equal(p.payload.tool,null);const facts=batch.payload.history_items.filter(f=>f.event_type==='DelegatedInput'&&f.payload.metadata.item_key===p.itemKey);assert.equal(new Set(facts.map(f=>f.payload.metadata.event_id)).size,2);assert.ok(facts.every(f=>f.payload.metadata.turn_id===p.turnId&&f.payload.text===p.payload.content&&!Object.hasOwn(f.payload,'call_id')));}
 }else{assert.equal(a[0].publications,2);assert.equal(a[0].negative_acks,1);assert.equal(delegated.length,0);}
 validation.push({file,verified:true,audits:a,items:e.history.items.length,delegations:delegated.length,tool_call_id:detail.call_id,body_complete:e.body.complete});
}
save('evidence-check',validation);
console.log(JSON.stringify({head,attachments:checks.length,all_fixed_live_match:true,protected:protectedChecks.length,source:source.length,evidence:validation}));
