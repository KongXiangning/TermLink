'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto');
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const out=__dirname,root=path.resolve('logs/task005-s2-repair-runtime-2/data');
const ids={N:'01a114a2-a201-7f73-993f-9c956ae35713',C:'01a114a4-e693-7be1-aafb-b9a3cb580e1d',D:'01a0fe25-56a2-7910-ba22-61e8016e8ad9',F:'01a0ee04-a775-72b3-bd07-04aac804a3b4'};
function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(dir,e.name)):[path.join(dir,e.name)]);}
(async()=>{
 const result={at:new Date().toISOString(),root,ids,files:{},sources:{}};
 for(const file of ['.env','data/sessions.json','native/codex-rollout-collector/target/debug/codex-rollout-collector.exe','native/codex-rollout-compat-spike/vendor/codex/Cargo.lock'])if(fs.existsSync(file)){const b=fs.readFileSync(file);result.files[file]={bytes:b.length,sha256:sha(b)};}
 const sourceFiles=walk(path.join(process.env.USERPROFILE,'.codex/sessions'));
 for(const [label,id]of Object.entries(ids)){const candidates=sourceFiles.filter(p=>p.endsWith(id+'.jsonl'));result.sources[label]=candidates.map(p=>{const b=fs.readFileSync(p),rows=b.toString('utf8').trim().split('\n').map(l=>JSON.parse(l)),meta=rows.find(r=>r.type==='session_meta')?.payload;return {path:p,bytes:b.length,sha256:sha(b),bound_id:meta?.id,history_base:meta?.history_base,forked_from_id:meta?.forked_from_id,records:rows.length,shapes:rows.reduce((o,r)=>{const k=[r.type,r.payload?.type,r.payload?.role].filter(Boolean).join('/');o[k]=(o[k]||0)+1;return o;},{}),markers:['TL832-S5-N-20261007','TL832-S5-N-DONE','TL832-S5-C-20261007','TL832-S5-C-DONE'].filter(m=>b.includes(m))};});}
 const SQL=await require('sql.js')(),db=new SQL.Database(fs.readFileSync(path.join(root,'codex-history.sqlite')));
 function query(q){const r=db.exec(q)[0];return r?r.values.map(v=>Object.fromEntries(r.columns.map((c,i)=>[c,v[i]]))):[];}
 result.integrity=query('PRAGMA quick_check');result.intents=query('SELECT conversation_id,intent_id,revision FROM reconciliation_intents');
 result.canonical=query('SELECT conversation_id,coverage_json FROM conversations').map(r=>{const id=r.conversation_id,items=query(`SELECT * FROM history_items WHERE conversation_id='${id}' ORDER BY ordinal,item_key`),details=query(`SELECT * FROM tool_details WHERE conversation_id='${id}' ORDER BY detail_key`),cp=query(`SELECT checkpoint_json FROM analysis_checkpoints WHERE conversation_id='${id}'`);return {id,coverage:JSON.parse(r.coverage_json),items:items.length,details:details.length,digest:sha(JSON.stringify({items,details})),checkpoint:cp.map(x=>JSON.parse(x.checkpoint_json)),marker_counts:Object.fromEntries(['TL832-S5-N-20261007','TL832-S5-N-DONE','TL832-S5-C-20261007','TL832-S5-C-DONE'].map(m=>[m,items.filter(x=>x.payload_json.includes(m)).length])),types:items.reduce((o,x)=>{o[x.item_type]=(o[x.item_type]||0)+1;return o;},{})};});
 result.staging=query('SELECT conversation_id,count(*) as batches,sum(published_at IS NOT NULL) as published FROM staging_batches GROUP BY conversation_id');result.receipts=query('SELECT conversation_id,count(*) as receipts FROM publication_receipts GROUP BY conversation_id');db.close();
 result.runs=walk(path.join(root,'codex-rollout-runs')).filter(p=>p.endsWith('.json')).map(p=>{const b=fs.readFileSync(p),r=JSON.parse(b);return {file:path.basename(p),sha256:sha(b),conversation_id:r.conversation_id,status:r.status,started_at:r.started_at,completed_at:r.completed_at,error:r.error,last_error:r.last_error,batches:r.batches,receipt_count:r.receipt_count,result:r.result};});
 for(const c of result.canonical)c.checkpoint=c.checkpoint.map(x=>({sha256:sha(JSON.stringify(x)),keys:Object.keys(x)}));
 for(const r of result.runs){for(const k of ['result','error','last_error']){const v=r[k];if(v&&typeof v==='object')r[k]={sha256:sha(JSON.stringify(v)),keys:Object.keys(v),code:v.code,message:v.message};}}
 const label=process.argv[2]||'baseline';fs.writeFileSync(path.join(out,label+'.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({label,sources:result.sources,canonical:result.canonical.map(r=>({id:r.id,items:r.items,details:r.details,digest:r.digest})),intents:result.intents,runs:result.runs.length,running:result.runs.filter(r=>['running','queued'].includes(r.status)).length,integrity:result.integrity}));
})().catch(e=>{console.error(e.message);process.exitCode=1;});
