const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
const d='logs/shared-history-compat-20261005/s4/review-2';
const execution='.workflow-system/records/events/key-fe2ea2e3cfa3398d95d7b34abe90be165036f95737eec18f5a0a04e473e120ca.json';
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const save=(name,v)=>fs.writeFileSync(`${d}/${name}.json`,JSON.stringify(v,null,2)+'\n');
const checks=JSON.parse(fs.readFileSync(execution.replace('/events/','/attachments/'),'utf8')).attachments.map(a=>({path:a.source_path,sha256:a.sha256,fixed_matches:hash(a.ref)===a.sha256,live_matches:hash(a.source_path)===a.sha256}));
save('attachment-check',checks);
const base=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s4/repair-r1/self-check.json','utf8'));
const protectedChecks=base.protectedChecks.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const sources=base.sources.map(p=>({...p,matches:hash(p.path)===p.sha256}));
const old=JSON.parse(fs.readFileSync('logs/shared-history-compat-20261005/s4/source-after.json','utf8')).filter(p=>!sources.some(s=>s.path===p.path)).map(p=>({...p,matches:hash(p.path)===p.sha256}));
const head=cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
save('scope-check',{head,protectedChecks,sources,unchangedS4:old});
for(const [label,id,step] of [['833','task-7ff69ba8242c90c52f0b93fa1144a655','S4'],['832','task-58bc12d9a46b8d84fb6e42888785b402','S2']]){
 const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:id,step_id:step}),encoding:'utf8'});
 fs.writeFileSync(`${d}/status-${label}-before.json`,r.stdout);if(r.status!==0)throw Error(r.stderr||r.stdout);
}
for(const [label,before,after] of [['importer','importer.js','src/services/codexRolloutCollector/analysisBatchImporter.js'],['tests','realRust.test.js','tests/codexRolloutCollector.realRust.test.js']]){
 const r=cp.spawnSync('git',['diff','--no-index','--','logs/shared-history-compat-20261005/s4/repair-r1/before/'+before,after],{encoding:'utf8'});
 fs.writeFileSync(`${d}/${label}-repair.diff`,r.stdout);if(![0,1].includes(r.status))throw Error(r.stderr);
}
console.log(JSON.stringify({head,attachments:checks.length,fixed_live_match:checks.every(p=>p.fixed_matches&&p.live_matches),protected:protectedChecks.every(p=>p.matches),sources:[...sources,...old].every(p=>p.matches)}));
if(head!==base.head||!checks.every(p=>p.fixed_matches&&p.live_matches)||![...protectedChecks,...sources,...old].every(p=>p.matches))throw Error('Current review subject mismatch');
