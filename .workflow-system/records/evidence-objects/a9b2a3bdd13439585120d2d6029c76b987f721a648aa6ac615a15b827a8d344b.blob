const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),assert=require('assert/strict');const dir='logs/history-save-repair-20261005/s5/review-utf8-20261008',e='logs/history-save-repair-20261005/s5/utf8-repair-20261008',sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const r=cp.spawnSync('node',['.workflow-system/runtime/support/assistance.mjs','task-status','--root','.'],{input:JSON.stringify({detail:'step',task_ref:'TASK-20260832',step_id:'S5'}),encoding:'utf8'});assert.equal(r.status,0);fs.writeFileSync(dir+'/status-before.json',r.stdout,{flag:'wx'});const s=JSON.parse(r.stdout);
const event=JSON.parse(fs.readFileSync(s.step.execution_ref)),a=JSON.parse(fs.readFileSync(s.step.execution_ref.replace('/events/','/attachments/'))).attachments;
const attachments=a.map(x=>x.ref?{path:x.source_path,fixed:sha(x.ref)===x.sha256,live:sha(x.source_path)===x.sha256,sha256:x.sha256}:{status:x.status,path:x.request,code:x.code});assert.ok(attachments.filter(x=>x.sha256).every(x=>x.fixed&&x.live));assert.equal(attachments.filter(x=>!x.sha256).length,1);
const wire=JSON.parse(fs.readFileSync(e+'/a-read-all.json')),privateWire=JSON.parse(fs.readFileSync(e+'/private/a-full-wire.json'));assert.equal(sha(e+'/private/a-full-wire.json'),wire.private_wire.sha256);assert.equal(privateWire.items.length,40);assert.equal(privateWire.details.length,9);assert.ok(wire.checks.every(x=>x.passed));assert.equal(wire.app_durable_ack,false);
const bytes=fs.readFileSync(e+'/test-before.txt');const text=bytes[0]===255&&bytes[1]===254?bytes.subarray(2).toString('utf16le'):bytes.toString('utf8');const negative=text.split(/\r?\n/).filter(l=>/^ℹ (tests|pass|fail)|^[✖✔] target stdout UTF8|^# (tests|pass|fail)|^not ok/.test(l));
const diff=cp.execFileSync('git',['diff','--','src/services/codexRolloutCollector/analyzerProcessManager.js','tests/codexRolloutCollector.test.js'],{encoding:'utf8'});fs.writeFileSync(dir+'/review-diff.txt',diff,{flag:'wx'});
const subjects=['src/services/codexRolloutCollector/analyzerProcessManager.js','tests/codexRolloutCollector.test.js','docs/product/plans/PLAN-20261005-codex-history-save-repair.md','docs/product/requirements/REQ-20261005-codex-history-save-repair.md','docs/changes/records/CR-20261008-0045-stdout-utf8-repair.md'].map(p=>({path:p,sha256:sha(p)}));
const protectedFiles=['docs/codex/codex-rollout-collector-architecture.md','docs/workflow/CONTRACTS.md','docs/workflow/DECISIONS.md','native/codex-rollout-collector/target/debug/codex-rollout-collector.exe','native/codex-rollout-compat-spike/vendor/codex/Cargo.lock'].map(p=>({path:p,sha256:sha(p)}));
const audit={execution_ref:s.step.execution_ref,head:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),attachments,subjects,protectedFiles,negative_test_summary:negative,wire:{sha256:wire.private_wire.sha256,items:40,details:9,checks:wire.checks.length,all_pass:true,complete:wire.complete,app_durable_ack:false},qualification:'Same-agent read-only change review. Reuses fixed execution test logs, current source/transport hash audit; no service/device/new model or Rust request. Optional stop log unavailable retained; separate readback records actual stopped observation.'};
fs.writeFileSync(dir+'/audit.json',JSON.stringify(audit,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({execution:audit.execution_ref,attachments_match:28,missing_optional:1,wire_hash_match:true,negative_tests:negative,head:audit.head}));
