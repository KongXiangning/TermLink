{
  "name": "termlink",
  "version": "1.0.0",
  "androidVersionCode": 1,
  "description": "",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run version:check",
    "test": "node --test",
    "version:check": "node scripts/check-version-consistency.js",
    "version:bump": "node scripts/bump-version.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "android:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "android:check-release-config": "node scripts/check-android-release-config.js --release",
    "release:build": "npm run release:build:win && npm run release:build:linux",
    "pre-release:build:win": "npm run version:check",
    "release:build:win": "node scripts/release/windows-release.js --all",
    "pre-release:build:linux": "npm run version:check",
    "release:build:linux": "node scripts/release/build-release.js --platform linux",
    "mtls:generate:nginx": "node scripts/certs/generate-nginx-mtls.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "basic-auth": "^2.0.1",
    "diff": "9.0.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "node-forge": "1.4.0",
    "node-pty": "^1.1.0",
    "sharp": "0.34.5",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "jsdom": "^26.0.0",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.17.0"
  }
}
