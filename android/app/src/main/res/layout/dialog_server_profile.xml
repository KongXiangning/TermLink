<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_dialog_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TermLink.SettingsInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_profile_name_label"
            app:placeholderText="@string/settings_profile_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords|text"
                android:minHeight="52dp"
                android:textColor="@color/sessions_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TermLink.SettingsInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_profile_url_label"
            app:placeholderText="@string/settings_profile_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_profile_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:minHeight="52dp"
                android:textColor="@color/sessions_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.TermLink.Settings.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_profile_terminal_type_label" />

        <Spinner
            android:id="@+id/spinner_profile_terminal_type"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_session_input"
            android:paddingStart="12dp"
            android:paddingEnd="36dp" />

        <TextView
            style="@style/TextAppearance.TermLink.Settings.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_profile_auth_type_label" />

        <Spinner
            android:id="@+id/spinner_profile_auth_type"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_session_input"
            android:paddingStart="12dp"
            android:paddingEnd="36dp" />

        <LinearLayout
            android:id="@+id/basic_auth_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.TermLink.SettingsInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/settings_profile_basic_username_label"
                app:placeholderText="@string/settings_profile_basic_username_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_profile_basic_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:minHeight="52dp"
                    android:textColor="@color/sessions_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.TermLink.SettingsInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/settings_profile_basic_password_label"
                app:placeholderText="@string/settings_profile_basic_password_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_profile_basic_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:textColor="@color/sessions_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_surface_card"
            android:orientation="vertical"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/checkbox_profile_mtls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/sessions_primary"
                android:text="@string/settings_profile_mtls_enabled"
                android:textColor="@color/sessions_text_primary" />

            <LinearLayout
                android:id="@+id/mtls_material_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_profile_mtls_certificate_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_profile_mtls_status_disabled"
                    android:textColor="@color/sessions_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_profile_mtls_choose_certificate"
                        style="@style/Widget.TermLink.SettingsButton.Primary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_profile_mtls_select_certificate" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_profile_mtls_remove_certificate"
                        style="@style/Widget.TermLink.SettingsButton.DangerText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/settings_profile_mtls_remove_certificate"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_profile_mtls_password"
                    style="@style/Widget.TermLink.SettingsInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/settings_profile_mtls_password_label"
                    app:placeholderText="@string/settings_profile_mtls_password_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_profile_mtls_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:minHeight="52dp"
                        android:textColor="@color/sessions_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TermLink.SettingsInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/settings_profile_allowed_hosts_label"
            app:placeholderText="@string/settings_profile_allowed_hosts_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_profile_allowed_hosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="52dp"
                android:textColor="@color/sessions_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
