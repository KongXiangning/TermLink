<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TermLink.SessionInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sessions_name_label"
        app:placeholderText="@string/sessions_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_create_session_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords|text"
            android:minHeight="52dp"
            android:textColor="@color/sessions_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/sessions_create_profile_label"
        android:textColor="@color/sessions_text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinner_create_session_profile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_session_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <LinearLayout
        android:id="@+id/create_session_mode_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sessions_create_mode_label"
            android:textColor="@color/sessions_text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_create_session_mode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_session_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/create_session_cwd_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TermLink.SessionInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sessions_create_cwd_label"
        app:placeholderText="@string/sessions_create_cwd_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_create_session_cwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions|text"
                android:minHeight="52dp"
                android:textColor="@color/sessions_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_browse_session_cwd"
            style="@style/Widget.TermLink.SessionButton.SecondaryText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:text="@string/sessions_create_cwd_browse"
            android:textColor="@color/sessions_primary" />
    </LinearLayout>
</LinearLayout>
