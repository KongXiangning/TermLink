<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sessions_card_bg_selected" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sessions_surface_alt" />
            <stroke android:width="1dp" android:color="@color/sessions_card_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
