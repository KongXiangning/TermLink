<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        MIUI blocks instrumentation from launching a non-exported target
        activity. Keep the production declaration non-exported; debug only
        exposes the local storage screen so its injected-cache UI tests can
        run on a real device.
    -->
    <application>
        <activity
            android:name=".ui.settings.CodexStorageManagementActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <!-- Debug-only Compose media progress fixture; never packaged in release. -->
        <activity
            android:name=".codex.ui.CodexMediaProgressTestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
